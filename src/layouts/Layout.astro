---
import '../styles/global.css';
import { LOCALES, type Locale } from '../i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  ogImage?: string;
}

const BCP47: Record<string, string> = {
  en: 'en', ko: 'ko', ja: 'ja', fr: 'fr', es: 'es',
  zh: 'zh-CN',
};
const descriptionDefaults: Record<string, string> = {
  en: 'OIYO — Explore your personality, destiny, and self',
  ko: 'OIYO — 당신의 운명을 탐험하세요',
  ja: 'OIYO — 自分の個性と運命を探ろう',
  fr: 'OIYO — Explorez votre personnalité et votre destin',
  es: 'OIYO — Explora tu personalidad y tu destino',
  zh: 'OIYO — 探索你的个性与命运',
};
const { title, locale, ogImage } = Astro.props;
const description = Astro.props.description ?? descriptionDefaults[locale] ?? descriptionDefaults['en'];
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const isCjk = ['ko', 'ja', 'zh'].includes(locale);
const defaultOgImage = new URL('/og-image.png', Astro.site).toString();
const resolvedOgImage = ogImage ?? defaultOgImage;
const routeWithoutLocale = Astro.url.pathname.replace(
  /^\/(?:en|ko|ja|zh|fr|es)(?=\/|$)/,
  '',
) || '/';
const alternateLinks = LOCALES.map((alternateLocale) => ({
  hreflang: BCP47[alternateLocale] ?? alternateLocale,
  href: new URL(`/${alternateLocale}${routeWithoutLocale}`, Astro.site),
}));
const xDefaultUrl = new URL(`/ko${routeWithoutLocale}`, Astro.site);
const siteUrl = Astro.site?.toString() ?? 'https://oiyo.net';
const faviconUrl = new URL('/favicon.svg', Astro.site).toString();
---

<!doctype html>
<html lang={BCP47[locale] ?? locale} class={isCjk ? 'text-cjk' : ''}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- OG -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OIYO" />
    <meta property="og:locale" content={(BCP47[locale] ?? 'en').replace('-', '_')} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <!-- JSON-LD: WebSite + Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${Astro.site}#website`,
          "url": Astro.site,
          "name": "OIYO",
          "description": descriptionDefaults['en'],
          "inLanguage": BCP47[locale] ?? locale
        },
        {
          "@type": "Organization",
          "@id": `${Astro.site}#organization`,
          "name": "OIYO",
          "url": siteUrl,
          "logo": { "@type": "ImageObject", "url": faviconUrl }
        }
      ]
    })} />

    <!-- hreflang for all locales -->
    {alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

    <title>{title} | OIYO</title>
  </head>
  <body>
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
