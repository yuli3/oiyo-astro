---
import '../styles/global.css';
import '../styles/print.css';
import { LOCALES, type Locale } from '../i18n';
import deindexedLocales from '../i18n/deindexed-locales.json';
import Header from '../components/Header.astro';
import { routeTransitionName } from '../lib/system/view-transition-name';
import Footer from '../components/Footer.astro';
import TestSourceNote from '../components/shared/TestSourceNote.astro';
import { getTestSourceNote } from '../data/test-source-notes';
import TestRelatedReading from '../components/shared/TestRelatedReading.astro';
import { getRelatedReading } from '../data/test-related-reading';
import AhoxyWelcome from '../components/shared/AhoxyWelcome.astro';
import TestPlayBeacon from '../components/shared/TestPlayBeacon';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  noindex?: boolean;
  canonicalPath?: string;
  ogImage?: string;
  // Opt-in server-rendered lead. Tool pages mount a client:load island, so
  // without this the crawler sees a page with no h1 and no body text at all.
  // Opt-in because pages whose island renders its own h1 would end up with two.
  heading?: string;
  intro?: string;
}

const BCP47: Record<string, string> = {
  en: 'en', ko: 'ko', ja: 'ja', fr: 'fr', es: 'es',
  zh: 'zh-CN',
};
const descriptionDefaults: Record<string, string> = {
  en: 'OIYO — Explore your personality, destiny, and self',
  ko: 'OIYO — 당신의 운명을 탐험하세요',
  ja: 'OIYO — 自分の個性と運命を探ろう',
  fr: 'OIYO — Explorez votre personnalité et votre destin',
  es: 'OIYO — Explora tu personalidad y tu destino',
  zh: 'OIYO — 探索你的个性与命运',
};
const { title, locale, noindex = false, canonicalPath, ogImage, heading, intro } = Astro.props;

// Crawl-budget policy — see astro.config.mjs. Reachable for users, out of the
// index, the sitemap, and the hreflang cluster.
const DEINDEXED_LOCALES = new Set<string>(deindexedLocales);
const isNoindex = noindex || DEINDEXED_LOCALES.has(locale);
const description = Astro.props.description ?? descriptionDefaults[locale] ?? descriptionDefaults['en'];
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const isCjk = ['ko', 'ja', 'zh'].includes(locale);
const defaultOgImage = new URL('/og-image.png', Astro.site).toString();
const resolvedOgImage = ogImage ?? defaultOgImage;
const routeWithoutLocale = Astro.url.pathname.replace(
  /^\/(?:en|ko|ja|zh|fr|es)(?=\/|$)/,
  '',
) || '/';
const alternateRouteWithoutLocale = canonicalPath
  ? canonicalPath.replace(/^\/(?:en|ko|ja|zh|fr|es)(?=\/|$)/, '') || '/'
  : routeWithoutLocale;
const testSourceNote = getTestSourceNote(routeWithoutLocale);
const relatedReading = getRelatedReading(routeWithoutLocale, locale);
// Deindexed locales are dropped from the hreflang cluster: Google discards
// hreflang annotations pointing at noindex URLs.
const alternateLinks = LOCALES.filter((l) => !DEINDEXED_LOCALES.has(l)).map((alternateLocale) => ({
  hreflang: BCP47[alternateLocale] ?? alternateLocale,
  href: new URL(`/${alternateLocale}${alternateRouteWithoutLocale}`, Astro.site),
}));
const xDefaultUrl = new URL(`/ko${alternateRouteWithoutLocale}`, Astro.site);
const siteUrl = Astro.site?.toString() ?? 'https://oiyo.net';
const faviconUrl = new URL('/favicon.svg', Astro.site).toString();
const themeColor = '#65a30d';
const isHomeRoute = routeWithoutLocale === '/';
const looksLikeTest = routeWithoutLocale !== '/achievements' && (Boolean(testSourceNote) || /test/.test(routeWithoutLocale));
const testId = routeWithoutLocale.replace(/^\/+|\/+$/g, '') || 'home';
const homeLabel = ({ ko: '홈', ja: 'ホーム', zh: '首页', fr: 'Accueil', es: 'Inicio' } as Record<string, string>)[locale] ?? 'Home';
---

<!doctype html>
<html lang={BCP47[locale] ?? locale} class={isCjk ? 'text-cjk' : ''}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {isNoindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="alternate" type="application/json" title="Knowledge Catalog" href="/knowledge/index.json" />
    <meta name="theme-color" content={themeColor} />
    <meta name="generator" content={Astro.generator} />

    <!-- OG -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OIYO" />
    <meta property="og:locale" content={(BCP47[locale] ?? 'en').replace('-', '_')} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <!-- JSON-LD: WebSite + Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${Astro.site}#website`,
          "url": Astro.site,
          "name": "OIYO",
          "description": descriptionDefaults['en'],
          "inLanguage": BCP47[locale] ?? locale,
          "publisher": { "@id": "https://oiyo.net/#organization" }
        },
        {
          "@type": "Organization",
          "@id": "https://oiyo.net/#organization",
          "name": "Oiyo",
          "url": "https://oiyo.net",
          "logo": { "@type": "ImageObject", "url": "https://oiyo.net/icon-512.png" }
        }
      ]
    })} />

    <!-- hreflang for all locales -->
    {alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

    <!-- JSON-LD: BreadcrumbList (locale segment skipped, last crumb = page title) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": (() => {
        const all = Astro.url.pathname.split('/').filter(Boolean);
        const crumbs = all
          .map((segment, index) => ({ segment, path: '/' + all.slice(0, index + 1).join('/') }))
          .filter(({ segment }, index) => !(index === 0 && (LOCALES as readonly string[]).includes(segment)));
        return [
          { "@type": "ListItem", "position": 1, "name": ({ ko: "홈", ja: "ホーム", zh: "首页", fr: "Accueil", es: "Inicio" } as Record<string, string>)[locale] ?? "Home", "item": siteUrl },
          ...crumbs.map(({ segment, path }, i) => ({
            "@type": "ListItem",
            "position": i + 2,
            "name": i === crumbs.length - 1
              ? title
              : segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' '),
            "item": new URL(path, Astro.site),
          })),
        ];
      })(),
    })} />

    <title>{title} | OIYO</title>

    <!-- GA4 — same family property as blog/wiki (G-915L6V38X6), split by hostname -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <script is:inline>
      // Local hosts must not report to the production property. Dev and local
      // preview were reaching it: 173 sessions and 2,295 pageviews in 28 days,
      // about a quarter of blog's real volume, which inflated every
      // pageview-based number we reasoned from (2026-08-19).
      // window.gtag is defined either way so callers never have to branch.
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      if (!/^(localhost|127\.0\.0\.1|0\.0\.0\.0|\[::1\])$/.test(location.hostname)) {
        gtag('js', new Date());
        gtag('config', 'G-915L6V38X6');
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + 'G-915L6V38X6';
        document.head.appendChild(s);
      }
    </script>

    <!-- Google AdSense Auto Ads — same publisher as blog/wiki (ca-pub-9541920090543312) -->
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" />
    <link rel="preconnect" href="https://googleads.g.doubleclick.net" />
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9541920090543312" crossorigin="anonymous"></script>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-[100] rounded-lg bg-primary px-4 py-2 text-primary-foreground"
    >
      {locale === "ko" ? "본문 바로가기" : locale === "ja" ? "本文へスキップ" : locale === "zh" ? "跳至正文" : locale === "fr" ? "Aller au contenu" : locale === "es" ? "Saltar al contenido" : "Skip to content"}
    </a>
    {/* 목록의 카드 제목과 **같은 이름**을 이 페이지의 제목에 준다. 브라우저는
        이름으로 양쪽을 짝지어 카드 글자를 제목으로 모프시킨다. 경로에서
        끌어내므로 도착 페이지 90여 곳이 자기가 전환 대상인지 알 필요가 없다.
        페이지당 제목은 하나뿐이라 이름 충돌은 생기지 않는다(충돌하면 브라우저는
        전환 전체를 건너뛴다 — audit:motion-contract 가 빌드 산출물에서 검사한다). */}
    <style is:inline set:html={`h1[data-route-title], #questionnaire-title { view-transition-name: ${routeTransitionName(Astro.url.pathname)}; }`} />
    <Header locale={locale} />
    {!isHomeRoute && (
      <nav aria-label="Breadcrumb" class="mx-auto flex max-w-6xl items-center gap-2 px-4 pt-5 text-xs text-muted-foreground">
        <a href={`/${locale}/`} class="hover:text-primary hover:underline">{homeLabel}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="truncate">{title}</span>
      </nav>
    )}
    <main id="main-content">
      {looksLikeTest && <TestPlayBeacon client:load testId={testId} />}
      {/* intro 를 heading 에서 분리한다. 공용 questionnaire UI 가 이미 h1 을 내는
          페이지에서는 heading 을 넘기지 않아 H1 중복을 피하는데, 예전 구조에서는
          그때 intro 도 함께 사라져 visible prose 가 없어졌다. */}
      {(heading || intro) && (
        <div class="mx-auto max-w-3xl px-4 pt-8">
          {heading && <h1 data-route-title class="text-2xl font-black tracking-tight text-foreground">{heading}</h1>}
          {intro && <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{intro}</p>}
        </div>
      )}
      <slot />
      {relatedReading && <TestRelatedReading locale={locale} blog={relatedReading.blog} wiki={relatedReading.wiki} />}
      {testSourceNote && <TestSourceNote locale={locale} note={testSourceNote} />}
    </main>
    <Footer locale={locale} />
    <AhoxyWelcome locale={locale} />
    <script>
      import { removeStoredTestInputs } from '../lib/user/test-results';
      removeStoredTestInputs('political-compass');
    </script>
  </body>
</html>
