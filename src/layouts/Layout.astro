---
import '../styles/global.css';
import type { Locale } from '../i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  ogImage?: string;
}

const BCP47: Record<string, string> = {
  en: 'en', ko: 'ko', ja: 'ja', fr: 'fr', es: 'es',
  zh: 'zh-CN', cn: 'zh-TW',
};
const descriptionDefaults: Record<string, string> = {
  en: 'OIYO — Explore your personality, destiny, and self',
  ko: 'OIYO — 당신의 운명을 탐험하세요',
  ja: 'OIYO — 自分の個性と運命を探ろう',
  fr: 'OIYO — Explorez votre personnalité et votre destin',
  es: 'OIYO — Explora tu personalidad y tu destino',
  zh: 'OIYO — 探索你的个性与命运',
  cn: 'OIYO — 探索您的個性與命運',
};
const { title, description = descriptionDefaults[locale] ?? descriptionDefaults['en'], locale, ogImage } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const isCjk = ['ko', 'ja', 'cn'].includes(locale);
const defaultOgImage = new URL('/og-image.png', Astro.site).toString();
const resolvedOgImage = ogImage ?? defaultOgImage;
---

<!doctype html>
<html lang={BCP47[locale] ?? locale} class={isCjk ? 'text-cjk' : ''}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- OG -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OIYO" />
    <meta property="og:locale" content={(BCP47[locale] ?? 'en').replace('-', '_')} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <!-- JSON-LD: WebSite + Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${Astro.site}#website`,
          "url": Astro.site,
          "name": "OIYO",
          "description": descriptionDefaults['en'],
          "potentialAction": {
            "@type": "SearchAction",
            "target": { "@type": "EntryPoint", "urlTemplate": `${Astro.site}${locale}/search?q={search_term_string}` },
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "Organization",
          "@id": `${Astro.site}#organization`,
          "name": "OIYO",
          "url": Astro.site,
          "logo": { "@type": "ImageObject", "url": `${Astro.site}favicon.svg` }
        }
      ]
    })} />

    <!-- hreflang for all locales -->
    <link rel="alternate" hreflang="en" href={new URL(`/en${Astro.url.pathname.replace(/^\/[a-z]{2}/, '')}`, Astro.site)} />
    <link rel="alternate" hreflang="ko" href={new URL(`/ko${Astro.url.pathname.replace(/^\/[a-z]{2}/, '')}`, Astro.site)} />
    <link rel="alternate" hreflang="ja" href={new URL(`/ja${Astro.url.pathname.replace(/^\/[a-z]{2}/, '')}`, Astro.site)} />
    <link rel="alternate" hreflang="zh" href={new URL(`/cn${Astro.url.pathname.replace(/^\/[a-z]{2}/, '')}`, Astro.site)} />
    <link rel="alternate" hreflang="fr" href={new URL(`/fr${Astro.url.pathname.replace(/^\/[a-z]{2}/, '')}`, Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(`/es${Astro.url.pathname.replace(/^\/[a-z]{2}/, '')}`, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(`/ko${Astro.url.pathname.replace(/^\/[a-z]{2}/, '')}`, Astro.site)} />

    <title>{title} | OIYO</title>
  </head>
  <body>
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
