---
import '../styles/global.css';
// Single static 404 served by Cloudflare Pages for every missing URL —
// must stay locale-neutral and never emit canonical/hreflang.
const locales = [
  { code: 'ko', label: '한국어', message: '페이지를 찾을 수 없습니다', home: '홈으로' },
  { code: 'en', label: 'English', message: 'Page not found', home: 'Go home' },
  { code: 'ja', label: '日本語', message: 'ページが見つかりません', home: 'ホームへ' },
  { code: 'zh', label: '中文', message: '找不到页面', home: '返回首页' },
  { code: 'fr', label: 'Français', message: 'Page introuvable', home: 'Accueil' },
  { code: 'es', label: 'Español', message: 'Página no encontrada', home: 'Inicio' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>404 — Page not found | OIYO</title>
  </head>
  <body class="min-h-screen bg-background text-foreground font-sans antialiased">
    <main class="flex min-h-screen flex-col items-center justify-center gap-8 px-4 text-center">
      <p class="font-black text-7xl tracking-tighter text-primary">404</p>
      <h1 class="text-xl font-bold">Page not found · 페이지를 찾을 수 없습니다</h1>
      <ul class="flex flex-wrap items-center justify-center gap-3">
        {locales.map(({ code, label, message, home }) => (
          <li>
            <a
              href={`/${code}/`}
              class="inline-flex items-center gap-1.5 rounded-lg border border-border px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:border-primary/40 hover:text-primary"
              title={message}
            >
              <span class="font-bold uppercase tracking-widest text-[11px]">{label}</span>
              <span aria-hidden="true">·</span>
              <span>{home}</span>
            </a>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
