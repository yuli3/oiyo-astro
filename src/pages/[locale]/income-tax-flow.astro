---
import Layout from "../../layouts/Layout.astro";
import { LOCALES } from "../../i18n";
import type { Locale } from "../../i18n";
import IncomeTaxFlowCalculator from "../../components/tools/IncomeTaxFlowCalculator";

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const BASE = "https://oiyo.net";

const meta: Record<string, { title: string; description: string }> = {
  ko: {
    title: "종합소득세 계산 흐름 — 소득금액→과세표준→산출세액→납부세액",
    description: "소득금액에서 소득공제·세율·세액공제·기납부세액을 단계별로 적용해 최종 납부할 세금(또는 환급액)을 보여주는 무료 도구. 각 단계가 무슨 뜻인지 설명과 함께.",
  },
  en: {
    title: "Income Tax Flow — Income → Base → Computed → Payable",
    description: "A free tool that walks Korean income tax step by step: income, deductions, rate, credits and prepaid tax — to the final amount payable (or refund), with each term explained.",
  },
  ja: {
    title: "総合所得税の計算フロー — 所得金額→課税標準→算出税額→納付税額",
    description: "所得金額から所得控除・税率・税額控除・既納付税額を段階的に適用し、最終納付額(または還付額)を表示する無料ツール。各段階の意味も解説。",
  },
};
const m = meta[locale] ?? meta.en;

const content: Record<string, {
  lead: string; faqTitle: string; faq: { q: string; a: string }[];
  relatedTitle: string; related: { href: string; label: string; desc: string; external?: boolean }[];
}> = {
  ko: {
    lead: "세금은 ‘한 번에’ 정해지지 않고 단계를 거칩니다. 소득금액에서 공제를 빼 과세표준을 만들고, 세율을 적용해 산출세액을 구한 뒤, 세액공제와 이미 낸 세금을 반영해 최종 납부액(또는 환급액)이 정해집니다. 각 단계가 무슨 뜻인지 함께 보여드립니다.",
    faqTitle: "자주 묻는 질문",
    faq: [
      { q: "과세표준이 뭔가요?", a: "세금을 매기는 ‘기준 금액’입니다. 종합소득금액에서 소득공제(인적공제·연금보험료 등)를 뺀 값으로, 공제가 클수록 과세표준이 줄어 세금이 낮아집니다." },
      { q: "산출세액과 결정세액은 어떻게 다른가요?", a: "산출세액은 과세표준에 누진세율을 적용해 ‘계산된’ 세금이고, 결정세액은 거기서 세액공제·감면(근로·자녀·연금계좌 등)을 뺀 ‘최종 확정’ 세금입니다." },
      { q: "누진공제는 무엇인가요?", a: "구간별로 세율이 올라가는 누진세 구조에서, 계산을 간단히 하려고 쓰는 보정값입니다. ‘과세표준 × 해당 구간 세율 − 누진공제’로 산출세액을 한 번에 구합니다." },
      { q: "기납부세액과 환급은요?", a: "월급에서 미리 떼인 원천징수세나 중간예납처럼 ‘이미 낸 세금’이 기납부세액입니다. 결정세액(+지방소득세)보다 많이 냈으면 차액을 환급받고, 적게 냈으면 더 냅니다." },
      { q: "이 계산은 정확한가요?", a: "구조 이해를 돕는 교육용 추정치입니다. 실제 세금은 공제 항목·부양가족·소득 종류에 따라 크게 달라집니다. 국세청 홈택스와 세무 전문가로 확인하세요." },
    ],
    relatedTitle: "이어서 배우기",
    related: [
      { href: "https://blog.oiyo.net/ko/academy-tax-law-basic-ch1/", label: "세법 기초 강의", desc: "조세 구조와 세목별 정리.", external: true },
      { href: "https://blog.oiyo.net/ko/academy-tax-saving-guide-ch1/", label: "절세 가이드", desc: "합법적으로 세금 줄이기.", external: true },
      { href: "/overseas-stock-tax", label: "해외주식·RSU 양도세 계산기", desc: "해외주식 22% 양도세." },
    ],
  },
  en: {
    lead: "Tax isn't set in one shot — it flows through stages: income minus deductions makes the taxable base, the rate gives the computed tax, then credits and prepaid tax determine the final amount payable (or refund). Each stage is explained as you go.",
    faqTitle: "Frequently asked questions",
    faq: [
      { q: "What is the taxable base?", a: "The amount tax is applied to: total income minus deductions. The bigger the deductions, the lower the base and the tax." },
      { q: "Computed vs determined tax?", a: "Computed tax applies the progressive rate to the base; determined tax subtracts credits to give the final income tax." },
      { q: "What is the progressive deduction?", a: "A shortcut value in Korea's bracket system: tax = base × bracket rate − progressive deduction, computed in one step." },
      { q: "Prepaid tax and refunds?", a: "Tax already paid (payroll withholding, interim payment). If you prepaid more than the determined tax (+ local tax), you get a refund; if less, you pay the difference." },
      { q: "Is this accurate?", a: "An educational estimate. Real tax varies widely by deductions, dependents and income type — verify via Korea's NTS Hometax and a professional." },
    ],
    relatedTitle: "Keep learning",
    related: [
      { href: "https://blog.oiyo.net/ko/academy-tax-law-basic-ch1/", label: "Tax law basics", desc: "Structure of taxation by type.", external: true },
      { href: "/overseas-stock-tax", label: "Foreign stock & RSU tax", desc: "22% capital-gains tax." },
    ],
  },
};
const c = content[locale] ?? content.en;
const related = c.related.map((r) => ({ ...r, href: r.external ? r.href : `/${locale}${r.href}` }));

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: c.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
});
const appJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: m.title, url: `${BASE}/${locale}/income-tax-flow`,
  applicationCategory: "FinanceApplication", operatingSystem: "Web",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  inLanguage: locale, description: m.description,
});
---

<Layout title={m.title} description={m.description} locale={locale}>
  <script is:inline type="application/ld+json" set:html={faqJsonLd} />
  <script is:inline type="application/ld+json" set:html={appJsonLd} />
  <div class="container mx-auto max-w-3xl px-4 py-8">
    <header class="mb-8">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{m.title}</h1>
      <p class="mt-3 leading-relaxed text-muted-foreground">{c.lead}</p>
    </header>

    <IncomeTaxFlowCalculator locale={locale} client:load />

    <section class="mt-12">
      <h2 class="mb-4 text-2xl font-bold">{c.faqTitle}</h2>
      <div class="space-y-3">
        {c.faq.map((f) => (
          <details class="group rounded-xl border border-border bg-card p-4">
            <summary class="cursor-pointer list-none font-semibold marker:content-none">
              <span class="text-primary">Q.</span> {f.q}
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-12">
      <h2 class="mb-4 text-xl font-bold">{c.relatedTitle}</h2>
      <div class="grid gap-3 md:grid-cols-3">
        {related.map((r) => (
          <a class="rounded-xl border border-border bg-card p-4 transition-colors hover:border-primary/40 hover:bg-primary/5" href={r.href} {...(r.external ? { rel: "noopener" } : {})}>
            <span class="font-semibold">{r.label}</span>
            <span class="mt-1 block text-sm text-muted-foreground">{r.desc}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
