---
import Layout from "../../layouts/Layout.astro";
import { LOCALES } from "../../i18n";
import type { Locale } from "../../i18n";
import OrdinaryWageCalculator from "../../components/tools/OrdinaryWageCalculator";

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "통상임금 시급 산정 & 포괄임금제 고정연장수당 분해기 | OIYO Tools",
    description: "월 209시간 기준 통상시급 역산, 포괄임금제 계약서 고정연장수당 쪼개기, 2026년 최저시급(10,030원) 위반 여부 및 약정 초과근무 시 추가 청구 수당을 1초 만에 진단합니다.",
  },
  en: {
    title: "Korea Ordinary Hourly Wage & Comprehensive Wage Decomposition | OIYO Tools",
    description: "Calculate ordinary hourly wage (209 hrs), decompose comprehensive wage contracts into base salary & fixed overtime, and verify 2026 minimum wage compliance.",
  },
  ja: {
    title: "韓国 通常賃金時給算定＆包括賃金制固定残業代分解機 | OIYO Tools",
    description: "月209時間基準の通常時給逆算、包括賃金契約の基本給と固定残業代分解、2026年最低時給（10,030ウォン）違反判定および超過残業代を診断。",
  },
  zh: {
    title: "韩国 通常时薪核算与一揽子薪资制(包薪制)固定加班费拆解器 | OIYO Tools",
    description: "基于月209工时倒算通常时薪，拆解包薪制合同中的基础工资与固定加班津贴，核验是否违反2026年法定最低时薪（10,030韩元）并测算欠付加班费。",
  },
  fr: {
    title: "Calculateur de salaire horaire ordinaire et décomposition de forfait en Corée | OIYO Tools",
    description: "Calculez le taux horaire ordinaire (base 209h), décomposez le forfait d'heures supplémentaires et vérifiez la conformité au salaire minimum 2026.",
  },
  es: {
    title: "Calculadora de salario ordinario por hora y desglose de salario global en Corea | OIYO Tools",
    description: "Calcule el salario ordinario por hora (base 209h), desglose el salario global en básico y horas extra fijas, y audite el salario mínimo 2026.",
  },
};

const currentMeta = meta[locale] ?? meta.ko;
---

<Layout title={currentMeta.title} description={currentMeta.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 space-y-8">
    <div class="text-center space-y-2 max-w-2xl mx-auto">
      <h1 class="text-3xl font-extrabold tracking-tight">통상임금 시급 & 포괄임금제 분해기</h1>
      <p class="text-muted-foreground text-sm">
        월 209시간 통상시급 역산, 기본급과 고정연장수당 세부 분해, 2026 최저시급(10,030원) 위반 및 추가 초과근무 수당 진단
      </p>
    </div>

    <OrdinaryWageCalculator client:load locale={locale} />

    <div class="max-w-4xl mx-auto border rounded-xl p-6 bg-card border-border space-y-4">
      <h2 class="text-lg font-bold">포괄임금제 계약서 서명 전 3대 필수 확인사항</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-muted-foreground leading-relaxed">
        <div class="space-y-1">
          <h3 class="font-semibold text-foreground">💡 기본급만으로 최저임금을 넘어야 합법</h3>
          <p>
            포괄임금제 계약서에 적힌 고정연장수당은 최저임금 산정 범위에 포함되지 않습니다. 따라서 고정연장수당을 뺀 <strong>순수 기본급을 209시간으로 나눈 금액이 2026년 법정 최저시급(10,030원) 이상</strong>이어야 법적으로 유효합니다.
          </p>
        </div>
        <div class="space-y-1">
          <h3 class="font-semibold text-foreground">💡 고정연장시간을 초과한 근무는 당연히 유급</h3>
          <p>
            대법원 판례에 따라 포괄임금제라 하더라도 계약서에 명시된 시간(예: 월 20시간)을 초과하여 일한 시간은 당연히 <strong>통상시급의 1.5배로 계산하여 추가 급여를 지급</strong>해야 하며, 이를 지급하지 않으면 근로기준법상 임금체불에 해당합니다.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
