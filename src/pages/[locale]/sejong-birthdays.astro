---
import Layout from "../../layouts/Layout.astro";
import { LOCALES, localePath } from "../../i18n";
import type { Locale } from "../../i18n";
import SejongBirthdays from "../../components/tools/past-life/SejongBirthdays";
import RelatedTools from "../../components/shared/RelatedTools.astro";

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
type Copy = { title: string; description: string; heading: string; sub: string; intro: string; howTitle: string; how: string[]; faqTitle: string; faq: { q: string; a: string }[] };
const copy: Record<Locale, Copy> = {
  ko: {
    title: "다른 해의 내 생일 실록 — 세종 32년 동안 해마다 내 생일에 생긴 일",
    description: "세종 재위 32년(1419~1450) 동안 해마다 내 생일에 『세종실록』에 무엇이 적혔는지 펼쳐 봐요. 기사 3만 3천여 건을 날짜별로 정리했어요.",
    heading: "다른 해의 내 생일 실록",
    sub: "세종 재위 32년 · 1419~1450",
    intro: "1426년 한 해만이 아니라 세종이 다스린 32년 동안, 해마다 내 생일에 조정에서는 무슨 일이 있었을까요? 생일을 넣으면 해마다 그날의 실록 첫 기사를 연표처럼 보여 드려요.",
    howTitle: "어떻게 찾나요",
    how: [
      "위키문헌의 세종실록 원년~32년 원문을 날짜별로 정리했어요(10,293일, 기사 33,151건).",
      "음력 날짜는 기사에 적힌 일진으로 하루씩 맞췄고, 양력은 계절상 같은 날로 계산했어요.",
      "생일은 월·일만 링크에 담아요.",
    ],
    faqTitle: "자주 묻는 질문",
    faq: [
      { q: "왜 어떤 해는 기록이 없나요?", a: "실록은 날마다 쓰지 않았어요. 또 1419년 음력 설 전과 1450년 2월 17일 세종이 세상을 떠난 뒤는 세종실록 범위 밖이에요." },
      { q: "1426년만 자세히 보고 싶어요.", a: "‘내 생일의 실록’(1426)에서는 그해 기사 전체와 날씨까지 볼 수 있어요." },
    ],
  },
  en: {
    title: "My birthday across Sejong's reign: 32 years of the Annals",
    description: "See what the Sejong Sillok recorded on your birthday in every year of Sejong's reign (1419–1450): over 33,000 entries sorted by date.",
    heading: "My birthday across Sejong's reign",
    sub: "32 years · 1419–1450",
    intro: "Not just 1426: what happened at court on your birthday in each of Sejong's 32 years?",
    howTitle: "How it works",
    how: ["10,293 dated days and 33,151 entries from Wikisource, matched by day ganzhi.", "Only month and day go into the link."],
    faqTitle: "FAQ",
    faq: [{ q: "Why are some years empty?", a: "The Annals did not record every day." }],
  },
  ja: {
    title: "別の年の誕生日の実録 — 世宗在位32年の毎年の誕生日",
    description: "世宗在位32年（1419〜1450）の毎年、自分の誕生日に『世宗実録』に何が書かれたかを見ます。",
    heading: "別の年の誕生日の実録",
    sub: "世宗在位32年・1419〜1450",
    intro: "1426年だけでなく、世宗の32年間、毎年の誕生日に朝廷では何があったでしょう。",
    howTitle: "仕組み",
    how: ["ウィキソースの世宗実録元年〜32年を日付ごとに整理しました。", "リンクには月日だけが入ります。"],
    faqTitle: "よくある質問",
    faq: [{ q: "記録がない年があるのは？", a: "実録は毎日書かれたわけではありません。" }],
  },
  zh: {
    title: "其他年份的生日实录 — 世宗在位32年里每年的生日",
    description: "看看世宗在位32年（1419–1450）里，每年你生日那天《世宗实录》记了什么。",
    heading: "其他年份的生日实录",
    sub: "世宗在位32年·1419–1450",
    intro: "不只是1426年：世宗在位的32年里，每年你生日那天朝廷发生了什么？",
    howTitle: "怎么查",
    how: ["整理了维基文库世宗实录元年至三十二年的逐日记事。", "链接只含月日。"],
    faqTitle: "常见问题",
    faq: [{ q: "为什么有些年份没有记录？", a: "实录并非每天都有记事。" }],
  },
  fr: {
    title: "Mon anniversaire sous Sejong : 32 ans d’Annales",
    description: "Ce que les Annales de Sejong ont noté le jour de votre anniversaire, chaque année de 1419 à 1450.",
    heading: "Mon anniversaire sous Sejong",
    sub: "32 ans · 1419–1450",
    intro: "Pas seulement 1426 : que s’est-il passé à la cour le jour de votre anniversaire, chaque année du règne ?",
    howTitle: "Comment ça marche",
    how: ["Articles de Wikisource classés par jour.", "Seuls le mois et le jour vont dans le lien."],
    faqTitle: "Questions fréquentes",
    faq: [{ q: "Pourquoi des années vides ?", a: "Les Annales n’écrivaient pas chaque jour." }],
  },
  es: {
    title: "Mi cumpleaños bajo Sejong: 32 años de Anales",
    description: "Lo que los Anales de Sejong anotaron el día de tu cumpleaños, cada año de 1419 a 1450.",
    heading: "Mi cumpleaños bajo Sejong",
    sub: "32 años · 1419–1450",
    intro: "No solo 1426: ¿qué pasó en la corte el día de tu cumpleaños en cada año del reinado?",
    howTitle: "Cómo funciona",
    how: ["Entradas de Wikisource ordenadas por día.", "Solo el mes y el día van en el enlace."],
    faqTitle: "Preguntas frecuentes",
    faq: [{ q: "¿Por qué hay años vacíos?", a: "Los Anales no registraban cada día." }],
  },
};
const c = copy[locale] ?? copy.en;
const faqJsonLd = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: c.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };
---
<Layout title={c.title} description={c.description} locale={locale} canonicalPath={localePath(locale, "/sejong-birthdays/")} ogImage="/images/past-life-1426/og/sejong-birthdays.webp">
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="container mx-auto max-w-3xl px-4 py-8">
    <p class="text-sm font-bold text-muted-foreground"><a class="hover:underline" href={localePath(locale, "/past-life-1426/")}>← {({ ko: "타임슬립 시리즈", en: "Time-slip series", ja: "タイムスリップ・シリーズ", zh: "时空穿越系列", fr: "Série voyage dans le temps", es: "Serie viaje en el tiempo" } as Record<string, string>)[locale] ?? "Time-slip"}</a></p>
    <h1 class="mt-2 text-4xl font-black tracking-tight text-foreground">
      {c.heading}
      <span class="mt-1 block text-xl font-bold text-muted-foreground">{c.sub}</span>
    </h1>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted-foreground">{c.intro}</p>
    <div class="mt-6"><SejongBirthdays locale={locale} client:load /></div>
    <RelatedTools locale={locale} tools={["sillok1426", "nightSky1426", "sillokNameHanja"]} current="sejongBirthdays" />
    <section class="mt-10 text-sm leading-relaxed text-muted-foreground">
      <h2 class="text-lg font-bold text-foreground">{c.howTitle}</h2>
      {c.how.map((p) => <p class="mt-2">{p}</p>)}
    </section>
    <section class="mt-10 text-sm leading-relaxed text-muted-foreground">
      <h2 class="text-lg font-bold text-foreground">{c.faqTitle}</h2>
      {c.faq.map((f) => (<div class="mt-4"><h3 class="font-bold text-foreground">{f.q}</h3><p class="mt-1">{f.a}</p></div>))}
    </section>
  </div>
</Layout>
