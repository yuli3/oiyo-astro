---
// Merged into /support (2026-07-30, user decision): support.astro now hosts
// the contact form directly. This route stays only as a redirect so existing
// links/bookmarks to /contact keep working.
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const target = `/${locale}/support/`;

const label: Record<Locale, string> = {
  ko: '고객지원 페이지로 이동',
  en: 'Go to the support page',
  ja: 'サポートページへ移動',
  zh: '前往支持页面',
  fr: 'Aller à la page d’assistance',
  es: 'Ir a la página de soporte',
};
const m = label[locale] ?? label.en;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={`https://oiyo.net${target}`} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>OIYO Support</title>
  </head>
  <body>
    <a href={target}>{m}</a>
  </body>
</html>
