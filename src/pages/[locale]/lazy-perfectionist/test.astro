---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import LazyPerfectionistTest from '../../../components/tests/LazyPerfectionistTest';
import WisdomNotes from '../../../components/shared/WisdomNotes.astro';
import TestContentBridge from '../../../components/shared/TestContentBridge.astro';
import { getTestBridge } from '../../../data/test-content-bridges';
import RelatedTools from '../../../components/shared/RelatedTools.astro';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '게으른 완벽주의자 테스트 — 미루기의 진짜 이유', description: '완벽주의, 실패 회피, 계획 과잉, 시작 저항 중 나의 미루기 패턴을 점검하고 오늘 할 작은 행동을 받아보세요.' },
  en: { title: 'Lazy Perfectionist Test — Why You Delay', description: 'Check whether your procrastination comes from perfectionism, fear of failure, overplanning, or start friction.' },
  ja: { title: '怠けた完璧主義者テスト — 先延ばしの理由', description: '完璧主義、失敗回避、計画過多、開始抵抗のどれが先延ばしを生むか確認します。' },
  zh: { title: '懒惰完美主义者测试', description: '检查拖延是否来自完美主义、失败恐惧、过度计划或启动阻力。' },
  fr: { title: 'Test du Perfectionniste Paresseux', description: 'Découvrez si votre procrastination vient du perfectionnisme, de la peur de l’échec ou de la sur-planification.' },
  es: { title: 'Test del Perfeccionista Perezoso', description: 'Descubre si tu procrastinación viene del perfeccionismo, miedo al fracaso o exceso de planificación.' },
};
const m = meta[locale] ?? meta.en;
const bridge = getTestBridge('lazy-perfectionist', locale);

const content: Record<Locale, { introTitle: string; intro: string; conceptTitle: string; concepts: { title: string; body: string }[]; faqTitle: string; faqs: { question: string; answer: string }[]; disclaimer: string; }> = {
  ko: { introTitle: '게으른 완벽주의는 사람을 단정하는 라벨이 아니라 미루기 뒤의 완벽주의 패턴을 보는 렌즈입니다', intro: '게으른 완벽주의자 테스트는 완벽주의, 실패 회피, 계획 과잉, 시작 저항 중 어떤 힘이 미루기를 키우는지 살펴봅니다. 결과는 의지 부족을 단정하는 말이 아니라 시작을 작게 만들기 위한 참고입니다.', conceptTitle: '게으른 완벽주의를 읽는 세 가지 관점', concepts: [{ title: '완벽한 조건', body: '시작 조건을 너무 높게 잡으면 준비가 행동을 대신할 수 있습니다.' }, { title: '실패의 상상', body: '결과를 미리 걱정할수록 작은 첫 단계가 더 멀게 느껴집니다.' }, { title: '오늘의 행동', body: '결과보다 시작 단위를 줄이는 것이 흐름을 되살리는 실마리입니다.' }], faqTitle: '자주 묻는 질문', faqs: [{ question: '게으른 완벽주의 결과는 얼마나 정확한가요?', answer: '현재 답변에 나타난 미루기 패턴을 요약한 참고 자료입니다. 과제의 종류와 부담 정도에 따라 달라질 수 있습니다.' }, { question: '이 결과는 제가 게으르다는 뜻인가요?', answer: '그렇게 단정하지 않습니다. 시작을 막는 기준, 두려움, 계획 습관을 살펴보는 렌즈로 읽어 주세요.' }, { question: '결과를 어떻게 활용하면 좋나요?', answer: '완벽한 계획보다 오늘 끝낼 수 있는 아주 작은 행동을 정하는 데 사용해 보세요.' }], disclaimer: '게으른 완벽주의자 테스트 결과는 자기 이해와 대화를 위한 참고입니다. 진단, 채용, 관계의 단정적 판단 근거로 사용하지 마세요.' },
  en: { introTitle: 'Lazy perfectionism is a lens for the perfectionism behind delay, not a label that defines you', intro: 'The lazy perfectionist test looks at whether delay is driven by perfectionism, fear of failure, overplanning, or start friction. The result does not declare a lack of willpower; it is a reference for making the first step smaller.', conceptTitle: 'Three ways to read lazy perfectionism', concepts: [{ title: 'Perfect conditions', body: 'When start conditions are too high, preparation can replace action.' }, { title: 'Imagined failure', body: 'The more you preview the outcome, the farther the first step can feel.' }, { title: 'Today’s action', body: 'Shrinking the start, not perfecting the result, often restores momentum.' }], faqTitle: 'Frequently asked questions', faqs: [{ question: 'How accurate is the lazy perfectionist result?', answer: 'It summarizes delay patterns shown in your current answers. Task type and pressure can shift it.' }, { question: 'Does this mean I am lazy?', answer: 'No. Read it as a lens for standards, fear, and planning habits that may block the start.' }, { question: 'How should I use the result?', answer: 'Use it to choose a very small action you can finish today, rather than to build a perfect plan.' }], disclaimer: 'Lazy perfectionist test results are for self-understanding and conversation. Do not use them as a basis for diagnosis, hiring, or definitive relationship judgments.' },
  ja: { introTitle: '怠けた完璧主義は人を決めつけるラベルではなく、先延ばしの裏にある完璧主義を見るレンズです', intro: '怠けた完璧主義者テストは完璧主義、失敗回避、計画過多、開始抵抗のどれが先延ばしを強めるかを見ます。結果は意志の弱さを決めるものではなく、開始を小さくするための参考です。', conceptTitle: '怠けた完璧主義を読む三つの視点', concepts: [{ title: '完璧な条件', body: '開始条件が高すぎると、準備が行動の代わりになります。' }, { title: '失敗の想像', body: '結果を先に心配するほど、小さな一歩が遠く感じられます。' }, { title: '今日の行動', body: '結果を完璧にするより開始単位を小さくすることが流れを戻します。' }], faqTitle: 'よくある質問', faqs: [{ question: '結果はどれくらい正確ですか？', answer: '現在の回答に表れた先延ばしパターンの要約です。課題の種類や負担の大きさで変わります。' }, { question: '怠けているという意味ですか？', answer: 'そう断定しません。開始を止める基準、恐れ、計画の習慣を見るレンズとして読んでください。' }, { question: 'どう活用すればよいですか？', answer: '完璧な計画より、今日終えられるとても小さな行動を決めるために使ってください。' }], disclaimer: '怠けた完璧主義者テストの結果は自己理解と対話のための参考です。診断、採用、人間関係の断定的判断には使わないでください。' },
  zh: { introTitle: '懒惰完美主义是观察拖延背后完美主义模式的镜片，不是定义人的标签', intro: '懒惰完美主义者测试观察拖延更来自完美主义、失败恐惧、过度计划还是启动阻力。结果不是判定意志不足，而是帮助你把开始变小的参考。', conceptTitle: '理解懒惰完美主义的三个角度', concepts: [{ title: '完美条件', body: '开始条件设得太高时，准备可能取代行动。' }, { title: '想象失败', body: '越提前担心结果，第一步越显得遥远。' }, { title: '今天的行动', body: '缩小开始单位，而不是完善结果，常常能恢复流动。' }], faqTitle: '常见问题', faqs: [{ question: '结果有多准确？', answer: '它概括的是当前回答中的拖延模式。任务类型和压力程度会影响结果。' }, { question: '这说明我懒吗？', answer: '不是。请把它看作观察阻挡开始的标准、恐惧和计划习惯的镜片。' }, { question: '应该如何使用结果？', answer: '用它来决定今天能完成的一个很小行动，而不是继续完善计划。' }], disclaimer: '懒惰完美主义者测试结果仅用于自我理解与对话，请勿作为诊断、招聘或关系定论的依据。' },
  fr: { introTitle: 'Le perfectionnisme paresseux est une lentille sur le perfectionnisme derrière le report, pas une étiquette qui vous définit', intro: 'Le test du perfectionniste paresseux observe si le report vient du perfectionnisme, de la peur, de la sur-planification ou du frottement initial. Le résultat ne juge pas la volonté; il aide à réduire le premier pas.', conceptTitle: 'Trois façons de lire le perfectionnisme paresseux', concepts: [{ title: 'Conditions parfaites', body: 'Quand les conditions de départ sont trop hautes, la préparation remplace l’action.' }, { title: 'Échec imaginé', body: 'Plus le résultat est anticipé, plus le premier pas paraît loin.' }, { title: 'Action du jour', body: 'Réduire le départ, plutôt que parfaire le résultat, relance souvent l’élan.' }], faqTitle: 'Questions fréquentes', faqs: [{ question: 'Le résultat est-il fiable ?', answer: 'Il résume les motifs de report visibles dans vos réponses. Le type de tâche et la pression peuvent le modifier.' }, { question: 'Cela veut-il dire que je suis paresseux ?', answer: 'Non. Lisez-le comme une lentille sur les standards, la peur et les habitudes de planification qui bloquent le départ.' }, { question: 'Comment l’utiliser ?', answer: 'Utilisez-le pour choisir une très petite action finissable aujourd’hui, plutôt que construire un plan parfait.' }], disclaimer: 'Les résultats du test du perfectionniste paresseux servent à la compréhension de soi et au dialogue. Ne les utilisez pas comme base de diagnostic, de recrutement ou de verdict relationnel.' },
  es: { introTitle: 'El perfeccionismo perezoso es una lente sobre el perfeccionismo detrás de la demora, no una etiqueta que te define', intro: 'El test del perfeccionista perezoso observa si la demora viene de perfeccionismo, miedo, sobreplanificación o fricción inicial. El resultado no juzga tu voluntad; ayuda a reducir el primer paso.', conceptTitle: 'Tres formas de leer el perfeccionismo perezoso', concepts: [{ title: 'Condiciones perfectas', body: 'Si las condiciones para empezar son demasiado altas, la preparación sustituye la acción.' }, { title: 'Fracaso imaginado', body: 'Cuanto más anticipas el resultado, más lejos parece el primer paso.' }, { title: 'Acción de hoy', body: 'Reducir el inicio, no perfeccionar el resultado, suele recuperar impulso.' }], faqTitle: 'Preguntas frecuentes', faqs: [{ question: '¿Qué tan preciso es el resultado?', answer: 'Resume patrones de demora que aparecen en tus respuestas. Tipo de tarea y presión pueden cambiarlo.' }, { question: '¿Significa que soy perezoso?', answer: 'No. Léelo como una lente sobre estándares, miedo y hábitos de planificación que bloquean el inicio.' }, { question: '¿Cómo usarlo?', answer: 'Úsalo para elegir una acción muy pequeña que puedas terminar hoy, no para construir un plan perfecto.' }], disclaimer: 'Los resultados del test del perfeccionista perezoso son para autoconocimiento y conversación. No los uses como base para diagnóstico, contratación o juicios definitivos sobre relaciones.' },
};

const c = content[locale] ?? content.en;
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
---

<Layout title={m.title} description={m.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <main class="mx-auto max-w-2xl px-4 py-10">
    <LazyPerfectionistTest client:load locale={locale} />
    <section class="mt-10 border-t border-violet-100 pt-8"><h2 class="text-2xl font-bold text-violet-950">{c.introTitle}</h2><p class="mt-4 leading-8 text-violet-800">{c.intro}</p></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.conceptTitle}</h2><div class="mt-4 grid gap-4 md:grid-cols-3">{c.concepts.map((item) => (<article class="rounded-xl border border-violet-100 bg-white p-4"><h3 class="font-semibold text-violet-950">{item.title}</h3><p class="mt-2 text-sm leading-6 text-violet-700">{item.body}</p></article>))}</div></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.faqTitle}</h2><div class="mt-4 divide-y divide-violet-100 rounded-xl border border-violet-100 bg-white">{c.faqs.map((faq) => (<details class="group p-4"><summary class="cursor-pointer list-none font-semibold text-violet-950">{faq.question}</summary><p class="mt-3 text-sm leading-6 text-violet-700">{faq.answer}</p></details>))}</div></section>
    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>
    <WisdomNotes topic="lazy-perfectionist" locale={locale} />
    <TestContentBridge content={bridge.content} blogUrl={bridge.blogUrl} wikiUrl={bridge.wikiUrl} />
    <RelatedTools locale={locale} tools={['perfectionism','selfEsteem','lethargy','eq']} current="lazyPerfectionist" />
  </main>
</Layout>
