---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import EmotionalIntelligenceTest from '../../../components/tests/EmotionalIntelligenceTest';
import RelatedTools from '../../../components/shared/RelatedTools.astro';
import { buildQuizJsonLd } from '../../../lib/seo/quiz-json-ld';
import TestSourceNote from '../../../components/shared/TestSourceNote.astro';
import PrintReportButton from '../../../components/shared/PrintReportButton.astro';
import { TEST_SOURCE_NOTES } from '../../../data/test-source-notes';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '감성지능(EQ) 테스트 — 나의 EQ는?', description: '자기인식·자기조절·동기부여·공감·사회적 기술 5가지 영역으로 나의 감성지능을 측정하세요.' },
  en: { title: 'Emotional Intelligence (EQ) Test — What Is Your EQ?', description: 'Measure your EQ across self-awareness, self-regulation, motivation, empathy, and social skills.' },
  ja: { title: '感情知性(EQ)テスト — あなたのEQは？', description: '自己認識・自己調整・モチベーション・共感・社会的スキルの5領域で感情知性を測定します。' },
  zh: { title: '情商(EQ)测试 — 你的情商是多少？', description: '通过自我认知、自我调节、动力、共情和社交技能5个领域测量你的情商。' },
  fr: { title: "Test d'Intelligence Émotionnelle (QE) — Quel est votre QE?", description: "Mesurez votre QE selon la conscience de soi, l'autorégulation, la motivation, l'empathie et les compétences sociales." },
  es: { title: 'Test de Inteligencia Emocional (IE) — ¿Cuál es tu IE?', description: 'Mide tu IE en autoconciencia, autorregulación, motivación, empatía y habilidades sociales.' },
};
const m = meta[locale] ?? meta.en;

const content: Record<Locale, { introTitle: string; intro: string; conceptTitle: string; concepts: { title: string; body: string }[]; faqTitle: string; faqs: { question: string; answer: string }[]; disclaimer: string; }> = {
  ko: { introTitle: '감성지능(EQ)은 사람을 단정하는 라벨이 아니라 감정을 알아차리고 다루는 방식을 보는 렌즈입니다', intro: '감성지능 테스트는 자기인식, 자기조절, 동기부여, 공감, 사회적 기술의 균형을 살펴봅니다. 결과는 능력을 고정하는 점수가 아니라 감정과 관계를 더 잘 조율하기 위한 참고입니다.', conceptTitle: 'EQ를 읽는 세 가지 관점', concepts: [{ title: '감정 인식', body: '내 감정의 이름과 강도를 알아차리는 능력입니다.' }, { title: '감정 조절', body: '느낀 감정을 억누르기보다 상황에 맞게 표현하고 다루는 힘입니다.' }, { title: '관계 기술', body: '상대의 감정 신호를 읽고 갈등 속에서도 대화를 이어가는 방식입니다.' }], faqTitle: '자주 묻는 질문', faqs: [{ question: 'EQ 결과는 얼마나 정확한가요?', answer: '현재 답변에 나타난 감정 처리 경향을 요약한 참고 자료입니다. 상황과 관계에 따라 달라질 수 있으니 절대적 점수로 보지 마세요.' }, { question: '이 결과가 전문적인 진단을 대신하나요?', answer: '아니요. 이 테스트는 임상 진단이 아닙니다. 불편감이나 걱정이 오래 지속되면 자격을 갖춘 전문가와 상담해 주세요.' }, { question: 'EQ는 바뀔 수 있나요?', answer: '네. 감정 이름 붙이기, 대화 연습, 회복 루틴을 통해 감정 조절과 관계 기술은 달라질 수 있습니다.' }], disclaimer: 'EQ 결과는 자기 이해와 대화를 위한 참고입니다. 진단, 채용, 관계의 단정적 판단 근거로 사용하지 마세요.' },
  en: { introTitle: 'Emotional intelligence is a lens for noticing and working with emotions, not a label that defines you', intro: 'The EQ test looks at the balance of self-awareness, self-regulation, motivation, empathy, and social skills. The result is not a fixed ability score; it is a reference for tuning emotion and relationships.', conceptTitle: 'Three ways to read EQ', concepts: [{ title: 'Emotional awareness', body: 'The ability to name your emotion and notice its intensity.' }, { title: 'Emotion regulation', body: 'Working with feelings in context instead of simply suppressing them.' }, { title: 'Relationship skills', body: 'Reading emotional signals and keeping dialogue possible during conflict.' }], faqTitle: 'Frequently asked questions', faqs: [{ question: 'How accurate is the EQ result?', answer: 'It summarizes emotion-processing tendencies shown in your current answers. Context and relationships can shift it, so avoid treating it as an absolute score.' }, { question: 'Does this replace a professional diagnosis?', answer: 'No. This test is not a clinical diagnosis. If concerns or distress persist, consider speaking with a qualified professional.' }, { question: 'Can EQ change?', answer: 'Yes. Naming emotions, practicing dialogue, and building recovery routines can change regulation and relationship skills.' }], disclaimer: 'EQ results are for self-understanding and conversation. Do not use them as a basis for diagnosis, hiring, or definitive relationship judgments.' },
  ja: { introTitle: '感情知性(EQ)は人を決めつけるラベルではなく、感情に気づき扱う方法を見るレンズです', intro: 'EQテストは自己認識、自己調整、動機づけ、共感、社会的スキルのバランスを見ます。結果は能力を固定する点数ではなく、感情と関係を整える参考です。', conceptTitle: 'EQを読む三つの視点', concepts: [{ title: '感情の認識', body: '自分の感情の名前と強さに気づく力です。' }, { title: '感情の調整', body: '感情を押し込めるのではなく、状況に合わせて表現し扱う力です。' }, { title: '関係スキル', body: '相手の感情サインを読み、葛藤の中でも対話を続ける方法です。' }], faqTitle: 'よくある質問', faqs: [{ question: 'EQの結果はどれくらい正確ですか？', answer: '現在の回答に表れた感情処理の傾向の要約です。状況や関係で変わるため、絶対的な点数として扱わないでください。' }, { question: '専門的な診断の代わりになりますか？', answer: 'いいえ。このテストは臨床的な診断ではありません。不調や心配が続く場合は、資格のある専門家に相談してください。' }, { question: 'EQは変わりますか？', answer: '変わります。感情に名前をつけること、対話の練習、回復ルーティンによって調整力や関係スキルは変化します。' }], disclaimer: 'EQの結果は自己理解と対話のための参考です。診断、採用、人間関係の断定的な判断材料には使わないでください。' },
  zh: { introTitle: '情商(EQ)是观察觉察和处理情绪方式的镜片，不是定义人的标签', intro: 'EQ测试观察自我认知、自我调节、动力、共情和社交技能的平衡。结果不是固定能力分数，而是帮助你更好调节情绪与关系的参考。', conceptTitle: '理解EQ的三个角度', concepts: [{ title: '情绪认知', body: '觉察并命名自己情绪及强度的能力。' }, { title: '情绪调节', body: '不是简单压抑情绪，而是在情境中表达和处理。' }, { title: '关系技能', body: '读懂他人的情绪信号，并在冲突中保持对话。' }], faqTitle: '常见问题', faqs: [{ question: 'EQ结果有多准确？', answer: '它概括的是当前回答中的情绪处理倾向。情境和关系会影响结果，因此不要当作绝对分数。' }, { question: '这个结果能代替专业诊断吗？', answer: '不能。本测试不是临床诊断。如果困扰或担忧持续存在，请考虑咨询合格的专业人士。' }, { question: 'EQ会改变吗？', answer: '会。练习命名情绪、对话和恢复习惯，都可能改变情绪调节与关系技能。' }], disclaimer: 'EQ结果仅用于自我理解与对话，请勿作为诊断、招聘或关系定论的依据。' },
  fr: { introTitle: 'L’intelligence émotionnelle est une lentille pour percevoir et gérer les émotions, pas une étiquette qui vous définit', intro: 'Le test de QE observe l’équilibre entre conscience de soi, autorégulation, motivation, empathie et compétences sociales. Le résultat n’est pas un score fixe, mais un repère pour ajuster émotions et relations.', conceptTitle: 'Trois façons de lire le QE', concepts: [{ title: 'Conscience émotionnelle', body: 'La capacité à nommer l’émotion et à sentir son intensité.' }, { title: 'Régulation émotionnelle', body: 'Composer avec l’émotion selon le contexte plutôt que la réprimer.' }, { title: 'Compétences relationnelles', body: 'Lire les signaux émotionnels et garder le dialogue possible en conflit.' }], faqTitle: 'Questions fréquentes', faqs: [{ question: 'Le résultat est-il fiable ?', answer: 'Il résume les tendances de traitement émotionnel visibles dans vos réponses du moment. Le contexte et les relations peuvent le modifier; ne le prenez pas comme score absolu.' }, { question: 'Cela remplace-t-il un diagnostic professionnel ?', answer: 'Non. Ce test n’est pas un diagnostic clinique. Si des inquiétudes ou une détresse persistent, consultez un professionnel qualifié.' }, { question: 'Le QE peut-il changer ?', answer: 'Oui. Nommer les émotions, pratiquer le dialogue et installer des routines de récupération peuvent modifier la régulation et les compétences relationnelles.' }], disclaimer: 'Les résultats de QE servent à la compréhension de soi et au dialogue. Ne les utilisez pas comme base de diagnostic, de recrutement ou de verdict relationnel.' },
  es: { introTitle: 'La inteligencia emocional es una lente para percibir y manejar emociones, no una etiqueta que te define', intro: 'El test de IE observa el equilibrio entre autoconciencia, autorregulación, motivación, empatía y habilidades sociales. El resultado no es una puntuación fija, sino una referencia para ajustar emociones y relaciones.', conceptTitle: 'Tres formas de leer la IE', concepts: [{ title: 'Conciencia emocional', body: 'La capacidad de nombrar la emoción y notar su intensidad.' }, { title: 'Regulación emocional', body: 'Trabajar con lo que sientes según el contexto, no solo reprimirlo.' }, { title: 'Habilidades relacionales', body: 'Leer señales emocionales y sostener el diálogo en el conflicto.' }], faqTitle: 'Preguntas frecuentes', faqs: [{ question: '¿Qué tan preciso es el resultado?', answer: 'Resume tendencias de procesamiento emocional que aparecen en tus respuestas actuales. Contexto y relaciones pueden cambiarlo; no lo trates como puntuación absoluta.' }, { question: '¿Sustituye a un diagnóstico profesional?', answer: 'No. Este test no es un diagnóstico clínico. Si las preocupaciones o el malestar persisten, considera hablar con un profesional cualificado.' }, { question: '¿La IE puede cambiar?', answer: 'Sí. Nombrar emociones, practicar diálogo y crear rutinas de recuperación puede cambiar regulación y habilidades relacionales.' }], disclaimer: 'Los resultados de IE son para autoconocimiento y conversación. No los uses como base para diagnóstico, contratación o juicios definitivos sobre relaciones.' },
};

const c = content[locale] ?? content.en;
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
const quizJsonLd = buildQuizJsonLd({
  name: m.title,
  description: m.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  inLanguage: locale,
  questions: [],
});

---
<Layout title={m.title} description={m.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(quizJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="mx-auto max-w-2xl px-4 py-10">
    <EmotionalIntelligenceTest client:load locale={locale} />
    <section class="mt-10 border-t border-green-100 pt-8"><h2 class="text-2xl font-bold text-foreground">{c.introTitle}</h2><p class="mt-4 leading-8 text-green-800">{c.intro}</p></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-foreground">{c.conceptTitle}</h2><div class="mt-4 grid gap-4 md:grid-cols-3">{c.concepts.map((item) => (<article class="rounded-xl border border-green-100 bg-card p-4"><h3 class="font-semibold text-foreground">{item.title}</h3><p class="mt-2 text-sm leading-6 text-green-700">{item.body}</p></article>))}</div></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-foreground">{c.faqTitle}</h2><div class="mt-4 divide-y divide-green-100 rounded-xl border border-green-100 bg-card">{c.faqs.map((faq) => (<details class="group p-4"><summary class="cursor-pointer list-none font-semibold text-foreground">{faq.question}</summary><p class="mt-3 text-sm leading-6 text-green-700">{faq.answer}</p></details>))}</div></section>
    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>
    <RelatedTools locale={locale} tools={['empathy','angerStyle','innerStrength','selfEsteem']} current="eq" />
  <PrintReportButton locale={locale} />
  <TestSourceNote locale={locale} note={TEST_SOURCE_NOTES['eq']} />
  </div>
</Layout>
