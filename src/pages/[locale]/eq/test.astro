---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import EmotionalIntelligenceTest from '../../../components/tests/EmotionalIntelligenceTest';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '감성지능(EQ) 테스트 — 나의 EQ는?', description: '자기인식·자기조절·동기부여·공감·사회적 기술 5가지 영역으로 나의 감성지능을 측정하세요.' },
  en: { title: 'Emotional Intelligence (EQ) Test — What Is Your EQ?', description: 'Measure your EQ across self-awareness, self-regulation, motivation, empathy, and social skills.' },
  ja: { title: '感情知性(EQ)テスト — あなたのEQは？', description: '自己認識・自己調整・モチベーション・共感・社会的スキルの5領域で感情知性を測定します。' },
  cn: { title: '情商(EQ)测试 — 你的情商是多少？', description: '通过自我认知、自我调节、动力、共情和社交技能5个领域测量你的情商。' },
  fr: { title: "Test d'Intelligence Émotionnelle (QE) — Quel est votre QE?", description: "Mesurez votre QE selon la conscience de soi, l'autorégulation, la motivation, l'empathie et les compétences sociales." },
  es: { title: 'Test de Inteligencia Emocional (IE) — ¿Cuál es tu IE?', description: 'Mide tu IE en autoconciencia, autorregulación, motivación, empatía y habilidades sociales.' },
};
const m = meta[locale] ?? meta.en;
---
<Layout title={m.title} description={m.description} locale={locale}>
  <main class="mx-auto max-w-2xl px-4 py-10">
    <EmotionalIntelligenceTest client:load locale={locale} />
  </main>
</Layout>
