---
import Layout from '../../../layouts/Layout.astro';
import AmbientParticles from '../../../components/visual/AmbientParticles.astro';
import { LOCALES, localePath } from '../../../i18n';
import type { Locale } from '../../../i18n';
import WisdomNotes from '../../../components/shared/WisdomNotes.astro';
import MentalBoost from '../../../components/shared/MentalBoost.astro';
import TestIcon from '../../../components/shared/TestIcon.astro';
import { buildTestsByPath } from '../../../data/test-hub-directory';
import { testIconSrc } from '../../../data/test-icons';
import { QUESTION_LANES, LANE_BY_PATH, SEARCH_ONLY_PATHS, MOOD_BOUNDARY } from '../../../data/test-question-lanes';
import { Card, CardContent, CardHeader } from '../../../components/ui/card';
import { routeTransitionName } from '../../../lib/system/view-transition-name';
import {
  Item,
  ItemActions,
  ItemContent,
  ItemDescription,
  ItemGroup,
  ItemMedia,
  ItemTitle,
} from '../../../components/ui/item';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const title: Record<Locale, string> = {
  ko: '나를 알아보는 검사 — OIYO',
  en: 'Tests to Understand Yourself — OIYO',
  ja: '自分を知るテスト — OIYO',
  zh: '了解自己的测试 — OIYO',
  fr: 'Tests pour Mieux se Connaître — OIYO',
  es: 'Tests para Conocerte — OIYO',
};

const description: Record<Locale, string> = {
  ko: '성격, 관계, 일, 지금 마음 — 궁금한 질문에서 시작하는 무료 검사. MBTI, 에니어그램, 빅파이브, 애착유형 등.',
  en: 'Free tests that start from your question — personality, relationships, work, and how you are doing lately. MBTI, Enneagram, Big Five, attachment style.',
  ja: '性格・関係・仕事・今の心 — 気になる質問から始める無料テスト。MBTI、エニアグラム、ビッグファイブ、愛着タイプなど。',
  zh: '性格、关系、工作、此刻心情 — 从你的问题开始的免费测试。MBTI、九型人格、大五人格、依恋类型等。',
  fr: 'Tests gratuits qui partent de votre question : personnalité, relations, travail, état du moment. MBTI, Ennéagramme, Big Five, attachement.',
  es: 'Tests gratuitos que parten de tu pregunta: personalidad, relaciones, trabajo y cómo estás. MBTI, Eneagrama, Big Five, apego.',
};

const heading: Record<Locale, string> = {
  ko: '무엇이 궁금하세요?',
  en: 'What do you want to know?',
  ja: '何が気になりますか？',
  zh: '你想了解什么？',
  fr: 'Que voulez-vous savoir ?',
  es: '¿Qué quieres saber?',
};

const subheading: Record<Locale, string> = {
  ko: '척도 이름이 아니라 지금 궁금한 질문에서 시작하세요',
  en: 'Start from the question you have, not the name of a scale',
  ja: '尺度の名前ではなく、今の疑問から始めましょう',
  zh: '从你此刻的疑问开始，而不是量表的名字',
  fr: 'Partez de votre question, pas du nom d’une échelle',
  es: 'Empieza por tu pregunta, no por el nombre de una escala',
};

const moreInLane: Record<Locale, (count: number) => string> = {
  ko: (count) => `이 질문의 검사 ${count}개 더 보기`,
  en: (count) => `Show ${count} more tests for this question`,
  ja: (count) => `この質問のテストをあと${count}件見る`,
  zh: (count) => `查看此问题的另外${count}项测试`,
  fr: (count) => `Voir ${count} autres tests pour cette question`,
  es: (count) => `Ver ${count} pruebas más para esta pregunta`,
};

const searchCopy: Record<Locale, { label: string; hint: string; empty: string; count: string }> = {
  ko: { label: '이름으로 검사·도구 찾기', hint: '검사 이름이나 궁금한 주제를 입력하세요.', empty: '일치하는 항목이 없어요. 짧은 단어로 다시 찾아보세요.', count: '검색 결과 {count}개' },
  en: { label: 'Find a test or tool by name', hint: 'Enter a test name or a topic.', empty: 'No matches. Try a shorter search term.', count: '{count} results' },
  ja: { label: '名前でテスト・ツールを探す', hint: 'テスト名や気になるテーマを入力してください。', empty: '該当する項目がありません。短い言葉でお試しください。', count: '検索結果 {count}件' },
  zh: { label: '按名称查找测试或工具', hint: '输入测试名称或感兴趣的主题。', empty: '没有匹配项，请尝试更短的关键词。', count: '{count}项结果' },
  fr: { label: 'Trouver un test ou un outil par son nom', hint: 'Saisissez le nom d’un test ou un sujet.', empty: 'Aucun résultat. Essayez un terme plus court.', count: '{count} résultats' },
  es: { label: 'Buscar una prueba o herramienta por nombre', hint: 'Escribe el nombre de una prueba o un tema.', empty: 'Sin coincidencias. Prueba con una palabra más corta.', count: '{count} resultados' },
};


const testsByPath = buildTestsByPath(locale);

const testForPath = (path: string) => {
  const test = testsByPath.get(localePath(locale, path));
  if (!test) throw new Error(`Missing test directory entry: ${path}`);
  return test;
};

const lanes = QUESTION_LANES.map((lane) => ({
  ...lane,
  tests: Object.entries(LANE_BY_PATH)
    .filter(([, id]) => id === lane.id)
    .map(([path]) => testForPath(path)),
}));

const searchableTests = [...Object.keys(LANE_BY_PATH), ...Object.keys(SEARCH_ONLY_PATHS)]
  .map(testForPath);
const searchText = searchCopy[locale];

// 빈 분류는 렌더하지 않는다. 다만 조용히 비면 매핑이 끊긴 것이므로 빌드에서
// 드러나야 한다 — scripts/audit-tests-question-ia.mjs 가 이 계약을 강제한다.
const visibleLanes = lanes.filter((lane) => lane.tests.length > 0);

---


<Layout title={title[locale]} description={description[locale]} locale={locale}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-b from-green-50/80 to-white pt-8 pb-6 px-4">
    <AmbientParticles density={0.7} />
    <div class="relative max-w-2xl mx-auto text-center">
      <h1 class="text-3xl md:text-4xl font-serif font-black text-foreground mb-3 leading-tight">
        {heading[locale]}
      </h1>
      <p class="text-primary text-sm md:text-base leading-relaxed">
        {subheading[locale]}
      </p>
      <p class="mt-3">
        <a href={localePath(locale, '/achievements/')} class="text-sm font-bold text-green-800 underline">
          {locale === 'ko' ? '테스트 업적' : locale === 'ja' ? 'テスト実績' : locale === 'zh' ? '测试成就' : locale === 'fr' ? 'Succès des tests' : locale === 'es' ? 'Logros de tests' : 'Test achievements'}
        </a>
      </p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 pt-5">
    <details open id="test-search" class="rounded-xl border border-primary/15 bg-card px-4">
      <summary class="min-h-11 cursor-pointer py-3 text-sm font-semibold text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">{searchText.label}</summary>
      <div class="pb-4">
        <div data-search-control hidden>
          <label for="test-search-input" class="block pb-2 text-sm text-foreground">{searchText.hint}</label>
          <input id="test-search-input" type="search" autocomplete="off" class="w-full min-h-11 rounded-md border border-input bg-background px-3 py-2 text-base text-foreground placeholder:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" />
          <p data-search-status role="status" class="pt-3 text-sm text-muted-foreground" data-empty={searchText.empty} data-count={searchText.count}></p>
        </div>
        <ul data-search-results data-search-idle class="divide-y divide-primary/10">
          {searchableTests.map((test) => (
            <li data-search-entry data-search-text={`${test.title[locale]} ${test.desc[locale]}`}>
              <a href={test.href} class="flex min-h-11 items-center gap-3 rounded-md px-3 py-3 text-sm leading-relaxed text-foreground hover:bg-primary/5 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
                {(testIconSrc(test.href) || test.icon) && (
                  <span class={`inline-flex size-8 shrink-0 items-center justify-center rounded-md ${test.bg} p-1 text-base`} aria-hidden="true">
                    <TestIcon src={testIconSrc(test.href)} fallback={test.icon} />
                  </span>
                )}
                <span class="min-w-0">{test.title[locale]}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </details>
  </section>

  <nav aria-label={heading[locale]} class="max-w-5xl mx-auto px-4 pt-6 flex flex-wrap gap-2">
    {visibleLanes.map((lane) => (
      <a href={`#${lane.id}`} class="min-h-11 inline-flex items-center rounded-full border border-primary/20 px-4 text-sm font-medium text-primary hover:bg-primary/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
        {lane.label[locale]}
      </a>
    ))}
  </nav>

  <!-- 질문별 대표 3개, 나머지는 네이티브 details로 탐색한다. JS 없이도 링크가 남는다. -->
  <section class="max-w-5xl mx-auto px-4 py-10 grid gap-6 lg:grid-cols-2 lg:items-start">
    {visibleLanes.map((lane) => (
      <Card className="border-primary/10 bg-card/95 shadow-sm">
        <CardHeader className="border-b border-primary/10 pb-4">
          <h2 id={lane.id} class="scroll-mt-24 text-base font-semibold text-foreground">
            {lane.question[locale]}
          </h2>
          <p class="text-xs text-muted-foreground">{lane.label[locale]} · {lane.tests.length}</p>
          {lane.id === 'mood' && (
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{MOOD_BOUNDARY[locale]}</p>
          )}
        </CardHeader>
        <CardContent className="p-3">
          <ItemGroup className="gap-1">
            {lane.tests.slice(0, 3).map((test) => (
              <Item role="listitem" size="sm" className="p-0 hover:bg-primary/5 focus-within:ring-2 focus-within:ring-ring/40">
                <a href={test.href} class="group flex min-w-0 flex-1 items-start gap-3 rounded-md px-3 py-3 outline-none">
                  <ItemMedia className={`size-10 rounded-md ${test.bg} p-1 text-lg`} aria-hidden="true">
                    <TestIcon src={testIconSrc(test.href)} fallback={test.icon} />
                  </ItemMedia>
                  <ItemContent className="min-w-0">
                    <ItemTitle
                      className="text-foreground group-hover:text-primary"
                      style={{ viewTransitionName: routeTransitionName(test.href) }}
                    >
                      {test.title[locale]}
                    </ItemTitle>
                    <ItemDescription className="text-xs">
                      {test.desc[locale]}
                    </ItemDescription>
                  </ItemContent>
                  <ItemActions className="self-center text-sm font-medium text-primary" aria-hidden="true">
                    →
                  </ItemActions>
                </a>
              </Item>
            ))}
          </ItemGroup>
          {lane.tests.length > 3 && (
            <details class="mt-3 border-t border-primary/10">
              <summary class="min-h-11 cursor-pointer rounded-md px-3 py-3 text-sm font-semibold text-primary hover:bg-primary/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
                {moreInLane[locale](lane.tests.length - 3)}
              </summary>
              <ul class="divide-y divide-primary/10 px-1">
                {lane.tests.slice(3).map((test) => (
                  <li>
                    {/* 2026-09-29 A2: 아이콘을 상위 3개에만 그려서 펼친 목록용으로 만든 그림 12개가 한 번도 보이지 않았다. */}
                    <a href={test.href} class="flex min-h-11 items-center gap-3 rounded-md px-3 py-2 text-sm leading-relaxed text-foreground hover:bg-primary/5 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
                      <span class={`flex size-7 shrink-0 items-center justify-center rounded-md ${test.bg} p-0.5 text-sm`} aria-hidden="true">
                        <TestIcon src={testIconSrc(test.href)} fallback={test.icon || "•"} />
                      </span>
                      <span class="min-w-0">{test.title[locale]}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )}
        </CardContent>
      </Card>
    ))}
  </section>

  <section class="max-w-5xl mx-auto px-4 pb-12">
    <MentalBoost locale={locale} />
    <WisdomNotes topic="test-hub" locale={locale} />
  </section>
</Layout>

<script>
  function initTestSearch() {
    const root = document.querySelector<HTMLDetailsElement>('#test-search');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    const input = root.querySelector<HTMLInputElement>('#test-search-input')!;
    const control = root.querySelector<HTMLElement>('[data-search-control]')!;
    const status = root.querySelector<HTMLElement>('[data-search-status]')!;
    const results = root.querySelector<HTMLElement>('[data-search-results]')!;
    const normalize = (value: string) => value.normalize('NFKC').toLocaleLowerCase().trim();
    const entries = Array.from(root.querySelectorAll<HTMLElement>('[data-search-entry]'))
      .map((element) => ({ element, text: normalize(element.dataset.searchText || '') }));
    control.hidden = false;
    const filter = () => {
      const terms = normalize(input.value).split(/\s+/).filter(Boolean);
      let count = 0;
      for (const { element, text } of entries) {
        const match = terms.length > 0 && terms.every((term) => text.includes(term));
        element.hidden = !match;
        if (match) count++;
      }
      results.hidden = !terms.length;
      results.removeAttribute('data-search-idle');
      status.textContent = !terms.length ? '' : count
        ? status.dataset.count!.replace('{count}', String(count)) : status.dataset.empty!;
    };
    // 한 프레임에 한 번만 필터한다. 서버 렌더 링크는 JS가 없어도 펼쳐 볼 수 있다.
    let frame = 0;
    input.addEventListener('input', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(filter);
    });
    filter();
  }
  initTestSearch();
  document.addEventListener('astro:page-load', initTestSearch);
</script>
