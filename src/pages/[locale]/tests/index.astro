---

<Layout title={title[locale]} description={description[locale]} locale={locale}>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-green-50/80 to-white pt-16 pb-10 px-4">
    <div class="max-w-2xl mx-auto text-center">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/70 border border-green-100 text-green-700 text-xs font-bold mb-5">
        OIYO Tests
      </div>
      <h1 class="text-3xl md:text-4xl font-serif font-black text-green-950 mb-3 leading-tight">
        {heading[locale]}
      </h1>
      <p class="text-green-700 text-sm md:text-base leading-relaxed">
        {subheading[locale]}
      </p>
    </div>
  </section>

  <!-- Test categories -->
  <section class="max-w-5xl mx-auto px-4 py-10 space-y-12">
    {categories.map((cat) => (
      <div>
        <h2 class="text-sm font-bold text-green-500 uppercase tracking-widest mb-5">
          {cat.label[locale]}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {cat.tests.map((test) => (
            <a
              href={test.href}
              class="group block bg-white rounded-2xl border border-green-50 p-5 hover:border-green-200 hover:-translate-y-1 transition-all duration-200 shadow-sm hover:shadow-md"
            >
              <div class="flex items-start justify-between mb-3">
                <div class={`w-11 h-11 rounded-xl ${test.bg} flex items-center justify-center text-xl`}>
                  {test.icon}
                </div>
                {test.badge && (
                  <span class="text-xs font-semibold bg-green-50 text-green-600 px-2 py-0.5 rounded-full border border-green-100">
                    {test.badge}
                  </span>
                )}
              </div>
              <h3 class="font-bold text-green-950 mb-1 group-hover:text-green-700 transition-colors text-sm">
                {test.title[locale]}
              </h3>
              <p class="text-xs text-green-600 leading-relaxed">
                {test.desc[locale]}
              </p>
              <div class="mt-3 text-xs font-semibold text-green-500 group-hover:text-green-700 transition-colors">
                {startLabel[locale]}
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</Layout>
