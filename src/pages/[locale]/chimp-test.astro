---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import ChimpTest from '../../components/tests/ChimpTest';
import BlogDeepDive from '../../components/shared/BlogDeepDive.astro';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<string, { title: string; description: string }> = {
  ko: {
    title: "침팬지 테스트 — 당신은 침팬지보다 기억력이 좋은가?",
    description: "숫자를 순서대로 기억하고 클릭하는 기억력 테스트. 침팬지의 순간 기억력에 도전해보세요.",
  },
  en: {
    title: "Chimp Memory Test",
    description: "A memory test where you remember and click numbers in order. Challenge the legendary short-term memory of chimpanzees.",
  },
  ja: {
    title: "チンパンジーテスト — あなたはチンパンジーより記憶力がいい？",
    description: "数字を順番に記憶してクリックする記憶力テスト。チンパンジーの瞬間記憶力に挑戦しましょう。",
  },
  fr: {
    title: "Test de Mémoire Chimpanzé",
    description: "Un test de mémoire où vous mémorisez et cliquez des chiffres dans l'ordre. Défiez la légendaire mémoire à court terme des chimpanzés.",
  },
  es: {
    title: "Test de Memoria del Chimpancé",
    description: "Un test de memoria donde recuerdas y haces clic en números en orden. Desafía la legendaria memoria a corto plazo de los chimpancés.",
  },
  zh: {
    title: "黑猩猩记忆测试 — 你的记忆力比黑猩猩好吗？",
    description: "记住数字并按顺序点击的记忆力测试。挑战黑猩猩的瞬间记忆力。",
  },
};
const m = meta[locale] ?? meta.en ?? Object.values(meta)[0];
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <ChimpTest locale={locale as any} client:load />
    <BlogDeepDive slug="chimp-test" locale={locale} />
  </div>
</Layout>
