---
import Layout from '../../../layouts/Layout.astro';
import MentalBoost from '../../../components/shared/MentalBoost.astro';
import RelatedTools from '../../../components/shared/RelatedTools.astro';
import { LOCALES, localePath } from '../../../i18n';
import type { Locale } from '../../../i18n';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
type L = Locale;
const txt = (map: Record<L, string>) => map[locale] ?? map.en;

const meta = {
  title: txt({ ko: '습관 형성 과학 — 21일·66일·무한 반복의 진실', en: 'The Science of Habit Formation — 21 Days, 66 Days & the Truth', ja: '習慣形成の科学 — 21日·66日·無限反復の真実', zh: '习惯养成科学 — 21天、66天与无限重复的真相', fr: 'La Science des Habitudes — 21 Jours, 66 Jours & la Vérité', es: 'La Ciencia de la Formación de Hábitos — 21 Días, 66 Días y la Verdad' }),
  description: txt({ ko: '"21일이면 습관이 된다"는 말은 사실일까요? 행동과학이 밝혀낸 습관 형성의 실제 메커니즘과 지속 가능한 습관 만들기 가이드입니다.', en: 'Is "21 days to form a habit" true? A guide to the actual mechanisms of habit formation revealed by behavioral science, with practical steps for sustainable habits.', ja: '「21日で習慣になる」は本当でしょうか？行動科学が明らかにした習慣形成の実際のメカニズムと持続可能な習慣作りガイドです。', zh: '"21天就能养成习惯"是真的吗？行为科学揭示的习惯养成真实机制与可持续习惯指南。', fr: '"21 jours pour former une habitude" est-il vrai ? Un guide sur les vrais mécanismes de formation d\'habitudes révélés par la science comportementale.', es: '¿Es cierto que "21 días forman un hábito"? Una guía sobre los mecanismos reales de formación de hábitos revelados por la ciencia del comportamiento.' }),
};

interface Section {
  id: string;
  icon: string;
  title: Record<L, string>;
  content: Record<L, string>;
}

const sections: Section[] = [
  {
    id: 'myth',
    icon: '❌',
    title: { ko: '"21일의 법칙"은 잘못된 믿음입니다', en: '"21-Day Rule" Is a Myth', ja: '「21日の法則」は誤った信念です', zh: '"21天法则"是个误解', fr: 'La "règle des 21 jours" est un mythe', es: 'La "regla de los 21 días" es un mito' },
    content: { ko: '1960년대 성형외과 의사 맥스웰 말츠가 환자들이 새 얼굴에 익숙해지는 데 최소 21일이 걸린다고 언급한 것이 잘못 전달되어 "21일이면 습관이 된다"는 통념이 생겼습니다.\n\n2010년 유니버시티 칼리지 런던의 필리파 랠리 박사 연구에 따르면, 새로운 행동이 자동적으로 느껴질 때까지는 평균 66일(18~254일)이 걸렸습니다. 습관의 종류에 따라 범위가 매우 넓습니다:\n\n• 간단한 습관 (물 마시기, 비타민 복용): 18~21일\n• 중간 습관 (아침 스트레칭, 일기): 40~60일\n• 복잡한 습관 (운동, 명상): 60~254일\n\n결론: 21일이 아니라 최소 66일 이상을 목표로 설계하세요.', en: 'In the 1960s, plastic surgeon Maxwell Maltz noted his patients took "a minimum of 21 days" to get used to their new face — and this was misquoted into the popular belief that habits form in 21 days.\n\nA 2010 UCL study by Dr. Phillippa Lally found it takes an average of 66 days (range: 18–254 days) for a new behavior to feel automatic. The range varies widely by habit type:\n\n• Simple habits (drinking water, taking vitamins): 18–21 days\n• Medium habits (morning stretching, journaling): 40–60 days\n• Complex habits (exercise, meditation): 60–254 days\n\nConclusion: Don\'t plan for 21 days — plan for at least 66 days minimum.', ja: '1960年代に形成外科医マクスウェル・マルツが患者たちが新しい顔に慣れるのに「最低21日」かかると述べたことが誤って伝わり、「21日で習慣になる」という俗説が生まれました。\n\n2010年のUCLフィリッパ・ラリー博士の研究によると、新しい行動が自動的に感じられるまでには平均66日（18〜254日）かかりました。習慣の種類によって範囲は非常に広いです：\n\n·簡単な習慣（水を飲む、ビタミンを摂る）：18〜21日\n·中程度の習慣（朝のストレッチ、日記）：40〜60日\n·複雑な習慣（運動、瞑想）：60〜254日\n\n結論：21日ではなく、最低66日以上を目標に計画してください。', zh: '1960年代，整形外科医生麦克斯韦·马尔茨提到患者适应新面孔"至少需要21天"，这被误传为"21天就能养成习惯"的通俗说法。\n\n2010年伦敦大学学院菲利帕·拉利博士的研究发现，一个新行为变得自动需要平均66天（18-254天）。范围因习惯类型而异：\n\n·简单习惯（喝水、服用维生素）：18-21天\n·中等习惯（早晨拉伸、写日记）：40-60天\n·复杂习惯（运动、冥想）：60-254天\n\n结论：不要以21天为目标，至少要计划66天以上。', fr: 'Dans les années 1960, le chirurgien plastique Maxwell Maltz nota que ses patients mettaient "au moins 21 jours" pour s\'habituer à leur nouveau visage — ce qui fut mal cité et devint la croyance populaire des habitudes en 21 jours.\n\nUne étude UCL 2010 du Dr Phillippa Lally a trouvé qu\'il faut en moyenne 66 jours (plage : 18–254 jours) pour qu\'un nouveau comportement devienne automatique. La plage varie selon le type d\'habitude :\n\n· Habitudes simples (boire de l\'eau, prendre des vitamines) : 18–21 jours\n· Habitudes moyennes (stretching matinal, journal) : 40–60 jours\n· Habitudes complexes (exercice, méditation) : 60–254 jours\n\nConclusion : Ne planifiez pas 21 jours — planifiez au moins 66 jours minimum.', es: 'En los años 60, el cirujano plástico Maxwell Maltz notó que sus pacientes tardaban "un mínimo de 21 días" en acostumbrarse a su nueva cara — y esto fue mal citado convirtiéndose en la creencia popular de los hábitos en 21 días.\n\nUn estudio UCL 2010 del Dr. Phillippa Lally encontró que se necesitan en promedio 66 días (rango: 18–254 días) para que un nuevo comportamiento se sienta automático. El rango varía mucho según el tipo de hábito:\n\n· Hábitos simples (beber agua, tomar vitaminas): 18–21 días\n· Hábitos medios (estiramiento matutino, journaling): 40–60 días\n· Hábitos complejos (ejercicio, meditación): 60–254 días\n\nConclusión: No planifiques 21 días — planifica al menos 66 días mínimo.' },
  },
  {
    id: 'loop',
    icon: '🔄',
    title: { ko: '습관 루프 — 단서·루틴·보상', en: 'The Habit Loop — Cue, Routine, Reward', ja: '習慣ループ — 合図·ルーティン·報酬', zh: '习惯回路 — 提示·例行动作·奖励', fr: 'La Boucle de l\'Habitude — Signal, Routine, Récompense', es: 'El Bucle del Hábito — Señal, Rutina, Recompensa' },
    content: { ko: '찰스 두히그의 『습관의 힘』과 제임스 클리어의 『아주 작은 습관의 힘』은 모두 "단서 → 루틴 → 보상" 구조를 핵심으로 제시합니다.\n\n① 단서 (Cue): 행동을 촉발하는 트리거. 시간, 장소, 이전 행동, 감정, 사람.\n예: "아침 커피를 내리는 순간" → "독서 5분 시작"\n\n② 루틴 (Routine): 실제 행동. 최대한 구체적이고 단순하게 설계.\n예: "책을 펼치고 타이머 5분 설정"\n\n③ 보상 (Reward): 즉각적인 만족감. 뇌가 이 루프를 반복할 가치가 있다고 학습.\n예: "완료 체크마크 표시, 좋아하는 음악 재생"\n\n핵심 원칙: 루틴보다 보상이 더 중요합니다. 의지력이 아니라 보상 설계가 습관을 만듭니다.', en: 'Charles Duhigg\'s The Power of Habit and James Clear\'s Atomic Habits both present the "cue → routine → reward" structure as the core mechanism.\n\n① Cue: The trigger that initiates behavior. Time, location, preceding action, emotion, person.\nEx: "The moment I start brewing morning coffee" → "Begin 5 minutes of reading"\n\n② Routine: The actual action. Design it to be as specific and simple as possible.\nEx: "Open the book and set a 5-minute timer"\n\n③ Reward: Immediate satisfaction. The brain learns that repeating this loop is worth it.\nEx: "Mark the completion checkbox, play your favorite music"\n\nKey principle: The reward matters more than the routine. Habit design is about reward engineering, not willpower.', ja: 'チャールズ・デュヒッグの「習慣の力」とジェームズ・クリアーの「ジャンプスタート原則」はどちらも「合図→ルーティン→報酬」構造を核心として提示しています。\n\n①合図（Cue）：行動を引き起こすトリガー。時間、場所、前の行動、感情、人物。\n例：「朝のコーヒーを淹れる瞬間」→「5分読書開始」\n\n②ルーティン（Routine）：実際の行動。できるだけ具体的でシンプルに設計。\n例：「本を開いてタイマー5分設定」\n\n③報酬（Reward）：即時の満足感。脳がこのループを繰り返す価値があると学習。\n例：「完了チェックマーク表示、好きな音楽を再生」\n\n核心原則：ルーティンより報酬の方が重要です。意志力ではなく報酬設計が習慣を作ります。', zh: '查尔斯·都希格的《习惯的力量》和詹姆斯·克利尔的《微习惯》都将"提示→例行动作→奖励"结构作为核心机制。\n\n①提示（Cue）：触发行为的信号。时间、地点、前一个动作、情绪、人物。\n例："冲咖啡的那一刻"→"开始阅读5分钟"\n\n②例行动作（Routine）：实际行为。尽可能具体简单地设计。\n例："打开书，设定5分钟计时器"\n\n③奖励（Reward）：即时满足感。大脑学习到重复这个回路是值得的。\n例："打上完成勾，播放喜爱的音乐"\n\n核心原则：奖励比例行动作更重要。是奖励设计而非意志力创造习惯。', fr: 'The Power of Habit de Charles Duhigg et Atomic Habits de James Clear présentent tous deux la structure "signal → routine → récompense" comme mécanisme central.\n\n① Signal (Cue) : Le déclencheur qui initie le comportement. Heure, lieu, action précédente, émotion, personne.\nEx : "Le moment où je commence à préparer mon café matinal" → "Commencer 5 minutes de lecture"\n\n② Routine : L\'action réelle. Concevez-la aussi simple et spécifique que possible.\nEx : "Ouvrir le livre et régler un minuteur de 5 minutes"\n\n③ Récompense : Satisfaction immédiate. Le cerveau apprend que répéter cette boucle en vaut la peine.\nEx : "Cocher la case de complétion, jouer de la musique préférée"\n\nPrincipe clé : La récompense compte plus que la routine. La conception de l\'habitude concerne l\'ingénierie des récompenses, pas la volonté.', es: 'El poder de los hábitos de Charles Duhigg y Hábitos atómicos de James Clear presentan la estructura "señal → rutina → recompensa" como mecanismo central.\n\n① Señal (Cue): El disparador que inicia el comportamiento. Hora, lugar, acción anterior, emoción, persona.\nEj: "El momento en que empiezo a preparar el café de la mañana" → "Comenzar 5 minutos de lectura"\n\n② Rutina: La acción real. Diseñala tan específica y simple como sea posible.\nEj: "Abrir el libro y configurar un temporizador de 5 minutos"\n\n③ Recompensa: Satisfacción inmediata. El cerebro aprende que vale la pena repetir este bucle.\nEj: "Marcar la casilla de completado, reproducir música favorita"\n\nPrincipio clave: La recompensa importa más que la rutina. La formación de hábitos consiste en diseñar recompensas, no en fuerza de voluntad.' },
  },
  {
    id: 'stacking',
    icon: '🧱',
    title: { ko: '습관 쌓기 (Habit Stacking)', en: 'Habit Stacking', ja: '習慣スタッキング', zh: '习惯堆叠', fr: 'Empilage d\'habitudes (Habit Stacking)', es: 'Apilamiento de hábitos (Habit Stacking)' },
    content: { ko: '습관 쌓기는 기존의 견고한 습관 위에 새 습관을 연결하는 방식입니다. 제임스 클리어가 공식화한 방법:\n\n"[기존 습관]을 한 후에, [새 습관]을 한다."\n\n예시:\n• "아침에 이를 닦은 후 → 스쿼트 10회"\n• "점심 식사를 마친 후 → 5분 산책"\n• "잠자리에 누운 후 → 독서 10페이지"\n• "퇴근 후 집에 들어오는 순간 → 운동복 입기"\n\n왜 효과적인가: 기존 습관은 이미 강력한 신경 경로를 가지고 있습니다. 새 행동을 그 경로에 연결하면 별도의 의지력이 필요 없습니다. 시작 마찰(activation energy)을 최소화하는 것이 핵심입니다.', en: 'Habit stacking connects a new habit to an existing, well-established one. James Clear\'s formula:\n\n"After I [EXISTING HABIT], I will [NEW HABIT]."\n\nExamples:\n• "After I brush my teeth in the morning → 10 squats"\n• "After I finish lunch → 5-minute walk"\n• "After I get into bed → read 10 pages"\n• "After I arrive home from work → put on workout clothes"\n\nWhy it works: Existing habits already have strong neural pathways. Attaching a new behavior to those pathways requires no extra willpower. Minimizing activation energy (the start friction) is key.', ja: '習慣スタッキングは既存の確立した習慣の上に新しい習慣を連結する方式です。ジェームズ・クリアーが公式化した方法：\n\n「[既存の習慣]をした後に、[新しい習慣]をする。」\n\n例：\n·「朝に歯を磨いた後→スクワット10回」\n·「昼食を終えた後→5分散歩」\n·「床に就いた後→読書10ページ」\n·「仕事から帰って家に入る瞬間→運動着を着る」\n\nなぜ効果的か：既存の習慣はすでに強力な神経経路を持っています。新しい行動をその経路に連結すれば、別の意志力が必要ありません。開始摩擦（activation energy）を最小化することが核心です。', zh: '习惯堆叠是将新习惯连接到已有的、根深蒂固习惯上的方式。詹姆斯·克利尔公式化的方法：\n\n"在我[现有习惯]之后，我将[新习惯]。"\n\n例子：\n·"早上刷牙之后→做10个深蹲"\n·"午餐结束后→散步5分钟"\n·"躺到床上后→阅读10页"\n·"下班回家的那一刻→换上运动服"\n\n为什么有效：现有习惯已经有了强大的神经通路。将新行为连接到这些通路上，不需要额外的意志力。最小化启动摩擦（activation energy）是关键。', fr: 'L\'empilage d\'habitudes connecte une nouvelle habitude à une habitude existante bien établie. La formule de James Clear :\n\n"Après [HABITUDE EXISTANTE], je ferai [NOUVELLE HABITUDE]."\n\nExemples :\n· "Après me brosser les dents → 10 squats"\n· "Après finir le déjeuner → marche de 5 minutes"\n· "Après me coucher → lire 10 pages"\n· "Après être rentré du travail → mettre les vêtements de sport"\n\nPourquoi ça marche : Les habitudes existantes ont déjà des voies neuronales solides. Attacher un nouveau comportement à ces voies ne nécessite aucune volonté supplémentaire. Minimiser l\'énergie d\'activation (la friction de départ) est essentiel.', es: 'El apilamiento de hábitos conecta un nuevo hábito a uno existente y bien establecido. La fórmula de James Clear:\n\n"Después de [HÁBITO EXISTENTE], haré [NUEVO HÁBITO]."\n\nEjemplos:\n· "Después de cepillarme los dientes → 10 sentadillas"\n· "Después de terminar el almuerzo → caminata de 5 minutos"\n· "Después de acostarme → leer 10 páginas"\n· "Después de llegar a casa del trabajo → ponerme ropa de entrenamiento"\n\nPor qué funciona: Los hábitos existentes ya tienen fuertes vías neuronales. Adjuntar un nuevo comportamiento a esas vías no requiere fuerza de voluntad extra. Minimizar la energía de activación (la fricción de inicio) es clave.' },
  },
  {
    id: 'identity',
    icon: '🪞',
    title: { ko: '정체성 기반 습관 — 가장 강력한 방법', en: 'Identity-Based Habits — The Most Powerful Method', ja: 'アイデンティティベースの習慣 — 最も強力な方法', zh: '基于身份的习惯 — 最强大的方法', fr: 'Habitudes basées sur l\'identité — La méthode la plus puissante', es: 'Hábitos basados en identidad — El método más poderoso' },
    content: { ko: '제임스 클리어의 핵심 통찰: 습관을 결과가 아니라 정체성에서 출발하세요.\n\n❌ 약한 방식: "나는 매일 달리기를 하고 싶다."\n✅ 강력한 방식: "나는 러너다. 러너는 달린다."\n\n❌ "나는 책을 더 많이 읽고 싶다."\n✅ "나는 독서가다. 독서가는 매일 책을 읽는다."\n\n행동의 변화보다 존재의 변화가 더 지속됩니다. 정체성이 먼저 바뀌면 행동은 자연스럽게 따라옵니다.\n\n실천법: 새 습관을 시작할 때 스스로에게 물어보세요 — "이 행동을 꾸준히 하는 사람은 어떤 사람인가? 나는 그런 사람인가? 그런 사람이 되고 싶은가?"', en: 'James Clear\'s core insight: Start habits from identity, not outcomes.\n\n❌ Weak approach: "I want to run every day."\n✅ Powerful approach: "I am a runner. Runners run."\n\n❌ "I want to read more books."\n✅ "I am a reader. Readers read every day."\n\nChanging your being lasts longer than changing your behavior. When identity shifts first, behavior naturally follows.\n\nPractice: When starting a new habit, ask yourself — "What kind of person consistently does this? Am I that person? Do I want to become that person?"', ja: 'ジェームズ・クリアーの核心的洞察：習慣を結果からではなくアイデンティティから出発させましょう。\n\n❌弱い方式：「私は毎日走りたい。」\n✅強力な方式：「私はランナーだ。ランナーは走る。」\n\n❌「私はもっと本を読みたい。」\n✅「私は読書家だ。読書家は毎日本を読む。」\n\n行動の変化より存在の変化の方が持続します。アイデンティティが先に変わると、行動は自然についてきます。\n\n実践法：新しい習慣を始める際に自分に問いかけましょう — 「この行動を続ける人はどんな人か？自分はその人か？そんな人になりたいか？」', zh: '詹姆斯·克利尔的核心洞察：从身份而非结果出发养成习惯。\n\n❌弱的方式："我想每天跑步。"\n✅强大的方式："我是跑者。跑者就是跑步的人。"\n\n❌"我想多读书。"\n✅"我是读书人。读书人每天阅读。"\n\n改变存在比改变行为更持久。当身份首先改变，行为自然随之而来。\n\n实践方法：开始新习惯时问自己——"持续做这件事的人是什么样的人？我是这样的人吗？我想成为这样的人吗？"', fr: 'L\'insight central de James Clear : Commencez les habitudes depuis l\'identité, pas les résultats.\n\n❌ Approche faible : "Je veux courir tous les jours."\n✅ Approche puissante : "Je suis coureur. Les coureurs courent."\n\n❌ "Je veux lire plus de livres."\n✅ "Je suis lecteur. Les lecteurs lisent chaque jour."\n\nChanger son être dure plus longtemps que changer son comportement. Quand l\'identité change en premier, le comportement suit naturellement.\n\nPratique : En commençant une nouvelle habitude, demandez-vous — "Quel type de personne fait cela régulièrement ? Suis-je cette personne ? Veux-je le devenir ?"', es: 'La perspectiva central de James Clear: Inicia los hábitos desde la identidad, no los resultados.\n\n❌ Enfoque débil: "Quiero correr todos los días."\n✅ Enfoque poderoso: "Soy corredor. Los corredores corren."\n\n❌ "Quiero leer más libros."\n✅ "Soy lector. Los lectores leen todos los días."\n\nCambiar tu ser dura más que cambiar tu comportamiento. Cuando la identidad cambia primero, el comportamiento la sigue naturalmente.\n\nPráctica: Al iniciar un nuevo hábito, pregúntate — "¿Qué tipo de persona hace esto consistentemente? ¿Soy esa persona? ¿Quiero convertirme en esa persona?"' },
  },
  {
    id: 'rules',
    icon: '📋',
    title: { ko: '지속 가능한 습관의 5가지 설계 원칙', en: '5 Design Principles for Sustainable Habits', ja: '持続可能な習慣の5つの設計原則', zh: '可持续习惯的5个设计原则', fr: '5 principes de conception pour des habitudes durables', es: '5 principios de diseño para hábitos sostenibles' },
    content: { ko: '① 2분 규칙: 새 습관은 2분 이내로 시작. "운동하기" → "운동복 입기만". 시작의 마찰을 줄여야 합니다.\n\n② 명확성 원칙: 언제·어디서·어떻게를 구체적으로 정하세요. "운동할 것이다" (X) → "매일 오전 7시 집 앞 공원에서 20분 걷는다" (O)\n\n③ 2일 규칙: 하루 빠지는 건 괜찮습니다. 단, 절대로 이틀 연속 빠지지 않습니다. 연속성이 깨지는 것은 한 번 빠졌을 때가 아니라 두 번 연속 빠졌을 때입니다.\n\n④ 최소 습관 (Never Zero): 아무리 힘든 날도 1% 버전은 실행합니다. 운동 못 하는 날 → "팔굽혀펴기 1개만". 책 못 읽는 날 → "첫 페이지 1줄만". 완전히 끊기는 것보다 1%가 낫습니다.\n\n⑤ 환경 설계: 좋은 습관의 마찰을 줄이고, 나쁜 습관의 마찰을 늘리세요. 물 마시기 → 책상 위에 물병 항상 두기. 스마트폰 줄이기 → 충전기를 침실 밖에 두기.', en: '① The 2-minute rule: New habits should be startable in under 2 minutes. "Exercise" → "Just put on workout clothes." Reduce the friction of starting.\n\n② Clarity principle: Specify exactly when, where, and how. "I will exercise" (X) → "I will walk 20 minutes at the park in front of my house at 7 AM every day" (O)\n\n③ The 2-day rule: Missing one day is okay. But never miss two days in a row. Continuity breaks not when you miss once, but when you miss twice consecutively.\n\n④ Minimum habit (Never Zero): Execute the 1% version even on the hardest days. Can\'t exercise today → "just 1 push-up." Can\'t read today → "just the first line of page 1." 1% beats nothing every time.\n\n⑤ Environment design: Reduce friction for good habits, increase friction for bad ones. Drink more water → Always keep a water bottle on your desk. Reduce phone time → Keep the charger outside the bedroom.', ja: '①2分ルール：新しい習慣は2分以内に始められるように。「運動する」→「運動着を着るだけ」。始まりの摩擦を減らすことが大切です。\n\n②明確性の原則：いつ·どこで·どのようにを具体的に決めましょう。「運動する」（×）→「毎日午前7時に自宅前の公園で20分歩く」（○）\n\n③2日ルール：1日休むのは大丈夫です。ただし、絶対に2日連続で休みません。連続性が壊れるのは1回休んだ時ではなく、2回連続休んだ時です。\n\n④最小習慣（Never Zero）：どんなに辛い日でも1%バージョンは実行します。運動できない日→「腕立て伏せ1回だけ」。本が読めない日→「最初のページの1行だけ」。完全に中断するより1%の方がましです。\n\n⑤環境設計：良い習慣の摩擦を減らし、悪い習慣の摩擦を増やしましょう。水を飲む→机の上に常に水筒を置く。スマートフォンを減らす→充電器を寝室の外に置く。', zh: '①2分钟规则：新习惯要在2分钟内能开始。"运动"→"只是穿上运动服"。减少开始的摩擦。\n\n②清晰原则：具体规定何时、何地、如何做。"我要运动"（×）→"每天上午7点在家门口公园走20分钟"（○）\n\n③两天规则：偶尔中断一天没关系。但绝不连续中断两天。连续性不是在中断一次时破坏，而是在连续中断两次时破坏。\n\n④最小习惯（永不归零）：即使最困难的一天也要执行1%版本。今天不能运动→"只做1个俯卧撑"。今天不能阅读→"只读第一页第一行"。1%总比完全停止要好。\n\n⑤环境设计：减少好习惯的摩擦，增加坏习惯的摩擦。多喝水→在桌上始终放一个水瓶。减少手机→把充电器放在卧室外面。', fr: '① La règle des 2 minutes : Les nouvelles habitudes doivent être démarrables en moins de 2 minutes. "Faire de l\'exercice" → "Juste mettre les vêtements de sport." Réduisez la friction du démarrage.\n\n② Principe de clarté : Spécifiez exactement quand, où et comment. "Je vais faire de l\'exercice" (X) → "Je marcherai 20 minutes au parc devant ma maison à 7h chaque jour" (O)\n\n③ La règle des 2 jours : Rater un jour, c\'est OK. Mais ne jamais rater deux jours de suite. La continuité se brise non pas quand on rate une fois, mais deux fois consécutives.\n\n④ Habitude minimale (Never Zero) : Exécutez la version 1% même les jours les plus difficiles. Ne peut pas faire de sport → "juste 1 pompe." Ne peut pas lire → "juste la première ligne." 1% bat toujours rien.\n\n⑤ Conception de l\'environnement : Réduisez la friction pour les bonnes habitudes, augmentez-la pour les mauvaises. Boire plus d\'eau → Toujours garder une bouteille sur le bureau. Réduire le temps de téléphone → Mettre le chargeur hors de la chambre.', es: '① La regla de los 2 minutos: Los nuevos hábitos deben poder iniciarse en menos de 2 minutos. "Hacer ejercicio" → "Solo ponerme la ropa de entrenamiento." Reduce la fricción del inicio.\n\n② Principio de claridad: Especifica exactamente cuándo, dónde y cómo. "Voy a ejercitarme" (X) → "Caminaré 20 minutos en el parque frente a mi casa a las 7 AM todos los días" (O)\n\n③ La regla de los 2 días: Saltarse un día está bien. Pero nunca saltarse dos días seguidos. La continuidad no se rompe cuando fallas una vez, sino cuando fallas dos veces consecutivas.\n\n④ Hábito mínimo (Nunca Cero): Ejecuta la versión del 1% incluso los días más difíciles. No puedes ejercitarte hoy → "solo 1 flexión." No puedes leer hoy → "solo la primera línea." El 1% siempre supera a nada.\n\n⑤ Diseño del entorno: Reduce la fricción para los buenos hábitos, aumenta la fricción para los malos. Beber más agua → Siempre tener una botella en el escritorio. Reducir tiempo en el teléfono → Poner el cargador fuera del dormitorio.' },
  },
];

