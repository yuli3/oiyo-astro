---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import TypingTest from '../../components/tests/TypingTest';
import BlogDeepDive from '../../components/shared/BlogDeepDive.astro';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<string, { title: string; description: string }> = {
  ko: {
    title: "타이핑 속도 테스트 — WPM 측정",
    description: "15초·30초·1분 모드로 타이핑 속도(WPM)와 정확도를 즉시 측정해보세요.",
  },
  en: {
    title: "Typing Speed Test — Measure Your WPM",
    description: "Test your typing speed and accuracy in 15s, 30s or 1-minute mode. Track WPM, accuracy, and errors in real time.",
  },
  ja: {
    title: "タイピング速度テスト — WPM測定",
    description: "15秒・30秒・1分モードでタイピング速度(WPM)と正確率を即時測定できます。",
  },
  fr: {
    title: "Test de vitesse de frappe — Mesurez votre WPM",
    description: "Testez votre vitesse et précision de frappe en mode 15s, 30s ou 1 minute. Suivi en temps réel.",
  },
  es: {
    title: "Test de velocidad de escritura — Mide tu PPM",
    description: "Prueba tu velocidad y precisión de escritura en modo 15s, 30s o 1 minuto. Seguimiento en tiempo real.",
  },
  zh: {
    title: "打字速度测试 — 测量你的WPM",
    description: "在15秒、30秒或1分钟模式下测试你的打字速度和准确率，实时追踪WPM。",
  },
};
const m = meta[locale] ?? meta.en ?? Object.values(meta)[0];
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <TypingTest locale={locale as any} client:load />
    <BlogDeepDive slug="typing-test" locale={locale} />
  </div>
</Layout>
