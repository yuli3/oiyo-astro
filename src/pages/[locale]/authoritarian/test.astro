---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES, localePath } from '../../../i18n';
import type { Locale } from '../../../i18n';
import AuthoritarianScaleTest from '../../../components/tests/AuthoritarianScaleTest';
import RelatedTools from '../../../components/shared/RelatedTools.astro';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: '권위주의 성격 척도 테스트 — F-Scale 현대화 버전',
    description: '권위 복종·공격 성향·관습 고수·체제 정당화 4차원으로 나의 권위주의 성향을 측정합니다. 자기 이해를 위한 심리 척도 테스트.',
  },
  en: {
    title: 'Authoritarian Personality Scale Test — Modernized F-Scale',
    description: 'Measure your authoritarian tendencies across 4 dimensions: Submission, Aggression, Conventionalism, and System Justification. A self-understanding psychological scale.',
  },
  ja: {
    title: '権威主義的性格尺度テスト — Fスケール現代化版',
    description: '権威服従·攻撃傾向·慣習固執·体制正当化の4次元で権威主義傾向を測定。自己理解のための心理尺度テスト。',
  },
  zh: {
    title: '威权主义人格量表测试 — F量表现代化版本',
    description: '从权威服从、权威攻击、传统主义、体制正当化4个维度测量你的威权主义倾向。用于自我理解的心理量表测试。',
  },
  fr: {
    title: 'Test d\'échelle de personnalité autoritaire — F-Scale modernisé',
    description: 'Mesurez vos tendances autoritaires sur 4 dimensions : soumission, agression, conventionnalisme et justification du système. Une échelle psychologique d\'auto-compréhension.',
  },
  es: {
    title: 'Test de Escala de Personalidad Autoritaria — F-Scale modernizado',
    description: 'Mide tus tendencias autoritarias en 4 dimensiones: sumisión, agresión, convencionalismo y justificación del sistema. Una escala psicológica de autocomprensión.',
  },
};

const m = meta[locale] ?? meta.en;

const intro: Record<Locale, { heading: string; body: string; dims: string[] }> = {
  ko: {
    heading: '나는 얼마나 권위주의적인가?',
    body: '1950년 아도르노의 F-Scale(파시즘 척도)을 현대화한 버전입니다. 정치적 판단이 아닌 순수한 자기 이해를 위한 심리 측정 도구입니다. 20문항, 4개 차원으로 측정합니다.',
    dims: ['1. 권위 복종 — 권위자·제도를 비판 없이 따르는 경향', '2. 권위적 공격 — 규범 이탈자를 강하게 처벌하려는 경향', '3. 관습 고수 — 전통·관습에 강하게 의존하는 경향', '4. 체제 정당화 — 현 사회 질서가 공정하다고 믿는 경향'],
  },
  en: {
    heading: 'How authoritarian am I?',
    body: 'A modernized version of Adorno\'s 1950 F-Scale (Fascism Scale). This is a psychological measurement tool purely for self-understanding, not political judgment. 20 questions across 4 dimensions.',
    dims: ['1. Authoritarian Submission — Uncritical deference to authority figures', '2. Authoritarian Aggression — Tendency to harshly punish norm-violators', '3. Conventionalism — Heavy reliance on tradition and social norms', '4. System Justification — Belief that the current social order is fair'],
  },
  ja: {
    heading: '私はどれくらい権威主義的か？',
    body: '1950年のアドルノのFスケール（ファシズム尺度）を現代化したバージョンです。政治的判断ではなく、純粋な自己理解のための心理測定ツールです。20問、4次元で測定します。',
    dims: ['1. 権威服従 — 権威者·制度を批判なく従う傾向', '2. 権威的攻撃 — 規範逸脱者を強く処罰しようとする傾向', '3. 慣習固執 — 伝統·慣習に強く依存する傾向', '4. 体制正当化 — 現社会秩序が公正だと信じる傾向'],
  },
  zh: {
    heading: '我有多威权主义？',
    body: '这是阿多诺1950年F量表（法西斯主义量表）的现代化版本。这是一个纯粹用于自我理解的心理测量工具，不作政治判断。20道题，4个维度。',
    dims: ['1. 权威服从 — 不加批判地服从权威人物的倾向', '2. 权威攻击 — 强烈惩罚违规者的倾向', '3. 传统主义 — 对传统和社会规范的强烈依赖', '4. 体制正当化 — 相信现有社会秩序公正的倾向'],
  },
  fr: {
    heading: 'À quel point suis-je autoritaire ?',
    body: 'Une version modernisée du F-Scale d\'Adorno de 1950 (échelle du Fascisme). C\'est un outil de mesure psychologique pour la compréhension de soi, non un jugement politique. 20 questions, 4 dimensions.',
    dims: ['1. Soumission autoritaire — Déférence inconditionnelle aux figures d\'autorité', '2. Agression autoritaire — Tendance à punir sévèrement les déviants', '3. Conventionnalisme — Forte dépendance aux traditions et normes sociales', '4. Justification du système — Croyance en la légitimité de l\'ordre social'],
  },
  es: {
    heading: '¿Cuánto soy autoritario?',
    body: 'Una versión modernizada de la Escala F de Adorno de 1950 (Escala del Fascismo). Es una herramienta de medición psicológica para el autoconocimiento, no un juicio político. 20 preguntas, 4 dimensiones.',
    dims: ['1. Sumisión autoritaria — Deferencia acrítica a figuras de autoridad', '2. Agresión autoritaria — Tendencia a castigar duramente a quienes violan normas', '3. Convencionalismo — Fuerte dependencia de tradiciones y normas sociales', '4. Justificación del sistema — Creencia en la legitimidad del orden social actual'],
  },
};

const intro_ = intro[locale] ?? intro.en;

const content: Record<Locale, { introTitle: string; intro: string; conceptTitle: string; concepts: { title: string; body: string }[]; faqTitle: string; faqs: { question: string; answer: string }[]; disclaimer: string; }> = {
  ko: { introTitle: '권위주의 성향은 사람을 단정하는 라벨이 아니라 권위와 질서를 바라보는 심리적 성향을 보는 렌즈입니다', intro: '권위주의 성향 테스트는 권위 복종, 규범 위반에 대한 반응, 관습 고수, 체제 정당화 성향을 살펴봅니다. 결과는 특정 정치 입장을 평가하지 않고, 권위와 안정에 대한 나의 반응 방식을 중립적으로 이해하기 위한 참고입니다.', conceptTitle: '권위주의 성향을 읽는 세 가지 관점', concepts: [{ title: '권위와 신뢰', body: '권위를 신뢰하는 방식은 안정감, 책임, 비판적 거리와 함께 읽어야 합니다.' }, { title: '규범과 처벌', body: '규범을 지키려는 마음과 위반에 대한 반응 강도를 구분해 봅니다.' }, { title: '중립적 탐색', body: '결과는 특정 정치 입장을 지지하거나 비판하지 않고 성향을 살피는 자료입니다.' }], faqTitle: '자주 묻는 질문', faqs: [{ question: '이 결과는 정치 성향을 평가하나요?', answer: '아니요. 특정 입장을 옳거나 그르다고 말하지 않습니다. 권위, 규범, 질서에 대한 심리적 반응을 중립적으로 정리합니다.' }, { question: '결과가 높으면 나쁜 뜻인가요?', answer: '그렇지 않습니다. 점수는 맥락을 읽는 단서일 뿐이며, 안정과 질서를 중시하는 방식이 어떤 장단점을 갖는지 살펴보는 데 쓰입니다.' }, { question: '결과는 바뀔 수 있나요?', answer: '네. 사회적 경험, 책임의 위치, 스트레스 수준에 따라 권위와 규범을 대하는 방식은 달라질 수 있습니다.' }], disclaimer: '권위주의 성향 테스트 결과는 자기 이해와 대화를 위한 참고입니다. 진단, 채용, 정치적 판단, 관계의 단정적 판단 근거로 사용하지 마세요.' },
  en: { introTitle: 'Authoritarian tendency is a lens for attitudes toward authority and order, not a label that defines you', intro: 'The authoritarian tendency test looks at submission to authority, reactions to norm violation, conventionalism, and system justification. The result does not evaluate any political stance; it neutrally describes how you respond to authority and stability.', conceptTitle: 'Three ways to read authoritarian tendency', concepts: [{ title: 'Authority and trust', body: 'Trust in authority is best read alongside stability, responsibility, and critical distance.' }, { title: 'Norms and sanction', body: 'It separates respect for norms from the intensity of reactions to violations.' }, { title: 'Neutral exploration', body: 'The result explores tendencies without endorsing or disparaging any political stance.' }], faqTitle: 'Frequently asked questions', faqs: [{ question: 'Does this evaluate political beliefs?', answer: 'No. It does not call any stance right or wrong. It neutrally summarizes psychological responses to authority, norms, and order.' }, { question: 'Is a higher result bad?', answer: 'Not by itself. The score is a contextual clue for reflecting on how valuing stability and order can carry both strengths and costs.' }, { question: 'Can the result change?', answer: 'Yes. Social experience, responsibility, and stress can shift how someone relates to authority and norms.' }], disclaimer: 'Authoritarian tendency results are for self-understanding and conversation. Do not use them as a basis for diagnosis, hiring, political judgment, or definitive relationship judgments.' },
  ja: { introTitle: '権威主義傾向は人を決めつけるラベルではなく、権威と秩序を見る心理的傾向のレンズです', intro: '権威主義傾向テストは権威服従、規範違反への反応、慣習、体制正当化の傾向を見ます。結果は特定の政治的立場を評価せず、権威と安定への反応を中立的に理解する参考です。', conceptTitle: '権威主義傾向を読む三つの視点', concepts: [{ title: '権威と信頼', body: '権威への信頼は安定感、責任、批判的距離と一緒に読む必要があります。' }, { title: '規範と反応', body: '規範を重んじる気持ちと、違反への反応の強さを分けて見ます。' }, { title: '中立的な探索', body: '結果は特定の政治的立場を支持も否定もせず、傾向を見つめる資料です。' }], faqTitle: 'よくある質問', faqs: [{ question: '政治的信条を評価しますか？', answer: 'いいえ。どの立場が正しい、間違っているとは言いません。権威、規範、秩序への心理的反応を中立的に整理します。' }, { question: '高い結果は悪い意味ですか？', answer: 'それだけで悪いとは言えません。安定や秩序を重んじる姿勢の強みと負担を考えるための文脈情報です。' }, { question: '結果は変わりますか？', answer: '変わります。社会的経験、責任の位置、ストレスによって権威や規範への向き合い方は変化します。' }], disclaimer: '権威主義傾向テストの結果は自己理解と対話のための参考です。診断、採用、政治的判断、人間関係の断定的判断には使わないでください。' },
  zh: { introTitle: '威权主义倾向是观察你看待权威与秩序的心理镜片，不是定义人的标签', intro: '威权主义倾向测试观察权威服从、对规范违反的反应、传统主义与体制正当化。结果不评价任何政治立场，只是中立整理你对权威和稳定的反应方式。', conceptTitle: '理解威权主义倾向的三个角度', concepts: [{ title: '权威与信任', body: '对权威的信任应和稳定感、责任感及批判距离一起理解。' }, { title: '规范与反应', body: '区分重视规范的态度，以及对违规行为反应的强度。' }, { title: '中立探索', body: '结果用于观察倾向，不支持也不贬低任何政治立场。' }], faqTitle: '常见问题', faqs: [{ question: '这个结果会评价政治信念吗？', answer: '不会。它不判断任何立场对错，只是中立整理你对权威、规范和秩序的心理反应。' }, { question: '结果较高就是不好吗？', answer: '不是。分数只是情境线索，用来思考重视稳定与秩序可能带来的优势和代价。' }, { question: '结果会改变吗？', answer: '会。社会经验、责任位置和压力水平都会改变一个人面对权威与规范的方式。' }], disclaimer: '威权主义倾向测试结果仅用于自我理解与对话，请勿作为诊断、招聘、政治判断或关系定论的依据。' },
  fr: { introTitle: 'La tendance autoritaire est une lentille sur l’autorité et l’ordre, pas une étiquette qui vous définit', intro: 'Le test de tendance autoritaire observe la soumission à l’autorité, les réactions aux écarts de norme, le conventionnalisme et la justification du système. Le résultat n’évalue aucune position politique; il décrit ces réponses de façon neutre.', conceptTitle: 'Trois façons de lire la tendance autoritaire', concepts: [{ title: 'Autorité et confiance', body: 'La confiance envers l’autorité se lit avec stabilité, responsabilité et distance critique.' }, { title: 'Normes et sanction', body: 'On distingue l’attachement aux normes de l’intensité des réactions aux écarts.' }, { title: 'Exploration neutre', body: 'Le résultat explore des tendances sans soutenir ni dénigrer une position politique.' }], faqTitle: 'Questions fréquentes', faqs: [{ question: 'Le test évalue-t-il des opinions politiques ?', answer: 'Non. Il ne juge aucune position comme bonne ou mauvaise. Il résume de façon neutre des réponses psychologiques à l’autorité, aux normes et à l’ordre.' }, { question: 'Un résultat élevé est-il mauvais ?', answer: 'Pas en soi. Le score sert de repère pour réfléchir aux forces et aux coûts possibles d’un besoin de stabilité et d’ordre.' }, { question: 'Le résultat peut-il changer ?', answer: 'Oui. Expériences sociales, responsabilités et stress peuvent modifier le rapport à l’autorité et aux normes.' }], disclaimer: 'Les résultats du test de tendance autoritaire servent à la compréhension de soi et au dialogue. Ne les utilisez pas comme base de diagnostic, de recrutement, de jugement politique ou de verdict relationnel.' },
  es: { introTitle: 'La tendencia autoritaria es una lente sobre autoridad y orden, no una etiqueta que te define', intro: 'El test de tendencia autoritaria observa sumisión a la autoridad, reacción ante normas, convencionalismo y justificación del sistema. El resultado no evalúa ninguna postura política; describe de forma neutral respuestas ante autoridad y estabilidad.', conceptTitle: 'Tres formas de leer la tendencia autoritaria', concepts: [{ title: 'Autoridad y confianza', body: 'La confianza en la autoridad se lee junto a estabilidad, responsabilidad y distancia crítica.' }, { title: 'Normas y sanción', body: 'Distingue el respeto por las normas de la intensidad ante las infracciones.' }, { title: 'Exploración neutral', body: 'El resultado explora tendencias sin respaldar ni descalificar ninguna postura política.' }], faqTitle: 'Preguntas frecuentes', faqs: [{ question: '¿Evalúa creencias políticas?', answer: 'No. No dice que una postura sea correcta o incorrecta. Resume de forma neutral respuestas psicológicas ante autoridad, normas y orden.' }, { question: '¿Un resultado alto es malo?', answer: 'No por sí mismo. El puntaje es una pista para reflexionar sobre fortalezas y costos de valorar estabilidad y orden.' }, { question: '¿Puede cambiar el resultado?', answer: 'Sí. Experiencias sociales, responsabilidades y estrés pueden cambiar la relación con autoridad y normas.' }], disclaimer: 'Los resultados del test de tendencia autoritaria son para autoconocimiento y conversación. No los uses como base para diagnóstico, contratación, juicio político o juicios definitivos sobre relaciones.' },
};

const c = content[locale] ?? content.en;
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
---

<Layout title={m.title} description={m.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="mx-auto max-w-2xl px-4 py-10">
    <div class="mb-8 rounded-2xl border-2 border-slate-200 bg-white p-6">
      <h2 class="text-xl font-black text-slate-900 mb-2">{intro_.heading}</h2>
      <p class="text-sm text-slate-600 leading-relaxed mb-4">{intro_.body}</p>
      <ul class="space-y-1">
        {intro_.dims.map((d) => (
          <li class="text-xs text-slate-500">{d}</li>
        ))}
      </ul>
    </div>

    <AuthoritarianScaleTest client:load locale={locale} />

    <section class="mt-10 border-t border-violet-100 pt-8"><h2 class="text-2xl font-bold text-violet-950">{c.introTitle}</h2><p class="mt-4 leading-8 text-violet-800">{c.intro}</p></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.conceptTitle}</h2><div class="mt-4 grid gap-4 md:grid-cols-3">{c.concepts.map((item) => (<article class="rounded-xl border border-violet-100 bg-white p-4"><h3 class="font-semibold text-violet-950">{item.title}</h3><p class="mt-2 text-sm leading-6 text-violet-700">{item.body}</p></article>))}</div></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.faqTitle}</h2><div class="mt-4 divide-y divide-violet-100 rounded-xl border border-violet-100 bg-white">{c.faqs.map((faq) => (<details class="group p-4"><summary class="cursor-pointer list-none font-semibold text-violet-950">{faq.question}</summary><p class="mt-3 text-sm leading-6 text-violet-700">{faq.answer}</p></details>))}</div></section>
    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>

    <div class="mt-8 rounded-2xl border-2 border-slate-100 bg-slate-50 p-5">
      <p class="text-xs font-bold text-slate-500 mb-3">
        {locale === 'ko' ? '관련 테스트' : locale === 'ja' ? '関連テスト' : locale === 'zh' ? '相关测试' : locale === 'fr' ? 'Tests connexes' : locale === 'es' ? 'Tests relacionados' : 'Related Tests'}
      </p>
      <div class="flex flex-wrap gap-2">
        <a href={localePath(locale, '/political/test')} class="rounded-full border-2 border-slate-200 bg-white px-4 py-1.5 text-sm font-semibold text-slate-600 transition hover:border-slate-500 hover:text-slate-900">
          {locale === 'ko' ? '정치 나침반 테스트' : locale === 'ja' ? '政治コンパステスト' : locale === 'zh' ? '政治指南针测试' : locale === 'fr' ? 'Test Boussole Politique' : locale === 'es' ? 'Test Brújula Política' : 'Political Compass Test'}
        </a>
        <a href={localePath(locale, '/inner-strength/test')} class="rounded-full border-2 border-slate-200 bg-white px-4 py-1.5 text-sm font-semibold text-slate-600 transition hover:border-slate-500 hover:text-slate-900">
          {locale === 'ko' ? '내면 근력 테스트' : locale === 'ja' ? '内面強度テスト' : locale === 'zh' ? '内在力量测试' : locale === 'fr' ? 'Force Intérieure' : locale === 'es' ? 'Fortaleza Interior' : 'Inner Strength Test'}
        </a>
        <a href={localePath(locale, '/big5/test')} class="rounded-full border-2 border-slate-200 bg-white px-4 py-1.5 text-sm font-semibold text-slate-600 transition hover:border-slate-500 hover:text-slate-900">
          {locale === 'ko' ? '빅파이브 테스트' : locale === 'ja' ? 'ビッグファイブテスト' : locale === 'zh' ? '大五人格测试' : locale === 'fr' ? 'Test Big Five' : locale === 'es' ? 'Test Big Five' : 'Big Five Test'}
        </a>
      </div>
    </div>
    <RelatedTools locale={locale} tools={['political','narcissism','mbti','empathy']} current="authoritarian" />
  </div>
</Layout>
