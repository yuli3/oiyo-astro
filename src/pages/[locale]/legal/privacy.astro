---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

interface LegalSection { heading: string; body: string[] }
interface LegalDoc {
  title: string;
  description: string;
  lastUpdated: string;
  lastUpdatedLabel: string;
  seeLabel: string;
  sections: LegalSection[];
}

const mod = await import(`../../../i18n/messages/${locale}/legal.json`).catch(
  () => import(`../../../i18n/messages/en/legal.json`),
);
const doc = (mod as { default: { privacy: LegalDoc } }).default.privacy;

// External links rendered by section index (0-based). Kept in code, not in the
// locale JSON, so translators never touch URLs and we avoid set:html.
const LINKS: Record<number, { label: string; href: string }[]> = {
  2: [
    { label: 'Google Analytics Opt-out Browser Add-on', href: 'https://tools.google.com/dlpage/gaoptout' },
    { label: 'Google Ads Settings', href: 'https://www.google.com/settings/ads' },
    { label: 'aboutads.info', href: 'https://optout.aboutads.info/' },
  ],
  4: [{ label: 'support@oiyo.net', href: 'mailto:support@oiyo.net' }],
  6: [{ label: 'support@oiyo.net', href: 'mailto:support@oiyo.net' }],
};
---

<Layout title={doc.title || 'Privacy Policy'} description={doc.description} locale={locale}>
  <section class="bg-gradient-to-b from-green-50/50 to-white pt-16 pb-8 px-4 text-center">
    <div class="max-w-2xl mx-auto animate-fadeInUp">
      <h1 class="text-4xl font-serif font-black text-foreground mb-2">{doc.title}</h1>
      <p class="text-xs text-green-500">{doc.lastUpdatedLabel}: {doc.lastUpdated}</p>
    </div>
  </section>

  <section class="max-w-2xl mx-auto px-4 py-8">
    <div class="bg-card rounded-2xl border border-green-50 p-8 space-y-6">
      {
        doc.sections.map((section, index) => (
          <div>
            <h2 class="text-lg font-bold text-foreground mb-2">{section.heading}</h2>
            {section.body.map((paragraph) => (
              <p class="text-sm text-green-700 leading-relaxed mb-2">{paragraph}</p>
            ))}
            {LINKS[index] && (
              <p class="text-sm text-green-700 leading-relaxed">
                {doc.seeLabel}{' '}
                {LINKS[index].map((link, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a
                      class="underline"
                      href={link.href}
                      {...(link.href.startsWith('http')
                        ? { target: '_blank', rel: 'noopener noreferrer' }
                        : {})}
                    >
                      {link.label}
                    </a>
                  </>
                ))}
              </p>
            )}
            <hr class="border-green-50 mt-6" />
          </div>
        ))
      }
      <p class="text-xs text-green-500">{doc.description}</p>
    </div>
  </section>
</Layout>
