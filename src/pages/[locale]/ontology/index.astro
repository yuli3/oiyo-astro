---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES, getTranslations } from '../../../i18n';
import type { Locale } from '../../../i18n';
import OntologyIsland from '../../../components/OntologyIsland';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = await getTranslations(locale);

// Load all messages needed by OntologyClient at build time and pass as props
// so the client island has them available without async loading
import enMessages from '../../../i18n/messages/en/dashboard.json';
import koMessages from '../../../i18n/messages/ko/dashboard.json';

// Dynamically import messages for current locale (static paths know locale at build time)
const msgFiles = [
  'akashic', 'catalog', 'chosun', 'commerce', 'dashboard',
  'egyptian', 'nav', 'ontology', 'saju', 'ui', 'universal',
  'common', 'hero',
];

// We pass a flat merged messages object keyed by namespace
// Each file's content becomes messages[filename]
const messages: Record<string, unknown> = {};
for (const file of msgFiles) {
  try {
    // Astro static imports must be resolvable at build time — use dynamic approach
    const mod = await import(`../../../i18n/messages/${locale}/${file}.json`).catch(
      () => import(`../../../i18n/messages/en/${file}.json`)
    );
    messages[file] = mod.default ?? mod;
  } catch {
    // ignore missing files
  }
}
---

<Layout
  title={t('hero.ontology.title') || 'My Sanctuary'}
  description={t('hero.ontology.desc')}
  locale={locale}
>
  <!-- Hero strip (server-rendered for SEO) -->
  <section class="relative overflow-hidden bg-gradient-to-b from-violet-50/60 to-white pt-16 pb-8 px-4 text-center">
    <div class="absolute inset-0 pointer-events-none opacity-20" aria-hidden="true">
      <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-[500px] h-[300px] bg-violet-300 rounded-full blur-3xl" />
    </div>
    <div class="relative z-10 max-w-2xl mx-auto animate-fadeInUp">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-violet-100 text-violet-700 text-xs font-bold mb-4">
        🏛️ {t('nav.ontology')}
      </div>
      <h1 class="text-4xl md:text-5xl font-serif font-black text-violet-950 mb-3 tracking-tight">
        {t('hero.ontology.title')}
      </h1>
      <p class="text-violet-700 text-lg leading-relaxed">
        {t('hero.ontology.desc')}
      </p>
    </div>
  </section>

  <!-- Full OntologyClient as React island — all 12 engines live here -->
  <OntologyIsland
    locale={locale}
    messages={messages}
    client:load
  />
</Layout>
