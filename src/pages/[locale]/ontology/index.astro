---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES, getTranslations } from '../../../i18n';
import type { Locale } from '../../../i18n';
import OntologyIsland from '../../../components/OntologyIsland';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = await getTranslations(locale);

// Server-rendered journey navigation: the SEO-readable spine of /ontology.
// Each stop is a static landing page; the React island below stays the playground.
const journeyText: Record<Locale, { heading: string; sub: string; steps: { title: string; desc: string }[] }> = {
  ko: {
    heading: '존재 탐구 여정',
    sub: '대시보드를 채우기 전에, 네 갈래의 질문부터 시작해 보세요.',
    steps: [
      { title: '나의 존재 지도', desc: 'MBTI·빅파이브·에니어그램·사주를 겹쳐 읽기' },
      { title: '내가 좋아하는 것', desc: '나를 살아나게 하는 활동·환경·색' },
      { title: '나의 존재론적 목표', desc: '직업이 아니라 "삶의 문장" 만들기' },
      { title: '행운을 가져다주는 것', desc: '상징 레이어 × 행동 레이어' },
      { title: '오늘의 나', desc: '오늘의 일진·별자리·타로' },
      { title: '존재의 백과사전', desc: '12가지 상징 체계 한눈에' },
    ],
  },
  en: {
    heading: 'The Self-Discovery Journey',
    sub: 'Before filling the dashboard, start with four questions.',
    steps: [
      { title: 'My map of being', desc: 'Reading MBTI, Big Five, Enneagram & Saju in layers' },
      { title: 'What I love', desc: 'Activities, environments & colors that revive me' },
      { title: 'My existential purpose', desc: 'Forging a "life sentence," not a job title' },
      { title: 'What brings me luck', desc: 'Symbolic layer × behavioral layer' },
      { title: 'Me, today', desc: "Today's day pillar, sun sign & tarot" },
      { title: 'Encyclopedia of being', desc: '12 symbolic systems at a glance' },
    ],
  },
  ja: {
    heading: '存在探求の旅',
    sub: 'ダッシュボードを埋める前に、4つの問いから始めましょう。',
    steps: [
      { title: '私の存在地図', desc: 'MBTI・ビッグファイブ・エニアグラム・四柱を重ねて読む' },
      { title: '私が好きなもの', desc: '自分を生き返らせる活動・環境・色' },
      { title: '存在論的な目標', desc: '職業ではなく「人生の一文」をつくる' },
      { title: '幸運をもたらすもの', desc: '象徴レイヤー × 行動レイヤー' },
      { title: '今日の私', desc: '今日の日辰・星座・タロット' },
      { title: '存在の百科事典', desc: '12の象徴体系をひと目で' },
    ],
  },
  zh: {
    heading: '存在探索之旅',
    sub: '在填满仪表盘之前,先从四个问题开始。',
    steps: [
      { title: '我的存在地图', desc: '叠加解读 MBTI、大五、九型与八字' },
      { title: '我喜欢的东西', desc: '让我活过来的活动、环境与颜色' },
      { title: '我的存在目标', desc: '打造"人生一句话",而非职业头衔' },
      { title: '带给我幸运的东西', desc: '象征层 × 行动层' },
      { title: '今天的我', desc: '今天的日辰、星座与塔罗' },
      { title: '存在百科全书', desc: '12种象征体系一目了然' },
    ],
  },
  fr: {
    heading: "Le voyage de l'exploration de soi",
    sub: 'Avant de remplir le tableau de bord, commencez par quatre questions.',
    steps: [
      { title: "Ma carte de l'être", desc: 'Lire MBTI, Big Five, ennéagramme et Saju en couches' },
      { title: "Ce que j'aime", desc: 'Activités, lieux et couleurs qui me font revivre' },
      { title: 'Mon but existentiel', desc: 'Forger une « phrase de vie », pas un titre' },
      { title: 'Ce qui me porte chance', desc: 'Couche symbolique × couche comportementale' },
      { title: "Moi, aujourd'hui", desc: 'Pilier du jour, signe et tarot' },
      { title: "Encyclopédie de l'être", desc: '12 systèmes symboliques en un regard' },
    ],
  },
  es: {
    heading: 'El viaje de exploración del ser',
    sub: 'Antes de llenar el panel, empieza con cuatro preguntas.',
    steps: [
      { title: 'Mi mapa del ser', desc: 'Leer MBTI, Big Five, eneagrama y Saju en capas' },
      { title: 'Lo que me gusta', desc: 'Actividades, entornos y colores que me reviven' },
      { title: 'Mi propósito existencial', desc: 'Forjar una «frase de vida», no un título' },
      { title: 'Lo que me da suerte', desc: 'Capa simbólica × capa conductual' },
      { title: 'Yo, hoy', desc: 'Pilar del día, signo y tarot' },
      { title: 'Enciclopedia del ser', desc: '12 sistemas simbólicos de un vistazo' },
    ],
  },
};

const jt = journeyText[locale] ?? journeyText.en;
const journeyStops = [
  { emoji: '🧭', href: `/${locale}/ontology/personality`, ...jt.steps[0] },
  { emoji: '🎨', href: `/${locale}/ontology/hobbies`, ...jt.steps[1] },
  { emoji: '🌟', href: `/${locale}/ontology/life-purpose`, ...jt.steps[2] },
  { emoji: '🍀', href: `/${locale}/ontology/luck`, ...jt.steps[3] },
  { emoji: '🌌', href: `/${locale}/today`, ...jt.steps[4] },
  { emoji: '📚', href: `/${locale}/ontology/encyclopedia`, ...jt.steps[5] },
];


const worldviewText: Record<Locale, {
  eyebrow: string; title: string; body: string; progress: string; open: string; try: string; recorded: string; revisit: string; profileTitle: string; profileBody: string; profileCta: string;
}> = {
  ko: {
    eyebrow: '나를 찾는 곳',
    title: '나를 하나의 유형으로 줄이지 않고, 여러 좌표를 겹쳐 읽는 존재 지도',
    body: 'OIYO Ontology는 성격, 가치관, 취향, 상징, 오늘의 상태를 함께 보며 당신만의 존재 지도를 완성하는 공간입니다.',
    progress: '현재 지도: 0 / 12 좌표 기록됨',
    open: '아직 열지 않음',
    try: '해보기',
    recorded: '기록됨',
    revisit: '다시 탐색하기',
    profileTitle: '프로필 내보내기',
    profileBody: '테스트와 상징 좌표를 모아 Markdown 프로필로 정리하세요. 프로필 내보내기는 상단 메뉴가 아니라 Ontology 안에서 제공됩니다.',
    profileCta: '내 프로필 정리하기',
  },
  en: {
    eyebrow: 'Find yourself', title: 'A map of being that layers many coordinates instead of reducing you to one type', body: 'OIYO Ontology gathers personality, values, taste, symbols, and today’s state into one self-discovery map.', progress: 'Current map: 0 / 12 coordinates recorded', open: 'Not opened yet', try: 'Try it', recorded: 'Recorded', revisit: 'Explore again', profileTitle: 'Profile export', profileBody: 'Turn your test and symbol coordinates into a reusable Markdown profile. Profile export now lives inside Ontology, not the top nav.', profileCta: 'Organize my profile',
  },
  ja: { eyebrow: '自分を見つける場所', title: '一つのタイプに縮めず、複数の座標を重ねて読む存在地図', body: 'OIYO Ontologyは性格、価値観、好み、象徴、今日の状態を一つの自己探索マップにまとめます。', progress: '現在の地図: 0 / 12 座標を記録', open: 'まだ開いていません', try: '試してみる', recorded: '記録済み', revisit: 'もう一度探索', profileTitle: 'プロフィール出力', profileBody: 'テストと象徴の座標をMarkdownプロフィールに整理します。プロフィール出力は上部メニューではなくOntology内で提供します。', profileCta: 'プロフィールを整理する' },
  zh: { eyebrow: '寻找自我的地方', title: '不把你缩成单一类型，而是叠加多个坐标的存在地图', body: 'OIYO Ontology 将性格、价值观、喜好、象征和今天的状态整合成一张自我探索地图。', progress: '当前地图：已记录 0 / 12 个坐标', open: '尚未打开', try: '试试看', recorded: '已记录', revisit: '再次探索', profileTitle: '导出资料', profileBody: '把测试和象征坐标整理成 Markdown 资料。资料导出将放在 Ontology 内，而不是顶部菜单。', profileCta: '整理我的资料' },
  fr: { eyebrow: 'Se trouver', title: 'Une carte de l’être qui superpose plusieurs coordonnées au lieu de vous réduire à un type', body: 'OIYO Ontology rassemble personnalité, valeurs, goûts, symboles et état du jour dans une carte de découverte de soi.', progress: 'Carte actuelle : 0 / 12 coordonnées enregistrées', open: 'Pas encore ouvert', try: 'Essayer', recorded: 'Enregistré', revisit: 'Explorer à nouveau', profileTitle: 'Exporter le profil', profileBody: 'Transformez vos tests et coordonnées symboliques en profil Markdown. L’export vit maintenant dans Ontology, pas dans le menu supérieur.', profileCta: 'Organiser mon profil' },
  es: { eyebrow: 'Encontrarte', title: 'Un mapa del ser que superpone coordenadas sin reducirte a un solo tipo', body: 'OIYO Ontology reúne personalidad, valores, gustos, símbolos y estado de hoy en un mapa de autodescubrimiento.', progress: 'Mapa actual: 0 / 12 coordenadas registradas', open: 'Aún no abierto', try: 'Probar', recorded: 'Registrado', revisit: 'Explorar de nuevo', profileTitle: 'Exportar perfil', profileBody: 'Convierte tus tests y coordenadas simbólicas en un perfil Markdown. La exportación vive dentro de Ontology, no en el menú superior.', profileCta: 'Organizar mi perfil' },
};
const wt = worldviewText[locale] ?? worldviewText.en;

// Localized copy for the 6 coordinate cards (previously hardcoded Korean → showed KO on every locale).
const cardText: Record<Locale, { badge: string; title: string; desc: string }[]> = {
  ko: [
    { badge: '성격 지도', title: '성격 좌표', desc: 'MBTI·Big Five·에니어그램으로 나의 기본 패턴 보기' },
    { badge: '가치 지도', title: '정치성향', desc: '사회·경제·국가·세계관에서 내가 우선하는 가치 보기' },
    { badge: '경제 세계관', title: '경제관', desc: '시장·정부·제도·인간 행동을 바라보는 관점 보기' },
    { badge: '역사적 자아', title: '조선붕당', desc: '원칙·현실·개혁·안정 사이에서 나의 역사적 기질 보기' },
    { badge: '취향 지도', title: '취향과 환경', desc: '나를 살아나게 하는 활동·색·공간의 단서 보기' },
    { badge: '상징 지도', title: '행운과 오늘의 나', desc: '상징 레이어와 오늘의 상태를 연결해 보기' },
  ],
  en: [
    { badge: 'Personality map', title: 'Personality', desc: 'See your core patterns through MBTI, Big Five & Enneagram' },
    { badge: 'Values map', title: 'Political values', desc: 'See the values you prioritize across society, economy, nation & worldview' },
    { badge: 'Economic worldview', title: 'Economic view', desc: 'See how you read markets, government, institutions & human behavior' },
    { badge: 'Historical self', title: 'Joseon factions', desc: 'See your historical temperament between principle, pragmatism, reform & stability' },
    { badge: 'Taste map', title: 'Taste & environment', desc: 'See clues to the activities, colors & spaces that revive you' },
    { badge: 'Symbol map', title: 'Luck & today', desc: 'Connect your symbolic layer with today’s state' },
  ],
  ja: [
    { badge: '性格マップ', title: '性格', desc: 'MBTI・ビッグファイブ・エニアグラムで基本パターンを見る' },
    { badge: '価値マップ', title: '政治的傾向', desc: '社会・経済・国家・世界観で優先する価値を見る' },
    { badge: '経済的世界観', title: '経済観', desc: '市場・政府・制度・人間行動の捉え方を見る' },
    { badge: '歴史的自己', title: '朝鮮の党派', desc: '原則・現実・改革・安定の間で歴史的気質を見る' },
    { badge: '好みマップ', title: '好みと環境', desc: '自分を生き返らせる活動・色・空間の手がかりを見る' },
    { badge: '象徴マップ', title: '幸運と今日の私', desc: '象徴レイヤーと今日の状態をつなぐ' },
  ],
  zh: [
    { badge: '性格地图', title: '性格', desc: '通过 MBTI、大五与九型看你的基本模式' },
    { badge: '价值地图', title: '政治倾向', desc: '看你在社会、经济、国家与世界观中优先的价值' },
    { badge: '经济世界观', title: '经济观', desc: '看你如何看待市场、政府、制度与人类行为' },
    { badge: '历史自我', title: '朝鲜党派', desc: '在原则、现实、改革与稳定之间看你的历史气质' },
    { badge: '品味地图', title: '品味与环境', desc: '看让你活过来的活动、颜色与空间线索' },
    { badge: '象征地图', title: '幸运与今天的我', desc: '把象征层与今天的状态连起来' },
  ],
  fr: [
    { badge: 'Carte de personnalité', title: 'Personnalité', desc: 'Voir vos schémas de base via MBTI, Big Five et ennéagramme' },
    { badge: 'Carte des valeurs', title: 'Tendances politiques', desc: 'Voir les valeurs que vous priorisez : société, économie, nation, vision du monde' },
    { badge: 'Vision économique', title: 'Vision économique', desc: 'Voir comment vous lisez marchés, État, institutions et comportements' },
    { badge: 'Soi historique', title: 'Factions Joseon', desc: 'Voir votre tempérament historique entre principe, pragmatisme, réforme et stabilité' },
    { badge: 'Carte des goûts', title: 'Goûts et environnement', desc: 'Voir les indices d’activités, couleurs et espaces qui vous font revivre' },
    { badge: 'Carte symbolique', title: 'Chance et aujourd’hui', desc: 'Relier votre couche symbolique à l’état du jour' },
  ],
  es: [
    { badge: 'Mapa de personalidad', title: 'Personalidad', desc: 'Ve tus patrones básicos con MBTI, Big Five y eneagrama' },
    { badge: 'Mapa de valores', title: 'Tendencia política', desc: 'Ve los valores que priorizas en sociedad, economía, nación y cosmovisión' },
    { badge: 'Cosmovisión económica', title: 'Visión económica', desc: 'Ve cómo interpretas mercados, gobierno, instituciones y conducta humana' },
    { badge: 'Yo histórico', title: 'Facciones Joseon', desc: 'Ve tu temperamento histórico entre principio, pragmatismo, reforma y estabilidad' },
    { badge: 'Mapa de gustos', title: 'Gustos y entorno', desc: 'Ve pistas de actividades, colores y espacios que te reviven' },
    { badge: 'Mapa simbólico', title: 'Suerte y hoy', desc: 'Conecta tu capa simbólica con el estado de hoy' },
  ],
};
const ct = cardText[locale] ?? cardText.en;
const cardMeta = [
  { id: 'personality', emoji: '🧠', href: `/${locale}/ontology/personality` },
  { id: 'political', emoji: '🧭', href: `/${locale}/political/test` },
  { id: 'economics', emoji: '📊', href: `/${locale}/economics-school-test` },
  { id: 'joseon', emoji: '🏯', href: `/${locale}/joseon-faction-test` },
  { id: 'hobbies', emoji: '🎨', href: `/${locale}/ontology/hobbies` },
  { id: 'luck', emoji: '✨', href: `/${locale}/ontology/luck` },
];
const coordinateCards = cardMeta.map((m, i) => ({ ...m, ...(ct[i] ?? cardText.en[i]), status: wt.open, cta: wt.try }));

// All namespaces needed by OntologyClient and its component tree
const namespaces = [
  'akashic', 'catalog', 'chosun', 'colorPersonality', 'commerce',
  'dashboard', 'egyptian', 'fortune', 'hobby', 'lifestyle',
  'mbti', 'nav', 'numerology', 'ontology', 'saju', 'tci', 'ui',
  'universal', 'common', 'hero',
];

const messages: Record<string, unknown> = {};
for (const ns of namespaces) {
  try {
    const mod = await import(`../../../i18n/messages/${locale}/${ns}.json`)
      .catch(() => import(`../../../i18n/messages/en/${ns}.json`));
    messages[ns] = mod.default ?? mod;
  } catch { /* skip missing */ }
}
---

<Layout
  title={t('hero.ontology.title') || 'My Sanctuary'}
  description={t('hero.ontology.desc')}
  locale={locale}
>
  <!-- SEO hero strip (server-rendered) -->
  <section class="relative overflow-hidden bg-gradient-to-b from-violet-50/60 to-white pt-16 pb-8 px-4 text-center">
    <div class="absolute inset-0 pointer-events-none opacity-20" aria-hidden="true">
      <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-[500px] h-[300px] bg-violet-300 rounded-full blur-3xl" />
    </div>
    <div class="relative z-10 max-w-2xl mx-auto animate-fadeInUp">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-violet-100 text-violet-700 text-xs font-bold mb-4">
        🏛️ {t('nav.ontology')}
      </div>
      <h1 class="text-4xl md:text-5xl font-serif font-black text-violet-950 mb-3 tracking-tight">
        {t('hero.ontology.title')}
      </h1>
      <p class="text-violet-700 text-lg leading-relaxed">
        {t('hero.ontology.desc')}
      </p>
    </div>
  </section>

  <!-- Ontology map dashboard (server-rendered, crawlable) -->
  <section class="max-w-5xl mx-auto px-4 py-8">
    <div class="rounded-[2rem] border border-violet-200 bg-white p-5 md:p-7 shadow-sm">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.25em] text-violet-500">{wt.eyebrow}</p>
          <h2 class="mt-2 text-2xl md:text-3xl font-black text-violet-950">{wt.title}</h2>
          <p class="mt-3 max-w-2xl text-sm leading-7 text-violet-700">{wt.body}</p>
        </div>
        <div id="ontology-progress-summary" data-template={wt.progress} class="rounded-2xl bg-violet-50 px-4 py-3 text-sm font-bold text-violet-800">
          {wt.progress}
        </div>
      </div>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {coordinateCards.map((card) => (
          <a href={card.href} data-coordinate-card={card.id} data-open-label={wt.open} data-recorded-label={wt.recorded} data-try-label={wt.try} data-revisit-label={wt.revisit} class="group flex h-full flex-col rounded-2xl border border-violet-100 bg-gradient-to-b from-white to-violet-50/40 p-4 transition-all hover:-translate-y-0.5 hover:border-violet-400 hover:shadow-md">
            <div class="flex items-start justify-between gap-3">
              <span class="text-3xl" aria-hidden="true">{card.emoji}</span>
              <span data-coordinate-status class="rounded-full bg-white px-2.5 py-1 text-[11px] font-black text-violet-600 ring-1 ring-violet-100">{card.status}</span>
            </div>
            <p class="mt-3 text-[11px] font-black uppercase tracking-[0.18em] text-violet-400">{card.badge}</p>
            <h3 class="mt-1 text-lg font-black text-violet-950 group-hover:text-violet-700">{card.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-6 text-slate-600">{card.desc}</p>
            <span data-coordinate-cta class="mt-4 text-sm font-black text-violet-700">{card.cta} →</span>
          </a>
        ))}
      </div>
      <a href={`/${locale}/profile/export`} class="mt-4 flex flex-col gap-2 rounded-2xl border border-emerald-200 bg-emerald-50/70 p-4 text-emerald-950 transition hover:border-emerald-400 hover:bg-emerald-50 md:flex-row md:items-center md:justify-between">
        <span>
          <span class="block text-sm font-black">🧾 {wt.profileTitle}</span>
          <span class="block text-sm leading-6 text-emerald-800">{wt.profileBody}</span>
        </span>
        <span class="shrink-0 rounded-full bg-white px-4 py-2 text-sm font-black text-emerald-700">{wt.profileCta}</span>
      </a>
    </div>
  </section>

  <!-- Journey navigation (legacy crawlable spine) -->
  <section class="max-w-4xl mx-auto px-4 pb-8">
    <h2 class="text-xl font-black text-violet-950 text-center mb-1">{jt.heading}</h2>
    <p class="text-sm text-violet-600 text-center mb-6">{jt.sub}</p>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {journeyStops.map((s, i) => (
        <a href={s.href} class="group relative flex items-start gap-3 rounded-2xl border border-violet-100 bg-white p-4 transition-all hover:border-violet-300 hover:shadow-sm">
          <span class="absolute top-3 right-3 text-[10px] font-black text-violet-300" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="text-2xl" aria-hidden="true">{s.emoji}</span>
          <span>
            <span class="block font-bold text-violet-950 group-hover:text-violet-700">{s.title}</span>
            <span class="block text-xs text-gray-500 mt-0.5 leading-relaxed">{s.desc}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Full OntologyClient with all 12 engines as React island -->
  <OntologyIsland
    locale={locale}
    messages={messages}
    client:load
  />


<script is:inline>
  (() => {
    const KEY = 'oiyo:ontology:coordinates';
    const readProgress = () => {
      try {
        const raw = window.localStorage.getItem(KEY);
        const parsed = raw ? JSON.parse(raw) : {};
        return parsed && typeof parsed === 'object' ? parsed : {};
      } catch {
        return {};
      }
    };
    const applyProgress = () => {
      const progress = readProgress();
      const cards = Array.from(document.querySelectorAll('[data-coordinate-card]'));
      let recorded = 0;
      cards.forEach((card) => {
        const id = card.getAttribute('data-coordinate-card');
        const record = id ? progress[id] : null;
        const status = card.querySelector('[data-coordinate-status]');
        const cta = card.querySelector('[data-coordinate-cta]');
        if (record?.status === 'recorded') {
          recorded += 1;
          if (status) status.textContent = card.getAttribute('data-recorded-label') || 'Recorded';
          if (cta) cta.textContent = `${card.getAttribute('data-revisit-label') || 'Explore again'} →`;
          card.classList.add('border-emerald-300', 'bg-emerald-50');
        } else {
          if (status) status.textContent = card.getAttribute('data-open-label') || 'Not opened yet';
          if (cta) cta.textContent = `${card.getAttribute('data-try-label') || 'Try it'} →`;
        }
      });
      const summary = document.getElementById('ontology-progress-summary');
      if (summary) {
        const current = summary.getAttribute('data-template') || summary.textContent || '';
        summary.textContent = current.replace(/0\s*\/\s*12|0\s*\/\s*12/g, `${recorded} / 12`);
      }
    };
    applyProgress();
    window.addEventListener('storage', applyProgress);
    window.addEventListener('oiyo:ontology-progress-updated', applyProgress);
  })();
</script>
</Layout>
