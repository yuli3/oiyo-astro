  ja: { mapProgress: '存在地図の完成度', nextStep: '次の一歩', mapComplete: '存在地図がすべて埋まりました 🎉' },
  zh: { mapProgress: '存在地图完成度', nextStep: '下一步', mapComplete: '你的存在地图已全部填满 🎉' },
  fr: { mapProgress: 'Progression de la carte', nextStep: 'Prochaine étape', mapComplete: 'Votre carte de l’être est complète 🎉' },
  es: { mapProgress: 'Progreso del mapa', nextStep: 'Siguiente paso', mapComplete: 'Tu mapa del ser está completo 🎉' },
};
const ju = journeyUi[locale] ?? journeyUi.en;
// Guide stops = destinations unique to the legacy journey (not already a coordinate card).
const guideStops = [journeyStops[2], journeyStops[4], journeyStops[5]];

// All namespaces needed by OntologyClient and its component tree
const namespaces = [
  'akashic', 'catalog', 'chosun', 'colorPersonality', 'commerce',
  'dashboard', 'egyptian', 'fortune', 'hobby', 'lifestyle',
  'mbti', 'nav', 'numerology', 'ontology', 'saju', 'tci', 'ui',
  'universal', 'common', 'hero',
];

const messages: Record<string, unknown> = {};
for (const ns of namespaces) {
  try {
    const mod = await import(`../../../i18n/messages/${locale}/${ns}.json`)
      .catch(() => import(`../../../i18n/messages/en/${ns}.json`));
    messages[ns] = mod.default ?? mod;
  } catch { /* skip missing */ }
}
---

<Layout
  title={t('hero.ontology.title') || 'My Sanctuary'}
  description={t('hero.ontology.desc')}
  locale={locale}
>
  <!-- SEO hero strip (server-rendered) -->
  <section class="relative overflow-hidden bg-gradient-to-b from-violet-50/60 to-white pt-16 pb-8 px-4 text-center">
    <div class="absolute inset-0 pointer-events-none opacity-20" aria-hidden="true">
      <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-[500px] h-[300px] bg-violet-300 rounded-full blur-3xl" />
    </div>
    <div class="relative z-10 max-w-2xl mx-auto animate-fadeInUp">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-violet-100 text-violet-700 text-xs font-bold mb-4">
        🏛️ {t('nav.ontology')}
      </div>
      <h1 class="text-4xl md:text-5xl font-serif font-black text-violet-950 mb-3 tracking-tight">
        {t('hero.ontology.title')}
      </h1>
      <p class="text-violet-700 text-lg leading-relaxed">
        {t('hero.ontology.desc')}
      </p>
    </div>
  </section>

  <!-- Zone 1 — Your data (입력됨): aggregated self-knowledge summary, populated client-side -->
  <section class="max-w-5xl mx-auto px-4 pt-8">
    <div class="rounded-[2rem] border border-violet-200 bg-white p-5 md:p-7 shadow-sm">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.25em] text-violet-500">{wt.eyebrow}</p>
        <h2 class="mt-1 text-2xl md:text-3xl font-black text-violet-950">{zt.z1Title}</h2>
        <p class="mt-2 max-w-2xl text-sm leading-7 text-violet-700">{zt.z1Sub}</p>
      </div>
      <div class="mt-5 grid gap-3 sm:grid-cols-3">
        <div class="rounded-2xl bg-violet-50 px-4 py-3">
          <p class="text-[11px] font-black uppercase tracking-wider text-violet-400">{zt.birthLabel}</p>
          <p id="ontology-stat-birth" data-set-label={zt.birthSet} data-unset-label={zt.birthUnset} class="mt-1 text-lg font-black text-violet-900">{zt.birthUnset}</p>
        </div>
        <div class="rounded-2xl bg-violet-50 px-4 py-3">
          <p class="text-[11px] font-black uppercase tracking-wider text-violet-400">{zt.testsLabel}</p>
          <p id="ontology-stat-tests" class="mt-1 text-lg font-black text-violet-900">0</p>
        </div>
        <div class="rounded-2xl bg-violet-50 px-4 py-3">
          <p class="text-[11px] font-black uppercase tracking-wider text-violet-400">{zt.coordsLabel}</p>
          <p id="ontology-progress-summary" class="mt-1 text-lg font-black text-violet-900">0 / {coordinateCards.length}</p>
        </div>
      </div>

      <!-- Journey meter: fills as the user records coordinates -->
      <div class="mt-5">
        <div class="flex items-center justify-between text-xs font-black text-violet-600">
          <span>{ju.mapProgress}</span>
          <span id="ontology-journey-pct">0%</span>
        </div>
        <div class="mt-1.5 h-2.5 w-full overflow-hidden rounded-full bg-violet-100">
          <div id="ontology-journey-bar" class="h-full rounded-full bg-gradient-to-r from-violet-400 to-violet-600 transition-all duration-700 ease-out" style="width:0%"></div>
        </div>
        <a id="ontology-next-step" href={coordinateCards[0].href} data-prefix={ju.nextStep} data-complete={ju.mapComplete} class="mt-3 inline-flex items-center gap-2 rounded-full bg-violet-600 px-4 py-2 text-sm font-black text-white transition hover:bg-violet-700">
          <span aria-hidden="true">→</span>
          <span id="ontology-next-step-text">{ju.nextStep}: {coordinateCards[0].title}</span>
        </a>
      </div>

      <a href={`/${locale}/profile/export`} class="mt-4 flex flex-col gap-2 rounded-2xl border border-emerald-200 bg-emerald-50/70 p-4 text-emerald-950 transition hover:border-emerald-400 hover:bg-emerald-50 md:flex-row md:items-center md:justify-between">
        <span>
          <span class="block text-sm font-black">🧾 {wt.profileTitle}</span>
          <span class="block text-sm leading-6 text-emerald-800">{wt.profileBody}</span>
        </span>
        <span class="shrink-0 rounded-full bg-white px-4 py-2 text-sm font-black text-emerald-700">{wt.profileCta}</span>
      </a>
    </div>
  </section>

  <!-- Zone 2 — My coordinates (입력/미입력 구분, recommended next highlighted client-side) -->
  <section class="max-w-5xl mx-auto px-4 pt-8">
    <div class="mb-4">
      <h2 class="text-xl md:text-2xl font-black text-violet-950">{zt.z2Title}</h2>
      <p class="mt-1 text-sm text-violet-600">{zt.z2Sub}</p>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {coordinateCards.map((card) => (
        <a href={card.href} data-coordinate-card={card.id} data-open-label={wt.open} data-recorded-label={wt.recorded} data-try-label={wt.try} data-revisit-label={wt.revisit} class="group relative flex h-full flex-col rounded-2xl border border-violet-100 bg-gradient-to-b from-white to-violet-50/40 p-4 transition-all hover:-translate-y-0.5 hover:border-violet-400 hover:shadow-md">
          <div class="flex items-start justify-between gap-3">
            <span class="text-3xl" aria-hidden="true">{card.emoji}</span>
            <span data-coordinate-status class="rounded-full bg-white px-2.5 py-1 text-[11px] font-black text-violet-600 ring-1 ring-violet-100">{card.status}</span>
          </div>
          <p class="mt-3 text-[11px] font-black uppercase tracking-[0.18em] text-violet-400">{card.badge}</p>
          <h3 class="mt-1 text-lg font-black text-violet-950 group-hover:text-violet-700">{card.title}</h3>
          <p class="mt-2 flex-1 text-sm leading-6 text-slate-600">{card.desc}</p>
          <span data-coordinate-cta class="mt-4 text-sm font-black text-violet-700">{card.cta} →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Zone 3 — Guide / recommendations (가이드: 다음 단계 + 서비스 안내) -->
  <section class="max-w-5xl mx-auto px-4 pt-8 pb-4">
    <div class="mb-4">
      <h2 class="text-xl md:text-2xl font-black text-violet-950">{zt.z3Title}</h2>
      <p class="mt-1 text-sm text-violet-600">{zt.z3Sub}</p>
    </div>
    <div class="grid gap-3 sm:grid-cols-3">
      {guideStops.map((s) => (
        <a href={s.href} class="group flex items-start gap-3 rounded-2xl border border-violet-100 bg-white p-4 transition-all hover:border-violet-300 hover:shadow-sm">
          <span class="text-2xl" aria-hidden="true">{s.emoji}</span>
          <span>
            <span class="block font-bold text-violet-950 group-hover:text-violet-700">{s.title}</span>
            <span class="block text-xs text-gray-500 mt-0.5 leading-relaxed">{s.desc}</span>
          </span>
        </a>
      ))}
    </div>
    <a href={`/${locale}`} class="mt-3 inline-flex items-center gap-1 text-sm font-black text-violet-700 hover:text-violet-900">{zt.allTools} →</a>
  </section>

  <!-- Deep dive divider + full React island (12 engines) -->
  <section class="max-w-5xl mx-auto px-4 pt-8">
    <div class="border-t border-violet-100 pt-6">
      <h2 class="text-xl md:text-2xl font-black text-violet-950">{zt.deepTitle}</h2>
      <p class="mt-1 text-sm text-violet-600">{zt.deepSub}</p>
    </div>
  </section>

  <!-- Full OntologyClient with all 12 engines as React island -->
  <OntologyIsland
    locale={locale}
    messages={messages}
    client:load
  />


<script is:inline>
  (() => {
    const COORD_KEY = 'oiyo:ontology:coordinates';
    const TESTS_KEY = 'oiyo:test-results:v1';
    const PROFILE_KEY = 'oiyo:profile-markdown-export:v2';
    const readJson = (k) => {
      try { const raw = window.localStorage.getItem(k); return raw ? JSON.parse(raw) : null; }
      catch { return null; }
    };
    const apply = () => {
      const progress = readJson(COORD_KEY) || {};
      const cards = Array.from(document.querySelectorAll('[data-coordinate-card]'));
      let recorded = 0;
      let firstEmpty = null;
      cards.forEach((card) => {
        const id = card.getAttribute('data-coordinate-card');
        const record = (id && progress && typeof progress === 'object') ? progress[id] : null;
        const status = card.querySelector('[data-coordinate-status]');
        const cta = card.querySelector('[data-coordinate-cta]');
        card.classList.remove('ring-2', 'ring-violet-400');
        if (record && record.status === 'recorded') {
          recorded += 1;
          if (status) status.textContent = card.getAttribute('data-recorded-label') || 'Recorded';
          if (cta) cta.textContent = `${card.getAttribute('data-revisit-label') || 'Explore again'} →`;
          card.classList.add('border-emerald-300', 'bg-emerald-50');
        } else {
          if (status) status.textContent = card.getAttribute('data-open-label') || 'Not opened yet';
          if (cta) cta.textContent = `${card.getAttribute('data-try-label') || 'Try it'} →`;
          if (!firstEmpty) firstEmpty = card;
        }
      });
      const total = cards.length || 1;
      // Guide the user: highlight the first empty coordinate as the recommended next step.
      if (firstEmpty) firstEmpty.classList.add('ring-2', 'ring-violet-400');

      const coordsEl = document.getElementById('ontology-progress-summary');
      if (coordsEl) coordsEl.textContent = `${recorded} / ${total}`;

      // Journey meter: fill the map as coordinates are recorded.
      const pct = Math.round((recorded / total) * 100);
      const bar = document.getElementById('ontology-journey-bar');
      if (bar) bar.style.width = `${pct}%`;
      const pctEl = document.getElementById('ontology-journey-pct');
      if (pctEl) pctEl.textContent = `${pct}%`;

      // Next step: point to the first empty coordinate, or celebrate when complete.
      const nextEl = document.getElementById('ontology-next-step');
      const nextText = document.getElementById('ontology-next-step-text');
      if (nextEl && nextText) {
        if (firstEmpty) {
          const prefix = nextEl.getAttribute('data-prefix') || 'Next';
          const title = firstEmpty.querySelector('h3');
          const href = firstEmpty.getAttribute('href');
          if (href) nextEl.setAttribute('href', href);
          nextText.textContent = `${prefix}: ${title ? title.textContent : ''}`.trim();
          nextEl.classList.remove('bg-emerald-600', 'hover:bg-emerald-700');
          nextEl.classList.add('bg-violet-600', 'hover:bg-violet-700');
        } else {
          nextText.textContent = nextEl.getAttribute('data-complete') || 'Complete';
          nextEl.classList.remove('bg-violet-600', 'hover:bg-violet-700');
          nextEl.classList.add('bg-emerald-600', 'hover:bg-emerald-700');
        }
      }

      const tests = readJson(TESTS_KEY);
      const testsEl = document.getElementById('ontology-stat-tests');
      if (testsEl) testsEl.textContent = String(Array.isArray(tests) ? tests.length : 0);

      const profile = readJson(PROFILE_KEY);
      const birthEl = document.getElementById('ontology-stat-birth');
      if (birthEl) {
        const has = profile && typeof profile === 'object' && typeof profile.birthDate === 'string' && profile.birthDate.trim().length > 0;
        birthEl.textContent = has
          ? (birthEl.getAttribute('data-set-label') || 'Recorded')
          : (birthEl.getAttribute('data-unset-label') || 'Not set');
        birthEl.classList.toggle('text-emerald-600', !!has);
        birthEl.classList.toggle('text-violet-900', !has);
      }
    };
    apply();
    window.addEventListener('storage', apply);
    window.addEventListener('oiyo:ontology-progress-updated', apply);
    window.addEventListener('oiyo:test-results-updated', apply);
  })();
</script>
</Layout>
