---
import Layout from '../../../../layouts/Layout.astro';
import OntologyTemplateShowcase from '../../../../components/ontology/OntologyTemplateShowcase.astro';
import { LOCALES, type Locale } from '../../../../i18n';

export function getStaticPaths() {
  const templateIds = ['1', '2', '3', '4'] as const;
  return LOCALES.flatMap((locale) =>
    templateIds.map((id) => ({ params: { id, locale } })),
  );
}

const { id, locale } = Astro.params as { id: string; locale: Locale };
const variant = Number(id);
---

<Layout
  title={`Ontology Template ${id}`}
  description="Experimental ontology dashboard prototype for visual review."
  locale={locale}
  noindex
>
  <OntologyTemplateShowcase locale={locale} variant={variant} />
</Layout>
