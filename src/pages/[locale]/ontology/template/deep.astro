---
// 프로토타입 워크벤치 — 승격 전 신규 존재론 기능을 한 화면에서 미리보기.
// noindex. 레거시 OntologyClient(Next.js 이식, 917b6da) 아일랜드는 유일한
// 사용처가 없어 2026-07-20 아카이브 처리(_archive/legacy-code/oiyo-legacy/ontology-client-2026-07-20/,
// 발열·보라색 테마 원인으로 확인됨) — 아래 3개 프로토타입은 각자 CI 감사가 있는
// 활성 작업물이라 그대로 유지.
import Layout from '../../../../layouts/Layout.astro';
import { ExplorationRecommenderPrototype } from '../../../../components/ontology/ExplorationRecommenderPrototype';
import { PersonalProfileHistoryPreview } from '../../../../components/ontology/PersonalProfileHistoryPreview';
import { OntologyPlatformReadOnlyPilot } from '../../../../components/ontology/OntologyPlatformReadOnlyPilot';
import { RoleVisualSystemPrototype } from '../../../../components/ontology/RoleVisualSystemPrototype';
import { LOCALES, type Locale } from '../../../../i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
---

<Layout title="Ontology Deep Dive (preview)" description="존재론 프로토타입 워크벤치. 프로덕션 미노출." locale={locale} noindex>
  <div class="mx-auto max-w-3xl px-4 py-8">
    <p class="mb-4 rounded-xl bg-amber-50 px-4 py-2 text-xs text-amber-800">
      보관용 프리뷰 — 승격 전 신규 기능들을 한 화면에서 겹쳐 읽는 작업대. 프로덕션 대시보드에는 노출되지 않습니다.
    </p>
    <ExplorationRecommenderPrototype locale={locale} client:visible />
    <OntologyPlatformReadOnlyPilot locale={locale} client:visible />
    <PersonalProfileHistoryPreview locale={locale} client:visible />
    <RoleVisualSystemPrototype locale={locale} client:visible />
  </div>
</Layout>
