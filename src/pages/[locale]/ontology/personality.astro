---
import Layout from '../../../layouts/Layout.astro';
import JourneyLanding from '../../../components/ontology/JourneyLanding.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import { personalityContent } from '../../../lib/ontology/journey/personality';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const content = personalityContent(locale);
---

<Layout title={content.title} description={content.intro} locale={locale}>
  <JourneyLanding locale={locale} content={content} />
</Layout>
