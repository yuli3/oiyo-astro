---
import Layout from '../../../../layouts/Layout.astro';
import { LOCALES, getTranslations } from '../../../../i18n';
import type { Locale } from '../../../../i18n';
import { IntlProvider } from '../../../../lib/shims/next-intl';
import EncyclopediaIsland from '../../../../components/EncyclopediaIsland';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = await getTranslations(locale);

const meta: Record<Locale, { title: string; description: string; heading: string; subheading: string }> = {
  ko: {
    title: '오행 백과사전 — 사주 천간·지지',
    description: '사주 명리학의 10천간과 12지지를 하나씩 찾아보는 오행 백과사전.',
    heading: '📚 오행 백과사전',
    subheading: '사주 천간·지지',
  },
  en: {
    title: 'Encyclopedia — Saju Stems & Branches',
    description: 'The Saju Stem & Branch Encyclopedia — look up each of the 10 Heavenly Stems and 12 Earthly Branches.',
    heading: '📚 Encyclopedia',
    subheading: 'Saju Stems & Branches',
  },
  ja: {
    title: '五行百科事典 — 四柱推命 天干・地支',
    description: '四柱推命の十天干・十二地支を一つずつ調べる五行百科事典。',
    heading: '📚 五行百科事典',
    subheading: '四柱推命 天干・地支',
  },
  zh: {
    title: '五行百科全书 — 四柱天干地支',
    description: '逐一查阅四柱命理的十天干与十二地支的五行百科全书。',
    heading: '📚 五行百科全书',
    subheading: '四柱天干地支',
  },
  fr: {
    title: 'Encyclopédie — Tiges et branches du Saju',
    description: 'L\'encyclopédie des tiges célestes et branches terrestres du Saju (astrologie coréenne).',
    heading: '📚 Encyclopédie',
    subheading: 'Tiges et branches du Saju',
  },
  es: {
    title: 'Enciclopedia — Tallos y ramas del Saju',
    description: 'La enciclopedia de los tallos celestes y ramas terrestres de la astrología Saju.',
    heading: '📚 Enciclopedia',
    subheading: 'Tallos y ramas del Saju',
  },
};

const m = meta[locale] ?? meta.en;

const namespaces = ['saju', 'saju-daymaster', 'elements', 'ontology', 'common', 'nav', 'ui'];
const messages: Record<string, unknown> = {};
for (const ns of namespaces) {
  try {
    const mod = await import(`../../../../i18n/messages/${locale}/${ns}.json`)
      .catch(() => import(`../../../../i18n/messages/en/${ns}.json`));
    messages[ns] = mod.default ?? mod;
  } catch { /* skip */ }
}
---

<Layout
  title={m.title}
  description={m.description}
  locale={locale}
>
  <section class="bg-gradient-to-b from-green-50/50 to-white pt-16 pb-8 px-4 text-center">
    <div class="max-w-2xl mx-auto animate-fadeInUp">
      <h1 class="text-4xl font-serif font-black text-foreground mb-2">{m.heading}</h1>
      <p class="text-green-600">{m.subheading}</p>
    </div>
  </section>

  <EncyclopediaIsland locale={locale} messages={messages} client:load />
</Layout>
