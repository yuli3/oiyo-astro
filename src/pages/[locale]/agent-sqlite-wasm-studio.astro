---
import Layout from "../../layouts/Layout.astro";
import { LOCALES } from "../../i18n";
import type { Locale } from "../../i18n";
import { AgentSqliteWasmStudio } from "../../components/tools/AgentSqliteWasmStudio";

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "SQLite 스키마 인스펙터 & DTO 생성기 | OIYO Tools",
    description: "SQLite 및 Cloudflare D1 DDL 스키마를 즉시 분석하여 테이블 관계, 인덱스 상태를 시각화하고 TypeScript Row 인터페이스를 자동 생성합니다.",
  },
  en: {
    title: "SQLite Schema Inspector & TypeScript DTO Studio | OIYO Tools",
    description: "Sub-millisecond SQLite DDL analyzer, table & index inspector, and TypeScript Row DTO generator.",
  },
  ja: {
    title: "SQLiteスキーマインスペクター＆DTO生成機 | OIYO Tools",
    description: "SQLiteおよびCloudflare D1のDDLスキーマを瞬時に解析し、テーブル構造を可視化、TypeScript Rowインターフェースを自動生成。",
  },
  zh: {
    title: "SQLite模式检查器与TypeScript DTO生成器 | OIYO Tools",
    description: "毫秒级解析SQLite与D1的DDL模式，可视化表关系与索引，自动生成类型安全的TypeScript Row模型接口。",
  },
  fr: {
    title: "Inspecteur de schéma SQLite et générateur DTO | OIYO Tools",
    description: "Analyse ultra-rapide des schémas DDL SQLite et génération automatique d'interfaces TypeScript Row.",
  },
  es: {
    title: "Inspector de esquemas SQLite y generador de DTO | OIYO Tools",
    description: "Analizador sub-milisegundo de DDL de SQLite, inspección de tablas e índices y generador de interfaces TypeScript Row.",
  },
};

const currentMeta = meta[locale] ?? meta.ko;
---

<Layout title={currentMeta.title} description={currentMeta.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 space-y-8">
    <div class="text-center space-y-2 max-w-2xl mx-auto">
      <h1 class="text-3xl font-extrabold tracking-tight">SQLite 스키마 인스펙터 & DTO 생성기</h1>
      <p class="text-muted-foreground text-sm">
        SQLite 및 Cloudflare D1 DDL 스키마 구문 분석, 테이블·인덱스 구조 파악 및 TypeScript Row 인터페이스 자동 생성
      </p>
    </div>

    <AgentSqliteWasmStudio client:load locale={locale} />

    <div class="max-w-4xl mx-auto border rounded-xl p-6 bg-card border-border space-y-4">
      <h2 class="text-lg font-bold">로컬 SQLite 스키마 설계 2대 핵심 팁</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-muted-foreground leading-relaxed">
        <div class="space-y-1">
          <h3 class="font-semibold text-foreground">🔍 외래키(Foreign Key) 인덱스 생성 필수</h3>
          <p>
            SQLite는 PostgreSQL이나 MySQL과 달리 <code>FOREIGN KEY</code> 제약조건을 걸어도 해당 컬럼에 <strong>인덱스를 자동 생성하지 않습니다</strong>. JOIN 성능과 CASCADE 삭제 속도를 보장하려면 외래키 컬럼에 반드시 명시적 <code>CREATE INDEX</code>를 추가해야 합니다.
          </p>
        </div>
        <div class="space-y-1">
          <h3 class="font-semibold text-foreground">🛡️ 타입 친화성(Type Affinity) 주의</h3>
          <p>
            SQLite는 유연한 타입 시스템(Type Affinity)을 사용하므로, <code>DATETIME</code>이나 <code>BOOLEAN</code>도 내부적으로 TEXT나 INTEGER로 저장됩니다. 생성된 TypeScript DTO를 통해 애플리케이션 계층에서 엄격한 타입을 보장하세요.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
