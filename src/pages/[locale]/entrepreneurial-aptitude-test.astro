---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import EntrepreneurialAptitudeTest from '../../components/tests/EntrepreneurialAptitudeTest';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<string, { title: string; description: string }> = {
  ko: {
    title: "창업가 기질 테스트 — 내 안의 기업가적 기질은?",
    description: "기업가적 지향성(위험감수·혁신성·주도성) 기반 — 14문항으로 나의 창업가 기질을 측정하고 강점을 확인하세요.",
  },
  en: {
    title: "Entrepreneurial Aptitude Test — How Strong Is the Entrepreneur in You?",
    description: "Based on Entrepreneurial Orientation (risk-taking, innovativeness, proactiveness) — measure your entrepreneurial aptitude with 14 questions.",
  },
  ja: {
    title: "起業家気質テスト — あなたの中の起業家気質は？",
    description: "起業家的志向性（リスク許容・革新性・主導性）に基づく — 14の設問であなたの起業家気質を測定し、強みを確認しましょう。",
  },
  fr: {
    title: "Test d'Aptitude Entrepreneuriale — Quel entrepreneur sommeille en vous ?",
    description: "Basé sur l'orientation entrepreneuriale (prise de risque, innovation, proactivité) — mesurez votre aptitude entrepreneuriale en 14 questions.",
  },
  es: {
    title: "Test de Aptitud Emprendedora — ¿Cuán fuerte es el emprendedor en ti?",
    description: "Basado en la orientación emprendedora (asunción de riesgos, innovación, proactividad) — mide tu aptitud emprendedora con 14 preguntas.",
  },
  zh: {
    title: "创业家气质测试 — 你内在的企业家特质有多强？",
    description: "基于创业导向（风险承担·创新性·主动性）— 用14个问题测量你的创业家气质并发现优势。",
  },
};
const m = meta[locale] ?? meta.en ?? Object.values(meta)[0];
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <EntrepreneurialAptitudeTest locale={locale as any} client:load />
  </div>
</Layout>
