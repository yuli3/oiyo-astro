---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import ReducedWorkingHoursParentingComponent from '../../components/tools/ReducedWorkingHoursParenting';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "육아기 근로시간 단축 급여 & 연차보장 계산기 — 2026 개정 초등 6학년·최대 3년",
    description: "남녀고용평등법 개정(만 12세·초등 6학년 이하 확대, 최대 3년) 고용보험 정부지원금(최초 5시간 100%, 초과분 80%), 회사 급여 실수령액 및 연차휴가 100% 보장 여부를 실시간 진단합니다.",
  },
  en: {
    title: "Korea Reduced Working Hours for Childcare Subsidy Calculator — Up to 6th Grade & 3 Years",
    description: "Calculate childcare hour reduction government subsidies (100% for first 5h, 80% thereafter), company pay retention rates, and statutory 100% annual leave protections in Korea.",
  },
  ja: {
    title: "韓国 育児期時短勤務給付金＆年次有給休暇保障計算機 — 小6・最大3年拡大",
    description: "男女雇用平等法改正(満12歳・小6以下拡大、最大3年)に基づく雇用保険政府支援金、会社給与の手取り額および年次有給休暇100%保障を即時診断します。",
  },
  zh: {
    title: "韩国育儿期缩短工时政府津贴与年假全额保障计算器 — 扩至小六与最长3年",
    description: "核查男女雇佣平等法最新修订(满12岁或小学六年级以下、最长3年)就业保险政府育儿津贴(前5小时100%、其余80%)、实发工资及年休假全额保障。",
  },
  fr: {
    title: "Allocation de Réduction du Temps de Travail pour Enfants en Corée",
    description: "Calculez les indemnités de l'assurance emploi pour la réduction du temps de travail parental jusqu'à 12 ans et la protection des congés payés en Corée.",
  },
  es: {
    title: "Subsidio por Reducción de Jornada por Cuidado de Hijos en Corea",
    description: "Calcula el subsidio de la seguridad social por reducción horaria por cuidado de hijos (hasta 12 años) y la garantía del 100% de vacaciones anuales en Corea.",
  },
};

const currentMeta = meta[locale] ?? meta.ko;
---

<Layout
  title={currentMeta.title}
  description={currentMeta.description}
  locale={locale}
>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto mb-8 text-center">
      <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary mb-3">
        <span>{locale === 'ko' ? '남녀고용평등법 2026' : 'Equal Employment Opportunity Act 2026'}</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl text-foreground">
        {currentMeta.title.split('—')[0]}
      </h1>
      <p class="mt-3 text-base text-muted-foreground sm:text-lg">
        {currentMeta.description}
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <ReducedWorkingHoursParentingComponent client:load locale={locale} />
    </div>

    {/* Hub-and-Spoke Context / FAQ */}
    <section class="max-w-4xl mx-auto mt-8 rounded-xl border border-border bg-card p-6 space-y-4 text-sm text-muted-foreground">
      <h2 class="text-lg font-bold text-foreground">
        {locale === 'ko' ? '자주 묻는 육아기 근로시간 단축 Q&A' : 'Frequently Asked Questions'}
      </h2>

      <div class="space-y-3">
        <div>
          <h3 class="font-semibold text-foreground">
            {locale === 'ko' ? 'Q1. 육아휴직을 이미 1년 다 썼는데 단축 근무를 또 신청할 수 있나요?' : 'Q1. Can I apply for reduced hours if I already used 1 year of parental leave?'}
          </h3>
          <p class="mt-1">
            {locale === 'ko'
              ? '네, 가능합니다. 육아기 근로시간 단축은 육아휴직과 별도로 기본 1년이 법으로 보장됩니다. 만약 육아휴직을 전혀 쓰지 않았다면 최대 3년까지, 육아휴직을 1년 모두 썼더라도 단축 근무 기본 1년은 언제든 추가로 사용할 수 있습니다.'
              : 'Yes. Reduced working hours are legally guaranteed for 1 year independently of parental leave. If parental leave is unused, it can be extended up to 3 years.'}
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-foreground">
            {locale === 'ko' ? 'Q2. 회사가 단축 근무를 이유로 연차휴가를 깎을 수 있나요?' : 'Q2. Can the company reduce my accrued annual leave days due to reduced hours?'}
          </h3>
          <p class="mt-1">
            {locale === 'ko'
              ? '불가능합니다. 근로기준법 제60조 제6항에 따라 육아기 근로시간 단축 기간은 전일 정상 출근한 것으로 간주됩니다. 따라서 단축 기간 중에도 연차휴가 일수는 단 하루도 삭감되지 않고 100% 온전히 발생합니다.'
              : 'No. Under Article 60-6 of the Labor Standards Act, reduced hours periods are legally deemed full attendance, so leave days cannot be prorated.'}
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-foreground">
            {locale === 'ko' ? 'Q3. 단축 근무 기간 중 퇴직하면 퇴직금이 줄어드나요?' : 'Q3. Does reduced hours diminish my severance pay if I resign?'}
          </h3>
          <p class="mt-1">
            {locale === 'ko'
              ? '손실이 발생하지 않습니다. 남녀고용평등법 제19조의3에 따라 퇴직금 산정의 기초가 되는 평균임금을 계산할 때 단축 기간은 산정 기간에서 제외하거나, 통상임금 최저선을 보장하여 불이익을 받지 않도록 엄격히 법으로 보호됩니다.'
              : 'No. The law mandates that severance pay base wages either exclude reduced periods or guarantee ordinary wage floors to prevent loss.'}
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
