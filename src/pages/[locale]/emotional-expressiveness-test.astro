---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import EmotionalExpressivenessTest from '../../components/tests/EmotionalExpressivenessTest';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<string, { title: string; description: string }> = {
  ko: {
    title: "정서표현성 테스트 — 나는 내 감정을 얼마나 드러내는가?",
    description: "버클리 정서표현성 연구 기반 — 14문항으로 긍정 정서와 부정·취약 정서의 표현을 측정해 나의 정서표현성을 확인하세요.",
  },
  en: {
    title: "Emotional Expressiveness Test — How Much Do You Show Your Emotions?",
    description: "Based on Berkeley Expressivity research — measure positive and negative/vulnerable expressivity with 14 questions to find your emotional expressiveness.",
  },
  ja: {
    title: "感情表現性テスト — 自分の感情をどれくらい表に出すか？",
    description: "バークレー感情表現性研究に基づく — 14の設問で肯定的・否定的/脆弱な感情の表現を測定し、感情表現性を確認しましょう。",
  },
  fr: {
    title: "Test d'Expressivité Émotionnelle — Combien montrez-vous vos émotions ?",
    description: "Basé sur la recherche Berkeley Expressivity — mesurez l'expressivité positive et négative/vulnérable en 14 questions.",
  },
  es: {
    title: "Test de Expresividad Emocional — ¿Cuánto muestras tus emociones?",
    description: "Basado en la investigación Berkeley Expressivity — mide la expresividad positiva y negativa/vulnerable con 14 preguntas.",
  },
  zh: {
    title: "情绪表达性测试 — 你有多常流露自己的情绪？",
    description: "基于伯克利情绪表达性研究 — 用14个问题测量积极情绪与消极/脆弱情绪的表达，了解你的情绪表达性。",
  },
};
const m = meta[locale] ?? meta.en ?? Object.values(meta)[0];
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <EmotionalExpressivenessTest locale={locale as any} client:load />
  </div>
</Layout>
