---
import Layout from '../../layouts/Layout.astro';
import { LOCALES, localePath } from '../../i18n';
import type { Locale } from '../../i18n';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
type L = Locale;
const txt = (map: Record<L, string>) => map[locale] ?? map.ko ?? map.en;

const title = txt({
  ko: '정보 위생 점검표 — 사실·출처·프레임을 분리해 읽기',
  en: 'Information Hygiene Checklist — Separate Facts, Sources, and Frames',
  ja: '情報衛生チェックリスト — 事実・出典・フレームを分けて読む',
  zh: '信息卫生检查表 — 区分事实、来源与框架',
  fr: 'Checklist d’hygiène informationnelle — séparer faits, sources et cadres',
  es: 'Lista de higiene informativa — separar hechos, fuentes y marcos',
});
const description = txt({
  ko: '논쟁적 정보나 시장 브리핑을 읽을 때 사실, 출처, 양측 입장, 프레임을 한 화면에서 정리하는 OIYO 실행 템플릿입니다.',
  en: 'An OIYO execution template for reviewing contested information with facts, sources, steelman viewpoints, and framing notes.',
  ja: '論争的な情報を、事実・出典・主要立場・フレームの4ブロックで整理するOIYO実行テンプレートです。',
  zh: '用事实、来源、多方立场与框架说明四个区块整理争议信息的 OIYO 执行模板。',
  fr: 'Un modèle OIYO pour examiner une information contestée avec faits, sources, points de vue steelman et cadrage.',
  es: 'Una plantilla OIYO para revisar información disputada con hechos, fuentes, posturas steelman y notas de encuadre.',
});

const principles = [
  txt({ ko: '사실과 의견을 분리합니다.', en: 'Separate facts from opinions.', ja: '事実と意見を分けます。', zh: '区分事实与意见。', fr: 'Séparer les faits des opinions.', es: 'Separar hechos y opiniones.' }),
  txt({ ko: '모든 사실 주장에는 출처와 확인일자를 붙입니다.', en: 'Attach a source and verification date to every factual claim.', ja: 'すべての事実主張に出典と確認日を付けます。', zh: '每个事实陈述都附来源与核验日期。', fr: 'Ajouter une source et une date de vérification à chaque fait.', es: 'Añadir fuente y fecha de verificación a cada hecho.' }),
  txt({ ko: '상대 입장이 동의할 만한 형태로 양측 주장을 요약합니다.', en: 'Summarize each side in a form that side would recognize.', ja: '各立場が納得できる形で要約します。', zh: '用各方都能认可的方式概括其立场。', fr: 'Résumer chaque position sous une forme qu’elle reconnaîtrait.', es: 'Resumir cada postura de forma que esa parte la reconocería.' }),
  txt({ ko: '어떤 단어와 강조가 프레임을 만드는지 드러냅니다.', en: 'Name the words and emphasis that create the frame.', ja: 'どの言葉や強調がフレームを作るかを明示します。', zh: '指出哪些词语与强调构成了框架。', fr: 'Nommer les mots et accents qui créent le cadrage.', es: 'Nombrar las palabras y énfasis que crean el marco.' }),
];

const blocks = [
  { n: '01', title: txt({ ko: '사실 타임라인', en: 'Fact timeline', ja: '事実タイムライン', zh: '事实时间线', fr: 'Chronologie des faits', es: 'Cronología de hechos' }), body: txt({ ko: '날짜·수치·발언·문서처럼 검증 가능한 항목만 적습니다. 해석은 다음 블록으로 미룹니다.', en: 'List only verifiable dates, numbers, statements, and documents. Keep interpretation out of this block.', ja: '日付・数値・発言・文書など検証可能な項目だけを書きます。解釈は次のブロックへ。', zh: '只记录日期、数字、发言、文件等可核验项目。解释放到后续区块。', fr: 'Lister seulement dates, chiffres, déclarations et documents vérifiables. Garder l’interprétation pour plus tard.', es: 'Enumera solo fechas, cifras, declaraciones y documentos verificables. Deja la interpretación para después.' }) },
  { n: '02', title: txt({ ko: '출처 표', en: 'Source table', ja: '出典表', zh: '来源表', fr: 'Table des sources', es: 'Tabla de fuentes' }), body: txt({ ko: '공식·1차 출처를 우선하고, 각 출처의 기관명·링크·확인일자·한계를 함께 기록합니다.', en: 'Prefer official or primary sources; record organization, link, checked date, and limitations.', ja: '公式・一次出典を優先し、機関名・リンク・確認日・限界も記録します。', zh: '优先官方/一手来源，并记录机构、链接、核验日期与局限。', fr: 'Privilégier les sources officielles/primaires; noter organisme, lien, date et limites.', es: 'Prioriza fuentes oficiales/primarias; registra entidad, enlace, fecha y límites.' }) },
  { n: '03', title: txt({ ko: '주요 입장 steelman', en: 'Steelman viewpoints', ja: '主要立場のsteelman', zh: '主要立场 steelman', fr: 'Positions steelman', es: 'Posturas steelman' }), body: txt({ ko: '찬성·반대·중립/불확실 입장을 각각 그 입장 지지자가 인정할 만한 형태로 요약합니다.', en: 'Summarize pro, con, and uncertain/neutral positions in their strongest fair form.', ja: '賛成・反対・中立/不確実を、それぞれ最も公正で強い形にします。', zh: '把赞成、反对、中立/不确定立场分别写成最强且公平的版本。', fr: 'Résumer pour, contre et incertain/neutre dans leur version la plus forte et juste.', es: 'Resume a favor, en contra e incierto/neutral en su versión más fuerte y justa.' }) },
  { n: '04', title: txt({ ko: '용어·프레임 노트', en: 'Terms and framing notes', ja: '用語・フレームノート', zh: '术语与框架说明', fr: 'Notes de termes et cadrage', es: 'Notas de términos y marco' }), body: txt({ ko: '같은 사실을 다르게 보이게 만드는 용어, 누락된 비교 기준, 감정적 표현을 표시합니다.', en: 'Flag terms, missing baselines, and emotional wording that change how the same facts feel.', ja: '同じ事実の見え方を変える用語・欠けた基準・感情的表現を示します。', zh: '标出会改变同一事实感受的术语、缺失基准与情绪化表达。', fr: 'Signaler termes, bases de comparaison absentes et formulations émotionnelles.', es: 'Marca términos, bases ausentes y lenguaje emocional que cambian la percepción.' }) },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: title,
    description,
    url: new URL(Astro.url.pathname, Astro.site).toString(),
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    inLanguage: locale,
    isAccessibleForFree: true,
    publisher: { '@id': 'https://oiyo.net/#organization' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: txt({
      ko: '정보 위생 점검표를 쓰는 순서',
      en: 'How to use the information hygiene checklist',
      ja: '情報衛生チェックリストの使い方',
      zh: '如何使用信息卫生检查表',
      fr: 'Comment utiliser la checklist d’hygiène informationnelle',
      es: 'Cómo usar la lista de higiene informativa',
    }),
    description,
    inLanguage: locale,
    step: blocks.map((block, index) => ({
      '@type': 'HowToStep',
      position: index + 1,
      name: block.title,
      text: block.body,
    })),
  },
];
---

<Layout title={title} description={description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <section class="bg-slate-950 text-white px-4 py-16">
    <div class="mx-auto max-w-5xl">
      <p class="mb-3 text-sm font-bold uppercase tracking-[0.24em] text-emerald-300">OIYO · Information Hygiene</p>
      <h1 class="text-3xl md:text-5xl font-black leading-tight">{title}</h1>
      <p class="mt-5 max-w-3xl text-base md:text-lg leading-8 text-slate-200">{description}</p>
      <div class="mt-8 flex flex-wrap gap-3 text-sm">
        <a class="rounded-full bg-emerald-400 px-5 py-3 font-bold text-slate-950" href="#template">{txt({ ko: '4블록 템플릿 보기', en: 'View the 4-block template', ja: '4ブロックを見る', zh: '查看四区块模板', fr: 'Voir le modèle en 4 blocs', es: 'Ver plantilla de 4 bloques' })}</a>
        <a class="rounded-full border border-white/25 px-5 py-3 font-bold text-white" href={localePath(locale, '/political/test')}>{txt({ ko: '정치 나침반으로 이동', en: 'Go to Political Compass', ja: '政治コンパスへ', zh: '前往政治罗盘', fr: 'Aller à la boussole politique', es: 'Ir a la brújula política' })}</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-12">
    <div class="rounded-3xl border border-emerald-100 bg-emerald-50 p-6 md:p-8">
      <h2 class="text-2xl font-black text-emerald-950">{txt({ ko: '비개입 원칙', en: 'Non-intervention principle', ja: '非介入の原則', zh: '非干预原则', fr: 'Principe de non-intervention', es: 'Principio de no intervención' })}</h2>
      <p class="mt-3 leading-7 text-emerald-900">{txt({ ko: '이 도구는 무엇을 믿거나 구매하거나 투표하라고 권하지 않습니다. 판단 전에 정보가 어떤 구조로 서 있는지 확인하도록 돕습니다.', en: 'This tool does not tell you what to believe, buy, or vote for. It helps you inspect how the information is structured before judging.', ja: 'このツールは何を信じる・買う・投票するかを指示しません。判断前に情報の構造を点検します。', zh: '本工具不建议你相信、购买或投票给什么，只帮助你在判断前检查信息结构。', fr: 'Cet outil ne recommande pas quoi croire, acheter ou voter; il aide à inspecter la structure de l’information.', es: 'Esta herramienta no dice qué creer, comprar o votar; ayuda a revisar la estructura informativa antes de juzgar.' })}</p>
      <ul class="mt-5 grid gap-3 md:grid-cols-2">
        {principles.map((p) => <li class="rounded-2xl bg-white px-4 py-3 text-sm font-semibold text-emerald-950 shadow-sm">✓ {p}</li>)}
      </ul>
    </div>
  </section>

  <section id="template" class="mx-auto max-w-5xl px-4 pb-16">
    <div class="grid gap-5 md:grid-cols-2">
      {blocks.map((block) => (
        <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="text-sm font-black text-emerald-600">{block.n}</div>
          <h2 class="mt-2 text-xl font-black text-slate-950">{block.title}</h2>
          <p class="mt-3 min-h-24 leading-7 text-slate-700">{block.body}</p>
          <div class="mt-5 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-500">
            {txt({ ko: '메모 공간: 여기에 주제별 사실·출처·입장·프레임을 복사해 정리하세요.', en: 'Memo area: copy topic-specific facts, sources, viewpoints, and frames here.', ja: 'メモ欄: 事実・出典・立場・フレームをここに整理。', zh: '备忘区：在这里整理事实、来源、立场与框架。', fr: 'Zone mémo : copiez ici faits, sources, positions et cadres.', es: 'Área de notas: copia aquí hechos, fuentes, posturas y marcos.' })}
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
