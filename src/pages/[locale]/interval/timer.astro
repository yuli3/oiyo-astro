---
import Layout from '../../../layouts/Layout.astro';
import { withTrailingSlash, LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import IntervalTimer from '../../../components/tools/IntervalTimer';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<string, { title: string; description: string }> = {
  ko: {
    title: '인터벌 운동 타이머 — 타바타·HIIT·홈트 커스텀 타이머',
    description: '운동·휴식 시간과 세트 수를 직접 정하는 인터벌 타이머. 타바타(20/10×8)·HIIT·홈트에. 소리·색상 큐로 단계 안내, 무료.',
  },
  en: {
    title: 'Interval Timer — Custom Tabata, HIIT & Home Workout Timer',
    description: 'Set your own work/rest and rounds. An interval timer for Tabata (20/10×8), HIIT and home workouts, with sound and color phase cues. Free.',
  },
  ja: {
    title: 'インターバルタイマー — タバタ・HIIT・宅トレ用カスタムタイマー',
    description: '運動・休憩・セット数を自分で設定するインターバルタイマー。タバタ(20/10×8)・HIIT・宅トレに。音と色で段階を案内、無料。',
  },
};
const m = meta[locale] ?? meta.en;

const content: Record<string, {
  introTitle: string;
  intro: string;
  relatedTitle: string;
  related: { href: string; label: string; desc: string }[];
  disclaimer: string;
}> = {
  ko: {
    introTitle: '시계 안 보고, 운동에만 집중하세요',
    intro: '인터벌 운동은 정해진 시간만큼 운동하고 쉬기를 반복합니다. 매번 시계를 볼 필요 없이, 소리와 색으로 단계를 알려주는 타이머에 맡기고 동작에만 집중하세요. 타바타·HIIT·스트레칭·플랭크 등 무엇이든.',
    relatedTitle: '함께 하면 좋은 것',
    related: [
      { href: '/breathing/timer', label: '호흡 타이머', desc: '운동 후 호흡을 정리.' },
      { href: '/journal/today', label: '오늘의 저널', desc: '오늘의 운동·컨디션 기록.' },
      { href: '/emotion/release', label: '감정 흘려보내기', desc: '스트레스를 운동과 함께 비우기.' },
    ],
    disclaimer: '건강 상태에 맞게 강도를 조절하세요. 통증·어지럼증이 있으면 즉시 중단하고 전문가와 상담하세요.',
  },
  en: {
    introTitle: 'Stop watching the clock — focus on moving',
    intro: 'Interval training repeats fixed work and rest periods. Instead of checking the clock, let the timer cue each phase with sound and color while you focus on the movement — Tabata, HIIT, stretching, planks, anything.',
    relatedTitle: 'Pairs well with',
    related: [
      { href: '/breathing/timer', label: 'Breathing Timer', desc: 'Recover your breath after a set.' },
      { href: '/journal/today', label: "Today's Journal", desc: 'Log today’s workout and condition.' },
      { href: '/emotion/release', label: 'Let the Feeling Pass', desc: 'Release stress alongside movement.' },
    ],
    disclaimer: 'Adjust intensity to your health. Stop immediately and consult a professional if you feel pain or dizziness.',
  },
};
const c = content[locale] ?? content.en;
const localizedRelated = c.related.map((item) => ({ ...item, href: withTrailingSlash(`/${locale}${item.href}`) }));
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <IntervalTimer locale={locale} client:load />

    <section class="mt-10 border-t border-green-100 pt-8">
      <h2 class="text-2xl font-bold text-foreground">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-green-800">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.relatedTitle}</h2>
      <div class="mt-4 grid gap-3 md:grid-cols-3">
        {localizedRelated.map((item) => (
          <a class="rounded-xl border border-green-100 bg-card p-4 transition-colors hover:border-green-300 hover:bg-surface-subtle" href={item.href}>
            <span class="font-semibold text-foreground">{item.label}</span>
            <span class="mt-2 block text-sm leading-6 text-green-700">{item.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">
      {c.disclaimer}
    </p>
  </div>
</Layout>
