---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import TestExplainer from '../../components/shared/TestExplainer.astro';
import { TEST_EXPLAINERS } from '../../data/test-explainers';
import DiscPersonalityTest from '../../components/tests/DiscPersonalityTest';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<string, { title: string; description: string }> = {
  ko: {
    title: "DISC 성격 유형 테스트 — 나의 행동 스타일은?",
    description: "12가지 직장·일상 상황 질문으로 DISC 성격 유형을 알아보세요. 주도형(D), 사교형(I), 안정형(S), 신중형(C) 4대 행동 패턴을 정밀 분석하고, 나의 강점과 대인관계 소통 전략 리포트를 즉시 무료로 확인하세요.",
  },
  en: {
    title: "DISC Personality Test — What's Your Behavioral Style?",
    description: "Discover your DISC personality type through 12 workplace questions. Analyze your Dominant, Influential, Steady, or Conscientious traits and get customized interpersonal communication advice instantly for free.",
  },
  ja: {
    title: "DISCパーソナリティテスト — あなたの行動スタイルは？",
    description: "12の職場・日常シナリオでDISCタイプを診断。主導型(D)・社交型(I)・安定型(S)・慎重型(C)の4大行動パターンを分析し、あなたの強みと対人コミュニケーション戦略を今すぐ無料で確認しましょう。",
  },
  fr: {
    title: "Test de Personnalité DISC — Quel est votre style comportemental?",
    description: "Découvrez votre type de personnalité DISC à travers 12 questions situationnelles. Analysez vos tendances Dominant, Influent, Stable ou Consciencieux et obtenez vos conseils de communication gratuitement.",
  },
  es: {
    title: "Test de Personalidad DISC — ¿Cuál es tu estilo de comportamiento?",
    description: "Descubre tu tipo de personalidad DISC con 12 preguntas situacionales. Analiza tus patrones Dominante, Influyente, Estable o Concienzudo y obtén recomendaciones de comunicación al instante y gratis.",
  },
  zh: {
    title: "DISC人格测试 — 你的行为风格是什么？",
    description: "通过12个职场与日常情境问题深入测试DISC人格类型。精准分析主导型(D)、影响型(I)、稳健型(S)与服从型(C)四大特质，立即免费获取你的沟通优势与人际交往分析报告。",
  },
};
const m = meta[locale] ?? meta.en ?? Object.values(meta)[0];
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <DiscPersonalityTest locale={locale as any} client:load />
    <TestExplainer content={TEST_EXPLAINERS['disc-personality']} locale={locale} />
    <div class="mt-4 flex flex-wrap items-center gap-3">
    </div>
  </div>
</Layout>
