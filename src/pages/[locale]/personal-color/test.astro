---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import PersonalColorTest from '../../../components/tests/PersonalColorTest';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '퍼스널컬러 테스트 — 나에게 어울리는 색은?', description: '봄·여름·가을·겨울 4계절 유형과 웜톤·쿨톤을 진단해드립니다.' },
  en: { title: 'Personal Color Test — Which Colors Suit You?', description: 'Discover your seasonal personal color type — Spring, Summer, Autumn, or Winter — and your warm or cool tone.' },
  ja: { title: 'パーソナルカラーテスト — あなたに似合う色は？', description: '春・夏・秋・冬の4シーズンタイプとウォームトーン・クールトーンを診断します。' },
  zh: { title: '个人色彩测试 — 什么颜色适合你？', description: '诊断你的四季个人色彩类型——春、夏、秋、冬——以及暖色调或冷色调。' },
  fr: { title: 'Test de Couleur Personnelle — Quelles couleurs vous conviennent?', description: 'Découvrez votre type de couleur saisonnière — Printemps, Été, Automne ou Hiver — et votre tonalité chaude ou froide.' },
  es: { title: 'Test de Color Personal — ¿Qué colores te favorecen?', description: 'Descubre tu tipo de color estacional — Primavera, Verano, Otoño o Invierno — y tu tono cálido o frío.' },
};
const m = meta[locale] ?? meta.en;

const content: Record<Locale, { introTitle: string; intro: string; conceptTitle: string; concepts: { title: string; body: string }[]; faqTitle: string; faqs: { question: string; answer: string }[]; disclaimer: string; }> = {
  ko: { introTitle: '퍼스널컬러는 사람을 단정하는 라벨이 아니라 어울리는 색의 인상을 보는 렌즈입니다', intro: '퍼스널컬러 테스트는 웜톤과 쿨톤, 계절 팔레트, 대비감이 나의 분위기와 어떻게 만나는지 살펴봅니다. 결과는 정답 색을 고정하기보다 색 선택을 더 즐겁게 해 주는 참고입니다.', conceptTitle: '퍼스널컬러를 읽는 세 가지 관점', concepts: [{ title: '온도감', body: '웜톤과 쿨톤은 피부색을 단정하기보다 색이 주는 조화감을 살피는 기준입니다.' }, { title: '계절 팔레트', body: '봄, 여름, 가을, 겨울은 밝기와 채도, 깊이를 쉽게 묶어 보는 상징입니다.' }, { title: '대비와 분위기', body: '같은 색도 대비가 강한지 부드러운지에 따라 인상이 달라집니다.' }], faqTitle: '자주 묻는 질문', faqs: [{ question: '퍼스널컬러 결과는 얼마나 정확한가요?', answer: '간단한 답변을 바탕으로 한 참고 결과입니다. 조명, 메이크업, 머리색, 취향에 따라 어울림은 달라질 수 있습니다.' }, { question: '결과와 다른 색을 입어도 되나요?', answer: '물론입니다. 퍼스널컬러는 금지 목록이 아니라 색을 고를 때 참고하는 팔레트입니다.' }, { question: '결과를 어떻게 활용하면 좋나요?', answer: '옷, 메이크업, 액세서리에서 먼저 시도해 볼 색 범위를 좁히는 힌트로 사용해 보세요.' }], disclaimer: '퍼스널컬러 결과는 자기 이해와 대화를 위한 참고입니다. 진단, 채용, 관계의 단정적 판단 근거로 사용하지 마세요.' },
  en: { introTitle: 'Personal color is a lens for color impression, not a label that defines you', intro: 'The personal color test looks at how warm or cool tone, seasonal palette, and contrast meet your overall impression. The result is not a fixed rulebook; it is a reference for enjoying color choices more clearly.', conceptTitle: 'Three ways to read personal color', concepts: [{ title: 'Color temperature', body: 'Warm and cool are guides to harmony, not fixed judgments about skin.' }, { title: 'Seasonal palette', body: 'Spring, Summer, Autumn, and Winter group brightness, saturation, and depth in an easy image.' }, { title: 'Contrast and mood', body: 'The same color can feel different depending on whether the contrast is sharp or soft.' }], faqTitle: 'Frequently asked questions', faqs: [{ question: 'How accurate is the personal color result?', answer: 'It is a reference based on brief answers. Lighting, makeup, hair color, and taste can all affect what feels harmonious.' }, { question: 'Can I wear colors outside my result?', answer: 'Of course. Personal color is not a ban list; it is a palette to consult when choosing colors.' }, { question: 'How should I use the result?', answer: 'Use it to narrow the colors you may want to try first in clothes, makeup, or accessories.' }], disclaimer: 'Personal color results are for self-understanding and conversation. Do not use them as a basis for diagnosis, hiring, or definitive relationship judgments.' },
  ja: { introTitle: 'パーソナルカラーは人を決めつけるラベルではなく、似合う色の印象を見るレンズです', intro: 'パーソナルカラーテストはウォーム/クール、季節パレット、コントラストが雰囲気とどう合うかを見ます。結果は正解の色を固定するものではなく、色選びを楽しむための参考です。', conceptTitle: 'パーソナルカラーを読む三つの視点', concepts: [{ title: '色の温度', body: 'ウォーム/クールは肌を決めつけるものではなく、調和を見やすくする基準です。' }, { title: '季節パレット', body: '春夏秋冬は明るさ、彩度、深みをイメージしやすくまとめた象徴です。' }, { title: 'コントラストと雰囲気', body: '同じ色でもコントラストが強いか柔らかいかで印象が変わります。' }], faqTitle: 'よくある質問', faqs: [{ question: 'パーソナルカラーの結果はどれくらい正確ですか？', answer: '短い回答をもとにした参考結果です。照明、メイク、髪色、好みによって似合い方は変わります。' }, { question: '結果と違う色を着てもよいですか？', answer: 'もちろんです。パーソナルカラーは避ける色の一覧ではなく、色選びの参考パレットです。' }, { question: '結果はどう活用すればよいですか？', answer: '服、メイク、アクセサリーでまず試す色の範囲を絞るヒントとして使ってください。' }], disclaimer: 'パーソナルカラーの結果は自己理解と対話のための参考です。診断、採用、人間関係の断定的な判断材料には使わないでください。' },
  zh: { introTitle: '个人色彩是观察适合颜色印象的镜片，不是定义人的标签', intro: '个人色彩测试观察暖冷调、季节色盘和对比度如何与你的整体氛围相遇。结果不是固定规则，而是让色彩选择更轻松的参考。', conceptTitle: '理解个人色彩的三个角度', concepts: [{ title: '色彩温度', body: '暖调和冷调是观察协调感的参考，不是对肤色的固定判断。' }, { title: '季节色盘', body: '春夏秋冬把明度、饱和度和深浅整理成容易理解的象征。' }, { title: '对比与氛围', body: '同一种颜色会因对比强弱不同而带来不同印象。' }], faqTitle: '常见问题', faqs: [{ question: '个人色彩结果有多准确？', answer: '这是基于简短回答的参考结果。光线、妆容、发色和个人喜好都会影响协调感。' }, { question: '可以穿结果以外的颜色吗？', answer: '当然可以。个人色彩不是禁用清单，而是选择颜色时可参考的色盘。' }, { question: '应该如何使用结果？', answer: '可用它缩小衣服、妆容和配饰中优先尝试的颜色范围。' }], disclaimer: '个人色彩结果仅用于自我理解与对话，请勿作为诊断、招聘或关系定论的依据。' },
  fr: { introTitle: 'La couleur personnelle est une lentille pour l’impression des couleurs, pas une étiquette qui vous définit', intro: 'Le test de couleur personnelle observe comment ton chaud/froid, palette saisonnière et contraste rencontrent votre impression. Le résultat n’est pas un règlement fixe, mais une aide pour choisir les couleurs avec plus de plaisir.', conceptTitle: 'Trois façons de lire la couleur personnelle', concepts: [{ title: 'Température couleur', body: 'Chaud et froid guident l’harmonie, sans juger la peau de façon fixe.' }, { title: 'Palette saisonnière', body: 'Printemps, Été, Automne et Hiver regroupent luminosité, saturation et profondeur.' }, { title: 'Contraste et ambiance', body: 'Une même couleur change d’effet selon un contraste net ou doux.' }], faqTitle: 'Questions fréquentes', faqs: [{ question: 'Le résultat est-il fiable ?', answer: 'C’est une référence fondée sur de brèves réponses. Lumière, maquillage, couleur des cheveux et goût personnel influencent l’harmonie.' }, { question: 'Puis-je porter d’autres couleurs ?', answer: 'Bien sûr. La couleur personnelle n’est pas une liste d’interdits, mais une palette de consultation.' }, { question: 'Comment utiliser le résultat ?', answer: 'Servez-vous-en pour choisir les couleurs à essayer d’abord dans les vêtements, le maquillage ou les accessoires.' }], disclaimer: 'Les résultats de couleur personnelle servent à la compréhension de soi et au dialogue. Ne les utilisez pas comme base de diagnostic, de recrutement ou de verdict relationnel.' },
  es: { introTitle: 'El color personal es una lente para la impresión del color, no una etiqueta que te define', intro: 'El test de color personal observa cómo tono cálido/frío, paleta estacional y contraste se encuentran con tu imagen. El resultado no es un reglamento fijo, sino una referencia para disfrutar mejor las elecciones de color.', conceptTitle: 'Tres formas de leer el color personal', concepts: [{ title: 'Temperatura del color', body: 'Cálido y frío orientan la armonía, no son juicios fijos sobre la piel.' }, { title: 'Paleta estacional', body: 'Primavera, Verano, Otoño e Invierno agrupan brillo, saturación y profundidad.' }, { title: 'Contraste y ambiente', body: 'El mismo color cambia de impresión si el contraste es intenso o suave.' }], faqTitle: 'Preguntas frecuentes', faqs: [{ question: '¿Qué tan preciso es el resultado?', answer: 'Es una referencia basada en respuestas breves. Luz, maquillaje, color de pelo y gusto personal influyen en lo que armoniza.' }, { question: '¿Puedo usar colores fuera del resultado?', answer: 'Por supuesto. El color personal no es una lista de prohibiciones, sino una paleta de consulta.' }, { question: '¿Cómo usar el resultado?', answer: 'Úsalo para reducir los colores que quieres probar primero en ropa, maquillaje o accesorios.' }], disclaimer: 'Los resultados de color personal son para autoconocimiento y conversación. No los uses como base para diagnóstico, contratación o juicios definitivos sobre relaciones.' },
};

const c = content[locale] ?? content.en;
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
---
<Layout title={m.title} description={m.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <main class="mx-auto max-w-2xl px-4 py-10">
    <PersonalColorTest client:load locale={locale} />
    <section class="mt-10 border-t border-violet-100 pt-8"><h2 class="text-2xl font-bold text-violet-950">{c.introTitle}</h2><p class="mt-4 leading-8 text-violet-800">{c.intro}</p></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.conceptTitle}</h2><div class="mt-4 grid gap-4 md:grid-cols-3">{c.concepts.map((item) => (<article class="rounded-xl border border-violet-100 bg-white p-4"><h3 class="font-semibold text-violet-950">{item.title}</h3><p class="mt-2 text-sm leading-6 text-violet-700">{item.body}</p></article>))}</div></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.faqTitle}</h2><div class="mt-4 divide-y divide-violet-100 rounded-xl border border-violet-100 bg-white">{c.faqs.map((faq) => (<details class="group p-4"><summary class="cursor-pointer list-none font-semibold text-violet-950">{faq.question}</summary><p class="mt-3 text-sm leading-6 text-violet-700">{faq.answer}</p></details>))}</div></section>
    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>
  </main>
</Layout>
