---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import CrossroadsInvestorTest from '../../../components/tests/CrossroadsInvestorTest';
import RelatedTools from '../../../components/shared/RelatedTools.astro';
import { buildQuizJsonLd } from '../../../lib/seo/quiz-json-ld';
import TestSourceNote from '../../../components/shared/TestSourceNote.astro';
import PrintReportButton from '../../../components/shared/PrintReportButton.astro';
import { TEST_SOURCE_NOTES } from '../../../data/test-source-notes';
export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '갈림길 경제 투자 성향 퀴즈 — 나의 투자자 유형은?', description: '지정학·K자 경제·AI·달러 투자 관점으로 보는 나의 투자 성향. 지정학 리더형·거시분석형·AI혁신형·달러분산형·균형형 중 어떤 유형인가요?' },
  en: { title: 'Crossroads Economy Investor Quiz — What Type of Investor Are You?', description: 'Discover your investor type through geopolitical, K-economy, AI, and dollar investment perspectives. Which are you: Geopolitical Leader, Macro Analyst, AI Innovator, Dollar Diversifier, or Balanced?' },
  ja: { title: '岐路経済投資傾向クイズ — 私はどの投資家タイプ？', description: '地政学・K字経済・AI・ドル投資の視点で見る私の投資傾向。地政学リーダー型・マクロ分析型・AI革新型・ドル分散型・バランス型のどれですか？' },
  zh: { title: '岔路经济投资风格测试 — 你是哪种投资者？', description: '从地缘政治、K形经济、AI和美元投资角度了解你的投资风格。地缘政治领导型、宏观分析型、AI创新型、美元分散型还是均衡型？' },
  fr: { title: 'Quiz Investisseur Économie Carrefour — Quel Type Êtes-Vous?', description: 'Découvrez votre type d\'investisseur à travers les perspectives géopolitique, économie K, IA et dollar. Géopolitique, Macro, IA, Dollar ou Équilibré?' },
  es: { title: 'Quiz Inversor Economía Encrucijada — ¿Qué Tipo Eres?', description: 'Descubre tu tipo de inversor a través de perspectivas geopolíticas, economía K, IA y dólar. ¿Geopolítico, Macro, IA, Dólar o Equilibrado?' },
};
const m = meta[locale] ?? meta.en;

const content: Record<Locale, { introTitle: string; intro: string; conceptTitle: string; concepts: { title: string; body: string }[]; faqTitle: string; faqs: { question: string; answer: string }[]; disclaimer: string; }> = {
  ko: { introTitle: '투자 성향 퀴즈는 사람을 단정하는 라벨이 아니라 경제 이슈를 바라보는 관점을 보는 렌즈입니다', intro: '이 퀴즈는 지정학, 거시경제, AI 혁신, 달러 분산, 균형 감각 중 어떤 관점에 더 끌리는지 살펴봅니다. 결과는 투자 조언이 아니라 의사결정에서 어떤 프레임을 먼저 쓰는지 이해하기 위한 참고입니다.', conceptTitle: '투자 성향을 읽는 세 가지 관점', concepts: [{ title: '관점의 우선순위', body: '어떤 뉴스와 리스크를 먼저 보느냐가 성향을 만듭니다.' }, { title: '위험 해석', body: '위험을 피할 대상, 관리할 변수, 기회 신호 중 무엇으로 보는지 살핍니다.' }, { title: '균형 감각', body: '한 유형이 정답은 아니며 관점의 조합이 의사결정을 더 견고하게 합니다.' }], faqTitle: '자주 묻는 질문', faqs: [{ question: '이 결과가 투자 추천인가요?', answer: '아니요. 결과는 투자 판단이나 매매 추천이 아니라 경제 이슈를 해석하는 개인적 관점을 정리한 것입니다.' }, { question: '결과가 바뀔 수 있나요?', answer: '네. 시장 환경, 경험, 관심 뉴스가 달라지면 관점의 우선순위도 바뀔 수 있습니다.' }, { question: '어떻게 활용하면 좋나요?', answer: '내가 자주 보는 신호와 놓치기 쉬운 신호를 함께 확인해 균형 있는 대화를 위한 자료로 쓰세요.' }], disclaimer: '투자 성향 퀴즈 결과는 자기 이해와 대화를 위한 참고입니다. 진단, 채용, 관계의 단정적 판단이나 투자 결정의 근거로 사용하지 마세요.' },
  en: { introTitle: 'The investor type quiz is a lens for how you frame economic issues, not a label that defines you', intro: 'This quiz looks at which lens draws you more: geopolitics, macro trends, AI innovation, dollar diversification, or balance. The result is not investment advice; it is a reference for understanding the frames you tend to use first.', conceptTitle: 'Three ways to read investor style', concepts: [{ title: 'Priority of lenses', body: 'The news and risks you notice first shape your investor style.' }, { title: 'Reading risk', body: 'Risk can feel like something to avoid, manage, or watch as an opportunity signal.' }, { title: 'Sense of balance', body: 'No type is the answer; combining lenses usually makes decisions sturdier.' }], faqTitle: 'Frequently asked questions', faqs: [{ question: 'Is this investment advice?', answer: 'No. The result is not a trading recommendation or financial decision guide; it summarizes how you tend to interpret economic issues.' }, { question: 'Can my result change?', answer: 'Yes. Market context, experience, and the news you follow can shift your priorities.' }, { question: 'How should I use it?', answer: 'Use it to notice both the signals you watch often and the signals you may overlook, especially in conversation.' }], disclaimer: 'Investor type quiz results are for self-understanding and conversation. Do not use them as a basis for diagnosis, hiring, relationship verdicts, or investment decisions.' },
  ja: { introTitle: '投資傾向クイズは人を決めつけるラベルではなく、経済テーマを見る視点を知るレンズです', intro: 'このクイズは地政学、マクロ経済、AI革新、ドル分散、バランスのどの視点に引かれやすいかを見ます。結果は投資助言ではなく、判断で先に使いやすいフレームを知る参考です。', conceptTitle: '投資傾向を読む三つの視点', concepts: [{ title: '視点の優先順位', body: 'どのニュースやリスクを先に見るかが投資スタイルを形作ります。' }, { title: 'リスクの読み方', body: 'リスクを避けるもの、管理する変数、機会のサインのどれとして見るかを扱います。' }, { title: 'バランス感覚', body: '一つのタイプが正解ではなく、視点の組み合わせが判断を支えます。' }], faqTitle: 'よくある質問', faqs: [{ question: 'これは投資助言ですか？', answer: 'いいえ。売買推奨や金融判断の指針ではなく、経済テーマの解釈傾向を整理するものです。' }, { question: '結果は変わりますか？', answer: '変わります。市場環境、経験、追っているニュースによって優先する視点は変化します。' }, { question: 'どう活用すればよいですか？', answer: 'よく見るサインと見落としやすいサインを確認し、バランスのある対話の材料にしてください。' }], disclaimer: '投資傾向クイズの結果は自己理解と対話のための参考です。診断、採用、人間関係の断定的判断や投資判断の根拠には使わないでください。' },
  zh: { introTitle: '投资风格测试是观察你看待经济议题角度的镜片，不是定义人的标签', intro: '本测试观察你更倾向地缘政治、宏观趋势、AI创新、美元分散还是均衡视角。结果不是投资建议，而是帮助你理解自己决策时常先使用哪些框架。', conceptTitle: '理解投资风格的三个角度', concepts: [{ title: '视角优先级', body: '你最先注意的新闻和风险，会塑造投资风格。' }, { title: '风险解读', body: '风险可能被看作需要避开的对象、需要管理的变量，或机会信号。' }, { title: '均衡感', body: '没有哪一种类型是标准答案，组合不同视角通常让判断更稳。' }], faqTitle: '常见问题', faqs: [{ question: '这是投资建议吗？', answer: '不是。结果不是交易建议或金融决策指南，只是整理你解释经济议题时的倾向。' }, { question: '结果会改变吗？', answer: '会。市场环境、经验和你关注的新闻都会改变视角优先级。' }, { question: '应该如何使用？', answer: '用它来发现你常看的信号和可能忽略的信号，作为更平衡讨论的材料。' }], disclaimer: '投资风格测试结果仅用于自我理解与对话，请勿作为诊断、招聘、关系定论或投资决定的依据。' },
  fr: { introTitle: 'Le quiz de profil investisseur est une lentille pour cadrer les enjeux économiques, pas une étiquette qui vous définit', intro: 'Ce quiz observe l’angle qui vous attire le plus entre géopolitique, macroéconomie, IA, dollar et équilibre. Le résultat n’est pas un conseil financier; il aide à comprendre les cadres que vous utilisez d’abord.', conceptTitle: 'Trois façons de lire le profil investisseur', concepts: [{ title: 'Priorité des angles', body: 'Les nouvelles et risques que vous remarquez d’abord façonnent votre style.' }, { title: 'Lecture du risque', body: 'Le risque peut être à éviter, à gérer, ou à lire comme signal d’opportunité.' }, { title: 'Sens de l’équilibre', body: 'Aucun type n’est la réponse; combiner les angles rend souvent la décision plus solide.' }], faqTitle: 'Questions fréquentes', faqs: [{ question: 'Est-ce un conseil d’investissement ?', answer: 'Non. Le résultat n’est ni recommandation d’achat ou de vente, ni guide financier; il résume votre manière d’interpréter les enjeux économiques.' }, { question: 'Le résultat peut-il changer ?', answer: 'Oui. Le contexte de marché, l’expérience et les nouvelles suivies peuvent déplacer vos priorités.' }, { question: 'Comment l’utiliser ?', answer: 'Utilisez-le pour repérer les signaux que vous regardez souvent et ceux que vous pourriez négliger.' }], disclaimer: 'Les résultats du quiz investisseur servent à la compréhension de soi et au dialogue. Ne les utilisez pas comme base de diagnostic, de recrutement, de verdict relationnel ou de décision financière.' },
  es: { introTitle: 'El quiz de tipo inversor es una lente para enfocar temas económicos, no una etiqueta que te define', intro: 'Este quiz observa qué enfoque te atrae más: geopolítica, macro, IA, dólar o equilibrio. El resultado no es asesoramiento financiero; ayuda a entender los marcos que sueles usar primero.', conceptTitle: 'Tres formas de leer el tipo inversor', concepts: [{ title: 'Prioridad de enfoques', body: 'Las noticias y riesgos que notas primero moldean tu estilo inversor.' }, { title: 'Lectura del riesgo', body: 'El riesgo puede sentirse como algo a evitar, gestionar o leer como señal de oportunidad.' }, { title: 'Sentido de equilibrio', body: 'Ningún tipo es la respuesta; combinar enfoques suele fortalecer las decisiones.' }], faqTitle: 'Preguntas frecuentes', faqs: [{ question: '¿Esto es asesoramiento de inversión?', answer: 'No. El resultado no es recomendación de compra o venta ni guía financiera; resume cómo tiendes a interpretar temas económicos.' }, { question: '¿Puede cambiar el resultado?', answer: 'Sí. El contexto de mercado, la experiencia y las noticias que sigues pueden cambiar tus prioridades.' }, { question: '¿Cómo usarlo?', answer: 'Úsalo para notar las señales que miras mucho y las que quizá pasas por alto.' }], disclaimer: 'Los resultados del quiz inversor son para autoconocimiento y conversación. No los uses como base para diagnóstico, contratación, juicios de relación o decisiones de inversión.' },
};

const c = content[locale] ?? content.en;
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
const quizJsonLd = buildQuizJsonLd({
  name: m.title,
  description: m.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  inLanguage: locale,
  questions: [],
});

---
<Layout title={m.title} description={m.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(quizJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="mx-auto max-w-2xl px-4 py-10">
    <CrossroadsInvestorTest client:load locale={locale} />
    <section class="mt-10 border-t border-green-100 pt-8"><h2 class="text-2xl font-bold text-green-950">{c.introTitle}</h2><p class="mt-4 leading-8 text-green-800">{c.intro}</p></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-green-950">{c.conceptTitle}</h2><div class="mt-4 grid gap-4 md:grid-cols-3">{c.concepts.map((item) => (<article class="rounded-xl border border-green-100 bg-white p-4"><h3 class="font-semibold text-green-950">{item.title}</h3><p class="mt-2 text-sm leading-6 text-green-700">{item.body}</p></article>))}</div></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-green-950">{c.faqTitle}</h2><div class="mt-4 divide-y divide-green-100 rounded-xl border border-green-100 bg-white">{c.faqs.map((faq) => (<details class="group p-4"><summary class="cursor-pointer list-none font-semibold text-green-950">{faq.question}</summary><p class="mt-3 text-sm leading-6 text-green-700">{faq.answer}</p></details>))}</div></section>
    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>
    <RelatedTools locale={locale} tools={['mbti','eq','enneagram','perfectionism']} current="investmentType" />
  <PrintReportButton locale={locale} />
  <TestSourceNote locale={locale} note={TEST_SOURCE_NOTES['investment-type']} />
  </div>
</Layout>
