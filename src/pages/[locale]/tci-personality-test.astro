---
import Layout from '../../layouts/Layout.astro';
import TestExplainer from '../../components/shared/TestExplainer.astro';
import TestConceptLink from '../../components/shared/TestConceptLink.astro';
import { TEST_EXPLAINERS } from '../../data/test-explainers';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import TciPersonalityTest from '../../components/tests/TciPersonalityTest';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<string, { title: string; description: string }> = {
  ko: {
    title: "TCI 기질 및 성격 검사 — 클로닌저 7차원 성격 분석",
    description: "클로닌저 심리학 모델 기반 TCI 기질 및 성격 검사. 타고난 4대 기질(자극추구·위험회피·보상의존·인내력)과 후천적 3대 성격(자율성·연대감·자기초월) 7개 차원을 심층 분석하고, 나만의 고유한 심리 프로필과 성장 가이드를 무료로 확인하세요.",
  },
  en: {
    title: "TCI Temperament & Character Test — Cloninger's 7-Dimension Analysis",
    description: "Free TCI test based on Cloninger's model. Explore 4 inborn temperaments and 3 character dimensions to uncover your personality pattern and growth roadmap.",
  },
  ja: {
    title: "TCI気質・性格検査 — クロニンジャー7次元性格分析",
    description: "クロニンジャー心理学モデルに基づくTCI気質・性格検査。生まれ持った4大気質（刺激追求・危険回避・報酬依存・忍耐力）と後天的3大性格（自己主導・協調・自己超越）の7次元を深層分析し、自分だけの成長指針を無料で確認しましょう。",
  },
  fr: {
    title: "Test TCI Tempérament & Caractère — Analyse 7 Dimensions de Cloninger",
    description: "Test TCI basé sur le modèle de Cloninger. Évaluez 4 tempéraments et 3 caractères pour révéler votre profil psychologique et vos axes de développement personnel.",
  },
  es: {
    title: "Test TCI Temperamento y Carácter — Análisis de 7 Dimensiones de Cloninger",
    description: "Test TCI basado en el modelo de Cloninger. Evalúa 4 temperamentos y 3 caracteres para descubrir tu perfil psicológico y claves de crecimiento personal.",
  },
  zh: {
    title: "TCI气质与性格测验 — Cloninger 7维度人格分析",
    description: "基于Cloninger心理学模型的TCI气质与性格测验。深入分析4大先天生得气质（新奇寻求·避害·奖赏依赖·坚持）与3大后天成熟性格（自导·合作·自超）共7个维度，即刻免费获取个性化心理成长分析。",
  },
};
const m = meta[locale] ?? meta.en ?? Object.values(meta)[0];
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <TciPersonalityTest locale={locale as any} client:load />
    <TestConceptLink locale={locale} path="/tci/about" />
    <TestExplainer content={TEST_EXPLAINERS['tci-personality']} locale={locale as Locale} />
  </div>
</Layout>
