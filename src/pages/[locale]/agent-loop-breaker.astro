---
import Layout from "../../layouts/Layout.astro";
import { LOCALES } from "../../i18n";
import type { Locale } from "../../i18n";
import AgentLoopBreaker from "../../components/tools/AgentLoopBreaker";

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "AI 에이전트 무한 루프 브레이커 (서킷 브레이커) | OIYO Tools",
    description: "동일 도구 3회 중복 호출, 핑퐁 루프(A-B-A-B), 연속 실패 정체를 0.1ms 내에 실시간 감지하여 토큰 낭비와 무한 루프를 원천 차단하는 에이전트 서킷 브레이커입니다.",
  },
  en: {
    title: "AI Agent Infinite Loop Circuit Breaker | OIYO Tools",
    description: "Zero-dependency sub-millisecond AI agent infinite loop breaker, ping-pong tool call detector, and circuit breaker engine.",
  },
  ja: {
    title: "AIエージェント 無限ループブレーカー（サーキットブレーカー） | OIYO Tools",
    description: "同一ツールの連続重複呼び出し、ピンポンループ（A-B-A-B）、連続失敗による膠着を0.1msで検知・遮断するサーキットブレーカー。",
  },
  zh: {
    title: "AI Agent 死循环与乒乓调用熔断器 (Circuit Breaker) | OIYO Tools",
    description: "零依赖毫秒级 AI Agent 死循环拦截器，实时侦测同一工具重复调用、交替乒乓死锁与连续失败状态，杜绝 Token 消耗浪费。",
  },
  fr: {
    title: "Disjoncteur de boucle infinie pour agents IA | OIYO Tools",
    description: "Interrupteur de boucle d'agent IA sans dépendance pour détecter les appels répétés, les boucles ping-pong et éviter le gaspillage de tokens.",
  },
  es: {
    title: "Disyuntor de bucle infinito para agentes de IA | OIYO Tools",
    description: "Herramienta para detectar bucles infinitos de agentes IA, llamadas ping-pong duplicadas y bloqueos consecutivos en submilisegundos.",
  },
};

const currentMeta = meta[locale] ?? meta.ko;
---

<Layout title={currentMeta.title} description={currentMeta.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 space-y-8">
    <div class="text-center space-y-2 max-w-2xl mx-auto">
      <h1 class="text-3xl font-extrabold tracking-tight">AI 에이전트 무한 루프 브레이커</h1>
      <p class="text-muted-foreground text-sm">
        동일 도구 반복 호출, 핑퐁 교착 루프 및 연속 에러 정체 실시간 탐지·차단(Circuit Breaker) 엔진
      </p>
    </div>

    <AgentLoopBreaker client:load locale={locale} />

    <div class="max-w-4xl mx-auto border rounded-xl p-6 bg-card border-border space-y-4">
      <h2 class="text-lg font-bold">자율 에이전트 무한 루프 방지 3대 핵심 원칙</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-muted-foreground leading-relaxed">
        <div class="space-y-1">
          <h3 class="font-semibold text-foreground">💡 동일 인자 시그니처 감지</h3>
          <p>
            파일 수정 실패나 테스트 실패 시 에이전트가 동일한 인자로 도구를 3회 이상 연속 호출하는 것은 전형적인 환각·교착 징후입니다. 이를 감지하여 <strong>즉시 실행을 멈추고 다른 경로를 탐색</strong>하게 해야 합니다.
          </p>
        </div>
        <div class="space-y-1">
          <h3 class="font-semibold text-foreground">💡 핑퐁(Ping-Pong) 상호의존 순환 절단</h3>
          <p>
            서브에이전트 A와 B, 혹은 도구 A와 도구 B가 서로의 출력을 입력으로 삼아 순환 호출을 반복하는 경우, 2사이클 이상 감지 시 <strong>서킷을 열어(Tripped) 선형 작업 순서로 강제 변환</strong>합니다.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
