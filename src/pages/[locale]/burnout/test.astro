---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import BurnoutTest from '../../../components/tests/BurnoutTest';
import TestContentBridge from '../../../components/shared/TestContentBridge.astro';
import { getTestBridge } from '../../../data/test-content-bridges';
import RelatedTools from '../../../components/shared/RelatedTools.astro';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '번아웃 테스트 — 나는 번아웃인가?', description: '감정 소진·이인화·성취감 저하 3가지 차원으로 번아웃 위험도를 측정하고 회복 방법을 제시합니다.' },
  en: { title: 'Burnout Test — Are You Burned Out?', description: 'Measure your burnout risk across emotional exhaustion, depersonalization, and personal accomplishment, with recovery tips.' },
  ja: { title: 'バーンアウトテスト — 燃え尽き症候群チェック', description: '感情的消耗・離人化・達成感の低下の3次元でバーンアウトリスクを測定し、回復方法を提示します。' },
  zh: { title: '职业倦怠测试 — 你倦怠了吗？', description: '从情绪耗竭、去人格化和个人成就感三个维度测量你的倦怠风险，并提供恢复建议。' },
  fr: { title: "Test de Burnout — Êtes-vous épuisé(e)?", description: "Mesurez votre risque de burnout selon l'épuisement émotionnel, la dépersonnalisation et l'accomplissement personnel, avec des conseils de récupération." },
  es: { title: 'Test de Burnout — ¿Estás agotado/a?', description: 'Mide tu riesgo de burnout en agotamiento emocional, despersonalización y logro personal, con consejos de recuperación.' },
};
const m = meta[locale] ?? meta.en;
const bridge = getTestBridge('burnout', locale);

const content: Record<Locale, { introTitle: string; intro: string; conceptTitle: string; concepts: { title: string; body: string }[]; faqTitle: string; faqs: { question: string; answer: string }[]; disclaimer: string; }> = {
  ko: { introTitle: '번아웃은 사람을 단정하는 라벨이 아니라 소진과 회복 필요 신호를 보는 렌즈입니다', intro: '번아웃 테스트는 감정 소진, 거리두기, 성취감 저하가 일상과 일에서 어떻게 나타나는지 살펴봅니다. 결과는 나를 몰아붙이기 위한 점수가 아니라 부담을 줄이고 회복 자원을 확인하기 위한 참고입니다.', conceptTitle: '번아웃을 읽는 세 가지 관점', concepts: [{ title: '감정 소진', body: '쉬어도 잘 회복되지 않는 피로와 감정의 고갈감을 봅니다.' }, { title: '거리두기', body: '사람, 일, 역할에서 마음이 멀어지는 방식을 살핍니다.' }, { title: '회복 신호', body: '부담을 줄이고 자원을 회복해야 할 단서를 찾습니다.' }], faqTitle: '자주 묻는 질문', faqs: [{ question: '번아웃 결과는 얼마나 정확한가요?', answer: '현재 답변에 나타난 소진 경향을 요약한 참고 자료입니다. 업무 강도, 수면, 지원 환경에 따라 달라질 수 있습니다.' }, { question: '이 결과가 전문적인 진단을 대신하나요?', answer: '아니요. 이 테스트는 임상 진단이 아닙니다. 소진감이나 걱정이 오래 지속되면 자격을 갖춘 전문가와 상담해 주세요.' }, { question: '결과를 어떻게 활용하면 좋나요?', answer: '책임을 더 떠안기보다 줄일 부담, 회복할 자원, 도움을 요청할 지점을 찾는 데 사용해 보세요.' }], disclaimer: '번아웃 테스트 결과는 자기 이해와 대화를 위한 참고입니다. 진단, 채용, 관계의 단정적 판단 근거로 사용하지 마세요.' },
  en: { introTitle: 'Burnout is a lens for exhaustion and recovery-need signals, not a label that defines you', intro: 'The burnout test looks at how emotional exhaustion, detachment, and reduced accomplishment show up in work and daily life. The result is not a score for pushing yourself harder; it is a reference for reducing load and rebuilding resources.', conceptTitle: 'Three ways to read burnout', concepts: [{ title: 'Emotional exhaustion', body: 'Tiredness and emotional depletion that do not lift easily with ordinary rest.' }, { title: 'Detachment', body: 'How your mind pulls away from people, work, or roles.' }, { title: 'Recovery signal', body: 'Clues that load needs to be reduced and resources rebuilt.' }], faqTitle: 'Frequently asked questions', faqs: [{ question: 'How accurate is the burnout result?', answer: 'It summarizes exhaustion tendencies shown in your current answers. Workload, sleep, and support can shift it.' }, { question: 'Does this replace a professional diagnosis?', answer: 'No. This test is not a clinical diagnosis. If exhaustion or concerns persist, consider speaking with a qualified professional.' }, { question: 'How should I use the result?', answer: 'Use it to identify load to reduce, resources to rebuild, and places where asking for support may help.' }], disclaimer: 'Burnout test results are for self-understanding and conversation. Do not use them as a basis for diagnosis, hiring, or definitive relationship judgments.' },
  ja: { introTitle: 'バーンアウトは人を決めつけるラベルではなく、消耗と回復の必要サインを見るレンズです', intro: 'バーンアウトテストは感情的消耗、距離感、達成感の低下が仕事や日常にどう表れるかを見ます。結果は自分をさらに追い込む点数ではなく、負担を減らし資源を回復する参考です。', conceptTitle: 'バーンアウトを読む三つの視点', concepts: [{ title: '感情的消耗', body: '普通の休息では戻りにくい疲れや感情の枯渇を見ます。' }, { title: '距離感', body: '人、仕事、役割から心が離れていく様子を見ます。' }, { title: '回復のサイン', body: '負担を減らし資源を回復する必要の手がかりを探します。' }], faqTitle: 'よくある質問', faqs: [{ question: 'バーンアウトの結果はどれくらい正確ですか？', answer: '現在の回答に表れた消耗傾向の要約です。仕事量、睡眠、支援環境で変わることがあります。' }, { question: '専門的な診断の代わりになりますか？', answer: 'いいえ。このテストは臨床的な診断ではありません。消耗感や心配が続く場合は、資格のある専門家に相談してください。' }, { question: '結果はどう使えばよいですか？', answer: 'さらに責任を背負うためではなく、減らす負担、回復する資源、助けを求める場所を見つけるために使ってください。' }], disclaimer: 'バーンアウトテストの結果は自己理解と対話のための参考です。診断、採用、人間関係の断定的判断には使わないでください。' },
  zh: { introTitle: '职业倦怠是观察耗竭与恢复需求信号的镜片，不是定义人的标签', intro: '职业倦怠测试观察情绪耗竭、疏离感和成就感降低在工作与生活中如何出现。结果不是让你继续逼自己的分数，而是帮助你减轻负担、重建资源的参考。', conceptTitle: '理解职业倦怠的三个角度', concepts: [{ title: '情绪耗竭', body: '观察普通休息也难以恢复的疲惫和情绪枯竭。' }, { title: '疏离感', body: '看内心如何与人、工作或角色拉开距离。' }, { title: '恢复信号', body: '寻找需要减轻负担、重建资源的线索。' }], faqTitle: '常见问题', faqs: [{ question: '职业倦怠结果有多准确？', answer: '它概括的是当前回答中的耗竭倾向。工作量、睡眠和支持环境都会影响结果。' }, { question: '这个结果能代替专业诊断吗？', answer: '不能。本测试不是临床诊断。如果耗竭感或担忧持续存在，请考虑咨询合格的专业人士。' }, { question: '应该如何使用结果？', answer: '用它来寻找可以减少的负担、需要恢复的资源，以及可以求助的位置。' }], disclaimer: '职业倦怠测试结果仅用于自我理解与对话，请勿作为诊断、招聘或关系定论的依据。' },
  fr: { introTitle: 'Le burnout est une lentille sur l’épuisement et le besoin de récupération, pas une étiquette qui vous définit', intro: 'Le test de burnout observe l’épuisement émotionnel, le détachement et la baisse d’accomplissement au travail et au quotidien. Le résultat ne sert pas à se pousser davantage, mais à réduire la charge et reconstruire les ressources.', conceptTitle: 'Trois façons de lire le burnout', concepts: [{ title: 'Épuisement émotionnel', body: 'Une fatigue et une vidange émotionnelle qui ne passent pas avec un repos ordinaire.' }, { title: 'Détachement', body: 'La façon dont l’esprit s’éloigne des personnes, du travail ou des rôles.' }, { title: 'Signal de récupération', body: 'Les indices qu’il faut réduire la charge et reconstruire les ressources.' }], faqTitle: 'Questions fréquentes', faqs: [{ question: 'Le résultat est-il fiable ?', answer: 'Il résume les tendances d’épuisement visibles dans vos réponses. Charge de travail, sommeil et soutien peuvent le modifier.' }, { question: 'Cela remplace-t-il un diagnostic professionnel ?', answer: 'Non. Ce test n’est pas un diagnostic clinique. Si l’épuisement ou les inquiétudes persistent, consultez un professionnel qualifié.' }, { question: 'Comment l’utiliser ?', answer: 'Utilisez-le pour repérer la charge à réduire, les ressources à reconstruire et les endroits où demander du soutien.' }], disclaimer: 'Les résultats du test de burnout servent à la compréhension de soi et au dialogue. Ne les utilisez pas comme base de diagnostic, de recrutement ou de verdict relationnel.' },
  es: { introTitle: 'El burnout es una lente sobre agotamiento y necesidad de recuperación, no una etiqueta que te define', intro: 'El test de burnout observa agotamiento emocional, distancia y menor logro en trabajo y vida diaria. El resultado no es para exigirte más, sino una referencia para reducir carga y reconstruir recursos.', conceptTitle: 'Tres formas de leer el burnout', concepts: [{ title: 'Agotamiento emocional', body: 'Cansancio y vaciamiento emocional que no ceden con descanso ordinario.' }, { title: 'Distancia', body: 'Cómo la mente se aleja de personas, trabajo o roles.' }, { title: 'Señal de recuperación', body: 'Pistas de que conviene reducir carga y reconstruir recursos.' }], faqTitle: 'Preguntas frecuentes', faqs: [{ question: '¿Qué tan preciso es el resultado?', answer: 'Resume tendencias de agotamiento que aparecen en tus respuestas. Carga laboral, sueño y apoyo pueden cambiarlo.' }, { question: '¿Sustituye a un diagnóstico profesional?', answer: 'No. Este test no es un diagnóstico clínico. Si el agotamiento o las preocupaciones persisten, considera hablar con un profesional cualificado.' }, { question: '¿Cómo usarlo?', answer: 'Úsalo para identificar carga a reducir, recursos a reconstruir y lugares donde pedir apoyo.' }], disclaimer: 'Los resultados del test de burnout son para autoconocimiento y conversación. No los uses como base para diagnóstico, contratación o juicios definitivos sobre relaciones.' },
};

const c = content[locale] ?? content.en;
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
---
<Layout title={m.title} description={m.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="mx-auto max-w-2xl px-4 py-10">
    <BurnoutTest client:load locale={locale} />
    <section class="mt-10 border-t border-violet-100 pt-8"><h2 class="text-2xl font-bold text-violet-950">{c.introTitle}</h2><p class="mt-4 leading-8 text-violet-800">{c.intro}</p></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.conceptTitle}</h2><div class="mt-4 grid gap-4 md:grid-cols-3">{c.concepts.map((item) => (<article class="rounded-xl border border-violet-100 bg-white p-4"><h3 class="font-semibold text-violet-950">{item.title}</h3><p class="mt-2 text-sm leading-6 text-violet-700">{item.body}</p></article>))}</div></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.faqTitle}</h2><div class="mt-4 divide-y divide-violet-100 rounded-xl border border-violet-100 bg-white">{c.faqs.map((faq) => (<details class="group p-4"><summary class="cursor-pointer list-none font-semibold text-violet-950">{faq.question}</summary><p class="mt-3 text-sm leading-6 text-violet-700">{faq.answer}</p></details>))}</div></section>
    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>
    <TestContentBridge content={bridge.content} blogUrl={bridge.blogUrl} wikiUrl={bridge.wikiUrl} />
    <RelatedTools locale={locale} tools={['depression','anxiety','lethargy','commuteMental']} current="burnout" />
  </div>
</Layout>
