import RelatedTools from '../../components/shared/RelatedTools.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '우리의 지도 — 2~10명이 모이면 어떤 모임인가', description: '생년월일만으로 오행·음양·띠·태양궁·일간·지지·마야·켈트 아홉 관점을 겹쳐 읽습니다. 몰린 기운과 빈자리, 누가 그 자리를 채우는지, 그리고 오늘의 우리까지.' },
  en: { title: 'Our Map — what kind of group you are together', description: 'Nine lenses from birth dates alone: five elements, yin-yang, zodiac, sun sign, day master, branches, Mayan, Celtic. What the group has too much of, what it lacks, who fills the gap — and how today lands.' },
  ja: { title: '私たちの地図 — 2〜10人が集まるとどんな集まりか', description: '生年月日だけで五行・陰陽・干支・太陽星座・日干・地支・マヤ・ケルトの九つの視点を重ねて読みます。偏った気と空いた席、それを埋める人、そして今日のわたしたち。' },
  zh: { title: '我们的地图 — 2到10人聚在一起是怎样的组合', description: '仅凭出生日期，叠加五行、阴阳、生肖、太阳星座、日干、地支、玛雅与凯尔特九种视角。偏多的气、空缺的位置、由谁补上，以及今天的我们。' },
  fr: { title: 'Notre carte — quel groupe vous formez ensemble', description: 'Neuf perspectives à partir des seules dates de naissance : cinq éléments, yin-yang, zodiaque, signe solaire, maître du jour, branches, maya, celte. Ce qui abonde, ce qui manque, qui comble — et ce que donne aujourd’hui.' },
  es: { title: 'Nuestro mapa — qué grupo formáis juntos', description: 'Nueve perspectivas solo con las fechas de nacimiento: cinco elementos, yin-yang, zodiaco, signo solar, tronco del día, ramas, maya y celta. Lo que sobra, lo que falta, quién lo cubre y cómo cae hoy.' },
};
const m = meta[locale] ?? meta.en;
/**
 * 본문 — audit:mystic-seo 의 고정 템플릿(introTitle·concepts·useCases·faqs·
 * reading·disclaimer)을 따른다. 2026-09-21 궁합을 이 페이지로 모은 뒤 목적지가
 * 됐으므로 다른 신비 도구와 같은 수준의 본문을 갖춘다. 예전 안내문은 렌즈 넷과
 * 이미 걷어낸 "중심 인물 바꾸기"를 설명하고 있어 지금 기능(아홉 관점·우리 기운·
