const c = content[locale] ?? content.en;
const canonicalUrl = `https://oiyo.net/${locale}/circle/`;
const webApplicationJsonLd = {
  '@type': 'WebApplication',
  name: m.title,
  description: m.description,
  url: canonicalUrl,
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Any',
  inLanguage: locale,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
  publisher: { '@id': 'https://oiyo.net/#organization' },
};
const howToJsonLd = {
  '@type': 'HowTo',
  name: c.introTitle,
  description: c.intro,
  step: c.steps.map((text, index) => ({ '@type': 'HowToStep', position: index + 1, text })),
};
const faqJsonLd = {
  '@type': 'FAQPage',
  mainEntity: c.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
const structuredData = { '@context': 'https://schema.org', '@graph': [webApplicationJsonLd, howToJsonLd, faqJsonLd] };
---

<Layout title={m.title} description={m.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <div class="mx-auto max-w-4xl px-4 py-8 sm:py-12">
    <CircleGathering client:load locale={locale} />

    <div class="mx-auto mt-14 max-w-3xl border-t border-border pt-10 sm:mt-20 sm:pt-14">
      <section aria-labelledby="circle-intro">
        <h2 id="circle-intro" class="text-balance text-2xl font-black tracking-tight text-foreground sm:text-3xl">{c.introTitle}</h2>
        <p class="mt-4 text-pretty leading-7 text-muted-foreground">{c.intro}</p>
        <ol class="mt-7 space-y-4">
          {c.steps.map((step, index) => (
            <li class="flex gap-4 text-sm leading-6 text-foreground sm:text-base">
              <span aria-hidden="true" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent font-black text-foreground">{index + 1}</span>
              <span class="pt-1">{step}</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="mt-12">
        <h2 class="text-xl font-black text-foreground">{c.conceptTitle}</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {c.concepts.map((item) => (
            <article class="rounded-2xl border border-border bg-card p-4">
              <h3 class="font-bold text-foreground">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">{item.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="mt-12">
        <h2 class="text-xl font-black text-foreground">{c.useTitle}</h2>
        <div class="mt-4 grid gap-4 md:grid-cols-3">
          {c.useCases.map((item) => (
            <article class="rounded-2xl bg-surface-subtle p-4">
              <h3 class="font-bold text-foreground">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">{item.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="mt-12">
        <h2 class="text-xl font-black text-foreground">{c.faqTitle}</h2>
        <div class="mt-4 divide-y divide-border border-y border-border">
          {c.faqs.map((faq) => (
            <details class="group py-4">
              <summary class="cursor-pointer list-none pr-8 font-bold leading-6 text-foreground marker:hidden">{faq.question}</summary>
              <p class="mt-3 text-sm leading-6 text-muted-foreground sm:text-base">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="mt-12">
        <h2 class="text-xl font-black text-foreground">{c.readingTitle}</h2>
        {/* 같은 사이트 안의 글·도구라 같은 탭에서 연다. */}
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          {c.reading.map((item) => (
            <a class="rounded-2xl border border-border bg-card p-4 transition-colors hover:bg-surface-subtle" href={item.href}>
              <span class="font-bold text-foreground">{item.label}</span>
              <span class="mt-2 block text-sm leading-6 text-muted-foreground">{item.desc}</span>
            </a>
          ))}
        </div>
      </section>

      <p class="mt-10 rounded-2xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>
    </div>

    <RelatedTools locale={locale} tools={['fortunePeriodic', 'sajuPeriodic', 'chineseZodiac']} current="circle" />
  </div>
</Layout>
