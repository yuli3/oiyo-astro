---
// 꿈 상징 개별 페이지. 머리말은 dream-symbols.ts, 본문은 explainers 컬렉션.
//
// 사전은 상징을 하나씩 늘려 가고 번역도 로케일마다 순차로 올라간다. 그래서
// 경로는 **본문이 실제로 있는 (로케일, 상징) 조합만** 낸다 — 데이터에 있다는
// 이유로 경로를 내면 번역이 없는 칸에서 빌드가 죽는다.
import Layout from '../../../layouts/Layout.astro';
import ExplainerArticle from '../../../components/shared/ExplainerArticle.astro';
import { DREAM_SYMBOL_BY_ID, DREAM_CATEGORY_LABELS } from '../../../data/dream-symbols';
import type { Locale } from '../../../i18n';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('explainers', (e) => e.data.topic.startsWith('dream-'));
  return entries
    .filter((e) => DREAM_SYMBOL_BY_ID[e.data.topic.slice('dream-'.length)])
    .map((e) => ({
      params: { locale: e.data.locale, symbol: e.data.topic.slice('dream-'.length) },
    }));
}
const { locale, symbol } = Astro.params as { locale: Locale; symbol: string };
const sym = DREAM_SYMBOL_BY_ID[symbol];
const entry = await getEntry('explainers', `${locale}/dream-${symbol}`);
if (!sym || !entry) throw new Error(`꿈 상징 없음: ${locale}/${symbol}`);

const BACK: Record<Locale, string> = {
  ko: '꿈 상징 사전', en: 'Dream symbol index', ja: '夢の象徴事典',
  zh: '梦境象征词典', fr: 'Index des symboles oniriques', es: 'Índice de símbolos oníricos',
};
const related = sym.related.map((id) => DREAM_SYMBOL_BY_ID[id]).filter(Boolean);
const RELATED: Record<Locale, string> = {
  ko: '함께 볼 상징', en: 'Related symbols', ja: '関連する象徴',
  zh: '相关象征', fr: 'Symboles liés', es: 'Símbolos relacionados',
};
---
<Layout title={entry.data.title} description={entry.data.description} locale={locale}>
  <div class="mx-auto max-w-2xl px-4 pt-8">
    <a class="text-sm text-muted-foreground hover:text-primary" href={`/${locale}/dream/`}>&larr; {BACK[locale] ?? BACK.en}</a>
    <p class="mt-4 flex items-center gap-2 text-sm text-muted-foreground">
      <span class="text-2xl" aria-hidden="true">{sym.emoji}</span>
      <span>{DREAM_CATEGORY_LABELS[sym.category][locale] ?? DREAM_CATEGORY_LABELS[sym.category].en}</span>
    </p>
    <ul class="mt-3 flex flex-wrap gap-2">
      {(sym.keywords[locale] ?? sym.keywords.en).map((k) => (
        <li class="rounded-full border border-border bg-surface-subtle px-3 py-1 text-xs text-muted-foreground">{k}</li>
      ))}
    </ul>
  </div>

  <ExplainerArticle entry={entry} locale={locale} testPath="/dream" ctaKind="dream" />

  {related.length > 0 && (
    <nav class="mx-auto max-w-2xl px-4 pb-12">
      <h2 class="text-sm font-bold text-foreground">{RELATED[locale] ?? RELATED.en}</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {related.map((r) => (
          <li>
            <a class="inline-flex items-center gap-1.5 rounded-lg border border-border px-3 py-1.5 text-sm transition-colors hover:border-primary/50 hover:text-primary"
               href={`/${locale}/dream/${r.id}/`}>
              <span aria-hidden="true">{r.emoji}</span>{r.name[locale] ?? r.name.en}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</Layout>
