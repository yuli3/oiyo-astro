---
// 꿈 상징 페이지.
//
// 경로는 **데이터에서** 낸다 — 6로케일 × 전체 상징. 사전은 짧은 항목을 넓게
// 모으는 것이 목적이라, 긴 해설이 있어야만 페이지가 생기는 구조면 색인이
// 없는 페이지를 링크하게 된다.
//
// 긴 해설(explainers)은 있으면 아래에 덧붙는다. 없으면 사전 항목만 보인다.
import Layout from '../../../layouts/Layout.astro';
import { render, getCollection } from 'astro:content';
import { DREAM_SYMBOLS, DREAM_SYMBOL_BY_ID, DREAM_CATEGORY_LABELS } from '../../../data/dream-symbols';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';

export async function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    DREAM_SYMBOLS.map((s) => ({ params: { locale, symbol: s.id } })),
  );
}

const { locale, symbol } = Astro.params as { locale: Locale; symbol: string };
const sym = DREAM_SYMBOL_BY_ID[symbol];
if (!sym) throw new Error(`꿈 상징 없음: ${symbol}`);
const r = sym.l10n[locale] ?? sym.l10n.en;

const articles = await getCollection(
  'explainers',
  (e) => e.data.topic === `dream-${symbol}` && e.data.locale === locale,
);
const article = articles[0];
const Article = article ? (await render(article)).Content : null;

const L: Record<Locale, {
  back: string; trad: string; psych: string; scenes: string; related: string;
  tool: string; note: string; deeper: string;
}> = {
  ko: {
    back: '꿈 상징 사전', trad: '전통 해몽에서는', psych: '꿈 연구의 관점에서는',
    scenes: '장면별로 전해 오는 읽기', related: '함께 볼 상징', tool: '해몽 도구로 읽기',
    note: '해몽은 문화적 상징 해석이며 앞일을 알려 주지 않습니다.', deeper: '더 자세히',
  },
  en: {
    back: 'Dream symbol index', trad: 'In the traditional reading', psych: 'From dream research',
    scenes: 'Scene by scene, as it was handed down', related: 'Related symbols', tool: 'Open the reading tool',
    note: 'Dream reading is cultural symbol interpretation and does not foretell anything.', deeper: 'In depth',
  },
  ja: {
    back: '夢の象徴事典', trad: '伝統的な夢解きでは', psych: '夢研究の観点では',
    scenes: '場面ごとに伝わる読み', related: '関連する象徴', tool: '夢占いツールで読む',
    note: '夢解きは文化的な象徴解釈であり、先のことを告げるものではありません。', deeper: '詳しく',
  },
  zh: {
    back: '梦境象征词典', trad: '传统解梦中', psych: '从梦的研究看',
    scenes: '逐个场景的传统读法', related: '相关象征', tool: '用解梦工具阅读',
    note: '解梦是文化性的象征解释，并不预告将来。', deeper: '详解',
  },
  fr: {
    back: 'Index des symboles oniriques', trad: 'Dans la lecture traditionnelle', psych: 'Du côté de la recherche',
    scenes: 'Scène par scène, telle que transmise', related: 'Symboles liés', tool: "Ouvrir l'outil de lecture",
    note: "L'interprétation des rêves est une lecture culturelle de symboles et ne prédit rien.", deeper: 'En détail',
  },
  es: {
    back: 'Índice de símbolos oníricos', trad: 'En la lectura tradicional', psych: 'Desde la investigación',
    scenes: 'Escena por escena, como se transmitió', related: 'Símbolos relacionados', tool: 'Abrir la herramienta',
    note: 'La interpretación de sueños es lectura cultural de símbolos y no predice nada.', deeper: 'En detalle',
  },
};
const t = L[locale] ?? L.en;
const related = sym.related.map((id) => DREAM_SYMBOL_BY_ID[id]).filter(Boolean);
const title = article?.data.title ?? r.name;
const description = article?.data.description ?? `${r.name} — ${r.traditional}`;
---
<Layout title={title} description={description} locale={locale}>
  <div class="mx-auto max-w-2xl px-4 py-10">
    <a class="text-sm text-muted-foreground hover:text-primary" href={`/${locale}/dream/`}>&larr; {t.back}</a>

    <h1 class="mt-4 flex items-center gap-3 text-3xl font-bold text-foreground" data-route-title>
      <span aria-hidden="true">{sym.emoji}</span>{r.name}
    </h1>
    <p class="mt-2 text-sm text-muted-foreground">
      {DREAM_CATEGORY_LABELS[sym.category][locale] ?? DREAM_CATEGORY_LABELS[sym.category].en}
    </p>
    <ul class="mt-3 flex flex-wrap gap-2">
      {r.keywords.map((k) => (
        <li class="rounded-full border border-border bg-surface-subtle px-3 py-1 text-xs text-muted-foreground">{k}</li>
      ))}
    </ul>

    <section class="mt-8">
      <h2 class="text-sm font-bold text-primary-strong">{t.trad}</h2>
      <p class="mt-2 leading-8 text-foreground">{r.traditional}</p>
    </section>

    <section class="mt-6">
      <h2 class="text-sm font-bold text-primary-strong">{t.psych}</h2>
      <p class="mt-2 leading-8 text-foreground">{r.psych}</p>
    </section>

    <section class="mt-6">
      <h2 class="text-sm font-bold text-primary-strong">{t.scenes}</h2>
      <ul class="mt-2 space-y-2">
        {r.scenes.map((sc) => (
          <li class="leading-7 text-muted-foreground">
            <span class="font-medium text-foreground">{sc.when}</span> — {sc.reads}
          </li>
        ))}
      </ul>
    </section>

    <p class="mt-8">
      <a class="inline-block rounded-lg bg-primary px-4 py-2 font-semibold text-primary-foreground transition-colors hover:bg-primary-strong"
         href={`/${locale}/dream/reading/`}>{t.tool}</a>
    </p>

    {Article && (
      <section class="mt-12 border-t border-border pt-8">
        <h2 class="text-sm font-bold uppercase tracking-widest text-muted-foreground">{t.deeper}</h2>
        <div class="explainer-prose mt-4"><Article /></div>
      </section>
    )}

    {related.length > 0 && (
      <nav class="mt-12">
        <h2 class="text-sm font-bold text-foreground">{t.related}</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {related.map((x) => (
            <li>
              <a class="inline-flex items-center gap-1.5 rounded-lg border border-border px-3 py-1.5 text-sm transition-colors hover:border-primary/50 hover:text-primary"
                 href={`/${locale}/dream/${x.id}/`}>
                <span aria-hidden="true">{x.emoji}</span>{(x.l10n[locale] ?? x.l10n.en).name}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <p class="mt-8 text-sm text-muted-foreground">{t.note}</p>
  </div>
</Layout>
