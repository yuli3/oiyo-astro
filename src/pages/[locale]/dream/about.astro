---
// 해몽 개념 해설. 본문은 explainers 컬렉션(src/content/explainers/<locale>/dream.md).
import Layout from '../../../layouts/Layout.astro';
import ExplainerArticle from '../../../components/shared/ExplainerArticle.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const have = new Set(
    (await getCollection('explainers', (e) => e.data.topic === 'dream')).map((e) => e.data.locale),
  );
  return LOCALES.filter((l) => have.has(l)).map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const entry = await getEntry('explainers', `${locale}/dream`);
if (!entry) throw new Error(`explainers 항목 없음: ${locale}/dream`);
---
<Layout title={entry.data.title} description={entry.data.description} locale={locale}>
  <ExplainerArticle entry={entry} locale={locale} testPath="/dream" ctaKind="dream" />
</Layout>
