const c = C[locale] ?? C.en;
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Layout title={c.title} description={c.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <section class="mx-auto max-w-2xl px-4 py-10">
    <p class="text-xs font-black tracking-widest text-primary">{c.eyebrow}</p>
    <h1 class="mt-3 text-3xl font-black tracking-tight">{c.h1}</h1>
    <p class="mt-3 text-base leading-relaxed text-muted-foreground">{c.lead}</p>

    <div class="mt-8">
      <TarotReading client:load locale={locale} preset="new-year-2027" />
    </div>

    <section class="mt-12 space-y-3">
      <h2 class="text-2xl font-black">{c.howHeading}</h2>
      {c.how.map((p) => <p class="leading-relaxed text-muted-foreground">{p}</p>)}
    </section>

    <nav class="mt-10 grid gap-3 sm:grid-cols-2" aria-label={c.hub}>
      <a href={`/${locale}/new-year-2027/`} class="flex min-h-11 items-center rounded-xl border bg-card p-4 text-sm font-black transition hover:border-primary">🐑 {c.hub}</a>
      <a href={`/${locale}/tarot/reading/`} class="flex min-h-11 items-center rounded-xl border bg-card p-4 text-sm font-black transition hover:border-primary">🃏 {c.more}</a>
    </nav>

    <section class="mt-10">
      <h2 class="text-2xl font-black">{c.faqHeading}</h2>
      <div class="mt-4 divide-y rounded-xl border bg-card">
        {c.faqs.map((f) => (
          <details class="p-4">
            <summary class="cursor-pointer font-semibold">{f.q}</summary>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </section>
</Layout>
