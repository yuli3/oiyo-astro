---
/**
 * 2027 신년 타로 3장 (상반기·하반기·한 해 조언). 2026-11-11 비주얼 브레인스토밍 6-4,
 * 2026-11-14 레퍼런스 정리 뒤 착수. 기존 덱·셔플 테이블을 그대로 쓰고 자리 이름만 새해용.
 * 신년운세 검색 피크(12/20) 전에 연다. 모음 페이지(/new-year-2027/)의 '새해 타로' 칸이 여기로 온다.
 */
import Layout from '../../../layouts/Layout.astro';
import TarotReading from '../../../components/tools/TarotReading';
import { LOCALES, type Locale } from '../../../i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

interface Copy {
  title: string;
  description: string;
  eyebrow: string;
  h1: string;
  lead: string;
  howHeading: string;
  how: string[];
  hub: string;
  more: string;
  faqHeading: string;
  faqs: { q: string; a: string }[];
}

