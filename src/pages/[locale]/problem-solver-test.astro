---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import ProblemSolverTest from '../../components/tests/ProblemSolverTest';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<string, { title: string; description: string }> = {
  ko: { title: "문제 해결사 테스트: 나의 문제 해결 스타일은?", description: "15개의 질문으로 나만의 문제 해결 방식을 발견하세요. 분석형·창의형·실용형·협력형·전략형 중 나의 문제 해결 스타일은 무엇인가요?" },
  en: { title: "Problem Solver Test: What's Your Problem-Solving Style?", description: "Discover your unique problem-solving approach through 15 questions. Analytical, Creative, Practical, Collaborative, or Strategic Solver — which style fits you?" },
  ja: { title: "問題解決者テスト：あなたの問題解決スタイルは？", description: "15の質問で問題解決スタイルを発見しましょう。分析型・創造型・実践型・協力型・戦略型のうち、あなたの問題解決スタイルはどれですか？" },
  fr: { title: "Test Problem Solver : Quel est votre style de résolution de problèmes ?", description: "Découvrez votre approche unique de résolution de problèmes à travers 15 questions. Analytique, Créatif, Pratique, Collaboratif ou Stratégique ?" },
  es: { title: "Test Problem Solver: ¿Cuál es tu estilo de resolución de problemas?", description: "Descubre tu enfoque único de resolución de problemas a través de 15 preguntas. ¿Analítico, Creativo, Práctico, Colaborativo o Estratégico?" },
  zh: { title: "问题解决者测试：你的问题解决风格是什么？", description: "透过15个问题发现你独特的问题解决方式。分析型、创意型、实践型、协作型还是策略型，你的问题解决风格是哪个？" },
};
const m = meta[locale] ?? meta.en ?? Object.values(meta)[0];
---

<Layout title={m.title} description={m.description} locale={locale} heading={m.title} intro={m.description}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <ProblemSolverTest locale={locale as any} client:load />
  </div>
</Layout>
