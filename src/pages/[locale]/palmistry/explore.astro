---
import Layout from '../../../layouts/Layout.astro';
import MysticTrinity from '../../../components/shared/MysticTrinity.astro';
import RelatedTools from '../../../components/shared/RelatedTools.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import PalmistryExplorer from '../../../components/tools/PalmistryExplorer';
import { PALM_LINE_DETAIL } from '../../../lib/engines/interpretation/shards/blood-palm-detail';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: '손금 탐색기 — 생명선·감정선·두뇌선·운명선 인터랙티브',
    description: '손 위의 4대 주요 선을 눌러 의미를 살펴보는 인터랙티브 손금 도구. 생명선·감정선·두뇌선·운명선의 특징과 해석을 한눈에.',
  },
  en: {
    title: 'Palm Explorer — Interactive Life, Heart, Head & Fate Lines',
    description: 'An interactive palmistry tool: tap the four major palm lines to explore their meanings. Heart, Head, Life, and Fate lines at a glance.',
  },
  ja: {
    title: '手相エクスプローラー — 感情線・頭脳線・生命線・運命線インタラクティブ',
    description: '手のひらの四大主要線をタップして意味を見るインタラクティブな手相ツール。感情線・頭脳線・生命線・運命線の特徴と解釈を一目で。',
  },
  zh: {
    title: '手相探索器 — 感情线·智慧线·生命线·命运线互动',
    description: '点按手掌四大主线即可了解含义的互动手相工具。一目了然地查看感情线、智慧线、生命线与命运线的特征与解读。',
  },
  fr: {
    title: 'Explorateur de paume — Lignes de vie, cœur, tête et destin (interactif)',
    description: 'Un outil de chiromancie interactif : touchez les quatre lignes principales de la paume pour explorer leur signification.',
  },
  es: {
    title: 'Explorador de la palma — Líneas de vida, corazón, cabeza y destino (interactivo)',
    description: 'Una herramienta de quiromancia interactiva: toca las cuatro líneas principales de la palma para explorar su significado.',
  },
};

const m = meta[locale] ?? meta.en;

const content: Record<Locale, {
  introTitle: string;
  intro: string;
  conceptTitle: string;
  concepts: { title: string; body: string }[];
  useTitle: string;
  useCases: { title: string; body: string }[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  readingTitle: string;
  reading: { href: string; label: string; desc: string }[];
  disclaimer: string;
}> = {
  "ko": {
    "faqTitle": "자주 묻는 질문",
    "readingTitle": "더 깊게 읽기",
    "introTitle": "손금은 몸의 진단서가 아니라 손바닥 위에 그려진 상징적 이야기입니다",
    "intro": "손금 보기는 생명선, 감정선, 지혜선, 운명선처럼 손바닥의 주요 선을 관찰해 성향, 관심, 삶을 바라보는 방식을 상징적으로 읽는 전통입니다. 손의 선은 건강 상태를 의학적으로 진단하지 않으며, 결과는 자기 이해와 가벼운 대화를 위한 참고로 보아야 합니다.",
    "conceptTitle": "주요 손금 선",
    "concepts": [
      {
        "title": "생명선",
        "body": "엄지 주변을 감싸는 선. 수명 예측이 아니라 활력과 생활 리듬의 상징으로 봅니다."
      },
      {
        "title": "감정선",
        "body": "손가락 아래를 가로지르는 선. 감정 표현과 관계에서의 반응 방식을 읽습니다."
      },
      {
        "title": "지혜선과 운명선",
        "body": "생각의 습관과 일·방향성에 대한 상징을 살피되, 고정된 운명으로 단정하지 않습니다."
      }
    ],
    "useTitle": "이렇게 활용하세요",
    "useCases": [
      {
        "title": "양손 비교하기",
        "body": "손금 전통에서는 주로 쓰는 손과 반대 손을 비교해 현재와 기질의 차이를 봅니다."
      },
      {
        "title": "선보다 맥락 보기",
        "body": "길이 하나로 판단하지 말고 깊이, 흐름, 손 모양을 함께 살핍니다."
