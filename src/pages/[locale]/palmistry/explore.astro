const c = content[locale] ?? content.en;

const webApplicationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: m.title,
  description: m.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Any',
  inLanguage: locale,
  isAccessibleForFree: true,
  publisher: { '@id': 'https://oiyo.net/#organization' },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

// wiki 에서 흡수한 상세 해설. 6로케일 원문이 다 있어 로케일 가드가 필요 없다.
const detailOrder = ['life','head','heart','fate'] as const;
const detailHeading: Record<Locale, string> = {"ko": "주요 손금 선 상세", "en": "The major lines in detail", "ja": "主要な線の詳細", "zh": "主要掌纹详解", "fr": "Les lignes majeures en détail", "es": "Las líneas principales en detalle"};
const details = detailOrder
  .map((key) => ({ key, entry: PALM_LINE_DETAIL[key]?.[locale] ?? PALM_LINE_DETAIL[key]?.en }))
  .filter((d) => Boolean(d.entry));

---

<Layout title={m.title} description={m.description} locale={locale} heading={m.title} intro={m.description}>
  <script type="application/ld+json" set:html={JSON.stringify([webApplicationJsonLd, faqJsonLd])} />
  <div class="mx-auto max-w-3xl px-4 py-10">
    <PalmistryExplorer client:load locale={locale} />
    <RelatedTools locale={locale} tools={['fortunePeriodic', 'natal', 'zodiac', 'saju']} current="palmistry" />

    <section class="mt-10 border-t border-green-100 pt-8">
      <h2 class="text-2xl font-bold text-foreground">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-green-800">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.conceptTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.concepts.map((item) => (
          <article class="rounded-xl border border-green-100 bg-card p-4">
            <h3 class="font-semibold text-foreground">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-green-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.useTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.useCases.map((item) => (
          <article class="rounded-xl bg-surface-subtle p-4">
            <h3 class="font-semibold text-foreground">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-green-800">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-foreground">{detailHeading[locale] ?? detailHeading.en}</h2>
      <div class="mt-4 space-y-4">
        {details.map(({ key, entry }) => (
          <details class="group rounded-xl border border-green-100 bg-card p-4" name={`detail-${key}`}>
            <summary class="cursor-pointer list-none font-semibold text-foreground marker:content-['']">
              <span class="mr-2 text-green-500 transition-transform group-open:rotate-90 inline-block" aria-hidden="true">▸</span>
              {entry.title}
            </summary>
            <div class="mt-3 space-y-3 text-sm leading-7 text-green-800" set:html={entry.leadHtml} />
            {entry.sections.map((sec) => (
              <div class="mt-5">
                <h3 class="font-semibold text-foreground">{sec.heading}</h3>
                <div class="mt-2 space-y-3 text-sm leading-7 text-green-800" set:html={sec.html} />
              </div>
            ))}
          </details>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-green-100 rounded-xl border border-green-100 bg-card">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-foreground">
              {faq.question}
            </summary>
            <p class="mt-3 text-sm leading-6 text-green-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.readingTitle}</h2>
      <div class="mt-4 grid gap-3 md:grid-cols-2">
        {c.reading.map((item) => (
          <a class="rounded-xl border border-green-100 bg-card p-4 transition-colors hover:border-green-300 hover:bg-surface-subtle" href={item.href} rel="noopener noreferrer" target="_blank">
            <span class="font-semibold text-foreground">{item.label}</span>
            <span class="mt-2 block text-sm leading-6 text-green-700">{item.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">
      {c.disclaimer}
    </p>
    <div class="mt-10">
      <MysticTrinity topic="zodiac" locale={locale} />
    </div>
  </div>
</Layout>
