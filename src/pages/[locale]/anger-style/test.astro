---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import AngerStyleTest from '../../../components/tests/AngerStyleTest';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '분노유형 테스트 — 나는 어떻게 화를 내는가?', description: '폭발형·억압형·수동공격형·분산형 등 나의 분노 표현 방식과 건강한 감정 관리법을 알아보세요.' },
  en: { title: 'Anger Style Test — How Do You Express Anger?', description: 'Discover your anger expression style — explosive, suppressive, passive-aggressive, or diffusing — and learn healthy management.' },
  ja: { title: '怒りのタイプテスト — どのように怒りを表現しますか？', description: '爆発型・抑圧型・受動的攻撃型・発散型など、あなたの怒り表現スタイルと健全な感情管理法を学びましょう。' },
  zh: { title: '愤怒风格测试 — 你如何表达愤怒？', description: '了解你的愤怒表达方式——爆发型、压抑型、被动攻击型或发散型——并学习健康的情绪管理。' },
  fr: { title: "Test de Style de Colère — Comment exprimez-vous la colère?", description: "Découvrez votre style d'expression de la colère — explosif, répressif, passif-agressif ou diffus — et apprenez à la gérer sainement." },
  es: { title: 'Test de Estilo de Ira — ¿Cómo expresas la ira?', description: 'Descubre tu estilo de expresión de ira — explosivo, represivo, pasivo-agresivo o difuso — y aprende a gestionarla sanamente.' },
};
const m = meta[locale] ?? meta.en;
---
<Layout title={m.title} description={m.description} locale={locale}>
  <main class="mx-auto max-w-2xl px-4 py-10">
    <AngerStyleTest client:load locale={locale} />
  </main>
</Layout>
