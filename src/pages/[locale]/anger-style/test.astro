---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import AngerStyleTest from '../../../components/tests/AngerStyleTest';
import RelatedTools from '../../../components/shared/RelatedTools.astro';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '분노유형 테스트 — 나는 어떻게 화를 내는가?', description: '폭발형·억압형·수동공격형·분산형 등 나의 분노 표현 방식과 건강한 감정 관리법을 알아보세요.' },
  en: { title: 'Anger Style Test — How Do You Express Anger?', description: 'Discover your anger expression style — explosive, suppressive, passive-aggressive, or diffusing — and learn healthy management.' },
  ja: { title: '怒りのタイプテスト — どのように怒りを表現しますか？', description: '爆発型・抑圧型・受動的攻撃型・発散型など、あなたの怒り表現スタイルと健全な感情管理法を学びましょう。' },
  zh: { title: '愤怒风格测试 — 你如何表达愤怒？', description: '了解你的愤怒表达方式——爆发型、压抑型、被动攻击型或发散型——并学习健康的情绪管理。' },
  fr: { title: "Test de Style de Colère — Comment exprimez-vous la colère?", description: "Découvrez votre style d'expression de la colère — explosif, répressif, passif-agressif ou diffus — et apprenez à la gérer sainement." },
  es: { title: 'Test de Estilo de Ira — ¿Cómo expresas la ira?', description: 'Descubre tu estilo de expresión de ira — explosivo, represivo, pasivo-agresivo o difuso — y aprende a gestionarla sanamente.' },
};
const m = meta[locale] ?? meta.en;

const content: Record<Locale, { introTitle: string; intro: string; conceptTitle: string; concepts: { title: string; body: string }[]; faqTitle: string; faqs: { question: string; answer: string }[]; disclaimer: string; }> = {
  ko: { introTitle: '분노유형은 사람을 단정하는 라벨이 아니라 화가 표현되는 방식을 보는 렌즈입니다', intro: '분노유형 테스트는 분노를 폭발시키는지, 누르는지, 우회적으로 표현하는지, 흩어내는지 살펴봅니다. 결과는 나쁜 사람을 가르는 기준이 아니라 감정 신호를 더 안전하게 다루기 위한 참고입니다.', conceptTitle: '분노유형을 읽는 세 가지 관점', concepts: [{ title: '감정 신호', body: '분노는 공격성만이 아니라 경계, 피로, 부당함을 알리는 신호일 수 있습니다.' }, { title: '표현 경로', body: '같은 화도 말, 침묵, 냉소, 행동으로 다르게 나타납니다.' }, { title: '회복 방식', body: '유형을 알면 화를 없애기보다 안전하게 다루는 방법을 찾기 쉽습니다.' }], faqTitle: '자주 묻는 질문', faqs: [{ question: '분노유형 결과는 얼마나 정확한가요?', answer: '현재 답변에 나타난 표현 경향을 요약한 참고 자료입니다. 상황과 관계에 따라 달라질 수 있으니 절대적 판정으로 보지 마세요.' }, { question: '분노유형은 바뀔 수 있나요?', answer: '네. 스트레스, 안전감, 대화 습관이 달라지면 분노를 표현하는 방식도 달라질 수 있습니다.' }, { question: '결과를 어떻게 활용하면 좋나요?', answer: '화를 참거나 터뜨리는 데서 끝내지 말고, 어떤 경계와 필요가 숨어 있는지 살피는 질문으로 사용하세요.' }], disclaimer: '분노유형 결과는 자기 이해와 대화를 위한 참고입니다. 진단, 채용, 관계의 단정적 판단 근거로 사용하지 마세요.' },
  en: { introTitle: 'Anger style is a lens for how anger is expressed, not a label that defines you', intro: 'The anger style test looks at whether anger is expressed directly, suppressed, displaced, or diffused. The result is not a measure of being good or bad; it is a reference for handling emotional signals more safely.', conceptTitle: 'Three ways to read anger style', concepts: [{ title: 'Emotional signal', body: 'Anger can signal boundaries, fatigue, or unfairness, not only aggression.' }, { title: 'Expression channel', body: 'The same anger may appear as words, silence, sarcasm, or action.' }, { title: 'Recovery style', body: 'Knowing the pattern helps you handle anger safely instead of trying to erase it.' }], faqTitle: 'Frequently asked questions', faqs: [{ question: 'How accurate is the anger style result?', answer: 'It summarizes expression patterns shown in your current answers. Context and relationships can shift it, so avoid treating it as an absolute verdict.' }, { question: 'Can anger style change?', answer: 'Yes. Stress, safety, and communication habits can change how anger is expressed.' }, { question: 'How should I use the result?', answer: 'Use it to ask what boundary or need may sit under the anger, rather than only trying to suppress or release it.' }], disclaimer: 'Anger style results are for self-understanding and conversation. Do not use them as a basis for diagnosis, hiring, or definitive relationship judgments.' },
  ja: { introTitle: '怒りのタイプは人を決めつけるラベルではなく、怒りの表れ方を見るレンズです', intro: '怒りのタイプテストは怒りを爆発させるか、抑えるか、遠回しに出すか、散らすかを見ます。結果は良し悪しを決める基準ではなく、感情のサインを安全に扱う参考です。', conceptTitle: '怒りのタイプを読む三つの視点', concepts: [{ title: '感情のサイン', body: '怒りは攻撃性だけでなく、境界、疲れ、不公平感のサインでもあります。' }, { title: '表現の経路', body: '同じ怒りでも言葉、沈黙、皮肉、行動として表れます。' }, { title: '回復のしかた', body: '型を知ると、怒りを消すより安全に扱う方法を探しやすくなります。' }], faqTitle: 'よくある質問', faqs: [{ question: '怒りのタイプの結果はどれくらい正確ですか？', answer: '現在の回答に表れた表現傾向の要約です。状況や関係で変わるため、絶対的な判定として扱わないでください。' }, { question: '怒りのタイプは変わりますか？', answer: '変わります。ストレス、安全感、対話の習慣が変わると表現のしかたも変化します。' }, { question: '結果はどう使えばよいですか？', answer: '怒りを抑えるか出すかだけでなく、その下にある境界や必要を探す質問として使ってください。' }], disclaimer: '怒りのタイプの結果は自己理解と対話のための参考です。診断、採用、人間関係の断定的な判断材料には使わないでください。' },
  zh: { introTitle: '愤怒风格是观察愤怒表达方式的镜片，不是定义人的标签', intro: '愤怒风格测试观察愤怒是直接爆发、压抑、间接表达还是分散释放。结果不是判断好坏的标准，而是帮助你更安全地处理情绪信号。', conceptTitle: '理解愤怒风格的三个角度', concepts: [{ title: '情绪信号', body: '愤怒不只是攻击性，也可能提示边界、疲惫或不公平感。' }, { title: '表达路径', body: '同一种愤怒可能表现为语言、沉默、讽刺或行动。' }, { title: '恢复方式', body: '了解模式后，更容易安全处理愤怒，而不是试图消灭它。' }], faqTitle: '常见问题', faqs: [{ question: '愤怒风格结果有多准确？', answer: '它概括的是当前回答中的表达倾向。情境和关系会影响结果，因此不要把它当作绝对结论。' }, { question: '愤怒风格会改变吗？', answer: '会。压力、安全感和沟通习惯变化时，表达愤怒的方式也会改变。' }, { question: '应该如何使用结果？', answer: '不要只想着压抑或释放愤怒，也可以用它来寻找愤怒背后的边界和需求。' }], disclaimer: '愤怒风格结果仅用于自我理解与对话，请勿作为诊断、招聘或关系定论的依据。' },
  fr: { introTitle: 'Le style de colère est une lentille pour la façon dont la colère s’exprime, pas une étiquette qui vous définit', intro: 'Le test de style de colère observe si la colère est exprimée, retenue, déplacée ou diffusée. Le résultat ne juge pas la personne; il aide à comprendre les signaux émotionnels avec plus de sécurité.', conceptTitle: 'Trois façons de lire le style de colère', concepts: [{ title: 'Signal émotionnel', body: 'La colère peut signaler limites, fatigue ou injustice, pas seulement agressivité.' }, { title: 'Canal d’expression', body: 'La même colère peut devenir mots, silence, sarcasme ou action.' }, { title: 'Mode de récupération', body: 'Connaître le motif aide à gérer la colère en sécurité plutôt qu’à l’effacer.' }], faqTitle: 'Questions fréquentes', faqs: [{ question: 'Le résultat est-il fiable ?', answer: 'Il résume les tendances d’expression visibles dans vos réponses du moment. Le contexte et les relations peuvent le modifier; ne le prenez pas comme verdict absolu.' }, { question: 'Le style de colère peut-il changer ?', answer: 'Oui. Stress, sécurité et habitudes de communication peuvent changer l’expression de la colère.' }, { question: 'Comment utiliser le résultat ?', answer: 'Servez-vous-en pour chercher quelle limite ou quel besoin se cache sous la colère, pas seulement pour la retenir ou la relâcher.' }], disclaimer: 'Les résultats du style de colère servent à la compréhension de soi et au dialogue. Ne les utilisez pas comme base de diagnostic, de recrutement ou de verdict relationnel.' },
  es: { introTitle: 'El estilo de ira es una lente para cómo se expresa la ira, no una etiqueta que te define', intro: 'El test de estilo de ira observa si la ira se expresa, se reprime, se desplaza o se disipa. El resultado no mide si alguien es bueno o malo; ayuda a manejar señales emocionales con más seguridad.', conceptTitle: 'Tres formas de leer el estilo de ira', concepts: [{ title: 'Señal emocional', body: 'La ira puede señalar límites, cansancio o injusticia, no solo agresividad.' }, { title: 'Canal de expresión', body: 'La misma ira puede aparecer como palabras, silencio, sarcasmo o acción.' }, { title: 'Forma de recuperación', body: 'Conocer el patrón ayuda a manejar la ira con seguridad en lugar de borrarla.' }], faqTitle: 'Preguntas frecuentes', faqs: [{ question: '¿Qué tan preciso es el resultado?', answer: 'Resume tendencias de expresión que aparecen en tus respuestas actuales. Contexto y relaciones pueden cambiarlo; no lo trates como veredicto absoluto.' }, { question: '¿Puede cambiar el estilo de ira?', answer: 'Sí. Estrés, seguridad y hábitos de comunicación pueden cambiar cómo se expresa la ira.' }, { question: '¿Cómo usar el resultado?', answer: 'Úsalo para preguntar qué límite o necesidad hay debajo de la ira, no solo para reprimirla o soltarla.' }], disclaimer: 'Los resultados del estilo de ira son para autoconocimiento y conversación. No los uses como base para diagnóstico, contratación o juicios definitivos sobre relaciones.' },
};

const c = content[locale] ?? content.en;
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
---
<Layout title={m.title} description={m.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <main class="mx-auto max-w-2xl px-4 py-10">
    <AngerStyleTest client:load locale={locale} />
    <section class="mt-10 border-t border-violet-100 pt-8"><h2 class="text-2xl font-bold text-violet-950">{c.introTitle}</h2><p class="mt-4 leading-8 text-violet-800">{c.intro}</p></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.conceptTitle}</h2><div class="mt-4 grid gap-4 md:grid-cols-3">{c.concepts.map((item) => (<article class="rounded-xl border border-violet-100 bg-white p-4"><h3 class="font-semibold text-violet-950">{item.title}</h3><p class="mt-2 text-sm leading-6 text-violet-700">{item.body}</p></article>))}</div></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.faqTitle}</h2><div class="mt-4 divide-y divide-violet-100 rounded-xl border border-violet-100 bg-white">{c.faqs.map((faq) => (<details class="group p-4"><summary class="cursor-pointer list-none font-semibold text-violet-950">{faq.question}</summary><p class="mt-3 text-sm leading-6 text-violet-700">{faq.answer}</p></details>))}</div></section>
    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>
    <RelatedTools locale={locale} tools={['eq','empathy','innerStrength','perfectionism']} current="angerStyle" />
  </main>
</Layout>
