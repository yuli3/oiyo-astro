---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import ColorPersonalityTest from '../../components/tests/ColorPersonalityTest';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<string, { title: string; description: string }> = {
  ko: {
    title: "컬러 성격 테스트 — 나를 대표하는 색깔은?",
    description: "색채 심리학 기반 15가지 질문 컬러 성격 테스트. 레드(열정·행동)·블루(신중·논리)·옐로우(창의·소통)·그린(평화·배려)·퍼플(직관·통찰) 5대 상징 색상으로 나의 강점, 보완점, 잘 맞는 궁합 컬러를 무료로 분석해 보세요.",
  },
  en: {
    title: "Color Personality Test — What Color Are You?",
    description: "Discover your color personality through 15 questions. Unpack Red, Blue, Yellow, Green, or Purple traits to reveal your strengths, blind spots, and ideal matches.",
  },
  ja: {
    title: "カラー性格テスト — 私を表す色は何？",
    description: "色彩心理学に基づく15問のカラー性格テスト。レッド（情熱）・ブルー（論理）・イエロー（創造）・グリーン（調和）・パープル（直感）の5大カラーから、あなたの強み、成長課題、相性の良い相手タイプを無料で分析しましょう。",
  },
  fr: {
    title: "Test de Personnalité par Couleur — Quelle est votre couleur?",
    description: "Test des couleurs en 15 questions. Révélez vos traits parmi Rouge, Bleu, Jaune, Vert ou Violet pour découvrir vos forces et compatibilités relationnelles.",
  },
  es: {
    title: "Test de Personalidad por Color — ¿Qué Color Eres?",
    description: "Test de personalidad por color en 15 preguntas. Descubre si eres Rojo, Azul, Amarillo, Verde o Morado para conocer tus mayores fortalezas y compatibilidades.",
  },
  zh: {
    title: "颜色性格测试 — 哪种颜色代表您？",
    description: "基于色彩心理学的15题颜色性格测试。深度解析红（热情行动）、蓝（审慎逻辑）、黄（创意沟通）、绿（温和包容）、紫（直觉敏锐）5大特质，即刻测出您的专属代表色、核心优势与最佳人际相合颜色。",
  },
};
const m = meta[locale] ?? meta.en ?? Object.values(meta)[0];
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <ColorPersonalityTest locale={locale as any} client:load />
  </div>
</Layout>
