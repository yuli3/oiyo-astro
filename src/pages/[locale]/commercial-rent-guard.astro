---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import CommercialRentGuardComponent from '../../components/tools/CommercialRentGuard';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "상가건물 임대료 5% 증액 상한선 & 권리금 보호 계산기 — 10년 갱신권 진단",
    description: "상가건물 임대차보호법 제10조(10년 계약갱신요구권), 제10조의4(권리금 회수기회 보호), 제11조(임대료 5% 증액 상한선) 및 지역별 환산보증금(서울 9억원) 기준 위반 여부를 실시간 진단합니다.",
  },
  en: {
    title: "Korea Commercial Rent 5% Cap & Goodwill Protection Calculator — 10-Year Lease Rights",
    description: "Audit statutory 5% commercial rent ceiling by regional conversion deposit limits (Seoul 900M KRW), 10-year contract renewal rights, and commercial lease goodwill recovery protection in Korea.",
  },
  ja: {
    title: "韓国 商業ビル賃貸料5%増額上限＆権利金保護計算機 — 10年契約更新権診断",
    description: "韓国商街建物賃貸借保護法に基づく10年更新権、ソウル9億ウォン換算保証金基準の5%賃料引き上げ上限、および終了6ヶ月前の権利金回収保護を即時診断します。",
  },
  zh: {
    title: "韩国商铺租金5%涨幅法定上限与商誉金保护计算器 — 10年续约权判定",
    description: "根据韩国商街建筑租赁保护法核查首尔9亿韩元折算保证金标准、5%租金法定涨幅限制、10年续租强制请求权及停业前6个月权利金返还保护资格。",
  },
  fr: {
    title: "Plafond des Loyers Commerciaux (5%) et Protection du Droit au Bail en Corée",
    description: "Évaluez le plafond d'augmentation légal de 5% selon le dépôt de conversion régional, le droit de renouvellement de bail sur 10 ans et la protection du pas-de-porte commercial en Corée.",
  },
  es: {
    title: "Calculadora de Límite de Alquiler Comercial (5%) y Protección de Traspaso en Corea",
    description: "Comprueba el límite legal de incremento de renta del 5%, el derecho de renovación de contrato por 10 años y la protección legal de traspaso de local comercial en Corea.",
  },
};

const currentMeta = meta[locale] ?? meta.ko;
---

<Layout
  title={currentMeta.title}
  description={currentMeta.description}
  locale={locale}
>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto mb-8 text-center">
      <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary mb-3">
        <span>{locale === 'ko' ? '상가건물 임대차보호법 2026' : 'Commercial Lease Protection 2026'}</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl text-foreground">
        {currentMeta.title.split('—')[0]}
      </h1>
      <p class="mt-3 text-base text-muted-foreground sm:text-lg">
        {currentMeta.description}
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <CommercialRentGuardComponent client:load locale={locale} />
    </div>

    {/* Hub-and-Spoke Context / FAQ */}
    <section class="max-w-4xl mx-auto mt-8 rounded-xl border border-border bg-card p-6 space-y-4 text-sm text-muted-foreground">
      <h2 class="text-lg font-bold text-foreground">
        {locale === 'ko' ? '자주 묻는 상가 임대차 법률 Q&A' : 'Frequently Asked Questions'}
      </h2>

      <div class="space-y-3">
        <div>
          <h3 class="font-semibold text-foreground">
            {locale === 'ko' ? 'Q1. 환산보증금을 초과하면 10년 계약갱신요구권을 행사할 수 없나요?' : 'Q1. Does exceeding conversion deposit limits forfeit the 10-year renewal right?'}
          </h3>
          <p class="mt-1">
            {locale === 'ko'
              ? '아닙니다. 2018년 개정 상가건물 임대차보호법 제10조에 따라, 환산보증금(서울 9억원, 부산 6.9억원 등)을 초과하는 고액 상가라 하더라도 10년 계약갱신요구권과 권리금 회수 보호(종료 6개월 전)는 100% 동일하게 법적으로 보장됩니다. 단, 5% 인상 상한선 대신 주변 시세와 물가를 반영한 협의 인상이 적용됩니다.'
              : 'No. Under the amended Korean Commercial Building Lease Protection Act, even leases exceeding regional conversion deposit thresholds are legally guaranteed the 10-year renewal right and goodwill recovery rights.'}
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-foreground">
            {locale === 'ko' ? 'Q2. 임대인이 보증금은 그대로 두고 월세만 5% 넘게 올리겠다고 합니다. 합법인가요?' : 'Q2. Can the landlord raise rent by more than 5% if the deposit is kept frozen?'}
          </h3>
          <p class="mt-1">
            {locale === 'ko'
              ? '위법입니다. 5% 증액 상한선은 월세 단독이 아니라 "환산보증금(보증금 + 월세 × 100)"의 총액을 기준으로 5% 이내여야 합니다. 보증금을 동결하더라도 월세 인상액이 총 환산보증금의 5%를 초과하면 초과 부분은 효력이 없으며, 임차인은 법정 상한을 초과한 금액을 지급할 의무가 없습니다.'
              : 'It is unlawful. The 5% statutory ceiling applies to the aggregate conversion deposit (Deposit + Monthly Rent x 100). Any increase exceeding 5% of the total conversion base is void.'}
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-foreground">
            {locale === 'ko' ? 'Q3. 임대인이 자신이 직접 장사하겠다며 권리금 회수를 방해합니다. 어떻게 대처하나요?' : 'Q3. What if the landlord refuses a new tenant claiming they will take over the store?'}
          </h3>
          <p class="mt-1">
            {locale === 'ko'
              ? '임대인이 정당한 사유 없이 신규 임차인과의 계약을 거절하거나 직접 사용할 목적으로 계약을 방해하면, 법 제10조의4에 따라 임차인이 신규 임차인으로부터 받기로 한 권리금 상당액에 대해 임대인을 상대로 손해배상청구 소송을 제기할 수 있습니다.'
              : 'If a landlord unreasonably refuses a replacement tenant to occupy the space personally, the tenant is legally entitled to sue the landlord for damages equivalent to the lost goodwill.'}
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
