---
import Layout from "../../layouts/Layout.astro";
import { LOCALES } from "../../i18n";
import type { Locale } from "../../i18n";
import { RentalDepositInterestTaxCalculator } from "../../components/tools/RentalDepositInterestTaxCalculator";

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "간주임대료 3주택 보증금 3억 초과 소득세 계산기 | OIYO Tools",
    description: "대한민국 소득세법 제25조에 따라 부부 합산 3주택 이상 보유자의 전세보증금 합계 3억원 초과분에 대한 간주임대료(연 3.5%)와 14% 분리과세액을 실시간 계산합니다.",
  },
  en: {
    title: "3-House Rental Deposit Deemed Interest Tax Calculator | OIYO Tools",
    description: "Calculate deemed rental income tax on residential lease deposits exceeding 300M KRW for owners of 3 or more homes under Korean income tax law.",
  },
  ja: {
    title: "みなし賃貸料 3住宅保証金3億ウォン超過 所得税計算機 | OIYO Tools",
    description: "韓国所得税法第25条に基づき、夫婦合算3住宅以上の伝貰保証金3億ウォン超過分に対するみなし賃貸料（年3.5%）と分離課税額を算出。",
  },
  zh: {
    title: "视同租金收入 3套房押金超3亿韩元 所得税计算器 | OIYO Tools",
    description: "依据韩国所得税法第25条，测算夫妻名下3套房以上全租押金超过3亿韩元部分的视同租金（年化3.5%）与14%单独课税税额。",
  },
  fr: {
    title: "Calculateur d'impôt sur revenus locatifs présumés (3 logements) | OIYO Tools",
    description: "Calculez l'impôt sur les revenus locatifs présumés pour les propriétaires de 3 logements ou plus ayant des dépôts de garantie supérieurs à 300M KRW.",
  },
  es: {
    title: "Calculadora de impuesto sobre ingresos ficticios de alquiler (3 viviendas) | OIYO Tools",
    description: "Calcule el impuesto sobre depósitos de arrendamiento superiores a 300 millones de KRW para propietarios de 3 o más viviendas.",
  },
};

const currentMeta = meta[locale] ?? meta.ko;
---

<Layout title={currentMeta.title} description={currentMeta.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 space-y-8">
    <div class="text-center space-y-2 max-w-2xl mx-auto">
      <h1 class="text-3xl font-extrabold tracking-tight">3주택 간주임대료 소득세 계산기</h1>
      <p class="text-muted-foreground text-sm">
        부부 합산 3주택 이상 + 보증금 3억원 초과 시 정기예금이자율(연 3.5%) 기반 간주임대료 및 분리과세액 산출
      </p>
    </div>

    <RentalDepositInterestTaxCalculator client:load locale={locale} />

    <div class="max-w-4xl mx-auto border rounded-xl p-6 bg-card border-border space-y-4">
      <h2 class="text-lg font-bold">간주임대료 과세 3대 핵심 판정 기준</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-muted-foreground leading-relaxed">
        <div class="space-y-1">
          <h3 class="font-semibold text-foreground">💡 2주택 이하 전세는 무조건 비과세</h3>
          <p>
            월세를 전혀 받지 않고 순수 전세 보증금만 받는 경우, 부부 합산 <strong>2주택자까지는 보증금이 수십억 원이어도 세금이 전액 면제</strong>됩니다. 간주임대료는 오직 3주택 이상 보유자에게만 발생합니다.
          </p>
        </div>
        <div class="space-y-1">
          <h3 class="font-semibold text-foreground">💡 소형주택은 주택 수 제외 특례</h3>
          <p>
            주거전용면적이 <strong>40㎡ 이하이면서 기준시가가 2억원 이하</strong>인 소형주택은 3주택 여부를 판정할 때 주택 수에서 제외됩니다. 원룸 오피스텔이나 소형 빌라를 임대 중이라면 이 특례를 확인하세요.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
