---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import ColorMemoryTest from '../../components/tests/ColorMemoryTest';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '색깔 기억력 테스트', description: '잠깐 보여주는 색상을 기억하고 맞혀보세요.' },
  en: { title: 'Color Memory Test', description: 'Remember the briefly shown colors and pick them.' },
  ja: { title: 'カラーメモリーテスト', description: '一瞬見せた色を記憶して答えてください。' },
  zh: { title: '颜色记忆测试', description: '记住短暂显示的颜色并选出正确答案。' },
  fr: { title: 'Test de Mémoire des Couleurs', description: 'Mémorisez les couleurs affichées brièvement.' },
  es: { title: 'Prueba de Memoria de Colores', description: 'Recuerda los colores mostrados brevemente y selecciónalos.' },
};
const m = meta[locale] ?? meta.en;
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <ColorMemoryTest locale={locale as any} client:load />
  </div>
</Layout>
