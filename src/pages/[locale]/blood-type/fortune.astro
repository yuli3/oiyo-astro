const c = content[locale] ?? content.en;

const webApplicationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: m.title,
  description: m.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Any',
  inLanguage: locale,
  isAccessibleForFree: true,
  publisher: { '@id': 'https://oiyo.net/#organization' },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Layout title={m.title} description={m.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify([webApplicationJsonLd, faqJsonLd])} />
  <div class="mx-auto max-w-2xl px-4 py-10">
    <BloodTypeFortune client:load locale={locale} />

    <section class="mt-10 border-t border-green-100 pt-8">
      <h2 class="text-2xl font-bold text-green-950">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-green-800">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-green-950">{c.conceptTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.concepts.map((item) => (
          <article class="rounded-xl border border-green-100 bg-white p-4">
            <h3 class="font-semibold text-green-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-green-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-green-950">{c.useTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.useCases.map((item) => (
          <article class="rounded-xl bg-green-50 p-4">
            <h3 class="font-semibold text-green-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-green-800">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-green-950">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-green-100 rounded-xl border border-green-100 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-green-950">
              {faq.question}
            </summary>
            <p class="mt-3 text-sm leading-6 text-green-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    {c.reading.length > 0 && (
    <section class="mt-10">
      <h2 class="text-xl font-bold text-green-950">{c.readingTitle}</h2>
      <div class="mt-4 grid gap-3 md:grid-cols-2">
        {c.reading.map((item) => (
          <a class="rounded-xl border border-green-100 bg-white p-4 transition-colors hover:border-green-300 hover:bg-green-50" href={item.href} rel="noopener noreferrer" target="_blank">
            <span class="font-semibold text-green-950">{item.label}</span>
            <span class="mt-2 block text-sm leading-6 text-green-700">{item.desc}</span>
          </a>
        ))}
