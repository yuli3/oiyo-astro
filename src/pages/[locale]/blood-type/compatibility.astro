---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import BloodTypeCompatibility from '../../../components/tools/BloodTypeCompatibility';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: '혈액형 궁합 계산기 — A·B·O·AB 혈액형 궁합',
    description: '두 사람의 혈액형을 입력하면 연애·우정·직장 궁합 점수와 상세 분석을 알려드립니다.',
  },
  en: {
    title: 'Blood Type Compatibility — A, B, O, AB Match',
    description: 'Enter two blood types to get love, friendship, and work compatibility scores with detailed analysis.',
  },
  ja: {
    title: '血液型相性計算機 — A・B・O・AB型の相性',
    description: '二人の血液型を入力すると、恋愛・友情・職場の相性スコアと詳細分析を表示します。',
  },
  zh: {
    title: '血型配对计算器 — A·B·O·AB血型配对',
    description: '输入两人的血型，获取恋爱、友情和工作配对分数及详细分析。',
  },
  fr: {
    title: 'Compatibilité Groupe Sanguin — A, B, O, AB',
    description: 'Entrez deux groupes sanguins pour obtenir des scores de compatibilité amoureuse, amicale et professionnelle.',
  },
  es: {
    title: 'Compatibilidad Tipo de Sangre — A, B, O, AB',
    description: 'Ingresa dos tipos de sangre para obtener puntuaciones de compatibilidad amorosa, amistosa y laboral.',
  },
};

const m = meta[locale] ?? meta.en;
---

<Layout title={m.title} description={m.description} locale={locale}>
  <main class="mx-auto max-w-2xl px-4 py-10">
    <BloodTypeCompatibility client:load locale={locale} />
  </main>
</Layout>
