  en: {
    title: "Today's Universe — Daily Saju, Stars & Tarot at a Glance",
    description:
      "Today's Saju day pillar (sexagenary cycle), the Sun's current zodiac sign, and your tarot card of the day — all on one screen. Start each day with the universe's changing energy.",
