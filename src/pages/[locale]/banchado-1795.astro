---
import Layout from "../../layouts/Layout.astro";
import { LOCALES, localePath } from "../../i18n";
import type { Locale } from "../../i18n";
import Banchado1795 from "../../components/tools/past-life/Banchado1795";
import RelatedTools from "../../components/shared/RelatedTools.astro";

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
type Copy = { title: string; description: string; heading: string; sub: string; intro: string; howTitle: string; how: string[]; faqTitle: string; faq: { q: string; a: string }[] };
const copy: Record<Locale, Copy> = {
  ko: {
    title: "1795 화성 행차 반차도 속 나 — 정조 행렬 1,779명 중 내 역할",
    description: "정조가 어머니 혜경궁과 화성에 다녀온 1795년 7박 8일 행차. 『원행을묘정리의궤』 반차도에 그려진 1,779명과 말 779필 가운데 내 자리를 뽑아요.",
    heading: "1795 화성 행차 반차도 속 나",
    sub: "정조의 8일 행렬, 1,779명 중 한 사람",
    intro: "1795년 윤2월 9일, 정조는 어머니 혜경궁 홍씨의 회갑을 맞아 아버지 사도세자의 묘가 있는 화성으로 떠났어요. 이 행렬을 그린 반차도에는 1,779명과 말 779필이 나와요. 그 가운데 나는 누구일까요?",
    howTitle: "어떻게 뽑나요",
    how: [
      "반차도에 그려진 1,779명을 역할별로 나눠, 인원 비율대로 뽑아요. 깃발 든 군사 238명, 말 탄 악대 115명, 말 탄 나인 28명, 가마 네 대의 수행원 44명(대마다 11명), 나머지 관원·호위 군사 1,354명이에요.",
      "정조 임금은 반차도에 그려지지 않고 주인 없는 말(좌마)로만 자리가 표시돼요. 그래서 '임금' 칸은 그림 밖 1명으로 따로 두었어요(1,780분의 1).",
      "생일로 뽑으면 같은 생일은 언제나 같은 자리가 나와요.",
      "행렬에 딸린 사람은 명단 기준으로 약 6,000명이었고, 그림에는 그 일부만 그렸어요. 한강은 배 36척을 이은 340m 배다리로 건넜어요.",
    ],
    faqTitle: "자주 묻는 질문",
    faq: [
      { q: "반차도란 무엇인가요?", a: "왕실 행사의 행렬을 순서대로 그린 그림이에요. 『원행을묘정리의궤』의 반차도는 1795년 정조의 화성 행차를 길이 15m가 넘는 그림으로 남겼어요." },
      { q: "정조는 왜 화성에 갔나요?", a: "어머니 혜경궁 홍씨의 회갑을 맞아 아버지 사도세자의 묘(현륭원)에 참배하고, 화성행궁 봉수당에서 회갑 잔치를 열기 위해서였어요." },
      { q: "여성도 행렬에 있었나요?", a: "있었어요. 가마를 탄 혜경궁과 두 군주 말고도, 얼굴을 가리고 말을 탄 나인 28명이 그려져 있어요." },
    ],
  },
  en: {
    title: "You in King Jeongjo's 1795 procession to Hwaseong",
    description: "Find your role among the 1,779 people and 779 horses painted in the 1795 royal procession scroll of Joseon Korea, with the eight-day journey day by day.",
    heading: "You in the 1795 royal procession",
    sub: "One of 1,779 in King Jeongjo's eight-day parade",
    intro: "In spring 1795 King Jeongjo took his mother, Lady Hyegyeong, to Hwaseong for her sixtieth birthday and to visit his father's tomb. The procession painting shows 1,779 people and 779 horses. Which one are you?",
    howTitle: "How it works",
    how: [
      "Roles are drawn in proportion to the painting: 238 flag bearers, 115 mounted musicians, 28 court ladies on horseback, 44 palanquin attendants and 1,354 officials and guards.",
      "The king himself is never drawn, only his saddled horse, so the king slot sits outside the picture at 1 in 1,780.",
      "Birthday mode always gives the same birthday the same place.",
    ],
    faqTitle: "FAQ",
    faq: [
      { q: "Were women in the procession?", a: "Yes: Lady Hyegyeong and two princesses in palanquins, and 28 veiled court ladies on horseback." },
    ],
  },
  ja: {
    title: "1795年 華城行幸の班次図の中の私 — 正祖の行列1,779人",
    description: "正祖が母・恵慶宮と華城を訪れた1795年の7泊8日の行幸。班次図に描かれた1,779人・馬779頭の中から、あなたの役割を引きます。",
    heading: "1795年 華城行幸の中の私",
    sub: "正祖の8日間の行列、1,779人のひとり",
    intro: "1795年閏2月9日、正祖は母・恵慶宮洪氏の還暦を迎え、父・思悼世子の墓がある華城へ出発しました。班次図には1,779人と馬779頭が描かれています。",
    howTitle: "仕組み",
    how: ["旗持ち238人、騎馬楽隊115人、騎馬の内人28人、輿の随行44人、官員・護衛1,354人の割合で引きます。", "正祖は絵に描かれず座馬だけ。王の枠は絵の外の1人（1,780分の1）です。"],
    faqTitle: "よくある質問",
    faq: [{ q: "女性も行列にいた？", a: "はい。輿の恵慶宮と二人の郡主のほか、顔を覆って馬に乗る内人28人が描かれています。" }],
  },
  zh: {
    title: "1795华城行幸班次图中的我 — 正祖队列1,779人",
    description: "正祖与母亲惠庆宫1795年七夜八天的华城之行。在班次图所画1,779人、779匹马中抽出你的角色。",
    heading: "1795华城行幸中的我",
    sub: "正祖八天队列中的1,779人之一",
    intro: "1795年闰二月初九，正祖为母亲惠庆宫洪氏六十大寿，前往父亲思悼世子陵墓所在的华城。班次图画有1,779人与779匹马。",
    howTitle: "玩法说明",
    how: ["按擎旗兵238、骑马乐手115、骑马宫女28、轿旁随从44、官员护卫1,354的比例抽取。", "正祖本人不入画，只画座马，王的位置在画外（1/1,780）。"],
    faqTitle: "常见问题",
    faq: [{ q: "队列中有女性吗？", a: "有。除坐轿的惠庆宫与两位郡主外，还有遮面骑马的宫女28人。" }],
  },
  fr: {
    title: "Vous dans le cortège royal coréen de 1795 (Hwaseong)",
    description: "Votre rôle parmi les 1 779 personnages et 779 chevaux du cortège peint du roi Jeongjo en 1795, et le voyage de huit jours.",
    heading: "Vous dans le cortège de 1795",
    sub: "Un des 1 779 du cortège du roi Jeongjo",
    intro: "Au printemps 1795, le roi Jeongjo emmena sa mère à Hwaseong pour ses soixante ans. Le rouleau peint montre 1 779 personnes et 779 chevaux.",
    howTitle: "Méthode",
    how: ["Tirage proportionnel : 238 porte-étendards, 115 musiciens à cheval, 28 dames de cour, 44 porteurs, 1 354 officiers et gardes.", "Le roi n'est jamais dessiné : sa case est hors du tableau (1 sur 1 780)."],
    faqTitle: "Questions fréquentes",
    faq: [{ q: "Y avait-il des femmes ?", a: "Oui : Dame Hyegyeong et deux princesses en palanquin, et 28 dames de cour voilées à cheval." }],
  },
  es: {
    title: "Tú en el cortejo real coreano de 1795 (Hwaseong)",
    description: "Tu papel entre las 1.779 personas y 779 caballos del cortejo pintado del rey Jeongjo en 1795, y el viaje de ocho días.",
    heading: "Tú en el cortejo de 1795",
    sub: "Uno de los 1.779 del cortejo del rey Jeongjo",
    intro: "En la primavera de 1795 el rey Jeongjo llevó a su madre a Hwaseong por sus sesenta años. El rollo pintado muestra 1.779 personas y 779 caballos.",
    howTitle: "Método",
    how: ["Sorteo proporcional: 238 abanderados, 115 músicos a caballo, 28 damas de la corte, 44 porteadores, 1.354 oficiales y guardias.", "El rey nunca se dibuja: su casilla está fuera del cuadro (1 de 1.780)."],
    faqTitle: "Preguntas frecuentes",
    faq: [{ q: "¿Había mujeres?", a: "Sí: la dama Hyegyeong y dos princesas en palanquín, y 28 damas veladas a caballo." }],
  },
};
const c = copy[locale] ?? copy.en;
const faqJsonLd = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: c.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };
---
<Layout title={c.title} description={c.description} locale={locale} canonicalPath={localePath(locale, "/banchado-1795/")} ogImage="/images/past-life-1426/og/banchado-1795.webp">
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="container mx-auto max-w-3xl px-4 py-8">
    <p class="text-sm font-bold text-muted-foreground"><a class="hover:underline" href={localePath(locale, "/past-life-1426/")}>← {({ ko: "타임슬립 시리즈", en: "Time-slip series", ja: "タイムスリップ・シリーズ", zh: "时空穿越系列", fr: "Série voyage dans le temps", es: "Serie viaje en el tiempo" } as Record<string, string>)[locale] ?? "Time-slip"}</a></p>
    <h1 class="mt-2 text-4xl font-black tracking-tight text-foreground">
      {c.heading}
      <span class="mt-1 block text-xl font-bold text-muted-foreground">{c.sub}</span>
    </h1>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted-foreground">{c.intro}</p>
    <div class="mt-6"><Banchado1795 locale={locale} client:load /></div>
    <RelatedTools locale={locale} tools={["joseon1789", "gwageo1426", "sillok1426"]} current="banchado1795" />
    <section class="mt-10 text-sm leading-relaxed text-muted-foreground">
      <h2 class="text-lg font-bold text-foreground">{c.howTitle}</h2>
      {c.how.map((p) => <p class="mt-2">{p}</p>)}
    </section>
    <section class="mt-10 text-sm leading-relaxed text-muted-foreground">
      <h2 class="text-lg font-bold text-foreground">{c.faqTitle}</h2>
      {c.faq.map((f) => (<div class="mt-4"><h3 class="font-bold text-foreground">{f.q}</h3><p class="mt-1">{f.a}</p></div>))}
    </section>
  </div>
</Layout>
