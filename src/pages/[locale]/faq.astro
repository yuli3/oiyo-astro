---
import Layout from '../../layouts/Layout.astro';
import { LOCALES, getTranslations, localePath } from '../../i18n';
import type { Locale } from '../../i18n';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = await getTranslations(locale);

// Use the numbered questions (1–5) which are general, not payment-specific
const faqs = ['1', '2', '3', '4', '5'].map((n) => ({
  q: t(`faq.questions.${n}.q`),
  a: t(`faq.questions.${n}.a`),
})).filter((f) => !f.q.startsWith('faq.'));
---

<Layout
  title="FAQ"
  description={t('faq.subtitle') || 'Frequently asked questions'}
  locale={locale}
>
  <section class="relative bg-gradient-to-b from-green-50/50 to-white pt-16 pb-8 px-4 text-center">
    <div class="max-w-2xl mx-auto animate-fadeInUp">
      <h1 class="text-4xl font-serif font-black text-foreground mb-3">FAQ</h1>
      <p class="text-green-700">{t('faq.subtitle')}</p>
    </div>
  </section>

  <section class="max-w-2xl mx-auto px-4 py-10">
    {faqs.length > 0 ? (
      <div class="space-y-3">
        {faqs.map((faq, i) => (
          <details class="group bg-card rounded-2xl border border-green-50 overflow-hidden">
            <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer font-semibold text-foreground hover:text-green-700 transition-colors list-none">
              <span>{faq.q}</span>
              <span class="text-green-400 text-lg group-open:rotate-45 transition-transform shrink-0">+</span>
            </summary>
            <div class="px-5 pb-5 text-green-700 text-sm leading-relaxed border-t border-green-50 pt-4">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    ) : (
      <div class="text-center text-green-500 py-12">
        <p class="text-4xl mb-3">🌿</p>
        <p>{t('faq.moreQuestions')}</p>
      </div>
    )}

    <div class="mt-10 text-center bg-green-50 rounded-2xl p-8">
      <p class="font-semibold text-foreground mb-1">{t('faq.stillHaveQuestions')}</p>
      <p class="text-sm text-green-600 mb-4">{t('faq.supportText')}</p>
      <a
        href={localePath(locale, '/contact')}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-green-700 text-white text-sm font-semibold hover:bg-green-800 transition-colors"
      >
        {t('faq.contact')} →
      </a>
    </div>
  </section>

  {faqs.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    })} />
  )}
</Layout>
