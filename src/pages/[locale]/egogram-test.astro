---
import Layout from '../../layouts/Layout.astro';
import TestExplainer from '../../components/shared/TestExplainer.astro';
import { TEST_EXPLAINERS } from '../../data/test-explainers';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import EgogramTest from '../../components/tests/EgogramTest';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<string, { title: string; description: string }> = {
  ko: {
    title: "에고그램 자아 상태 테스트 — 나의 다섯 가지 자아는?",
    description: "교류분석(TA) 이론 기반 10문항 에고그램 자아 상태 테스트. 비판적 부모(CP), 양육적 부모(NP), 성인(A), 자유로운 아이(FC), 순응하는 아이(AC) 5대 자아 에너지 균형을 분석하고 심리 솔루션을 즉시 무료로 확인하세요.",
  },
  en: {
    title: "Egogram Test — What Are Your Five Ego States?",
    description: "A 10-question egogram self-test based on Transactional Analysis (TA). Analyze your 5 ego states (Critical Parent, Nurturing Parent, Adult, Free Child, Adapted Child) and discover personalized psychological insights instantly for free.",
  },
  ja: {
    title: "エゴグラムテスト — あなたの5つの自我状態は？",
    description: "交流分析(TA)理論に基づく10問のエゴグラムテスト。批判的親(CP)、養育的親(NP)、成人(A)、自由な子供(FC)、順応した子供(AC)の5つの自我状態バランスを精密分析し、心理アドバイスを今すぐ無料で確認しましょう。",
  },
  fr: {
    title: "Test Égodiagramme — Quels sont vos cinq états du moi?",
    description: "Test égodiagramme de 10 questions basé sur l'Analyse Transactionnelle (TA). Analysez l'équilibre de vos 5 états du moi (Parent Critique, Parent Nourricier, Adulte, Enfant Libre, Enfant Adapté) et obtenez des conseils gratuits.",
  },
  es: {
    title: "Test de Egograma — ¿Cuáles son tus cinco estados del yo?",
    description: "Test de egograma de 10 preguntas basado en el Análisis Transaccional (AT). Analiza el equilibrio de tus 5 estados del yo (Padre Crítico, Padre Nutricio, Adulto, Niño Libre, Niño Adaptado) y obtén consejos psicológicos gratis.",
  },
  zh: {
    title: "自我图测试 — 你的五种自我状态是什么？",
    description: "基于人际沟通分析(TA)理论的10题自我图测试。全面解析批判性父母(CP)、抚育性父母(NP)、成人(A)、自由儿童(FC)与顺从儿童(AC)五大自我状态平衡，立即免费获取专属心理成长指南。",
  },
};
const m = meta[locale] ?? meta.en ?? Object.values(meta)[0];
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <EgogramTest locale={locale as any} client:load />
    <TestExplainer content={TEST_EXPLAINERS['egogram']} locale={locale as Locale} />
  </div>
</Layout>
