---
// akashic-records 개념 해설. 본문은 explainers 컬렉션(src/content/explainers/<locale>/akashic-records.md).
// 재창조가 로케일마다 순차로 올라가므로 원고가 있는 로케일만 경로를 낸다.
import Layout from '../../../layouts/Layout.astro';
import ExplainerArticle from '../../../components/shared/ExplainerArticle.astro';
import HeroArt from '../../../components/shared/HeroArt.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const have = new Set(
    (await getCollection('explainers', (e) => e.data.topic === 'akashic-records')).map((e) => e.data.locale),
  );
  return LOCALES.filter((l) => have.has(l)).map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const entry = await getEntry('explainers', `${locale}/akashic-records`);
if (!entry) throw new Error(`explainers 항목 없음: ${locale}/akashic-records`);
---
<Layout title={entry.data.title} description={entry.data.description} locale={locale}>
  {/* 2026-09-30 2-15: 세계수 세계관 그림(밤하늘)을 아카식 설명 머리에 둔다. */}
  <div class="mx-auto max-w-3xl px-4 pt-8">
    <HeroArt src="/images/oiyo-imagegen/hero/world-tree-night-sky.webp" class="max-h-64" />
  </div>
  <ExplainerArticle entry={entry} locale={locale} testPath="/ontology/" />
</Layout>
