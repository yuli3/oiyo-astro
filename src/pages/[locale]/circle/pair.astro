---
/**
 * 두 사람 보기 — 우리의 지도에서 고른 두 사람을 깊이 읽는 장.
 *
 * 이 브라우저의 원(localStorage)을 읽는 개인 화면이라 색인하지 않는다
 * (config/noindex-routes.js 에도 같은 경로가 있다). 주소에는 원 안의 번호만
 * 있고 생년월일·좌표는 싣지 않는다.
 */
import Layout from '../../../layouts/Layout.astro';
import PairReadingView from '../../../components/profile/PairReadingView';
import RelationshipComparisonPanel from '../../../components/profile/RelationshipComparisonPanel';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '두 사람 보기 — 우리의 지도', description: '우리의 지도에서 고른 두 사람을 이름·세 장면·둘의 달력·아홉 관점·근거로 깊이 읽어요.' },
  en: { title: 'The two of you — Our map', description: 'Read two people from Our map in depth: a name, three scenes, a shared calendar, nine lenses and the evidence.' },
  ja: { title: 'ふたりを見る — 私たちの地図', description: '私たちの地図で選んだふたりを、名前・三つの場面・ふたりの暦・九つの視点・根拠で深く読みます。' },
  zh: { title: '两个人 — 我们的地图', description: '深入解读从我们的地图中选出的两个人：名字、三个场景、共同日历、九种视角与依据。' },
  fr: { title: 'Vous deux — Notre carte', description: 'Lisez en profondeur deux personnes de Notre carte : un nom, trois scènes, un calendrier commun, neuf perspectives et les preuves.' },
  es: { title: 'Vosotros dos — Nuestro mapa', description: 'Lee a fondo a dos personas de Nuestro mapa: un nombre, tres escenas, un calendario compartido, nueve perspectivas y las pruebas.' },
};
const m = meta[locale] ?? meta.en;

/**
 * 검사 결과로도 맞춰 보기 — 2026-09-23 세운 결정.
 *
 * 이 패널(A5 파일럿)은 2026-09-21 에 공개 경로를 거뒀다. 궁합이 여러 갈래로
 * 흩어져 있던 것이 문제였고, 생년월일 기반 하나로 모으기로 했기 때문이다.
 * 되살리되 **갈래를 늘리지 않는다** — 별도 경로를 다시 열지 않고 두 사람 보기
 * 아래 접힌 칸으로 들어간다. 위는 생년월일 상징으로 보고, 아래는 각자 완료한
 * 검사 결과로 본다. 둘은 보는 것이 다르지 우열이 아니다.
 */
const compare: Record<Locale, { summary: string; lead: string }> = {
  ko: { summary: '검사 결과로도 맞춰 보기', lead: '위는 태어난 날의 상징으로 본 읽기예요. 두 사람이 각자 검사를 마쳤다면, 그 결과로도 공통점과 차이를 맞춰 볼 수 있어요.' },
  en: { summary: 'Compare by assessment results too', lead: 'Above is the reading from birth symbols. If you have each completed assessments, you can also line up what you share and where you differ.' },
  ja: { summary: '検査結果でも照らし合わせる', lead: '上は生まれた日の象徴による読みです。ふたりがそれぞれ検査を終えていれば、その結果でも共通点と違いを照らし合わせられます。' },
  zh: { summary: '也用测验结果对照', lead: '上面是按出生象征的解读。若两人各自完成过测验，也可以用结果来对照共同点与差异。' },
  fr: { summary: 'Comparer aussi par les résultats de tests', lead: 'Ci-dessus, la lecture par les symboles de naissance. Si vous avez chacun passé des tests, vous pouvez aussi aligner ce que vous partagez et ce qui vous sépare.' },
  es: { summary: 'Comparar también por los resultados de los tests', lead: 'Arriba está la lectura por los símbolos de nacimiento. Si cada uno ha completado tests, también podéis contrastar lo que compartís y en qué diferís.' },
};
const c = compare[locale] ?? compare.en;
---
<Layout title={m.title} description={m.description} locale={locale} noindex={true}>
  <div class="mx-auto max-w-4xl px-4 py-8 sm:py-12">
    <PairReadingView client:load locale={locale} />

    <details class="mt-8 rounded-[2rem] border border-border bg-card p-4 sm:p-7">
      <summary class="cursor-pointer list-none text-lg font-black text-foreground">{c.summary}</summary>
      <p class="mt-3 text-sm leading-7 text-muted-foreground">{c.lead}</p>
      <div class="mt-5">
        <RelationshipComparisonPanel client:visible locale={locale} />
      </div>
    </details>
  </div>
</Layout>
