---
import Layout from "../../layouts/Layout.astro";
import { LOCALES, localePath } from "../../i18n";
import type { Locale } from "../../i18n";
import Gyeonggongjang from "../../components/tools/past-life/Gyeonggongjang";
import RelatedTools from "../../components/shared/RelatedTools.astro";

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
type Copy = { title: string; description: string; heading: string; sub: string; intro: string; howTitle: string; how: string[]; faqTitle: string; faq: { q: string; a: string }[] };
const copy: Record<Locale, Copy> = {
  ko: {
    title: "경공장 장적 속 나 — 경국대전 서울 장인 2,800여 명 중 내 자리",
    description: "1485년 『경국대전』의 서울 관청 장인(경공장)이라면 나는 무엇을 만들었을까? 사옹원 사기장, 군기시 화살장, 상의원 비단장까지 실제 인원 비율로 뽑아요.",
    heading: "경공장 장적 속 나",
    sub: "『경국대전』 서울 관청의 장인 뽑기",
    intro: "조선은 서울 관청마다 장인을 두고 이름을 장적(공장안)에 올렸어요. 궁중 그릇을 굽던 사옹원 사기장, 화살을 만들던 군기시 시인, 왕의 옷감을 짜던 상의원 능라장… 실제 인원 비율로 내 자리를 뽑아 봐요.",
    howTitle: "어떻게 뽑나요",
    how: [
      "출처에서 관청별 인원을 확인한 20개 직종, 약 1,500자리에서 인원이 많은 자리일수록 잘 나오게 뽑아요.",
      "근무 방식(교대·급료·체아직·장포)은 한국민족문화대백과와 실록위키를 따랐어요.",
      "생일로 뽑으면 같은 생일은 언제나 같은 결과가 나와요. 생일은 링크에 들어가지 않아요.",
    ],
    faqTitle: "자주 묻는 질문",
    faq: [
      { q: "경공장은 모두 몇 명이었나요?", a: "『경국대전』 기준 30개 관청, 약 130종, 2,795명(한국민족문화대백과·실록위키)이에요. 우리역사넷은 2,841명으로 적어 출처마다 조금 달라요." },
      { q: "신분도 뽑나요?", a: "아니요. 장인은 양인과 관청·사찰에 속한 사람, 승려 등 여러 신분이 섞여 있었지만, 이 뽑기는 직종과 관청만 뽑아요." },
    ],
  },
  en: {
    title: "Me in the royal artisan register: Joseon's Seoul workshops, 1485",
    description: "If you were one of some 2,800 artisans in Seoul's offices under the 1485 code, what would you make? Palace porcelain, army arrows or royal silk, drawn by real headcounts.",
    heading: "Me in the royal artisan register",
    sub: "Artisans of Seoul's offices under the Gyeongguk Daejeon",
    intro: "Joseon kept artisans in each Seoul office and listed them in a register. Draw your trade and office in proportion to the real numbers.",
    howTitle: "How it works",
    how: ["We draw from about 1,500 places across 20 trades whose numbers by office are confirmed in the sources."],
    faqTitle: "FAQ",
    faq: [{ q: "How many were there?", a: "About 130 trades and 2,795 artisans in 30 offices (2,841 in another source)." }],
  },
  ja: {
    title: "京工匠の匠籍の中の私 — 経国大典の職人",
    description: "1485年『経国大典』の漢城の官庁職人なら、私は何を作った？実際の人数比で引きます。",
    heading: "京工匠の匠籍の中の私",
    sub: "『経国大典』漢城の官庁の職人",
    intro: "朝鮮は漢城の官庁ごとに職人を置き、匠籍に名を載せました。実際の人数比で私の席を引きます。",
    howTitle: "仕組み",
    how: ["官庁別人数を確認できた20職種・約1,500席から人数比で引きます。"],
    faqTitle: "よくある質問",
    faq: [{ q: "全部で何人？", a: "30官庁に約130種、2,795名（別の出典では2,841名）。" }],
  },
  zh: {
    title: "京工匠匠籍里的我 — 经国大典的工匠",
    description: "如果你是1485年《经国大典》中汉城官署的工匠，你会做什么？按真实人数比例抽。",
    heading: "京工匠匠籍里的我",
    sub: "《经国大典》汉城官署的工匠",
    intro: "朝鲜在汉城各官署设工匠并登入匠籍。按真实人数比例抽出你的位置。",
    howTitle: "怎么抽",
    how: ["在确认了各署人数的20个行当、约1,500个名额中按比例抽取。"],
    faqTitle: "常见问题",
    faq: [{ q: "一共多少人？", a: "30个官署约130种、2,795人（另一出处为2,841人）。" }],
  },
  fr: {
    title: "Moi, artisan royal de Joseon : les ateliers de Séoul en 1485",
    description: "Si vous étiez l'un des quelque 2 800 artisans des offices de Séoul en 1485, que feriez-vous ? Tiré selon les vrais effectifs.",
    heading: "Moi, artisan royal de Joseon",
    sub: "Les artisans des offices de Séoul",
    intro: "Joseon attachait des artisans à chaque office de Séoul et les inscrivait au registre. Tirez votre métier selon les effectifs réels.",
    howTitle: "Comment ça marche",
    how: ["Tirage parmi environ 1 500 places de 20 métiers dont l'effectif par office est confirmé."],
    faqTitle: "Questions fréquentes",
    faq: [{ q: "Combien étaient-ils ?", a: "Environ 130 métiers et 2 795 artisans dans 30 offices (2 841 selon une autre source)." }],
  },
  es: {
    title: "Yo, artesano real de Joseon: los talleres de Seúl en 1485",
    description: "Si fueras uno de los unos 2.800 artesanos de las oficinas de Seúl en 1485, ¿qué harías? Según cifras reales.",
    heading: "Yo, artesano real de Joseon",
    sub: "Los artesanos de las oficinas de Seúl",
    intro: "Joseon asignaba artesanos a cada oficina de Seúl y los inscribía en un registro. Sortea tu oficio según las cifras reales.",
    howTitle: "Cómo funciona",
    how: ["Sorteo entre unas 1.500 plazas de 20 oficios con cifras confirmadas por oficina."],
    faqTitle: "Preguntas frecuentes",
    faq: [{ q: "¿Cuántos eran?", a: "Unos 130 oficios y 2.795 artesanos en 30 oficinas (2.841 según otra fuente)." }],
  },
};
const c = copy[locale] ?? copy.en;
const faqJsonLd = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: c.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };
---
<Layout title={c.title} description={c.description} locale={locale} canonicalPath={localePath(locale, "/gyeonggongjang/")} ogImage="/images/past-life-1426/og/gyeonggongjang.webp">
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="container mx-auto max-w-3xl px-4 py-8">
    <p class="text-sm font-bold text-muted-foreground"><a class="hover:underline" href={localePath(locale, "/past-life-1426/")}>← {({ ko: "타임슬립 시리즈", en: "Time-slip series", ja: "タイムスリップ・シリーズ", zh: "时空穿越系列", fr: "Série voyage dans le temps", es: "Serie viaje en el tiempo" } as Record<string, string>)[locale] ?? "Time-slip"}</a></p>
    <h1 class="mt-2 text-4xl font-black tracking-tight text-foreground">
      {c.heading}
      <span class="mt-1 block text-xl font-bold text-muted-foreground">{c.sub}</span>
    </h1>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted-foreground">{c.intro}</p>
    <div class="mt-6"><Gyeonggongjang locale={locale} client:load /></div>
    <RelatedTools locale={locale} tools={["joseon1426", "joseonTime", "joseonNames"]} current="gyeonggongjang" />
    <section class="mt-10 text-sm leading-relaxed text-muted-foreground">
      <h2 class="text-lg font-bold text-foreground">{c.howTitle}</h2>
      {c.how.map((p) => <p class="mt-2">{p}</p>)}
    </section>
    <section class="mt-10 text-sm leading-relaxed text-muted-foreground">
      <h2 class="text-lg font-bold text-foreground">{c.faqTitle}</h2>
      {c.faq.map((f) => (<div class="mt-4"><h3 class="font-bold text-foreground">{f.q}</h3><p class="mt-1">{f.a}</p></div>))}
    </section>
  </div>
</Layout>
