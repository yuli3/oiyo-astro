---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import CollabRiskTest from '../../components/tests/CollabRiskTest';
import BlogDeepDive from '../../components/shared/BlogDeepDive.astro';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<string, { title: string; description: string }> = {
  ko: { title: "협업 리스크 테스트: 나는 팀워크에 얼마나 안전한가?", description: "12개의 질문으로 팀워크 내 협업 리스크와 갈등 요인을 진단합니다. 낮음·보통·높음·위험 4단계 평가." },
  en: { title: "Collab Risk Test: How Safe Are You for Teamwork?", description: "Assess your collaboration risk factors in teamwork with 12 questions. Rated Low, Moderate, High, or Critical." },
  ja: { title: "コラボリスクテスト：チームワークにどれくらい安全？", description: "12の質問でチームワークにおける協業リスクと対立要因を診断。低・中・高・危険の4段階評価。" },
  fr: { title: "Test Collab Risk : Êtes-vous fiable pour le travail en équipe?", description: "Évaluez vos facteurs de risque de collaboration en équipe avec 12 questions. Évalué Faible, Modéré, Élevé ou Critique." },
  es: { title: "Test Collab Risk: ¿Qué tan seguro eres para el trabajo en equipo?", description: "Evalúa tus factores de riesgo de colaboración con 12 preguntas. Calificado como Bajo, Moderado, Alto o Crítico." },
  zh: { title: "协作风险测试：你对团队合作有多安全？", description: "通过12个问题诊断团队协作中的风险因素。低、中、高、危险四个等级评估。" },
};
const m = meta[locale] ?? meta.en ?? Object.values(meta)[0];
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <CollabRiskTest locale={locale as any} client:load />
    <BlogDeepDive slug="collab-risk-test" locale={locale} />
  </div>
</Layout>
