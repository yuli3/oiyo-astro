---
import Layout from "../../layouts/Layout.astro";
import { LOCALES } from "../../i18n";
import type { Locale } from "../../i18n";
import OvertimeNightHolidayCalculator from "../../components/tools/OvertimeNightHolidayCalculator";

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "연장·야간·휴일근로 가산수당 & 중복할증(최대 2.5배) 계산기 | OIYO Tools",
    description: "근로기준법 제56조 기준, 평일 연장(1.5배), 야간(0.5배), 휴일(1.5~2.0배) 및 휴일야간 중복할증(최대 2.5배) 법정 가산수당을 1초 만에 계산합니다.",
  },
  en: {
    title: "Korea Overtime, Night & Holiday Premium Pay Calculator (Max 2.5x) | OIYO Tools",
    description: "Calculate statutory overtime (1.5x), night shift (0.5x), holiday (1.5x/2.0x), and compounded night-holiday premium pay (up to 2.5x) under Korean Labor Law.",
  },
  ja: {
    title: "韓国 時間外・夜間・休日労働割増賃金＆重複割増（最大2.5倍）計算機 | OIYO Tools",
    description: "韓国勤労基準法第56条に基づき、残業(1.5倍)、夜間(0.5倍加算)、休日(1.5〜2.0倍)および休日夜間重複割増(最大2.5倍)手当を瞬時に計算。",
  },
  zh: {
    title: "韩国 加班·夜班·节假日加班法定津贴与重叠加成（最高2.5倍）计算器 | OIYO Tools",
    description: "依据韩国劳动基准法第56条，精准测算工作日加班（1.5倍）、夜班（0.5倍加成）、节假日（1.5~2.0倍）及节假日夜班叠加（最高2.5倍）法定工资。",
  },
  fr: {
    title: "Calculateur d'heures supplémentaires, de nuit et de jours fériés en Corée | OIYO Tools",
    description: "Calculez les majorations légales pour heures supplémentaires (1,5x), travail de nuit (0,5x) et jours fériés (jusqu'à 2,5x) en Corée.",
  },
  es: {
    title: "Calculadora de horas extras, nocturnas y festivas en Corea (Hasta 2.5x) | OIYO Tools",
    description: "Calcule la remuneración legal por horas extraordinarias (1.5x), nocturnas (0.5x) y días festivos (hasta 2.5x) según la Ley Laboral de Corea.",
  },
};

const currentMeta = meta[locale] ?? meta.ko;
---

<Layout title={currentMeta.title} description={currentMeta.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 space-y-8">
    <div class="text-center space-y-2 max-w-2xl mx-auto">
      <h1 class="text-3xl font-extrabold tracking-tight">연장·야간·휴일 가산수당 계산기</h1>
      <p class="text-muted-foreground text-sm">
        근로기준법 제56조 연장(1.5배), 야간(0.5배), 휴일(1.5~2.0배) 및 휴일야간 중복할증(최대 2.5배) 완벽 분해
      </p>
    </div>

    <OvertimeNightHolidayCalculator client:load locale={locale} />

    <div class="max-w-4xl mx-auto border rounded-xl p-6 bg-card border-border space-y-4">
      <h2 class="text-lg font-bold">근로기준법상 가산수당 중복할증 핵심 규칙</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-muted-foreground leading-relaxed">
        <div class="space-y-1">
          <h3 class="font-semibold text-foreground">💡 휴일 8시간 초과 + 야간근로 = 2.5배(250%)</h3>
          <p>
            휴일에 8시간을 초과하여 일하면 <strong>휴일 연장수당(2.0배)</strong>이 적용되며, 여기에 22시 이후 <strong>야간근로가 겹칠 경우 추가 0.5배가 합산</strong>되어 시급의 <strong>2.5배(250%)</strong>를 지급받아야 합니다.
          </p>
        </div>
        <div class="space-y-1">
          <h3 class="font-semibold text-foreground">⚠️ 5인 미만 사업장은 법정 가산수당 제외</h3>
          <p>
            근로기준법 제56조는 상시근로자 <strong>5인 이상 사업장에만 의무 적용</strong>됩니다. 5인 미만 소규모 사업장의 경우 연장, 야간, 휴일에 근무하더라도 가산수당 없이 근무한 시간만큼의 <strong>기본 시급(1.0배)</strong>만 지급됩니다.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
