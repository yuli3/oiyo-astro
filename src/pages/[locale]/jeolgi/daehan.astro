---
// 대한 해설. 본문은 explainers 컬렉션(src/content/explainers/<locale>/jeolgi-daehan.md).
//
// getStaticPaths 가 로케일을 필터하는 이유: 재창조는 로케일마다 순차로 올라간다.
// LOCALES 를 그대로 돌리면 원고가 아직 없는 로케일에서 빌드가 죽는다.
import Layout from '../../../layouts/Layout.astro';
import ExplainerArticle from '../../../components/shared/ExplainerArticle.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const have = new Set(
    (await getCollection('explainers', (e) => e.data.topic === 'jeolgi-daehan'))
      .map((e) => e.data.locale),
  );
  return LOCALES.filter((l) => have.has(l)).map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const entry = await getEntry('explainers', `${locale}/jeolgi-daehan`);
if (!entry) throw new Error(`explainers 항목 없음: ${locale}/jeolgi-daehan`);
---
<Layout title={entry.data.title} description={entry.data.description} locale={locale}>
  <ExplainerArticle entry={entry} locale={locale} testPath="/saju/calculator" ctaKind="saju" />
</Layout>
