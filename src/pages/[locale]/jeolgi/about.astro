---
// 24절기 해설. 본문은 explainers 컬렉션(src/content/explainers/<locale>/jeolgi.md)에 있다.
// 테스트가 아니라 사주 계산기로 잇는다 — 글이 설명하는 월주 경계를 실제로 쓰는 화면이다.
import Layout from '../../../layouts/Layout.astro';
import ExplainerArticle from '../../../components/shared/ExplainerArticle.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import { getEntry } from 'astro:content';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const entry = await getEntry('explainers', `${locale}/jeolgi`);
if (!entry) throw new Error(`explainers 항목 없음: ${locale}/jeolgi`);
---
<Layout title={entry.data.title} description={entry.data.description} locale={locale}>
  <ExplainerArticle entry={entry} locale={locale} testPath="/saju/calculator" ctaKind="saju" />
</Layout>
