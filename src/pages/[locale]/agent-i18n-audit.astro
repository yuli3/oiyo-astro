---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import AgentI18nAuditComponent from '../../components/tools/AgentI18nAudit';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "AI 에이전트 다국어 i18n 누락 키 & 치환자 일관성 감사기 — 번역 완성도 검사",
    description: "다국어 웹 서비스 및 AI 에이전트 JSON 딕셔너리 간 누락 키, 고아 키, 템플릿 변수 치환자({var}) 유실 및 번역 완성도를 실시간 전수 감사하고 패치 스텁을 생성합니다.",
  },
  en: {
    title: "Agent i18n Missing Keys & Token Consistency Auditor — Translation Completeness Tool",
    description: "Audit missing translation keys, orphaned keys, variable interpolation mismatches, and completeness percentages across multi-locale JSON dictionaries in real time.",
  },
  ja: {
    title: "AIエージェント 多言語i18n 欠落キー＆置換トークン一貫性監査機 — 翻訳完成度検査",
    description: "多言語WebサービスおよびAIエージェントのJSON辞書間の欠落キー、不要な孤立キー、変数置換子({var})の欠落、および翻訳完成度をリアルタイム監査しパッチを生成します。",
  },
  zh: {
    title: "AI Agent 多语言 i18n 缺失键与替换标记一致性审计器 — 翻译完整度检测",
    description: "实时全面审计多语言JSON字典间的缺失键、冗余孤立键、模板变量插值({var})丢失及各语言翻译完成度百分比，并自动生成补丁文件。",
  },
  fr: {
    title: "Audit i18n Clés Manquantes et Cohérence des Variables pour Agents IA",
    description: "Détectez les clés de traduction manquantes, les clés orphelines et les variables d'interpolation brisées dans vos dictionnaires JSON multilingues.",
  },
  es: {
    title: "Auditor de Claves Faltantes i18n y Coherencia de Tokens para Agentes IA",
    description: "Audita claves de traducción ausentes, claves huérfanas y variables de interpolación rotas en diccionarios JSON multilingües en tiempo real.",
  },
};

const currentMeta = meta[locale] ?? meta.ko;
---

<Layout
  title={currentMeta.title}
  description={currentMeta.description}
  locale={locale}
>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto mb-8 text-center">
      <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary mb-3">
        <span>{locale === 'ko' ? '글로벌 엔지니어링 도구' : 'Global Engineering Tools'}</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl text-foreground">
        {currentMeta.title.split('—')[0]}
      </h1>
      <p class="mt-3 text-base text-muted-foreground sm:text-lg">
        {currentMeta.description}
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <AgentI18nAuditComponent client:load locale={locale} />
    </div>

    {/* Hub-and-Spoke Context / FAQ */}
    <section class="max-w-4xl mx-auto mt-8 rounded-xl border border-border bg-card p-6 space-y-4 text-sm text-muted-foreground">
      <h2 class="text-lg font-bold text-foreground">
        {locale === 'ko' ? '자주 묻는 i18n 번역 및 AI 엔지니어링 Q&A' : 'Frequently Asked Questions'}
      </h2>

      <div class="space-y-3">
        <div>
          <h3 class="font-semibold text-foreground">
            {locale === 'ko' ? 'Q1. 변수 치환자({variable}) 불일치가 왜 런타임 크래시를 유발하나요?' : 'Q1. Why do missing interpolation tokens cause runtime crashes?'}
          </h3>
          <p class="mt-1">
            {locale === 'ko'
              ? 'react-intl, next-intl, vue-i18n 등의 다국어 프레임워크는 원문에 정의된 변수(예: {username}, {count})가 번역문에서 누락되거나 오타({userName} 등)가 발생하면 TypeError를 던지거나 렌더링이 실패할 수 있습니다. 본 감사기는 파싱 단계에서 토큰 목록을 추출하여 누락 여부를 사전에 차단합니다.'
              : 'Frameworks like react-intl or next-intl can throw runtime errors if tokens like {count} are omitted or misspelled in translated strings.'}
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-foreground">
            {locale === 'ko' ? 'Q2. 고아 키(Orphaned Keys)는 왜 정리해야 하나요?' : 'Q2. Why should orphan keys be cleaned up?'}
          </h3>
          <p class="mt-1">
            {locale === 'ko'
              ? '기준 언어 코드에서 기능이 삭제되었음에도 타 언어 파일에 방치된 고아 키는 클라이언트 번들 크기를 불필요하게 낭비하고, 후속 번역 작업 시 이미 폐기된 문장을 반복 번역하는 인적·토큰 비용 낭비를 유발합니다.'
              : 'Orphaned keys bloat client bundle sizes and waste translation budget on obsolete features.'}
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-foreground">
            {locale === 'ko' ? 'Q3. 자동 생성된 패치 스텁은 어떻게 활용하나요?' : 'Q3. How can the patch stub be used?'}
          </h3>
          <p class="mt-1">
            {locale === 'ko'
              ? '누락된 키만을 추출한 패치 JSON을 복사하여 Claude, GPT, Gemini 등의 AI 모델에 전달하면 원문 맥락을 그대로 유지하면서 누락된 번역문만을 즉시 완성할 수 있습니다.'
              : 'Copy the patch JSON stub and prompt an LLM to translate only the missing items, ensuring prompt efficiency.'}
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
