---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import PoliticalCompassTest from '../../../components/tests/PoliticalCompassTest';
import RelatedTools from '../../../components/shared/RelatedTools.astro';
import { buildQuizJsonLd } from '../../../lib/seo/quiz-json-ld';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: '정치 나침반 테스트 — 나의 가치관과 세계관 좌표',
    description: '경제(평등↔시장), 사회(전통↔진보), 외교(민족↔국제), 국가(권위↔자유) 4개 축으로 나의 정치적 가치관 스펙트럼을 찾아보세요.',
  },
  en: {
    title: 'Political Compass Test — Find Your Values & Worldview',
    description: 'Discover your political value spectrum across 4 axes: Economics (Equality↔Market), Social (Traditional↔Progressive), Diplomacy (National↔Global), State (Authoritarian↔Libertarian).',
  },
  ja: {
    title: '政治コンパステスト — 価値観と世界観の座標',
    description: '経済(平等↔市場)、社会(伝統↔進歩)、外交(民族↔国際)、国家(権威↔自由)の4軸で、自分の政治的価値観スペクトラムを見つけましょう。',
  },
  zh: {
    title: '政治指南针测试 — 探索你的价值观坐标',
    description: '通过4个轴——经济(平等↔市场)、社会(传统↔进步)、外交(民族↔全球)、国家(威权↔自由)——找到你的政治价值观谱系。',
  },
  fr: {
    title: 'Test Boussole Politique — Trouvez vos Valeurs',
    description: 'Découvrez votre spectre de valeurs politiques sur 4 axes : Économie (Égalité↔Marché), Social (Traditionnel↔Progressiste), Diplomatie (Nationaliste↔Mondialiste), État (Autoritaire↔Libertaire).',
  },
  es: {
    title: 'Test Brújula Política — Descubre tus Valores',
    description: 'Descubre tu espectro de valores políticos en 4 ejes: Economía (Igualdad↔Mercado), Social (Tradicional↔Progresista), Diplomacia (Nacionalista↔Globalista), Estado (Autoritario↔Libertario).',
  },
};
const m = meta[locale] ?? meta.en;
const ontologyContextMap = {
  ko: { badge: '가치 지도', title: '정치성향은 정당 선택이 아니라, 가치 충돌에서 무엇을 먼저 보는지 알려주는 좌표입니다.', body: '이 결과는 OIYO Ontology 안에서 사회와 공동체를 바라보는 렌즈입니다. 경제관, 조선붕당, 삶의 가치와 함께 읽으면 나의 존재 지도가 더 선명해집니다.', status: '아직 열지 않음', time: '소요 시간 5분', count: '41문항' },
  en: { badge: 'Values map', title: 'Political orientation is not a party choice; it is a coordinate for what you prioritize in value conflicts.', body: 'Inside OIYO Ontology, this result is a lens for how you read society and community. It becomes clearer with economic worldview, Joseon factions, and life values.', status: 'Not opened yet', time: '5 min', count: '41 questions' },
  ja: { badge: '価値地図', title: '政治性向は政党選択ではなく、価値の衝突で何を先に見るかの座標です。', body: 'OIYO Ontologyでは、社会と共同体を見るレンズです。経済観、朝鮮派閥、人生価値と重ねると存在地図がより明確になります。', status: 'まだ開いていません', time: '5分', count: '41問' },
  zh: { badge: '价值地图', title: '政治倾向不是政党选择，而是你在价值冲突中优先看见什么的坐标。', body: '在 OIYO Ontology 中，它是理解社会与共同体的镜片。与经济观、朝鲜派系和人生价值一起阅读会更清晰。', status: '尚未打开', time: '5分钟', count: '41题' },
  fr: { badge: 'Carte des valeurs', title: 'L’orientation politique n’est pas un choix de parti, mais une coordonnée de vos priorités dans les conflits de valeurs.', body: 'Dans OIYO Ontology, c’est une lentille pour lire société et communauté. Elle se précise avec économie, factions Joseon et valeurs de vie.', status: 'Pas encore ouvert', time: '5 min', count: '41 questions' },
  es: { badge: 'Mapa de valores', title: 'La orientación política no es elegir partido, sino una coordenada de lo que priorizas en conflictos de valor.', body: 'Dentro de OIYO Ontology, es una lente para leer sociedad y comunidad. Se aclara con economía, facciones Joseon y valores de vida.', status: 'Aún no abierto', time: '5 min', count: '41 preguntas' },
} as const;
const oc = ontologyContextMap[locale] ?? ontologyContextMap.en;

// 소개 텍스트
const intro: Record<Locale, { heading: string; body: string; axes: string[] }> = {
  ko: {
    heading: '내 정치적 가치관의 좌표는?',
    body: '41개 문항, 4단계로 나의 가치관과 세계관이 정치적 스펙트럼 어디에 위치하는지 확인해보세요. 특정 정당이나 이념을 지지하는 것이 아닌, 순수하게 자기 이해를 위한 도구입니다.',
    axes: ['1. 경제관 — 평등주의 ↔ 시장주의','2. 사회관 — 전통주의 ↔ 진보주의','3. 세계관 — 민족주의 ↔ 국제주의','4. 국가관 — 권위주의 ↔ 자유주의'],
  },
  en: {
    heading: 'Where do your values land on the political spectrum?',
    body: '41 questions across 4 steps to discover where your values and worldview sit on the political spectrum. This is a self-understanding tool, not an endorsement of any political party.',
    axes: ['1. Economics — Equality ↔ Market','2. Social — Traditional ↔ Progressive','3. Diplomacy — Nationalist ↔ Globalist','4. State Power — Authoritarian ↔ Libertarian'],
  },
  ja: {
    heading: '自分の価値観は政治的スペクトラムのどこに？',
    body: '41問、4ステップで、あなたの価値観と世界観が政治的スペクトラムのどこに位置するかを確認しましょう。特定の政党やイデオロギーを支持するものではありません。',
    axes: ['1. 経済観 — 平等主義 ↔ 市場主義','2. 社会観 — 伝統主義 ↔ 進歩主義','3. 世界観 — 民族主義 ↔ 国際主義','4. 国家観 — 権威主義 ↔ 自由主義'],
  },
  zh: {
    heading: '你的价值观在政治光谱中的位置',
    body: '41个问题，分4步，帮你发现自己的价值观和世界观在政治光谱中的位置。这是一个自我理解的工具，不代表支持任何政党。',
    axes: ['1. 经济观 — 平等主义 ↔ 市场主义','2. 社会观 — 传统主义 ↔ 进步主义','3. 外交观 — 民族主义 ↔ 国际主义','4. 国家观 — 威权主义 ↔ 自由主义'],
  },
  fr: {
    heading: 'Où se situent vos valeurs sur le spectre politique ?',
    body: '41 questions en 4 étapes pour découvrir où se situent vos valeurs sur le spectre politique. Cet outil est uniquement destiné à la compréhension de soi.',
    axes: ['1. Économie — Égalitaire ↔ Libéral','2. Social — Traditionnel ↔ Progressiste','3. Diplomatie — Nationaliste ↔ Mondialiste','4. État — Autoritaire ↔ Libertaire'],
  },
  es: {
    heading: '¿Dónde están tus valores en el espectro político?',
    body: '41 preguntas en 4 pasos para descubrir dónde se sitúan tus valores en el espectro político. Esta herramienta es solo para la autocomprensión.',
    axes: ['1. Economía — Igualitario ↔ Mercado','2. Social — Tradicional ↔ Progresista','3. Diplomacia — Nacionalista ↔ Globalista','4. Estado — Autoritario ↔ Libertario'],
  },
};
const iv = intro[locale] ?? intro.en;

const content: Record<Locale, { introTitle: string; intro: string; conceptTitle: string; concepts: { title: string; body: string }[]; faqTitle: string; faqs: { question: string; answer: string }[]; disclaimer: string; }> = {
  ko: { introTitle: '정치 나침반은 사람을 단정하는 라벨이 아니라 가치관의 좌표를 보는 렌즈입니다', intro: '정치 나침반 테스트는 경제, 사회, 외교, 국가관 네 축에서 나의 가치 우선순위가 어디에 놓이는지 살펴봅니다. 결과는 특정 정당이나 이념을 지지하거나 반대하지 않으며, 가치 조합을 중립적으로 이해하기 위한 참고입니다.', conceptTitle: '정치 나침반을 읽는 세 가지 관점', concepts: [{ title: '축으로 보기', body: '정치 성향은 하나의 이름보다 여러 가치 축의 조합으로 보는 편이 더 섬세합니다.' }, { title: '우선순위의 차이', body: '같은 결론에 도달해도 경제, 자유, 공동체, 안정 중 무엇을 먼저 두는지는 다를 수 있습니다.' }, { title: '중립적 해석', body: '결과는 특정 정당이나 이념의 지지·반대를 뜻하지 않으며 자기 탐색을 위한 좌표입니다.' }], faqTitle: '자주 묻는 질문', faqs: [{ question: '이 결과는 특정 정치 입장을 평가하나요?', answer: '아니요. 어떤 입장이 옳거나 그르다고 말하지 않습니다. 여러 가치가 어떻게 조합되는지 중립적으로 보여 줍니다.' }, { question: '결과가 나중에 바뀔 수 있나요?', answer: '네. 사회 경험, 관심 이슈, 책임의 위치가 바뀌면 가치 우선순위도 달라질 수 있습니다.' }, { question: '결과를 어떻게 활용하면 좋나요?', answer: '나와 다른 사람을 판단하기보다, 어떤 가치 충돌에서 내가 무엇을 먼저 보는지 설명하는 언어로 사용해 보세요.' }], disclaimer: '정치 나침반 결과는 자기 이해와 대화를 위한 참고입니다. 진단, 채용, 정치적 단정, 관계의 단정적 판단 근거로 사용하지 마세요.' },
  en: { introTitle: 'The political compass is a lens for value coordinates, not a label that defines you', intro: 'The political compass test looks at where your value priorities sit across economic, social, diplomatic, and state-power axes. The result does not endorse or oppose any party or ideology; it is a neutral reference for understanding value combinations.', conceptTitle: 'Three ways to read the political compass', concepts: [{ title: 'Reading by axes', body: 'Political orientation is often clearer as a mix of value axes than as one label.' }, { title: 'Different priorities', body: 'People can reach similar conclusions while prioritizing economy, liberty, community, or stability differently.' }, { title: 'Neutral interpretation', body: 'The result does not endorse or oppose a party or ideology; it is a coordinate for self-reflection.' }], faqTitle: 'Frequently asked questions', faqs: [{ question: 'Does this evaluate a political stance?', answer: 'No. It does not call any stance right or wrong. It neutrally shows how different values combine in your answers.' }, { question: 'Can my result change later?', answer: 'Yes. Social experience, current issues, and responsibility can shift value priorities.' }, { question: 'How should I use the result?', answer: 'Use it as language for explaining which values you notice first in a conflict, not as a way to judge yourself or others.' }], disclaimer: 'Political compass results are for self-understanding and conversation. Do not use them as a basis for diagnosis, hiring, political verdicts, or definitive relationship judgments.' },
  ja: { introTitle: '政治コンパスは人を決めつけるラベルではなく、価値観の座標を見るレンズです', intro: '政治コンパステストは経済、社会、外交、国家観の四軸で価値の優先順位がどこにあるかを見ます。結果は政党やイデオロギーを支持も否定もせず、価値の組み合わせを中立的に理解する参考です。', conceptTitle: '政治コンパスを読む三つの視点', concepts: [{ title: '軸で読む', body: '政治的傾向は一つの名前より、複数の価値軸の組み合わせで見ると繊細です。' }, { title: '優先順位の違い', body: '同じ結論でも、経済、自由、共同体、安定のどれを先に置くかは違います。' }, { title: '中立的な解釈', body: '結果は政党やイデオロギーへの支持・反対ではなく、自己探索の座標です。' }], faqTitle: 'よくある質問', faqs: [{ question: '特定の政治的立場を評価しますか？', answer: 'いいえ。どの立場が正しい、間違っているとは言いません。複数の価値がどう組み合わさるかを中立的に示します。' }, { question: '結果は後で変わりますか？', answer: '変わります。社会経験、関心のある課題、責任の位置によって価値の優先順位は変化します。' }, { question: '結果はどう使えばよいですか？', answer: '自分や他者を判断するためではなく、価値の衝突で何を先に見るかを説明する言葉として使ってください。' }], disclaimer: '政治コンパスの結果は自己理解と対話のための参考です。診断、採用、政治的断定、人間関係の断定的判断には使わないでください。' },
  zh: { introTitle: '政治指南针是观察价值观坐标的镜片，不是定义人的标签', intro: '政治指南针测试观察经济、社会、外交和国家观四个轴上你的价值优先级。结果不支持也不反对任何政党或意识形态，只是中立理解价值组合的参考。', conceptTitle: '理解政治指南针的三个角度', concepts: [{ title: '按轴理解', body: '政治倾向用多个价值轴的组合来理解，通常比单一标签更细致。' }, { title: '优先级差异', body: '即使结论相似，人们对经济、自由、共同体和稳定的优先顺序也可能不同。' }, { title: '中立解读', body: '结果不代表支持或反对任何政党或意识形态，只是自我探索的坐标。' }], faqTitle: '常见问题', faqs: [{ question: '这个结果会评价某种政治立场吗？', answer: '不会。它不判断任何立场对错，只是中立展示你回答中不同价值如何组合。' }, { question: '结果以后会改变吗？', answer: '会。社会经验、当前关注议题和责任位置都可能改变价值优先级。' }, { question: '应该如何使用结果？', answer: '不要用它评判自己或他人，而是用来说明价值冲突中你会先看到什么。' }], disclaimer: '政治指南针结果仅用于自我理解与对话，请勿作为诊断、招聘、政治定论或关系定论的依据。' },
  fr: { introTitle: 'La boussole politique est une lentille pour vos coordonnées de valeurs, pas une étiquette qui vous définit', intro: 'Le test boussole politique observe vos priorités de valeurs sur les axes économique, social, diplomatique et étatique. Le résultat ne soutient ni ne rejette aucun parti ou courant; il sert à comprendre les combinaisons de valeurs de façon neutre.', conceptTitle: 'Trois façons de lire la boussole politique', concepts: [{ title: 'Lire par axes', body: 'Une orientation politique se comprend souvent mieux comme combinaison d’axes que comme étiquette unique.' }, { title: 'Différences de priorité', body: 'Des conclusions proches peuvent venir de priorités différentes: économie, liberté, communauté ou stabilité.' }, { title: 'Interprétation neutre', body: 'Le résultat ne soutient ni ne rejette aucun parti ou courant; c’est un repère d’auto-réflexion.' }], faqTitle: 'Questions fréquentes', faqs: [{ question: 'Le résultat évalue-t-il une position politique ?', answer: 'Non. Il ne dit pas qu’une position est bonne ou mauvaise. Il montre de façon neutre la combinaison de valeurs dans vos réponses.' }, { question: 'Le résultat peut-il changer ?', answer: 'Oui. Les expériences sociales, les sujets actuels et les responsabilités peuvent déplacer les priorités de valeurs.' }, { question: 'Comment l’utiliser ?', answer: 'Utilisez-le pour expliquer quelles valeurs vous remarquez d’abord dans un conflit, pas pour juger les personnes.' }], disclaimer: 'Les résultats de la boussole politique servent à la compréhension de soi et au dialogue. Ne les utilisez pas comme base de diagnostic, de recrutement, de verdict politique ou de verdict relationnel.' },
  es: { introTitle: 'La brújula política es una lente para coordenadas de valores, no una etiqueta que te define', intro: 'El test de brújula política observa tus prioridades de valores en los ejes económico, social, diplomático y estatal. El resultado no apoya ni rechaza partidos o ideologías; sirve para entender combinaciones de valores de forma neutral.', conceptTitle: 'Tres formas de leer la brújula política', concepts: [{ title: 'Leer por ejes', body: 'La orientación política suele entenderse mejor como mezcla de ejes de valor que como una sola etiqueta.' }, { title: 'Diferencias de prioridad', body: 'Conclusiones parecidas pueden venir de prioridades distintas: economía, libertad, comunidad o estabilidad.' }, { title: 'Interpretación neutral', body: 'El resultado no apoya ni rechaza partidos o ideologías; es una coordenada para reflexionar.' }], faqTitle: 'Preguntas frecuentes', faqs: [{ question: '¿El resultado evalúa una postura política?', answer: 'No. No dice que una postura sea correcta o incorrecta. Muestra de forma neutral cómo se combinan valores en tus respuestas.' }, { question: '¿Puede cambiar el resultado?', answer: 'Sí. Experiencias sociales, temas actuales y responsabilidades pueden cambiar prioridades de valor.' }, { question: '¿Cómo usarlo?', answer: 'Úsalo para explicar qué valores notas primero en un conflicto, no para juzgar a personas.' }], disclaimer: 'Los resultados de la brújula política son para autoconocimiento y conversación. No los uses como base para diagnóstico, contratación, veredictos políticos o juicios definitivos sobre relaciones.' },
};

const c = content[locale] ?? content.en;
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
const quizJsonLd = buildQuizJsonLd({
  name: m.title,
  description: m.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  inLanguage: locale,
  questions: [],
});

---

<Layout title={m.title} description={m.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(quizJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="mx-auto max-w-2xl px-4 py-10">
    <section class="mb-6 rounded-3xl border border-violet-200 bg-gradient-to-br from-violet-50 to-white p-5 shadow-sm">
      <div class="flex flex-wrap items-center gap-2 text-xs font-black text-violet-600">
        <a href={`/${locale}/ontology`} class="hover:text-violet-800">OIYO Ontology</a>
        <span>›</span>
        <span>{oc.badge}</span>
        <span class="ml-auto rounded-full bg-white px-2.5 py-1 text-violet-700">{oc.status}</span>
      </div>
      <h1 class="mt-3 text-2xl font-black text-violet-950">{oc.title}</h1>
      <p class="mt-3 text-sm leading-7 text-violet-700">{oc.body}</p>
      <div class="mt-4 flex flex-wrap gap-2 text-xs font-bold text-slate-600">
        <span class="rounded-full bg-white px-3 py-1 ring-1 ring-violet-100">{oc.time}</span>
        <span class="rounded-full bg-white px-3 py-1 ring-1 ring-violet-100">{oc.count}</span>
      </div>
    </section>

    <!-- 소개 섹션 -->
    <div class="mb-8 rounded-2xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-black text-slate-900">{iv.heading}</h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-600">{iv.body}</p>
      <ul class="mt-4 space-y-1">
        {iv.axes.map(a => (
          <li class="flex items-start gap-2 text-sm text-slate-700">
            <span class="mt-0.5 text-green-600">▸</span>{a}
          </li>
        ))}
      </ul>
    </div>

    <!-- 테스트 컴포넌트 -->
    <PoliticalCompassTest client:load locale={locale} />

    <section class="mt-10 border-t border-violet-100 pt-8"><h2 class="text-2xl font-bold text-violet-950">{c.introTitle}</h2><p class="mt-4 leading-8 text-violet-800">{c.intro}</p></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.conceptTitle}</h2><div class="mt-4 grid gap-4 md:grid-cols-3">{c.concepts.map((item) => (<article class="rounded-xl border border-violet-100 bg-white p-4"><h3 class="font-semibold text-violet-950">{item.title}</h3><p class="mt-2 text-sm leading-6 text-violet-700">{item.body}</p></article>))}</div></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.faqTitle}</h2><div class="mt-4 divide-y divide-violet-100 rounded-xl border border-violet-100 bg-white">{c.faqs.map((faq) => (<details class="group p-4"><summary class="cursor-pointer list-none font-semibold text-violet-950">{faq.question}</summary><p class="mt-3 text-sm leading-6 text-violet-700">{faq.answer}</p></details>))}</div></section>
    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>

    <RelatedTools locale={locale} tools={['authoritarian','narcissism','mbti','enneagram']} current="political" />
