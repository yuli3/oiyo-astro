---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import MenuRoulette from '../../../components/tools/MenuRoulette';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<string, { title: string; description: string }> = {
  ko: {
    title: '월급날 메뉴 룰렛 — 점심·저녁 뭐 먹지? 메뉴 추천 룰렛',
    description: '오늘 뭐 먹을지 고민될 때 돌리는 메뉴 추천 룰렛. 한식·중식·일식·양식·분식·카페별로 랜덤 추천 + 월급날 작은 사치 아이디어까지.',
  },
  en: {
    title: 'Payday Menu Roulette — What to Eat? Random Meal Picker',
    description: "Can't decide what to eat? Spin the menu roulette for a random meal by cuisine — Korean, Chinese, Japanese, Western, snacks, cafe — plus a small payday treat idea.",
  },
  ja: {
    title: '給料日メニュールーレット — 何食べる？メニュー推薦ルーレット',
    description: '今日何を食べるか迷ったら回すメニュー推薦ルーレット。和食・中華・洋食などからランダム推薦＋給料日のちょっとした贅沢アイデアも。',
  },
};
const m = meta[locale] ?? meta.en;

const content: Record<string, {
  introTitle: string;
  intro: string;
  relatedTitle: string;
  related: { href: string; label: string; desc: string }[];
  disclaimer: string;
}> = {
  ko: {
    introTitle: '결정 피로, 룰렛에 맡기세요',
    intro: '하루에도 몇 번씩 "뭐 먹지?"로 시간을 씁니다. 사소한 결정에 에너지를 쓰지 말고, 룰렛에 맡기고 오늘 한 끼를 가볍게 즐겨보세요. 월급날엔 작은 사치 한 가지도 함께.',
    relatedTitle: '함께 하면 좋은 것',
    related: [
      { href: '/strengths/keywords', label: '강점 키워드 찾기', desc: '나를 알아가는 단어 도구.' },
      { href: '/journal/today', label: '오늘의 저널', desc: '하루 한 줄로 마음 정리.' },
      { href: '/today', label: '오늘의 우주', desc: '오늘의 나를 위한 한 장.' },
    ],
    disclaimer: '재미로 즐기는 추천 도구입니다. 알레르기·식이 제한은 직접 확인하세요.',
  },
  en: {
    introTitle: 'Decision fatigue? Let the roulette decide',
    intro: 'We spend energy several times a day on “what should I eat?” Don’t burn willpower on small choices — let the roulette pick and enjoy today’s meal lightly. On payday, add one small treat.',
    relatedTitle: 'Pairs well with',
    related: [
      { href: '/strengths/keywords', label: 'Strength Keywords', desc: 'A word tool to know yourself.' },
      { href: '/journal/today', label: "Today's Journal", desc: 'Settle your mind in a line a day.' },
      { href: '/today', label: 'Daily Universe', desc: 'A page for today’s you.' },
    ],
    disclaimer: 'A for-fun recommendation tool. Check allergies and dietary needs yourself.',
  },
};
const c = content[locale] ?? content.en;
const localizedRelated = c.related.map((item) => ({ ...item, href: `/${locale}${item.href}` }));
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <MenuRoulette locale={locale} client:load />

    <section class="mt-10 border-t border-green-100 pt-8">
      <h2 class="text-2xl font-bold text-green-950">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-green-800">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-green-950">{c.relatedTitle}</h2>
      <div class="mt-4 grid gap-3 md:grid-cols-3">
        {localizedRelated.map((item) => (
          <a class="rounded-xl border border-green-100 bg-white p-4 transition-colors hover:border-green-300 hover:bg-green-50" href={item.href}>
            <span class="font-semibold text-green-950">{item.label}</span>
            <span class="mt-2 block text-sm leading-6 text-green-700">{item.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">
      {c.disclaimer}
    </p>
  </div>
</Layout>
