---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import LoveLanguageTest from '../../../components/tests/LoveLanguageTest';
import RelatedTools from '../../../components/shared/RelatedTools.astro';
import { buildQuizJsonLd } from '../../../lib/seo/quiz-json-ld';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '사랑의 언어 테스트 — 나의 사랑 표현 방식은?', description: '5가지 사랑의 언어(인정의 말·함께하는 시간·선물·봉사·스킨십) 중 나의 주요 유형을 알아보세요.' },
  en: { title: 'Love Language Test — How Do You Express Love?', description: 'Discover your primary love language from the 5 types: words of affirmation, quality time, gifts, acts of service, and touch.' },
  ja: { title: '愛の言語テスト — あなたの愛の表現方法は？', description: '言葉・時間・贈り物・奉仕・スキンシップの5つの愛の言語から、あなたの主要タイプを発見しましょう。' },
  zh: { title: '爱的语言测试 — 你如何表达爱？', description: '从5种爱的语言（肯定言辞、优质时光、礼物、服务行为、肢体接触）中了解你的主要类型。' },
  fr: { title: "Test des Langages de l'Amour — Comment exprimez-vous l'amour?", description: "Découvrez votre langage amoureux principal parmi les 5 types : mots d'affirmation, temps de qualité, cadeaux, actes de service et toucher." },
  es: { title: 'Test de los Lenguajes del Amor — ¿Cómo expresas el amor?', description: 'Descubre tu lenguaje del amor principal entre los 5 tipos: palabras de afirmación, tiempo de calidad, regalos, actos de servicio y toque físico.' },
};
const m = meta[locale] ?? meta.en;

const content: Record<Locale, { introTitle: string; intro: string; conceptTitle: string; concepts: { title: string; body: string }[]; faqTitle: string; faqs: { question: string; answer: string }[]; disclaimer: string; }> = {
  ko: { introTitle: '사랑의 언어는 사람을 단정하는 라벨이 아니라 애정을 주고받는 방식을 보는 렌즈입니다', intro: '사랑의 언어 테스트는 인정의 말, 함께하는 시간, 선물, 봉사, 스킨십 중 어떤 표현이 더 크게 와닿는지 살펴봅니다. 결과는 관계를 단순화하는 이름표가 아니라 서로의 신호를 번역하는 대화의 출발점입니다.', conceptTitle: '사랑의 언어를 읽는 세 가지 관점', concepts: [{ title: '표현 언어', body: '내가 자연스럽게 주는 애정 방식과 받고 싶은 방식은 다를 수 있습니다.' }, { title: '관계 맥락', body: '연인, 가족, 친구 관계마다 중요하게 느끼는 표현이 달라질 수 있습니다.' }, { title: '대화의 번역', body: '결과는 상대를 바꾸기보다 서로의 신호를 번역하는 데 도움이 됩니다.' }], faqTitle: '자주 묻는 질문', faqs: [{ question: '사랑의 언어 결과는 얼마나 정확한가요?', answer: '현재 답변에 나타난 선호를 요약한 참고 자료입니다. 관계의 종류와 시기에 따라 달라질 수 있으니 절대적 라벨로 보지 마세요.' }, { question: '주고 싶은 방식과 받고 싶은 방식이 다를 수 있나요?', answer: '네. 내가 익숙하게 표현하는 방식과 실제로 안정감을 느끼는 방식은 다를 수 있습니다.' }, { question: '결과를 어떻게 활용하면 좋나요?', answer: '상대에게 요구를 강요하기보다 서로 어떤 표현을 더 잘 알아차리는지 묻는 대화로 사용해 보세요.' }], disclaimer: '사랑의 언어 결과는 자기 이해와 대화를 위한 참고입니다. 진단, 채용, 관계의 단정적 판단 근거로 사용하지 마세요.' },
  en: { introTitle: 'Love language is a lens for giving and receiving affection, not a label that defines you', intro: 'The love language test looks at which expressions feel most meaningful among words, time, gifts, service, and touch. The result is not a shortcut for simplifying relationships; it is a conversation starter for translating signals.', conceptTitle: 'Three ways to read love language', concepts: [{ title: 'Expression language', body: 'The way you naturally give affection may differ from the way you prefer to receive it.' }, { title: 'Relationship context', body: 'Partners, family, and friends can bring out different needs.' }, { title: 'Translation for dialogue', body: 'The result helps translate signals between people rather than forcing anyone to change.' }], faqTitle: 'Frequently asked questions', faqs: [{ question: 'How accurate is the love language result?', answer: 'It summarizes preferences shown in your current answers. Relationship type and timing can shift the result, so avoid treating it as an absolute label.' }, { question: 'Can giving and receiving styles differ?', answer: 'Yes. The way you habitually express affection may differ from the way you actually feel reassured.' }, { question: 'How should I use the result?', answer: 'Use it to ask which expressions each person notices most, rather than to demand a fixed script from someone.' }], disclaimer: 'Love language results are for self-understanding and conversation. Do not use them as a basis for diagnosis, hiring, or definitive relationship judgments.' },
  ja: { introTitle: '愛の言語は人を決めつけるラベルではなく、愛情を伝え受け取る方法を見るレンズです', intro: '愛の言語テストは言葉、時間、贈り物、行動、スキンシップの中でどの表現が響きやすいかを見ます。結果は関係を単純化する名前ではなく、互いのサインを翻訳する対話の出発点です。', conceptTitle: '愛の言語を読む三つの視点', concepts: [{ title: '表現の言語', body: '自然に与える愛情表現と、受け取りたい表現は違うことがあります。' }, { title: '関係の文脈', body: '恋人、家族、友人によって大切に感じる表現は変わります。' }, { title: '対話の翻訳', body: '結果は相手を変えるためではなく、互いのサインを翻訳するために役立ちます。' }], faqTitle: 'よくある質問', faqs: [{ question: '愛の言語の結果はどれくらい正確ですか？', answer: '現在の回答に表れた好みの要約です。関係の種類や時期で変わるため、絶対的なラベルとして扱わないでください。' }, { question: '与える方法と受け取りたい方法は違いますか？', answer: '違うことがあります。慣れている表現と、実際に安心を感じる表現は同じとは限りません。' }, { question: '結果はどう使えばよいですか？', answer: '相手に型を求めるより、どの表現に気づきやすいかを話し合うきっかけにしてください。' }], disclaimer: '愛の言語の結果は自己理解と対話のための参考です。診断、採用、人間関係の断定的な判断材料には使わないでください。' },
  zh: { introTitle: '爱的语言是观察表达与接收爱意的镜片，不是定义人的标签', intro: '爱的语言测试观察肯定言辞、相处时间、礼物、服务行为和肢体接触中哪些表达更有意义。结果不是简化关系的标签，而是翻译彼此信号的对话起点。', conceptTitle: '理解爱的语言的三个角度', concepts: [{ title: '表达语言', body: '你自然付出的爱意方式，可能和你希望接收的方式不同。' }, { title: '关系情境', body: '伴侣、家人和朋友之间，重要的表达可能不同。' }, { title: '对话翻译', body: '结果的作用不是改变对方，而是帮助彼此翻译信号。' }], faqTitle: '常见问题', faqs: [{ question: '爱的语言结果有多准确？', answer: '它概括的是当前回答中的偏好。关系类型和阶段会影响结果，因此不要把它当作绝对标签。' }, { question: '付出方式和接收方式会不同吗？', answer: '会。你习惯表达爱意的方式，可能不同于真正让你安心的方式。' }, { question: '应该如何使用结果？', answer: '与其要求对方照做，不如用它来讨论彼此更容易注意到哪些表达。' }], disclaimer: '爱的语言结果仅用于自我理解与对话，请勿作为诊断、招聘或关系定论的依据。' },
  fr: { introTitle: 'Le langage de l’amour est une lentille pour donner et recevoir l’affection, pas une étiquette qui vous définit', intro: 'Le test des langages de l’amour observe les expressions les plus parlantes entre mots, temps, cadeaux, services et toucher. Le résultat n’est pas un raccourci pour simplifier la relation, mais un départ pour traduire les signaux.', conceptTitle: 'Trois façons de lire les langages de l’amour', concepts: [{ title: 'Langage d’expression', body: 'Votre façon de donner l’affection peut différer de celle que vous aimez recevoir.' }, { title: 'Contexte relationnel', body: 'Partenaire, famille et amis peuvent faire ressortir des besoins différents.' }, { title: 'Traduction du dialogue', body: 'Le résultat aide à traduire les signaux sans chercher à changer l’autre.' }], faqTitle: 'Questions fréquentes', faqs: [{ question: 'Le résultat est-il fiable ?', answer: 'Il résume les préférences visibles dans vos réponses du moment. Le type de relation et la période peuvent le modifier; ne le prenez pas comme étiquette absolue.' }, { question: 'Donner et recevoir peuvent-ils différer ?', answer: 'Oui. La façon habituelle d’exprimer l’affection peut différer de celle qui rassure vraiment.' }, { question: 'Comment utiliser le résultat ?', answer: 'Servez-vous-en pour demander quelles expressions chacun remarque le mieux, pas pour imposer un scénario.' }], disclaimer: 'Les résultats des langages de l’amour servent à la compréhension de soi et au dialogue. Ne les utilisez pas comme base de diagnostic, de recrutement ou de verdict relationnel.' },
  es: { introTitle: 'El lenguaje del amor es una lente para dar y recibir afecto, no una etiqueta que te define', intro: 'El test de los lenguajes del amor observa qué expresiones pesan más entre palabras, tiempo, regalos, servicio y contacto. El resultado no simplifica la relación; ayuda a traducir señales y abrir conversación.', conceptTitle: 'Tres formas de leer los lenguajes del amor', concepts: [{ title: 'Lenguaje de expresión', body: 'La forma en que das afecto puede diferir de la forma en que prefieres recibirlo.' }, { title: 'Contexto relacional', body: 'Pareja, familia y amistades pueden activar necesidades distintas.' }, { title: 'Traducción del diálogo', body: 'El resultado ayuda a traducir señales entre personas sin imponer cambios.' }], faqTitle: 'Preguntas frecuentes', faqs: [{ question: '¿Qué tan preciso es el resultado?', answer: 'Resume preferencias que aparecen en tus respuestas actuales. El tipo de relación y el momento pueden cambiarlo; no lo trates como etiqueta absoluta.' }, { question: '¿Pueden diferir dar y recibir?', answer: 'Sí. La forma habitual de expresar afecto puede diferir de la que realmente te da seguridad.' }, { question: '¿Cómo usar el resultado?', answer: 'Úsalo para preguntar qué expresiones nota mejor cada persona, no para imponer un guion fijo.' }], disclaimer: 'Los resultados de lenguajes del amor son para autoconocimiento y conversación. No los uses como base para diagnóstico, contratación o juicios definitivos sobre relaciones.' },
};

const c = content[locale] ?? content.en;
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
const quizJsonLd = buildQuizJsonLd({
  name: m.title,
  description: m.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  inLanguage: locale,
  questions: [],
});

---
<Layout title={m.title} description={m.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(quizJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="mx-auto max-w-2xl px-4 py-10">
    <LoveLanguageTest client:load locale={locale} />
    <section class="mt-10 border-t border-violet-100 pt-8"><h2 class="text-2xl font-bold text-violet-950">{c.introTitle}</h2><p class="mt-4 leading-8 text-violet-800">{c.intro}</p></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.conceptTitle}</h2><div class="mt-4 grid gap-4 md:grid-cols-3">{c.concepts.map((item) => (<article class="rounded-xl border border-violet-100 bg-white p-4"><h3 class="font-semibold text-violet-950">{item.title}</h3><p class="mt-2 text-sm leading-6 text-violet-700">{item.body}</p></article>))}</div></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.faqTitle}</h2><div class="mt-4 divide-y divide-violet-100 rounded-xl border border-violet-100 bg-white">{c.faqs.map((faq) => (<details class="group p-4"><summary class="cursor-pointer list-none font-semibold text-violet-950">{faq.question}</summary><p class="mt-3 text-sm leading-6 text-violet-700">{faq.answer}</p></details>))}</div></section>
    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>
    <RelatedTools locale={locale} tools={['attachment', 'mbti', 'enneagram']} current="loveLanguage" />
  </div>
</Layout>
