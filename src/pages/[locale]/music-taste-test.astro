---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import FiveStyleTest from '../../components/tests/FiveStyleTest';
import { MUSIC_COPY, MUSIC_EN_NAMES, MUSIC_SPEC } from '../../data/five-style/music-taste';
import TestSourceNote from '../../components/shared/TestSourceNote.astro';
import { TEST_SOURCE_NOTES } from '../../data/test-source-notes';
import RelatedTools from '../../components/shared/RelatedTools.astro';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '음악 취향 검사 — 나는 어떤 결의 소리에 손이 가나', description: '열두 가지 듣는 장면으로 부드러운·담백한·세련된·강렬한·리듬의 다섯 결 중 내 취향의 비율을 봐요. Rentfrow 등의 MUSIC 모형을 따랐어요.' },
  en: { title: 'Music taste test — the kind of sound you reach for', description: 'Twelve listening scenes show how your taste mixes five textures — Mellow, Unpretentious, Sophisticated, Intense and Contemporary — following the MUSIC model of Rentfrow and colleagues.' },
  ja: { title: '音楽の好み診断 — どんな質感の音に手が伸びるか', description: '十二の聴く場面から、やわらかな・素朴な・洗練された・激しい・リズムの五つの質感の割合を見ます。Rentfrow らの MUSIC モデルに沿っています。' },
  zh: { title: '音乐品味测验 — 你会伸手去拿哪种质感的声音', description: '用十二个听歌场景，看柔和、质朴、精致、激烈、律动五种质感在你品味里的比例。参照 Rentfrow 等人的 MUSIC 模型。' },
  fr: { title: 'Test des goûts musicaux — le grain de son vers lequel vous allez', description: 'Douze scènes d’écoute montrent comment vos goûts mêlent cinq grains — doux, simple, raffiné, intense et rythmique — selon le modèle MUSIC de Rentfrow et ses collègues.' },
  es: { title: 'Test de gustos musicales — la textura de sonido hacia la que vas', description: 'Doce escenas de escucha muestran cómo se mezclan en tu gusto cinco texturas — suave, sencilla, sofisticada, intensa y rítmica — según el modelo MUSIC de Rentfrow y sus colegas.' },
};
const m = meta[locale] ?? meta.en;

const intro: Record<Locale, { title: string; body: string }> = {
  ko: { title: '장르보다 먼저, 소리의 결이 있어요', body: '같은 록을 좋아해도 누군가는 소리의 세기에, 누군가는 가사의 진솔함에 끌려요. 음악 심리학 연구는 사람들의 취향이 장르 이름보다 몇 개의 결 — 부드러움, 담백함, 세련됨, 강렬함, 리듬 — 로 더 잘 묶인다고 봐요. 이 검사는 듣는 장면에서 고른 것을 모아 그 다섯 결의 비율을 보여 드려요.' },
  en: { title: 'Before genre, there is texture', body: 'Two people can both love rock — one for its force, the other for the honesty of the lyrics. Research in music psychology finds that taste groups more neatly into a few textures — mellow, unpretentious, sophisticated, intense, contemporary — than into genre names. This test gathers what you choose in everyday listening scenes and shows the proportions of those five.' },
  ja: { title: 'ジャンルより先に、音の質感があります', body: '同じロック好きでも、音の強さに惹かれる人もいれば、歌詞の率直さに惹かれる人もいます。音楽心理学の研究では、好みはジャンル名よりも、やわらかさ・素朴さ・洗練・激しさ・リズムといったいくつかの質感でまとまりやすいとされます。この診断は、聴く場面で選んだものを集めて五つの割合を示します。' },
  zh: { title: '比曲风更早的，是声音的质感', body: '同样喜欢摇滚，有人被力量吸引，有人被歌词的真诚打动。音乐心理学研究认为，人的品味用几种质感——柔和、质朴、精致、激烈、律动——来归类，比用曲风名称更准确。这个测验汇总你在听歌场景中的选择，展示这五种质感的比例。' },
  fr: { title: 'Avant le genre, il y a le grain', body: 'Deux personnes peuvent aimer le rock, l’une pour sa puissance, l’autre pour la sincérité des paroles. La psychologie de la musique montre que les goûts se regroupent mieux en quelques grains — doux, simple, raffiné, intense, rythmique — qu’en noms de genres. Ce test rassemble vos choix dans des scènes d’écoute du quotidien et montre la part de chacun des cinq.' },
  es: { title: 'Antes del género, está la textura', body: 'Dos personas pueden amar el rock, una por su fuerza y otra por la sinceridad de la letra. La psicología de la música encuentra que el gusto se agrupa mejor en unas pocas texturas — suave, sencilla, sofisticada, intensa y rítmica — que en nombres de géneros. Este test reúne lo que eliges en escenas cotidianas de escucha y muestra la proporción de esas cinco.' },
};
const c = intro[locale] ?? intro.en;
---
<Layout title={m.title} description={m.description} locale={locale}>
  <div class="mx-auto max-w-2xl px-4 py-10">
    <FiveStyleTest client:load locale={locale} spec={MUSIC_SPEC} copy={MUSIC_COPY[locale] ?? MUSIC_COPY.en} englishNames={MUSIC_EN_NAMES} />
    <section class="mt-10 border-t border-border pt-8">
      <h2 class="text-xl font-bold text-foreground">{c.title}</h2>
      <p class="mt-3 leading-8 text-muted-foreground [word-break:keep-all]">{c.body}</p>
    </section>
    <TestSourceNote locale={locale} note={TEST_SOURCE_NOTES['music-taste-test']} />
    <RelatedTools locale={locale} tools={['mbti', 'big5', 'personalColor']} current="music-taste-test" />
  </div>
</Layout>
