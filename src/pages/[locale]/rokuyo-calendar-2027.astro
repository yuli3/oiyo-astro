---
/**
 * 2027年カレンダー 六曜・祝日・天赦日 (ja). 日本の祝日・六曜なので ja のみ.
 * 値はすべてビルド時に lib/jp-calendar-2027.ts で計算. 次の作業 3次 #2 (2026-11-22).
 */
import Layout from '../../layouts/Layout.astro';
import { localePath, type Locale } from '../../i18n';
import { jpHolidays, jpMonthGrid, tenshabi } from '../../lib/jp-calendar-2027';

export function getStaticPaths() {
  return [{ params: { locale: 'ja' } }];
}

const { locale } = Astro.params as { locale: Locale };
const WD = ['日', '月', '火', '水', '木', '金', '土'];
const hs = jpHolidays();
const months = Array.from({ length: 12 }, (_, i) => ({ month: i + 1, cells: jpMonthGrid(i + 1) }));
const all = months.flatMap((m) => m.cells.filter((c): c is NonNullable<typeof c> => c !== null));
const taian = all.filter((c) => c.rokuyo === '大安');
const taianWeekend = taian.filter((c) => c.dow === 0 || c.dow === 6 || c.holiday);
const tensha = tenshabi();
const md = (d: string) => {
  const [, m, day] = d.split('-').map(Number);
  return `${m}月${day}日(${WD[new Date(`${d}T00:00:00Z`).getUTCDay()]})`;
};
const rokuyoOf = (d: string) => all.find((c) => c.date === d)?.rokuyo ?? '';
const offWeekdays = hs.filter((h) => {
  const w = new Date(`${h.date}T00:00:00Z`).getUTCDay();
  return w !== 0 && w !== 6;
}).length;

const title = '2027年カレンダー 六曜・祝日・天赦日 — 大安の土日祝が一目でわかる';
const description = `2027年の祝日・振替休日は${hs.length}日(平日${offWeekdays}日)。大安は${taian.length}日、そのうち土日祝は${taianWeekend.length}日。天赦日${tensha.length}日と六曜を月別カレンダーにまとめ、結婚式・入籍・引っ越しの日取り選びに使えます。印刷もできます。`;

const faqs = [
  { q: '2027年の祝日は何日ありますか？', a: `振替休日を含めて${hs.length}日で、土日以外の平日は${offWeekdays}日です。春分の日(3月21日)が日曜日なので3月22日が振替休日になります。` },
  { q: '六曜はどう決まりますか？', a: '旧暦の(月＋日)を6で割った余りで、0が大安、1が赤口、2が先勝、3が友引、4が先負、5が仏滅です。旧暦の毎月1日は月ごとに決まった六曜から始まるので、新暦で見ると順番が途中で飛ぶ日があります。' },
  { q: '2027年の大安の土日祝はいつですか？', a: `${taianWeekend.length}日あります。${taianWeekend.slice(0, 6).map((c) => md(c.date)).join('、')}など。結婚式場の予約は早めに埋まります。` },
  { q: '天赦日とは？', a: `天が万物の罪を赦すとされる日で、暦の上で最上の吉日とされます。立春〜立夏前の戊寅、立夏〜立秋前の甲午、立秋〜立冬前の戊申、立冬〜立春前の甲子の日です。2027年は${tensha.map((d) => md(d)).join('、')}。` },
  { q: '旧暦はどう計算していますか？', a: '天文計算で朔(新月)と中気を求め、国立天文台の暦と同じ原理(定気法)で決めています。大切な日取りはお手元の暦でも確認してください。' },
];
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Layout title={title} description={description} locale={locale} availableLocales={['ja']}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <section class="mx-auto max-w-4xl px-4 py-10 print:max-w-none print:p-0" data-print-page>
    <div class="print:hidden">
      <p class="text-xs font-black tracking-widest text-primary">2027年 · 令和9年</p>
      <h1 class="mt-3 text-3xl font-black tracking-tight">2027年カレンダー 六曜・祝日</h1>
      <p class="mt-3 text-base leading-relaxed text-muted-foreground">祝日・振替休日、毎日の六曜、天赦日を月ごとにまとめました。大安の土日祝もすぐ探せます。印刷ボタンでカレンダーだけ印刷できます。</p>

      <div class="mt-6 grid gap-3 sm:grid-cols-3">
        <div class="rounded-2xl border bg-card p-4"><p class="text-xs text-muted-foreground">祝日・振替休日</p><p class="mt-1 text-2xl font-black">{hs.length}日</p></div>
        <div class="rounded-2xl border bg-card p-4"><p class="text-xs text-muted-foreground">大安</p><p class="mt-1 text-2xl font-black">{taian.length}日</p></div>
        <div class="rounded-2xl border bg-card p-4"><p class="text-xs text-muted-foreground">大安の土日祝</p><p class="mt-1 text-2xl font-black">{taianWeekend.length}日</p></div>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <button type="button" class="min-h-11 rounded-xl bg-primary px-4 text-sm font-black text-primary-foreground" data-print>🖨️ カレンダーを印刷</button>
        <p class="text-xs text-muted-foreground"><span class="font-black text-destructive">赤</span> 日曜・祝日 · <span class="font-black text-primary">大安</span> は太字 · ★ 天赦日</p>
      </div>
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-2 print:grid-cols-3 print:gap-3">
      {months.map(({ month, cells }) => (
        <section class="rounded-2xl border bg-card p-3 print:break-inside-avoid" aria-label={`2027年${month}月`}>
          <h2 class="px-1 text-lg font-black">{month}月</h2>
          <table class="mt-2 w-full table-fixed text-center">
            <caption class="sr-only">{`2027年${month}月のカレンダー`}</caption>
            <thead>
              <tr>{WD.map((w, i) => <th scope="col" class={`pb-1 text-xs font-bold ${i === 0 ? 'text-destructive' : 'text-muted-foreground'}`}>{w}</th>)}</tr>
            </thead>
            <tbody>
              {Array.from({ length: cells.length / 7 }, (_, r) => (
                <tr>
                  {cells.slice(r * 7, r * 7 + 7).map((c) =>
                    c ? (
                      <td class="h-14 border-t align-top" title={[c.holiday, c.rokuyo, c.tensha ? '天赦日' : null].filter(Boolean).join(' · ')}>
                        <div class={`text-sm font-black ${c.holiday || c.dow === 0 ? 'text-destructive' : 'text-foreground'}`}>{c.day}{c.tensha && <span class="text-primary">★</span>}</div>
                        <div class={`text-xs leading-tight ${c.rokuyo === '大安' ? 'font-black text-primary' : 'text-muted-foreground'}`}>{c.rokuyo}</div>
                        {c.holiday && <div class="truncate text-xs font-bold leading-tight text-destructive">{c.holiday}</div>}
                      </td>
                    ) : (
                      <td class="h-14 border-t" />
                    ),
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      ))}
    </div>

    <div class="print:hidden">
      <section class="mt-12">
        <h2 class="text-2xl font-black">2027年の祝日一覧</h2>
        <div class="mt-4 overflow-x-auto rounded-xl border">
          <table class="w-full text-sm">
            <caption class="sr-only">2027年の祝日と振替休日</caption>
            <thead class="bg-muted text-left"><tr><th class="p-3" scope="col">日付</th><th class="p-3" scope="col">祝日</th><th class="p-3" scope="col">六曜</th></tr></thead>
            <tbody class="divide-y">
              {hs.map((h) => (
                <tr>
                  <td class="p-3 font-bold tabular-nums">{md(h.date)}</td>
                  <td class={`p-3 ${h.kind !== 'holiday' ? 'font-black text-destructive' : ''}`}>{h.name}</td>
                  <td class="p-3 text-muted-foreground">{rokuyoOf(h.date)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="mt-10">
        <h2 class="text-2xl font-black">大安の土日祝 {taianWeekend.length}日</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">結婚式・顔合わせ・入籍で人気の日です。</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {taianWeekend.map((c) => <li class="rounded-xl border bg-card px-3 py-2 text-sm font-bold tabular-nums">{md(c.date)}{c.holiday ? ` ${c.holiday}` : ''}{c.tensha ? ' ★天赦日' : ''}</li>)}
        </ul>
      </section>

      <section class="mt-10">
        <h2 class="text-2xl font-black">2027年の天赦日</h2>
        <ul class="mt-4 grid gap-2 sm:grid-cols-3">
          {tensha.map((d) => <li class="rounded-xl border bg-card p-3 text-sm"><strong class="tabular-nums">{md(d)}</strong> <span class="text-muted-foreground">{rokuyoOf(d)}</span></li>)}
        </ul>
      </section>

      <section class="mt-10">
        <h2 class="text-2xl font-black">よくある質問</h2>
        <div class="mt-4 divide-y rounded-xl border bg-card">
          {faqs.map((f) => (
            <details class="group p-4"><summary class="cursor-pointer text-sm font-black">{f.q}</summary><p class="mt-2 text-sm leading-relaxed text-muted-foreground">{f.a}</p></details>
          ))}
        </div>
      </section>

      <p class="mt-8 text-xs leading-5 text-muted-foreground">祝日は「国民の祝日に関する法律」に基づく計算です。春分・秋分の日は天文計算値で、正式には前年2月の官報で発表されます。六曜・天赦日は暦注で、科学的な根拠はありません。</p>

      <nav class="mt-10 grid gap-3 sm:grid-cols-2" aria-label="あわせて見る">
        <a href={localePath(locale, '/sunrise-2027')} class="rounded-xl border bg-card p-4 text-sm font-black transition hover:border-primary">☀️ 2027年 初日の出の時刻</a>
        <a href={localePath(locale, '/oshogatsu-2027')} class="rounded-xl border bg-card p-4 text-sm font-black transition hover:border-primary">🎍 2027年 お正月</a>
        <a href={localePath(locale, '/setsubun-2027')} class="rounded-xl border bg-card p-4 text-sm font-black transition hover:border-primary">👹 2027年 節分</a>
        <a href={localePath(locale, '/mandalart-2027')} class="rounded-xl border bg-card p-4 text-sm font-black transition hover:border-primary">🎯 2027 マンダラチャート</a>
      </nav>
    </div>
  </section>
</Layout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
