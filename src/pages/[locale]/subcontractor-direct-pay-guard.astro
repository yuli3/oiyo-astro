---
import Layout from "../../layouts/Layout.astro";
import { LOCALES } from "../../i18n";
import type { Locale } from "../../i18n";
import { SubcontractorDirectPayGuard } from "../../components/tools/SubcontractorDirectPayGuard";

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "하도급 대금 직접지급 청구 자격 판정기 | OIYO Tools",
    description: "대한민국 하도급법 제14조 법정 4대 사유(부도·3자합의·2회연체·지급보증미이행) 기준 발주자 직접 청구 자격과 대항력을 진단합니다.",
  },
  en: {
    title: "Subcontractor Direct Payment Eligibility Guard | OIYO Tools",
    description: "Audit subcontractor direct payment rights against project owners under Art. 14 of the Korean Subcontracting Act.",
  },
  ja: {
    title: "下請代金直接支払請求資格判定機 | OIYO Tools",
    description: "韓国下請法第14条の法定4工事事由（不渡り・3者合意・2回延滞・支払保証不履行）に基づき、発注者への直接請求資格を判定。",
  },
  zh: {
    title: "转包工程款直接支付索赔资格诊断器 | OIYO Tools",
    description: "依据韩国转包法第14条法定4项事由（破产、三方协议、延期2次以上、未履约担保），测算向发包人直接索赔工程款资格。",
  },
  fr: {
    title: "Contrôleur de paiement direct des sous-traitants | OIYO Tools",
    description: "Évaluez l'éligibilité légale au paiement direct auprès des maîtres d'ouvrage selon la loi coréenne sur la sous-traitance.",
  },
  es: {
    title: "Verificador de pago directo a subcontratistas | OIYO Tools",
    description: "Verifique la elegibilidad legal para exigir pagos directos al propietario del proyecto bajo la Ley de Subcontratación de Corea.",
  },
};

const currentMeta = meta[locale] ?? meta.ko;
---

<Layout title={currentMeta.title} description={currentMeta.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 space-y-8">
    <div class="text-center space-y-2 max-w-2xl mx-auto">
      <h1 class="text-3xl font-extrabold tracking-tight">하도급 대금 직접지급 청구 가드</h1>
      <p class="text-muted-foreground text-sm">
        원사업자 부도·연체 시 하도급법 제14조 기준 발주자 직접지급 청구권 및 제3자 압류 대항력 진단
      </p>
    </div>

    <SubcontractorDirectPayGuard client:load locale={locale} />

    <div class="max-w-4xl mx-auto border rounded-xl p-6 bg-card border-border space-y-4">
      <h2 class="text-lg font-bold">하도급대금 직접지급 2대 핵심 법률 상식</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-muted-foreground leading-relaxed">
        <div class="space-y-1">
          <h3 class="font-semibold text-foreground">📬 도달주의와 신속한 통지</h3>
          <p>
            대법원 판례상 수급사업자의 직접지급 요청은 <strong>발주자에게 도달한 시점</strong>에 효력이 발생합니다. 구두나 전화 통보는 법적 효력이 없으므로 반드시 우체국 내용증명(배달증명)으로 확정일자를 확보해야 합니다.
          </p>
        </div>
        <div class="space-y-1">
          <h3 class="font-semibold text-foreground">⚖️ 제3자 가압류와의 선후 관계</h3>
          <p>
            원사업자의 다른 채권자가 발주자의 공사대금 채권을 가압류하기 전에 직접지급 요청서가 먼저 발주자에게 도달해야 <strong>100% 우선변제권</strong>을 갖습니다. 압류가 먼저 도달한 경우 법원 공탁 후 배당 절차로 넘어가 전액 회수가 어려워질 수 있습니다.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
