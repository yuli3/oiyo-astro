---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import HealthInsuranceLocalPropertyComponent from '../../components/tools/HealthInsuranceLocalProperty';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "지역가입자 부동산·전월세 건강보험료 계산기 — 2026 자동차 폐지·1억 공제",
    description: "국민건강보험법 시행령 개정(자동차 건보료 전면 폐지 0원, 재산 기본공제 1억원 일괄 확대)을 반영하여 은퇴자·퇴사자 지역가입자의 자가 주택 및 전월세 재산 건강보험료를 실시간 계산합니다.",
  },
  en: {
    title: "Korea Local Health Insurance Property Tax Calculator — 100M Deduction & Auto Tax Repeal",
    description: "Calculate local health insurance property taxes in Korea reflecting the 100M KRW basic deduction, auto health insurance abolition, and 30% Jeonse deposit evaluation rules.",
  },
  ja: {
    title: "韓国 地域加入者 不動産・伝貰家賃 健康保険料計算機 — 自動車廃止＆1億控除",
    description: "国民健康保険法改正(自動車保険料の全廃・財産基本控除1億ウォン一括拡大)を反映し、退職者・地域加入者の自己住宅およびチョンセ財産健康保険料を即時計算します。",
  },
  zh: {
    title: "韩国地域参保人房产与全租房健康保险费计算器 — 汽车彻底免征与1亿抵扣",
    description: "测算韩国国民健康保险法最新修订(汽车健保费彻底免除、财产基本抵扣额一律扩大至1亿韩元)退休人员与个体户自住房及全租房财产健保费。",
  },
  fr: {
    title: "Assurance Maladie Coréenne Régime Local — Barème Immobilier et Abattement",
    description: "Calculez la cotisation d'assurance maladie pour les résidents locaux en Corée avec l'abattement de 100M KRW et la suppression de la taxe sur les véhicules.",
  },
  es: {
    title: "Calculadora de Seguro de Salud Local por Propiedad en Corea — Exención de 100M",
    description: "Calcula las cuotas del seguro de salud local en Corea considerando la deducción de 100M KRW sobre inmuebles y la derogación total del gravamen sobre vehículos.",
  },
};

const currentMeta = meta[locale] ?? meta.ko;
---

<Layout
  title={currentMeta.title}
  description={currentMeta.description}
  locale={locale}
>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto mb-8 text-center">
      <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary mb-3">
        <span>{locale === 'ko' ? '국민건강보험법 2026' : 'National Health Insurance Act 2026'}</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl text-foreground">
        {currentMeta.title.split('—')[0]}
      </h1>
      <p class="mt-3 text-base text-muted-foreground sm:text-lg">
        {currentMeta.description}
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <HealthInsuranceLocalPropertyComponent client:load locale={locale} />
    </div>

    {/* Hub-and-Spoke Context / FAQ */}
    <section class="max-w-4xl mx-auto mt-8 rounded-xl border border-border bg-card p-6 space-y-4 text-sm text-muted-foreground">
      <h2 class="text-lg font-bold text-foreground">
        {locale === 'ko' ? '자주 묻는 지역가입자 건강보험료 Q&A' : 'Frequently Asked Questions'}
      </h2>

      <div class="space-y-3">
        <div>
          <h3 class="font-semibold text-foreground">
            {locale === 'ko' ? 'Q1. 고가 외제차나 제네시스를 가지고 있으면 건보료가 많이 나오나요?' : 'Q1. Do luxury cars increase my local health insurance premiums?'}
          </h3>
          <p class="mt-1">
            {locale === 'ko'
              ? '아닙니다. 2024년 2월 국민건강보험법 시행령 개정으로 자동차에 부과되던 건강보험료가 전면 폐지되었습니다. 차량 가격이나 배기량, 수입차 여부와 관계없이 모든 자동차의 건보료 점수는 0점(0원)입니다.'
              : 'No. The automobile component of Korean local health insurance was repealed in February 2024. All vehicles incur 0 points regardless of value or engine size.'}
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-foreground">
            {locale === 'ko' ? 'Q2. 전세 3억원에 살고 있는데 재산 건보료가 왜 0원인가요?' : 'Q2. Why is my property health tax 0 KRW for a 300M KRW Jeonse?'}
          </h3>
          <p class="mt-1">
            {locale === 'ko'
              ? '건강보험공단은 전월세 보증금의 30%만 재산으로 평가합니다. 3억원의 30%는 9,000만원이며, 법정 기본공제 1억원을 차감하면 과세표준이 0원이 되기 때문에 재산에 대한 건강보험료가 전액 면제됩니다.'
              : 'The National Health Insurance Service only evaluates 30% of rental deposits. 30% of 300M is 90M KRW, which is below the 100M KRW statutory basic deduction, resulting in zero property tax.'}
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-foreground">
            {locale === 'ko' ? 'Q3. 직장을 퇴사했는데 지역 건보료가 너무 많이 나왔습니다. 방법이 없나요?' : 'Q3. What can I do if my local premium after leaving work is too expensive?'}
          </h3>
          <p class="mt-1">
            {locale === 'ko'
              ? '퇴사 후 지역 건강보험료가 직장에서 내던 본인부담금보다 비싸다면, 첫 고지서를 받은 날로부터 2개월 이내에 건강보험공단에 "임의계속가입"을 신청하세요. 최대 36개월간 종전 직장에서 내던 보험료 수준으로 동결하여 납부할 수 있습니다.'
              : 'Apply for "Voluntary Continuation" within 2 months of receiving your first local bill to lock in previous workplace payroll rates for up to 36 months.'}
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
