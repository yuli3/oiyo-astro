---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import DigitalBalanceTest from '../../components/tests/DigitalBalanceTest';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<string, { title: string; description: string }> = {
  ko: {
    title: "디지털 균형 테스트 — 스마트폰 사용 습관 점검",
    description: "스마트폰과 디지털 기기 사용 습관을 점검하고, 건강한 디지털 라이프를 위한 맞춤형 조언을 받아보세요.",
  },
  en: {
    title: "Digital Balance Test",
    description: "Assess your smartphone and digital device habits, and get personalized advice for a healthier digital lifestyle.",
  },
  ja: {
    title: "デジタルバランステスト — スマートフォン使用習慣チェック",
    description: "スマートフォンとデジタルデバイスの使用習慣をチェックし、健康的なデジタルライフのためのアドバイスを受けましょう。",
  },
  fr: {
    title: "Test d'Équilibre Numérique",
    description: "Évaluez vos habitudes d'utilisation des smartphones et appareils numériques, et obtenez des conseils personnalisés.",
  },
  es: {
    title: "Test de Equilibrio Digital",
    description: "Evalúa tus hábitos de uso del smartphone y dispositivos digitales, y obtén consejos personalizados para un estilo de vida digital más saludable.",
  },
  zh: {
    title: "数位均衡测试 — 智慧型手机使用习惯检测",
    description: "检测您的智慧型手机和数位设备使用习惯，获得健康数位生活的个性化建议。",
  },
};
const m = meta[locale] ?? meta.en ?? Object.values(meta)[0];
---

<Layout title={m.title} description={m.description} locale={locale}>
  <main class="container mx-auto px-4 py-8 max-w-3xl">
    <DigitalBalanceTest locale={locale as any} client:load />
  </main>
</Layout>
