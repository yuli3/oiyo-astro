    "conceptTitle": "Bases de compatibilité",
    "concepts": [
      {
        "title": "12 animaux",
        "body": "Rat, Bœuf, Tigre, Lapin, Dragon, Serpent, Cheval, Chèvre, Singe, Coq, Chien et Cochon."
      },
      {
        "title": "Lecture par année",
