---
// 육십갑자 해설. 본문은 explainers 컬렉션(src/content/explainers/<locale>/saju-60gapja.md).
// 표는 SIXTY_GANZHI 와 같은 순서에서 생성해 넣었다 — 계산기와 같은 데이터다.
import Layout from '../../../layouts/Layout.astro';
import ExplainerArticle from '../../../components/shared/ExplainerArticle.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const have = new Set(
    (await getCollection('explainers', (e) => e.data.topic === 'saju-60gapja')).map((e) => e.data.locale),
  );
  return LOCALES.filter((l) => have.has(l)).map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const entry = await getEntry('explainers', `${locale}/saju-60gapja`);
if (!entry) throw new Error(`explainers 항목 없음: ${locale}/saju-60gapja`);
---
<Layout title={entry.data.title} description={entry.data.description} locale={locale}>
  <ExplainerArticle entry={entry} locale={locale} testPath="/saju/calculator" ctaKind="saju" />
</Layout>
