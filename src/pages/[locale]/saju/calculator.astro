  es: {
    title: 'Calculadora Saju — Los Cuatro Pilares del Destino',
    description: 'Ingresa tu fecha y hora de nacimiento para analizar tus Tallos Celestiales, Ramas Terrestres y Cinco Elementos.',
  },
};

