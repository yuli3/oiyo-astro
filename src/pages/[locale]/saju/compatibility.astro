---
import Layout from '../../../layouts/Layout.astro';
import MysticTrinity from '../../../components/shared/MysticTrinity.astro';
import RelatedTools from '../../../components/shared/RelatedTools.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import SajuCompatibility from '../../../components/tools/SajuCompatibility';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: '사주 궁합 — 오행으로 보는 두 사람의 궁합',
    description: '두 사람의 생년을 입력하면 오행(목화토금수)의 상생·상극 관계로 궁합을 분석합니다. 연인·친구·가족 궁합을 확인해보세요.',
  },
  en: {
    title: 'Saju Compatibility — Five-Element Compatibility Analysis',
    description: 'Enter two birth years to analyze compatibility through the Five-Element generation and conquest cycles. Perfect for couples, friends, and family.',
  },
  ja: {
    title: '四柱相性診断 — 五行で見る二人の相性',
    description: '二人の生まれ年を入力すると、五行の相生・相克関係から相性を分析します。恋人・友人・家族の相性を確かめてみましょう。',
  },
  zh: {
    title: '四柱合婚 — 五行相生相克的相性分析',
    description: '输入两人的出生年份，通过五行相生相克关系分析二人相性。适用于情侣、朋友、家人的缘分分析。',
  },
  fr: {
    title: 'Compatibilité Saju — Analyse par les Cinq Éléments',
    description: "Entrez deux années de naissance pour analyser la compatibilité à travers les cycles de génération et de conquête des Cinq Éléments. Idéal pour les couples, amis et familles.",
  },
  es: {
    title: 'Compatibilidad Saju — Análisis por los Cinco Elementos',
    description: 'Ingresa dos años de nacimiento para analizar la compatibilidad mediante los ciclos de generación y conquista de los Cinco Elementos. Ideal para parejas, amigos y familias.',
  },
};

const m = meta[locale] ?? meta.en;
---

<Layout title={m.title} description={m.description} locale={locale}>
  <main class="mx-auto max-w-2xl px-4 py-10">
    <SajuCompatibility client:load locale={locale} />
    <RelatedTools locale={locale} tools={['zodiacCompat', 'saju', 'natal']} current="" />
      <MysticTrinity topic="saju" locale={locale} />
  </main>
</Layout>
