---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES, localePath, type Locale } from '../../../i18n';
import NewYearReportPreview from '../../../components/tools/NewYearReportPreview';
import { getNewYearReportCopy } from '../../../lib/fortune/new-year-report-copy';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const copy = getNewYearReportCopy(locale);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: copy.page.h1,
  url: canonicalUrl,
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Web',
  inLanguage: locale,
  description: copy.page.description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: copy.page.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<Layout title={copy.page.title} description={copy.page.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(webAppJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <section class="mx-auto max-w-3xl px-4 py-10">
    <p class="text-xs font-black uppercase tracking-widest text-primary">{copy.page.eyebrow}</p>
    <h1 class="mt-3 text-3xl font-black tracking-tight md:text-4xl">{copy.page.h1}</h1>
    <p class="mt-3 text-base leading-relaxed text-muted-foreground md:text-lg">{copy.page.sub}</p>

    <div class="mt-8">
      <NewYearReportPreview client:load locale={locale} />
    </div>

    <div class="mt-10 space-y-4">
      <h2 class="text-2xl font-black">{copy.page.aboutHeading}</h2>
      {copy.page.about.map((para) => <p class="leading-relaxed text-muted-foreground">{para}</p>)}
    </div>

    <section class="mt-10">
      <h2 class="text-2xl font-black">{copy.page.faqHeading}</h2>
      <div class="mt-4 divide-y rounded-xl border bg-card">
        {copy.page.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer text-sm font-black">{faq.question}</summary>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <nav class="mt-10 grid gap-4 md:grid-cols-2" aria-label="Saju">
      <a href={localePath(locale, '/saju/calculator')} class="rounded-xl border bg-card p-4 transition hover:border-primary">
        <span class="text-sm font-black">🀄 {locale === 'ko' ? '사주 계산기' : locale === 'ja' ? '四柱推命計算機' : locale === 'zh' ? '八字计算器' : locale === 'fr' ? 'Calculateur Saju' : locale === 'es' ? 'Calculadora Saju' : 'Saju calculator'}</span>
      </a>
      <a href={localePath(locale, '/saju/yearly')} class="rounded-xl border bg-card p-4 transition hover:border-primary">
        <span class="text-sm font-black">📅 {locale === 'ko' ? '올해의 사주 운세' : locale === 'ja' ? '今年の四柱推命運勢' : locale === 'zh' ? '今年八字运势' : locale === 'fr' ? 'Saju de l’année' : locale === 'es' ? 'Saju del año' : 'Saju fortune this year'}</span>
      </a>
    </nav>
  </section>
</Layout>
