---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import EmpathyTest from '../../../components/tests/EmpathyTest';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '공감 능력 테스트 — 나의 공감 지수는?', description: '인지적 공감·정서적 공감·공감 피로 세 가지 차원으로 나의 공감 능력을 측정해보세요.' },
  en: { title: 'Empathy Test — What Is Your Empathy Quotient?', description: 'Measure your empathy across cognitive empathy, emotional empathy, and compassion fatigue dimensions.' },
  ja: { title: '共感力テスト — あなたの共感指数は？', description: '認知的共感・感情的共感・共感疲労の3次元で自分の共感能力を測定しましょう。' },
  cn: { title: '共情能力测试 — 你的共情指数是多少？', description: '从认知共情、情感共情和同情疲劳三个维度测量你的共情能力。' },
  fr: { title: "Test d'Empathie — Quel est votre quotient empathique?", description: "Mesurez votre empathie selon les dimensions cognitives, émotionnelles et la fatigue compassionnelle." },
  es: { title: 'Test de Empatía — ¿Cuál es tu cociente empático?', description: 'Mide tu empatía en empatía cognitiva, empatía emocional y fatiga por compasión.' },
};
const m = meta[locale] ?? meta.en;
---
<Layout title={m.title} description={m.description} locale={locale}>
  <main class="mx-auto max-w-2xl px-4 py-10">
    <EmpathyTest client:load locale={locale} />
  </main>
</Layout>
