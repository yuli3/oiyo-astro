---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import EmpathyTest from '../../../components/tests/EmpathyTest';
import RelatedTools from '../../../components/shared/RelatedTools.astro';
import { buildQuizJsonLd } from '../../../lib/seo/quiz-json-ld';
import TestSourceNote from '../../../components/shared/TestSourceNote.astro';
import PrintReportButton from '../../../components/shared/PrintReportButton.astro';
import { TEST_SOURCE_NOTES } from '../../../data/test-source-notes';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '공감 능력 테스트 — 나의 공감 방식은?', description: '인지적 공감·정서적 공감·자비적 공감 세 가지 경향을 살펴보고 관계에서의 강점과 경계를 확인해보세요.' },
  en: { title: 'Empathy Test — What Is Your Empathy Style?', description: 'Explore cognitive, affective, and compassionate empathy tendencies, including relationship strengths and boundaries.' },
  ja: { title: '共感力テスト — あなたの共感スタイルは？', description: '認知的・情動的・思いやり的共感の三つの傾向と、関係の中での強みや境界を振り返ります。' },
  zh: { title: '共情能力测试 — 你的共情方式是什么？', description: '了解认知共情、情感共情和慈悲共情三种倾向，以及关系中的优势与边界。' },
  fr: { title: "Test d'empathie — Quel est votre style?", description: "Explorez les tendances d'empathie cognitive, affective et compassionnelle, ainsi que vos forces et limites relationnelles." },
  es: { title: 'Test de empatía — ¿Cuál es tu estilo?', description: 'Explora las tendencias de empatía cognitiva, afectiva y compasiva, junto con fortalezas y límites en las relaciones.' },
};
const m = meta[locale] ?? meta.en;

const content: Record<Locale, { introTitle: string; intro: string; conceptTitle: string; concepts: { title: string; body: string }[]; faqTitle: string; faqs: { question: string; answer: string }[]; disclaimer: string; }> = {
  ko: { introTitle: '공감 능력은 사람을 단정하는 라벨이 아니라 타인의 마음을 이해하고 느끼는 방식을 보는 렌즈입니다', intro: '공감 능력 테스트는 인지적 공감, 정서적 공감, 자비적 공감이 나의 관계에 어떻게 나타나는지 살펴봅니다. 결과는 착함의 점수가 아니라 관계에서 에너지와 경계를 이해하기 위한 참고입니다.', conceptTitle: '공감을 읽는 세 가지 관점', concepts: [{ title: '인지적 공감', body: '상대의 관점과 이유를 머리로 이해하는 능력입니다.' }, { title: '정서적 공감', body: '상대의 감정에 함께 울림을 느끼는 민감도입니다.' }, { title: '자비적 공감', body: '이해와 느낌을 상대가 원하는 실제 도움으로 연결하려는 경향입니다. 과도한 돌봄은 피로로 이어질 수 있습니다.' }], faqTitle: '자주 묻는 질문', faqs: [{ question: '공감 능력 결과는 얼마나 정확한가요?', answer: '현재 답변에 나타난 공감 경향을 요약한 참고 자료입니다. 관계와 컨디션에 따라 달라질 수 있으니 절대적 점수로 보지 마세요.' }, { question: '공감이 높으면 항상 좋은가요?', answer: '높은 공감은 관계에 도움이 되지만 경계가 약하면 피로로 이어질 수 있습니다. 균형 있게 읽는 것이 중요합니다.' }, { question: '결과를 어떻게 활용하면 좋나요?', answer: '내가 잘 읽는 신호와 쉽게 지치는 장면을 함께 확인해 관계의 거리와 회복 방식을 조정해 보세요.' }], disclaimer: '공감 능력 테스트 결과는 자기 이해와 대화를 위한 참고입니다. 진단, 채용, 관계의 단정적 판단 근거로 사용하지 마세요.' },
  en: { introTitle: 'Empathy is a lens for how you understand and feel with others, not a label that defines you', intro: 'The empathy test looks at how cognitive, affective, and compassionate empathy appear in relationships. The result is not a score for goodness; it is a reference for understanding energy and boundaries.', conceptTitle: 'Three ways to read empathy', concepts: [{ title: 'Cognitive empathy', body: 'Understanding another person’s perspective and reasons.' }, { title: 'Affective empathy', body: 'The sensitivity to resonate with another person’s feeling.' }, { title: 'Compassionate empathy', body: 'Turning understanding and feeling into help the other person wants. Excessive caregiving can still lead to fatigue.' }], faqTitle: 'Frequently asked questions', faqs: [{ question: 'How accurate is the empathy result?', answer: 'It summarizes empathy tendencies shown in your current answers. Relationships and condition can shift it, so avoid treating it as an absolute score.' }, { question: 'Is higher empathy always better?', answer: 'High empathy can help relationships, but weak boundaries can lead to fatigue. Read the result with balance.' }, { question: 'How should I use the result?', answer: 'Notice both the signals you read well and the situations that drain you, then adjust distance and recovery.' }], disclaimer: 'Empathy test results are for self-understanding and conversation. Do not use them as a basis for diagnosis, hiring, or definitive relationship judgments.' },
  ja: { introTitle: '共感力は人を決めつけるラベルではなく、他者の心を理解し感じる方法を見るレンズです', intro: '共感力テストは認知的・情動的・思いやり的共感が関係にどう表れるかを見ます。結果は善良さの点数ではなく、関係の中のエネルギーと境界を理解する参考です。', conceptTitle: '共感を読む三つの視点', concepts: [{ title: '認知的共感', body: '相手の視点や理由を頭で理解する力です。' }, { title: '情動的共感', body: '相手の感情に響きやすい敏感さです。' }, { title: '思いやり的共感', body: '理解と感情を、相手が望む具体的な助けにつなげる傾向です。過度な世話は疲労につながることもあります。' }], faqTitle: 'よくある質問', faqs: [{ question: '共感力の結果はどれくらい正確ですか？', answer: '現在の回答に表れた共感傾向の要約です。関係や体調で変わるため、絶対的な点数として扱わないでください。' }, { question: '共感が高いほどよいですか？', answer: '高い共感は関係に役立ちますが、境界が弱いと疲れにつながります。バランスで読むことが大切です。' }, { question: '結果はどう使えばよいですか？', answer: '読み取りやすいサインと疲れやすい場面を一緒に見て、距離と回復を調整してみてください。' }], disclaimer: '共感力テストの結果は自己理解と対話のための参考です。診断、採用、人間関係の断定的な判断材料には使わないでください。' },
  zh: { introTitle: '共情能力是观察你理解并感受他人内心方式的镜片，不是定义人的标签', intro: '共情能力测试观察认知共情、情感共情和慈悲共情在关系中如何出现。结果不是善良程度分数，而是理解关系中能量和边界的参考。', conceptTitle: '理解共情的三个角度', concepts: [{ title: '认知共情', body: '理解他人的视角和理由的能力。' }, { title: '情感共情', body: '对他人情绪产生共鸣的敏感度。' }, { title: '慈悲共情', body: '把理解和感受转化为对方需要的实际帮助。过度照顾仍可能带来疲惫。' }], faqTitle: '常见问题', faqs: [{ question: '共情结果有多准确？', answer: '它概括的是当前回答中的共情倾向。关系和状态会影响结果，因此不要当作绝对分数。' }, { question: '共情越高越好吗？', answer: '高共情有助关系，但边界不足可能带来疲惫。需要平衡理解。' }, { question: '应该如何使用结果？', answer: '同时看你擅长读懂的信号和容易耗尽的场景，再调整距离和恢复方式。' }], disclaimer: '共情能力测试结果仅用于自我理解与对话，请勿作为诊断、招聘或关系定论的依据。' },
  fr: { introTitle: 'L’empathie est une lentille pour comprendre et ressentir avec autrui, pas une étiquette qui vous définit', intro: 'Le test d’empathie observe la place de l’empathie cognitive, affective et compassionnelle. Le résultat n’est pas un score de bonté, mais un repère pour comprendre énergie et limites.', conceptTitle: 'Trois façons de lire l’empathie', concepts: [{ title: 'Empathie cognitive', body: 'Comprendre le point de vue et les raisons de l’autre.' }, { title: 'Empathie affective', body: 'La sensibilité à résonner avec l’émotion de l’autre.' }, { title: 'Empathie compassionnelle', body: 'Transformer compréhension et ressenti en une aide souhaitée par l’autre. Un soutien excessif peut tout de même fatiguer.' }], faqTitle: 'Questions fréquentes', faqs: [{ question: 'Le résultat est-il fiable ?', answer: 'Il résume les tendances empathiques visibles dans vos réponses du moment. Les relations et l’état personnel peuvent le modifier; ne le prenez pas comme score absolu.' }, { question: 'Plus d’empathie est-il toujours mieux ?', answer: 'Une forte empathie aide les relations, mais des limites faibles peuvent fatiguer. Lisez le résultat avec équilibre.' }, { question: 'Comment l’utiliser ?', answer: 'Repérez les signaux que vous lisez bien et les situations qui vous épuisent, puis ajustez distance et récupération.' }], disclaimer: 'Les résultats du test d’empathie servent à la compréhension de soi et au dialogue. Ne les utilisez pas comme base de diagnostic, de recrutement ou de verdict relationnel.' },
  es: { introTitle: 'La empatía es una lente para comprender y sentir con otras personas, no una etiqueta que te define', intro: 'El test de empatía observa cómo aparecen la empatía cognitiva, afectiva y compasiva. El resultado no es una puntuación de bondad, sino una referencia para entender energía y límites.', conceptTitle: 'Tres formas de leer la empatía', concepts: [{ title: 'Empatía cognitiva', body: 'Comprender la perspectiva y las razones de otra persona.' }, { title: 'Empatía afectiva', body: 'La sensibilidad para resonar con lo que siente otra persona.' }, { title: 'Empatía compasiva', body: 'Convertir comprensión y sentimiento en la ayuda que la otra persona desea. Cuidar en exceso también puede agotar.' }], faqTitle: 'Preguntas frecuentes', faqs: [{ question: '¿Qué tan preciso es el resultado?', answer: 'Resume tendencias empáticas que aparecen en tus respuestas actuales. Relaciones y estado personal pueden cambiarlo; no lo trates como puntuación absoluta.' }, { question: '¿Más empatía siempre es mejor?', answer: 'La empatía alta ayuda, pero límites débiles pueden cansar. Lee el resultado con equilibrio.' }, { question: '¿Cómo usarlo?', answer: 'Nota las señales que lees bien y las situaciones que te agotan, luego ajusta distancia y recuperación.' }], disclaimer: 'Los resultados del test de empatía son para autoconocimiento y conversación. No los uses como base para diagnóstico, contratación o juicios definitivos sobre relaciones.' },
};

const c = content[locale] ?? content.en;
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
const quizJsonLd = buildQuizJsonLd({
  name: m.title,
  description: m.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  inLanguage: locale,
  questions: [],
});

---
<Layout title={m.title} description={m.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(quizJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="mx-auto max-w-2xl px-4 py-10">
    <EmpathyTest client:load locale={locale} />
    <section class="mt-10 border-t border-green-100 pt-8"><h2 class="text-2xl font-bold text-green-950">{c.introTitle}</h2><p class="mt-4 leading-8 text-green-800">{c.intro}</p></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-green-950">{c.conceptTitle}</h2><div class="mt-4 grid gap-4 md:grid-cols-3">{c.concepts.map((item) => (<article class="rounded-xl border border-green-100 bg-white p-4"><h3 class="font-semibold text-green-950">{item.title}</h3><p class="mt-2 text-sm leading-6 text-green-700">{item.body}</p></article>))}</div></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-green-950">{c.faqTitle}</h2><div class="mt-4 divide-y divide-green-100 rounded-xl border border-green-100 bg-white">{c.faqs.map((faq) => (<details class="group p-4"><summary class="cursor-pointer list-none font-semibold text-green-950">{faq.question}</summary><p class="mt-3 text-sm leading-6 text-green-700">{faq.answer}</p></details>))}</div></section>
    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>
    <RelatedTools locale={locale} tools={['eq','innerStrength','loveLanguage','attachment']} current="empathy" />
  <PrintReportButton locale={locale} />
  <TestSourceNote locale={locale} note={TEST_SOURCE_NOTES['empathy']} />
  </div>
</Layout>
