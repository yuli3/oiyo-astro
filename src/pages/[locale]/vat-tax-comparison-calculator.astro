---
import Layout from "../../layouts/Layout.astro";
import { LOCALES } from "../../i18n";
import type { Locale } from "../../i18n";
import VatTaxComparisonCalculator from "../../components/tools/VatTaxComparisonCalculator";

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "부가가치세 일반과세 vs 간이과세(1억 400만원) 절세 비교기 | OIYO Tools",
    description: "2024년 7월 개정 간이과세 1억 400만원 기준 및 4,800만원 납부면제 반영, 초기 인테리어/장비 매입세액 환급 여부와 일반과세 vs 간이과세 유불리를 1초 만에 비교합니다.",
  },
  en: {
    title: "Korea VAT Calculator: General vs Simplified Taxpayer (104M KRW Threshold) | OIYO Tools",
    description: "Compare Korea Value Added Tax (VAT) between general and simplified taxpayers under the 104M KRW limit and analyze purchase tax refund break-even points.",
  },
  ja: {
    title: "韓国 付加価値税 一般課税 vs 簡易課税（1億400万ウォン基準）比較機 | OIYO Tools",
    description: "韓国の簡易課税基準（1億400万ウォン未満）および仕入税額控除・還付の損益分岐点を業種別にリアルタイム比較します。",
  },
  zh: {
    title: "韩国 增值税 一般纳税人 vs 简易征税人（1亿400万韩元基准）节税对比器 | OIYO Tools",
    description: "对比韩国增值税一般纳税人与简易纳税人税负，测算初期进项税额全额退税与简易征税的最佳选择点。",
  },
  fr: {
    title: "Simulateur de TVA en Corée : Régime général vs Régime simplifié | OIYO Tools",
    description: "Comparez la TVA en Corée entre le régime général et le régime simplifié (seuil de 104M KRW) et évaluez les remboursements de crédit de TVA.",
  },
  es: {
    title: "Calculadora de IVA en Corea: Régimen General vs Simplificado | OIYO Tools",
    description: "Compare el IVA en Corea entre contribuyentes generales y simplificados (límite de 104M KRW) y calcule el punto de equilibrio para la devolución.",
  },
};

const currentMeta = meta[locale] ?? meta.ko;
---

<Layout title={currentMeta.title} description={currentMeta.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 space-y-8">
    <div class="text-center space-y-2 max-w-2xl mx-auto">
      <h1 class="text-3xl font-extrabold tracking-tight">부가가치세 일반 vs 간이과세 비교기</h1>
      <p class="text-muted-foreground text-sm">
        2024년 7월 개정 1억 400만원 간이과세 기준 반영, 업종별 부가가치율 납부액과 초기 시설투자 환급 분기점 시뮬레이터
      </p>
    </div>

    <VatTaxComparisonCalculator client:load />

    <div class="max-w-4xl mx-auto border rounded-xl p-6 bg-card border-border space-y-4">
      <h2 class="text-lg font-bold">초기 창업자 부가가치세 과세유형 선택 핵심 가이드</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-muted-foreground leading-relaxed">
        <div class="space-y-1">
          <h3 class="font-semibold text-foreground">💡 초기 설비·인테리어 투자가 큰 경우 (일반과세 추천)</h3>
          <p>
            인테리어 공사비나 기계 설비 구매비가 3천만원 이상 발생할 경우, 일반과세를 선택해야 10%에 해당하는 수백만 원의 부가세를 국세청으로부터 현금 환급받을 수 있습니다. 간이과세자는 환급이 불가능(0원)합니다.
          </p>
        </div>
        <div class="space-y-1">
          <h3 class="font-semibold text-foreground">💡 연매출 4,800만원 미만 (간이과세 절대 유리)</h3>
          <p>
            연간 매출액이 4,800만원 미만인 소상공인은 부가가치세 납부의무가 법적으로 완전 면제(0원)되므로 초기 대규모 투자가 없다면 간이과세를 유지하는 것이 압도적으로 유리합니다.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
