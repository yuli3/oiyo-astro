---
import Layout from '../../layouts/Layout.astro';
import HeroArt from '../../components/shared/HeroArt.astro';
import UsageClip from '../../components/shared/UsageClip.astro';
import { LOCALES, getTranslations } from '../../i18n';
import type { Locale } from '../../i18n';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = await getTranslations(locale);

// 2026-10-07 소개 영상. 화면 속 글자는 ko 판과 en 판 두 벌이고, 문장은 여기 HTML 이 맡는다.
const introCopy: Record<string, { label: string; caption: string }> = {
  ko: { label: "OIYO 소개 영상", caption: "나를 이해하는 지도, OIYO를 10초로 봐요. 재생하면 소리가 나요." },
  en: { label: "OIYO intro video", caption: "OIYO in ten seconds: a map for understanding yourself. Plays with sound." },
  ja: { label: "OIYO紹介動画", caption: "自分を理解するための地図、OIYOを10秒で。再生すると音が出ます。" },
  zh: { label: "OIYO 介绍视频", caption: "十秒看懂 OIYO：一张理解自己的地图。播放时有声音。" },
  fr: { label: "Vidéo de présentation d’OIYO", caption: "OIYO en dix secondes : une carte pour mieux se comprendre. La lecture est sonore." },
  es: { label: "Vídeo de presentación de OIYO", caption: "OIYO en diez segundos: un mapa para entenderte. Se reproduce con sonido." },
};
const intro = introCopy[locale] ?? introCopy.en;
const introScreens = locale === "ko" ? "ko" : "en";

const values = [
  { key: 'free', icon: '🌍' },
  { key: 'privacy', icon: '🔒' },
  { key: 'science', icon: '🔬' },
  { key: 'engaging', icon: '✨' },
];
---

<Layout
  title={t('marketing.about.hero.title') || 'About OIYO'}
  description={t('marketing.about.hero.description')}
  locale={locale}
  ogImage={new URL('/brand/sacred-tree-og.png', Astro.site).toString()}
>
  <!-- Hero -->
  <section class="relative bg-gradient-to-b from-green-50/60 to-white pt-16 pb-12 px-4 text-center">
    <div class="absolute inset-0 pointer-events-none opacity-20" aria-hidden="true">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-green-200 rounded-full blur-3xl" />
    </div>
    <div class="relative z-10 max-w-2xl mx-auto animate-fadeInUp">
      <img
        src="/brand/sacred-tree.png"
        alt=""
        width="160"
        height="160"
        class="mx-auto mb-5 h-28 w-28 object-contain sm:h-36 sm:w-36"
      />
      <p class="text-green-600 text-sm font-semibold uppercase tracking-widest mb-3">
        {t('marketing.about.hero.subtitle')}
      </p>
      <h1 class="text-4xl md:text-5xl font-serif font-black text-foreground mb-4 tracking-tight">
        {t('marketing.about.hero.title')}
      </h1>
      <p class="text-primary text-lg leading-relaxed">
        {t('marketing.about.hero.description')}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pt-10">
    <UsageClip
      sound
      src={`/motion/oiyo-intro-${introScreens}.mp4`}
      poster={`/motion/oiyo-intro-${introScreens}.jpg`}
      width={1280}
      height={720}
      label={intro.label}
      caption={intro.caption}
      replay=""
    />
  </section>

  <!-- Mission -->
  <section class="max-w-3xl mx-auto px-4 py-12">
    {/* 2026-09-30 2-15: 세운 결정 — 세계수 그림은 나의 지도 밖(소개·세계관)에서 쓴다. */}
    <HeroArt src="/images/oiyo-imagegen/hero/world-tree-dawn.webp" class="mb-8 max-h-64" />
    <div class="bg-card rounded-2xl border border-green-50 p-8 text-center">
      <h2 class="text-2xl font-bold text-foreground mb-3">
        {t('marketing.about.mission.title')}
      </h2>
      <p class="text-primary leading-relaxed">
        {t('marketing.about.mission.description')}
      </p>
    </div>
  </section>

  <!-- Values -->
  <section class="bg-green-50/40 py-12 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-foreground text-center mb-8">
        {t('marketing.about.values.title')}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {values.map(({ key, icon }) => (
          <div class="bg-card rounded-2xl border border-green-50 p-6">
            <div class="text-2xl mb-3">{icon}</div>
            <h3 class="font-bold text-foreground mb-1">
              {t(`marketing.about.values.${key}.title`)}
            </h3>
            <p class="text-sm text-green-600 leading-relaxed">
              {t(`marketing.about.values.${key}.description`)}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="max-w-3xl mx-auto px-4 py-12 text-center">
    <h2 class="text-2xl font-bold text-foreground mb-3">
      {t('marketing.about.story.title')}
    </h2>
    <p class="text-primary leading-relaxed">
      {t('marketing.about.story.description')}
    </p>
  </section>
</Layout>
