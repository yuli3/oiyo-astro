---
import Layout from '../../layouts/Layout.astro';
import { LOCALES, getTranslations } from '../../i18n';
import type { Locale } from '../../i18n';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = await getTranslations(locale);

const values = [
  { key: 'free', icon: '🌍' },
  { key: 'privacy', icon: '🔒' },
  { key: 'science', icon: '🔬' },
  { key: 'engaging', icon: '✨' },
];
---

<Layout
  title={t('marketing.about.hero.title') || 'About OIYO'}
  description={t('marketing.about.hero.description')}
  locale={locale}
  ogImage={new URL('/brand/sacred-tree-og.png', Astro.site).toString()}
>
  <!-- Hero -->
  <section class="relative bg-gradient-to-b from-green-50/60 to-white pt-16 pb-12 px-4 text-center">
    <div class="absolute inset-0 pointer-events-none opacity-20" aria-hidden="true">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-green-200 rounded-full blur-3xl" />
    </div>
    <div class="relative z-10 max-w-2xl mx-auto animate-fadeInUp">
      <img
        src="/brand/sacred-tree.png"
        alt=""
        width="160"
        height="160"
        class="mx-auto mb-5 h-28 w-28 object-contain sm:h-36 sm:w-36"
      />
      <p class="text-green-600 text-sm font-semibold uppercase tracking-widest mb-3">
        {t('marketing.about.hero.subtitle')}
      </p>
      <h1 class="text-4xl md:text-5xl font-serif font-black text-foreground mb-4 tracking-tight">
        {t('marketing.about.hero.title')}
      </h1>
      <p class="text-green-700 text-lg leading-relaxed">
        {t('marketing.about.hero.description')}
      </p>
    </div>
  </section>

  <!-- Mission -->
  <section class="max-w-3xl mx-auto px-4 py-12">
    <div class="bg-card rounded-2xl border border-green-50 p-8 text-center">
      <h2 class="text-2xl font-bold text-foreground mb-3">
        {t('marketing.about.mission.title')}
      </h2>
      <p class="text-green-700 leading-relaxed">
        {t('marketing.about.mission.description')}
      </p>
    </div>
  </section>

  <!-- Values -->
  <section class="bg-green-50/40 py-12 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-foreground text-center mb-8">
        {t('marketing.about.values.title')}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {values.map(({ key, icon }) => (
          <div class="bg-card rounded-2xl border border-green-50 p-6">
            <div class="text-2xl mb-3">{icon}</div>
            <h3 class="font-bold text-foreground mb-1">
              {t(`marketing.about.values.${key}.title`)}
            </h3>
            <p class="text-sm text-green-600 leading-relaxed">
              {t(`marketing.about.values.${key}.description`)}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="max-w-3xl mx-auto px-4 py-12 text-center">
    <h2 class="text-2xl font-bold text-foreground mb-3">
      {t('marketing.about.story.title')}
    </h2>
    <p class="text-green-700 leading-relaxed">
      {t('marketing.about.story.description')}
    </p>
  </section>
</Layout>
