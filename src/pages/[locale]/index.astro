---
import Layout from '../../layouts/Layout.astro';
import PeriodicFortune from '../../components/tools/PeriodicFortune';
import { LOCALES, getTranslations, localePath } from '../../i18n';
import type { Locale } from '../../i18n';
// 2026-08-25 impeccable critique P2: one coherent icon language instead of
// four unrelated emoji vocabularies (doors/tests/map/value-props each used
// their own set). lucide-react is already a project dependency; these are
// static SVGs, no client directive needed.
import { Heart, Brain, Waves, Sparkles, Wand2, Sun, ClipboardCheck, Star, FlaskConical, Lock, Square, SquareCheck } from 'lucide-react';
import type { ComponentType } from 'react';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = await getTranslations(locale);

type L = Locale

const txt = (map: Record<L, string>) => map[locale] ?? map.en

// <title>/meta 는 SEO 카피 그대로 둔다 — 이번 개편은 화면에 보이는 구조 문제
// (질문·랜딩부터 어디서 뭘 하는지 8번 바뀌는 문제)를 고치는 것이지 검색 카피 교체가
// 아니다. 온페이지 h1 은 pageRole 로 별도 관리.
const heroTitle = txt({
  ko: '나를 알아가는 가장 쉬운 방법',
  en: 'Know Yourself, Deeply',
  ja: '自分を深く知る、最も簡単な方法',
  zh: '了解自己，最简单的方式',
  fr: 'Connaissez-vous Vraiment',
  es: 'Conócete Profundamente',
})

const heroSub = txt({
  ko: 'MBTI부터 사주까지, 심리학과 동양 철학으로 나를 탐색하는 무료 도구 모음.',
  en: 'From MBTI to Saju — free tools for self-exploration through psychology and Eastern wisdom.',
  ja: 'MBTIから四柱推命まで — 心理学と東洋哲学で自分を探る無料ツール集。',
  zh: '从MBTI到四柱推命 — 通过心理学与东方智慧免费探索自我。',
  fr: 'Du MBTI au Saju — outils gratuits d\'exploration de soi par la psychologie et la sagesse orientale.',
  es: 'Del MBTI al Saju — herramientas gratuitas de autoexploración a través de la psicología y la sabiduría oriental.',
})

// 검색 결과에 쓰는 설명은 히어로 문구와 다를 수 있다.
//
// `/en/` 이 최근 28일 GSC 에서 받은 쿼리는 **"ahoxy" 하나뿐이다**(40노출·3.5위·**0클릭**,
// 직전 28일은 2노출). ahoxy.com 을 찾던 사람이 우리를 3위에서 보고 그냥 지나친다 —
// 결과 어디에도 "ahoxy 가 여기로 왔다"가 없기 때문이다. 301 은 걸려 있지만 브랜드
// 이전의 마지막 한 칸이 비어 있는 셈이다([[ahoxy-301-keep-and-pivot]]).
//
// 그래서 **en 에만** 이전 안내 한 문장을 붙인다. 다른 로케일에는 이 쿼리가 없어 노이즈다.
// 히어로 문구(heroSub)는 건드리지 않는다 — 화면에 보이는 카피와 검색 스니펫은 목적이 다르다.
// 리뷰: 2026-09-03(28일 후) CTR 확인. 여전히 0이면 title 로 올린다.
const metaDescription = locale === 'en'
  ? `${heroSub} ahoxy.com is now OIYO.`
  : heroSub

// 2026-08-25 /grill-me 개편: 홈이 카탈로그가 아니라 세 문이 되도록 재구성.
// company-brain/AI-Sessions/wiki/design/oiyo-landing-ux-consistency-2026-08-25.md 참조.
// 없앤 것: 통계 띠("28+" 등), 히어로 8칸 격자, 인기 7 + 빠른 18 이중 목록, teal 블러.

const pageRole = txt({
  ko: '질문은 여기서. 모아둔 건 지도에서.',
  en: 'Answer questions here. See it all come together in your map.',
  ja: '質問はここで。集めたものは地図で。',
  zh: '问题在这里回答，汇总在地图里查看。',
  fr: 'Répondez aux questions ici. Retrouvez tout dans votre carte.',
  es: 'Responde preguntas aquí. Encuéntralo todo en tu mapa.',
})

// 2026-08-25: swapped "three doors" (3 button-cards) for the PRD's §5.1
// sentence-wizard variant — one screen, first-person statements instead of
// category labels, no pre-highlighted default. Same 3 destinations as
// before (MBTI / attachment / ontology); only the presentation changed.
type WizardStatement = { key: string; sentence: string; href: string }

const wizardIntro = txt({
  ko: '지금 가장 가까운 문장에 표시하세요',
  en: 'Mark whichever sentence feels closest to you right now',
  ja: '今、一番近いと感じる文に印をつけてください',
  zh: '请勾选此刻最贴近你的一句话',
  fr: 'Cochez la phrase qui vous ressemble le plus en ce moment',
  es: 'Marca la frase que más se parezca a ti ahora mismo',
})

const wizardStatements: WizardStatement[] = [
  {
    key: 'personality',
    sentence: txt({
      ko: '나는 내가 어떤 사람인지 잘 모르겠다',
      en: "I don't really know what kind of person I am",
      ja: '自分がどんな人間なのかよくわからない',
      zh: '我不太清楚自己是什么样的人',
      fr: 'Je ne sais pas vraiment quel genre de personne je suis',
      es: 'No sé muy bien qué tipo de persona soy',
    }),
    href: localePath(locale, '/mbti/test'),
  },
  {
    key: 'relationships',
    sentence: txt({
      ko: '가까운 사람과 반복해서 같은 패턴이 생긴다',
      en: 'The same pattern keeps repeating with people close to me',
      ja: '近しい人との間で同じパターンが繰り返される',
      zh: '和亲近的人之间总是重复同样的模式',
      fr: 'Le même schéma se répète avec mes proches',
      es: 'El mismo patrón se repite con las personas cercanas',
    }),
    href: localePath(locale, '/attachment-style/test'),
  },
  {
    key: 'birth',
    sentence: txt({
      ko: '내 생년월일이 나를 어떻게 말하는지 궁금하다',
      en: "I'm curious what my birth date says about me",
      ja: '生まれた日が自分について何を語るのか気になる',
      zh: '我想知道我的出生日期能说明什么',
      fr: 'Je suis curieux(se) de ce que dit ma date de naissance',
      es: 'Tengo curiosidad por lo que dice mi fecha de nacimiento',
    }),
    href: localePath(locale, '/ontology'),
  },
]

type PsychTest = { icon: ComponentType<{ size?: number; strokeWidth?: number; className?: string }>; title: string; questions: number; minutes: number; href: string }

const questionsMinutesLabel = (n: number, m: number) => txt({
  ko: `${n}문항 · ${m}분`,
  en: `${n} questions · ${m} min`,
  ja: `${n}問 · ${m}分`,
  zh: `${n}题 · ${m}分钟`,
  fr: `${n} questions · ${m} min`,
  es: `${n} preguntas · ${m} min`,
})

const psychTests: PsychTest[] = [
  {
    icon: Brain,
    title: txt({ ko: 'MBTI', en: 'MBTI', ja: 'MBTI', zh: 'MBTI', fr: 'MBTI', es: 'MBTI' }),
    questions: 16, minutes: 3,
    href: localePath(locale, '/mbti/test'),
  },
  {
    icon: Waves,
    title: txt({ ko: '빅파이브', en: 'Big Five', ja: 'ビッグファイブ', zh: '大五人格', fr: 'Big Five', es: 'Cinco Grandes' }),
    questions: 20, minutes: 4,
    href: localePath(locale, '/big5/test'),
  },
  {
    icon: Sparkles,
    title: txt({ ko: '에니어그램', en: 'Enneagram', ja: 'エニアグラム', zh: '九型人格', fr: 'Ennéagramme', es: 'Eneagrama' }),
    questions: 27, minutes: 5,
    href: localePath(locale, '/enneagram/test'),
  },
  {
    icon: Heart,
    title: txt({ ko: '애착유형', en: 'Attachment', ja: '愛着タイプ', zh: '依恋类型', fr: 'Attachement', es: 'Apego' }),
    questions: 12, minutes: 2,
    href: localePath(locale, '/attachment-style/test'),
  },
]

// 2026-08-25 impeccable critique P2: doors[0]/doors[1]과 psychTests[0]/[3]가
// 같은 URL(MBTI/애착)을 5줄 차이로 두 번 보여줘서 "실수처럼" 읽힌다는 지적.
// 목적지를 바꾸지 않고(위 문의 기본값은 확정 사양), 이 섹션이 "전체 목록"임을
// 제목으로 명시해 위의 문과 겹치는 게 의도된 레이아웃임을 알린다.
const sectionPsychTitle = txt({ ko: '심리검사 전체', en: 'All Psychology Tests', ja: '心理テスト一覧', zh: '全部心理测试', fr: 'Tous les tests de psychologie', es: 'Todos los tests de psicología' })
const ctaStart = txt({ ko: '시작하기', en: 'Start', ja: '始める', zh: '开始', fr: 'Commencer', es: 'Comenzar' })

const fortuneSectionTitle = txt({
  ko: '오늘',
  en: 'Today',
  ja: '今日',
  zh: '今日',
  fr: "Aujourd'hui",
  es: 'Hoy',
})
const tarotCard = {
  title: txt({ ko: '타로 리딩', en: 'Tarot Reading', ja: 'タロットリーディング', zh: '塔罗牌解读', fr: 'Tirage de Tarot', es: 'Lectura de Tarot' }),
  href: localePath(locale, '/tarot/reading'),
}
const fortuneWidgetTitle = txt({
  ko: '오늘의 운세',
  en: "Today's Fortune",
  ja: '今日の運勢',
  zh: '今日运势',
  fr: 'La fortune du jour',
  es: 'La fortuna de hoy',
})

const moreSectionTitle = txt({ ko: '더 보기', en: 'More', ja: 'もっと見る', zh: '更多', fr: 'Voir plus', es: 'Ver más' })
const ctaAllTests = txt({ ko: '전체 검사', en: 'All Tests', ja: '全テスト', zh: '所有测试', fr: 'Tous les Tests', es: 'Todos los Tests' })

const personalMap = {
  title: txt({ ko: '흩어진 결과를, 하나의 나의 지도로', en: 'Turn scattered results into your personal map', ja: '散らばった結果を、ひとつの「私の地図」へ', zh: '把零散的结果，汇成一张“我的地图”', fr: 'Transformez vos résultats en une carte personnelle', es: 'Convierte tus resultados en tu mapa personal' }),
  description: txt({ ko: '생년월일로 계산한 것, 테스트로 발견한 것, 내가 직접 고른 것을 서로 섞지 않고 연결해 보세요.', en: 'Connect what birth data calculates, what assessments reveal, and what you choose—without mixing them into one score.', ja: '生年月日から分かること、テストで見つけたこと、自分で選んだことを、一つの点数に混ぜずにつなげます。', zh: '连接出生信息所计算的、测验所发现的，以及你亲自选择的内容，而不把它们混成一个分数。', fr: 'Reliez ce que calcule votre naissance, ce que révèlent les tests et ce que vous choisissez, sans tout fondre en un score.', es: 'Conecta lo que calcula tu nacimiento, lo que revelan los tests y lo que eliges, sin mezclarlo todo en una puntuación.' }),
  born: txt({ ko: '타고난 것', en: 'Born with', ja: '生まれ持ったもの', zh: '天生的', fr: 'Données de naissance', es: 'Lo innato' }),
  measured: txt({ ko: '검사로 본 것', en: 'Measured', ja: 'テストで見たもの', zh: '测验发现的', fr: 'Mesuré', es: 'Lo medido' }),
  chosen: txt({ ko: '내가 고른 것', en: 'Chosen by me', ja: '自分で選んだもの', zh: '我选择的', fr: 'Choisi par moi', es: 'Lo que elijo' }),
  bornDetail: txt({ ko: '사주 · 오행 · 별자리', en: 'Saju · elements · zodiac', ja: '四柱推命 · 五行 · 星座', zh: '八字 · 五行 · 星座', fr: 'Saju · éléments · zodiaque', es: 'Saju · elementos · zodiaco' }),
  measuredDetail: txt({ ko: '성격 · 가치관 · 관계', en: 'Traits · values · relationships', ja: '性格 · 価値観 · 関係', zh: '性格 · 价值观 · 关系', fr: 'Traits · valeurs · relations', es: 'Rasgos · valores · relaciones' }),
  chosenDetail: txt({ ko: '관심 · 활동 · 다음 행동', en: 'Interests · activities · next steps', ja: '関心 · 活動 · 次の一歩', zh: '兴趣 · 活动 · 下一步', fr: 'Intérêts · activités · prochaine étape', es: 'Intereses · actividades · próximos pasos' }),
  cta: txt({ ko: '내 지도 열기', en: 'Open my map', ja: '私の地図を開く', zh: '打开我的地图', fr: 'Ouvrir ma carte', es: 'Abrir mi mapa' }),
  privacy: txt({ ko: '로그인 없이 · 이 브라우저에만 저장', en: 'No login · stored only in this browser', ja: 'ログイン不要 · このブラウザだけに保存', zh: '无需登录 · 仅保存在此浏览器', fr: 'Sans connexion · stocké dans ce navigateur', es: 'Sin iniciar sesión · guardado en este navegador' }),
}
---

<Layout
  title={heroTitle}
  description={metaDescription}
  locale={locale}
>
  <!-- 1. 한 문장 역할 -->
  <section class="relative overflow-hidden bg-gradient-to-b from-green-50/80 to-white pt-16 pb-10 px-4">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute -top-40 -left-40 w-[500px] h-[500px] bg-green-200 rounded-full blur-3xl opacity-20" />
    </div>

    <div class="relative z-10 max-w-2xl mx-auto text-center animate-fadeInUp">
      <div class="inline-flex items-center px-3 py-1 rounded-full bg-white/70 backdrop-blur-sm border border-green-100 text-green-700 text-xs font-bold mb-5 shadow-sm">
        OIYO
      </div>
      <h1 class="text-3xl md:text-4xl font-serif font-black text-green-950 mb-3 tracking-tight leading-tight">
        {pageRole}
      </h1>
      <p class="text-green-700 font-medium text-sm md:text-base max-w-lg mx-auto leading-relaxed">
        {heroSub}
      </p>
    </div>
  </section>

  <!-- 2. 문장 위저드 — 세 문 대신 (PRD §5.1) -->
  <section class="max-w-3xl mx-auto px-4 pb-2" aria-label={wizardIntro}>
    <h2 class="text-sm font-bold text-green-800 mb-3">{wizardIntro}</h2>
    <div class="divide-y divide-green-100 border-y border-green-100">
      {wizardStatements.map((w) => (
        <a
          href={w.href}
          class="group flex items-center gap-3 py-4 hover:bg-green-50/60 -mx-2 px-2 rounded-lg transition-colors"
        >
          <span class="shrink-0 text-green-300 group-hover:hidden">
            <Square size={20} strokeWidth={2} aria-hidden="true" />
          </span>
          <span class="hidden shrink-0 text-green-700 group-hover:inline-flex">
            <SquareCheck size={20} strokeWidth={2} aria-hidden="true" />
          </span>
          <span class="min-w-0 flex-1 font-bold text-sm text-green-950">{w.sentence}</span>
          <span class="shrink-0 text-green-400 group-hover:text-green-700 transition-colors" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <!-- 3. 심리 네 개 -->
  <section class="max-w-3xl mx-auto px-4 pt-10">
    <h2 class="text-lg font-bold text-green-950 mb-2">{sectionPsychTitle}</h2>
    <div class="divide-y divide-green-100 border-t border-green-100">
      {psychTests.map((test) => (
        <a
          href={test.href}
          class="group flex items-center gap-3 py-3.5 hover:bg-green-50/60 -mx-2 px-2 rounded-lg transition-colors"
        >
          <span class="w-8 shrink-0 text-green-700">
            <test.icon size={20} strokeWidth={2} aria-hidden="true" />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block font-bold text-green-950 text-sm group-hover:text-green-700 transition-colors">
              {test.title}
            </span>
            <span class="block text-xs text-green-700 mt-0.5">{questionsMinutesLabel(test.questions, test.minutes)}</span>
          </span>
          <span class="shrink-0 text-xs font-semibold text-green-700 group-hover:text-green-900 transition-colors">
            {ctaStart} →
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- 4. 지도 한 줄 -->
  <section class="mx-auto max-w-4xl px-4 pt-10" aria-labelledby="personal-map-title">
    <div class="relative overflow-hidden rounded-[2rem] bg-[#f7f8ed] px-5 py-7 sm:px-8 sm:py-9 lg:px-10">
      <div class="pointer-events-none absolute -right-20 -top-24 h-64 w-64 rounded-full bg-lime-200/50 blur-3xl" aria-hidden="true"></div>
      <div class="relative grid items-center gap-8 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <h2 id="personal-map-title" class="max-w-xl text-2xl font-black leading-tight text-green-950 sm:text-3xl">
            {personalMap.title}
          </h2>
          <p class="mt-3 max-w-xl text-sm leading-6 text-green-800/75 sm:text-base">
            {personalMap.description}
          </p>
          <div class="mt-6 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
            <a
              href={localePath(locale, '/ontology')}
              class="inline-flex min-h-12 items-center justify-center rounded-full bg-green-800 px-6 py-3 text-sm font-bold text-white shadow-sm transition-colors hover:bg-green-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-800"
            >
              {personalMap.cta}<span class="ml-2" aria-hidden="true">→</span>
            </a>
            <p class="inline-flex items-center gap-1.5 text-xs font-semibold text-green-800">
              <Lock size={12} strokeWidth={2.5} aria-hidden="true" />{personalMap.privacy}
            </p>
          </div>
        </div>

        <div aria-label={personalMap.title}>
          <div class="grid gap-5 sm:grid-cols-3 sm:divide-x sm:divide-lime-300/70">
            {[
              { icon: Sun, title: personalMap.born, detail: personalMap.bornDetail },
              { icon: ClipboardCheck, title: personalMap.measured, detail: personalMap.measuredDetail },
              { icon: Star, title: personalMap.chosen, detail: personalMap.chosenDetail },
            ].map((item) => (
              <div class="flex items-start gap-3 sm:flex-col sm:gap-2 sm:px-5 sm:first:pl-0">
                <item.icon size={18} strokeWidth={2.25} className="text-lime-700 shrink-0" aria-hidden="true" />
                <div>
                  <p class="text-sm font-black text-green-950">{item.title}</p>
                  <p class="mt-1 text-xs leading-5 text-green-800">{item.detail}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. 오늘 둘 (타로, 오늘의 운세) -->
  <section class="max-w-3xl mx-auto px-4 pt-14">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-bold text-green-950">{fortuneSectionTitle}</h2>
      <a href={tarotCard.href} class="group inline-flex items-center gap-1.5 text-sm font-semibold text-green-700 hover:text-green-900 transition-colors">
        <Wand2 size={16} strokeWidth={2} aria-hidden="true" />{tarotCard.title}
        <span class="text-green-500 group-hover:translate-x-0.5 transition-transform" aria-hidden="true">→</span>
      </a>
    </div>
    <div class="rounded-3xl bg-green-50/60 p-5">
      <p class="text-xs font-bold text-green-700 uppercase tracking-wide mb-2">{fortuneWidgetTitle}</p>
      <PeriodicFortune client:visible locale={locale} period="today" />
    </div>
  </section>

  <!-- 6. 더 보기 -->
  <section class="max-w-3xl mx-auto px-4 pt-10 pb-14">
    <h2 class="sr-only">{moreSectionTitle}</h2>
    <div class="flex flex-wrap justify-center gap-3">
      <a
        href={localePath(locale, '/tests')}
        class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full bg-white border border-green-200 text-green-800 text-sm font-semibold hover:bg-green-50 hover:border-green-300 transition-all shadow-sm"
      >
        {ctaAllTests} →
      </a>
      <a
        href={localePath(locale, '/ontology')}
        class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full bg-white border border-green-200 text-green-800 text-sm font-semibold hover:bg-green-50 hover:border-green-300 transition-all shadow-sm"
      >
        {personalMap.cta} →
      </a>
    </div>
  </section>

  <!-- Value props strip -->
  <section class="bg-gradient-to-b from-green-50/50 to-white py-12 px-4 border-t border-green-50">
    <div class="max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
      {[
        {
          icon: FlaskConical,
          title: txt({ ko: '심리학 기반', en: 'Psychology-Based', ja: '心理学ベース', zh: '基于心理学', fr: 'Basé sur la Psychologie', es: 'Basado en Psicología' }),
