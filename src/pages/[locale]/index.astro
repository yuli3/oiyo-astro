---
import Layout from '../../layouts/Layout.astro';
import FortuneWall from '../../components/tools/FortuneWall.astro';
import AmbientParticles from '../../components/visual/AmbientParticles.astro';
import { LOCALES, getTranslations, localePath } from '../../i18n';
import type { Locale } from '../../i18n';
// 2026-08-25 impeccable critique P2: one coherent icon language instead of
// four unrelated emoji vocabularies (doors/tests/map/value-props each used
// their own set). lucide-react is already a project dependency; these are
// static SVGs, no client directive needed.
import { Wand2, Sun, ClipboardCheck, FlaskConical, Lock, Globe2, Hourglass, ArrowRight } from 'lucide-react';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = await getTranslations(locale);

type L = Locale

const txt = (map: Record<L, string>) => map[locale] ?? map.en

// <title>/meta 는 SEO 카피 그대로 둔다 — 이번 개편은 화면에 보이는 구조 문제
// (질문·랜딩부터 어디서 뭘 하는지 8번 바뀌는 문제)를 고치는 것이지 검색 카피 교체가
// 아니다. 온페이지 h1 은 pageRole 로 별도 관리.
const heroTitle = txt({
  ko: '나를 알아가는 가장 쉬운 방법',
  en: 'Know Yourself, Deeply',
  ja: '自分を深く知る、最も簡単な方法',
  zh: '了解自己，最简单的方式',
  fr: 'Connaissez-vous Vraiment',
  es: 'Conócete Profundamente',
})

const heroSub = txt({
  ko: 'MBTI부터 사주까지, 심리학과 동양 철학으로 나를 탐색하는 무료 도구 모음.',
  en: 'From MBTI to Saju — free tools for self-exploration through psychology and Eastern wisdom.',
  ja: 'MBTIから四柱推命まで — 心理学と東洋哲学で自分を探る無料ツール集。',
  zh: '从MBTI到四柱推命 — 通过心理学与东方智慧免费探索自我。',
  fr: 'Du MBTI au Saju — outils gratuits d\'exploration de soi par la psychologie et la sagesse orientale.',
  es: 'Del MBTI al Saju — herramientas gratuitas de autoexploración a través de la psicología y la sabiduría oriental.',
})

// 검색 결과에 쓰는 설명은 히어로 문구와 다를 수 있다.
//
// `/en/` 이 최근 28일 GSC 에서 받은 쿼리는 **"ahoxy" 하나뿐이다**(40노출·3.5위·**0클릭**,
// 직전 28일은 2노출). ahoxy.com 을 찾던 사람이 우리를 3위에서 보고 그냥 지나친다 —
// 결과 어디에도 "ahoxy 가 여기로 왔다"가 없기 때문이다. 301 은 걸려 있지만 브랜드
// 이전의 마지막 한 칸이 비어 있는 셈이다([[ahoxy-301-keep-and-pivot]]).
//
// 그래서 **en 에만** 이전 안내 한 문장을 붙인다. 다른 로케일에는 이 쿼리가 없어 노이즈다.
// 히어로 문구(heroSub)는 건드리지 않는다 — 화면에 보이는 카피와 검색 스니펫은 목적이 다르다.
// 리뷰: 2026-09-03(28일 후) CTR 확인. 여전히 0이면 title 로 올린다.
const metaDescription = locale === 'en'
  ? `${heroSub} ahoxy.com is now OIYO.`
  : heroSub

// 2026-08-26 (세운 지시): "타고난 것/검사로 본 것/내가 고른 것" 세 갈래는 /tests·
// /ontology 와 내용이 겹친다는 게 세운 판단이라 홈에서 걷어냄. 대신 검색으로
// 들어오는 방문자(예: "쥐띠 이번달 운세")가 원하는 답을 랜딩에서 바로 보게
// 하는 쪽으로 방향을 바꿨다 — 생년월일 없이 12지신·별자리 전체를 기간별로
// 보여주는 FortuneWall이 핵심 콘텐츠, 헤더는 짧은 훅 + 검사/온톨로지 CTA만.
// 두 프로토타입(훅+도배 / 도배만) 비교 후 훅+도배 확정.
const pageRole = txt({
  ko: '당신의 인생을 함께 설계하는 Life Coordinator',
  en: 'The Life Coordinator that designs your life with you',
  ja: 'あなたの人生を共に設計する Life Coordinator',
  zh: '与您一起设计人生的 Life Coordinator',
  fr: 'Le Life Coordinator qui conçoit votre vie avec vous',
  es: 'El Life Coordinator que diseña tu vida contigo',
})

const heroSubDisplay = txt({
  ko: '사주·별자리·심리검사로 오늘의 나를 읽고, 내일의 방향을 함께 그려요.',
  en: 'Read who you are today through Saju, zodiac and psychology tests, and plan where you go next.',
  ja: '四柱推命・星座・心理テストで今日の自分を読み解き、明日の方向を一緒に描きます。',
  zh: '通过四柱推命、星座与心理测试读懂今天的你，一起描绘明天的方向。',
  fr: 'Lisez qui vous êtes aujourd’hui grâce au Saju, au zodiaque et aux tests, et tracez la suite.',
  es: 'Descubre quién eres hoy con el Saju, el zodiaco y los tests, y traza tu próximo paso.',
})

const ctaStartTest = txt({ ko: '검사 시작하기', en: 'Start a Test', ja: '検査を始める', zh: '开始测试', fr: 'Commencer un test', es: 'Empezar un test' })
const ctaSeeMap = txt({ ko: '나의 지도 보기', en: 'See My Map', ja: '私の地図を見る', zh: '查看我的地图', fr: 'Voir ma carte', es: 'Ver mi mapa' })

// 2026-11-02 (세운 "랜딩 정리"): 뽑기 입구를 하나짜리 큰 카드에서 두 칸짜리
// 줄로 바꿨다. 환생 나라 + 600년 전 나는? 두 개를 같은 무게로 보여준다.
const drawsTitle = txt({ ko: '재미로 뽑아보기', en: 'Just for fun', ja: '気軽に引いてみる', zh: '随手抽一抽', fr: 'Pour s’amuser', es: 'Solo por diversión' })
const draws = [
  {
    href: localePath(locale, '/reincarnation-country'),
    icon: Globe2,
    entry: 'reincarnation',
    title: txt({ ko: '다시 태어난다면 어느 나라?', en: 'Born again, in which country?', ja: '生まれ変わるならどの国？', zh: '再出生会在哪个国家？', fr: 'Si vous renaissiez, quel pays ?', es: 'Si nacieras de nuevo, ¿qué país?' }),
    description: txt({ ko: '실제 출생 수 비중으로 나라를 뽑아요.', en: 'A country drawn by real birth shares.', ja: '実際の出生数の割合で国を引きます。', zh: '按真实出生比重抽国家。', fr: 'Un pays tiré selon les naissances réelles.', es: 'Un país sorteado según nacimientos reales.' }),
  },
  {
    href: localePath(locale, '/past-life-1426/'),
    icon: Hourglass,
    entry: 'past-life-1426',
    title: txt({ ko: '600년 전 나는?', en: 'Who were you 600 years ago?', ja: '600年前のわたしは？', zh: '600年前的我是谁？', fr: 'Qui étiez-vous il y a 600 ans ?', es: '¿Quién eras hace 600 años?' }),
    description: txt({ ko: '조선 관직·유럽 왕좌·미국 출생 주를 역사 자료로 뽑아요.', en: 'A Joseon office, a European throne or a US birth state, from historical data.', ja: '朝鮮の官職・欧州の玉座・米国の出生州を史料で引きます。', zh: '用史料抽朝鲜官职、欧洲王座或美国出生州。', fr: 'Une charge à Joseon, un trône européen ou un État américain, selon les archives.', es: 'Un cargo en Joseon, un trono europeo o un estado de EE. UU., con datos históricos.' }),
  },
]

const tarotCard = {
  title: txt({ ko: '타로 리딩', en: 'Tarot Reading', ja: 'タロットリーディング', zh: '塔罗牌解读', fr: 'Tirage de Tarot', es: 'Lectura de Tarot' }),
  href: localePath(locale, '/tarot/reading'),
  description: txt({ ko: '카드 세 장으로 지금의 흐름 읽기', en: 'Three cards on where things stand', ja: '3枚のカードで今の流れを読む', zh: '三张牌读懂当下', fr: 'Trois cartes sur le moment présent', es: 'Tres cartas sobre tu momento' }),
}

const moreSectionTitle = txt({ ko: '더 보기', en: 'More', ja: 'もっと見る', zh: '更多', fr: 'Voir plus', es: 'Ver más' })
const ctaAllTests = txt({ ko: '전체 검사', en: 'All Tests', ja: '全テスト', zh: '所有测试', fr: 'Tous les Tests', es: 'Todos los Tests' })
const allTestsDescription = txt({ ko: '성격·관계·진로 검사 한눈에 보기', en: 'Personality, relationship and career tests', ja: '性格・関係・進路の検査を一覧で', zh: '性格、关系、职业测试一览', fr: 'Tests de personnalité, relations et carrière', es: 'Tests de personalidad, relaciones y carrera' })
const fortuneHeading = txt({ ko: '12지신·별자리 운세', en: 'Chinese zodiac & star sign fortunes', ja: '十二支・星座の運勢', zh: '十二生肖·星座运势', fr: 'Horoscopes chinois et occidental', es: 'Horóscopo chino y occidental' })

---

<Layout
  title={heroTitle}
  description={metaDescription}
  locale={locale}
>
  <!-- 1. 한 문장 역할 + CTA -->
  <section class="relative overflow-hidden bg-gradient-to-b from-green-50/80 to-white pt-12 pb-10 px-4">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute -top-40 -left-40 w-[500px] h-[500px] bg-green-200 rounded-full blur-3xl opacity-20" />
    </div>
    <AmbientParticles />

    <div class="relative z-10 max-w-2xl mx-auto text-center animate-fadeInUp">
      <h1 class="text-3xl md:text-4xl font-serif font-black text-foreground mb-3 tracking-tight leading-tight">
        {pageRole}
      </h1>
      <p class="text-primary font-medium text-sm md:text-base max-w-lg mx-auto leading-relaxed">
        {heroSubDisplay}
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a
          href={localePath(locale, '/tests')}
          class="inline-flex min-h-12 items-center justify-center rounded-full bg-primary-strong px-6 py-3 text-sm font-bold text-white shadow-sm transition-colors hover:bg-green-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-800"
        >
          {ctaStartTest} →
        </a>
        <a
          href={localePath(locale, '/ontology')}
          class="inline-flex min-h-12 items-center justify-center rounded-full border border-border bg-card px-6 py-3 text-sm font-bold text-green-800 transition-colors hover:border-green-300 hover:bg-surface-subtle"
        >
          {ctaSeeMap}
        </a>
      </div>
      <h2 class="mt-8 text-left text-xs font-bold uppercase tracking-widest text-green-600">{drawsTitle}</h2>
      <div class="mt-2 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {draws.map((d) => (
          <a
            href={d.href}
            data-draw-entry={d.entry}
            class="flex items-start gap-3 rounded-2xl border border-border bg-surface-subtle p-4 text-left text-foreground transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
          >
            <d.icon size={24} strokeWidth={1.75} className="mt-0.5 shrink-0 text-primary" aria-hidden="true" />
            <span class="min-w-0">
              <span class="block font-bold leading-snug">{d.title}</span>
              <span class="mt-1 block text-xs leading-relaxed text-muted-foreground">{d.description}</span>
            </span>
            <ArrowRight size={16} className="ml-auto mt-1 shrink-0 text-primary" aria-hidden="true" />
          </a>
        ))}
      </div>
    </div>
  </section>
  <!-- 2. 운세 도배: 생년월일 없이 12지신·별자리 × 오늘/이번주/이번달/올해 전체 -->
  <section class="pt-10 pb-4">
    <h2 class="sr-only">{fortuneHeading}</h2>
    <FortuneWall locale={locale} />
  </section>

  <!-- 3. 기타 내용들 (타로, 전체 검사) — 세운 지시: 이미지(타로카드/전체검사) 붙일
       예정이라 작은 필로 두지 않고 큰 카드로 중앙정렬. 이미지 준비되면 아래
       아이콘 원(rounded-full) 을 <img> 로 교체. -->
  <section class="max-w-2xl mx-auto px-4 pt-8 pb-12">
    <h2 class="sr-only">{moreSectionTitle}</h2>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      {[
        { href: tarotCard.href, icon: Wand2, title: tarotCard.title, description: tarotCard.description },
        { href: localePath(locale, '/tests'), icon: ClipboardCheck, title: ctaAllTests, description: allTestsDescription },
      ].map((card) => (
        <a
          href={card.href}
          class="group flex items-center gap-4 rounded-2xl border border-border bg-card p-4 shadow-sm transition-all hover:border-green-300 hover:shadow-md"
        >
          <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-surface-subtle text-primary transition-colors group-hover:bg-green-100">
            <card.icon size={28} strokeWidth={1.75} aria-hidden="true" />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block font-bold text-foreground">{card.title}</span>
            <span class="mt-0.5 block text-xs text-muted-foreground">{card.description}</span>
          </span>
          <ArrowRight size={16} className="shrink-0 text-primary" aria-hidden="true" />
        </a>
      ))}
    </div>
  </section>

  <!-- Value props strip -->
  <section class="bg-gradient-to-b from-green-50/50 to-white py-8 px-4 border-t border-green-50">
    <div class="max-w-4xl mx-auto grid grid-cols-3 gap-3 sm:gap-6 text-center">
      {[
        {
          icon: FlaskConical,
          title: txt({ ko: '심리학 기반', en: 'Psychology-Based', ja: '心理学ベース', zh: '基于心理学', fr: 'Basé sur la Psychologie', es: 'Basado en Psicología' }),
          desc: txt({ ko: 'OCEAN·애착이론 등 검증된 연구 기반', en: 'OCEAN, attachment theory & validated research', ja: 'OCEAN・愛着理論などの検証済み研究に基づく', zh: '基于OCEAN、依恋理论等经验证的研究', fr: 'OCEAN, théorie de l\'attachement & recherche validée', es: 'OCEAN, teoría del apego e investigación validada' }),
        },
        {
          icon: Sun,
          title: txt({ ko: '동양 철학', en: 'Eastern Wisdom', ja: '東洋哲学', zh: '东方智慧', fr: 'Sagesse Orientale', es: 'Sabiduría Oriental' }),
          desc: txt({ ko: '사주·수비학·별자리 등 전통 지혜 통합', en: 'Saju, numerology, zodiac & traditional wisdom', ja: '四柱推命・数秘術・星座など伝統的知恵を統合', zh: '四柱推命、数字命理、星座等传统智慧整合', fr: 'Saju, numérologie, zodiaque & sagesse traditionnelle', es: 'Saju, numerología, zodíaco & sabiduría tradicional' }),
        },
        {
          icon: Lock,
          title: txt({ ko: '개인정보 보호', en: 'Privacy First', ja: 'プライバシー優先', zh: '隐私优先', fr: 'Confidentialité d\'Abord', es: 'Privacidad Primero' }),
          desc: txt({ ko: '결과는 기기에만 저장. 서버 전송 없음', en: 'Results stay on your device. No server uploads.', ja: '結果はデバイスのみに保存。サーバー送信なし', zh: '结果仅保存在您的设备上。不上传至服务器', fr: 'Les résultats restent sur votre appareil. Pas d\'envoi serveur.', es: 'Los resultados permanecen en tu dispositivo. Sin envíos al servidor.' }),
        },
      ].map(v => (
        <div class="flex flex-col items-center gap-2">
          <v.icon size={24} strokeWidth={1.75} className="text-primary" aria-hidden="true" />
          <h3 class="text-sm font-bold text-foreground sm:text-base">{v.title}</h3>
          <p class="text-xs text-primary leading-relaxed sm:text-sm">{v.desc}</p>
        </div>
      ))}
    </div>
  </section>

</Layout>
