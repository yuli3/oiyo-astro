---
import Layout from '../../layouts/Layout.astro';
import { LOCALES, getTranslations, localePath } from '../../i18n';
import type { Locale } from '../../i18n';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = await getTranslations(locale);

const features = [
  {
    id: 'tests',
    title: {
      ko: '성격 & 운세 테스트',
      en: 'Personality & Fortune Tests',
      ja: '性格 & 占いテスト',
      cn: '性格与运势测试',
      fr: 'Tests de Personnalité',
      es: 'Pruebas de Personalidad',
    }[locale] ?? 'Personality & Fortune Tests',
    description: {
      ko: 'MBTI·에니어그램·빅파이브·사주·수비학·별자리 등 8가지 테스트를 한 곳에서.',
      en: 'MBTI, Enneagram, Big Five, Saju, Numerology, Zodiac & more — all in one place.',
      ja: 'MBTI・エニアグラム・ビッグファイブ・四柱・数秘術・星座など8種のテストを一か所で。',
      cn: 'MBTI、九型人格、大五人格、四柱、数字命理、星座等8种测试一站汇聚。',
      fr: 'MBTI, Ennéagramme, Big Five, Saju, Numérologie, Zodiaque et plus — tout en un.',
      es: 'MBTI, Eneagrama, Big Five, Saju, Numerología, Zodíaco y más — todo en un lugar.',
    }[locale] ?? 'MBTI, Enneagram, Big Five, Saju, Numerology, Zodiac & more — all in one place.',
    href: localePath(locale, '/tests'),
    bg: 'bg-green-50',
    icon: '✨',
    badge: '8 tests',
  },
  {
    id: 'ontology',
    title: t('hero.ontology.title') || 'My Sanctuary',
    description: t('hero.ontology.desc') || 'Discover your soul blueprint.',
    href: localePath(locale, '/ontology'),
    bg: 'bg-violet-50',
    icon: '🏛️',
    badge: '',
  },
  {
    id: 'mbti',
    title: {
      ko: 'MBTI 직업 적성 테스트',
      en: 'MBTI Career Test',
      ja: 'MBTI 職業適性テスト',
      cn: 'MBTI 职业测试',
      fr: 'Test de Carrière MBTI',
      es: 'Test de Carrera MBTI',
    }[locale] ?? 'MBTI Career Test',
    description: {
      ko: '12가지 업무 상황으로 나에게 맞는 직업 유형을 찾아보세요.',
      en: 'Find your career type through 12 work scenario questions.',
      ja: '12の職場シナリオで最適な職業タイプを発見。',
      cn: '通过12个情境发现你的职业类型。',
      fr: '12 scénarios pour trouver votre type de carrière.',
      es: '12 situaciones para encontrar tu tipo de carrera.',
    }[locale] ?? 'Find your career type through 12 work scenario questions.',
    href: localePath(locale, '/mbti/test'),
    bg: 'bg-blue-50',
    icon: '🧠',
    badge: '16 types',
  },
  {
    id: 'enneagram',
    title: {
      ko: '에니어그램 테스트',
      en: 'Enneagram Test',
      ja: 'エニアグラムテスト',
      cn: '九型人格测试',
      fr: 'Test Ennéagramme',
      es: 'Test Eneagrama',
    }[locale] ?? 'Enneagram Test',
    description: {
      ko: '27가지 문항으로 나의 핵심 동기와 두려움을 탐색하세요.',
      en: 'Explore your core motivations and fears with 27 questions.',
      ja: '27問で核心的な動機と恐怖を探求。',
      cn: '27道题探索您的核心动机与恐惧。',
      fr: '27 questions pour explorer vos motivations profondes.',
      es: '27 preguntas para explorar tus motivaciones centrales.',
    }[locale] ?? 'Explore your core motivations and fears with 27 questions.',
    href: localePath(locale, '/enneagram/test'),
    bg: 'bg-indigo-50',
    icon: '🔮',
    badge: '9 types',
  },
];
---

<Layout
  title={t('hero.title') || 'OIYO'}
  description={t('hero.description')}
  locale={locale}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-b from-green-50/70 to-white pt-20 pb-16 px-4">
    <div class="absolute inset-0 pointer-events-none opacity-20" aria-hidden="true">
      <div class="absolute -top-32 -left-32 w-96 h-96 bg-green-300 rounded-full blur-3xl" />
      <div class="absolute top-16 right-0 w-[500px] h-[500px] bg-teal-200 rounded-full blur-3xl" />
    </div>

    <div class="relative z-10 max-w-3xl mx-auto text-center animate-fadeInUp">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/60 backdrop-blur-sm border border-green-100 text-green-700 text-xs font-bold mb-6">
        ✨ OIYO
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-black text-green-950 mb-4 tracking-tight leading-tight">
        {t('hero.title')}
      </h1>
      <p class="text-green-700 font-medium text-base md:text-lg max-w-lg mx-auto leading-relaxed opacity-90">
        {t('hero.subtitle')}
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href={localePath(locale, '/mbti/test')}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-green-700 text-white font-semibold text-sm shadow-lg shadow-green-200 hover:bg-green-800 transition-all hover:-translate-y-0.5"
        >
          {t('hero.cta.primary')} →
        </a>
        <a
          href={localePath(locale, '/ontology')}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white text-green-700 font-semibold text-sm border border-green-100 hover:bg-green-50 transition-all"
        >
          {t('hero.cta.secondary')}
        </a>
      </div>
    </div>
  </section>

  <!-- Feature Cards -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map((feat) => (
        <a
          href={feat.href}
          class="group block bg-white rounded-2xl border border-green-50 p-6 hover:border-green-200 hover:-translate-y-1 transition-all duration-200 shadow-sm hover:shadow-md"
        >
          <div class="flex items-start justify-between mb-4">
            <div class={`w-12 h-12 rounded-xl ${feat.bg} flex items-center justify-center text-2xl`}>
              {feat.icon}
            </div>
            {feat.badge && (
              <span class="text-xs font-semibold bg-green-50 text-green-600 px-2 py-1 rounded-full border border-green-100">
                {feat.badge}
              </span>
            )}
          </div>
          <h2 class="font-bold text-green-950 mb-1 group-hover:text-green-700 transition-colors">
            {feat.title}
          </h2>
          <p class="text-sm text-green-600 leading-relaxed">
            {feat.description}
          </p>
          <div class="mt-4 text-xs font-semibold text-green-500 group-hover:text-green-700 transition-colors">
            Start →
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- About teaser -->
  <section class="bg-green-50/50 py-16 px-4">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-green-950 mb-3">
        {t('marketing.about.hero.title')}
      </h2>
      <p class="text-green-700 leading-relaxed mb-6">
        {t('marketing.about.hero.description')}
      </p>
      <a href={localePath(locale, '/about')} class="text-sm font-semibold text-green-600 hover:text-green-800 transition-colors">
        {t('nav.about')} →
      </a>
    </div>
  </section>
</Layout>
