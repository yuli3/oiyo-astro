---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import TestExplainer from '../../components/shared/TestExplainer.astro';
import { TEST_EXPLAINERS } from '../../data/test-explainers';
import ProcrastinationTypeTest from '../../components/tests/ProcrastinationTypeTest';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<string, { title: string; description: string }> = {
  ko: { title: "미루기 유형 테스트 — 나는 왜 미루는가?", description: "페라리 & 타이스(Ferrari & Tice) 심리학 연구 기반 7가지 핵심 질문 진단. 완벽주의형·회피형·압도형·스릴추구형·결정불능형 5대 미루기 원인을 정밀 분석하고, 미루는 습관을 끊어내는 맞춤형 실행 전략을 무료로 확인하세요." },
  en: { title: "Procrastination Type Test — Why Do You Procrastinate?", description: "Identify why you procrastinate based on Ferrari & Tice research. Assess 5 root types across 7 questions to unlock actionable anti-procrastination habits." },
  ja: { title: "先延ばし類型テスト — なぜ先延ばしにするのか？", description: "フェラーリ＆タイス（Ferrari & Tice）の心理学研究に基づく7つの診断。完璧主義型・回避型・圧倒型・スリル追求型・決断困難型の5大原因を分析し、先延ばし癖を断ち切る行動戦略を無料で確認しましょう。" },
  fr: { title: "Test de Procrastination — Pourquoi procrastinez-vous?", description: "Comprenez votre procrastination selon la recherche de Ferrari & Tice. Identifiez votre profil parmi 5 types et adoptez des méthodes pour passer à l'action." },
  es: { title: "Test de Procrastinación — ¿Por qué pospones las cosas?", description: "Descubre por qué postergas tareas según los estudios de Ferrari y Tice. Identifica tu perfil entre 5 tipos y adopta métodos eficaces para pasar a la acción." },
  zh: { title: "拖延类型测试 — 你为何拖延？", description: "基于法拉利与泰斯（Ferrari & Tice）心理学研究的7题专业拖延自测。深入分析完美主义型、逃避型、过载型、刺激寻求型与决断迟疑型5大核心成因，精准诊断拖延症结，即刻获取摆脱拖延的专属行动策略。" },
};
const m = meta[locale] ?? meta.en ?? Object.values(meta)[0];
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <ProcrastinationTypeTest locale={locale as any} client:load />
    <TestExplainer content={TEST_EXPLAINERS['procrastination-type']} locale={locale} />
  </div>
</Layout>
