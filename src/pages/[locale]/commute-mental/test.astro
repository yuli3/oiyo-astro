---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import CommuteMentalTest from '../../../components/tests/CommuteMentalTest';
import RelatedTools from '../../../components/shared/RelatedTools.astro';
import { buildQuizJsonLd } from '../../../lib/seo/quiz-json-ld';
import TestSourceNote from '../../../components/shared/TestSourceNote.astro';
import PrintReportButton from '../../../components/shared/PrintReportButton.astro';
import { TEST_SOURCE_NOTES } from '../../../data/test-source-notes';
export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '출퇴근 멘탈 테스트: 나의 직장인 멘탈 상태는?', description: '10개의 질문으로 출퇴근길 나의 멘탈 상태를 알아보세요. 가벼운 발걸음, 저항, 무기력, 도피 중 어떤 유형인가요?' },
  en: { title: 'Commute Mental Test: What\'s Your Workday Mindset?', description: 'Discover your commute mindset with 10 questions. Are you Lightfoot, Resistant, Lethargic, or Escapist?' },
  ja: { title: '通勤メンタルテスト：あなたの職場人メンタル状態は？', description: '10の質問で通勤時のメンタル状態を診断。軽い足取り、抵抗感、無気力、逃避の4タイプ。' },
  zh: { title: '通勤心态测试：你的职场心理状态如何？', description: '通过10个问题了解你的通勤心态。你是轻盈型、抵抗型、倦怠型还是逃避型？' },
  fr: { title: 'Test Mental Trajet : Quel est votre état d\'esprit au travail?', description: "Découvrez votre état d'esprit lors du trajet avec 10 questions. Êtes-vous Léger, Résistant, Léthargique ou Fugitif?" },
  es: { title: 'Test Mental del Trayecto: ¿Cuál es tu mentalidad laboral?', description: 'Descubre tu mentalidad en el trayecto con 10 preguntas. ¿Eres Ligero, Resistente, Letárgico o Escapista?' },
};
const m = meta[locale] ?? meta.en;

const content: Record<Locale, { introTitle: string; intro: string; conceptTitle: string; concepts: { title: string; body: string }[]; faqTitle: string; faqs: { question: string; answer: string }[]; disclaimer: string; }> = {
  ko: { introTitle: '출퇴근 멘탈은 사람을 단정하는 라벨이 아니라 출퇴근길의 마음 상태를 보는 렌즈입니다', intro: '출퇴근 멘탈 테스트는 가벼움, 저항감, 무기력, 도피감이 출퇴근 장면에서 어떻게 나타나는지 살펴봅니다. 결과는 직장인을 평가하는 기준이 아니라 하루의 전환 구간을 이해하기 위한 참고입니다.', conceptTitle: '출퇴근 멘탈을 읽는 세 가지 관점', concepts: [{ title: '아침 신호', body: '집을 나서기 전의 마음이 하루 전체의 부담을 보여줄 때가 있습니다.' }, { title: '전환 구간', body: '출퇴근은 사적인 나와 일하는 나 사이를 건너는 심리적 통로입니다.' }, { title: '회복 단서', body: '작은 루틴, 거리 조정, 기대치 정리가 멘탈 부담을 줄일 수 있습니다.' }], faqTitle: '자주 묻는 질문', faqs: [{ question: '출퇴근 멘탈 결과는 얼마나 정확한가요?', answer: '현재 답변에 나타난 출퇴근 감정 패턴을 요약한 참고 자료입니다. 업무 시기, 수면, 교통 상황에 따라 달라질 수 있습니다.' }, { question: '결과가 안 좋으면 직장을 바꿔야 하나요?', answer: '그렇게 단정할 수 없습니다. 결과는 부담의 신호를 정리한 것이며, 작은 조정부터 구조적 변화까지 여러 선택지를 생각해 볼 자료입니다.' }, { question: '어떻게 활용하면 좋나요?', answer: '출근 전후에 반복되는 감정과 회복되는 순간을 함께 기록해 나에게 맞는 전환 루틴을 찾아보세요.' }], disclaimer: '출퇴근 멘탈 테스트 결과는 자기 이해와 대화를 위한 참고입니다. 진단, 채용, 관계의 단정적 판단 근거로 사용하지 마세요.' },
  en: { introTitle: 'Commute mindset is a lens for your workday transition, not a label that defines you', intro: 'The commute mental test looks at how lightness, resistance, lethargy, and escapism show up during the commute. The result is not a rating of you as a worker; it is a reference for understanding the transition between private life and work.', conceptTitle: 'Three ways to read commute mindset', concepts: [{ title: 'Morning signal', body: 'The feeling before leaving home can reveal the weight of the whole workday.' }, { title: 'Transition zone', body: 'A commute is a psychological passage between private self and work self.' }, { title: 'Recovery clue', body: 'Small routines, route choices, and expectation resets can reduce mental load.' }], faqTitle: 'Frequently asked questions', faqs: [{ question: 'How accurate is the commute result?', answer: 'It summarizes commute emotion patterns shown in your current answers. Work season, sleep, and traffic can shift it.' }, { question: 'Does a difficult result mean I should change jobs?', answer: 'Not necessarily. The result organizes burden signals and can support thinking about small adjustments, structural changes, or both.' }, { question: 'How should I use it?', answer: 'Notice recurring feelings before and after commuting, plus moments of recovery, then design a transition routine that fits you.' }], disclaimer: 'Commute mental test results are for self-understanding and conversation. Do not use them as a basis for diagnosis, hiring, or definitive relationship judgments.' },
  ja: { introTitle: '通勤メンタルは人を決めつけるラベルではなく、通勤時の心の状態を見るレンズです', intro: '通勤メンタルテストは軽さ、抵抗感、無気力、逃避感が通勤場面でどう表れるかを見ます。結果は働く人を評価する基準ではなく、一日の切り替え区間を理解する参考です。', conceptTitle: '通勤メンタルを読む三つの視点', concepts: [{ title: '朝のサイン', body: '家を出る前の気持ちが一日の負担を示すことがあります。' }, { title: '切り替え区間', body: '通勤は私的な自分と働く自分をつなぐ心理的な通路です。' }, { title: '回復の手がかり', body: '小さなルーティン、道の選び方、期待値の調整が負担を軽くします。' }], faqTitle: 'よくある質問', faqs: [{ question: '通勤メンタルの結果はどれくらい正確ですか？', answer: '現在の回答に表れた通勤時の感情パターンの要約です。仕事の時期、睡眠、交通状況で変わることがあります。' }, { question: 'つらい結果なら転職すべきですか？', answer: 'そう断定はできません。結果は負担のサインを整理するもので、小さな調整から構造的な変化まで考える材料です。' }, { question: 'どう活用すればよいですか？', answer: '通勤前後に繰り返される感情と回復する瞬間を記録し、自分に合う切り替えルーティンを探してください。' }], disclaimer: '通勤メンタルテストの結果は自己理解と対話のための参考です。診断、採用、人間関係の断定的判断には使わないでください。' },
  zh: { introTitle: '通勤心态是观察通勤路上心理状态的镜片，不是定义人的标签', intro: '通勤心态测试观察轻盈、抵抗、无力和逃避感在通勤中如何出现。结果不是评价职场人的标准，而是理解一天转换区间的参考。', conceptTitle: '理解通勤心态的三个角度', concepts: [{ title: '早晨信号', body: '出门前的心情有时会反映整个工作日的重量。' }, { title: '转换区间', body: '通勤是私人自我与工作自我之间的心理通道。' }, { title: '恢复线索', body: '小例行、路线选择和调整期待，都可能减轻心理负担。' }], faqTitle: '常见问题', faqs: [{ question: '通勤心态结果有多准确？', answer: '它概括的是当前回答中的通勤情绪模式。工作阶段、睡眠和交通状况都会影响结果。' }, { question: '结果不好就应该换工作吗？', answer: '不能这样断定。结果只是整理负担信号，可帮助你思考小调整、结构变化或两者结合。' }, { question: '应该如何使用？', answer: '记录通勤前后反复出现的情绪和恢复瞬间，找到适合自己的转换例行。' }], disclaimer: '通勤心态测试结果仅用于自我理解与对话，请勿作为诊断、招聘或关系定论的依据。' },
  fr: { introTitle: 'L’état mental du trajet est une lentille sur votre transition de journée, pas une étiquette qui vous définit', intro: 'Le test mental du trajet observe la légèreté, la résistance, la lassitude et l’évitement pendant le trajet. Le résultat n’évalue pas la personne au travail; il aide à comprendre la transition entre vie privée et travail.', conceptTitle: 'Trois façons de lire le trajet mental', concepts: [{ title: 'Signal du matin', body: 'Le ressenti avant de partir peut révéler le poids de toute la journée.' }, { title: 'Zone de transition', body: 'Le trajet relie psychologiquement le soi privé et le soi au travail.' }, { title: 'Piste de récupération', body: 'Petites routines, choix d’itinéraire et attentes ajustées peuvent alléger la charge.' }], faqTitle: 'Questions fréquentes', faqs: [{ question: 'Le résultat est-il fiable ?', answer: 'Il résume les motifs émotionnels visibles dans vos réponses. Période de travail, sommeil et transport peuvent le modifier.' }, { question: 'Un résultat difficile signifie-t-il changer de travail ?', answer: 'Pas nécessairement. Le résultat organise des signaux de charge et peut aider à penser ajustements légers ou changements structurels.' }, { question: 'Comment l’utiliser ?', answer: 'Notez les émotions qui reviennent avant et après le trajet, ainsi que les moments de récupération, puis créez une routine de transition.' }], disclaimer: 'Les résultats du test mental du trajet servent à la compréhension de soi et au dialogue. Ne les utilisez pas comme base de diagnostic, de recrutement ou de verdict relationnel.' },
  es: { introTitle: 'La mentalidad del trayecto es una lente sobre tu transición laboral, no una etiqueta que te define', intro: 'El test mental del trayecto observa ligereza, resistencia, apatía y escape durante el desplazamiento. El resultado no evalúa a la persona trabajadora; ayuda a entender la transición entre vida privada y trabajo.', conceptTitle: 'Tres formas de leer el trayecto mental', concepts: [{ title: 'Señal matinal', body: 'Lo que sientes antes de salir puede revelar el peso de toda la jornada.' }, { title: 'Zona de transición', body: 'El trayecto conecta psicológicamente el yo privado y el yo laboral.' }, { title: 'Pista de recuperación', body: 'Rutinas pequeñas, ruta y expectativas ajustadas pueden aliviar la carga mental.' }], faqTitle: 'Preguntas frecuentes', faqs: [{ question: '¿Qué tan preciso es el resultado?', answer: 'Resume patrones emocionales del trayecto que aparecen en tus respuestas. Etapa laboral, sueño y tráfico pueden cambiarlo.' }, { question: '¿Un resultado difícil significa cambiar de trabajo?', answer: 'No necesariamente. El resultado organiza señales de carga y ayuda a pensar en ajustes pequeños o cambios estructurales.' }, { question: '¿Cómo usarlo?', answer: 'Registra emociones repetidas antes y después del trayecto, más momentos de recuperación, y diseña una rutina de transición.' }], disclaimer: 'Los resultados del test mental del trayecto son para autoconocimiento y conversación. No los uses como base para diagnóstico, contratación o juicios definitivos sobre relaciones.' },
};

const c = content[locale] ?? content.en;
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
const quizJsonLd = buildQuizJsonLd({
  name: m.title,
  description: m.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  inLanguage: locale,
  questions: [],
});

---
<Layout title={m.title} description={m.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(quizJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="mx-auto max-w-2xl px-4 py-10">
    <CommuteMentalTest client:load locale={locale} />
    <section class="mt-10 border-t border-violet-100 pt-8"><h2 class="text-2xl font-bold text-violet-950">{c.introTitle}</h2><p class="mt-4 leading-8 text-violet-800">{c.intro}</p></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.conceptTitle}</h2><div class="mt-4 grid gap-4 md:grid-cols-3">{c.concepts.map((item) => (<article class="rounded-xl border border-violet-100 bg-white p-4"><h3 class="font-semibold text-violet-950">{item.title}</h3><p class="mt-2 text-sm leading-6 text-violet-700">{item.body}</p></article>))}</div></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.faqTitle}</h2><div class="mt-4 divide-y divide-violet-100 rounded-xl border border-violet-100 bg-white">{c.faqs.map((faq) => (<details class="group p-4"><summary class="cursor-pointer list-none font-semibold text-violet-950">{faq.question}</summary><p class="mt-3 text-sm leading-6 text-violet-700">{faq.answer}</p></details>))}</div></section>
    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>
    <RelatedTools locale={locale} tools={['burnout','lethargy','anxiety','sleepType']} current="commuteMental" />
  <PrintReportButton locale={locale} />
  <TestSourceNote locale={locale} note={TEST_SOURCE_NOTES['commute-mental']} />
  </div>
</Layout>
