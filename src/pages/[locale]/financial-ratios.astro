---
import Layout from "../../layouts/Layout.astro";
import { LOCALES } from "../../i18n";
import type { Locale } from "../../i18n";
import FinancialRatioExplorer from "../../components/tools/FinancialRatioExplorer";

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const BASE = "https://oiyo.net";

const meta: Record<string, { title: string; description: string }> = {
  ko: {
    title: "재무비율 탐색기 — 유동비율·부채비율·ROE를 표에서 색으로",
    description: "샘플 재무상태표·손익계산서에서 재무비율을 고르면 분자·분모 계정이 두 색으로 이어집니다. 유동비율=유동자산/유동부채처럼 공식·계산·해석을 인터랙티브하게 배우는 무료 도구.",
  },
  en: {
    title: "Financial Ratio Explorer — See Current Ratio, ROE in the Statements",
    description: "Pick a financial ratio on a sample balance sheet and income statement and watch its numerator and denominator light up in two colors. Learn current ratio, debt ratio, ROE and more interactively, free.",
  },
  ja: {
    title: "財務比率エクスプローラー — 流動比率・ROEを表で色分け",
    description: "サンプルの貸借対照表・損益計算書で財務比率を選ぶと、分子・分母の勘定科目が2色で連動。流動比率=流動資産/流動負債のように公式・計算・解釈をインタラクティブに学ぶ無料ツール。",
  },
  zh: {
    title: "财务比率探索器 — 在报表中用颜色看流动比率·ROE",
    description: "在示例资产负债表与利润表中选择财务比率，其分子与分母科目会以两种颜色联动高亮。像流动比率=流动资产/流动负债一样，交互式学习公式、计算与解读的免费工具。",
  },
  fr: {
    title: "Explorateur de ratios financiers — Ratio de liquidité, ROE",
    description: "Choisissez un ratio sur un bilan et un compte de résultat d'exemple : son numérateur et son dénominateur s'illuminent en deux couleurs. Apprenez le ratio de liquidité, le ROE et plus, gratuitement.",
  },
  es: {
    title: "Explorador de ratios financieros — Ratio corriente, ROE",
    description: "Elige un ratio en un balance y una cuenta de resultados de ejemplo y observa cómo su numerador y denominador se iluminan en dos colores. Aprende el ratio corriente, ROE y más, gratis.",
  },
};
const m = meta[locale] ?? meta.en;

const content: Record<string, {
  lead: string; faqTitle: string; faq: { q: string; a: string }[];
  relatedTitle: string; related: { href: string; label: string; desc: string; external?: boolean }[];
}> = {
  ko: {
    lead: "재무비율은 공식만 외우면 금방 잊습니다. 하지만 '이 숫자가 표의 어디에서 왔는지'를 눈으로 보면 오래 남습니다. 비율을 고르면 분자(파랑)와 분모(주황)가 재무제표에서 그대로 이어져, 유동비율=유동자산/유동부채가 어떻게 계산되는지 한눈에 들어옵니다.",
    faqTitle: "자주 묻는 질문",
    faq: [
      { q: "유동비율은 무엇을 뜻하나요?", a: "유동비율 = 유동자산 ÷ 유동부채입니다. 1년 안에 현금화할 수 있는 자산으로 1년 안에 갚아야 할 빚을 얼마나 감당할 수 있는지를 봅니다. 100% 이상이면 단기 지급능력이 있다고 보며, 통상 150~200%를 선호합니다." },
      { q: "부채비율이 높으면 무조건 나쁜가요?", a: "부채비율 = 부채총계 ÷ 자본총계입니다. 높을수록 빚 의존도가 크지만, 업종에 따라 적정 수준이 다릅니다. 제조·인프라는 자본집약적이라 상대적으로 높고, 통상 200% 이하를 건전하게 봅니다." },
      { q: "ROE와 ROA의 차이는?", a: "ROE(자기자본이익률)=당기순이익÷자본은 '주주 돈으로 얼마를 벌었나', ROA(총자산이익률)=당기순이익÷자산은 '전체 자산을 얼마나 효율적으로 굴렸나'를 봅니다. 빚을 많이 쓰면 ROE는 올라가도 ROA는 그대로일 수 있어, 둘을 함께 봐야 합니다." },
      { q: "이 수치로 실제 투자 판단을 해도 되나요?", a: "아니요. 여기 값은 학습용 가상 회사 예시이며, 적정 기준도 업종·상황마다 다릅니다. 실제 판단은 여러 해 추세와 동종업계 비교, 공시자료를 함께 봐야 합니다." },
    ],
    relatedTitle: "이어서 배우기",
    related: [
      { href: "/income-statement-game", label: "손익계산서 게임", desc: "계정 분류로 이익 단계 익히기." },
      { href: "/tax-calendar", label: "세금 신고 캘린더", desc: "부가세·법인세 신고 일정." },
      { href: "https://blog.oiyo.net/ko/academy-accounting-basics-ch1/", label: "회계학 개론", desc: "재무제표 기초 강의.", external: true },
    ],
  },
  en: {
    lead: "Financial ratios are easy to forget when they're just formulas. Seeing where each number comes from in the statements makes them stick. Pick a ratio and its numerator (blue) and denominator (amber) light up across the balance sheet and income statement — so current ratio = current assets / current liabilities becomes obvious.",
    faqTitle: "FAQ",
    faq: [
      { q: "What does the current ratio mean?", a: "Current ratio = current assets ÷ current liabilities. It measures whether assets convertible to cash within a year can cover debts due within a year. ≥100% signals short-term liquidity; 150–200% is often preferred." },
      { q: "Is a high debt ratio always bad?", a: "Debt-to-equity = total liabilities ÷ total equity. Higher means more reliance on debt, but the healthy level varies by industry — capital-intensive sectors run higher. ≤200% is generally viewed as sound." },
      { q: "ROE vs ROA?", a: "ROE = net income ÷ equity ('return on shareholders' money'); ROA = net income ÷ assets ('how efficiently all assets are used'). Heavy borrowing can lift ROE while ROA stays flat, so read them together." },
      { q: "Can I use these numbers for real investing?", a: "No — the figures are an illustrative sample, and healthy ranges vary by industry. Real analysis needs multi-year trends, peer comparison and official filings." },
    ],
    relatedTitle: "Learn more",
    related: [
      { href: "/income-statement-game", label: "Income statement game", desc: "Classify accounts to learn profit steps." },
      { href: "/tax-calendar", label: "Tax calendar", desc: "VAT & corporate tax deadlines." },
    ],
  },
};
const c = content[locale] ?? content.en;

const url = `${BASE}/${locale}/financial-ratios`;
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: c.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
const appLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: m.title.split(" — ")[0],
  url,
  applicationCategory: "FinanceApplication",
  operatingSystem: "Web browser",
  offers: { "@type": "Offer", price: "0", priceCurrency: "KRW" },
  inLanguage: locale,
  publisher: { "@id": "https://oiyo.net/#organization" },
};
---

<Layout title={m.title} description={m.description}>
  <main class="mx-auto max-w-3xl px-4 py-8">
    <p class="mb-6 text-sm leading-relaxed text-gray-600">{c.lead}</p>

    <FinancialRatioExplorer client:load locale={locale} />

    <section class="mt-12 border-t border-gray-100 pt-8">
      <h2 class="text-lg font-black text-gray-900">{c.faqTitle}</h2>
      <div class="mt-4 space-y-4">
        {c.faq.map((f) => (
          <div>
            <h3 class="text-sm font-bold text-gray-800">{f.q}</h3>
            <p class="mt-1 text-sm leading-relaxed text-gray-600">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-lg font-black text-gray-900">{c.relatedTitle}</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {c.related.map((r) => (
          <a href={r.href} class="rounded-xl border border-gray-200 p-3 transition-colors hover:border-emerald-300" {...(r.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
            <div class="text-sm font-bold text-gray-800">{r.label}</div>
            <div class="mt-0.5 text-xs text-gray-500">{r.desc}</div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(appLd)} />
</Layout>
