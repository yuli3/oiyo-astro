const c = C[locale];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Layout title={c.title} description={c.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <section class="mx-auto max-w-2xl px-4 py-10">
    <p class="text-xs font-black tracking-widest text-primary">{c.eyebrow}</p>
    <h1 class="mt-3 text-3xl font-black tracking-tight">{c.h1}</h1>
    <p class="mt-3 text-base leading-relaxed text-muted-foreground">{c.lead}</p>

    <div class="mt-8">
      <MythGuardianTest client:load locale={locale} figures={figures} />
    </div>

    <p class="mt-8">
      <a href={`/${locale}/myth/`} class="inline-flex min-h-11 items-center rounded-xl border border-border bg-card px-4 font-bold hover:border-primary/50">📚 {c.hub}</a>
    </p>

    <section class="mt-10">
      <h2 class="text-2xl font-black">{c.faqHeading}</h2>
      <div class="mt-4 divide-y rounded-xl border bg-card">
        {c.faqs.map((f) => (
          <details class="p-4">
            <summary class="cursor-pointer font-semibold">{f.q}</summary>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </section>
</Layout>
