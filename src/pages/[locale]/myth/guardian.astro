---
/**
 * 나의 수호신 찾기. 2026-11-09 세운 결재(발굴 1번), company-brain
 * think-tank/2026-11-09-oiyo-content-discovery.md. 신화 인물 글 100편이 가장 넓은
 * 노출 묶음이라, 검사 결과가 그 글로 이어지게 만든다. 결과 설명은 글 요약을 그대로 쓴다.
 */
import Layout from '../../../layouts/Layout.astro';
import MythGuardianTest from '../../../components/tools/myth/MythGuardianTest';
import { getCollection } from 'astro:content';
import { LOCALES, type Locale } from '../../../i18n';
import { GUARDIAN_IDS, mythNameFromTitle } from '../../../lib/myth-guardian';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const entries = await getCollection('articles', (e) => e.data.locale === locale);
const figures: Record<string, { name: string; description: string }> = {};
for (const e of entries) {
  const slug = e.id.split('/').pop()!.replace(/\.mdx$/, '');
  const id = slug.replace(/^meaning-of-myth-/, '');
  if (slug.startsWith('meaning-of-myth-') && GUARDIAN_IDS.includes(id)) {
    figures[id] = { name: mythNameFromTitle(e.data.title), description: e.data.description };
  }
}

