---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import SleepChronotypeTest from '../../../components/tests/SleepChronotypeTest';
import RelatedTools from '../../../components/shared/RelatedTools.astro';
import { buildQuizJsonLd } from '../../../lib/seo/quiz-json-ld';
import TestSourceNote from '../../../components/shared/TestSourceNote.astro';
import { TEST_SOURCE_NOTES } from '../../../data/test-source-notes';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '수면 유형 테스트 — 나는 아침형인가 저녁형인가?', description: '나의 일주기 리듬(크로노타입)을 알아보고 최적의 수면·생산성 시간대를 파악하세요.' },
  en: { title: 'Sleep Chronotype Test — Are You a Morning or Evening Person?', description: 'Discover your circadian rhythm chronotype and find your optimal sleep and productivity windows.' },
  ja: { title: '睡眠タイプテスト — 朝型か夜型か？', description: '自分のサーカディアンリズム（クロノタイプ）を知り、最適な睡眠と生産性の時間帯を把握しましょう。' },
  zh: { title: '睡眠类型测试 — 你是晨型人还是夜型人？', description: '了解你的昼夜节律（时间类型），找到最佳睡眠和生产力时间段。' },
  fr: { title: 'Test de Chronotype — Êtes-vous du matin ou du soir?', description: 'Découvrez votre chronotype circadien et trouvez vos fenêtres optimales de sommeil et de productivité.' },
  es: { title: 'Test de Cronotipo — ¿Eres madrugador/a o noctámbulo/a?', description: 'Descubre tu cronotipo circadiano y encuentra tus ventanas óptimas de sueño y productividad.' },
};
const m = meta[locale] ?? meta.en;

const content: Record<Locale, { introTitle: string; intro: string; conceptTitle: string; concepts: { title: string; body: string }[]; faqTitle: string; faqs: { question: string; answer: string }[]; disclaimer: string; }> = {
  ko: { introTitle: '수면 유형은 사람을 단정하는 라벨이 아니라 나의 하루 리듬을 보는 렌즈입니다', intro: '수면 유형 테스트는 아침형과 저녁형 사이에서 에너지, 집중, 졸림이 움직이는 시간대를 살펴봅니다. 결과는 생활을 고정하는 이름표가 아니라 하루를 더 잘 배치하기 위한 참고입니다.', conceptTitle: '수면 유형을 읽는 세 가지 관점', concepts: [{ title: '크로노타입', body: '타고난 리듬과 생활 습관이 만난 현재의 수면 경향입니다.' }, { title: '집중 시간대', body: '가장 맑은 시간과 느려지는 시간을 알면 일정 조정에 도움이 됩니다.' }, { title: '생활 맥락', body: '일, 학교, 돌봄처럼 외부 일정이 결과에 영향을 줄 수 있습니다.' }], faqTitle: '자주 묻는 질문', faqs: [{ question: '수면 유형 결과는 얼마나 정확한가요?', answer: '현재 답변에 나타난 리듬 경향을 요약한 참고 자료입니다. 계절, 일정, 피로도에 따라 달라질 수 있습니다.' }, { question: '아침형이나 저녁형은 바뀔 수 있나요?', answer: '네. 나이, 빛 노출, 업무 시간, 수면 습관에 따라 리듬은 어느 정도 조정될 수 있습니다.' }, { question: '결과를 어떻게 활용하면 좋나요?', answer: '중요한 일은 집중이 잘 되는 시간대에 두고, 느려지는 시간에는 회복이나 단순 작업을 배치해 보세요.' }], disclaimer: '수면 유형 테스트 결과는 자기 이해와 대화를 위한 참고입니다. 진단, 채용, 관계의 단정적 판단 근거로 사용하지 마세요.' },
  en: { introTitle: 'Sleep chronotype is a lens for your daily rhythm, not a label that defines you', intro: 'The sleep chronotype test looks at when energy, focus, and sleepiness move across the morning-evening spectrum. The result is not a fixed lifestyle label; it is a reference for arranging your day more realistically.', conceptTitle: 'Three ways to read sleep type', concepts: [{ title: 'Chronotype', body: 'Your current sleep tendency where natural rhythm and habits meet.' }, { title: 'Focus window', body: 'Knowing clear and slow hours can help you arrange your day.' }, { title: 'Life context', body: 'Work, school, caregiving, and schedules can shape the result.' }], faqTitle: 'Frequently asked questions', faqs: [{ question: 'How accurate is the sleep type result?', answer: 'It summarizes rhythm tendencies shown in your current answers. Season, schedule, and fatigue can shift it.' }, { question: 'Can morning or evening type change?', answer: 'Yes. Age, light exposure, work hours, and sleep habits can adjust rhythm to some degree.' }, { question: 'How should I use the result?', answer: 'Place demanding work in clearer hours and use slower hours for recovery or simpler tasks.' }], disclaimer: 'Sleep type results are for self-understanding and conversation. Do not use them as a basis for diagnosis, hiring, or definitive relationship judgments.' },
  ja: { introTitle: '睡眠タイプは人を決めつけるラベルではなく、一日のリズムを見るレンズです', intro: '睡眠タイプテストは朝型と夜型の間でエネルギー、集中、眠気が動く時間帯を見ます。結果は生活を固定する名前ではなく、一日を現実的に整える参考です。', conceptTitle: '睡眠タイプを読む三つの視点', concepts: [{ title: 'クロノタイプ', body: '生まれ持ったリズムと生活習慣が交わる現在の睡眠傾向です。' }, { title: '集中の時間帯', body: '頭が冴える時間と遅くなる時間を知ると予定を整えやすくなります。' }, { title: '生活の文脈', body: '仕事、学校、介護など外部予定が結果に影響することがあります。' }], faqTitle: 'よくある質問', faqs: [{ question: '睡眠タイプの結果はどれくらい正確ですか？', answer: '現在の回答に表れたリズム傾向の要約です。季節、予定、疲労度で変わることがあります。' }, { question: '朝型や夜型は変わりますか？', answer: '変わります。年齢、光の浴び方、勤務時間、睡眠習慣によってリズムはある程度調整されます。' }, { question: '結果はどう使えばよいですか？', answer: '重要な作業は頭が冴える時間に置き、遅くなる時間は回復や単純作業に使ってみてください。' }], disclaimer: '睡眠タイプテストの結果は自己理解と対話のための参考です。診断、採用、人間関係の断定的判断には使わないでください。' },
  zh: { introTitle: '睡眠类型是观察日常节律的镜片，不是定义人的标签', intro: '睡眠类型测试观察晨型与夜型之间，能量、专注和困意变化的时间段。结果不是固定生活方式的标签，而是更现实安排一天的参考。', conceptTitle: '理解睡眠类型的三个角度', concepts: [{ title: '时间类型', body: '是天生节律与生活习惯交汇后的当前睡眠倾向。' }, { title: '专注窗口', body: '了解清醒和变慢的时间，有助于安排一天。' }, { title: '生活情境', body: '工作、学校、照护等外部日程会影响结果。' }], faqTitle: '常见问题', faqs: [{ question: '睡眠类型结果有多准确？', answer: '它概括的是当前回答中的节律倾向。季节、日程和疲劳程度会影响结果。' }, { question: '晨型或夜型会改变吗？', answer: '会。年龄、光照、工作时间和睡眠习惯都可能在一定程度上调整节律。' }, { question: '应该如何使用结果？', answer: '把重要任务放在更清醒的时间，把较慢的时间留给恢复或简单任务。' }], disclaimer: '睡眠类型测试结果仅用于自我理解与对话，请勿作为诊断、招聘或关系定论的依据。' },
  fr: { introTitle: 'Le chronotype est une lentille sur votre rythme quotidien, pas une étiquette qui vous définit', intro: 'Le test de chronotype observe les moments où énergie, concentration et somnolence varient entre matin et soir. Le résultat n’est pas une étiquette fixe, mais un repère pour organiser la journée plus justement.', conceptTitle: 'Trois façons de lire le type de sommeil', concepts: [{ title: 'Chronotype', body: 'Votre tendance actuelle, à la rencontre du rythme naturel et des habitudes.' }, { title: 'Fenêtre de concentration', body: 'Connaître les heures claires et lentes aide à organiser la journée.' }, { title: 'Contexte de vie', body: 'Travail, école, soins et horaires peuvent influencer le résultat.' }], faqTitle: 'Questions fréquentes', faqs: [{ question: 'Le résultat est-il fiable ?', answer: 'Il résume les tendances de rythme visibles dans vos réponses. Saison, horaires et fatigue peuvent le modifier.' }, { question: 'Matin ou soir peut-il changer ?', answer: 'Oui. Âge, exposition à la lumière, horaires de travail et habitudes de sommeil peuvent ajuster le rythme.' }, { question: 'Comment l’utiliser ?', answer: 'Placez les tâches exigeantes dans les heures claires et gardez les heures lentes pour récupérer ou simplifier.' }], disclaimer: 'Les résultats de chronotype servent à la compréhension de soi et au dialogue. Ne les utilisez pas comme base de diagnostic, de recrutement ou de verdict relationnel.' },
  es: { introTitle: 'El cronotipo es una lente sobre tu ritmo diario, no una etiqueta que te define', intro: 'El test de cronotipo observa cuándo cambian energía, foco y somnolencia entre mañana y noche. El resultado no es una etiqueta fija de estilo de vida, sino una referencia para organizar el día con más realismo.', conceptTitle: 'Tres formas de leer el tipo de sueño', concepts: [{ title: 'Cronotipo', body: 'Tu tendencia actual donde se encuentran ritmo natural y hábitos.' }, { title: 'Ventana de foco', body: 'Saber tus horas claras y lentas ayuda a organizar el día.' }, { title: 'Contexto de vida', body: 'Trabajo, escuela, cuidados y horarios pueden influir en el resultado.' }], faqTitle: 'Preguntas frecuentes', faqs: [{ question: '¿Qué tan preciso es el resultado?', answer: 'Resume tendencias de ritmo que aparecen en tus respuestas. Estación, horario y cansancio pueden cambiarlo.' }, { question: '¿Puede cambiar ser matutino o nocturno?', answer: 'Sí. Edad, luz, horarios de trabajo y hábitos de sueño pueden ajustar el ritmo en cierto grado.' }, { question: '¿Cómo usarlo?', answer: 'Pon tareas exigentes en horas más claras y usa horas lentas para recuperación o tareas simples.' }], disclaimer: 'Los resultados de cronotipo son para autoconocimiento y conversación. No los uses como base para diagnóstico, contratación o juicios definitivos sobre relaciones.' },
};

const c = content[locale] ?? content.en;
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
const quizJsonLd = buildQuizJsonLd({
  name: m.title,
  description: m.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  inLanguage: locale,
  questions: [],
});

---
<Layout title={m.title} description={m.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(quizJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="mx-auto max-w-2xl px-4 py-10">
    <SleepChronotypeTest client:load locale={locale} />
    <section class="mt-10 border-t border-violet-100 pt-8"><h2 class="text-2xl font-bold text-violet-950">{c.introTitle}</h2><p class="mt-4 leading-8 text-violet-800">{c.intro}</p></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.conceptTitle}</h2><div class="mt-4 grid gap-4 md:grid-cols-3">{c.concepts.map((item) => (<article class="rounded-xl border border-violet-100 bg-white p-4"><h3 class="font-semibold text-violet-950">{item.title}</h3><p class="mt-2 text-sm leading-6 text-violet-700">{item.body}</p></article>))}</div></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.faqTitle}</h2><div class="mt-4 divide-y divide-violet-100 rounded-xl border border-violet-100 bg-white">{c.faqs.map((faq) => (<details class="group p-4"><summary class="cursor-pointer list-none font-semibold text-violet-950">{faq.question}</summary><p class="mt-3 text-sm leading-6 text-violet-700">{faq.answer}</p></details>))}</div></section>
    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>
    <RelatedTools locale={locale} tools={['lethargy','burnout','commuteMental','eq']} current="sleepType" />
  <TestSourceNote locale={locale} note={TEST_SOURCE_NOTES['sleep-type']} />
  </div>
</Layout>
