---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import SleepChronotypeTest from '../../../components/tests/SleepChronotypeTest';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '수면 유형 테스트 — 나는 아침형인가 저녁형인가?', description: '나의 일주기 리듬(크로노타입)을 알아보고 최적의 수면·생산성 시간대를 파악하세요.' },
  en: { title: 'Sleep Chronotype Test — Are You a Morning or Evening Person?', description: 'Discover your circadian rhythm chronotype and find your optimal sleep and productivity windows.' },
  ja: { title: '睡眠タイプテスト — 朝型か夜型か？', description: '自分のサーカディアンリズム（クロノタイプ）を知り、最適な睡眠と生産性の時間帯を把握しましょう。' },
  cn: { title: '睡眠类型测试 — 你是晨型人还是夜型人？', description: '了解你的昼夜节律（时间类型），找到最佳睡眠和生产力时间段。' },
  fr: { title: 'Test de Chronotype — Êtes-vous du matin ou du soir?', description: 'Découvrez votre chronotype circadien et trouvez vos fenêtres optimales de sommeil et de productivité.' },
  es: { title: 'Test de Cronotipo — ¿Eres madrugador/a o noctámbulo/a?', description: 'Descubre tu cronotipo circadiano y encuentra tus ventanas óptimas de sueño y productividad.' },
};
const m = meta[locale] ?? meta.en;
---
<Layout title={m.title} description={m.description} locale={locale}>
  <main class="mx-auto max-w-2xl px-4 py-10">
    <SleepChronotypeTest client:load locale={locale} />
  </main>
</Layout>
