---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import AssertivenessTest from '../../components/tests/AssertivenessTest';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<string, { title: string; description: string }> = {
  ko: {
    title: "자기주장성 테스트 — 나는 내 생각과 경계를 얼마나 표현하는가?",
    description: "라스 자기주장 척도(RAS) 기반 14문항 자가진단. 거절하기, 생각과 감정 표현, 건강한 심리적 경계 설정 능력을 정밀 평가하여 소극형·주장형·공격형 3가지 소통 패턴과 당당한 의사 표현 훈련법을 무료로 확인하세요.",
  },
  en: {
    title: "Assertiveness Test — How Well Do You Express Your Thoughts and Boundaries?",
    description: "Assess your communication assertiveness with the 14-question Rathus (RAS) test. Evaluate boundary setting and self-expression to speak up with calm confidence.",
  },
  ja: {
    title: "アサーティブネス（自己主張）テスト — 自分の考えと境界をどれくらい表現できる？",
    description: "レイサス自己主張尺度（RAS）に基づく14問の診断。嫌なことを断る力、感情の率直な表現、健全なバウンダリー（境界線）設定力を測定し、受動・主張・攻撃の3大パターンと自信ある対話法を確認しましょう。",
  },
  fr: {
    title: "Test d'Affirmation de Soi — À quel point exprimez-vous vos pensées et limites ?",
    description: "Test d'affirmation de soi basé sur l'échelle RAS en 14 questions. Évaluez votre capacité à poser des limites et à exprimer vos besoins avec assurance sereine.",
  },
  es: {
    title: "Test de Asertividad — ¿Cuánto expresas tus pensamientos y límites?",
    description: "Test de asertividad basado en la escala de Rathus (RAS) en 14 preguntas. Evalúa tu capacidad de poner límites y expresar tus opiniones con firmeza y respeto.",
  },
  zh: {
    title: "自我主张（果敢度）测试 — 你有多能表达想法与界限？",
    description: "基于拉瑟斯自我主张量表（RAS）的14题果敢度专业自测。精确评估勇敢拒绝、真实情感表达与健康心理界限设定能力，深入诊断消极、果断与攻击3大沟通风格，即刻获取坚定表达自我的心理训练法。",
  },
};
const m = meta[locale] ?? meta.en ?? Object.values(meta)[0];
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <AssertivenessTest locale={locale as any} client:load />
  </div>
</Layout>
