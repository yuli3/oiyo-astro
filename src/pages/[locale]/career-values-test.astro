---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import CareerValuesTest from '../../components/tests/CareerValuesTest';
import BlogArticleLink from '../../components/shared/BlogArticleLink.astro';
import { CAREER_VALUES_RELEASE_GATE } from '../../../config/assessment-release-gates.js';

export async function getStaticPaths() { return LOCALES.map((locale) => ({ params: { locale } })); }

const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '직업 가치관 탐색 — 18문항·6차원 업무환경 성찰', description: '안정성·성취·자율성·기여·창의성·인정의 6차원을 18문항으로 살펴보고, 자신에게 중요한 업무환경 특징을 정리하세요.' },
  en: { title: 'Career Values Reflection — 18 Items, Six Work-Environment Dimensions', description: 'Reflect on Security, Achievement, Autonomy, Contribution, Creativity, and Recognition, then identify work-environment features worth exploring.' },
  ja: { title: '仕事の価値観リフレクション — 18項目・6次元', description: '安定性・達成・自律性・貢献・創造性・承認の6次元を振り返り、確認したい職場環境の特徴を整理します。' },
  zh: { title: '职业价值观反思 — 18题、六维工作环境探索', description: '从稳定、成就、自主、贡献、创造与认可六个维度反思，并整理值得进一步了解的工作环境特征。' },
  fr: { title: 'Valeurs professionnelles — Réflexion en 18 items et six dimensions', description: 'Explorez sécurité, accomplissement, autonomie, contribution, créativité et reconnaissance, puis les caractéristiques de travail à examiner.' },
  es: { title: 'Valores profesionales — Reflexión de 18 ítems y seis dimensiones', description: 'Explora seguridad, logro, autonomía, contribución, creatividad y reconocimiento, y los rasgos del entorno laboral que conviene investigar.' },
};
const content: Record<Locale, { heading: string; intro: string; method: string; limits: string; faqTitle: string; faqs: { question: string; answer: string }[] }> = {
  ko: { heading: '직업 이름보다 업무환경의 조건을 살펴봅니다', intro: '같은 직업도 조직, 팀, 계약, 역할에 따라 실제 환경이 크게 달라집니다. 결과를 특정 직업의 정답으로 읽지 말고, 채용 공고와 면담에서 확인할 조건을 만드는 데 활용하세요.', method: '각 차원은 3문항의 1~5 응답을 합산한 뒤 0~100 범위로 환산합니다. 점수가 같으면 공동 순위이며, 사람끼리 비교하는 백분위가 아닙니다.', limits: 'OIYO가 작성한 성찰 도구로 심리측정 타당화·규준화가 이루어지지 않았습니다. 중요한 진로 결정은 흥미, 역량, 건강, 소득, 기회와 실제 노동시장 정보를 함께 검토하세요.', faqTitle: '자주 묻는 질문', faqs: [{ question: '이 결과로 직업을 고를 수 있나요?', answer: '아니요. 결과는 업무환경 질문을 만드는 재료이며 직업 적합도 판정이 아닙니다.' }, { question: '점수가 높을수록 더 좋은가요?', answer: '아닙니다. 현재 중요하게 응답한 정도를 요약할 뿐 가치의 우열이나 능력을 뜻하지 않습니다.' }] },
  en: { heading: 'Explore work conditions, not job-title verdicts', intro: 'The same occupation can feel very different across organizations, teams, contracts, and roles. Use the result to form questions for job descriptions and conversations—not as a list of correct careers.', method: 'Each dimension sums three 1–5 responses and maps the total to 0–100. Equal scores share rank; these are not population percentiles.', limits: 'This OIYO-authored reflection tool has not been psychometrically validated or normed. Important career decisions also require interests, skills, health, income needs, opportunities, and current labor-market evidence.', faqTitle: 'Frequently asked questions', faqs: [{ question: 'Can this choose a career for me?', answer: 'No. It helps generate questions about work environments; it does not determine career fit.' }, { question: 'Is a higher score better?', answer: 'No. It summarizes current importance ratings, not ability or the quality of a value.' }] },
  ja: { heading: '職業名ではなく、働く条件を見ます', intro: '同じ職業でも組織、チーム、契約、役割で環境は変わります。結果は正解の職業一覧ではなく、求人や面談で確認する質問づくりに使ってください。', method: '各次元は3項目の1〜5回答を合計し0〜100に換算します。同点は同順位で、集団内の百分位ではありません。', limits: 'OIYO独自の省察ツールで、心理測定上の妥当化や規準化はされていません。重要な判断では興味、能力、健康、収入、機会、市場情報も検討してください。', faqTitle: 'よくある質問', faqs: [{ question: '職業を選べますか？', answer: 'いいえ。職場環境を確認する質問の材料で、職業適合判定ではありません。' }, { question: '高得点ほど良いですか？', answer: 'いいえ。現在の重要度を要約するだけで、能力や価値の優劣ではありません。' }] },
  zh: { heading: '关注工作条件，而不是职业名称的结论', intro: '同一职业在不同组织、团队、合同与职责中可能完全不同。请用结果形成查看招聘信息或面谈时的问题，而不是寻找唯一正确的职业。', method: '每个维度汇总三题的1至5分回答并换算为0至100。同分并列，分数不是群体百分位。', limits: '这是OIYO原创反思工具，尚未进行心理测量验证或常模化。重要职业决定还需结合兴趣、能力、健康、收入需求、机会与当前劳动力市场信息。', faqTitle: '常见问题', faqs: [{ question: '它能替我选择职业吗？', answer: '不能。它帮助你提出工作环境问题，不判断职业适配。' }, { question: '分数越高越好吗？', answer: '不是。它只概括当前的重要程度，不代表能力或价值高低。' }] },
  fr: { heading: 'Explorez les conditions de travail, pas un verdict de métier', intro: 'Un même métier varie selon l’organisation, l’équipe, le contrat et le rôle. Servez-vous du résultat pour préparer des questions, pas pour obtenir une liste de métiers corrects.', method: 'Chaque dimension additionne trois réponses de 1 à 5 puis les convertit sur 100. Les égalités partagent le rang ; ce ne sont pas des percentiles.', limits: 'Cet outil OIYO n’a pas été validé ni étalonné psychométriquement. Une décision importante doit aussi considérer intérêts, compétences, santé, revenus, possibilités et marché actuel.', faqTitle: 'Questions fréquentes', faqs: [{ question: 'Peut-il choisir un métier ?', answer: 'Non. Il aide à formuler des questions sur l’environnement, sans juger l’adéquation.' }, { question: 'Un score élevé est-il meilleur ?', answer: 'Non. Il résume l’importance actuelle, pas une capacité ni la qualité d’une valeur.' }] },
  es: { heading: 'Explora condiciones laborales, no veredictos de profesión', intro: 'Una misma profesión cambia según organización, equipo, contrato y función. Usa el resultado para preparar preguntas, no para obtener una lista de profesiones correctas.', method: 'Cada dimensión suma tres respuestas de 1 a 5 y las convierte a 0–100. Los empates comparten rango; no son percentiles poblacionales.', limits: 'Esta herramienta OIYO no ha sido validada ni baremada psicométricamente. Una decisión importante también exige intereses, habilidades, salud, ingresos, oportunidades y datos actuales del mercado.', faqTitle: 'Preguntas frecuentes', faqs: [{ question: '¿Puede elegir una profesión?', answer: 'No. Ayuda a formular preguntas sobre entornos, sin determinar ajuste profesional.' }, { question: '¿Una puntuación alta es mejor?', answer: 'No. Resume la importancia actual, no la capacidad ni la calidad de un valor.' }] },
};
const m = meta[locale] ?? meta.en;
const c = content[locale] ?? content.en;
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
const appJsonLd = { '@context': 'https://schema.org', '@type': 'WebApplication', name: m.title, description: m.description, url: new URL(Astro.url.pathname, Astro.site).toString(), inLanguage: locale, applicationCategory: 'LifestyleApplication', offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' } };
---

<Layout title={m.title} description={m.description} locale={locale} noindex={!CAREER_VALUES_RELEASE_GATE.indexable}>
  <script type="application/ld+json" set:html={JSON.stringify(appJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="container mx-auto max-w-3xl px-4 py-8">
    <CareerValuesTest locale={locale} client:load />
    <section class="mt-12 border-t border-green-100 pt-8"><h2 class="text-2xl font-bold text-green-950">{c.heading}</h2><p class="mt-4 leading-8 text-green-900">{c.intro}</p><p class="mt-4 leading-8 text-green-900">{c.method}</p></section>
    <section class="mt-8 rounded-xl border border-amber-100 bg-amber-50 p-5 text-sm leading-7 text-amber-950">{c.limits}</section>
    <section class="mt-10"><h2 class="text-xl font-bold text-green-950">{c.faqTitle}</h2><div class="mt-4 divide-y divide-green-100 rounded-xl border border-green-100 bg-white">{c.faqs.map((faq) => <details class="p-4"><summary class="cursor-pointer font-semibold text-green-950">{faq.question}</summary><p class="mt-3 text-sm leading-6 text-green-800">{faq.answer}</p></details>)}</div></section>
    <BlogArticleLink testId="career-values-test" locale={locale} />
  </div>
</Layout>
