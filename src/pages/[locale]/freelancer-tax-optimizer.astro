---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import FreelancerTaxOptimizer from '../../components/tools/FreelancerTaxOptimizer';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "프리랜서 3.3% 종소세 환급 & 경비율 계산기 — 단순경비율 vs 간편장부 절세 비교",
    description: "원천징수 3.3% 떼인 사업소득세 환급액 계산 및 단순경비율과 간편장부(실제 영수증 지출) 중 어떤 신고 방식이 더 유리한지 2026 세법 기준으로 비교합니다.",
  },
  en: {
    title: "Freelancer 3.3% Withholding Tax Refund & Expense Ratio Optimizer",
    description: "Calculate 3.3% withholding tax refunds in Korea and compare simple expense ratio vs actual expense bookkeeping to maximize tax savings.",
  },
  ja: {
    title: "フリーランス 3.3% 源泉徴収 還付金＆経費率計算機 — 単純経費率 vs 簡易帳簿",
    description: "韓国のフリーランス・副業従事者向けに3.3％源泉徴収税の還付額と経費率による節税効果をシミュレーションします。",
  },
  zh: {
    title: "自由职业者 3.3% 代扣个税退税与费用率计算器 — 简易费用率对比简易账簿",
    description: "精准计算韩国自由职业者 3.3% 代扣税退税金额，实时对比简易费用率与实际支出凭证申报的节税效果。",
  },
  fr: {
    title: "Calculateur de Remboursement d'Impôt Freelance 3.3% en Corée",
    description: "Estimez votre remboursement d'impôt retenu à la source (3.3%) en Corée et optimisez votre déduction de frais professionnels.",
  },
  es: {
    title: "Calculadora de Devolución de Impuestos para Autónomos 3.3% en Corea",
    description: "Calcula el reembolso de la retención del 3.3% y compara la deducción fija frente a gastos reales en Corea.",
  },
};

const currentMeta = meta[locale] ?? meta.ko;
---

<Layout
  title={currentMeta.title}
  description={currentMeta.description}
  locale={locale}
>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto mb-8 text-center">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl text-foreground">
        {currentMeta.title.split('—')[0]}
      </h1>
      <p class="mt-2 text-base text-muted-foreground">
        {currentMeta.description}
      </p>
    </div>

    <FreelancerTaxOptimizer client:load locale={locale} />
  </main>
</Layout>
