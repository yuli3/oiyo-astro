---
import Layout from '../../layouts/Layout.astro';
import { LOCALES, getTranslations } from '../../i18n';
import type { Locale } from '../../i18n';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = await getTranslations(locale);
---

<Layout
  title={t('support.hero.title') || 'Support'}
  description={t('support.hero.subtitle')}
  locale={locale}
>
  <section class="relative bg-gradient-to-b from-green-50/50 to-white pt-16 pb-8 px-4 text-center">
    <div class="max-w-2xl mx-auto animate-fadeInUp">
      <h1 class="text-4xl font-serif font-black text-foreground mb-3">
        {t('support.hero.title')}
      </h1>
      <p class="text-green-700">{t('support.hero.subtitle')}</p>
    </div>
  </section>

  <section class="max-w-2xl mx-auto px-4 py-10">
    <div class="grid gap-4 mb-8">
      <!-- Categories -->
      {(['technical', 'general', 'feature_request'] as const).map((cat) => (
        <div class="bg-card rounded-2xl border border-green-50 p-5 flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center text-lg shrink-0">
            {cat === 'technical' ? '⚙️' : cat === 'feature_request' ? '💡' : '💬'}
          </div>
          <div>
            <h3 class="font-semibold text-foreground text-sm">
              {t(`support.categories.${cat}`)}
            </h3>
          </div>
        </div>
      ))}
    </div>

    <div class="bg-card rounded-2xl border border-green-50 p-8">
      <p class="font-semibold text-foreground mb-1">{t('support.contact')}</p>
      <p class="text-sm text-green-600 mb-5">{t('support.form.descriptionPlaceholder')}</p>
      <form
        name="contact"
        method="POST"
        action="https://formspree.io/f/contact"
        class="space-y-5"
      >
        <div>
          <label class="block text-sm font-semibold text-green-800 mb-1.5" for="name">
            {t('contact.name')}
          </label>
          <input
            id="name"
            name="name"
            type="text"
            required
            class="w-full px-4 py-2.5 rounded-xl border border-green-100 bg-green-50/30 text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-green-300 placeholder:text-green-300"
            placeholder={t('contact.name')}
          />
        </div>

        <div>
          <label class="block text-sm font-semibold text-green-800 mb-1.5" for="email">
            Email
          </label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full px-4 py-2.5 rounded-xl border border-green-100 bg-green-50/30 text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-green-300 placeholder:text-green-300"
            placeholder="hello@example.com"
          />
        </div>

        <div>
          <label class="block text-sm font-semibold text-green-800 mb-1.5" for="message">
            Message
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            class="w-full px-4 py-2.5 rounded-xl border border-green-100 bg-green-50/30 text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-green-300 placeholder:text-green-300 resize-none"
            placeholder={t('contact.subtitle')}
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-3 rounded-xl bg-green-700 text-white font-semibold text-sm hover:bg-green-800 transition-colors"
        >
          {t('contact.test.submit')}
        </button>
      </form>
    </div>

    <div class="mt-6 text-center text-sm text-green-500">
      <a href="mailto:support@oiyo.net" class="hover:text-green-700 transition-colors">
        support@oiyo.net
      </a>
    </div>
  </section>
</Layout>
