---
import Layout from '../../layouts/Layout.astro';
import { LOCALES, getTranslations } from '../../i18n';
import type { Locale } from '../../i18n';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = await getTranslations(locale);
// 2026-10-06 (audit S1): the form posted to Formspree's public placeholder id
// (/f/contact), so every message was silently lost while the page promised a
// reply. Until a real inbox endpoint exists, take inquiries by email only.
// Re-enable a form only with a verified endpoint.
const SUPPORT_EMAIL = 'support@oiyo.net';
---

<Layout
  title={t('support.hero.title') || 'Support'}
  description={t('support.hero.subtitle')}
  locale={locale}
>
  <section class="relative bg-gradient-to-b from-green-50/50 to-white pt-16 pb-8 px-4 text-center">
    <div class="max-w-2xl mx-auto animate-fadeInUp">
      <h1 class="text-4xl font-serif font-black text-foreground mb-3">
        {t('support.hero.title')}
      </h1>
      <p class="text-primary">{t('support.hero.subtitle')}</p>
    </div>
  </section>

  <section class="max-w-2xl mx-auto px-4 py-10">
    <div class="grid gap-4 mb-8">
      <!-- Categories -->
      {(['technical', 'general', 'feature_request'] as const).map((cat) => (
        <div class="bg-card rounded-2xl border border-green-50 p-5 flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-surface-subtle flex items-center justify-center text-lg shrink-0">
            {cat === 'technical' ? '⚙️' : cat === 'feature_request' ? '💡' : '💬'}
          </div>
          <div>
            <h3 class="font-semibold text-foreground text-sm">
              {t(`support.categories.${cat}`)}
            </h3>
          </div>
        </div>
      ))}
    </div>

    <div class="bg-card rounded-2xl border border-green-50 p-8 text-center">
      <p class="font-semibold text-foreground mb-2">{t('support.email.notice')}</p>
      <p class="text-sm text-green-600 mb-6">{t('support.email.body')}</p>
      <a
        href={`mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent(t('support.email.subject'))}`}
        class="inline-block w-full py-3 rounded-xl bg-primary text-primary-foreground font-semibold text-sm hover:bg-primary-strong transition-colors"
      >
        {t('support.email.button')}
      </a>
      <p class="mt-4 text-sm text-green-500">
        <a href={`mailto:${SUPPORT_EMAIL}`} class="hover:text-primary transition-colors">{SUPPORT_EMAIL}</a>
      </p>
    </div>
  </section>
</Layout>
