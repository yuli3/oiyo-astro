---
import Layout from '../../layouts/Layout.astro';
import { withTrailingSlash, LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import PranayamaGuide from '../../components/tools/PranayamaGuide';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<string, { title: string; description: string }> = {
  ko: {
    title: '요가 호흡(프라나야마) 가이드 — 나디쇼다나·우자이 등 8종 안내 타이머',
    description: '교호 호흡(나디쇼다나)·우자이·브라마리 등 대표 요가 호흡법 8종을 애니메이션 타이머와 단계별 설명·효과·주의사항으로 안내. 무료, 비공개.',
  },
  en: {
    title: 'Yoga Breathing (Pranayama) Guide — 8 Techniques with Guided Timer',
    description: 'Practice 8 classic pranayama techniques — alternate nostril (Nadi Shodhana), Ujjayi, Bhramari and more — with an animated pacer, step-by-step instructions, benefits and cautions. Free, private.',
  },
  ja: {
    title: 'ヨガ呼吸（プラーナーヤーマ）ガイド — 8種をタイマーで案内',
    description: '片鼻呼吸（ナディショーダナ）、ウジャイ、ブラーマリーなど代表的なヨガ呼吸法8種を、アニメーションのペーサーと手順・効果・注意点で案内。無料・非公開。',
  },
  zh: {
    title: '瑜伽呼吸（调息法）指南 — 8种技巧与引导计时器',
    description: '练习8种经典调息法，包括交替鼻孔呼吸（Nadi Shodhana）、Ujjayi、Bhramari等，配有动画节奏器、分步说明、效果和注意事项。免费、私密。',
  },
  fr: {
    title: 'Guide de respiration yoga (pranayama) — 8 techniques avec minuterie guidée',
    description: 'Pratiquez 8 techniques classiques de pranayama, dont la respiration alternée (Nadi Shodhana), Ujjayi, Bhramari et plus, avec un guide animé, des étapes, des bienfaits et des précautions. Gratuit et privé.',
  },
  es: {
    title: 'Guía de respiración yóguica (pranayama) — 8 técnicas con temporizador guiado',
    description: 'Practica 8 técnicas clásicas de pranayama, como respiración alterna (Nadi Shodhana), Ujjayi, Bhramari y más, con una guía animada, instrucciones paso a paso, beneficios y precauciones. Gratis y privado.',
  },
};
const m = meta[locale] ?? meta.en;

const content: Record<string, {
  introTitle: string;
  intro: string;
  whoTitle: string;
  who: string[];
  relatedTitle: string;
  related: { href: string; label: string; desc: string }[];
  disclaimer: string;
}> = {
  ko: {
    introTitle: '호흡을 바꾸면 마음이 바뀝니다',
    intro: '프라나야마(prāṇāyāma)는 요가의 호흡 수련으로, 들숨·멈춤·날숨의 리듬을 의식적으로 조절해 신경계를 안정시키고 집중을 키웁니다. 각 기법을 골라 화면의 원이 커지고 작아지는 흐름에 맞춰 호흡하세요. 단계별 설명과 효과·주의사항을 함께 제공합니다.',
    whoTitle: '이런 분께 좋아요',
    who: [
      '긴장·불안을 빠르게 가라앉히고 싶을 때 — 1:2 이완·브라마리',
      '집중·각성이 필요할 때 — 우자이·수리야 베다나',
      '신경계 균형을 잡고 싶을 때 — 나디쇼다나(교호 호흡)',
      '몸의 열을 식히고 싶을 때 — 시탈리(냉각 호흡)',
    ],
    relatedTitle: '함께 하면 좋은 것',
    related: [
      { href: '/breathing/timer', label: '쉼 호흡 타이머', desc: '4-7-8·박스 등 빠른 진정용 호흡.' },
      { href: '/emotion/release', label: '감정 흘려보내기', desc: '호흡과 함께 감정 내려놓기.' },
      { href: '/guild', label: '모험가 길드', desc: '매일 호흡을 퀘스트로.' },
    ],
    disclaimer: '이 도구는 일반적인 웰빙 보조용이며 의학적 치료가 아닙니다. 임신 중이거나 심혈관·호흡기 질환, 고혈압이 있다면 강한 호흡법(수리야 베다나 등) 전에 전문가와 상담하세요. 어지러우면 즉시 멈추고 평소 호흡으로 돌아옵니다.',
  },
  en: {
    introTitle: 'Change your breath, change your mind',
    intro: 'Pranayama is the breathing practice of yoga: consciously shaping the rhythm of inhale, hold and exhale to steady the nervous system and sharpen focus. Pick a technique and breathe with the circle as it grows and shrinks. Each comes with step-by-step instructions, benefits and cautions.',
    whoTitle: 'Good for',
    who: [
      'Calming tension or anxiety fast — 1:2 Relaxing, Bhramari',
      'Building focus and alertness — Ujjayi, Surya Bhedana',
      'Balancing the nervous system — Nadi Shodhana (alternate nostril)',
      'Cooling the body and mind — Sheetali',
    ],
    relatedTitle: 'Pairs well with',
    related: [
      { href: '/breathing/timer', label: 'Breathing Timer', desc: '4-7-8, box & quick-calm patterns.' },
      { href: '/emotion/release', label: 'Let Emotions Pass', desc: 'Let feelings go with the breath.' },
      { href: '/guild', label: "Adventurer's Guild", desc: 'Make breathing a daily quest.' },
    ],
    disclaimer: 'This is a general wellbeing aid, not medical treatment. If you are pregnant or have cardiovascular, respiratory or blood-pressure conditions, consult a professional before strong techniques (e.g. Surya Bhedana). If you feel dizzy, stop and return to normal breathing.',
  },
  ja: {
    introTitle: '呼吸が変わると、心も変わります',
    intro: 'プラーナーヤーマはヨガの呼吸法です。吸う・止める・吐くリズムを意識的に整え、神経系を安定させ、集中を高めます。技法を選び、円が広がったり縮んだりする動きに合わせて呼吸してください。それぞれに手順、効果、注意点が付いています。',
    whoTitle: 'こんな時に',
    who: [
      '緊張や不安をすばやく落ち着けたい時 — 1:2 リラックス、ブラーマリー',
      '集中と覚醒感を高めたい時 — ウジャイ、スーリヤ・ベーダナ',
      '神経系のバランスを整えたい時 — ナディショーダナ（片鼻交互呼吸）',
      '体と心をクールダウンしたい時 — シータリー',
    ],
    relatedTitle: '一緒に使うとよいもの',
    related: [
      { href: '/breathing/timer', label: '呼吸タイマー', desc: '4-7-8、ボックスなど素早く落ち着く呼吸パターン。' },
      { href: '/emotion/release', label: '感情を手放す', desc: '呼吸と一緒に感情を流す。' },
      { href: '/guild', label: '冒険者ギルド', desc: '呼吸を毎日のクエストに。' },
    ],
    disclaimer: 'これは一般的なウェルビーイング補助であり、医療行為ではありません。妊娠中の方、心血管・呼吸器・血圧に関する状態がある方は、強い技法（例：スーリヤ・ベーダナ）の前に専門家へ相談してください。めまいを感じたら中止し、通常の呼吸に戻ってください。',
  },
  zh: {
    introTitle: '改变呼吸，也改变心绪',
    intro: '调息法是瑜伽中的呼吸练习：有意识地塑造吸气、屏息和呼气的节奏，以稳定神经系统并提升专注。选择一种技巧，跟随圆形放大和缩小的节奏呼吸。每种技巧都包含分步说明、效果和注意事项。',
    whoTitle: '适合用于',
    who: [
      '快速安抚紧张或焦虑 — 1:2 放松、Bhramari',
      '提升专注和清醒度 — Ujjayi、Surya Bhedana',
      '平衡神经系统 — Nadi Shodhana（交替鼻孔呼吸）',
      '冷却身心 — Sheetali',
    ],
    relatedTitle: '适合搭配',
    related: [
      { href: '/breathing/timer', label: '呼吸计时器', desc: '4-7-8、方块呼吸和快速平静模式。' },
      { href: '/emotion/release', label: '让情绪流过', desc: '配合呼吸放下感受。' },
      { href: '/guild', label: '冒险者公会', desc: '把呼吸变成每日任务。' },
    ],
    disclaimer: '这是一般身心健康辅助工具，不是医疗治疗。如果你正在怀孕，或有心血管、呼吸系统或血压相关状况，请在练习较强技巧（如 Surya Bhedana）前咨询专业人士。如果感到头晕，请立即停止并回到自然呼吸。',
  },
  fr: {
    introTitle: 'Changez votre souffle, changez votre état d’esprit',
    intro: 'Le pranayama est la pratique respiratoire du yoga : façonner consciemment le rythme de l’inspiration, de la rétention et de l’expiration pour stabiliser le système nerveux et affiner la concentration. Choisissez une technique et respirez avec le cercle qui grandit et rétrécit. Chaque technique comprend des étapes, des bienfaits et des précautions.',
    whoTitle: 'Utile pour',
    who: [
      'Calmer rapidement tension ou anxiété — relaxation 1:2, Bhramari',
      'Développer concentration et vigilance — Ujjayi, Surya Bhedana',
      'Équilibrer le système nerveux — Nadi Shodhana (respiration alternée)',
      'Rafraîchir le corps et l’esprit — Sheetali',
    ],
    relatedTitle: 'À associer avec',
    related: [
      { href: '/breathing/timer', label: 'Minuteur de respiration', desc: '4-7-8, respiration carrée et modèles d’apaisement rapide.' },
      { href: '/emotion/release', label: 'Laisser passer les émotions', desc: 'Laissez les ressentis partir avec le souffle.' },
      { href: '/guild', label: 'Guilde des aventuriers', desc: 'Faites de la respiration une quête quotidienne.' },
    ],
    disclaimer: 'Ceci est une aide générale au bien-être, pas un traitement médical. Si vous êtes enceinte ou avez des troubles cardiovasculaires, respiratoires ou de tension artérielle, consultez un professionnel avant les techniques fortes (par ex. Surya Bhedana). En cas de vertige, arrêtez et revenez à une respiration normale.',
  },
  es: {
    introTitle: 'Cambia tu respiración, cambia tu mente',
    intro: 'Pranayama es la práctica de respiración del yoga: moldear conscientemente el ritmo de inhalar, retener y exhalar para estabilizar el sistema nervioso y afinar la concentración. Elige una técnica y respira con el círculo mientras crece y se reduce. Cada una incluye instrucciones paso a paso, beneficios y precauciones.',
    whoTitle: 'Bueno para',
    who: [
      'Calmar tensión o ansiedad rápidamente — relajación 1:2, Bhramari',
      'Desarrollar enfoque y alerta — Ujjayi, Surya Bhedana',
      'Equilibrar el sistema nervioso — Nadi Shodhana (respiración alterna)',
      'Refrescar cuerpo y mente — Sheetali',
    ],
    relatedTitle: 'Combina bien con',
    related: [
      { href: '/breathing/timer', label: 'Temporizador de respiración', desc: '4-7-8, cuadrada y patrones de calma rápida.' },
      { href: '/emotion/release', label: 'Dejar pasar emociones', desc: 'Suelta sentimientos con la respiración.' },
      { href: '/guild', label: 'Gremio de aventureros', desc: 'Convierte respirar en una misión diaria.' },
    ],
    disclaimer: 'Esta es una ayuda general de bienestar, no un tratamiento médico. Si estás embarazada o tienes afecciones cardiovasculares, respiratorias o de presión arterial, consulta a un profesional antes de técnicas intensas (p. ej., Surya Bhedana). Si sientes mareo, detente y vuelve a la respiración normal.',
  },
};
const c = content[locale] ?? content.en;
const localizedRelated = c.related.map((item) => ({ ...item, href: withTrailingSlash(`/${locale}${item.href}`) }));
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <PranayamaGuide locale={locale} client:load />

    <section class="mt-10 border-t border-green-100 pt-8">
      <h2 class="text-2xl font-bold text-foreground">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-green-800">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.whoTitle}</h2>
      <ul class="mt-4 space-y-3">
        {c.who.map((w) => (
          <li class="rounded-xl bg-green-50 px-4 py-3 text-sm leading-6 text-green-800">{w}</li>
        ))}
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.relatedTitle}</h2>
      <div class="mt-4 grid gap-3 md:grid-cols-3">
        {localizedRelated.map((item) => (
          <a class="rounded-xl border border-green-100 bg-card p-4 transition-colors hover:border-green-300 hover:bg-green-50" href={item.href}>
            <span class="font-semibold text-foreground">{item.label}</span>
            <span class="mt-2 block text-sm leading-6 text-green-700">{item.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">
      {c.disclaimer}
    </p>
  </div>
</Layout>
