---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import LethargyRecoveryTest from '../../../components/tests/LethargyRecoveryTest';
import WisdomNotes from '../../../components/shared/WisdomNotes.astro';
import TestContentBridge from '../../../components/shared/TestContentBridge.astro';
import { getTestBridge } from '../../../data/test-content-bridges';
import RelatedTools from '../../../components/shared/RelatedTools.astro';
import { buildQuizJsonLd } from '../../../lib/seo/quiz-json-ld';
import TestSourceNote from '../../../components/shared/TestSourceNote.astro';
import PrintReportButton from '../../../components/shared/PrintReportButton.astro';
import { TEST_SOURCE_NOTES } from '../../../data/test-source-notes';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '무기력증 테스트 — 회복 포인트 찾기', description: '에너지 저하, 행동 시동, 의미 상실, 연결 필요 신호를 점검하고 나에게 맞는 작은 회복 계획을 받아보세요.' },
  en: { title: 'Lethargy Test — Find Your Recovery Focus', description: 'Check low energy, activation, meaning, and support signals, then get a small recovery plan.' },
  ja: { title: '無気力テスト — 回復ポイントを探す', description: 'エネルギー低下、行動開始、意味の喪失、支援の必要性を確認します。' },
  zh: { title: '无力感测试 — 找到恢复重点', description: '检查能量、行动启动、意义感和支持需求信号。' },
  fr: { title: 'Test de Léthargie — Trouver le Point de Récupération', description: 'Vérifiez énergie, activation, sens et besoin de soutien avec un petit plan de récupération.' },
  es: { title: 'Test de Apatía — Encuentra tu Foco de Recuperación', description: 'Evalúa energía, activación, sentido y necesidad de apoyo con un pequeño plan.' },
};
const m = meta[locale] ?? meta.en;
const bridge = getTestBridge('lethargy', locale);

const content: Record<Locale, { introTitle: string; intro: string; conceptTitle: string; concepts: { title: string; body: string }[]; faqTitle: string; faqs: { question: string; answer: string }[]; disclaimer: string; }> = {
  ko: { introTitle: '무기력은 사람을 단정하는 라벨이 아니라 에너지가 떨어지는 신호와 회복 단서를 보는 렌즈입니다', intro: '무기력증 테스트는 에너지 저하, 행동 시동, 의미감, 연결 욕구가 지금 어떻게 나타나는지 살펴봅니다. 결과는 나를 탓하기 위한 이름이 아니라 작은 회복 방향을 찾기 위한 참고입니다.', conceptTitle: '무기력을 읽는 세 가지 관점', concepts: [{ title: '에너지 신호', body: '피곤함, 무거움, 회복 속도처럼 몸과 마음의 배터리를 봅니다.' }, { title: '행동 시동', body: '할 마음은 있어도 시작이 막히는 순간을 구분합니다.' }, { title: '의미와 연결', body: '작은 의미감과 도움 요청 가능성이 회복의 실마리가 될 수 있습니다.' }], faqTitle: '자주 묻는 질문', faqs: [{ question: '무기력 결과는 얼마나 정확한가요?', answer: '현재 답변에 나타난 에너지와 행동 시동의 경향을 요약한 참고 자료입니다. 수면, 스트레스, 생활 조건에 따라 달라질 수 있습니다.' }, { question: '이 결과가 전문적인 진단을 대신하나요?', answer: '아니요. 이 테스트는 임상 진단이 아닙니다. 무기력이나 걱정이 오래 지속되면 자격을 갖춘 전문가와 상담해 주세요.' }, { question: '결과를 어떻게 활용하면 좋나요?', answer: '크게 바꾸려 하기보다 오늘 가능한 작은 행동, 휴식, 도움 요청 중 하나를 고르는 단서로 사용해 보세요.' }], disclaimer: '무기력증 테스트 결과는 자기 이해와 대화를 위한 참고입니다. 진단, 채용, 관계의 단정적 판단 근거로 사용하지 마세요.' },
  en: { introTitle: 'Lethargy is a lens for low-energy signals and recovery clues, not a label that defines you', intro: 'The lethargy test looks at how energy, activation, meaning, and support needs show up right now. The result is not a name for blaming yourself; it is a reference for finding small recovery directions.', conceptTitle: 'Three ways to read lethargy', concepts: [{ title: 'Energy signals', body: 'It looks at the battery of body and mind: tiredness, heaviness, and recovery speed.' }, { title: 'Starting action', body: 'It separates not wanting from wanting but being unable to begin.' }, { title: 'Meaning and support', body: 'Small meaning and reachable support can become recovery clues.' }], faqTitle: 'Frequently asked questions', faqs: [{ question: 'How accurate is the lethargy result?', answer: 'It summarizes energy and activation tendencies shown in your current answers. Sleep, stress, and living conditions can shift it.' }, { question: 'Does this replace a professional diagnosis?', answer: 'No. This test is not a clinical diagnosis. If lethargy or concerns persist, consider speaking with a qualified professional.' }, { question: 'How should I use the result?', answer: 'Use it as a clue for choosing one small action today: rest, a tiny task, or asking for support.' }], disclaimer: 'Lethargy test results are for self-understanding and conversation. Do not use them as a basis for diagnosis, hiring, or definitive relationship judgments.' },
  ja: { introTitle: '無気力は人を決めつけるラベルではなく、エネルギー低下のサインと回復の手がかりを見るレンズです', intro: '無気力テストはエネルギー、行動開始、意味、支援の必要が今どう表れるかを見ます。結果は自分を責める名前ではなく、小さな回復方向を探す参考です。', conceptTitle: '無気力を読む三つの視点', concepts: [{ title: 'エネルギーのサイン', body: '疲れ、重さ、回復の速さなど心身のバッテリーを見ます。' }, { title: '行動の始動', body: 'やる気がないのか、やりたいのに始めにくいのかを分けます。' }, { title: '意味とつながり', body: '小さな意味感や助けを求められる可能性が回復の糸口になります。' }], faqTitle: 'よくある質問', faqs: [{ question: '無気力の結果はどれくらい正確ですか？', answer: '現在の回答に表れたエネルギーと行動開始の傾向の要約です。睡眠、ストレス、生活条件で変わることがあります。' }, { question: '専門的な診断の代わりになりますか？', answer: 'いいえ。このテストは臨床的な診断ではありません。無気力や心配が続く場合は、資格のある専門家に相談してください。' }, { question: '結果はどう使えばよいですか？', answer: '大きく変えようとするより、今日できる休息、小さな行動、助けを求めることの一つを選ぶ手がかりにしてください。' }], disclaimer: '無気力テストの結果は自己理解と対話のための参考です。診断、採用、人間関係の断定的判断には使わないでください。' },
  zh: { introTitle: '无力感是观察能量下降信号与恢复线索的镜片，不是定义人的标签', intro: '无力感测试观察能量、行动启动、意义感和支持需求现在如何呈现。结果不是责备自己的名称，而是寻找小恢复方向的参考。', conceptTitle: '理解无力感的三个角度', concepts: [{ title: '能量信号', body: '观察疲惫、沉重感和恢复速度等身心电量。' }, { title: '行动启动', body: '区分不想做，以及想做却难以开始的状态。' }, { title: '意义与连接', body: '微小的意义感和可触及的支持，可能成为恢复线索。' }], faqTitle: '常见问题', faqs: [{ question: '无力感结果有多准确？', answer: '它概括的是当前回答中的能量和行动启动倾向。睡眠、压力和生活条件都会影响结果。' }, { question: '这个结果能代替专业诊断吗？', answer: '不能。本测试不是临床诊断。如果无力感或担忧持续存在，请考虑咨询合格的专业人士。' }, { question: '应该如何使用结果？', answer: '不要急着大幅改变，可以把它当作选择今天一个小行动、休息或求助的线索。' }], disclaimer: '无力感测试结果仅用于自我理解与对话，请勿作为诊断、招聘或关系定论的依据。' },
  fr: { introTitle: 'La léthargie est une lentille sur la baisse d’énergie et les pistes de récupération, pas une étiquette qui vous définit', intro: 'Le test de léthargie observe l’énergie, l’activation, le sens et le besoin de soutien actuels. Le résultat ne sert pas à se blâmer, mais à trouver de petites directions de récupération.', conceptTitle: 'Trois façons de lire la léthargie', concepts: [{ title: 'Signaux d’énergie', body: 'On observe la batterie corps-esprit: fatigue, lourdeur et vitesse de récupération.' }, { title: 'Démarrage de l’action', body: 'On distingue ne pas vouloir de vouloir sans réussir à commencer.' }, { title: 'Sens et soutien', body: 'Un petit sens et un soutien accessible peuvent ouvrir la récupération.' }], faqTitle: 'Questions fréquentes', faqs: [{ question: 'Le résultat est-il fiable ?', answer: 'Il résume les tendances d’énergie et d’activation visibles dans vos réponses. Sommeil, stress et conditions de vie peuvent le modifier.' }, { question: 'Cela remplace-t-il un diagnostic professionnel ?', answer: 'Non. Ce test n’est pas un diagnostic clinique. Si la léthargie ou les inquiétudes persistent, consultez un professionnel qualifié.' }, { question: 'Comment l’utiliser ?', answer: 'Utilisez-le pour choisir une petite action aujourd’hui: repos, tâche minuscule ou demande de soutien.' }], disclaimer: 'Les résultats du test de léthargie servent à la compréhension de soi et au dialogue. Ne les utilisez pas comme base de diagnostic, de recrutement ou de verdict relationnel.' },
  es: { introTitle: 'La apatía es una lente sobre señales de baja energía y recuperación, no una etiqueta que te define', intro: 'El test de apatía observa energía, activación, sentido y necesidad de apoyo en este momento. El resultado no es para culparte, sino para encontrar pequeñas direcciones de recuperación.', conceptTitle: 'Tres formas de leer la apatía', concepts: [{ title: 'Señales de energía', body: 'Observa la batería de cuerpo y mente: cansancio, pesadez y ritmo de recuperación.' }, { title: 'Inicio de acción', body: 'Distingue no querer de querer pero no lograr empezar.' }, { title: 'Sentido y apoyo', body: 'Un pequeño sentido y apoyo accesible pueden dar pistas de recuperación.' }], faqTitle: 'Preguntas frecuentes', faqs: [{ question: '¿Qué tan preciso es el resultado?', answer: 'Resume tendencias de energía y activación que aparecen en tus respuestas. Sueño, estrés y condiciones de vida pueden cambiarlo.' }, { question: '¿Sustituye a un diagnóstico profesional?', answer: 'No. Este test no es un diagnóstico clínico. Si la apatía o las preocupaciones persisten, considera hablar con un profesional cualificado.' }, { question: '¿Cómo usarlo?', answer: 'Úsalo para elegir una pequeña acción hoy: descansar, hacer una tarea mínima o pedir apoyo.' }], disclaimer: 'Los resultados del test de apatía son para autoconocimiento y conversación. No los uses como base para diagnóstico, contratación o juicios definitivos sobre relaciones.' },
};

const c = content[locale] ?? content.en;
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
const quizJsonLd = buildQuizJsonLd({
  name: m.title,
  description: m.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  inLanguage: locale,
  questions: [],
});

---

<Layout title={m.title} description={m.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(quizJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="mx-auto max-w-2xl px-4 py-10">
    <LethargyRecoveryTest client:load locale={locale} />
    <section class="mt-10 border-t border-green-100 pt-8"><h2 class="text-2xl font-bold text-foreground">{c.introTitle}</h2><p class="mt-4 leading-8 text-green-800">{c.intro}</p></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-foreground">{c.conceptTitle}</h2><div class="mt-4 grid gap-4 md:grid-cols-3">{c.concepts.map((item) => (<article class="rounded-xl border border-green-100 bg-card p-4"><h3 class="font-semibold text-foreground">{item.title}</h3><p class="mt-2 text-sm leading-6 text-green-700">{item.body}</p></article>))}</div></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-foreground">{c.faqTitle}</h2><div class="mt-4 divide-y divide-green-100 rounded-xl border border-green-100 bg-card">{c.faqs.map((faq) => (<details class="group p-4"><summary class="cursor-pointer list-none font-semibold text-foreground">{faq.question}</summary><p class="mt-3 text-sm leading-6 text-green-700">{faq.answer}</p></details>))}</div></section>
    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>
    <WisdomNotes topic="lethargy" locale={locale} />
    <TestContentBridge content={bridge.content} blogUrl={bridge.blogUrl} wikiUrl={bridge.wikiUrl} />
    <RelatedTools locale={locale} tools={['burnout','depression','sleepType','stressResponse']} current="lethargy" />
  <PrintReportButton locale={locale} />
  <TestSourceNote locale={locale} note={TEST_SOURCE_NOTES['lethargy']} />
  </div>
</Layout>
