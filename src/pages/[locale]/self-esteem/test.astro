---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import SelfEsteemTest from '../../../components/tests/SelfEsteemTest';
import RelatedTools from '../../../components/shared/RelatedTools.astro';
import { buildQuizJsonLd } from '../../../lib/seo/quiz-json-ld';
import TestSourceNote from '../../../components/shared/TestSourceNote.astro';
import PrintReportButton from '../../../components/shared/PrintReportButton.astro';
import { TEST_SOURCE_NOTES } from '../../../data/test-source-notes';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '자존감 테스트 — 나의 자존감 수준을 측정해보세요', description: '로젠버그 자존감 척도 기반 테스트로 나의 자존감 수준과 향상 방법을 알아보세요.' },
  en: { title: 'Self-Esteem Test — Measure Your Self-Worth', description: 'Based on the Rosenberg Self-Esteem Scale, discover your self-esteem level and how to improve it.' },
  ja: { title: '自尊心テスト — 自己肯定感を測定', description: 'ローゼンバーグ自尊心尺度に基づき、あなたの自尊心レベルと向上方法を確認しましょう。' },
  zh: { title: '自尊心测试 — 测量你的自我价值感', description: '基于罗森伯格自尊量表，了解你的自尊水平和提升方法。' },
  fr: { title: "Test d'Estime de Soi — Mesurez votre confiance", description: "Basé sur l'échelle de Rosenberg, découvrez votre niveau d'estime de soi et comment l'améliorer." },
  es: { title: 'Test de Autoestima — Mide tu autoestima', description: 'Basado en la Escala de Autoestima de Rosenberg, descubre tu nivel y cómo mejorarlo.' },
};
const m = meta[locale] ?? meta.en;

const content: Record<Locale, { introTitle: string; intro: string; conceptTitle: string; concepts: { title: string; body: string }[]; faqTitle: string; faqs: { question: string; answer: string }[]; disclaimer: string; }> = {
  ko: { introTitle: '자존감은 사람을 단정하는 라벨이 아니라 나를 평가하고 대하는 방식을 보는 렌즈입니다', intro: '자존감 테스트는 자기 가치감, 자기 수용, 비교와 실패 앞에서의 반응을 살펴봅니다. 결과는 나의 가치를 결정하는 점수가 아니라 스스로를 대하는 습관을 돌아보기 위한 참고입니다.', conceptTitle: '자존감을 읽는 세 가지 관점', concepts: [{ title: '자기 가치감', body: '성과와 무관하게 나를 존중할 수 있는 감각을 봅니다.' }, { title: '자기 수용', body: '부족한 부분을 인정하면서도 전체의 나를 버리지 않는 태도입니다.' }, { title: '비교 반응', body: '타인의 기준을 만났을 때 내 마음이 어떻게 흔들리는지 살핍니다.' }], faqTitle: '자주 묻는 질문', faqs: [{ question: '자존감 결과는 얼마나 정확한가요?', answer: '현재 답변에 나타난 자기 평가 경향을 요약한 참고 자료입니다. 컨디션과 상황에 따라 달라질 수 있으니 절대적 점수로 보지 마세요.' }, { question: '이 결과가 전문적인 진단을 대신하나요?', answer: '아니요. 이 테스트는 임상 진단이 아닙니다. 불편감이나 걱정이 오래 지속되면 자격을 갖춘 전문가와 상담해 주세요.' }, { question: '자존감은 바뀔 수 있나요?', answer: '네. 반복되는 경험, 관계, 자기 대화 방식이 달라지면 나를 대하는 감각도 달라질 수 있습니다.' }], disclaimer: '자존감 테스트 결과는 자기 이해와 대화를 위한 참고입니다. 진단, 채용, 관계의 단정적 판단 근거로 사용하지 마세요.' },
  en: { introTitle: 'Self-esteem is a lens for how you evaluate and treat yourself, not a label that defines you', intro: 'The self-esteem test looks at self-worth, self-acceptance, and responses to comparison or failure. The result is not a score that decides your value; it is a reference for noticing habits in how you treat yourself.', conceptTitle: 'Three ways to read self-esteem', concepts: [{ title: 'Self-worth', body: 'The sense that you can respect yourself apart from performance.' }, { title: 'Self-acceptance', body: 'Acknowledging limits without rejecting your whole self.' }, { title: 'Comparison response', body: 'How your inner ground shifts when you meet other people’s standards.' }], faqTitle: 'Frequently asked questions', faqs: [{ question: 'How accurate is the self-esteem result?', answer: 'It summarizes self-evaluation tendencies shown in your current answers. Mood and context can shift it, so avoid treating it as an absolute score.' }, { question: 'Does this replace a professional diagnosis?', answer: 'No. This test is not a clinical diagnosis. If concerns or distress persist, consider speaking with a qualified professional.' }, { question: 'Can self-esteem change?', answer: 'Yes. Repeated experiences, relationships, and self-talk can change how you relate to yourself.' }], disclaimer: 'Self-esteem test results are for self-understanding and conversation. Do not use them as a basis for diagnosis, hiring, or definitive relationship judgments.' },
  ja: { introTitle: '自尊心は人を決めつけるラベルではなく、自分を評価し扱う方法を見るレンズです', intro: '自尊心テストは自己価値感、自己受容、比較や失敗への反応を見ます。結果はあなたの価値を決める点数ではなく、自分への接し方の習慣を振り返る参考です。', conceptTitle: '自尊心を読む三つの視点', concepts: [{ title: '自己価値感', body: '成果と切り離して自分を尊重できる感覚を見ます。' }, { title: '自己受容', body: '足りない部分を認めながらも、自分全体を否定しない態度です。' }, { title: '比較への反応', body: '他人の基準に触れたとき心がどう揺れるかを見ます。' }], faqTitle: 'よくある質問', faqs: [{ question: '自尊心の結果はどれくらい正確ですか？', answer: '現在の回答に表れた自己評価の傾向の要約です。体調や状況で変わるため、絶対的な点数として扱わないでください。' }, { question: '専門的な診断の代わりになりますか？', answer: 'いいえ。このテストは臨床的な診断ではありません。不調や心配が続く場合は、資格のある専門家に相談してください。' }, { question: '自尊心は変わりますか？', answer: '変わります。経験、関係、自分への語りかけが変わると、自分への感覚も変化します。' }], disclaimer: '自尊心テストの結果は自己理解と対話のための参考です。診断、採用、人間関係の断定的な判断材料には使わないでください。' },
  zh: { introTitle: '自尊心是观察你评价和对待自己的镜片，不是定义人的标签', intro: '自尊心测试观察自我价值感、自我接纳，以及面对比较或失败时的反应。结果不是决定你价值的分数，而是帮助你看见自我对待习惯的参考。', conceptTitle: '理解自尊心的三个角度', concepts: [{ title: '自我价值感', body: '观察你是否能在表现之外尊重自己。' }, { title: '自我接纳', body: '承认不足的同时，不否定完整的自己。' }, { title: '比较反应', body: '当遇到他人标准时，内心会如何动摇。' }], faqTitle: '常见问题', faqs: [{ question: '自尊心结果有多准确？', answer: '它概括的是当前回答中的自我评价倾向。状态和情境会影响结果，因此不要当作绝对分数。' }, { question: '这个结果能代替专业诊断吗？', answer: '不能。本测试不是临床诊断。如果困扰或担忧持续存在，请考虑咨询合格的专业人士。' }, { question: '自尊心会改变吗？', answer: '会。反复经验、关系和自我对话方式变化时，对待自己的感觉也会改变。' }], disclaimer: '自尊心测试结果仅用于自我理解与对话，请勿作为诊断、招聘或关系定论的依据。' },
  fr: { introTitle: 'L’estime de soi est une lentille sur votre façon de vous évaluer et de vous traiter, pas une étiquette qui vous définit', intro: 'Le test d’estime de soi observe la valeur personnelle, l’acceptation de soi et les réactions à la comparaison ou à l’échec. Le résultat ne décide pas votre valeur; il aide à remarquer vos habitudes envers vous-même.', conceptTitle: 'Trois façons de lire l’estime de soi', concepts: [{ title: 'Valeur personnelle', body: 'La capacité à se respecter au-delà de la performance.' }, { title: 'Acceptation de soi', body: 'Reconnaître ses limites sans rejeter toute sa personne.' }, { title: 'Réaction à la comparaison', body: 'Comment votre base intérieure bouge face aux critères des autres.' }], faqTitle: 'Questions fréquentes', faqs: [{ question: 'Le résultat est-il fiable ?', answer: 'Il résume les tendances d’auto-évaluation visibles dans vos réponses du moment. L’humeur et le contexte peuvent le modifier; ne le prenez pas comme score absolu.' }, { question: 'Cela remplace-t-il un diagnostic professionnel ?', answer: 'Non. Ce test n’est pas un diagnostic clinique. Si des inquiétudes ou une détresse persistent, consultez un professionnel qualifié.' }, { question: 'L’estime de soi peut-elle changer ?', answer: 'Oui. Les expériences répétées, les relations et le dialogue intérieur peuvent modifier le rapport à soi.' }], disclaimer: 'Les résultats du test d’estime de soi servent à la compréhension de soi et au dialogue. Ne les utilisez pas comme base de diagnostic, de recrutement ou de verdict relationnel.' },
  es: { introTitle: 'La autoestima es una lente sobre cómo te valoras y te tratas, no una etiqueta que te define', intro: 'El test de autoestima observa valor personal, autoaceptación y reacciones ante comparación o fracaso. El resultado no decide tu valor; ayuda a notar hábitos en la forma en que te tratas.', conceptTitle: 'Tres formas de leer la autoestima', concepts: [{ title: 'Valor personal', body: 'La capacidad de respetarte más allá del rendimiento.' }, { title: 'Autoaceptación', body: 'Reconocer límites sin rechazar todo tu yo.' }, { title: 'Respuesta a la comparación', body: 'Cómo se mueve tu base interna frente a estándares ajenos.' }], faqTitle: 'Preguntas frecuentes', faqs: [{ question: '¿Qué tan preciso es el resultado?', answer: 'Resume tendencias de autoevaluación que aparecen en tus respuestas actuales. Ánimo y contexto pueden cambiarlo; no lo trates como puntuación absoluta.' }, { question: '¿Sustituye a un diagnóstico profesional?', answer: 'No. Este test no es un diagnóstico clínico. Si las preocupaciones o el malestar persisten, considera hablar con un profesional cualificado.' }, { question: '¿La autoestima puede cambiar?', answer: 'Sí. Experiencias repetidas, relaciones y diálogo interno pueden cambiar cómo te relacionas contigo.' }], disclaimer: 'Los resultados del test de autoestima son para autoconocimiento y conversación. No los uses como base para diagnóstico, contratación o juicios definitivos sobre relaciones.' },
};

const c = content[locale] ?? content.en;
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
const quizJsonLd = buildQuizJsonLd({
  name: m.title,
  description: m.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  inLanguage: locale,
  questions: [],
});

---
<Layout title={m.title} description={m.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(quizJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="mx-auto max-w-2xl px-4 py-10">
    <SelfEsteemTest client:load locale={locale} />
    <section class="mt-10 border-t border-green-100 pt-8"><h2 class="text-2xl font-bold text-foreground">{c.introTitle}</h2><p class="mt-4 leading-8 text-green-800">{c.intro}</p></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-foreground">{c.conceptTitle}</h2><div class="mt-4 grid gap-4 md:grid-cols-3">{c.concepts.map((item) => (<article class="rounded-xl border border-green-100 bg-card p-4"><h3 class="font-semibold text-foreground">{item.title}</h3><p class="mt-2 text-sm leading-6 text-green-700">{item.body}</p></article>))}</div></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-foreground">{c.faqTitle}</h2><div class="mt-4 divide-y divide-green-100 rounded-xl border border-green-100 bg-card">{c.faqs.map((faq) => (<details class="group p-4"><summary class="cursor-pointer list-none font-semibold text-foreground">{faq.question}</summary><p class="mt-3 text-sm leading-6 text-green-700">{faq.answer}</p></details>))}</div></section>
    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>
    <RelatedTools locale={locale} tools={['innerStrength','perfectionism','depression','empathy']} current="selfEsteem" />
  <PrintReportButton locale={locale} />
  <TestSourceNote locale={locale} note={TEST_SOURCE_NOTES['self-esteem']} />
  </div>
</Layout>
