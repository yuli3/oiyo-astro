---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import TypingSpeedTest from '../../components/tests/TypingSpeedTest';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '타이핑 속도 테스트', description: '1분간 얼마나 빠르고 정확하게 타이핑할 수 있나요?' },
  en: { title: 'Typing Speed Test', description: 'How fast and accurately can you type in 1 minute?' },
  ja: { title: 'タイピング速度テスト', description: '1分間でどれだけ速く正確にタイピングできますか？' },
  zh: { title: '打字速度测试', description: '您在1分钟内能打多快多准确？' },
  fr: { title: 'Test de Vitesse de Frappe', description: 'Combien de mots pouvez-vous taper en 1 minute, rapidement et sans erreur ?' },
  es: { title: 'Prueba de Velocidad de Mecanografía', description: '¿Qué tan rápido y preciso puedes escribir en 1 minuto?' },
};
const m = meta[locale] ?? meta.en;
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <TypingSpeedTest locale={locale as any} client:load />
  </div>
</Layout>
