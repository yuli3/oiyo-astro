---
// 인지부조화 랩. blog academy 글에 심겨 있던 실습을 oiyo 로 옮겨 다시 만들었다
// (2026-09-03 주제 정렬 4단계). 심리는 oiyo 소유 주제다.
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import CognitiveDissonanceLab from '../../../components/tools/CognitiveDissonanceLab';
import TestExplainer from '../../../components/shared/TestExplainer.astro';
import { TEST_EXPLAINERS } from '../../../data/test-explainers';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '인지부조화 랩 — 신념과 행동이 어긋날 때 무엇이 움직이나', description: '중요도·어긋남·다른 이유를 움직여 부조화의 크기가 어떻게 달라지는지 보고, 사람들이 그 긴장을 줄이는 네 가지 방법을 비교합니다.' },
  en: { title: 'Cognitive Dissonance Lab — What Moves When Belief and Action Diverge', description: 'Move importance, gap and justification to see how the magnitude of dissonance changes, and compare the four ways people reduce that tension.' },
  ja: { title: '認知的不協和ラボ — 信念と行動がずれるとき何が動くか', description: '重要度・ずれ・他の理由を動かして不協和の大きさがどう変わるかを見て、人がその緊張を減らす四つの方法を比べます。' },
  zh: { title: '认知失调实验室 — 当信念与行为背离时什么在动', description: '拖动重要度、落差与其他理由，看看失调的大小如何变化，并比较人们减少这种张力的四种方式。' },
  fr: { title: "Labo de dissonance cognitive — ce qui bouge quand croyance et acte divergent", description: "Faites varier importance, écart et justification pour voir comment change l'ampleur de la dissonance, et comparez les quatre façons de réduire cette tension." },
  es: { title: 'Laboratorio de disonancia cognitiva — qué se mueve cuando creencia y acto divergen', description: 'Mueve importancia, distancia y justificación para ver cómo cambia la magnitud de la disonancia, y compara las cuatro formas de reducir esa tensión.' },
};
const m = meta[locale] ?? meta.en;
---
<Layout title={m.title} description={m.description} locale={locale}>
  <div class="mx-auto max-w-2xl px-4 py-10">
    <h1 class="text-2xl font-bold leading-snug text-foreground sm:text-3xl">{m.title}</h1>
    <p class="mt-3 text-muted-foreground">{m.description}</p>
    <div class="mt-8">
      <CognitiveDissonanceLab locale={locale} client:load />
    </div>
    <TestExplainer content={TEST_EXPLAINERS['cognitive-dissonance']} locale={locale} />
  </div>
</Layout>
