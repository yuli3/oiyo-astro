---
/**
 * 2027 토정비결 — 한국 세시 풍속이라 ko 한 로케일만 낸다(나라별 특화 원칙,
 * 2026-10-19 세운). 2026-11-03 세운 결재, company-brain
 * think-tank/2026-11-03-oiyo-series-more-content.md 2번.
 */
import Layout from '../../layouts/Layout.astro';
import TojeongFortune from '../../components/tools/TojeongFortune';
import { localePath, type Locale } from '../../i18n';
import { TOJEONG_LIMIT } from '../../data/tojeong-readings';

export function getStaticPaths() {
  return [{ params: { locale: 'ko' } }];
}

const { locale } = Astro.params as { locale: Locale };
const title = '2027 토정비결 무료 — 정미년 신수 보기';
const description = '음력 또는 양력 생일로 2027년 정미년 토정비결 괘를 뽑고, 한 해의 바탕·사람과 일·한 해를 맺는 법을 읽어요. 괘가 나온 계산도 그대로 보여 드려요.';

const faqs = [
  { q: '토정비결은 무엇인가요?', a: '새해에 한 해의 신수를 보던 조선 후기의 세시 풍속이에요. 토정 이지함이 지었다고 전하지만, 실제 저자인지는 확실하지 않아요. 나이·생월·생일로 상중하 세 괘를 뽑아 144가지 괘 가운데 하나를 얻어요.' },
  { q: '괘는 어떻게 계산하나요?', a: '상괘는 세는 나이에 그해 태세수를 더해 8로 나눈 나머지, 중괘는 그해 생월의 날수에 월건수를 더해 6으로 나눈 나머지, 하괘는 생일에 그날 일진수를 더해 3으로 나눈 나머지예요. 나머지가 0이면 8·6·3으로 봐요. 결과 아래에서 내 계산을 그대로 볼 수 있어요.' },
  { q: '양력 생일로 봐도 되나요?', a: '토정비결은 음력 생일을 써요. 양력을 고르면 음력으로 바꿔 계산하는데, 드물게 하루가 어긋날 수 있어요. 음력 생일을 알면 음력으로 넣는 것이 정확해요.' },
  { q: '풀이 문장은 원문인가요?', a: '아니에요. 전해 오는 괘사는 판본마다 달라서, OIYO가 상괘·중괘·하괘를 각각 새로 풀어 이어 붙였어요. 오락과 마음 정리를 위한 읽을거리예요.' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Layout title={title} description={description} locale={locale} availableLocales={['ko']}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <section class="mx-auto max-w-2xl px-4 py-10">
    <p class="text-xs font-black tracking-widest text-primary">2027 정미년 신수</p>
    <h1 class="mt-3 text-3xl font-black tracking-tight">2027 토정비결</h1>
    <p class="mt-3 text-base leading-relaxed text-muted-foreground">생일을 넣으면 세 괘를 뽑아 한 해의 바탕, 사람과 일, 한 해를 맺는 법을 읽어 드려요. 입력한 생일은 이 브라우저 밖으로 보내지 않아요.</p>

    <div class="mt-8">
      <TojeongFortune client:load />
    </div>

    <section class="mt-12 space-y-3">
      <h2 class="text-2xl font-black">토정비결을 읽는 법</h2>
      <p class="leading-relaxed text-muted-foreground">토정비결은 사주처럼 태어난 시를 쓰지 않고, 나이와 음력 생월·생일만으로 괘를 정해요. 그래서 같은 해에 같은 날 태어난 사람은 같은 괘를 받아요. 한 사람의 운명을 가르기보다 새해를 맞아 마음을 다잡던 풍속에 가까워요.</p>
      <p class="leading-relaxed text-muted-foreground">해마다 태세(그해의 간지)가 바뀌어서, 같은 사람도 해마다 다른 괘를 받아요. 2027년은 정미(丁未)년이라 태세수는 정(6)과 미(8)를 더한 14예요.</p>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-black">자주 묻는 질문</h2>
      <div class="mt-4 divide-y rounded-xl border bg-card">
        {faqs.map((f) => (
          <details class="group p-4">
            <summary class="cursor-pointer text-sm font-black">{f.q}</summary>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-8 text-xs leading-5 text-muted-foreground">{TOJEONG_LIMIT} 계산식 출처: <a class="underline" href="https://encykorea.aks.ac.kr/Article/E0059207" rel="noopener">한국민족문화대백과사전 「토정비결」</a>.</p>

    <nav class="mt-10 grid gap-3 sm:grid-cols-2" aria-label="함께 보기">
      <a href={localePath(locale, '/saju/new-year-2027')} class="rounded-xl border bg-card p-4 text-sm font-black transition hover:border-primary">🀄 2027 사주 신년 운세</a>
      <a href={localePath(locale, '/chinese-zodiac/year')} class="rounded-xl border bg-card p-4 text-sm font-black transition hover:border-primary">🐑 2027 띠별 운세</a>
    </nav>
  </section>
</Layout>
