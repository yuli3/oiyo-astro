---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import InnerStrengthTest from '../../../components/tests/InnerStrengthTest';
import RelatedTools from '../../../components/shared/RelatedTools.astro';
export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '내면 근력 자가진단 — 6단계로 측정하는 나의 내면 힘', description: '자기절제·삶의서사·목표몰입·한계돌파·평정심·리더십 6가지 차원으로 내면 근력을 측정하세요.' },
  en: { title: 'Inner Strength Assessment — Measure Your Inner Power in 6 Dimensions', description: 'Measure your inner strength across 6 dimensions: Self-Discipline, Life Narrative, Goal Focus, Limit-Breaking, Equanimity, and Leadership.' },
  ja: { title: '内面強度自己診断 — 6段階で測る内面の力', description: '自己制御・人生の物語・目標集中・限界突破・平静心・リーダーシップの6次元で内面の強さを測ります。' },
  zh: { title: '内在力量自我评估 — 6维度测量内在实力', description: '通过自我约束、人生叙事、目标专注、突破极限、平静心和领导力6个维度测量你的内在力量。' },
  fr: { title: "Auto-évaluation de la Force Intérieure — 6 Dimensions", description: "Mesurez votre force intérieure selon 6 dimensions: auto-discipline, récit de vie, focus sur les objectifs, dépassement des limites, équanimité et leadership." },
  es: { title: 'Autoevaluación de Fortaleza Interior — 6 Dimensiones', description: 'Mide tu fuerza interior en 6 dimensiones: autodisciplina, narrativa de vida, enfoque en metas, romper límites, ecuanimidad y liderazgo.' },
};
const m = meta[locale] ?? meta.en;

const content: Record<Locale, { introTitle: string; intro: string; conceptTitle: string; concepts: { title: string; body: string }[]; faqTitle: string; faqs: { question: string; answer: string }[]; disclaimer: string; }> = {
  ko: { introTitle: '내면 근력은 사람을 단정하는 라벨이 아니라 어려움 속에서 버티고 회복하는 힘을 보는 렌즈입니다', intro: '내면 근력 자가진단은 자기절제, 삶의 서사, 목표 몰입, 한계 돌파, 평정심, 리더십의 균형을 살펴봅니다. 결과는 강함을 증명하는 등급이 아니라 지금의 회복 자원을 이해하기 위한 참고입니다.', conceptTitle: '내면 근력을 읽는 세 가지 관점', concepts: [{ title: '버티는 힘', body: '힘들 때 무너지지 않는 것뿐 아니라 다시 정렬하는 능력까지 봅니다.' }, { title: '의미의 서사', body: '경험을 어떤 이야기로 엮는지가 지속력에 영향을 줍니다.' }, { title: '평정과 추진', body: '강하게 밀어붙이는 힘과 멈춰 균형을 잡는 힘을 함께 읽습니다.' }], faqTitle: '자주 묻는 질문', faqs: [{ question: '내면 근력 결과는 얼마나 정확한가요?', answer: '현재 답변에 나타난 회복과 지속의 경향을 요약한 참고 자료입니다. 상황과 피로도에 따라 달라질 수 있습니다.' }, { question: '낮은 결과는 약하다는 뜻인가요?', answer: '아니요. 지금 자원이 줄어 있거나 특정 영역이 더 많은 돌봄을 필요로 한다는 신호일 수 있습니다.' }, { question: '결과를 어떻게 활용하면 좋나요?', answer: '강한 영역은 유지하고 약한 영역은 작은 루틴으로 보완하는 방식으로 읽어 보세요.' }], disclaimer: '내면 근력 자가진단 결과는 자기 이해와 대화를 위한 참고입니다. 진단, 채용, 관계의 단정적 판단 근거로 사용하지 마세요.' },
  en: { introTitle: 'Inner strength is a lens for endurance and recovery, not a label that defines you', intro: 'The inner strength assessment looks at self-discipline, life narrative, goal focus, limit-breaking, equanimity, and leadership. The result is not a grade proving strength; it is a reference for understanding current recovery resources.', conceptTitle: 'Three ways to read inner strength', concepts: [{ title: 'Capacity to endure', body: 'It includes not only holding on, but also realigning after strain.' }, { title: 'Narrative of meaning', body: 'The story you build from experience affects persistence.' }, { title: 'Calm and drive', body: 'It reads the force to push forward together with the ability to pause and balance.' }], faqTitle: 'Frequently asked questions', faqs: [{ question: 'How accurate is the inner strength result?', answer: 'It summarizes endurance and recovery tendencies shown in your current answers. Context and fatigue can shift it.' }, { question: 'Does a low result mean I am weak?', answer: 'No. It may mean current resources are low or that one area needs more care.' }, { question: 'How should I use the result?', answer: 'Use strong areas as supports and choose small routines to reinforce weaker areas.' }], disclaimer: 'Inner strength assessment results are for self-understanding and conversation. Do not use them as a basis for diagnosis, hiring, or definitive relationship judgments.' },
  ja: { introTitle: '内面の強さは人を決めつけるラベルではなく、困難の中で耐え回復する力を見るレンズです', intro: '内面強度自己診断は自己制御、人生の物語、目標集中、限界突破、平静心、リーダーシップのバランスを見ます。結果は強さを証明する等級ではなく、今の回復資源を理解する参考です。', conceptTitle: '内面の強さを読む三つの視点', concepts: [{ title: '耐える力', body: '崩れないことだけでなく、負荷の後に整え直す力も見ます。' }, { title: '意味の物語', body: '経験をどんな物語にするかが持続力に影響します。' }, { title: '平静と推進', body: '押し進める力と、立ち止まり均衡を取る力を一緒に読みます。' }], faqTitle: 'よくある質問', faqs: [{ question: '内面の強さの結果はどれくらい正確ですか？', answer: '現在の回答に表れた回復と持続の傾向の要約です。状況や疲労度で変わることがあります。' }, { question: '低い結果は弱いという意味ですか？', answer: 'いいえ。今の資源が少ない、または特定の領域により多くのケアが必要というサインかもしれません。' }, { question: '結果はどう使えばよいですか？', answer: '強い領域を支えにし、弱い領域は小さなルーティンで補うように読んでください。' }], disclaimer: '内面強度自己診断の結果は自己理解と対話のための参考です。診断、採用、人間関係の断定的判断には使わないでください。' },
  zh: { introTitle: '内在力量是观察在困难中坚持并恢复能力的镜片，不是定义人的标签', intro: '内在力量自我评估观察自我约束、人生叙事、目标专注、突破极限、平静心和领导力的平衡。结果不是证明强弱的等级，而是理解当前恢复资源的参考。', conceptTitle: '理解内在力量的三个角度', concepts: [{ title: '承受力', body: '不只是撑住，也包括压力之后重新整理自己的能力。' }, { title: '意义叙事', body: '你如何把经验编织成故事，会影响持续力。' }, { title: '平静与推进', body: '同时看向前推动的力量，以及停下来保持平衡的力量。' }], faqTitle: '常见问题', faqs: [{ question: '内在力量结果有多准确？', answer: '它概括的是当前回答中的恢复与持续倾向。情境和疲劳程度会影响结果。' }, { question: '结果较低就是软弱吗？', answer: '不是。它可能表示当前资源较少，或某个领域需要更多照顾。' }, { question: '应该如何使用结果？', answer: '把较强的领域当作支撑，把较弱的领域用小习惯慢慢补上。' }], disclaimer: '内在力量自我评估结果仅用于自我理解与对话，请勿作为诊断、招聘或关系定论的依据。' },
  fr: { introTitle: 'La force intérieure est une lentille pour tenir et récupérer, pas une étiquette qui vous définit', intro: 'L’auto-évaluation de force intérieure observe auto-discipline, récit de vie, concentration, dépassement, équanimité et leadership. Le résultat n’est pas une note de force, mais un repère pour comprendre vos ressources de récupération actuelles.', conceptTitle: 'Trois façons de lire la force intérieure', concepts: [{ title: 'Capacité à tenir', body: 'Elle inclut tenir bon, mais aussi se réaligner après la tension.' }, { title: 'Récit de sens', body: 'L’histoire que vous faites de l’expérience influence la persévérance.' }, { title: 'Calme et élan', body: 'On lit la force d’avancer avec la capacité de s’arrêter et d’équilibrer.' }], faqTitle: 'Questions fréquentes', faqs: [{ question: 'Le résultat est-il fiable ?', answer: 'Il résume les tendances de récupération et de persévérance visibles dans vos réponses. Le contexte et la fatigue peuvent le modifier.' }, { question: 'Un résultat bas signifie-t-il que je suis faible ?', answer: 'Non. Il peut indiquer des ressources basses ou un domaine qui demande plus de soin.' }, { question: 'Comment l’utiliser ?', answer: 'Servez-vous des domaines forts comme appuis et renforcez les autres par de petites routines.' }], disclaimer: 'Les résultats de force intérieure servent à la compréhension de soi et au dialogue. Ne les utilisez pas comme base de diagnostic, de recrutement ou de verdict relationnel.' },
  es: { introTitle: 'La fortaleza interior es una lente para resistir y recuperarte, no una etiqueta que te define', intro: 'La autoevaluación de fortaleza interior observa autodisciplina, narrativa vital, enfoque, superación, ecuanimidad y liderazgo. El resultado no es una nota de fuerza, sino una referencia para entender recursos actuales de recuperación.', conceptTitle: 'Tres formas de leer la fortaleza interior', concepts: [{ title: 'Capacidad de sostener', body: 'Incluye resistir y también reajustarte después de la tensión.' }, { title: 'Narrativa de sentido', body: 'La historia que construyes con la experiencia afecta la persistencia.' }, { title: 'Calma e impulso', body: 'Lee la fuerza de avanzar junto con la capacidad de pausar y equilibrar.' }], faqTitle: 'Preguntas frecuentes', faqs: [{ question: '¿Qué tan preciso es el resultado?', answer: 'Resume tendencias de recuperación y persistencia que aparecen en tus respuestas. Contexto y cansancio pueden cambiarlo.' }, { question: '¿Un resultado bajo significa debilidad?', answer: 'No. Puede indicar recursos bajos o un área que necesita más cuidado.' }, { question: '¿Cómo usarlo?', answer: 'Usa las áreas fuertes como apoyo y refuerza las otras con rutinas pequeñas.' }], disclaimer: 'Los resultados de fortaleza interior son para autoconocimiento y conversación. No los uses como base para diagnóstico, contratación o juicios definitivos sobre relaciones.' },
};

const c = content[locale] ?? content.en;
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
---
<Layout title={m.title} description={m.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="mx-auto max-w-2xl px-4 py-10">
    <InnerStrengthTest client:load locale={locale} />
    <section class="mt-10 border-t border-violet-100 pt-8"><h2 class="text-2xl font-bold text-violet-950">{c.introTitle}</h2><p class="mt-4 leading-8 text-violet-800">{c.intro}</p></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.conceptTitle}</h2><div class="mt-4 grid gap-4 md:grid-cols-3">{c.concepts.map((item) => (<article class="rounded-xl border border-violet-100 bg-white p-4"><h3 class="font-semibold text-violet-950">{item.title}</h3><p class="mt-2 text-sm leading-6 text-violet-700">{item.body}</p></article>))}</div></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.faqTitle}</h2><div class="mt-4 divide-y divide-violet-100 rounded-xl border border-violet-100 bg-white">{c.faqs.map((faq) => (<details class="group p-4"><summary class="cursor-pointer list-none font-semibold text-violet-950">{faq.question}</summary><p class="mt-3 text-sm leading-6 text-violet-700">{faq.answer}</p></details>))}</div></section>
    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>
    <RelatedTools locale={locale} tools={['selfEsteem','empathy','eq','angerStyle']} current="innerStrength" />
  </div>
</Layout>
