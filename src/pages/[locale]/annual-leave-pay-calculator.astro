---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import AnnualLeavePayCalculatorComponent from '../../components/tools/AnnualLeavePayCalculator';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "연차 계산기 — 근로기준법 근속연수별 연차 발생 일수(최대 25일) & 미사용 연차수당 계산기",
    description: "근로기준법 제60조에 따른 입사 1년 미만(월 1일) 및 1년 이상(15일+2년마다 1일 가산, 최대 25일) 법정 연차 일수, 1일 통상임금 기준 미사용 연차수당 및 연차 사용촉진제도 무효 여부를 계산합니다.",
  },
  en: {
    title: "Korea Annual Paid Leave Calculator — Accrual Schedule & Unused Leave Allowance",
    description: "Calculate statutory annual paid leave accrual (up to 25 days) under Korean Labor Standards Act and compute unused leave cash compensation based on ordinary wage.",
  },
  ja: {
    title: "韓国 年次有給休暇計算機 — 勤続年数別付与日数（最大25日）＆未消化有給手当計算",
    description: "韓国勤労基準法第60条に基づく1年未満および勤続年数別有給休暇発生日数（最大25日）、1日通常賃金基準の未消化有給手当および有給取得促進の適法性を判定します。",
  },
  zh: {
    title: "韩国带薪年假计算器 — 资历年数折算（最高25天）与未休年假工资补偿计算",
    description: "测算韩国劳动基准法入职未满1年及连续工龄法定年假天数（最高25天），依据通常工资核算未休年假现金补偿金及年假使用促进程序合法性。",
  },
  fr: {
    title: "Simulateur de Congés Payés en Corée — Jours Acquis et Indemnité de Congés Non Pris",
    description: "Calculez les jours de congés payés légaux (jusqu'à 25 jours) en Corée et estimez l'indemnité compensatrice de congés non pris.",
  },
  es: {
    title: "Calculadora de Vacaciones Pagadas Anuales en Corea — Días y Compensación Económica",
    description: "Calcula los días de vacaciones acumulados según la antigüedad laboral (hasta 25 días) y la compensación por vacaciones no disfrutadas en Corea.",
  },
};

const currentMeta = meta[locale] ?? meta.ko;
---

<Layout
  title={currentMeta.title}
  description={currentMeta.description}
  locale={locale}
>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto mb-8 text-center">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl text-foreground">
        {currentMeta.title.split('—')[0]}
      </h1>
      <p class="mt-3 text-base text-muted-foreground sm:text-lg">
        {currentMeta.description}
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <AnnualLeavePayCalculatorComponent client:load locale={locale} />
    </div>
  </main>
</Layout>
