---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import RiasecQuickTest from '../../components/tests/RiasecQuickTest';
import BlogArticleLink from '../../components/shared/BlogArticleLink.astro';
import TestSourceNote from '../../components/shared/TestSourceNote.astro';
import PrintReportButton from '../../components/shared/PrintReportButton.astro';
import { TEST_SOURCE_NOTES } from '../../data/test-source-notes';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<string, { title: string; description: string }> = {
  ko: {
    title: "RIASEC 직업 흥미 빠른 검사 — 18문항, 3분",
    description: "Holland Code RIASEC 이론 기반 18개 질문으로 나의 직업 흥미 유형을 빠르게 알아보세요. 현실형·탐구형·예술형·사회형·진취형·관습형 6가지 차원을 간단히 분석합니다.",
  },
  en: {
    title: "RIASEC Quick Career Test — 18 Questions, 3 Minutes",
    description: "Discover your career interest type through 18 Holland Code RIASEC questions in about 3 minutes. A short read on the same 6 dimensions: Realistic, Investigative, Artistic, Social, Enterprising, and Conventional.",
  },
  ja: {
    title: "RIASEC 職業興味 クイック検査 — 18問・3分",
    description: "ホランドコードRIASEC理論に基づく18問で職業興味タイプを約3分で発見しましょう。現実型・研究型・芸術型・社会型・企業型・慣習型の6次元を手軽に分析します。",
  },
  fr: {
    title: "Test rapide RIASEC — 18 questions, 3 minutes",
    description: "Découvrez votre type d'intérêt professionnel avec 18 questions basées sur la théorie de Holland, en environ 3 minutes. Analyse rapide de 6 dimensions: Réaliste, Investigateur, Artistique, Social, Entreprenant, Conventionnel.",
  },
  es: {
    title: "Test rápido RIASEC — 18 preguntas, 3 minutos",
    description: "Descubre tu tipo de interés profesional con 18 preguntas basadas en la teoría de Holland en unos 3 minutos. Un análisis rápido de 6 dimensiones: Realista, Investigador, Artístico, Social, Emprendedor, Convencional.",
  },
  zh: {
    title: "RIASEC职业兴趣快速测试 — 18题，3分钟",
    description: "通过18个基于霍兰德代码RIASEC理论的问题，用约3分钟快速发现您的职业兴趣类型。简要分析6个维度：现实型、研究型、艺术型、社会型、企业型、传统型。",
  },
};
const m = meta[locale] ?? meta.en ?? Object.values(meta)[0];
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <RiasecQuickTest locale={locale as any} client:load />
    <BlogArticleLink testId="riasec-career-test" locale={locale} />
  <PrintReportButton locale={locale} />
  <TestSourceNote locale={locale} note={TEST_SOURCE_NOTES['riasec-quick']} />
  </div>
</Layout>
