---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import BusinessIncorporationPivotComponent from '../../components/tools/BusinessIncorporationPivot';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "개인사업자 vs 법인 전환 종합소득세·법인세 분기점 계산기 — 절세 시뮬레이터",
    description: "소득세법 누진세율(6~45%)과 법인세율(9~19%), 대표자 인건비 처리에 따른 연간 실질 절세액 및 건강보험료 경감 분기점을 실시간 비교합니다.",
  },
  en: {
    title: "Korea Sole Proprietor vs Corporation Tax Pivot Calculator — Incorporation Breakeven",
    description: "Compare progressive individual income tax (6~45%) vs corporate tax (9~19%), factor in CEO salary deductions and local health insurance, and find the optimal incorporation breakeven point.",
  },
  ja: {
    title: "韓国 個人事業主vs法人成り 総合所得税・法人税分岐点計算機 — 節税シミュレーター",
    description: "所得税累進税率(6〜45%)と法人税率(9〜19%)、代表者給与の損金算入および健康保険料の軽減を反映した実質節税額と法人成り分岐点を即時診断します。",
  },
  zh: {
    title: "韩国个体工商户转型法人综合所得税与法人税临界点计算器 — 节税测算",
    description: "对比综合所得税累进税率(6~45%)与企业法人税率(9~19%)，结合法人代表薪酬税前抵扣及健康保险费差异测算法人化最优临界点与年节税金额。",
  },
  fr: {
    title: "Simulateur de Passage en Société en Corée — Entreprise Individuelle vs SA",
    description: "Comparez l'impôt sur le revenu progressif et l'impôt sur les sociétés pour trouver le seuil optimal d'incorporation fiscale en Corée.",
  },
  es: {
    title: "Calculadora de Transformación en Sociedad en Corea — Autónomo vs Empresa",
    description: "Compara el IRPF progresivo con el impuesto de sociedades para determinar el punto de inflexión óptimo para constituir una empresa en Corea.",
  },
};

const currentMeta = meta[locale] ?? meta.ko;
---

<Layout
  title={currentMeta.title}
  description={currentMeta.description}
  locale={locale}
>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto mb-8 text-center">
      <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary mb-3">
        <span>{locale === 'ko' ? '소득세법 & 법인세법 2026' : 'Income & Corporate Tax Acts 2026'}</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl text-foreground">
        {currentMeta.title.split('—')[0]}
      </h1>
      <p class="mt-3 text-base text-muted-foreground sm:text-lg">
        {currentMeta.description}
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <BusinessIncorporationPivotComponent client:load locale={locale} />
    </div>

    {/* Hub-and-Spoke Context / FAQ */}
    <section class="max-w-4xl mx-auto mt-8 rounded-xl border border-border bg-card p-6 space-y-4 text-sm text-muted-foreground">
      <h2 class="text-lg font-bold text-foreground">
        {locale === 'ko' ? '자주 묻는 법인 전환 세무 Q&A' : 'Frequently Asked Questions'}
      </h2>

      <div class="space-y-3">
        <div>
          <h3 class="font-semibold text-foreground">
            {locale === 'ko' ? 'Q1. 보통 연 순이익 얼마부터 법인 전환을 추천하나요?' : 'Q1. At what net profit level is incorporation recommended?'}
          </h3>
          <p class="mt-1">
            {locale === 'ko'
              ? '일반적으로 연간 순이익(매출 - 경비) 7,000만원~1억원 이상부터 추천합니다. 개인사업자는 과세표준 8,800만원 초과 시 35% 이상의 고율 누진세율이 적용되는 반면, 법인은 과세표준 2억원 이하까지 9%(지방세 포함 9.9%) 저율 단일세율이 적용되기 때문입니다.'
              : 'Generally from 70M~100M KRW in annual net profit. Personal income over 88M KRW faces 35%+ brackets, whereas corporate profits up to 200M are taxed at a flat 9%.'}
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-foreground">
            {locale === 'ko' ? 'Q2. 법인을 세우면 건강보험료도 줄어드나요?' : 'Q2. Does incorporating also reduce health insurance?'}
          </h3>
          <p class="mt-1">
            {locale === 'ko'
              ? '네, 절감 효과가 큽니다. 개인사업자는 사업 소득 전체에 대해 지역 건강보험료(약 7.09%)가 무겁게 부과되지만, 법인 대표자는 "직장가입자"로 전환되어 본인이 설정한 급여(연봉)에 대해서만 건보료를 납부하므로 건보료 부담이 크게 낮아집니다.'
              : 'Yes. Sole proprietors pay local health taxes on entire business profits, while corporate CEOs pay workplace payroll rates strictly on their declared salary.'}
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-foreground">
            {locale === 'ko' ? 'Q3. 법인 통장의 돈을 마음대로 인출하면 안 되나요?' : 'Q3. Can I freely withdraw money from the corporate account?'}
          </h3>
          <p class="mt-1">
            {locale === 'ko'
              ? '절대 안 됩니다. 법인은 대표자와 법적으로 별개의 인격체이므로, 정당한 급여나 배당 결의 없이 대표자가 돈을 인출하면 "가지급금"으로 처리되어 매년 4.6%의 인정이자가 대표자 상여로 과세되며 세무조사의 표적이 됩니다.'
              : 'No. The corporation is a distinct legal entity. Unapproved withdrawals become deemed loans taxed at 4.6% deemed interest.'}
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
