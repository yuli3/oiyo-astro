---
import Layout from "../../layouts/Layout.astro";
import { LOCALES, localePath } from "../../i18n";
import type { Locale } from "../../i18n";
import EuropePastLife from "../../components/tools/past-life/EuropePastLife";
import RelatedTools from "../../components/shared/RelatedTools.astro";


export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

type Copy = { title: string; description: string; heading: string; sub: string; intro: string; howTitle: string; how: string[]; faqTitle: string; faq: { q: string; a: string }[] };
const copy: Record<Locale, Copy> = {
  ko: {
    title: "600년 전 유럽의 왕좌 — 1426년 30개 나라 중 내가 앉을 자리 뽑기",
    description: "1426년 유럽에 실제로 있던 30개 왕국·제국·공국·공화국·기사단 중 한 자리에 앉아요. 실제 군주와 초상, 같은 해 나와 동갑이던 유명인까지 보여줘요.",
    heading: "600년 전 유럽의 왕좌",
    sub: "1426년, 당신이 앉을 자리와 옆자리의 사람들",
    intro: "백년전쟁이 한창이고, 잔 다르크는 열네 살, 구텐베르크는 아직 인쇄기를 만들기 전이에요. 그해 실제로 있던 왕좌 하나에 앉혀 드려요.",
    howTitle: "어떤 자료로 뽑나요",
    how: [
      "왕좌: 1426년에 실제로 존재한 30개 나라의 최고 자리를 같은 확률로 뽑아요. 나라별 관직 정원을 비교할 자료가 없어서 왕좌만 다뤄요.",
      "군주와 초상: 군주와 재위 기간은 위키백과·위키데이터 기준이에요. 초상은 위키미디어 공용의 퍼블릭 도메인·CC 이미지이고, 생전에 만든 것인지 후대에 그린 것인지 함께 적어요.",
      "동갑 유명인: 위키데이터에서 1426년에 살아 있었고 여러 언어 위키백과에 실린 482명 중, 지금 내 나이와 1426년 나이가 같은 사람을 보여줘요.",
    ],
    faqTitle: "자주 묻는 질문",
    faq: [
      { q: "문장(紋章)은 왜 없나요?", a: "위키데이터에 걸린 문장 대부분이 1426년이 아닌 다른 시대 것이었어요. 틀린 시대 그림을 보여주지 않으려고 뺐어요." },
      { q: "피렌체는 왜 사람 이름이 없나요?", a: "피렌체 공화국의 최고 자리인 정의의 기수는 두 달마다 추첨으로 바뀌어서 한 사람으로 정할 수 없어요." },
      { q: "초상이 실제 얼굴인가요?", a: "아닐 수 있어요. 많은 초상이 군주가 죽은 뒤 수십~수백 년 뒤에 그려졌어요. 그림 아래에 연도와 함께 표시했어요." },
    ],
  },
  en: {
    title: "Your throne in 1426 Europe — draw one of 30 real thrones",
    description: "Sit on one of the 30 real European thrones of 1426, with the actual ruler, a portrait, and famous people who were your age that year.",
    heading: "Your throne in 1426 Europe",
    sub: "Where you sit in 1426, and who was around",
    intro: "The Hundred Years' War is raging, Joan of Arc is 14, and Gutenberg has not built his press yet. Take a throne that really existed that year.",
    howTitle: "What the draw uses",
    how: [
      "Throne: the top seat of 30 realms that existed in 1426, each equally likely. There is no comparable roster of court offices across realms, so only thrones are drawn.",
      "Ruler and portrait: rulers and reigns follow Wikipedia and Wikidata; portraits are public-domain or CC images from Wikimedia Commons, marked as made in their lifetime or later.",
      "Same-age peers: from 482 people alive in 1426 with articles in many Wikipedias (Wikidata), those whose 1426 age equals your age now.",
    ],
    faqTitle: "FAQ",
    faq: [
      { q: "Why no coats of arms?", a: "Most arms linked on Wikidata belong to other centuries, so they were left out rather than shown for the wrong period." },
      { q: "Are the portraits real likenesses?", a: "Not always. Many were painted decades or centuries later; the year is shown under each image." },
    ],
  },
  ja: {
    title: "1426年欧州の玉座 — 実在した30の玉座から一つを引く",
    description: "1426年に実在した欧州30か国の玉座に座ります。実際の君主と肖像、その年に同い年だった有名人も表示します。",
    heading: "1426年欧州の玉座",
    sub: "1426年、あなたが座る席とまわりの人々",
    intro: "百年戦争のさなか、ジャンヌ・ダルクは14歳、グーテンベルクはまだ印刷機を作っていません。その年に実在した玉座の一つに座りましょう。",
    howTitle: "使うデータ",
    how: [
      "玉座：1426年に実在した30か国の最高位を同じ確率で引きます。",
      "君主と肖像：ウィキペディア・ウィキデータ基準。肖像はウィキメディア・コモンズのパブリックドメイン・CC画像で、存命中か後世の作かを表示します。",
      "同い年の有名人：1426年に生きていた482人（ウィキデータ）から、いまのあなたと同じ年齢だった人を表示します。",
    ],
    faqTitle: "よくある質問",
    faq: [{ q: "紋章はなぜない？", a: "ウィキデータの紋章の多くが別の時代のものだったため、載せていません。" }],
  },
  zh: {
    title: "1426年欧洲王座 — 从30个真实王座中抽一个",
    description: "坐上1426年欧洲30国中的一个真实王座，附真实君主、肖像，以及那年与你同龄的名人。",
    heading: "1426年欧洲王座",
    sub: "1426年，你坐的位置和身边的人",
    intro: "百年战争正酣，贞德14岁，古腾堡还没造出印刷机。坐上那一年真实存在的王座。",
    howTitle: "使用的资料",
    how: [
      "王座：1426年真实存在的30国最高位置，等概率抽取。",
      "君主与肖像：依据维基百科和维基数据；肖像为维基共享资源的公有领域或CC图像，并标明是生前还是后世所作。",
      "同龄名人：从1426年在世的482人（维基数据）中，显示当年与你现在同龄的人。",
    ],
    faqTitle: "常见问题",
    faq: [{ q: "为什么没有纹章？", a: "维基数据上的纹章大多属于其他时代，为避免误导没有使用。" }],
  },
  fr: {
    title: "Votre trône en 1426 — l'un des 30 vrais trônes européens",
    description: "Prenez l'un des 30 trônes réels de l'Europe de 1426, avec le vrai souverain, un portrait et les célébrités de votre âge cette année-là.",
    heading: "Votre trône en 1426",
    sub: "Votre place en 1426 et vos contemporains",
    intro: "La guerre de Cent Ans fait rage, Jeanne d'Arc a 14 ans et Gutenberg n'a pas encore sa presse.",
    howTitle: "Les données utilisées",
    how: [
      "Trône : la plus haute charge de 30 royaumes de 1426, à chances égales.",
      "Souverain et portrait : Wikipédia et Wikidata ; portraits du domaine public ou CC (Wikimedia Commons), datés.",
      "Contemporains : parmi 482 personnes vivantes en 1426 (Wikidata), celles qui avaient alors votre âge actuel.",
    ],
    faqTitle: "Questions fréquentes",
    faq: [{ q: "Pourquoi pas d'armoiries ?", a: "La plupart des armoiries de Wikidata datent d'autres époques ; elles ont été écartées." }],
  },
  es: {
    title: "Tu trono en 1426 — uno de los 30 tronos europeos reales",
    description: "Ocupa uno de los 30 tronos reales de la Europa de 1426, con el soberano real, un retrato y los famosos de tu edad ese año.",
    heading: "Tu trono en 1426",
    sub: "Tu lugar en 1426 y tus contemporáneos",
    intro: "La guerra de los Cien Años está en marcha, Juana de Arco tiene 14 años y Gutenberg aún no tiene imprenta.",
    howTitle: "Datos usados",
    how: [
      "Trono: el cargo supremo de 30 reinos de 1426, con igual probabilidad.",
      "Soberano y retrato: Wikipedia y Wikidata; retratos de dominio público o CC (Wikimedia Commons), con fecha.",
      "Contemporáneos: entre 482 personas vivas en 1426 (Wikidata), las que tenían entonces tu edad actual.",
    ],
    faqTitle: "Preguntas frecuentes",
    faq: [{ q: "¿Por qué no hay escudos?", a: "La mayoría de los escudos de Wikidata son de otras épocas; se omitieron." }],
  },
};
const c = copy[locale] ?? copy.en;
const faqJsonLd = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: c.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };
---

<Layout title={c.title} description={c.description} locale={locale} canonicalPath={localePath(locale, "/europe-1426/")}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="container mx-auto max-w-3xl px-4 py-8">
    <p class="text-sm font-bold text-muted-foreground"><a class="hover:underline" href={localePath(locale, "/past-life-1426/")}>← {({ ko: "600년 전 나는?", en: "Who were you 600 years ago?", ja: "600年前のわたしは？", zh: "600年前的我是谁？", fr: "Qui étiez-vous il y a 600 ans ?", es: "¿Quién eras hace 600 años?" } as Record<string, string>)[locale] ?? "1426"}</a></p>
    <h1 class="mt-2 text-4xl font-black tracking-tight text-foreground">
      {c.heading}
      <span class="mt-1 block text-xl font-bold text-muted-foreground">{c.sub}</span>
    </h1>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted-foreground">{c.intro}</p>
    <div class="mt-6"><EuropePastLife locale={locale} client:load /></div>
    <RelatedTools locale={locale} tools={["joseon1426", "usBirthState", "reincarnation"]} current="europe1426" />
    <section class="mt-10 text-sm leading-relaxed text-muted-foreground">
      <h2 class="text-lg font-bold text-foreground">{c.howTitle}</h2>
      {c.how.map((p) => <p class="mt-2">{p}</p>)}
    </section>
    <section class="mt-10 text-sm leading-relaxed text-muted-foreground">
      <h2 class="text-lg font-bold text-foreground">{c.faqTitle}</h2>
      {c.faq.map((f) => (<div class="mt-4"><h3 class="font-bold text-foreground">{f.q}</h3><p class="mt-1">{f.a}</p></div>))}
    </section>
  </div>
</Layout>
