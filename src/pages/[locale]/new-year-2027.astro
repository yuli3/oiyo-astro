const c = C[locale] ?? C.en;
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const animals = ANIMAL_SLUG.map((slug, i) => {
  const rel = relationTo2027(i);
  return { slug, i, name: ANIMAL_NAMES[locale][i], img: ANIMAL_IMAGE[i], tag: rel === 'none' ? null : c.relationTag[rel] };
});
