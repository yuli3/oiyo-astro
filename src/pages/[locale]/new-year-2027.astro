            <a href={link.href} class="flex min-h-16 flex-col justify-center rounded-xl border border-border bg-card px-4 py-3 hover:border-primary/50">
              <span class="font-bold text-foreground">{link.label}</span>
              <span class="mt-1 text-xs leading-5 text-muted-foreground">{link.note}</span>
