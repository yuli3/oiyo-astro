    </section>

    <section class="mt-10 rounded-2xl border border-border bg-surface-subtle p-5">
      <h2 class="text-lg font-black">{c.factsHeading}</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-foreground">
        {c.facts.map((f) => <li>{f}</li>)}
      </ul>
      {c.factsSource && (
        <p class="mt-3 text-xs text-muted-foreground">
          <a class="underline underline-offset-4" href={c.factsSource.href} rel="noopener" target="_blank">{c.factsSource.label}</a>
        </p>
      )}
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-black">{c.faqHeading}</h2>
      <div class="mt-4 divide-y rounded-xl border bg-card">
        {c.faqs.map((f) => (
          <details class="p-4">
            <summary class="cursor-pointer font-semibold">{f.q}</summary>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </section>
</Layout>
