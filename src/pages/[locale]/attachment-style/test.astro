---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import AttachmentStyleTest from '../../../components/tests/AttachmentStyleTest';
import TestContentBridge from '../../../components/shared/TestContentBridge.astro';
import { getTestBridge } from '../../../data/test-content-bridges';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '애착유형 테스트 — 나의 애착 스타일은?', description: '안정형·불안형·회피형·혼란형 4가지 애착유형 중 나의 유형을 알아보고 관계 패턴을 이해하세요.' },
  en: { title: 'Attachment Style Test — What Is Your Attachment Type?', description: 'Discover your attachment style — secure, anxious, avoidant, or disorganized — and understand your relationship patterns.' },
  ja: { title: '愛着スタイルテスト — あなたの愛着タイプは？', description: '安定型・不安型・回避型・混乱型の4タイプから自分の愛着スタイルを発見し、関係パターンを理解しましょう。' },
  zh: { title: '依恋风格测试 — 你的依恋类型是什么？', description: '了解你的依恋类型——安全型、焦虑型、回避型或混乱型——并理解你的关系模式。' },
  fr: { title: "Test de Style d'Attachement — Quel est votre type?", description: "Découvrez votre style d'attachement — sécure, anxieux, évitant ou désorganisé — et comprenez vos schémas relationnels." },
  es: { title: 'Test de Estilo de Apego — ¿Cuál es tu tipo?', description: 'Descubre tu estilo de apego — seguro, ansioso, evitativo o desorganizado — y comprende tus patrones relacionales.' },
};
const m = meta[locale] ?? meta.en;
const bridge = getTestBridge('attachment', locale);
---
<Layout title={m.title} description={m.description} locale={locale}>
  <main class="mx-auto max-w-2xl px-4 py-10">
    <AttachmentStyleTest client:load locale={locale} />
    <TestContentBridge content={bridge.content} blogUrl={bridge.blogUrl} wikiUrl={bridge.wikiUrl} />
  </main>
</Layout>
