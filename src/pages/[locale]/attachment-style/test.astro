---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import AttachmentStyleTest from '../../../components/tests/AttachmentStyleTest';
import TestContentBridge from '../../../components/shared/TestContentBridge.astro';
import RelatedTools from '../../../components/shared/RelatedTools.astro';
import { getTestBridge } from '../../../data/test-content-bridges';
import { buildQuizJsonLd } from '../../../lib/seo/quiz-json-ld';
import TestSourceNote from '../../../components/shared/TestSourceNote.astro';
import PrintReportButton from '../../../components/shared/PrintReportButton.astro';
import { TEST_SOURCE_NOTES } from '../../../data/test-source-notes';
import { ADULT_ATTACHMENT_RELEASE_GATE } from '../../../../config/assessment-release-gates.js';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: '성인 애착 경향 검사 — 불안·회피 두 축', description: '가까운 관계에서 나타나는 애착 불안과 회피 경향을 OIYO 자체 12문항으로 살펴보세요. 고정 유형이나 진단이 아닌 자기이해용 연속축 결과입니다.' },
  en: { title: 'Adult Attachment Tendencies — Anxiety & Avoidance', description: 'Explore attachment anxiety and avoidance with 12 OIYO-authored prompts. Continuous self-reflection results, not a fixed type or diagnosis.' },
  ja: { title: '成人の愛着傾向チェック — 不安と回避の二軸', description: 'OIYO独自の12項目で愛着不安と回避傾向を確認します。固定タイプや診断ではなく自己理解のための連続軸です。' },
  zh: { title: '成人依恋倾向测验 — 焦虑与回避双维度', description: '通过12道OIYO原创题目观察依恋焦虑与回避倾向。结果是连续维度的自我理解，不是固定类型或诊断。' },
  fr: { title: 'Tendances d’attachement adulte — anxiété et évitement', description: 'Explorez anxiété et évitement avec 12 items originaux OIYO. Des dimensions continues de réflexion, pas un type fixe ni un diagnostic.' },
  es: { title: 'Tendencias de apego adulto — ansiedad y evitación', description: 'Explora ansiedad y evitación con 12 ítems originales de OIYO. Dimensiones continuas para reflexionar, no un tipo fijo ni un diagnóstico.' },
};
const m = meta[locale] ?? meta.en;
const isDraftAssessment = !ADULT_ATTACHMENT_RELEASE_GATE.indexable;
const bridge = getTestBridge('attachment', locale);

const content: Record<Locale, { introTitle: string; intro: string; conceptTitle: string; concepts: { title: string; body: string }[]; faqTitle: string; faqs: { question: string; answer: string }[]; disclaimer: string; }> = {
  ko: { introTitle: '애착유형은 사람을 단정하는 라벨이 아니라 관계에서 안전감을 찾는 방식을 보는 렌즈입니다', intro: '애착유형 테스트는 가까움, 거리감, 불안, 회피가 관계 속에서 어떻게 나타나는지 살펴봅니다. 결과는 누군가를 판단하기 위한 이름표가 아니라 관계 패턴을 더 부드럽게 이해하기 위한 출발점입니다.', conceptTitle: '애착유형을 읽는 세 가지 관점', concepts: [{ title: '안정감', body: '갈등이나 거리감 속에서도 관계가 이어질 수 있다는 감각을 봅니다.' }, { title: '불안 신호', body: '상대의 반응을 과하게 확인하거나 거절을 크게 느끼는 패턴을 살핍니다.' }, { title: '회피 신호', body: '가까워질수록 독립성과 안전거리를 더 필요로 하는 장면을 봅니다.' }], faqTitle: '자주 묻는 질문', faqs: [{ question: '애착유형 결과는 얼마나 정확한가요?', answer: '현재 답변에 나타난 관계 경향을 요약한 참고 자료입니다. 관계 경험과 상대에 따라 달라질 수 있으니 절대적인 판정으로 보지 마세요.' }, { question: '유형은 바뀔 수 있나요?', answer: '네. 안전한 경험, 반복된 대화, 관계의 맥락이 달라지면 애착 반응도 달라질 수 있습니다.' }, { question: '결과를 관계에서 어떻게 쓰면 좋나요?', answer: '상대에게 책임을 돌리기보다 내가 가까움과 거리감을 어떻게 느끼는지 설명하는 언어로 사용해 보세요.' }], disclaimer: '애착유형 결과는 자기 이해와 대화를 위한 참고입니다. 진단, 채용, 관계의 단정적 판단 근거로 사용하지 마세요.' },
  en: { introTitle: 'Attachment style is a lens for how you seek safety in relationships, not a label that defines you', intro: 'The attachment style test looks at how closeness, distance, anxiety, and avoidance appear in relationships. The result is not a tag for judging anyone; it is a starting point for understanding relationship patterns more gently.', conceptTitle: 'Three ways to read attachment style', concepts: [{ title: 'Sense of safety', body: 'How much you can trust that a relationship can continue through conflict or distance.' }, { title: 'Anxious signals', body: 'Patterns of checking for reassurance or feeling rejection intensely.' }, { title: 'Avoidant signals', body: 'Moments when closeness increases the need for independence or distance.' }], faqTitle: 'Frequently asked questions', faqs: [{ question: 'How accurate is the attachment style result?', answer: 'It summarizes relationship tendencies shown in your current answers. Experiences and partners can change the pattern, so avoid treating it as an absolute verdict.' }, { question: 'Can attachment style change?', answer: 'Yes. Safer experiences, repeated conversation, and different relationship contexts can shift attachment responses.' }, { question: 'How should I use this in a relationship?', answer: 'Use it as language for explaining how closeness and distance feel to you, rather than as a way to assign blame.' }], disclaimer: 'Attachment style results are for self-understanding and conversation. Do not use them as a basis for diagnosis, hiring, or definitive relationship judgments.' },
  ja: { introTitle: '愛着スタイルは人を決めつけるラベルではなく、関係の中で安心を求める方法を見るレンズです', intro: '愛着スタイルテストは親密さ、距離、不安、回避が関係の中でどう表れるかを見ます。結果は人を判断する名前ではなく、関係パターンをやわらかく理解する出発点です。', conceptTitle: '愛着スタイルを読む三つの視点', concepts: [{ title: '安心感', body: '葛藤や距離があっても関係が続くと感じられるかを見ます。' }, { title: '不安のサイン', body: '相手の反応を何度も確かめたり、拒絶を強く感じたりするパターンです。' }, { title: '回避のサイン', body: '近づくほど独立性や安全な距離を必要とする場面を見ます。' }], faqTitle: 'よくある質問', faqs: [{ question: '愛着スタイルの結果はどれくらい正確ですか？', answer: '現在の回答に表れた関係傾向の要約です。経験や相手によって変わるため、絶対的な判定として扱わないでください。' }, { question: '愛着スタイルは変わりますか？', answer: '変わります。安全な経験、繰り返される対話、関係の文脈が変わると反応も変化します。' }, { question: '関係でどう使えばよいですか？', answer: '相手を責めるためではなく、親密さや距離が自分にどう感じられるかを説明する言葉として使ってください。' }], disclaimer: '愛着スタイルの結果は自己理解と対話のための参考です。診断、採用、人間関係の断定的な判断材料には使わないでください。' },
  zh: { introTitle: '依恋风格是观察你在关系中寻求安全感的镜片，不是定义人的标签', intro: '依恋风格测试观察亲近、距离、焦虑与回避在关系中如何出现。结果不是评判任何人的标签，而是更温和理解关系模式的起点。', conceptTitle: '理解依恋风格的三个角度', concepts: [{ title: '安全感', body: '观察你是否相信关系能在冲突或距离中继续存在。' }, { title: '焦虑信号', body: '包括反复确认对方反应，或把拒绝感受得很强烈。' }, { title: '回避信号', body: '当关系更亲近时，可能更需要独立和安全距离。' }], faqTitle: '常见问题', faqs: [{ question: '依恋风格结果有多准确？', answer: '它概括的是当前回答中呈现的关系倾向。关系经验和对象会影响模式，因此不要当作绝对结论。' }, { question: '依恋风格会改变吗？', answer: '会。更安全的经验、反复的沟通和不同关系情境，都可能改变依恋反应。' }, { question: '在关系中应该如何使用？', answer: '把它当作说明自己如何感受亲近与距离的语言，而不是归咎对方的工具。' }], disclaimer: '依恋风格结果仅用于自我理解与对话，请勿作为诊断、招聘或关系定论的依据。' },
  fr: { introTitle: 'Le style d’attachement est une lentille pour votre sécurité relationnelle, pas une étiquette qui vous définit', intro: 'Le test de style d’attachement observe la proximité, la distance, l’anxiété et l’évitement dans les relations. Le résultat n’est pas une étiquette pour juger, mais un départ pour comprendre les schémas relationnels avec plus de nuance.', conceptTitle: 'Trois façons de lire le style d’attachement', concepts: [{ title: 'Sentiment de sécurité', body: 'La confiance qu’une relation peut tenir malgré le conflit ou la distance.' }, { title: 'Signaux anxieux', body: 'Le besoin de vérifier l’affection ou de ressentir fortement le rejet.' }, { title: 'Signaux évitants', body: 'Les moments où la proximité augmente le besoin d’indépendance ou de distance.' }], faqTitle: 'Questions fréquentes', faqs: [{ question: 'Le résultat est-il fiable ?', answer: 'Il résume les tendances relationnelles visibles dans vos réponses du moment. Les expériences et les partenaires peuvent modifier le motif; ne le traitez pas comme verdict absolu.' }, { question: 'Un style d’attachement peut-il changer ?', answer: 'Oui. Des expériences plus sûres, des conversations répétées et d’autres contextes relationnels peuvent déplacer les réponses.' }, { question: 'Comment l’utiliser en relation ?', answer: 'Utilisez-le pour expliquer comment proximité et distance vous touchent, pas pour attribuer une faute.' }], disclaimer: 'Les résultats du style d’attachement servent à la compréhension de soi et au dialogue. Ne les utilisez pas comme base de diagnostic, de recrutement ou de verdict relationnel.' },
  es: { introTitle: 'El estilo de apego es una lente para cómo buscas seguridad en las relaciones, no una etiqueta que te define', intro: 'El test de estilo de apego observa cómo aparecen cercanía, distancia, ansiedad y evitación en las relaciones. El resultado no es una etiqueta para juzgar, sino un punto de partida para entender patrones con más cuidado.', conceptTitle: 'Tres formas de leer el estilo de apego', concepts: [{ title: 'Sensación de seguridad', body: 'La confianza en que una relación puede continuar pese al conflicto o la distancia.' }, { title: 'Señales ansiosas', body: 'Patrones de buscar confirmación o sentir el rechazo con mucha intensidad.' }, { title: 'Señales evitativas', body: 'Momentos en que la cercanía aumenta la necesidad de independencia o distancia.' }], faqTitle: 'Preguntas frecuentes', faqs: [{ question: '¿Qué tan preciso es el resultado?', answer: 'Resume tendencias relacionales que aparecen en tus respuestas actuales. Experiencias y personas pueden cambiar el patrón; no lo trates como veredicto absoluto.' }, { question: '¿Puede cambiar el estilo de apego?', answer: 'Sí. Experiencias más seguras, conversaciones repetidas y nuevos contextos relacionales pueden cambiar las respuestas.' }, { question: '¿Cómo usarlo en una relación?', answer: 'Úsalo para explicar cómo sientes cercanía y distancia, no para asignar culpa.' }], disclaimer: 'Los resultados del estilo de apego son para autoconocimiento y conversación. No los uses como base para diagnóstico, contratación o juicios definitivos sobre relaciones.' },
};

const dimensionalContent: typeof content = {
  ko: { introTitle: '애착을 네 가지 상자보다 불안·회피 두 축으로 읽습니다', intro: '이 검사는 중요한 가까운 관계에서 거리와 거절에 대한 걱정이 얼마나 쉽게 활성화되는지, 의존과 취약성 공유에서 얼마나 거리를 두는지를 따로 살펴봅니다. 두 경향은 관계와 시기에 따라 달라질 수 있습니다.', conceptTitle: '두 축을 읽는 기준', concepts: [{ title: '애착 불안', body: '거리감·모호한 반응·거절 가능성 앞에서 걱정과 확인 욕구가 활성화되는 경향입니다.' }, { title: '애착 회피', body: '의존하거나 약한 감정을 나누는 상황에서 독립성과 거리를 더 필요로 하는 경향입니다.' }, { title: '관계 맥락', body: '같은 사람도 연인·가족·친구 관계와 최근 경험에 따라 다른 응답을 보일 수 있습니다.' }], faqTitle: '자주 묻는 질문', faqs: [{ question: '결과가 내 애착유형을 확정하나요?', answer: '아닙니다. 자연스럽고 정확한 유형 경계는 없으며, 이 결과는 현재 응답척도에서 본 두 연속 경향입니다.' }, { question: '높은 점수는 문제가 있다는 뜻인가요?', answer: '아닙니다. 좋고 나쁨이나 정상·비정상을 판정하지 않으며, 맥락을 살피기 위한 신호입니다.' }, { question: '관계가 안전하지 않을 때도 대화를 시도해야 하나요?', answer: '폭력·통제·위협이 있다면 애착 문제로 해석하거나 대화를 강요하지 말고 안전과 전문 지원을 우선하세요.' }], disclaimer: 'OIYO 자체 문항으로 만든 자기이해 도구입니다. 임상 진단, ECR/ECR-R/ECR-RS 척도, 관계 안전성 또는 학대 판별 도구가 아닙니다.' },
  en: { introTitle: 'Read attachment through anxiety and avoidance, not four boxes', intro: 'This assessment separately explores worry around distance or rejection and distance around dependence or vulnerability. Both tendencies can vary by relationship and over time.', conceptTitle: 'How to read the two dimensions', concepts: [{ title: 'Attachment anxiety', body: 'How readily worry and reassurance-seeking activate around distance, ambiguity, or possible rejection.' }, { title: 'Attachment avoidance', body: 'How readily distance and self-reliance activate around dependence or sharing vulnerability.' }, { title: 'Relationship context', body: 'The same person can respond differently with partners, family, friends, and after recent experiences.' }], faqTitle: 'Frequently asked questions', faqs: [{ question: 'Does this establish my attachment type?', answer: 'No. There is no natural, correct categorical boundary; these are two continuous tendencies in your current responses.' }, { question: 'Does a higher score mean something is wrong?', answer: 'No. It is not a good/bad or normal/abnormal judgment, only a signal to consider in context.' }, { question: 'Should I start a conversation if the relationship is unsafe?', answer: 'If there is violence, control, or threat, do not reduce it to attachment or pressure yourself into dialogue. Prioritize safety and qualified support.' }], disclaimer: 'An OIYO-authored reflection tool—not a clinical diagnosis, ECR/ECR-R/ECR-RS instrument, or assessment of relationship safety or abuse.' },
  ja: { introTitle: '愛着を四つの箱ではなく不安と回避の二軸で読みます', intro: '距離や拒絶への心配と、依存や弱さの共有で距離を取る傾向を別々に見ます。どちらも関係や時期で変わります。', conceptTitle: '二軸の読み方', concepts: [{ title: '愛着不安', body: '距離・曖昧さ・拒絶の可能性で心配や確認欲求が動く傾向です。' }, { title: '愛着回避', body: '依存や弱さの共有で自立や距離を必要とする傾向です。' }, { title: '関係の文脈', body: '同じ人でも相手や最近の経験によって回答は変わります。' }], faqTitle: 'よくある質問', faqs: [{ question: '愛着タイプを確定しますか？', answer: 'いいえ。自然で正しい分類境界はなく、現在の回答に見られる二つの連続傾向です。' }, { question: '高い点数は問題ですか？', answer: 'いいえ。良し悪しや正常・異常の判定ではありません。' }, { question: '関係が安全でなくても話し合うべきですか？', answer: '暴力・支配・脅迫がある場合は愛着問題にせず、安全と専門支援を優先してください。' }], disclaimer: 'OIYO独自項目の自己理解ツールで、診断・ECR系尺度・関係安全性や虐待の判定ではありません。' },
  zh: { introTitle: '用焦虑与回避双维度理解依恋，而不是四种固定类型', intro: '本测验分别观察距离或拒绝引发的担忧，以及面对依赖或脆弱时拉开距离的倾向。两者都会随关系和时间变化。', conceptTitle: '如何理解两个维度', concepts: [{ title: '依恋焦虑', body: '面对距离、含糊反应或可能被拒绝时，担忧和确认需要被激活的倾向。' }, { title: '依恋回避', body: '面对依赖或分享脆弱时，更需要独立和距离的倾向。' }, { title: '关系情境', body: '同一个人在伴侣、家人、朋友关系和不同经历后可能有不同回答。' }], faqTitle: '常见问题', faqs: [{ question: '结果会确定我的依恋类型吗？', answer: '不会。不存在天然正确的分类边界；结果只是当前回答中的两个连续倾向。' }, { question: '分数较高表示有问题吗？', answer: '不是。本测验不判断好坏或正常异常，只提供结合情境观察的信号。' }, { question: '关系不安全时也应该沟通吗？', answer: '如果存在暴力、控制或威胁，不要归因于依恋或强迫自己沟通，请优先确保安全并寻求专业支持。' }], disclaimer: 'OIYO原创题目的自我理解工具，不是诊断、ECR系列量表，也不判断关系安全或虐待。' },
  fr: { introTitle: 'Lire l’attachement sur deux dimensions plutôt qu’en quatre cases', intro: 'Ce test distingue l’inquiétude face à la distance ou au rejet et la prise de distance face à la dépendance ou à la vulnérabilité. Ces tendances varient selon les relations et le temps.', conceptTitle: 'Lire les deux dimensions', concepts: [{ title: 'Anxiété d’attachement', body: 'Activation de l’inquiétude et du besoin d’être rassuré face à la distance ou à l’ambiguïté.' }, { title: 'Évitement d’attachement', body: 'Besoin d’autonomie ou de distance face à la dépendance ou au partage de vulnérabilité.' }, { title: 'Contexte relationnel', body: 'Une même personne peut répondre différemment selon la relation et les expériences récentes.' }], faqTitle: 'Questions fréquentes', faqs: [{ question: 'Le résultat fixe-t-il mon type ?', answer: 'Non. Il n’existe pas de frontière catégorielle naturelle; ce sont deux tendances continues dans vos réponses actuelles.' }, { question: 'Un score élevé signifie-t-il un problème ?', answer: 'Non. Ce n’est pas un jugement bon/mauvais ou normal/anormal.' }, { question: 'Faut-il dialoguer si la relation est dangereuse ?', answer: 'En cas de violence, contrôle ou menace, priorisez la sécurité et une aide qualifiée plutôt que l’explication par l’attachement.' }], disclaimer: 'Outil OIYO original de réflexion, sans valeur diagnostique, sans équivalence ECR et sans évaluation de la sécurité ou de la violence.' },
  es: { introTitle: 'Leer el apego en dos dimensiones, no en cuatro cajas', intro: 'Este test separa la preocupación ante distancia o rechazo de la distancia ante dependencia o vulnerabilidad. Ambas tendencias cambian según la relación y el momento.', conceptTitle: 'Cómo leer las dos dimensiones', concepts: [{ title: 'Ansiedad de apego', body: 'Activación de preocupación y búsqueda de confirmación ante distancia, ambigüedad o posible rechazo.' }, { title: 'Evitación de apego', body: 'Necesidad de independencia o distancia ante dependencia o vulnerabilidad.' }, { title: 'Contexto relacional', body: 'La misma persona puede responder distinto según la relación y experiencias recientes.' }], faqTitle: 'Preguntas frecuentes', faqs: [{ question: '¿El resultado fija mi tipo de apego?', answer: 'No. No existe una frontera categórica natural; son dos tendencias continuas en tus respuestas actuales.' }, { question: '¿Una puntuación alta significa un problema?', answer: 'No. No juzga bien/mal ni normal/anormal.' }, { question: '¿Debo dialogar si la relación no es segura?', answer: 'Ante violencia, control o amenazas, prioriza la seguridad y el apoyo cualificado, no una explicación de apego.' }], disclaimer: 'Herramienta original de OIYO para reflexionar; no es diagnóstico, escala ECR ni evaluación de seguridad o abuso.' },
};

const c = dimensionalContent[locale] ?? dimensionalContent.en;
const assessmentSourceBoundary: Record<Locale, string> = {
  ko: '검사 품질과 전문적 사용 경계를 확인하기 위한 일반 참고이며, 이 자체 문항의 타당도를 인증하지 않습니다.',
  en: 'A general reference for assessment quality and professional-use boundaries; it does not validate these OIYO-authored items.',
  ja: '検査の質と専門的利用の境界を確認する一般資料であり、OIYO独自項目の妥当性を認証するものではありません。',
  zh: '这是关于测评质量与专业使用边界的一般参考，并不验证这些 OIYO 原创题目的效度。',
  fr: 'Une référence générale sur la qualité des évaluations et leurs limites professionnelles; elle ne valide pas les items originaux d’OIYO.',
  es: 'Una referencia general sobre calidad y límites de uso profesional; no valida los ítems originales de OIYO.',
};
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
const quizJsonLd = buildQuizJsonLd({
  name: m.title,
  description: m.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  inLanguage: locale,
  questions: [],
});

---
<Layout title={m.title} description={m.description} locale={locale} noindex={isDraftAssessment}>
  <script type="application/ld+json" set:html={JSON.stringify(quizJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="mx-auto max-w-2xl px-4 py-10">
    <AttachmentStyleTest client:load locale={locale} />
    <section class="mt-10 border-t border-green-100 pt-8"><h2 class="text-2xl font-bold text-foreground">{c.introTitle}</h2><p class="mt-4 leading-8 text-green-800">{c.intro}</p></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-foreground">{c.conceptTitle}</h2><div class="mt-4 grid gap-4 md:grid-cols-3">{c.concepts.map((item) => (<article class="rounded-xl border border-green-100 bg-card p-4"><h3 class="font-semibold text-foreground">{item.title}</h3><p class="mt-2 text-sm leading-6 text-green-700">{item.body}</p></article>))}</div></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-foreground">{c.faqTitle}</h2><div class="mt-4 divide-y divide-green-100 rounded-xl border border-green-100 bg-card">{c.faqs.map((faq) => (<details class="group p-4"><summary class="cursor-pointer list-none font-semibold text-foreground">{faq.question}</summary><p class="mt-3 text-sm leading-6 text-green-700">{faq.answer}</p></details>))}</div></section>
    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>
    <p class="mt-4 text-sm leading-6 text-green-700">
      <a class="underline underline-offset-2" href="https://www.apa.org/topics/testing-assessment-measurement" rel="noopener noreferrer" target="_blank">APA — Testing, Assessment, and Measurement</a>
      {' '}— {assessmentSourceBoundary[locale]}
    </p>
    <TestContentBridge content={bridge.content} blogUrl={bridge.blogUrl} wikiUrl={bridge.wikiUrl} />
    <RelatedTools locale={locale} tools={['loveLanguage', 'mbti', 'enneagram']} current="attachment" />
  <PrintReportButton locale={locale} />
  <TestSourceNote locale={locale} note={TEST_SOURCE_NOTES['attachment-style']} />
  </div>
</Layout>
