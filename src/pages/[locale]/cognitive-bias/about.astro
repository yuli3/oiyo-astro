---
// cognitive-bias 개념 해설. 본문은 explainers 컬렉션(src/content/explainers/<locale>/cognitive-bias.md)에 있다.
import Layout from '../../../layouts/Layout.astro';
import ExplainerArticle from '../../../components/shared/ExplainerArticle.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import { getEntry } from 'astro:content';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const entry = await getEntry('explainers', `${locale}/cognitive-bias`);
if (!entry) throw new Error(`explainers 항목 없음: ${locale}/cognitive-bias`);
---
<Layout title={entry.data.title} description={entry.data.description} locale={locale}>
  <ExplainerArticle entry={entry} locale={locale} testPath="/cognitive-bias-test" />
</Layout>
