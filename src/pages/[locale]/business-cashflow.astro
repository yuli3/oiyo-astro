---
import { withTrailingSlash } from '../../i18n';
import Layout from "../../layouts/Layout.astro";
import { LOCALES } from "../../i18n";
import type { Locale } from "../../i18n";
import CashflowExplorer from "../../components/tools/CashflowExplorer";

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const BASE = "https://oiyo.net";

const meta: Record<string, { title: string; description: string }> = {
  ko: {
    title: "사업은 어떻게 돈을 버나 — 업종별 캐시플로우 한눈에",
    description: "렌트·학원·은행·유튜버·인플루언서·카페·SaaS·쇼핑몰·프랜차이즈까지, 업종별로 돈이 들어오고 나가는 구조(수익원·비용·순이익)를 플로우차트로 비교하는 무료 도구.",
  },
  en: {
    title: "How Businesses Make Money — Cashflow by Industry",
    description: "A free tool that maps how money flows in and out (revenue, costs, net profit) for rentals, academies, banks, YouTubers, influencers, cafes, SaaS, online stores and franchises.",
  },
  ja: {
    title: "ビジネスはどう稼ぐ? — 業種別キャッシュフロー",
    description: "賃貸・塾・銀行・YouTuber・インフルエンサー・カフェ・SaaS・ECなど、業種ごとにお金が入る・出る仕組み(収益源・費用・純利益)を比較する無料ツール。",
  },
};
const m = meta[locale] ?? meta.en;

const content: Record<string, {
  lead: string;
  faqTitle: string; faq: { q: string; a: string }[];
  relatedTitle: string; related: { href: string; label: string; desc: string }[];
}> = {
  ko: {
    lead: "“이 사업은 대체 어떻게 돈을 벌지?” 업종을 고르면, 돈이 들어오는 곳(수익원) → 사업 → 나가는 곳(비용) → 남는 것(순이익)의 흐름을 한눈에 보여드립니다. 각 사업 모델의 핵심 원리까지.",
    faqTitle: "자주 묻는 질문",
    faq: [
      { q: "사업마다 돈 버는 방식이 왜 다른가요?", a: "‘무엇을 파느냐’가 다르기 때문입니다. 가진 자산을 빌려주거나(임대), 시간·전문성을 팔거나(서비스), 돈으로 돈을 굴리거나(금융), 주목을 모아 광고로 바꾸거나(콘텐츠), 물건을 만들어 마진을 붙여 팝니다(상품). 같은 매출이라도 비용 구조가 달라 남는 돈이 다릅니다." },
      { q: "캐시플로우(현금흐름)란 무엇인가요?", a: "실제로 돈이 들어오고 나가는 흐름입니다. 회계상 ‘이익’과는 다릅니다. 장부상 이익이 나도 현금이 돌지 않으면(예: 외상이 안 들어옴) 사업은 멈출 수 있습니다." },
      { q: "수익이 나는데 왜 망하나요? (흑자도산)", a: "이익은 장부의 숫자고, 망하는 건 ‘현금이 떨어질 때’입니다. 매출은 외상으로 잡혀 있는데 인건비·임대료·대출 이자는 현금으로 당장 나가면, 흑자여도 돈이 막혀 부도가 납니다." },
      { q: "어떤 사업이 마진이 좋나요?", a: "추가 한 명을 받는 데 드는 비용(한계비용)이 낮을수록 유리합니다. SaaS·학원처럼 같은 고정비로 더 많은 고객을 받을수록 이익률이 급격히 좋아집니다. 반대로 상품·요식업은 원가와 고정비 부담이 큽니다." },
      { q: "이 도구의 숫자는 정확한가요?", a: "이 도구는 사업 ‘구조’를 직관적으로 이해하기 위한 교육용 모델입니다. 실제 수익률·비용은 업체·시기·지역에 따라 크게 다르므로, 창업·투자 결정 시에는 반드시 구체적 자료와 전문가 상담을 거치세요." },
    ],
    relatedTitle: "함께 보면 좋은 것",
    related: [
      { href: "/saju/calculator", label: "사주 계산기", desc: "타고난 기질과 진로의 흐름." },
      { href: "/life-balance", label: "삶의 균형 진단", desc: "재정 포함 8영역 밸런스." },
    ],
  },
  en: {
    lead: "“How on earth does this business make money?” Pick an industry and see the flow at a glance: where money comes in (revenue) → the business → where it goes out (costs) → what's left (net profit) — plus the core principle of each model.",
    faqTitle: "Frequently asked questions",
    faq: [
      { q: "Why do different businesses make money in different ways?", a: "Because they sell different things. Some rent out assets, some sell time and expertise (services), some put money to work (finance), some gather attention and sell ads (content), and some make or resell goods at a markup (products). Even with the same revenue, different cost structures leave different profit." },
      { q: "What is cashflow?", a: "It's the actual movement of money in and out — different from accounting ‘profit.’ A business can show a book profit yet stall if cash doesn't circulate (e.g., unpaid receivables)." },
      { q: "Why do profitable businesses still fail?", a: "Profit is a number on the books; failure happens when cash runs out. If sales are on credit but salaries, rent and loan interest leave in cash now, even a profitable business can hit insolvency." },
      { q: "Which models have the best margins?", a: "The lower the cost of serving one more customer (marginal cost), the better. SaaS and academies improve margins sharply as they add customers under the same fixed cost; product and food businesses carry heavier cost-of-goods and fixed costs." },
      { q: "Are these numbers accurate?", a: "This is an educational model to build intuition about business structure. Real margins and costs vary widely by company, time and place — always use concrete data and professional advice for any startup or investment decision." },
    ],
    relatedTitle: "Pairs well with",
    related: [
      { href: "/saju/calculator", label: "Saju Calculator", desc: "Innate temperament and career flow." },
      { href: "/life-balance", label: "Wheel of Life", desc: "8-area balance, finance included." },
    ],
  },
};
const c = content[locale] ?? content.en;
const related = c.related.map((r) => ({ ...r, href: withTrailingSlash(`/${locale}${r.href}`) }));

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: c.faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
});
const appJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: m.title,
  url: `${BASE}/${locale}/business-cashflow`,
  applicationCategory: "EducationApplication",
  operatingSystem: "Web",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  inLanguage: locale,
  description: m.description,
});
---

<Layout title={m.title} description={m.description} locale={locale}>
  <script is:inline type="application/ld+json" set:html={faqJsonLd} />
  <script is:inline type="application/ld+json" set:html={appJsonLd} />
  <div class="container mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{m.title}</h1>
      <p class="mt-3 leading-relaxed text-muted-foreground">{c.lead}</p>
    </header>

    <CashflowExplorer locale={locale} client:load />

    <section class="mt-12">
      <h2 class="mb-4 text-2xl font-bold">{c.faqTitle}</h2>
      <div class="space-y-3">
        {c.faq.map((f) => (
          <details class="group rounded-xl border border-border bg-card p-4">
            <summary class="cursor-pointer list-none font-semibold marker:content-none">
              <span class="text-primary">Q.</span> {f.q}
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-12">
      <h2 class="mb-4 text-xl font-bold">{c.relatedTitle}</h2>
      <div class="grid gap-3 md:grid-cols-2">
        {related.map((r) => (
          <a class="rounded-xl border border-border bg-card p-4 transition-colors hover:border-primary/40 hover:bg-primary/5" href={r.href}>
            <span class="font-semibold">{r.label}</span>
            <span class="mt-1 block text-sm text-muted-foreground">{r.desc}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
