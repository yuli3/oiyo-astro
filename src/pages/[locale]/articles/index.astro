---
// 아티클 색인 — topic 48종을 한 장에 모은다.
//
// 이 페이지 하나로 모든 topic 페이지가 인바운드를 얻고, topic 페이지가
// 글들에게 인바운드를 준다. 상세 페이지의 RelatedArticles 가 글끼리 묶어
// 그물을 완성한다(PRD §4).
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { topicName, MIN_TOPIC_ARTICLES } from "../../../lib/articles/topics";
import { LOCALES } from "../../../i18n";
import type { Locale } from "../../../i18n";

const slugOf = (id: string) => id.split("/").pop()!.replace(/\.mdx$/, "");

export async function getStaticPaths() {
  // Astro 는 getStaticPaths 를 격리해 실행하므로 모듈 스코프 헬퍼가 보이지 않는다.
  const slugOf = (id: string) => id.split("/").pop()!.replace(/\.mdx$/, "");
  const all = await getCollection("articles");
  return LOCALES.map((locale: Locale) => {
    const mine = all.filter((e) => e.data.locale === locale && e.data.topic);
    const byTopic = new Map<string, typeof mine>();
    for (const e of mine) {
      const list = byTopic.get(e.data.topic!) ?? [];
      list.push(e);
      byTopic.set(e.data.topic!, list);
    }
    const groups = [...byTopic.entries()]
      .map(([topic, list]) => ({
        topic,
        count: list.length,
        // 1편짜리 topic 은 목록 페이지를 만들지 않으므로 카드가 그 글로 바로 간다.
        href:
          list.length >= MIN_TOPIC_ARTICLES
            ? `/${locale}/topic/${topic}/`
            : `/${locale}/${slugOf(list[0].id)}/`,
        preview: list
          .slice()
          .sort(
            (a, b) =>
              new Date(b.data.pubDate ?? 0).valueOf() -
              new Date(a.data.pubDate ?? 0).valueOf(),
          )
          .slice(0, 3)
          .map((e) => ({ slug: slugOf(e.id), title: e.data.title })),
      }))
      .sort((a, b) => b.count - a.count || a.topic.localeCompare(b.topic));
    return {
      params: { locale },
      props: { locale, groups, total: mine.length },
    };
  });
}

const { locale, groups, total } = Astro.props as {
  locale: Locale;
  groups: {
    topic: string;
    count: number;
    href: string;
    preview: { slug: string; title: string }[];
  }[];
  total: number;
};

const T: Record<string, { title: string; sub: (a: number, t: number) => string; count: (n: number) => string; more: string }> = {
  ko: {
    title: "글 모아보기",
    sub: (a, t) => `${t}개 주제에 걸친 글 ${a}편이에요.`,
    count: (n) => `${n}편`,
    more: "더 보기",
  },
  en: {
    title: "All articles",
    sub: (a, t) => `${a} articles across ${t} topics.`,
    count: (n) => `${n}`,
    more: "More",
  },
  ja: {
    title: "記事一覧",
    sub: (a, t) => `${t}のテーマに${a}本の記事があります。`,
    count: (n) => `${n}本`,
    more: "もっと見る",
  },
  zh: {
    title: "全部文章",
    sub: (a, t) => `${t} 个主题，共 ${a} 篇文章。`,
    count: (n) => `${n} 篇`,
    more: "更多",
  },
  fr: {
    title: "Tous les articles",
    sub: (a, t) => `${a} articles répartis sur ${t} thèmes.`,
    count: (n) => `${n}`,
    more: "Plus",
  },
  es: {
    title: "Todos los artículos",
    sub: (a, t) => `${a} artículos en ${t} temas.`,
    count: (n) => `${n}`,
    more: "Más",
  },
};
const t = T[locale] ?? T.en;
---

<Layout
  title={`${t.title} — Oiyo`}
  description={t.sub(total, groups.length)}
  locale={locale}
>
  <section class="mx-auto w-full max-w-5xl px-4 py-10 sm:py-14">
    <h1 class="text-3xl font-extrabold tracking-tight text-neutral-900 sm:text-4xl">
      {t.title}
    </h1>
    <p class="mt-2 text-sm text-neutral-500 sm:text-base">
      {t.sub(total, groups.length)}
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {groups.map((g) => (
        <article class="flex flex-col rounded-2xl border border-neutral-200 bg-white p-4 transition-colors hover:border-emerald-300">
          <a
            href={g.href}
            class="flex items-baseline justify-between gap-2 text-base font-bold tracking-tight text-neutral-900 hover:text-emerald-700"
          >
            <span class="min-w-0">{topicName(g.topic, locale)}</span>
            <span class="shrink-0 text-xs font-semibold tabular-nums text-neutral-400">
              {t.count(g.count)}
            </span>
          </a>
          <ul class="mt-3 space-y-1.5">
            {g.preview.map((p) => (
              <li>
                <a
                  href={`/${locale}/${p.slug}/`}
                  class="line-clamp-1 block text-xs leading-relaxed text-neutral-600 underline-offset-4 hover:text-emerald-700 hover:underline"
                >
                  {p.title}
                </a>
              </li>
            ))}
          </ul>
          {g.count > g.preview.length && (
            <a
              href={g.href}
              class="mt-3 self-start text-xs font-semibold text-emerald-700 underline-offset-4 hover:underline"
            >
              {t.more} →
            </a>
          )}
        </article>
      ))}
    </div>
  </section>
</Layout>
