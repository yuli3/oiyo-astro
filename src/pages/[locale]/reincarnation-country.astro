---
import Layout from "../../layouts/Layout.astro";
import { LOCALES } from "../../i18n";
import type { Locale } from "../../i18n";
import ReincarnationCountry from "../../components/tools/ReincarnationCountry";
import RelatedTools from "../../components/shared/RelatedTools.astro";

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string; heading: string; intro: string }> = {
  ko: {
    title: "다시 태어난다면 어느 나라? — 신생아·인구 가중 추첨",
    description: "지금 태어나는 아이 기준 또는 현재 인구 기준으로, 환생 국가를 가중 추첨합니다. 여러 번도 가능합니다.",
    heading: "다시 태어난다면 어느 나라?",
    intro: "점이 아닙니다. 세계은행 인구와 조출생률로 연간 출생 수를 추정한 뒤, 신생아 비중 또는 인구 비중으로 나라를 뽑습니다. 여러 번은 서로 독립입니다.",
  },
  en: {
    title: "If you were born again, which country? — Birth or population weights",
    description: "A weighted draw of your next country using current births or current population. Multiple independent lives are allowed.",
    heading: "If you were born again, which country?",
    intro: "This is not a fortune. It draws a country with World Bank population and crude birth rates, using either today's births or today's population as the weight.",
  },
  ja: {
    title: "生まれ変わるとしたらどの国？ — 出生または人口の重み",
    description: "いま生まれている子ども、またはいま生きている人の重みで次の国を抽選します。複数回も独立です。",
    heading: "生まれ変わるとしたらどの国？",
    intro: "占いではありません。世界銀行の人口と粗出生率から出生数を推定し、出生または人口の比率で国を引きます。",
  },
  zh: {
    title: "如果再出生会在哪个国家？ — 按新生儿或人口加权",
    description: "用当前出生数或当前人口做加权抽取。可以独立抽取多次。",
    heading: "如果再出生会在哪个国家？",
    intro: "这不是占卜。用世界银行人口与粗出生率估算出生数，再按新生儿或人口比重抽国家。",
  },
  fr: {
    title: "Si vous renaissiez, dans quel pays ? — Naissances ou population",
    description: "Tirage pondéré du prochain pays selon les naissances actuelles ou la population actuelle. Plusieurs vies indépendantes sont possibles.",
    heading: "Si vous renaissiez, dans quel pays ?",
    intro: "Ce n'est pas une voyance. Les poids viennent des indicateurs Banque mondiale : naissances estimées ou population.",
  },
  es: {
    title: "Si nacieras de nuevo, ¿en qué país? — Nacimientos o población",
    description: "Sorteo ponderado del siguiente país según nacimientos actuales o población actual. Puedes repetir vidas independientes.",
    heading: "Si nacieras de nuevo, ¿en qué país?",
    intro: "No es un horóscopo. Usa población y tasa bruta de natalidad del Banco Mundial, con peso de nacimientos o de población.",
  },
};

const m = meta[locale] ?? meta.en;
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto max-w-3xl px-4 py-8">
    <h1 class="text-3xl font-black tracking-tight text-slate-900">{m.heading}</h1>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate-600">{m.intro}</p>
    <div class="mt-6">
      <ReincarnationCountry locale={locale} client:load />
    </div>
    <RelatedTools locale={locale} tools={["countryMatch", "chineseZodiac", "numerology", "riasec"]} current="reincarnation" />
    {locale === "ko" && (
      <section class="mt-10 text-sm leading-relaxed text-slate-600">
        <h2 class="text-lg font-bold text-slate-900">이 숫자는 무엇인가</h2>
        <p class="mt-2">신생아 모드는 지금 태어나는 아이 기준입니다. 인구 모드는 지금 살아 있는 사람 기준입니다. 행복도나 GDP로 확률을 바꾸지 않습니다.</p>
        <p class="mt-2">여러 번은 서로 독립입니다. 같은 나라가 또 나와도 오류가 아닙니다.</p>
      </section>
    )}
  </div>
</Layout>
