---
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import RelatedTools from '../../../components/shared/RelatedTools.astro';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const target = `/${locale}/lazy-perfectionist/test/`;

const meta: Record<Locale, { title: string; description: string; label: string }> = {
  ko: {
    title: '완벽주의 테스트 — 게으른 완벽주의 테스트로 이동',
    description: '완벽주의형 미루기, 실패 회피, 기준 과잉을 점검하는 게으른 완벽주의 테스트로 이동합니다.',
    label: '게으른 완벽주의 테스트로 이동',
  },
  en: {
    title: 'Perfectionism Test — Continue to Lazy Perfectionist Test',
    description: 'Continue to the lazy perfectionist test for perfectionist procrastination, fear of failure, and overplanning.',
    label: 'Continue to the lazy perfectionist test',
  },
  ja: {
    title: '完璧主義テスト — 怠けた完璧主義者テストへ',
    description: '完璧主義的な先延ばし、失敗回避、計画過多を確認するテストへ移動します。',
    label: '怠けた完璧主義者テストへ',
  },
  zh: {
    title: '完美主义测试 — 前往懒惰完美主义者测试',
    description: '前往检查完美主义拖延、失败回避和过度计划的测试。',
    label: '前往懒惰完美主义者测试',
  },
  fr: {
    title: 'Test de Perfectionnisme — Continuer vers le test dédié',
    description: 'Continuez vers le test du perfectionnisme paresseux pour explorer procrastination, peur de l’échec et sur-planification.',
    label: 'Continuer vers le test dédié',
  },
  es: {
    title: 'Test de Perfeccionismo — Continuar al test dedicado',
    description: 'Continúa al test de perfeccionismo perezoso para revisar procrastinación, miedo al fracaso y sobreplanificación.',
    label: 'Continuar al test dedicado',
  },
};

const m = meta[locale] ?? meta.en;

const content: Record<Locale, { introTitle: string; intro: string; conceptTitle: string; concepts: { title: string; body: string }[]; faqTitle: string; faqs: { question: string; answer: string }[]; disclaimer: string; }> = {
  ko: { introTitle: '완벽주의는 사람을 단정하는 라벨이 아니라 높은 기준과 미루기의 관계를 보는 렌즈입니다', intro: '완벽주의 테스트는 완벽주의형 미루기, 실패 회피, 계획 과잉이 시작을 어떻게 늦추는지 살펴보는 게으른 완벽주의 테스트로 이어집니다. 결과는 의지 부족을 단정하기보다 기준과 시작 방식을 이해하기 위한 참고입니다.', conceptTitle: '완벽주의를 읽는 세 가지 관점', concepts: [{ title: '높은 기준', body: '기준이 도움을 주는지, 시작을 막는 압박이 되는지 구분합니다.' }, { title: '실패 회피', body: '틀릴 가능성을 줄이려다 행동 자체가 늦어지는 패턴을 봅니다.' }, { title: '작은 시작', body: '완벽한 준비보다 작고 반복 가능한 행동이 흐름을 만들 수 있습니다.' }], faqTitle: '자주 묻는 질문', faqs: [{ question: '완벽주의 결과는 얼마나 정확한가요?', answer: '현재 답변에 나타난 기준과 미루기 경향을 요약한 참고 자료입니다. 과제와 상황에 따라 달라질 수 있습니다.' }, { question: '완벽주의는 항상 나쁜가요?', answer: '아니요. 높은 기준은 도움이 될 수 있지만, 시작을 막거나 회복을 어렵게 만들 때는 조정이 필요합니다.' }, { question: '결과를 어떻게 활용하면 좋나요?', answer: '완벽한 결과보다 오늘 시작할 수 있는 가장 작은 행동을 정하는 데 사용해 보세요.' }], disclaimer: '완벽주의 테스트 결과는 자기 이해와 대화를 위한 참고입니다. 진단, 채용, 관계의 단정적 판단 근거로 사용하지 마세요.' },
  en: { introTitle: 'Perfectionism is a lens for high standards and delay, not a label that defines you', intro: 'The perfectionism test leads to the lazy perfectionist test, which looks at how perfectionistic procrastination, fear of failure, and overplanning slow the start. The result is a reference for understanding standards and starting patterns, not a judgment of willpower.', conceptTitle: 'Three ways to read perfectionism', concepts: [{ title: 'High standards', body: 'It separates standards that guide you from pressure that blocks the start.' }, { title: 'Fear of failure', body: 'Trying to reduce mistakes can sometimes delay action itself.' }, { title: 'Small start', body: 'A small repeatable action can create movement before perfect preparation is ready.' }], faqTitle: 'Frequently asked questions', faqs: [{ question: 'How accurate is the perfectionism result?', answer: 'It summarizes standards and delay tendencies shown in your current answers. Task and context can shift it.' }, { question: 'Is perfectionism always bad?', answer: 'No. High standards can help, but they may need adjustment when they block starting or recovery.' }, { question: 'How should I use the result?', answer: 'Use it to choose the smallest action you can start today, rather than to perfect the outcome first.' }], disclaimer: 'Perfectionism test results are for self-understanding and conversation. Do not use them as a basis for diagnosis, hiring, or definitive relationship judgments.' },
  ja: { introTitle: '完璧主義は人を決めつけるラベルではなく、高い基準と先延ばしの関係を見るレンズです', intro: '完璧主義テストは、完璧主義的な先延ばし、失敗回避、計画過多が開始を遅らせるしくみを見る怠けた完璧主義者テストへ続きます。結果は意志の弱さではなく、基準と開始のしかたを理解する参考です。', conceptTitle: '完璧主義を読む三つの視点', concepts: [{ title: '高い基準', body: '助けになる基準と、開始を止める圧力を分けて見ます。' }, { title: '失敗回避', body: '間違いを減らそうとして行動そのものが遅れるパターンです。' }, { title: '小さな開始', body: '完璧な準備より、小さく繰り返せる行動が流れを作ります。' }], faqTitle: 'よくある質問', faqs: [{ question: '完璧主義の結果はどれくらい正確ですか？', answer: '現在の回答に表れた基準と先延ばし傾向の要約です。課題や状況によって変わります。' }, { question: '完璧主義はいつも悪いですか？', answer: 'いいえ。高い基準は助けになりますが、開始や回復を妨げるときは調整が必要です。' }, { question: '結果はどう使えばよいですか？', answer: '完璧な結果より、今日始められる最小の行動を決めるために使ってください。' }], disclaimer: '完璧主義テストの結果は自己理解と対話のための参考です。診断、採用、人間関係の断定的判断には使わないでください。' },
  zh: { introTitle: '完美主义是观察高标准与拖延关系的镜片，不是定义人的标签', intro: '完美主义测试会前往懒惰完美主义者测试，观察完美主义拖延、失败回避和过度计划如何延迟开始。结果不是评判意志力，而是理解标准和启动方式的参考。', conceptTitle: '理解完美主义的三个角度', concepts: [{ title: '高标准', body: '区分能引导你的标准，以及阻挡开始的压力。' }, { title: '失败回避', body: '为了减少错误，有时反而让行动本身延后。' }, { title: '小开始', body: '比起完美准备，一个可重复的小行动更容易带来流动。' }], faqTitle: '常见问题', faqs: [{ question: '完美主义结果有多准确？', answer: '它概括的是当前回答中的标准和拖延倾向。任务与情境会影响结果。' }, { question: '完美主义总是不好吗？', answer: '不是。高标准可以有帮助，但当它阻挡开始或恢复时，就需要调整。' }, { question: '应该如何使用结果？', answer: '用它来决定今天能开始的最小行动，而不是先追求完美结果。' }], disclaimer: '完美主义测试结果仅用于自我理解与对话，请勿作为诊断、招聘或关系定论的依据。' },
  fr: { introTitle: 'Le perfectionnisme est une lentille sur standards élevés et report, pas une étiquette qui vous définit', intro: 'Le test de perfectionnisme mène au test du perfectionniste paresseux, qui explore procrastination perfectionniste, peur de l’échec et sur-planification. Le résultat aide à comprendre standards et démarrage, sans juger la volonté.', conceptTitle: 'Trois façons de lire le perfectionnisme', concepts: [{ title: 'Standards élevés', body: 'On distingue les standards qui guident de la pression qui bloque le départ.' }, { title: 'Peur de l’échec', body: 'Réduire les erreurs peut parfois retarder l’action elle-même.' }, { title: 'Petit départ', body: 'Une petite action répétable peut créer du mouvement avant la préparation parfaite.' }], faqTitle: 'Questions fréquentes', faqs: [{ question: 'Le résultat est-il fiable ?', answer: 'Il résume les tendances de standards et de report visibles dans vos réponses. La tâche et le contexte peuvent le modifier.' }, { question: 'Le perfectionnisme est-il toujours mauvais ?', answer: 'Non. Des standards élevés peuvent aider, mais ils demandent ajustement quand ils bloquent le départ ou la récupération.' }, { question: 'Comment l’utiliser ?', answer: 'Utilisez-le pour choisir la plus petite action à commencer aujourd’hui, plutôt que parfaire le résultat.' }], disclaimer: 'Les résultats du test de perfectionnisme servent à la compréhension de soi et au dialogue. Ne les utilisez pas comme base de diagnostic, de recrutement ou de verdict relationnel.' },
  es: { introTitle: 'El perfeccionismo es una lente sobre estándares altos y demora, no una etiqueta que te define', intro: 'El test de perfeccionismo lleva al test del perfeccionista perezoso, que explora procrastinación perfeccionista, miedo al fracaso y sobreplanificación. El resultado ayuda a entender estándares e inicio, sin juzgar la voluntad.', conceptTitle: 'Tres formas de leer el perfeccionismo', concepts: [{ title: 'Estándares altos', body: 'Distingue estándares que orientan de presión que bloquea el inicio.' }, { title: 'Miedo al fracaso', body: 'Intentar reducir errores puede retrasar la acción misma.' }, { title: 'Inicio pequeño', body: 'Una acción pequeña y repetible puede crear movimiento antes de la preparación perfecta.' }], faqTitle: 'Preguntas frecuentes', faqs: [{ question: '¿Qué tan preciso es el resultado?', answer: 'Resume tendencias de estándares y demora que aparecen en tus respuestas. Tarea y contexto pueden cambiarlo.' }, { question: '¿El perfeccionismo siempre es malo?', answer: 'No. Los estándares altos pueden ayudar, pero necesitan ajuste cuando bloquean el inicio o la recuperación.' }, { question: '¿Cómo usarlo?', answer: 'Úsalo para elegir la acción más pequeña que puedas empezar hoy, no para perfeccionar primero el resultado.' }], disclaimer: 'Los resultados del test de perfeccionismo son para autoconocimiento y conversación. No los uses como base para diagnóstico, contratación o juicios definitivos sobre relaciones.' },
};

const c = content[locale] ?? content.en;
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{m.title} | OIYO</title>
    <meta name="description" content={m.description} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <meta http-equiv="refresh" content={`0; url=${target}`} />
  <link rel="canonical" href={`https://oiyo.net${target}`} />
    <style>
      body { margin: 0; font-family: system-ui, sans-serif; color: #052e16; background: #f7fee7; }
      main { max-width: 42rem; margin: 0 auto; padding: 4rem 1rem; text-align: center; }
      a { display: inline-flex; margin-top: 1.5rem; border-radius: .5rem; background: #15803d; color: white; padding: .75rem 1rem; font-weight: 700; text-decoration: none; }
    </style>
  </head>
  <body>
    <div>
      <h1>{m.title}</h1>
      <p>{m.description}</p>
      <a href={target}>{m.label}</a>
      <section class="mt-10 border-t border-violet-100 pt-8"><h2 class="text-2xl font-bold text-violet-950">{c.introTitle}</h2><p class="mt-4 leading-8 text-violet-800">{c.intro}</p></section>
      <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.conceptTitle}</h2><div class="mt-4 grid gap-4 md:grid-cols-3">{c.concepts.map((item) => (<article class="rounded-xl border border-violet-100 bg-white p-4"><h3 class="font-semibold text-violet-950">{item.title}</h3><p class="mt-2 text-sm leading-6 text-violet-700">{item.body}</p></article>))}</div></section>
      <section class="mt-10"><h2 class="text-xl font-bold text-violet-950">{c.faqTitle}</h2><div class="mt-4 divide-y divide-violet-100 rounded-xl border border-violet-100 bg-white">{c.faqs.map((faq) => (<details class="group p-4"><summary class="cursor-pointer list-none font-semibold text-violet-950">{faq.question}</summary><p class="mt-3 text-sm leading-6 text-violet-700">{faq.answer}</p></details>))}</div></section>
      <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>
    <RelatedTools locale={locale} tools={['lazyPerfectionist','selfEsteem','adhd','anxiety']} current="perfectionism" />
    </div>
  </body>
</html>
