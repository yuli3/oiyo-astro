---
import Layout from '../../../layouts/Layout.astro';
import { withTrailingSlash, LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import CountryMatch from '../../../components/tools/CountryMatch';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<string, { title: string; description: string }> = {
  ko: {
    title: '나에게 맞는 나라 찾기 — 라이프스타일 국가 매칭 테스트',
    description: '기후·도시·문화 등 취향 몇 가지로 당신과 가장 잘 맞는 나라를 찾아주는 테스트. 여행·이주·한 달 살기 영감. 무료.',
  },
  en: {
    title: 'Find Your Country Match — Lifestyle Country Quiz',
    description: 'Answer a few preferences (climate, city, culture) and discover the countries that fit you best. Inspiration for travel, relocation, or a month abroad. Free.',
  },
  ja: {
    title: '自分に合う国を探す — ライフスタイル国マッチング',
    description: '気候・都市・文化などの好みから、あなたに最も合う国を見つけるテスト。旅行・移住・一か月暮らしのヒントに。無料。',
  },
  zh: {
    title: '寻找最适合你的国家 — 生活方式国家测试',
    description: '通过气候、城市、文化等几项偏好，为你找到最契合的国家。为旅行、移居或短居海外提供灵感。免费。',
  },
  fr: {
    title: 'Trouvez votre pays idéal — Quiz de style de vie',
    description: "Répondez à quelques préférences (climat, ville, culture) et découvrez les pays qui vous correspondent le mieux. Une inspiration pour voyager, s'expatrier ou vivre un mois à l'étranger. Gratuit.",
  },
  es: {
    title: 'Encuentra tu país ideal — Test de estilo de vida',
    description: 'Responde a algunas preferencias (clima, ciudad, cultura) y descubre los países que mejor encajan contigo. Inspiración para viajar, mudarte o vivir un mes en el extranjero. Gratis.',
  },
};
const m = meta[locale] ?? meta.en;

const content: Record<string, {
  introTitle: string; intro: string;
  relatedTitle: string; related: { href: string; label: string; desc: string }[];
}> = {
  ko: {
    introTitle: '취향이 곧 목적지입니다',
    intro: '어떤 기후를 좋아하는지, 도시와 자연 중 무엇에 끌리는지 — 몇 가지 라이프스타일 취향만으로 당신과 결이 맞는 나라를 골라드립니다. 여행지 고민, 한 달 살기, 이주 상상에 가볍게 활용해 보세요.',
    relatedTitle: '함께 보면 좋은 것',
    related: [
      { href: '/saju/calculator', label: '사주 계산기', desc: '내 기운과 어울리는 방향·기질.' },
      { href: '/strengths/keywords', label: '강점 키워드', desc: '나를 끌리는 단어로 이해하기.' },
      { href: '/reincarnation-country', label: '다시 태어난다면', desc: '취향이 아니라 신생아·인구 가중 추첨.' },
    ],
  },
  en: {
    introTitle: 'Your taste is your destination',
    intro: "What climate you love, city or nature — a few lifestyle preferences are enough to surface countries that match your vibe. Great for picking a trip, a month abroad, or imagining a move.",
    relatedTitle: 'Pairs well with',
    related: [
      { href: '/saju/calculator', label: 'Saju Calculator', desc: 'Directions and temperament that suit your energy.' },
      { href: '/strengths/keywords', label: 'Strength Keywords', desc: 'Know yourself through resonant words.' },
      { href: '/reincarnation-country', label: 'If you were born again', desc: 'A weighted draw by births or population, not taste.' },
    ],
  },
  ja: {
    introTitle: '好みがあなたの行き先になる',
    intro: 'どんな気候が好きか、都市と自然どちらに惹かれるか — いくつかのライフスタイルの好みだけで、あなたと相性の良い国を見つけます。旅行先選びや一か月暮らし、移住の想像に気軽に使ってみてください。',
    relatedTitle: '合わせて見たいもの',
    related: [
      { href: '/saju/calculator', label: '四柱推命計算機', desc: 'あなたの気質に合う方角・気質。' },
      { href: '/strengths/keywords', label: '強みキーワード', desc: '惹かれる言葉から自分を知る。' },
      { href: '/reincarnation-country', label: '生まれ変わるとしたら', desc: '好みではなく、出生または人口の重み抽選。' },
    ],
  },
  zh: {
    introTitle: '你的喜好就是你的目的地',
    intro: '你喜欢什么样的气候，更偏爱城市还是自然——只需几项生活方式偏好，就能为你找到气质相符的国家。无论是选旅行地、体验一个月的海外生活，还是畅想移居，都可以轻松一试。',
    relatedTitle: '搭配阅读',
    related: [
      { href: '/saju/calculator', label: '八字计算器', desc: '与你气场相合的方位与气质。' },
      { href: '/strengths/keywords', label: '优势关键词', desc: '用触动你的词语了解自己。' },
      { href: '/reincarnation-country', label: '如果再出生', desc: '不是喜好，而是按新生儿或人口加权抽取。' },
    ],
  },
  fr: {
    introTitle: 'Vos goûts sont votre destination',
    intro: "Le climat que vous aimez, la ville ou la nature qui vous attire — quelques préférences de style de vie suffisent pour révéler les pays qui vous correspondent. Idéal pour choisir une destination de voyage, imaginer un mois à l'étranger ou un déménagement.",
    relatedTitle: 'À découvrir aussi',
    related: [
      { href: '/saju/calculator', label: 'Calculateur Saju', desc: 'Les directions et le tempérament qui correspondent à votre énergie.' },
      { href: '/strengths/keywords', label: 'Mots-clés de force', desc: 'Apprenez à vous connaître à travers des mots qui résonnent.' },
      { href: '/reincarnation-country', label: 'Si vous renaissiez', desc: 'Tirage pondéré par naissances ou population, pas par goût.' },
    ],
  },
  es: {
    introTitle: 'Tu gusto es tu destino',
    intro: 'El clima que te gusta, si te atrae más la ciudad o la naturaleza — bastan algunas preferencias de estilo de vida para descubrir los países que encajan contigo. Ideal para elegir un viaje, imaginar un mes en el extranjero o una mudanza.',
    relatedTitle: 'Combina bien con',
    related: [
      { href: '/saju/calculator', label: 'Calculadora Saju', desc: 'Direcciones y temperamento que se ajustan a tu energía.' },
      { href: '/strengths/keywords', label: 'Palabras clave de fortaleza', desc: 'Conócete a través de palabras que resuenan contigo.' },
      { href: '/reincarnation-country', label: 'Si nacieras de nuevo', desc: 'Sorteo por nacimientos o población, no por gusto.' },
    ],
  },
};
const c = content[locale] ?? content.en;
const localizedRelated = c.related.map((item) => ({ ...item, href: withTrailingSlash(`/${locale}${item.href}`) }));
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <CountryMatch locale={locale} client:load />

    <section class="mt-10 border-t border-green-100 pt-8">
      <h2 class="text-2xl font-bold text-green-950">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-green-800">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-green-950">{c.relatedTitle}</h2>
      <div class="mt-4 grid gap-3 md:grid-cols-3">
        {localizedRelated.map((item) => (
          <a class="rounded-xl border border-green-100 bg-white p-4 transition-colors hover:border-green-300 hover:bg-green-50" href={item.href}>
            <span class="font-semibold text-green-950">{item.label}</span>
            <span class="mt-2 block text-sm leading-6 text-green-700">{item.desc}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
