---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import MbtiCareerTest from '../../../components/tests/MbtiCareerTest';
import TestContentBridge from '../../../components/shared/TestContentBridge.astro';
import { getTestBridge } from '../../../data/test-content-bridges';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: 'MBTI 직업 적성 테스트 — 나에게 맞는 직업은?',
    description: '12가지 업무 상황 질문으로 나의 MBTI 직업 유형을 알아보세요. 추천 직업, 업무 스타일, 이상적인 환경까지 분석해드립니다.',
  },
  en: {
    title: 'MBTI Career Test — What Career Suits You?',
    description: 'Discover your MBTI career type through 12 work scenario questions. Find recommended careers, work style, and ideal environments.',
  },
  ja: {
    title: 'MBTI 職業適性テスト — あなたに合う職業は？',
    description: '12の職場シナリオで自分のMBTI職業タイプを発見。おすすめ職業、仕事スタイル、理想的な環境を分析します。',
  },
  zh: {
    title: 'MBTI 职业适性测试 — 什么职业适合你？',
    description: '通过12个工作情境问题发现你的MBTI职业类型。找到推荐职业、工作风格和理想环境。',
  },
  fr: {
    title: 'Test de Carrière MBTI — Quelle carrière vous convient?',
    description: 'Découvrez votre type de carrière MBTI à travers 12 scénarios de travail.',
  },
  es: {
    title: 'Test de Carrera MBTI — ¿Qué carrera te conviene?',
    description: 'Descubre tu tipo de carrera MBTI con 12 preguntas sobre situaciones de trabajo.',
  },
};

const m = meta[locale] ?? meta.en;
const bridge = getTestBridge('mbti', locale);
---

<Layout title={m.title} description={m.description} locale={locale}>
  <main class="mx-auto max-w-2xl px-4 py-10">
    <MbtiCareerTest client:load locale={locale} />
    <TestContentBridge content={bridge.content} blogUrl={bridge.blogUrl} wikiUrl={bridge.wikiUrl} />
  </main>
</Layout>
