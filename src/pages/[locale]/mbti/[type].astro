---
import Layout from '../../../layouts/Layout.astro';
import MentalBoost from '../../../components/shared/MentalBoost.astro';
import { LOCALES, withTrailingSlash } from '../../../i18n';
import type { Locale } from '../../../i18n';
import { MBTI_DEEP_DATA, COGNITIVE_FUNCTIONS } from '../../../lib/engines/interpretation/shards/mbti-deep-shards';
import { TYPE_PROFILES } from '../../../components/tests/MbtiPersonalityTest';
import { MBTI_LIFE_KO } from '../../../lib/engines/interpretation/shards/mbti-life-ko';
import type { SixLangString } from '../../../lib/engines/interpretation/engine.contract';

const COGNITIVE_STACK_BY_TYPE: Record<string, [string, string, string, string]> = {
  ISTJ: ['Si', 'Te', 'Fi', 'Ne'], ISFJ: ['Si', 'Fe', 'Ti', 'Ne'],
  INFJ: ['Ni', 'Fe', 'Ti', 'Se'], INTJ: ['Ni', 'Te', 'Fi', 'Se'],
  ISTP: ['Ti', 'Se', 'Ni', 'Fe'], ISFP: ['Fi', 'Se', 'Ni', 'Te'],
  INFP: ['Fi', 'Ne', 'Si', 'Te'], INTP: ['Ti', 'Ne', 'Si', 'Fe'],
  ESTP: ['Se', 'Ti', 'Fe', 'Ni'], ESFP: ['Se', 'Fi', 'Te', 'Ni'],
  ENFP: ['Ne', 'Fi', 'Te', 'Si'], ENTP: ['Ne', 'Ti', 'Fe', 'Si'],
  ESTJ: ['Te', 'Si', 'Ne', 'Fi'], ESFJ: ['Fe', 'Si', 'Ne', 'Ti'],
  ENFJ: ['Fe', 'Ni', 'Se', 'Ti'], ENTJ: ['Te', 'Ni', 'Se', 'Fi'],
};

export async function getStaticPaths() {
  const types = Object.keys(MBTI_DEEP_DATA) as (keyof typeof MBTI_DEEP_DATA)[];
  const paths: { params: { locale: string; type: string }; props: { locale: Locale; type: string } }[] = [];
  for (const locale of LOCALES) {
    for (const type of types) {
      paths.push({ params: { locale, type: type.toLowerCase() }, props: { locale, type } });
    }
  }
  return paths;
}

const { locale, type } = Astro.props as { locale: Locale; type: string };
const data = MBTI_DEEP_DATA[type as keyof typeof MBTI_DEEP_DATA];
const profile = TYPE_PROFILES[type as keyof typeof TYPE_PROFILES];
const stack = COGNITIVE_STACK_BY_TYPE[type];

// 직업 적성·관계 해설은 한국어 원문만 존재한다(wiki 48편 흡수, 기계번역 안 함).
// locale 이 ko 가 아니면 undefined 라 아래 두 섹션이 통째로 렌더되지 않는다 —
// 이 가드를 지우면 전 로케일에 한국어가 노출된다.
const lifeKo = locale === 'ko' ? MBTI_LIFE_KO[type] : undefined;

function t(s: SixLangString): string {
  return s[locale] ?? s.en;
}
const typeName = locale === 'ko' ? profile.ko : profile.en;

const L: Record<Locale, {
  cognitiveStackTitle: string;
  worldviewTitle: string;
  strengthsTitle: string;
  challengesTitle: string;
  growthTitle: string;
  lifeTitle: string;
  otherTypesTitle: string;
  testCta: string;
  disclaimer: string;
  breadcrumbHome: string;
  breadcrumbMbti: string;
}> = {
  ko: {
    cognitiveStackTitle: '인지기능 스택',
    worldviewTitle: '세상을 보는 방식',
    strengthsTitle: '강점',
    challengesTitle: '주의할 점',
    growthTitle: '성장 방향',
    lifeTitle: '삶과 관계에 미치는 영향',
    otherTypesTitle: '다른 유형 보기',
    testCta: '내 MBTI 유형 확인하기 →',
    disclaimer: '이 설명은 자기 이해를 돕는 참고 자료이며, 공식 MBTI 진단이나 채용·진로의 단정적 근거로 사용하지 마세요.',
    breadcrumbHome: '홈',
    breadcrumbMbti: 'MBTI',
  },
  en: {
    cognitiveStackTitle: 'Cognitive Function Stack',
    worldviewTitle: 'How This Type Sees the World',
    strengthsTitle: 'Strengths',
    challengesTitle: 'Common Challenges',
    growthTitle: 'Growth Path',
    lifeTitle: 'Life & Relationship Implications',
    otherTypesTitle: 'Explore Other Types',
    testCta: 'Find your MBTI type →',
    disclaimer: 'This description is a reference for self-understanding. Do not use it as a formal MBTI diagnosis or as a definitive basis for hiring or career decisions.',
    breadcrumbHome: 'Home',
    breadcrumbMbti: 'MBTI',
  },
  ja: {
    cognitiveStackTitle: '認知機能スタック',
    worldviewTitle: 'この型が世界を見る方法',
    strengthsTitle: '強み',
    challengesTitle: '気をつけたい点',
    growthTitle: '成長の方向',
    lifeTitle: '人生と人間関係への影響',
    otherTypesTitle: '他のタイプを見る',
    testCta: '自分のMBTIタイプを調べる →',
    disclaimer: 'この説明は自己理解のための参考資料です。正式なMBTI診断や採用・進路の断定的な根拠として使用しないでください。',
    breadcrumbHome: 'ホーム',
    breadcrumbMbti: 'MBTI',
  },
  zh: {
    cognitiveStackTitle: '认知功能栈',
    worldviewTitle: '这个类型如何看世界',
    strengthsTitle: '优势',
    challengesTitle: '需要注意的地方',
    growthTitle: '成长方向',
    lifeTitle: '对生活与人际关系的影响',
    otherTypesTitle: '查看其他类型',
    testCta: '测出我的MBTI类型 →',
    disclaimer: '此说明仅供自我理解参考，请勿作为正式MBTI诊断或招聘、职业决策的决定性依据。',
    breadcrumbHome: '首页',
    breadcrumbMbti: 'MBTI',
  },
  fr: {
    cognitiveStackTitle: 'Pile de fonctions cognitives',
    worldviewTitle: 'Comment ce type voit le monde',
    strengthsTitle: 'Points forts',
    challengesTitle: 'Points de vigilance',
    growthTitle: 'Piste de développement',
    lifeTitle: 'Implications pour la vie et les relations',
    otherTypesTitle: 'Explorer les autres types',
    testCta: 'Découvrir mon type MBTI →',
    disclaimer: "Cette description est une référence pour la connaissance de soi. Ne l'utilisez pas comme un diagnostic MBTI formel ni comme base décisive pour le recrutement ou la carrière.",
    breadcrumbHome: 'Accueil',
    breadcrumbMbti: 'MBTI',
  },
  es: {
    cognitiveStackTitle: 'Pila de funciones cognitivas',
    worldviewTitle: 'Cómo ve el mundo este tipo',
    strengthsTitle: 'Fortalezas',
    challengesTitle: 'Puntos a cuidar',
    growthTitle: 'Camino de crecimiento',
    lifeTitle: 'Implicaciones para la vida y las relaciones',
    otherTypesTitle: 'Explorar otros tipos',
    testCta: 'Descubre mi tipo MBTI →',
    disclaimer: 'Esta descripción es una referencia para el autoconocimiento. No la uses como diagnóstico MBTI formal ni como base decisiva para contratación o carrera.',
    breadcrumbHome: 'Inicio',
    breadcrumbMbti: 'MBTI',
  },
};
const c = L[locale] ?? L.en;

const metaTitle: Record<Locale, string> = {
  ko: `${type} (${profile.ko}) 완전 해설 — 인지기능·강점·성장 방향`,
  en: `${type} (${profile.en}) Explained — Cognitive Functions, Strengths & Growth`,
  ja: `${type}（${profile.en}）完全解説 — 認知機能・強み・成長`,
  zh: `${type}（${profile.en}）完整解析 — 认知功能·优势·成长方向`,
  fr: `${type} (${profile.en}) expliqué — fonctions cognitives, forces et croissance`,
  es: `${type} (${profile.en}) explicado — funciones cognitivas, fortalezas y crecimiento`,
};
const metaDescription: Record<Locale, string> = {
  ko: `${type} 유형의 인지기능 스택(Dominant~Inferior), 강점과 주의할 점, 성장 방향을 정리했습니다.`,
  en: `A deep dive into the ${type} personality type: cognitive function stack, strengths, challenges, and growth path.`,
  ja: `${type}タイプの認知機能スタック、強み、注意点、成長の方向をまとめました。`,
  zh: `深入解析${type}人格类型：认知功能栈、优势、挑战与成长方向。`,
  fr: `Une analyse approfondie du type ${type} : pile de fonctions cognitives, forces, défis et croissance.`,
  es: `Un análisis profundo del tipo ${type}: pila de funciones cognitivas, fortalezas, desafíos y crecimiento.`,
};
// 2026-10-09: search snippets must preserve the same limits as the reviewed body.
const isfjTitle = {
  ko: 'ISFJ 해설 — 선호·유형 이론의 한계·자기점검',
  en: 'ISFJ Explained — Preferences, Theory Limits & Self-Reflection',
  ja: 'ISFJ解説 — 好み・タイプ理論の限界・自己理解',
  zh: 'ISFJ解析 — 偏好、类型理论的局限与自我观察',
  fr: 'ISFJ — préférences, limites de la théorie et réflexion personnelle',
  es: 'ISFJ — preferencias, límites de la teoría y reflexión personal',
};
const isfjDescription = {
  ko: 'ISFJ의 네 선호와 유형 역동 이론을 살펴봐요. 능력·궁합·진단과 구분하고, 경험을 돌아볼 질문과 공식 자료를 함께 확인해요.',
  en: 'Explore ISFJ preferences and type dynamics, distinct from ability, compatibility or diagnosis, with reflection questions and official sources.',
  ja: 'ISFJの好みとタイプ・ダイナミクスを、能力・相性・診断とは区別して紹介します。経験を振り返る質問と公式資料を確認できます。',
  zh: '了解ISFJ偏好与类型动力学，区分能力、配对预测和诊断，并结合经验回顾问题与官方资料。',
  fr: 'Explorez les préférences ISFJ et la dynamique des types, distinctes des aptitudes, de la compatibilité et du diagnostic, avec des questions et des sources officielles.',
  es: 'Explora las preferencias ISFJ y la dinámica de tipos, distintas de capacidad, compatibilidad o diagnóstico, con preguntas y fuentes oficiales.',
};
// 2026-10-09: reviewed ENFJ/ISFJ snippets and headings share the same non-predictive limits.
const hasReviewedReading = type === 'ISFJ' || type === 'ENFJ';
const m = hasReviewedReading
  ? { title: t(isfjTitle).replaceAll('ISFJ', type), description: t(isfjDescription).replaceAll('ISFJ', type) }
  : { title: metaTitle[locale] ?? metaTitle.en, description: metaDescription[locale] ?? metaDescription.en };

function localePath(path: string) {
  return withTrailingSlash(`/${locale}${path}`);
}

const cognitiveStack = stack.map((code, i) => ({
  role: ['dominant', 'auxiliary', 'tertiary', 'inferior'][i],
  code,
  name: t(COGNITIVE_FUNCTIONS[code].name),
  // 2026-10-09: use reviewed per-type explanations without changing unreviewed types.
  narrative: t(data.cognitiveReadings?.[code] ?? COGNITIVE_FUNCTIONS[code].narrative),
}));

// 2026-10-09: provider definitions and use limits are not independent validation.
const isfjEvidenceIntro: SixLangString = {
  ko: '아래는 선호 이론과 사용 범위를 설명하는 공식 자료예요. 독립적인 예측 타당도 검증은 아니에요.',
  en: 'These official materials explain preference theory and use limits, not independent predictive validation.',
  ja: '以下は選好の理論と使用範囲を説明する公式資料です。独立した予測妥当性の検証ではありません。',
  zh: '以下官方资料说明偏好理论与使用范围，不是独立的预测效度验证。',
  fr: 'Ces documents officiels expliquent la théorie des préférences et ses limites d’usage, sans validation prédictive indépendante.',
  es: 'Estos materiales oficiales explican la teoría de preferencias y sus límites de uso, no una validación predictiva independiente.',
};
const isfjSources = [
  { title: 'MBTI preferences', href: 'https://www.myersbriggs.org/my-mbti-personality-type/the-mbti-preferences/' },
  { title: 'Type dynamics', href: 'https://www.myersbriggs.org/unique-features-of-myers-briggs/type-dynamics-processes/' },
  { title: 'Personality type and careers', href: 'https://www.myersbriggs.org/type-in-my-life/personality-type-and-careers/' },
  { title: 'Personality type and relationships', href: 'https://www.myersbriggs.org/type-in-my-life/personality-type-and-relationships/' },
  { title: 'MBTI Facts', href: 'https://www.themyersbriggs.com/en-us/support/mbti-facts' },
];

const otherTypes = (Object.keys(MBTI_DEEP_DATA) as (keyof typeof MBTI_DEEP_DATA)[]).filter((x) => x !== type);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: m.title,
  description: m.description,
  inLanguage: locale,
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: c.breadcrumbHome, item: `https://oiyo.net/${locale}/` },
    { '@type': 'ListItem', position: 2, name: c.breadcrumbMbti, item: `https://oiyo.net${localePath('/mbti/test')}` },
    { '@type': 'ListItem', position: 3, name: type, item: `https://oiyo.net${localePath(`/mbti/${type.toLowerCase()}`)}` },
  ],
};
---

<Layout title={m.title} description={m.description} locale={locale} heading={`${profile.emoji} ${type} — ${typeName}`} intro={t(data.typeNarrative)}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <div class="mx-auto max-w-2xl px-4 py-10">

    <section class="mt-2">
      <h2 class="text-xl font-bold text-foreground">{c.worldviewTitle}</h2>
      <p class="mt-4 leading-8 text-green-800">{t(data.worldview)}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.cognitiveStackTitle}</h2>
      {hasReviewedReading && (
        <div class="mt-3 text-sm leading-6 text-muted-foreground">
          <p>{t(isfjEvidenceIntro)}</p>
          <ul class="mt-2 space-y-1">
            {isfjSources.map((source) => (
              <li><a class="underline" href={source.href}>{source.title}</a></li>
            ))}
            {type === 'ENFJ' && (
              <li><a class="underline" href="https://www.myersbriggs.org/using-type-as-a-professional/mbti-code-of-ethics/">{t({ ko: 'MBTI 윤리강령: 채용·능력 판단과 구분해요', en: 'MBTI ethics: not for hiring or ability judgments', ja: 'MBTI倫理綱領：採用・能力判断とは区別', zh: 'MBTI伦理：不用于招聘或能力判断', fr: 'Éthique MBTI : ni recrutement ni jugement des aptitudes', es: 'Ética MBTI: no para selección laboral ni juicios de capacidad' })}</a></li>
            )}
          </ul>
          {type === 'ENFJ' && (
            <p class="mt-2"><a class="underline" href={localePath('/mbti-enfj')}>{t({ ko: 'ENFJ 읽을거리: 사례와 연구의 한계', en: 'ENFJ reading: examples and research limits', ja: 'ENFJの読み物：事例と研究の限界', zh: 'ENFJ阅读：案例与研究局限', fr: 'Lecture ENFJ : exemples et limites des recherches', es: 'Lectura ENFJ: ejemplos y límites de la investigación' })}</a></p>
          )}
        </div>
      )}
      <div class="mt-4 grid gap-3">
        {cognitiveStack.map((f) => (
          <article class="rounded-xl border border-border bg-card p-4">
            <p class="text-[10px] font-bold uppercase tracking-widest text-green-600">{f.role}</p>
            <h3 class="mt-1 font-semibold text-foreground">{f.code} — {f.name}</h3>
            <p class="mt-2 text-sm leading-6 text-primary">{f.narrative}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-foreground">{type === 'ENFJ' ? t({ ko: '직접 시도할 행동', en: 'Actions to try', ja: '試してみる行動', zh: '可以尝试的行动', fr: 'Actions à essayer', es: 'Acciones que probar' }) : hasReviewedReading ? t({ ko: '선호를 확인할 질문', en: 'Questions to explore your preferences', ja: '好みを確かめる質問', zh: '了解偏好的问题', fr: 'Questions pour explorer vos préférences', es: 'Preguntas para explorar tus preferencias' }) : c.strengthsTitle}</h2>
      <ul class="mt-4 space-y-2">
        {data.strengths.map((s) => (
          <li class="flex gap-2 text-sm leading-6 text-green-800">
            <span class="text-green-500" aria-hidden="true">✓</span>
            <span>{t(s)}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.challengesTitle}</h2>
      <ul class="mt-4 space-y-2">
        {data.challenges.map((s) => (
          <li class="flex gap-2 text-sm leading-6 text-amber-800">
            <span class="text-amber-500" aria-hidden="true">•</span>
            <span>{t(s)}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.growthTitle}</h2>
      <p class="mt-4 leading-8 text-green-800">{t(data.growthPath)}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.lifeTitle}</h2>
      <p class="mt-4 leading-8 text-green-800">{t(data.lifeImplications)}</p>
    </section>

    {lifeKo && (
      <section class="mt-10">
        <h2 class="text-xl font-bold text-foreground">{hasReviewedReading ? '직무와 업무 조건 탐색' : '직업 적성'}</h2>
        <dl class="mt-4 grid gap-2 rounded-xl border border-border bg-green-50/60 p-4 text-sm">
          <div class="flex gap-2"><dt class="shrink-0 font-semibold text-green-900">{hasReviewedReading ? '탐색 예시' : '대표 직군'}</dt><dd class="text-green-800">{lifeKo.career.keywords}</dd></div>
          <div class="flex gap-2"><dt class="shrink-0 font-semibold text-green-900">{hasReviewedReading ? '확인할 업무 조건' : '살아나는 환경'}</dt><dd class="text-green-800">{lifeKo.career.thrives}</dd></div>
          <div class="flex gap-2"><dt class="shrink-0 font-semibold text-green-900">{hasReviewedReading ? '확인할 부담' : '시드는 환경'}</dt><dd class="text-green-800">{lifeKo.career.wilts}</dd></div>
        </dl>
        <h3 class="mt-6 font-semibold text-foreground">{hasReviewedReading ? '탐색할 직무 예시' : '강점이 살아나는 직군'}</h3>
        <ul class="mt-3 space-y-2">
          {lifeKo.career.roles.map((r) => (
            <li class="text-sm leading-6 text-green-800"><strong class="font-semibold text-foreground">{r.name}</strong> — {r.desc}</li>
          ))}
        </ul>
        <h3 class="mt-6 font-semibold text-foreground">{hasReviewedReading ? '경험으로 확인할 조건' : '피해야 할 환경'}</h3>
        {lifeKo.career.avoid.map((p) => <p class="mt-3 text-sm leading-7 text-green-800">{p}</p>)}
        <h3 class="mt-6 font-semibold text-foreground">커리어 성장 팁</h3>
        <p class="mt-3 text-sm leading-7 text-green-800">{lifeKo.career.growth}</p>
      </section>
    )}

    {lifeKo && (
      <section class="mt-10">
        <h2 class="text-xl font-bold text-foreground">관계와 연애</h2>
        <dl class="mt-4 grid gap-2 rounded-xl border border-border bg-green-50/60 p-4 text-sm">
          <div class="flex gap-2"><dt class="shrink-0 font-semibold text-green-900">{type === 'ENFJ' ? '편한 표현' : '사랑의 언어'}</dt><dd class="text-green-800">{lifeKo.relationship.loveLanguage}</dd></div>
          <div class="flex gap-2"><dt class="shrink-0 font-semibold text-green-900">{type === 'ENFJ' ? '원하는 관심과 시간' : '설레는 순간'}</dt><dd class="text-green-800">{lifeKo.relationship.spark}</dd></div>
          <div class="flex gap-2"><dt class="shrink-0 font-semibold text-green-900">{type === 'ENFJ' ? '연락·휴식·갈등 후 대화' : '식는 순간'}</dt><dd class="text-green-800">{lifeKo.relationship.cool}</dd></div>
        </dl>
        <h3 class="mt-6 font-semibold text-foreground">사랑할 때의 모습</h3>
        {lifeKo.relationship.loveStyle.map((p) => <p class="mt-3 text-sm leading-7 text-green-800">{p}</p>)}
        {lifeKo.relationship.matches.length > 0 && (
          <>
            <h3 class="mt-6 font-semibold text-foreground">편안하다고 자주 언급되는 유형</h3>
            <ul class="mt-3 space-y-2">
              {lifeKo.relationship.matches.map((r) => (
                <li class="text-sm leading-6 text-green-800"><strong class="font-semibold text-foreground">{r.name}</strong> — {r.desc}</li>
              ))}
            </ul>
          </>
        )}
        <p class="mt-3 text-xs leading-6 text-green-600">{type === 'ENFJ' ? '유형 조합만으로 관계의 성공을 예측할 수 없어요.' : '고정된 궁합표는 없습니다. 같은 유형끼리도 잘 맞을 수 있고, 목록에 없는 조합도 좋은 관계를 만듭니다.'}</p>
        <h3 class="mt-6 font-semibold text-foreground">부딪히기 쉬운 지점</h3>
        {lifeKo.relationship.friction.map((p) => <p class="mt-3 text-sm leading-7 text-green-800">{p}</p>)}
        <h3 class="mt-6 font-semibold text-foreground">관계를 오래 가게 하는 실천</h3>
        <ul class="mt-3 space-y-2">
          {lifeKo.relationship.tips.map((x) => (
            <li class="flex gap-2 text-sm leading-6 text-green-800"><span class="text-green-500" aria-hidden="true">·</span><span>{x}</span></li>
          ))}
        </ul>
      </section>
    )}

    {lifeKo && (
      <section class="mt-10">
        <h2 class="text-xl font-bold text-foreground">공부법</h2>
        <dl class="mt-4 grid gap-2 rounded-xl border border-border bg-green-50/60 p-4 text-sm">
          <div class="flex gap-2"><dt class="shrink-0 font-semibold text-green-900">{type === 'ENFJ' ? '시험해 볼 학습 방식' : '맞는 리듬'}</dt><dd class="text-green-800">{lifeKo.study.rhythm}</dd></div>
          <div class="flex gap-2"><dt class="shrink-0 font-semibold text-green-900">집중을 돕는 것</dt><dd class="text-green-800">{lifeKo.study.helps}</dd></div>
          <div class="flex gap-2"><dt class="shrink-0 font-semibold text-green-900">피해야 할 방식</dt><dd class="text-green-800">{lifeKo.study.avoid}</dd></div>
        </dl>
        {lifeKo.study.focus.map((p) => <p class="mt-3 text-sm leading-7 text-green-800">{p}</p>)}
        <h3 class="mt-6 font-semibold text-foreground">{type === 'ENFJ' ? '학습 탐색 예시' : '추천 학습 루틴'}</h3>
        <ol class="mt-3 space-y-2">
          {lifeKo.study.steps.map((x, i) => (
            <li class="flex gap-3 text-sm leading-6 text-green-800">
              <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary-strong text-[11px] font-bold text-white">{i + 1}</span>
              <span><strong class="font-semibold text-foreground">{x.name}</strong> — {x.desc}</span>
            </li>
          ))}
        </ol>
        <h3 class="mt-6 font-semibold text-foreground">피해야 할 학습 함정</h3>
        {lifeKo.study.traps.map((p) => <p class="mt-3 text-sm leading-7 text-green-800">{p}</p>)}
      </section>
    )}

    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>

    <div class="mt-8 text-center">
      <a
        href={localePath('/mbti/test')}
        class="inline-flex items-center gap-1 rounded-full bg-primary-strong px-6 py-3 text-sm font-bold text-white hover:bg-green-900"
      >
        {c.testCta}
      </a>
    </div>

    <section class="mt-10 border-t border-border pt-8">
      <h2 class="text-lg font-bold text-foreground">{c.otherTypesTitle}</h2>
      <div class="mt-4 grid grid-cols-4 gap-2">
        {otherTypes.map((ot) => (
          <a
            href={localePath(`/mbti/${ot.toLowerCase()}`)}
            class="rounded-lg border border-border bg-card px-2 py-2 text-center text-xs font-bold text-green-800 hover:border-green-300 hover:bg-surface-subtle"
          >
            {TYPE_PROFILES[ot as keyof typeof TYPE_PROFILES].emoji} {ot}
          </a>
        ))}
      </div>
    </section>

    <MentalBoost locale={locale} />
  </div>
</Layout>
