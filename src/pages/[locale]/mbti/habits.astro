    intro: 'Sport, lecture, rangement, planification et journal tiennent mieux quand la forme respecte vos préférences. Cette page relie chaque type MBTI à des habitudes, styles d’exercice et patterns qui peuvent fatiguer.',
    conceptTitle: 'Logique des recommandations',
    concepts: [
      { title: 'Direction d’énergie', body: 'Certains types tiennent seuls; d’autres ont besoin de personnes ou d’élan partagé.' },
      { title: 'Niveau de stimulation', body: 'Répétition stable pour certains, nouveauté et variation pour d’autres.' },
      { title: 'Type de récompense', body: 'Données, réussite, sens, plaisir ou lien motivent selon les profils.' },
    ],
    useTitle: 'Comment l’utiliser',
    useCases: [
      { title: 'Choisir un sport', body: 'Regardez les conditions: solo ou social, compétitif ou expérientiel, mesuré ou intuitif.' },
      { title: 'Ajuster une routine', body: 'Une habitude qui échoue souvent a peut-être besoin d’un meilleur design.' },
      { title: 'S’organiser à plusieurs', body: 'Comprendre les besoins de régularité rend les routines partagées plus simples.' },
    ],
    faqTitle: 'Questions fréquentes',
    faqs: [
      { question: 'Les recommandations MBTI sont-elles fixes ?', answer: 'Non. Ce sont des pistes lifestyle basées sur des préférences. Testez petit.' },
      { question: 'Et si je n’aime pas la suggestion ?', answer: 'La suggestion est un point de départ. Choisissez surtout une action que vous voulez répéter.' },
      { question: 'Le sport doit-il suivre le MBTI ?', answer: 'Non. Mais un environnement et une récompense adaptés facilitent le retour.' },
    ],
    readingTitle: 'Lire plus',
    reading: [
      { href: 'https://oiyo.net/fr/habit-builder/30-days', label: 'Défi 30 jours', desc: 'Transformer une habitude en petite expérience.' },
      { href: 'https://oiyo.net/fr/routine/builder', label: 'Créer une routine', desc: 'Placer l’habitude dans un rythme réaliste.' },
      { href: 'https://wiki.oiyo.net/ko/meaning-of-mbti/', label: 'Concept MBTI', desc: 'Revoir les quatre paires de préférences.' },
    ],
    disclaimer: 'Ces suggestions MBTI sont des pistes légères de réflexion lifestyle.',
  },
  es: {
    introTitle: 'Los hábitos por MBTI muestran distintas formas de ser constante',
    intro: 'Ejercicio, lectura, orden, planificación y journaling se sostienen mejor cuando la forma encaja con tus preferencias. Esta página conecta cada tipo MBTI con hábitos, estilos de ejercicio y patrones que pueden agotar.',
    conceptTitle: 'Cómo se enmarcan las recomendaciones',
    concepts: [
      { title: 'Dirección de energía', body: 'Algunos tipos sostienen hábitos a solas; otros necesitan personas o impulso compartido.' },
      { title: 'Nivel de estímulo', body: 'Algunas personas prefieren repetición estable; otras necesitan variedad y novedad.' },
      { title: 'Tipo de recompensa', body: 'Datos, logro, sentido, diversión o conexión motivan de formas distintas.' },
    ],
    useTitle: 'Cómo usar la guía',
    useCases: [
      { title: 'Elegir ejercicio', body: 'Mira condiciones: solo o social, competitivo o experiencial, medido o intuitivo.' },
      { title: 'Ajustar rutinas', body: 'Un hábito que falla seguido quizá necesita rediseño, no más presión.' },
      { title: 'Planear con otros', body: 'Entender necesidades de constancia ayuda en rutinas compartidas.' },
    ],
    faqTitle: 'Preguntas frecuentes',
    faqs: [
      { question: '¿Las recomendaciones MBTI son fijas?', answer: 'No. Son pistas lifestyle basadas en preferencias. Pruébalas en pequeño.' },
      { question: '¿Y si no me gusta la sugerencia?', answer: 'Es un punto de partida. Importa más elegir algo que realmente quieras repetir.' },
      { question: '¿El ejercicio debe seguir el MBTI?', answer: 'No. Pero un entorno y una recompensa adecuados facilitan empezar y volver.' },
    ],
    readingTitle: 'Leer más',
    reading: [
      { href: 'https://oiyo.net/es/habit-builder/30-days', label: 'Desafío 30 días', desc: 'Convierte un hábito recomendado en experimento.' },
      { href: 'https://oiyo.net/es/routine/builder', label: 'Construir rutina', desc: 'Pon el hábito dentro de un ritmo realista.' },
      { href: 'https://wiki.oiyo.net/ko/meaning-of-mbti/', label: 'Concepto MBTI', desc: 'Revisa los cuatro pares de preferencias.' },
    ],
    disclaimer: 'Estas sugerencias MBTI son pistas ligeras de auto-reflexión lifestyle.',
  },
};

const c = content[locale] ?? content.en;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Layout title={meta.title} description={meta.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="mx-auto max-w-3xl px-4 py-10">
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-black text-slate-900">
        {txt({ ko: 'MBTI별 추천 습관·운동', en: 'MBTI Habits & Exercise Guide', ja: 'MBTIタイプ別習慣·運動', zh: 'MBTI推荐习惯和运动', fr: 'Habitudes & Exercices par MBTI', es: 'Hábitos y Ejercicio por MBTI' })}
      </h1>
      <p class="mt-2 text-slate-500 max-w-xl mx-auto">
        {txt({ ko: '성격 유형에 맞는 습관과 운동을 선택하면 의지력 없이도 꾸준히 이어집니다.', en: 'Choosing habits and exercises that match your personality type means you can stay consistent without relying on willpower.', ja: '性格タイプに合った習慣と運動を選ぶと、意志力なしでも継続できます。', zh: '选择符合性格类型的习惯和运动，不需要意志力也能持之以恒。', fr: 'Choisir des habitudes et exercices adaptés à votre type permet la régularité sans volonté forcée.', es: 'Elegir hábitos y ejercicios que coincidan con tu tipo de personalidad permite la consistencia sin depender de la fuerza de voluntad.' })}
      </p>
    </div>

    <div class="space-y-4">
      {TYPES.map(({ type, color, habits, exercise, avoid }) => (
        <div class={`rounded-2xl border-2 p-5 ${color}`}>
          <div class="flex items-center gap-3 mb-4">
            <span class="rounded-xl bg-white/70 px-4 py-1 font-mono text-xl font-black text-slate-800">{type}</span>
          </div>
          <div class="grid gap-3 sm:grid-cols-3">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">✦ {labelHabits}</p>
              <p class="text-sm leading-relaxed text-slate-800">{habits[locale] ?? habits.en}</p>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">◉ {labelExercise}</p>
              <p class="text-sm leading-relaxed text-slate-800">{exercise[locale] ?? exercise.en}</p>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">✕ {labelAvoid}</p>
              <p class="text-sm leading-relaxed text-slate-500 italic">{avoid[locale] ?? avoid.en}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a href={localePath(locale, '/mbti/test')} class="inline-flex items-center gap-2 rounded-xl border-2 border-green-700 bg-green-700 px-6 py-3 font-bold text-white transition hover:bg-green-800">
        {txt({ ko: '내 MBTI 테스트하기', en: 'Take the MBTI Test', ja: 'MBTIテストを受ける', zh: '做MBTI测试', fr: 'Passer le test MBTI', es: 'Hacer el test MBTI' })} →
      </a>
    </div>
    <RelatedTools locale={locale} tools={['mbti', 'big5', 'enneagram', 'attachment']} current="mbti-habits" />

    <section class="mt-8 border-t border-green-100 pt-8">
      <h2 class="text-2xl font-bold text-slate-950">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.conceptTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.concepts.map((item) => (
          <article class="rounded-xl border border-green-100 bg-white p-4">
            <h3 class="font-semibold text-slate-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.useTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.useCases.map((item) => (
          <article class="rounded-xl bg-green-50 p-4">
            <h3 class="font-semibold text-slate-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-green-100 rounded-xl border border-green-100 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-950">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.readingTitle}</h2>
      <div class="mt-4 grid gap-3 md:grid-cols-3">
        {c.reading.map((item) => (
          <a class="rounded-xl border border-green-100 bg-white p-4 transition-colors hover:border-green-300 hover:bg-green-50" href={item.href} rel="noopener noreferrer" target="_blank">
            <span class="font-semibold text-slate-950">{item.label}</span>
            <span class="mt-2 block text-sm leading-6 text-slate-700">{item.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">
      {c.disclaimer}
    </p>
      <MentalBoost locale={locale} />
  </div>
</Layout>
