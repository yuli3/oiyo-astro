---
import Layout from '../../../layouts/Layout.astro';
import MentalBoost from '../../../components/shared/MentalBoost.astro';
import RelatedTools from '../../../components/shared/RelatedTools.astro';
import { LOCALES, localePath } from '../../../i18n';
import type { Locale } from '../../../i18n';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
type L = Locale;
const txt = (map: Record<L, string>) => map[locale] ?? map.en;

const meta = {
  title: txt({ ko: 'MBTI별 추천 습관·운동 — 나에게 맞는 루틴 찾기', en: 'MBTI Habits & Exercise — Build Routines That Fit Your Type', ja: 'MBTIタイプ別おすすめ習慣·運動', zh: 'MBTI推荐习惯和运动', fr: 'Habitudes & Exercices MBTI', es: 'Hábitos y Ejercicios MBTI' }),
  description: txt({ ko: 'MBTI 유형별로 지속하기 쉬운 습관과 맞는 운동 스타일을 추천합니다. 억지로 만들지 않아도 자연스럽게 이어지는 루틴을 찾아보세요.', en: 'Discover habits and exercise styles that align with your MBTI type — routines you can actually maintain naturally.', ja: 'MBTIタイプ別に続けやすい習慣と合った運動スタイルをご紹介。自然に続けられるルーティンを見つけましょう。', zh: '根据MBTI类型推荐容易坚持的习惯和适合的运动风格。', fr: 'Découvrez les habitudes et les styles d\'exercice qui s\'alignent avec votre type MBTI.', es: 'Descubre hábitos y estilos de ejercicio que se alinean con tu tipo MBTI.' }),
};

interface HabitEntry {
  type: string;
  color: string;
  habits: Record<L, string>;
  exercise: Record<L, string>;
  avoid: Record<L, string>;
}

const TYPES: HabitEntry[] = [
  { type: 'INTJ', color: 'border-green-300 bg-green-50',
    habits: { ko: '매일 밤 다음 날 계획 15분, 주간 리뷰·OKR 점검, 독서 30분(비소설)', en: '15 min nightly planning, weekly OKR review, 30 min non-fiction reading', ja: '毎晩15分翌日計画、週次レビュー、30分読書（ノンフィクション）', zh: '每晚15分钟计划明天，每周OKR回顾，30分钟非虚构阅读', fr: '15 min de planification nocturne, révision OKR hebdomadaire, 30 min de lecture non-fiction', es: '15 min de planificación nocturna, revisión semanal OKR, 30 min de lectura no ficción' },
    exercise: { ko: '솔로 운동 선호: 웨이트 트레이닝, 수영, 사이클링. 목표 기반으로 데이터 추적하면 동기 유지 쉬움', en: 'Prefers solo training: weight lifting, swimming, cycling. Goal-based data tracking sustains motivation', ja: 'ソロトレーニング好み：ウェイトリフティング、水泳、サイクリング。目標ベースのデータ追跡で動機維持', zh: '偏爱独自训练：力量训练、游泳、骑行。基于目标的数据追踪维持动力', fr: 'Préfère l\'entraînement solo: musculation, natation, cyclisme. Le suivi des données maintient la motivation', es: 'Prefiere entrenar solo: levantamiento de pesas, natación, ciclismo. El seguimiento de datos mantiene la motivación' },
    avoid: { ko: '즉흥적인 그룹 활동, 사교 목적의 운동', en: 'Spontaneous group activities, exercise for purely social reasons', ja: '即興のグループ活動、社交目的の運動', zh: '即兴团体活动，纯社交目的的运动', fr: 'Activités de groupe spontanées, exercice à des fins purement sociales', es: 'Actividades grupales espontáneas, ejercicio por razones puramente sociales' } },
  { type: 'INTP', color: 'border-sky-300 bg-sky-50',
    habits: { ko: '아이디어 노트 항상 옆에 두기, 포모도로 타이머(25분 집중), 퍼즐·문제 하나 매일 풀기', en: 'Always keep an idea notebook nearby, Pomodoro timer (25 min focus), solve one puzzle/problem daily', ja: 'アイデアノートを常に傍に、ポモドーロタイマー（25分集中）、毎日パズルや問題を一つ解く', zh: '随时携带想法笔记本，番茄工作法（25分钟专注），每天解决一个谜题/问题', fr: 'Garder un carnet d\'idées à portée, minuterie Pomodoro (25 min de concentration), résoudre un puzzle quotidien', es: 'Siempre tener un cuaderno de ideas cerca, temporizador Pomodoro (25 min de enfoque), resolver un acertijo diariamente' },
    exercise: { ko: '체스 같은 두뇌 쓰는 운동, 하이킹(생각하며 걷기), 탁구, 프리스비. 규칙적 스케줄보다 흥미 기반으로', en: 'Mind-engaging exercise: hiking (thinking walks), table tennis, frisbee. Interest-based rather than rigid schedules', ja: '脳を使う運動：ハイキング（考えながら歩く）、卓球、フリスビー。興味ベースで', zh: '需要思考的运动：徒步（边走边思考）、乒乓球、飞盘。基于兴趣而非固定时间表', fr: 'Exercices engageants mentalement : randonnée, tennis de table, frisbee. Basé sur l\'intérêt plutôt que les horaires', es: 'Ejercicio que involucra la mente: senderismo, tenis de mesa, frisbee. Basado en interés más que en horarios fijos' },
    avoid: { ko: '고정된 반복 루틴, 팀 스포츠(특히 경쟁 강조)', en: 'Fixed repetitive routines, team sports with heavy competition emphasis', ja: '固定した反復ルーティン、チームスポーツ（特に競争重視）', zh: '固定重复的套路，竞争性强的团队运动', fr: 'Routines répétitives fixes, sports d\'équipe avec forte emphase sur la compétition', es: 'Rutinas repetitivas fijas, deportes de equipo con fuerte énfasis en la competición' } },
  { type: 'ENTJ', color: 'border-red-300 bg-red-50',
    habits: { ko: '아침 루틴 엄수(기상·운동·계획), 분기 목표 설정, 멘토링 세션 주 1회', en: 'Strict morning routine (wake/exercise/plan), quarterly goal setting, weekly mentoring session', ja: '朝ルーティン厳守（起床·運動·計画）、四半期目標設定、週1メンタリングセッション', zh: '严格晨间例程（起床·运动·计划），季度目标设定，每周辅导课程', fr: 'Routine matinale stricte (lever/exercice/planification), objectifs trimestriels, session de mentorat hebdomadaire', es: 'Rutina matutina estricta (despertar/ejercicio/planificación), establecimiento de metas trimestrales, sesión de mentoría semanal' },
    exercise: { ko: '경쟁·기록 도전이 있는 운동: 마라톤, 트라이애슬론, CrossFit, 격투기 도장. 진도 측정이 핵심', en: 'Competition and record-breaking: marathon, triathlon, CrossFit, martial arts dojo. Measuring progress is key', ja: '競争·記録挑戦がある運動：マラソン、トライアスロン、CrossFit、武道道場。進捗測定が核心', zh: '有竞争和记录挑战的运动：马拉松、铁人三项、CrossFit、武道道场。测量进度是关键', fr: 'Sports avec compétition et défis : marathon, triathlon, CrossFit, arts martiaux. Mesurer les progrès est clé', es: 'Deportes con competición y desafíos de récords: maratón, triatlón, CrossFit, artes marciales. Medir el progreso es clave' },
    avoid: { ko: '목표 없는 운동, 너무 느린 페이스', en: 'Exercise without goals, overly slow-paced activities', ja: '目標のない運動、ペースが遅すぎる活動', zh: '没有目标的运动，节奏过慢的活动', fr: 'Exercice sans objectifs, activités à rythme trop lent', es: 'Ejercicio sin metas, actividades a un ritmo demasiado lento' } },
  { type: 'ENTP', color: 'border-orange-300 bg-orange-50',
    habits: { ko: '새 아이디어 매일 3가지 적기, 다양한 분야 팟캐스트 청취, 월 1회 새 시도(음식·장소·기술)', en: 'Write 3 new ideas daily, listen to cross-domain podcasts, try something new monthly (food/place/skill)', ja: '毎日3つの新アイデアを書く、異分野ポッドキャスト聴取、月1回新しいことを試す', zh: '每天记录3个新想法，收听跨领域播客，每月尝试新事物（食物/地点/技能）', fr: 'Écrire 3 nouvelles idées quotidiennement, podcasts interdisciplinaires, essayer quelque chose de nouveau mensuellement', es: 'Escribir 3 nuevas ideas diariamente, podcasts de diferentes campos, probar algo nuevo mensualmente' },
    exercise: { ko: '다양성 있는 운동: 클라이밍, 파쿠르, 줄넘기, 서핑 체험. 같은 것 반복 싫어하므로 종목 자주 바꾸기', en: 'Varied exercise: climbing, parkour, jump rope, surf lessons. Change activities frequently to avoid boredom', ja: '多様な運動：クライミング、パルクール、縄跳び、サーフィン体験。同じことの繰り返しが嫌なので種目をよく変える', zh: '多样化运动：攀岩、跑酷、跳绳、冲浪体验。频繁更换项目避免无聊', fr: 'Exercices variés : escalade, parkour, saut à la corde, leçons de surf. Changer souvent d\'activités', es: 'Ejercicio variado: escalada, parkour, salto a la cuerda, clases de surf. Cambiar actividades frecuentemente' },
    avoid: { ko: '같은 루틴의 반복, 의무감으로만 하는 운동', en: 'Repeating the same routine, exercising only out of obligation', ja: '同じルーティンの繰り返し、義務感だけでする運動', zh: '重复相同的套路，只出于义务感运动', fr: 'Répéter la même routine, faire de l\'exercice uniquement par obligation', es: 'Repetir la misma rutina, hacer ejercicio sólo por obligación' } },
  { type: 'INFJ', color: 'border-green-300 bg-green-50',
    habits: { ko: '아침 명상 10분, 저널링(감사 3가지+오늘 의도), 디지털 디톡스 저녁 시간', en: '10 min morning meditation, journaling (3 gratitudes + daily intention), digital detox evenings', ja: '朝10分瞑想、ジャーナリング（感謝3つ+今日の意図）、夜のデジタルデトックス', zh: '早上10分钟冥想，日记（3个感恩+今日意图），晚上数字排毒', fr: '10 min de méditation matinale, journalisation (3 gratitudes + intention du jour), soirées de détox numérique', es: '10 min de meditación matutina, journaling (3 gratitudes + intención diaria), desintoxicación digital nocturna' },
    exercise: { ko: '요가, 태극권, 필라테스, 자연 속 걷기. 혼자 또는 소수 파트너와. 마음-몸 연결을 느끼는 운동', en: 'Yoga, tai chi, pilates, nature walks. Alone or with a small partner. Mind-body connection activities', ja: 'ヨガ、太極拳、ピラティス、自然の中を歩く。一人か少数パートナーと。心身のつながりを感じる運動', zh: '瑜伽、太极拳、普拉提、自然漫步。独自或与少数伙伴。感受身心连接的运动', fr: 'Yoga, tai-chi, pilates, marche en nature. Seul ou avec un petit partenaire. Activités reliant corps et esprit', es: 'Yoga, tai chi, pilates, caminatas en la naturaleza. Solo o con una pequeña pareja. Actividades de conexión mente-cuerpo' },
    avoid: { ko: '시끄러운 헬스장, 대규모 단체 운동, 경쟁 강조', en: 'Noisy gyms, large group exercise classes, competition-heavy environments', ja: 'うるさいジム、大規模グループ運動、競争強調', zh: '嘈杂的健身房，大型团体运动课，强调竞争', fr: 'Salles de sport bruyantes, cours d\'exercice en grands groupes, environnements compétitifs', es: 'Gimnasios ruidosos, clases de ejercicio en grupos grandes, entornos competitivos' } },
  { type: 'INFP', color: 'border-pink-300 bg-pink-50',
    habits: { ko: '창작 노트 매일 열기(그림·시·낙서), 의미 있는 목표 1개씩 주간 점검, 자기 연민 일기', en: 'Open a creative journal daily (drawing/poetry/doodles), weekly check-in on one meaningful goal, self-compassion diary', ja: '毎日クリエイティブノートを開く（絵·詩·落書き）、週次で意味ある目標1つを確認、自己慈悲日記', zh: '每天打开创作笔记本（画画/诗歌/涂鸦），每周检查一个有意义的目标，自我慈悲日记', fr: 'Ouvrir un journal créatif quotidiennement, vérification hebdomadaire d\'un objectif significatif, journal d\'auto-compassion', es: 'Abrir un diario creativo diariamente, revisión semanal de un objetivo significativo, diario de autocompasión' },
    exercise: { ko: '의미 있는 스토리가 있는 운동: 댄스(이야기 담긴), 자연 하이킹, 리듬체조. 기록보다 경험 중심', en: 'Exercise with meaningful story: expressive dance, nature hiking, rhythmic gymnastics. Experience over records', ja: '意味のあるストーリーがある運動：表現ダンス、自然ハイキング、新体操。記録より経験重視', zh: '有意义故事的运动：表达性舞蹈、自然徒步、艺术体操。以体验为中心而非记录', fr: 'Exercice avec un récit significatif : danse expressive, randonnée en nature, gym rythmique. L\'expérience prime sur les records', es: 'Ejercicio con historia significativa: danza expresiva, senderismo en la naturaleza, gimnasia rítmica. Experiencia sobre records' },
    avoid: { ko: '성과 비교, 리더보드, 경쟁적 팀 환경', en: 'Performance comparisons, leaderboards, competitive team environments', ja: 'パフォーマンス比較、リーダーボード、競争的なチーム環境', zh: '成绩比较，排行榜，竞争性团队环境', fr: 'Comparaisons de performances, classements, environnements d\'équipe compétitifs', es: 'Comparaciones de rendimiento, tablas de clasificación, entornos de equipo competitivos' } },
  { type: 'ENFJ', color: 'border-green-300 bg-green-50',
    habits: { ko: '주 1회 의미 있는 1:1 대화 시간, 주간 감사 편지(문자라도), 커뮤니티 기여 활동', en: 'Weekly meaningful 1:1 conversation, weekly gratitude letter (even a text), community contribution activity', ja: '週1回の意味ある1:1会話、週次感謝の手紙（テキストでも）、コミュニティ貢献活動', zh: '每周有意义的一对一对话，每周感恩信（短信也行），社区贡献活动', fr: 'Conversation 1:1 significative hebdomadaire, lettre de gratitude hebdomadaire, activité de contribution communautaire', es: 'Conversación 1:1 significativa semanal, carta de gratitud semanal (incluso un mensaje), actividad de contribución comunitaria' },
    exercise: { ko: '팀·커뮤니티 운동 선호: 그룹 피트니스 클래스, 러닝 크루, 팀 스포츠. 함께하는 것 자체가 동기', en: 'Prefers team/community exercise: group fitness classes, running crews, team sports. The togetherness itself is motivating', ja: 'チーム·コミュニティ運動好み：グループフィットネスクラス、ランニングクルー、チームスポーツ。一緒にすること自体が動機', zh: '偏爱团队/社区运动：团体健身课、跑步团、团队运动。一起运动本身就是动力', fr: 'Préfère l\'exercice en équipe/communauté : cours de fitness en groupe, équipes de course, sports d\'équipe', es: 'Prefiere ejercicio en equipo/comunidad: clases de fitness grupales, grupos de running, deportes de equipo' },
    avoid: { ko: '혼자 하는 반복적 운동, 동료 없이 장기 지속하기 어려움', en: 'Repetitive solo training — hard to sustain long-term without companions', ja: '一人でする反復的な運動、仲間なしで長期継続が難しい', zh: '单独重复性训练，没有伙伴难以长期坚持', fr: 'Entraînement solo répétitif — difficile à maintenir à long terme sans compagnons', es: 'Entrenamiento repetitivo en solitario — difícil de mantener a largo plazo sin compañeros' } },
  { type: 'ENFP', color: 'border-yellow-300 bg-yellow-50',
    habits: { ko: '아침 의도 설정(한 단어), 감동 받은 것 사진으로 기록, 주 2회 새 경험 의도적으로 만들기', en: 'Morning intention setting (one word), photo-record things that move you, intentionally create 2 new experiences/week', ja: '朝の意図設定（一言）、感動したことを写真で記録、週2回新しい経験を意図的に作る', zh: '早晨设定意图（一个词），用照片记录感动的事物，每周有意识地创造2次新体验', fr: 'Définir une intention matinale (un mot), photographier ce qui vous touche, créer intentionnellement 2 nouvelles expériences/semaine', es: 'Establecer intención matutina (una palabra), fotografiar lo que te conmueve, crear intencionalmente 2 nuevas experiencias/semana' },
    exercise: { ko: '재미가 첫 번째: 줌바, 실내 암벽, 서핑, 댄스 배틀. 친구와 함께 → 훨씬 지속률 높음', en: 'Fun first: Zumba, indoor climbing, surfing, dance battles. With friends → much higher consistency', ja: '楽しさが第一：ズンバ、室内クライミング、サーフィン、ダンスバトル。友達と一緒→継続率がはるかに高い', zh: '乐趣第一：尊巴舞、室内攀岩、冲浪、舞蹈对决。与朋友一起→坚持率更高', fr: 'Le plaisir avant tout : Zumba, escalade intérieure, surf, battle de danse. Avec des amis → taux de régularité bien plus élevé', es: 'La diversión primero: Zumba, escalada interior, surf, batallas de baile. Con amigos → mucho mayor consistencia' },
    avoid: { ko: '혼자 하는 반복적인 운동, 너무 엄격한 일정', en: 'Repetitive solo workouts, overly rigid schedules', ja: '一人でする反復的な運動、厳しすぎるスケジュール', zh: '单独重复性锻炼，过于严格的时间表', fr: 'Entraînements solo répétitifs, horaires trop rigides', es: 'Entrenamientos repetitivos en solitario, horarios demasiado rígidos' } },
  { type: 'ISTJ', color: 'border-slate-300 bg-slate-50',
    habits: { ko: '매일 같은 시간 기상, 체크리스트 완수 후 하루 마감, 주간 재고 점검(집·재정·건강)', en: 'Wake at the same time daily, close the day by completing a checklist, weekly review (home/finances/health)', ja: '毎日同じ時間に起床、チェックリストを完了してから1日を締める、週次棚卸し（家·財政·健康）', zh: '每天同一时间起床，完成清单后结束一天，每周盘点（家庭/财务/健康）', fr: 'Se lever à la même heure quotidiennement, terminer la journée en complétant une liste, révision hebdomadaire', es: 'Despertar a la misma hora diariamente, terminar el día completando una lista, revisión semanal (hogar/finanzas/salud)' },
