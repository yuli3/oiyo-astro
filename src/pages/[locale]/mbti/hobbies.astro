      { href: 'https://wiki.oiyo.net/ko/meaning-of-mbti/', label: 'Concepto MBTI', desc: 'Revisa las cuatro preferencias.' },
    ],
    disclaimer: 'Estas sugerencias de pasatiempos MBTI son pistas lúdicas de auto-reflexión.',
  },
};

const c = content[locale] ?? content.en;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Layout title={meta.title} description={meta.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="mx-auto max-w-3xl px-4 py-10">
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-black text-slate-900">{heading}</h1>
      <p class="mt-2 text-slate-500">{subheading}</p>
      <a
        href={localePath(locale, '/mbti/test')}
        class="mt-4 inline-flex items-center gap-2 rounded-full border-2 border-green-700 bg-primary px-5 py-2 text-sm font-bold text-primary-foreground transition hover:bg-green-800"
      >
        {labelTest} →
      </a>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      {TYPES.map(({ type, color, hobbies, why }) => (
        <div class={`rounded-2xl border-2 p-5 ${color}`}>
          <div class="mb-3 flex items-center gap-2">
            <span class="rounded-lg bg-white/70 px-3 py-1 font-mono text-lg font-black text-slate-800">{type}</span>
          </div>
          <p class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-1">{labelHobbies}</p>
          <p class="text-sm leading-relaxed text-slate-800 mb-3">{hobbies}</p>
          <p class="text-xs text-slate-500 italic border-t border-slate-200 pt-2">{why[locale] ?? why.en}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 rounded-2xl border-2 border-green-200 bg-surface-subtle p-6 text-center">
      <p class="text-sm text-slate-600 mb-3">
        {txt({ ko: '내 MBTI 유형이 아직 확실하지 않다면?', en: 'Not sure of your MBTI type yet?', ja: 'MBTIタイプがまだ分からない？', zh: '还不确定你的MBTI类型？', fr: 'Pas encore sûr de votre type MBTI ?', es: '¿Aún no estás seguro de tu tipo MBTI?' })}
      </p>
      <a
        href={localePath(locale, '/mbti/test')}
        class="inline-flex items-center gap-2 rounded-xl border-2 border-green-700 bg-card px-6 py-3 font-bold text-green-700 transition hover:bg-primary hover:text-primary-foreground"
      >
        {txt({ ko: '무료 MBTI 테스트 하기', en: 'Take the Free MBTI Test', ja: '無料MBTIテストを受ける', zh: '参加免费MBTI测试', fr: 'Passer le test MBTI gratuit', es: 'Hacer el test MBTI gratis' })} →
      </a>
    </div>
    <RelatedTools locale={locale} tools={['mbti', 'big5', 'enneagram', 'attachment']} current="mbti-hobbies" />

    <section class="mt-8 border-t border-green-100 pt-8">
      <h2 class="text-2xl font-bold text-slate-950">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.conceptTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.concepts.map((item) => (
          <article class="rounded-xl border border-green-100 bg-card p-4">
            <h3 class="font-semibold text-slate-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.useTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.useCases.map((item) => (
          <article class="rounded-xl bg-surface-subtle p-4">
            <h3 class="font-semibold text-slate-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-green-100 rounded-xl border border-green-100 bg-card">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-950">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.readingTitle}</h2>
      <div class="mt-4 grid gap-3 md:grid-cols-3">
        {c.reading.map((item) => (
          <a class="rounded-xl border border-green-100 bg-card p-4 transition-colors hover:border-green-300 hover:bg-surface-subtle" href={item.href} rel="noopener noreferrer" target="_blank">
            <span class="font-semibold text-slate-950">{item.label}</span>
            <span class="mt-2 block text-sm leading-6 text-slate-700">{item.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">
      {c.disclaimer}
    </p>
      <MentalBoost locale={locale} />
  </div>
</Layout>
