  { type: 'ISTP', color: 'bg-zinc-100 border-zinc-300',
    hobbies: txt({ ko: '오토바이·자동차 정비, 클라이밍·서핑, 목공·금속공예, 사진 촬영(다큐멘터리), 3D 프린팅', en: 'Motorcycle/car mechanics, rock climbing/surfing, woodworking/metalworking, documentary photography, 3D printing', ja: 'バイク·自動車整備、ロッククライミング·サーフィン、木工·金属加工、写真撮影(ドキュメンタリー)、3Dプリント', zh: '摩托车汽车维修、攀岩冲浪、木工金属工艺、纪录片摄影、3D打印', fr: 'Mécanique moto/auto, escalade/surf, menuiserie/métallurgie, photographie documentaire, impression 3D', es: 'Mecánica de motos/coches, escalada/surf, carpintería/metalurgia, fotografía documental, impresión 3D' }),
    why: { ko: '손으로 만지고 분해하고 해결하는 과정에서 몰입하는 ISTP에게 최적', en: 'Optimal for ISTPs who find flow in hands-on work, disassembling, and solving problems', ja: '手で触れ、分解し、解決するプロセスに没頭するISTPに最適', zh: '对于在动手、拆解和解决问题过程中进入心流状态的ISTP来说是最佳选择', fr: 'Optimal pour les ISTP qui trouvent le flow dans le travail manuel, le démontage et la résolution de problèmes', es: 'Óptimo para ISTPs que encuentran el flow en el trabajo manual, el desmontaje y la resolución de problemas' } },
  { type: 'ISFP', color: 'bg-lime-100 border-lime-300',
    hobbies: txt({ ko: '수채화·아크릴화, 도예, 자연 사진, 요가·필라테스, 향수·캔들 만들기, 반려동물 돌봄', en: 'Watercolor/acrylic painting, ceramics/pottery, nature photography, yoga/pilates, perfume/candle making, pet care', ja: '水彩画·アクリル画、陶芸、自然写真、ヨガ·ピラティス、香水·キャンドル作り', zh: '水彩画丙烯画、陶艺、自然摄影、瑜伽普拉提、香水蜡烛制作、宠物照料', fr: 'Aquarelle/peinture acrylique, céramique/poterie, photographie nature, yoga/pilates, fabrication de parfum/bougies', es: 'Acuarela/pintura acrílica, cerámica/alfarería, fotografía de naturaleza, yoga/pilates, fabricación de perfumes/velas' }),
    why: { ko: '감각적 아름다움과 현재 순간의 경험을 중시하는 ISFP에게 자연스러운 취미', en: 'Natural hobbies for ISFPs who value sensory beauty and present-moment experiences', ja: '感覚的な美しさと現在の瞬間の経験を大切にするISFPにとって自然な趣味', zh: '对于重视感官美和当下体验的ISFP来说自然而然的爱好', fr: 'Loisirs naturels pour les ISFP qui valorisent la beauté sensorielle et les expériences du moment présent', es: 'Pasatiempos naturales para ISFPs que valoran la belleza sensorial y las experiencias del momento presente' } },
  { type: 'ESTP', color: 'bg-red-100 border-orange-300',
    hobbies: txt({ ko: '격투기·스파링, 스케이트보드, 포커·도박 전략, 부동산·플리핑, 이벤트 MC, 자동차 레이싱', en: 'Martial arts/sparring, skateboarding, poker/strategy gambling, real estate flipping, event MCing, car racing', ja: '格闘技·スパーリング、スケートボード、ポーカー、不動産フリッピング、イベントMC', zh: '格斗武术、滑板、扑克策略、房产翻修、活动主持、赛车', fr: 'Arts martiaux/combat, skateboard, poker/jeux de stratégie, retournement immobilier, animation d\'événements', es: 'Artes marciales/sparring, skateboarding, póker/juegos de estrategia, flipping inmobiliario, animación de eventos' }),
    why: { ko: '스릴과 즉각적인 행동, 현실적 결과에서 에너지를 얻는 ESTP에게 최적', en: 'Optimal for ESTPs who gain energy from thrill, immediate action, and tangible results', ja: 'スリルと即座の行動、現実的な結果からエネルギーを得るESTPに最適', zh: '对于从刺激、即时行动和实际结果中获得能量的ESTP来说是最佳选择', fr: 'Optimal pour les ESTP qui gagnent de l\'énergie du frisson, de l\'action immédiate et des résultats tangibles', es: 'Óptimo para ESTPs que ganan energía del emoción, la acción inmediata y los resultados tangibles' } },
  { type: 'ESFP', color: 'bg-fuchsia-100 border-fuchsia-300',
    hobbies: txt({ ko: '댄스·케이팝, 유튜브·틱톡 창작, 파티·이벤트 기획, 패션·스타일링, 노래(보컬 레슨)', en: 'Dance/K-pop, YouTube/TikTok creation, party/event organizing, fashion/styling, singing (vocal lessons)', ja: 'ダンス·K-POP、YouTube·TikTok創作、パーティー·イベント企画、ファッション·スタイリング', zh: '舞蹈K-pop、YouTube/TikTok创作、派对活动组织、时尚造型、唱歌声乐课', fr: 'Danse/K-pop, création YouTube/TikTok, organisation de fêtes/événements, mode/stylisme, chant', es: 'Baile/K-pop, creación YouTube/TikTok, organización de fiestas/eventos, moda/estilismo, canto' }),
    why: { ko: '삶 자체를 즐기고 사람들을 즐겁게 하는 것에서 기쁨을 찾는 ESFP에게 완벽한 출구', en: 'Perfect outlet for ESFPs who find joy in enjoying life itself and making others happy', ja: '人生自体を楽しみ、人々を喜ばせることに喜びを見つけるESFPにとって完璧な出口', zh: '对于从享受生活本身和让他人快乐中找到喜悦的ESFP来说是完美的出口', fr: 'Exutoire parfait pour les ESFP qui trouvent de la joie dans l\'appréciation de la vie et la joie des autres', es: 'Salida perfecta para ESFPs que encuentran alegría en disfrutar la vida y hacer felices a los demás' } },
];
---

<Layout title={meta.title} description={meta.description} locale={locale}>
  <main class="mx-auto max-w-3xl px-4 py-10">
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-black text-slate-900">{heading}</h1>
      <p class="mt-2 text-slate-500">{subheading}</p>
      <a
        href={localePath(locale, '/mbti/test')}
        class="mt-4 inline-flex items-center gap-2 rounded-full border-2 border-green-700 bg-green-700 px-5 py-2 text-sm font-bold text-white transition hover:bg-green-800"
      >
        {labelTest} →
      </a>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      {TYPES.map(({ type, color, hobbies, why }) => (
        <div class={`rounded-2xl border-2 p-5 ${color}`}>
          <div class="mb-3 flex items-center gap-2">
            <span class="rounded-lg bg-white/70 px-3 py-1 font-mono text-lg font-black text-slate-800">{type}</span>
          </div>
          <p class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-1">{labelHobbies}</p>
          <p class="text-sm leading-relaxed text-slate-800 mb-3">{hobbies}</p>
          <p class="text-xs text-slate-500 italic border-t border-slate-200 pt-2">{why[locale] ?? why.en}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 rounded-2xl border-2 border-green-200 bg-green-50 p-6 text-center">
      <p class="text-sm text-slate-600 mb-3">
        {txt({ ko: '내 MBTI 유형이 아직 확실하지 않다면?', en: 'Not sure of your MBTI type yet?', ja: 'MBTIタイプがまだ分からない？', zh: '还不确定你的MBTI类型？', fr: 'Pas encore sûr de votre type MBTI ?', es: '¿Aún no estás seguro de tu tipo MBTI?' })}
      </p>
      <a
        href={localePath(locale, '/mbti/test')}
        class="inline-flex items-center gap-2 rounded-xl border-2 border-green-700 bg-white px-6 py-3 font-bold text-green-700 transition hover:bg-green-700 hover:text-white"
      >
        {txt({ ko: '무료 MBTI 테스트 하기', en: 'Take the Free MBTI Test', ja: '無料MBTIテストを受ける', zh: '参加免费MBTI测试', fr: 'Passer le test MBTI gratuit', es: 'Hacer el test MBTI gratis' })} →
      </a>
    </div>
  </main>
</Layout>
