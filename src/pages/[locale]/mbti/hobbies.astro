---
import Layout from '../../../layouts/Layout.astro';
import { LOCALES, localePath } from '../../../i18n';
import type { Locale } from '../../../i18n';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };

type L = Locale;
const txt = (map: Record<L, string>) => map[locale] ?? map.en;

const meta = {
  title: txt({
    ko: 'MBTI별 추천 취미 — 나에게 맞는 취미 찾기',
    en: 'MBTI Hobbies — Find Activities That Suit Your Type',
    ja: 'MBTIタイプ別おすすめ趣味',
    zh: 'MBTI类型推荐爱好',
    fr: 'Loisirs MBTI — Trouvez des activités selon votre type',
    es: 'Pasatiempos MBTI — Encuentra actividades para tu tipo',
  }),
  description: txt({
    ko: 'MBTI 16가지 유형별로 에너지를 충전하고 몰입할 수 있는 취미를 추천합니다. 내향형과 외향형, 직관형과 감각형의 취향 차이를 반영한 취미 가이드.',
    en: 'Discover hobbies matched to all 16 MBTI types. Activities designed to recharge your energy and spark deep engagement based on your personality preferences.',
    ja: 'MBTI 16タイプ別に合ったおすすめ趣味を紹介。エネルギーを充電し、深く楽しめる活動をタイプごとにご提案。',
    zh: '根据MBTI 16种类型推荐适合的爱好，帮助你充电和深度投入的活动。',
    fr: 'Découvrez des loisirs adaptés aux 16 types MBTI. Activités pour recharger votre énergie selon vos préférences de personnalité.',
    es: 'Descubre pasatiempos para los 16 tipos MBTI. Actividades para recargar energía según tus preferencias de personalidad.',
  }),
};

const heading = txt({
  ko: 'MBTI별 추천 취미',
  en: 'Hobbies by MBTI Type',
  ja: 'MBTIタイプ別おすすめ趣味',
  zh: 'MBTI类型推荐爱好',
  fr: 'Loisirs par Type MBTI',
  es: 'Pasatiempos por Tipo MBTI',
});

const subheading = txt({
  ko: '내 유형에 맞는 취미를 찾으면 억지로 즐기려 하지 않아도 자연스럽게 빠져듭니다.',
  en: 'When you find a hobby that fits your type, you\'ll find yourself naturally drawn in — no forcing required.',
  ja: '自分のタイプに合った趣味を見つけると、自然と深く楽しめるようになります。',
  zh: '找到适合自己类型的爱好，就能自然地沉浸其中，无需强迫自己。',
  fr: 'Quand vous trouvez un loisir adapté à votre type, vous vous y plongez naturellement.',
  es: 'Cuando encuentras un pasatiempo que se adapta a tu tipo, te sumerges naturalmente.',
});

const labelHobbies = txt({ ko: '추천 취미', en: 'Recommended Hobbies', ja: 'おすすめ趣味', zh: '推荐爱好', fr: 'Loisirs recommandés', es: 'Pasatiempos recomendados' });
const labelWhy = txt({ ko: '잘 맞는 이유', en: 'Why it fits', ja: 'なぜ合うのか', zh: '为什么适合', fr: 'Pourquoi ça convient', es: 'Por qué se adapta' });
const labelTest = txt({ ko: '내 MBTI 알아보기', en: 'Find my MBTI', ja: 'MBTIを調べる', zh: '了解我的MBTI', fr: 'Trouver mon MBTI', es: 'Encontrar mi MBTI' });

interface MBTIEntry {
  type: string;
  color: string;
  hobbies: string;
  why: Record<L, string>;
}

const TYPES: MBTIEntry[] = [
  { type: 'INTJ', color: 'bg-violet-100 border-violet-300',
    hobbies: txt({ ko: '체스·바둑, 코딩·프로그래밍, SF 소설, 전략 보드게임, 투자 분석, 철학 독서', en: 'Chess, coding, sci-fi novels, strategy board games, investment analysis, philosophy reading', ja: 'チェス·囲碁、コーディング、SF小説、戦略ボードゲーム、投資分析', zh: '国际象棋、编程、科幻小说、战略棋盘游戏、投资分析、哲学阅读', fr: 'Échecs, programmation, romans SF, jeux de stratégie, analyse d\'investissement', es: 'Ajedrez, programación, novelas de ciencia ficción, juegos de estrategia, análisis de inversión' }),
    why: { ko: '장기적 패턴과 전략 설계를 즐기는 INTJ에게 최적', en: 'Perfect for INTJs who enjoy long-term pattern recognition and strategic planning', ja: '長期的パターンと戦略設計を楽しむINTJに最適', zh: '对于享受长期模式识别和战略规划的INTJ来说是最佳选择', fr: 'Parfait pour les INTJ qui apprécient la reconnaissance de patterns et la planification stratégique', es: 'Perfecto para INTJs que disfrutan el reconocimiento de patrones a largo plazo' } },
  { type: 'INTP', color: 'bg-sky-100 border-sky-300',
    hobbies: txt({ ko: '수학·물리 퍼즐, 오픈소스 프로젝트, 위키 편집, 언어 학습, 실험적 요리, 도미노 설계', en: 'Math/physics puzzles, open-source projects, wiki editing, language learning, experimental cooking, domino design', ja: '数学·物理パズル、オープンソース、言語学習、実験料理', zh: '数学物理谜题、开源项目、语言学习、实验烹饪', fr: 'Puzzles mathématiques, projets open-source, apprentissage des langues, cuisine expérimentale', es: 'Puzzles matemáticos, proyectos open-source, aprendizaje de idiomas, cocina experimental' }),
    why: { ko: '논리 구조를 탐구하고 아이디어를 연결하는 것을 좋아하는 INTP에게 이상적', en: 'Ideal for INTPs who love exploring logical structures and connecting ideas', ja: '論理構造を探求しアイデアをつなぐことが好きなINTPに理想的', zh: '对于喜欢探索逻辑结构并连接想法的INTP来说是理想选择', fr: 'Idéal pour les INTP qui aiment explorer les structures logiques et connecter les idées', es: 'Ideal para INTPs que aman explorar estructuras lógicas y conectar ideas' } },
  { type: 'ENTJ', color: 'bg-red-100 border-red-300',
    hobbies: txt({ ko: '토론 클럽, 비즈니스 시뮬레이션, 마라톤·트라이애슬론, 독서 모임(리더십), 투자·주식', en: 'Debate clubs, business simulations, marathon/triathlon, leadership book clubs, investing', ja: 'ディベートクラブ、ビジネスシミュレーション、マラソン、投資', zh: '辩论俱乐部、商业模拟、马拉松、领导力读书会、投资', fr: 'Clubs de débat, simulations d\'affaires, marathon/triathlon, clubs de lecture leadership', es: 'Clubes de debate, simulaciones de negocios, maratón/triatlón, clubes de lectura de liderazgo' }),
    why: { ko: '목표를 향해 추진하고 경쟁에서 에너지를 얻는 ENTJ의 성향과 맞음', en: 'Aligns with ENTJs\' drive to push toward goals and gain energy from competition', ja: '目標に向かって推進し競争からエネルギーを得るENTJの傾向と一致', zh: '与ENTJ追求目标、从竞争中获得能量的特质相符', fr: 'Correspond à la tendance ENTJ à poursuivre des objectifs et à gagner de l\'énergie de la compétition', es: 'Se alinea con la tendencia ENTJ de perseguir objetivos y ganar energía de la competencia' } },
  { type: 'ENTP', color: 'bg-orange-100 border-orange-300',
    hobbies: txt({ ko: '즉흥 연기·임프로브, 브레인스토밍 세션, 팟캐스트 제작, 스타트업 프로젝트, 과학 실험', en: 'Improv comedy, brainstorming sessions, podcast creation, startup projects, science experiments', ja: 'インプロバイゼーション、ブレインストーミング、ポッドキャスト制作、スタートアッププロジェクト', zh: '即兴表演、头脑风暴、播客制作、创业项目、科学实验', fr: 'Comédie improvisée, séances de brainstorming, création de podcasts, projets de startup', es: 'Comedia improvisada, sesiones de brainstorming, creación de podcasts, proyectos de startup' }),
    why: { ko: '새로운 아이디어와 논쟁을 즐기는 ENTP에게 최적의 창의적 출구', en: 'Perfect creative outlet for ENTPs who enjoy new ideas and intellectual debate', ja: '新しいアイデアと議論を楽しむENTPに最適な創造的な出口', zh: '对于喜欢新想法和智识辩论的ENTP来说是完美的创意出口', fr: 'Exutoire créatif parfait pour les ENTP qui apprécient les nouvelles idées et les débats intellectuels', es: 'Salida creativa perfecta para ENTPs que disfrutan nuevas ideas y debates intelectuales' } },
  { type: 'INFJ', color: 'bg-purple-100 border-purple-300',
    hobbies: txt({ ko: '일기·에세이 쓰기, 심리학·철학 독서, 아트저널링, 명상, 자원봉사, 시 창작', en: 'Journaling/essay writing, psychology & philosophy reading, art journaling, meditation, volunteering, poetry', ja: '日記·エッセイ書き、心理学·哲学読書、アートジャーナリング、瞑想', zh: '日记写作、心理学哲学阅读、艺术日志、冥想、志愿服务、诗歌创作', fr: 'Journalisation/écriture d\'essais, lecture de psychologie et philosophie, journal artistique, méditation', es: 'Journaling/escritura de ensayos, lectura de psicología y filosofía, journal artístico, meditación' }),
    why: { ko: '내면 세계를 탐구하고 의미를 찾는 INFJ에게 깊은 만족을 주는 활동', en: 'Activities that give INFJs deep satisfaction in exploring the inner world and finding meaning', ja: '内面世界を探求し意味を見つけるINFJに深い満足をもたらす活動', zh: '给喜欢探索内心世界和寻找意义的INFJ带来深度满足的活动', fr: 'Activités qui donnent aux INFJ une profonde satisfaction dans l\'exploration du monde intérieur', es: 'Actividades que dan a los INFJ satisfacción profunda en explorar el mundo interior' } },
  { type: 'INFP', color: 'bg-pink-100 border-pink-300',
