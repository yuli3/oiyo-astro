---
/**
 * 내가 태어난 해 — 대한민국 연도별 출생아 수·합계출산율 (ko 전용). 10종 랜덤 5번, 2026-11-21.
 * 자료는 Mac에서 e-나라지표·위키백과 표를 받아 맞춰 본 값(src/lib/born-year.ts 머리말).
 */
import Layout from '../../layouts/Layout.astro';
import BornYearStats from '../../components/tools/born/BornYearStats';
import { localePath, type Locale } from '../../i18n';
import { animalFor, BIRTH_YEARS, BORN_LIMIT, BORN_SOURCE_ENARA, BORN_SOURCE_WIKI, formatBirths } from '../../lib/born-year';

export function getStaticPaths() {
  return [{ params: { locale: 'ko' } }];
}

const { locale } = Astro.params as { locale: Locale };
const title = '내가 태어난 해 출생아 수 — 1950~2024 연도별 출생아·합계출산율과 내 동갑 수';
const description = '태어난 해를 고르면 그해 대한민국 출생아 수, 75해 중 순위, 2024년 대비 몇 배인지, 합계출산율을 보여 줘요. 1950~2024 연도별 출생아 수 표와 출처를 함께 정리했어요.';

const decades = [1950, 1960, 1970, 1980, 1990, 2000, 2010, 2020];
const faqs = [
  { q: '출생아 수가 가장 많았던 해는 언제인가요?', a: '1950~2024년 가운데 1960년(108만 535명)이에요. 공식 출생통계가 시작된 1970년 이후로는 1971년(102만 4,773명)이 가장 많아요.' },
  { q: '가장 적게 태어난 해는요?', a: '2023년 22만 9,971명이에요. 2024년에는 23만 8,300명으로 9년 만에 늘었어요.' },
  { q: '합계출산율은 무엇인가요?', a: '여성 한 명이 평생 낳을 것으로 예상되는 아이 수예요. 2024년 0.748명으로, 인구를 유지하는 수준(약 2.1명)의 3분의 1 정도예요.' },
  { q: '동갑 수가 지금 살아 있는 사람 수인가요?', a: '아니에요. 그해 태어나 신고된 아이 수예요. 지금 같은 나이 인구는 사망과 이민·귀화로 달라지니 주민등록 인구 통계를 보세요.' },
  { q: '2003년과 2019년에는 왜 "약"이 붙나요?', a: '두 출처의 정확한 수가 맞지 않아서, e-나라지표의 천 명 단위 값을 썼어요.' },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Layout title={title} description={description} locale={locale} availableLocales={['ko']}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <section class="mx-auto max-w-2xl px-4 py-10">
    <p class="text-xs font-black tracking-widest text-primary">통계로 보는 나 · 1950~2024</p>
    <h1 class="mt-3 text-3xl font-black tracking-tight">내가 태어난 해, 몇 명이 함께 태어났을까</h1>
    <p class="mt-3 text-base leading-relaxed text-muted-foreground">태어난 해를 고르면 그해 대한민국 출생아 수와 75해 가운데 순위, 2024년보다 몇 배였는지 알려 드려요. 막대를 눌러 다른 해도 볼 수 있어요.</p>

    <div class="mt-8">
      <BornYearStats client:load />
    </div>

    <section class="mt-12 space-y-3">
      <h2 class="text-2xl font-black">연도별 출생아 수와 합계출산율</h2>
      <p class="leading-relaxed text-muted-foreground">1960년 108만 명에서 2023년 23만 명까지, 한 해 태어나는 아이는 5분의 1로 줄었어요. 1970년대 초 100만 명, 1980년대 중반 60만 명대, 2002년 40만 명대, 2017년 30만 명대, 2020년 20만 명대로 내려왔어요.</p>
      {decades.map((d) => (
        <details class="rounded-xl border bg-card" open={d === 1990}>
          <summary class="cursor-pointer p-4 text-sm font-black">{d}년대</summary>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <caption class="sr-only">{d}년대 연도별 출생아 수</caption>
              <thead class="bg-muted text-left">
                <tr><th class="p-3" scope="col">해</th><th class="p-3" scope="col">띠</th><th class="p-3" scope="col">출생아 수</th><th class="p-3" scope="col">합계출산율</th></tr>
              </thead>
              <tbody class="divide-y">
                {BIRTH_YEARS.filter((b) => b.year >= d && b.year < d + 10).map((b) => {
                  const a = animalFor(b.year);
                  return (
                    <tr>
                      <td class="p-3 font-bold">{b.year}</td>
                      <td class="p-3"><a class="underline" href={localePath(locale, `/chinese-zodiac/${a.id}`)}>{a.emoji} {a.name}</a></td>
                      <td class="p-3">{formatBirths(b)}</td>
                      <td class="p-3">{b.tfr != null ? `${b.tfr}명` : '–'}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </details>
      ))}
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-black">자주 묻는 질문</h2>
      <div class="mt-4 divide-y rounded-xl border bg-card">
        {faqs.map((f) => (
          <details class="group p-4">
            <summary class="cursor-pointer text-sm font-black">{f.q}</summary>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-8 text-xs leading-5 text-muted-foreground">
      {BORN_LIMIT} 출처: <a class="underline" href={BORN_SOURCE_ENARA} rel="noopener">e-나라지표 출생아 수와 합계출산율</a>(국가데이터처 「2024년 출생통계(확정)」, 1970~2024),
      <a class="underline" href={BORN_SOURCE_WIKI} rel="noopener">위키백과 대한민국의 인구</a>(정확한 출생아 수, 1950~1969 전체).
    </p>

    <nav class="mt-10 grid gap-3 sm:grid-cols-2" aria-label="함께 보기">
      <a href={localePath(locale, '/chinese-zodiac')} class="rounded-xl border bg-card p-4 text-sm font-black transition hover:border-primary">🐲 내 띠 성격과 궁합</a>
      <a href={localePath(locale, '/new-year-2027')} class="rounded-xl border bg-card p-4 text-sm font-black transition hover:border-primary">🐑 2027 신년운세 모음</a>
      <a href={localePath(locale, '/profile/year-2026')} class="rounded-xl border bg-card p-4 text-sm font-black transition hover:border-primary">🗓️ 나의 2026 결산 카드</a>
      <a href={localePath(locale, '/dongji-2026')} class="rounded-xl border bg-card p-4 text-sm font-black transition hover:border-primary">🥣 2026 동지 팥죽 카드</a>
    </nav>
  </section>
</Layout>
