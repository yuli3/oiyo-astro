    ],
    disclaimer: 'このページは時間の使い方を軽く見直すための生活設計コンテンツです。',
  },
  zh: {
    introTitle: '创造时间，就是把优先事项放进日历',
    intro: '空闲时间很少自然出现。时间审计能看到时间流向，时间块能保护重要事项，能量匹配能让困难任务出现在你真正有精力的时候。',
    conceptTitle: '夺回时间的三根杠杆',
    concepts: [
      { title: '时间审计', body: '记录几天到一周，看看时间实际去了哪里。' },
      { title: '时间块', body: '把重要任务从模糊清单移到日历上的具体时间。' },
      { title: '能量匹配', body: '高能量时做深度工作，低能量时处理杂务。' },
    ],
    useTitle: '适合的场景',
    useCases: [
      { title: '找回个人时间', body: '先预约运动、阅读、兴趣或休息，不等一天自动空出来。' },
      { title: '保护专注工作', body: '避免深度工作被消息和会议切碎。' },
      { title: '为例程留空间', body: '加入新习惯前，先找到真实可用的时间段。' },
    ],
    faqTitle: '常见问题',
    faqs: [
      { question: '时间块会不会太僵硬？', answer: '不是把每分钟填满。好的时间块包含缓冲和可移动空间。' },
      { question: '时间审计要做多久？', answer: '第一次3天到1周足够。如果工作日和周末不同，最好都包含。' },
      { question: '日程经常变化怎么办？', answer: '保留20%到30%的缓冲，只保护少数最关键的小块。' },
    ],
    readingTitle: '延伸阅读',
    reading: [
      { href: 'https://oiyo.net/zh/routine/builder', label: '打造例程', desc: '把时间块连接到每日节奏。' },
    ],
    disclaimer: '本页用于轻松回看时间使用方式与生活设计。',
  },
  fr: {
    introTitle: 'Créer du temps, c’est mettre les priorités dans l’agenda',
    intro: 'Le temps libre apparaît rarement par hasard. Un audit montre les fuites, le time blocking protège l’essentiel et l’énergie guide le bon moment pour les tâches exigeantes.',
    conceptTitle: 'Trois leviers',
    concepts: [
      { title: 'Audit du temps', body: 'Observer quelques jours pour voir où partent les heures.' },
      { title: 'Blocs de temps', body: 'Transformer une intention vague en créneau précis.' },
      { title: 'Énergie', body: 'Placer le travail profond aux moments les plus clairs.' },
    ],
    useTitle: 'Quand l’utiliser',
    useCases: [
      { title: 'Retrouver du temps personnel', body: 'Planifier sport, lecture, loisirs ou repos avant que la journée se remplisse.' },
      { title: 'Protéger la concentration', body: 'Éviter que le travail profond disparaisse entre réunions et messages.' },
      { title: 'Faire place aux routines', body: 'Trouver le vrai créneau avant d’ajouter une habitude.' },
    ],
    faqTitle: 'Questions fréquentes',
    faqs: [
      { question: 'Le time blocking est-il trop rigide ?', answer: 'Non si vous gardez des marges. Il protège l’essentiel sans remplir chaque minute.' },
      { question: 'Combien de temps auditer ?', answer: 'Trois jours à une semaine suffisent pour commencer.' },
      { question: 'Et si mon agenda change beaucoup ?', answer: 'Gardez 20 à 30% de marge et protégez seulement quelques blocs essentiels.' },
    ],
    readingTitle: 'Lire plus',
    reading: [
      { href: 'https://oiyo.net/fr/routine/builder', label: 'Créer une routine', desc: 'Relier les blocs au rythme quotidien.' },
    ],
    disclaimer: 'Cette page sert à observer votre usage du temps avec une réflexion lifestyle légère.',
  },
  es: {
    introTitle: 'Crear tiempo es poner prioridades en el calendario',
    intro: 'El tiempo libre rara vez aparece solo. Una auditoría muestra fugas, los bloques protegen lo importante y el mapa de energía coloca tareas difíciles cuando tu mente está disponible.',
    conceptTitle: 'Tres palancas',
    concepts: [
      { title: 'Auditoría de tiempo', body: 'Observar varios días para ver dónde van las horas.' },
      { title: 'Bloques de tiempo', body: 'Pasar una intención vaga a un espacio concreto del calendario.' },
      { title: 'Energía', body: 'Reservar horas claras para trabajo profundo y horas bajas para administración.' },
    ],
    useTitle: 'Cuándo usarlo',
    useCases: [
      { title: 'Recuperar tiempo personal', body: 'Programar ejercicio, lectura, hobbies o descanso antes de que el día se llene.' },
      { title: 'Proteger enfoque', body: 'Evitar que el trabajo profundo desaparezca entre mensajes y reuniones.' },
      { title: 'Hacer espacio para rutinas', body: 'Encontrar el horario real antes de sumar un hábito.' },
    ],
    faqTitle: 'Preguntas frecuentes',
    faqs: [
      { question: '¿Bloquear tiempo es demasiado rígido?', answer: 'No si incluye márgenes. Protege lo importante sin llenar cada minuto.' },
      { question: '¿Cuánto dura una auditoría?', answer: 'De tres días a una semana basta para empezar.' },
      { question: '¿Y si mi agenda cambia mucho?', answer: 'Deja 20 a 30% de margen y protege solo unos pocos bloques esenciales.' },
    ],
    readingTitle: 'Leer más',
    reading: [
      { href: 'https://oiyo.net/es/routine/builder', label: 'Construir rutina', desc: 'Conectar bloques con el ritmo diario.' },
    ],
    disclaimer: 'Esta página sirve para observar tu uso del tiempo con una reflexión lifestyle ligera.',
  },
};

const c = content[locale] ?? content.en;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Layout title={meta.title} description={meta.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="mx-auto max-w-2xl px-4 py-10">
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-black text-slate-900">{txt({ ko: '시간 만들기', en: 'Making Time', ja: '時間の作り方', zh: '创造时间', fr: 'Créer du Temps', es: 'Crear Tiempo' })}</h1>
      <p class="mt-2 text-sm text-slate-500">{meta.description}</p>
    </div>

    <div class="space-y-5">
      {steps.map(({ num, title, desc }) => (
        <div class="rounded-2xl border-2 border-slate-200 bg-card p-6 hover:border-green-300 transition">
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 font-mono text-3xl font-black text-green-600 opacity-40">{num}</span>
            <div>
              <h2 class="text-base font-black text-slate-900 mb-2">{title[locale] ?? title.en}</h2>
              <p class="whitespace-pre-line text-sm leading-relaxed text-slate-700">{desc[locale] ?? desc.en}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 grid gap-3 sm:grid-cols-2">
      <a href={localePath(locale, '/routine/builder')} class="flex items-center gap-2 rounded-xl border-2 border-green-200 bg-green-50 p-4 transition hover:border-green-400">
        <span class="text-2xl">📋</span>
        <div>
          <p class="font-bold text-green-800">{txt({ ko: '루틴 만들기 가이드', en: 'Routine Builder Guide', ja: 'ルーティン設計ガイド', zh: '例程设计指南', fr: 'Guide de construction de routine', es: 'Guía de construcción de rutina' })}</p>
          <p class="text-xs text-green-600">{txt({ ko: '아침·저녁·주간 루틴 설계', en: 'Morning, evening & weekly design', ja: '朝·夜·週間ルーティン設計', zh: '晨间、晚间和每周例程设计', fr: 'Conception matin, soir & hebdomadaire', es: 'Diseño mañana, noche y semanal' })}</p>
        </div>
      </a>
      <a href={localePath(locale, '/habit-builder/30-days')} class="flex items-center gap-2 rounded-xl border-2 border-slate-200 bg-card p-4 transition hover:border-green-300">
        <span class="text-2xl">🌱</span>
        <div>
          <p class="font-bold text-slate-800">{txt({ ko: '30일 습관 챌린지', en: '30-Day Habit Challenge', ja: '30日習慣チャレンジ', zh: '30天习惯挑战', fr: 'Défi 30 jours', es: 'Desafío 30 días' })}</p>
          <p class="text-xs text-slate-500">{txt({ ko: '과학적 습관 형성 프로그램', en: 'Science-backed habit formation', ja: '科学的習慣形成プログラム', zh: '科学习惯养成计划', fr: 'Programme de formation d\'habitudes scientifique', es: 'Programa de formación de hábitos científico' })}</p>
        </div>
      </a>
    </div>
    <RelatedTools locale={locale} tools={['mbti', 'big5', 'attachment']} current="routine-time-maker" />

    <section class="mt-8 border-t border-green-100 pt-8">
      <h2 class="text-2xl font-bold text-slate-950">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.conceptTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.concepts.map((item) => (
          <article class="rounded-xl border border-green-100 bg-card p-4">
            <h3 class="font-semibold text-slate-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.useTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.useCases.map((item) => (
          <article class="rounded-xl bg-green-50 p-4">
            <h3 class="font-semibold text-slate-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-green-100 rounded-xl border border-green-100 bg-card">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-950">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.readingTitle}</h2>
      <div class="mt-4 grid gap-3 md:grid-cols-3">
        {c.reading.map((item) => (
          <a class="rounded-xl border border-green-100 bg-card p-4 transition-colors hover:border-green-300 hover:bg-green-50" href={item.href} rel="noopener noreferrer" target="_blank">
            <span class="font-semibold text-slate-950">{item.label}</span>
            <span class="mt-2 block text-sm leading-6 text-slate-700">{item.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">
      {c.disclaimer}
    </p>
      <MentalBoost locale={locale} />
  </div>
</Layout>
