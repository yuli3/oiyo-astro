    ],
    readingTitle: 'Read more',
    reading: [
      { href: 'https://oiyo.net/en/routine/builder', label: 'Build a routine', desc: 'Connect your time blocks to a daily rhythm.' },
    ],
    disclaimer: 'This page is for lifestyle design and light self-reflection about how you spend time.',
  },
  ja: {
    introTitle: '時間を作るとは、優先順位をカレンダーに置くことです',
    intro: '自由な時間は自然には残りにくいものです。時間監査で漏れを見つけ、タイムブロックで大切なことを守り、エネルギーに合わせて配置すると「いつか」が予定になります。',
    conceptTitle: '時間を取り戻す三つの軸',
    concepts: [
      { title: '時間監査', body: '数日から一週間、実際に時間がどこへ行くか記録します。' },
      { title: 'タイムブロック', body: '重要なことをリストではなく、カレンダーの具体的な時間に置きます。' },
      { title: 'エネルギー配置', body: '集中作業は高エネルギー時間に、雑務は低い時間に置きます。' },
    ],
    useTitle: '役立つ場面',
    useCases: [
      { title: '自分の時間を戻す', body: '運動、読書、趣味、休息を先に予定します。' },
      { title: '集中時間を守る', body: 'メールや会議の間に深い作業が消えないようにします。' },
      { title: 'ルーティンの場所を作る', body: '新しい習慣を入れる前に、現実の時間帯を見つけます。' },
    ],
    faqTitle: 'よくある質問',
    faqs: [
      { question: 'タイムブロックは窮屈では？', answer: 'すべての分を埋める必要はありません。余白ブロックを入れるほど現実的になります。' },
      { question: '時間監査はどれくらい必要？', answer: '最初は3日から1週間で十分です。平日と週末が違うなら両方を含めます。' },
      { question: '予定変更が多い場合は？', answer: '一日の20〜30%を余白にし、守るブロックを少数に絞ります。' },
