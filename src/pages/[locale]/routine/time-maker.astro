}> = {
  ko: {
    introTitle: '시간 만들기는 빈틈을 찾는 일이 아니라 우선순위를 달력에 올리는 일입니다',
    intro: '바쁜 일상에서 시간은 우연히 남지 않습니다. 시간 감사로 새는 곳을 보고, 에너지 높은 시간대를 보호하고, 중요한 일을 먼저 블록으로 잡으면 “언젠가”가 실제 일정으로 바뀝니다.',
    conceptTitle: '시간을 되찾는 세 가지 축',
    concepts: [
      { title: '시간 감사', body: '일주일 단위로 활동을 기록해 실제로 어디에 시간이 쓰이는지 봅니다.' },
      { title: '시간 블로킹', body: '중요한 일을 할 일 목록이 아니라 달력의 특정 시간에 배치합니다.' },
      { title: '에너지 매칭', body: '깊은 집중은 고에너지 시간에, 잡무는 낮은 에너지 시간에 둡니다.' },
    ],
    useTitle: '이럴 때 도움이 됩니다',
    useCases: [
      { title: '개인 시간 회복', body: '운동, 독서, 취미처럼 계속 밀리는 시간을 먼저 예약합니다.' },
      { title: '업무 집중 정리', body: '메일과 회의 사이에 사라지는 깊은 작업 시간을 보호합니다.' },
      { title: '루틴 공간 만들기', body: '새 루틴을 넣기 전에 실제로 비울 수 있는 시간대를 찾습니다.' },
    ],
    faqTitle: '자주 묻는 질문',
    faqs: [
      { question: '시간 블로킹은 너무 답답하지 않나요?', answer: '모든 분을 채우라는 뜻이 아닙니다. 중요한 블록과 여유 블록을 함께 두면 오히려 덜 쫓깁니다.' },
      { question: '시간 감사는 얼마나 해야 하나요?', answer: '처음에는 3일에서 1주일이면 충분합니다. 평일과 주말 패턴이 다르면 둘 다 포함하세요.' },
      { question: '갑작스러운 일이 많으면 어떻게 하나요?', answer: '하루 일정의 20~30%를 버퍼로 두고, 절대 지킬 핵심 블록만 작게 잡는 편이 현실적입니다.' },
    ],
    readingTitle: '더 읽어보기',
    reading: [
      { href: 'https://oiyo.net/ko/routine/builder', label: '루틴 만들기', desc: '시간 블록을 실제 하루 흐름으로 연결합니다.' },
    ],
    disclaimer: '이 페이지는 시간을 쓰는 방식을 가볍게 돌아보는 생활 설계 콘텐츠입니다.',
  },
  en: {
    introTitle: 'Making time means putting priorities on the calendar',
    intro: 'Free time rarely appears by accident. A time audit shows where hours leak, time blocking protects what matters, and energy matching helps you put demanding work where your mind is actually available.',
    conceptTitle: 'Three levers for reclaiming time',
    concepts: [
      { title: 'Time audit', body: 'Track a few days to see where your hours actually go.' },
