    ],
    faqTitle: 'Frequently asked questions',
    faqs: [
      { question: 'Is time blocking too rigid?', answer: 'It does not mean filling every minute. Good time blocking includes buffers and flexible blocks.' },
      { question: 'How long should I run a time audit?', answer: 'Three days to one week is enough for a first pass. Include both weekdays and weekends if they differ.' },
