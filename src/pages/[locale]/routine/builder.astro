const c = content[locale] ?? content.en;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Layout title={meta.title} description={meta.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="mx-auto max-w-2xl px-4 py-10">
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-black text-slate-900">{meta.title.split('—')[0].trim()}</h1>
      <p class="mt-2 text-sm text-slate-500">{meta.description}</p>
    </div>

    <div class="space-y-6">
      {sections.map(({ title, icon, content }) => (
        <div class="rounded-2xl border-2 border-green-200 bg-card p-6">
          <h2 class="mb-3 flex items-center gap-2 text-lg font-black text-slate-900">
            <span class="text-2xl">{icon}</span>{title}
          </h2>
          <div class="whitespace-pre-line text-sm leading-relaxed text-slate-700">{content}</div>
        </div>
      ))}
    </div>

    <RoutineChecklist client:visible locale={locale} />

    <div class="mt-10 rounded-2xl border-2 border-green-100 bg-green-50 p-5">
      <p class="mb-3 text-sm font-bold text-green-800">{txt({ ko: '관련 도구', en: 'Related Tools', ja: '関連ツール', zh: '相关工具', fr: 'Outils connexes', es: 'Herramientas relacionadas' })}</p>
      <div class="flex flex-wrap gap-2">
        {links.map(({ href, label }) => (
          <a href={localePath(locale, href)} class="rounded-full border-2 border-green-300 bg-card px-4 py-1.5 text-sm font-semibold text-green-700 transition hover:bg-green-700 hover:text-white">
            {label}
          </a>
        ))}
      </div>
    </div>
    <RelatedTools locale={locale} tools={['mbti', 'big5', 'attachment']} current="routine-builder" />

    <section class="mt-8 border-t border-green-100 pt-8">
      <h2 class="text-2xl font-bold text-slate-950">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.conceptTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.concepts.map((item) => (
          <article class="rounded-xl border border-green-100 bg-card p-4">
            <h3 class="font-semibold text-slate-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.useTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.useCases.map((item) => (
          <article class="rounded-xl bg-green-50 p-4">
            <h3 class="font-semibold text-slate-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-green-100 rounded-xl border border-green-100 bg-card">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-950">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.readingTitle}</h2>
      <div class="mt-4 grid gap-3 md:grid-cols-3">
        {c.reading.map((item) => (
          <a class="rounded-xl border border-green-100 bg-card p-4 transition-colors hover:border-green-300 hover:bg-green-50" href={item.href} rel="noopener noreferrer" target="_blank">
            <span class="font-semibold text-slate-950">{item.label}</span>
            <span class="mt-2 block text-sm leading-6 text-slate-700">{item.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">
      {c.disclaimer}
    </p>
      <MentalBoost locale={locale} />
  </div>
</Layout>
