---
import Layout from '../../../layouts/Layout.astro';
import MentalBoost from '../../../components/shared/MentalBoost.astro';
import RelatedTools from '../../../components/shared/RelatedTools.astro';
import { LOCALES, localePath } from '../../../i18n';
import type { Locale } from '../../../i18n';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
type L = Locale;
const txt = (map: Record<L, string>) => map[locale] ?? map.en;

const meta = {
  title: txt({ ko: '에니어그램 유형별 추천 취미·여가 활동', en: 'Enneagram Hobbies & Leisure by Type', ja: 'エニアグラムタイプ別おすすめ趣味・余暇活動', zh: '九型人格推荐兴趣与休闲活动', fr: 'Loisirs & Hobbies par Type Ennéagramme', es: 'Hobbies y Ocio por Tipo Eneagrama' }),
  description: txt({ ko: '에니어그램 9가지 유형별로 진심으로 즐길 수 있는 취미와 여가 활동을 추천합니다. 핵심 동기에 맞는 활동을 찾아 진정한 휴식과 성장을 경험하세요.', en: 'Discover hobbies and leisure activities that align with each of the 9 Enneagram types — activities that resonate with your core motivations for true rest and growth.', ja: 'エニアグラム9タイプ別に心から楽しめる趣味と余暇活動をご紹介。核心的な動機に合う活動で真の休息と成長を体験しましょう。', zh: '为九型人格的9种类型推荐能真正享受的兴趣和休闲活动，找到符合核心动机的活动体验真正的休息与成长。', fr: 'Découvrez des hobbies et loisirs en accord avec chacun des 9 types Ennéagramme — des activités qui résonnent avec vos motivations profondes.', es: 'Descubre hobbies y actividades de ocio que se alinean con cada uno de los 9 tipos del Eneagrama — actividades que resuenan con tus motivaciones centrales.' }),
};

interface TypeEntry {
  num: number;
  name: Record<L, string>;
  core: Record<L, string>;
  color: string;
  hobbies: Record<L, string>[];
  leisure: Record<L, string>;
  avoid: Record<L, string>;
}

const TYPES: TypeEntry[] = [
  {
    num: 1, name: { ko: '개혁가', en: 'The Reformer', ja: '改革者', zh: '改革者', fr: 'Le Réformateur', es: 'El Reformador' },
    core: { ko: '더 나은 세상을 만들고 싶은 원칙주의자', en: 'The principled perfectionist who wants to make things better', ja: 'より良い世界を作りたい原則主義者', zh: '想要让世界变得更好的原则主义者', fr: "Le perfectionniste qui veut améliorer le monde", es: 'El perfeccionista que quiere mejorar el mundo' },
    color: 'border-slate-300 bg-slate-50',
    hobbies: [
      { ko: '독서 — 윤리·철학·역사 논픽션', en: 'Reading — ethics, philosophy, history non-fiction', ja: '読書 — 倫理·哲学·歴史ノンフィクション', zh: '阅读 — 伦理、哲学、历史非虚构', fr: 'Lecture — essais d\'éthique, philosophie, histoire', es: 'Lectura — ensayos de ética, filosofía, historia' },
      { ko: '가드닝·텃밭 — 정확한 계획과 질서 있는 성장', en: 'Gardening — planned, orderly growth with visible results', ja: 'ガーデニング·家庭菜園 — 計画的で秩序ある成長', zh: '园艺·菜园 — 有计划、有秩序的成长', fr: 'Jardinage — croissance ordonnée avec résultats visibles', es: 'Jardinería — crecimiento ordenado con resultados visibles' },
      { ko: '칼리그라피·손글씨 — 완벽한 형태를 추구', en: 'Calligraphy / hand lettering — pursuit of perfect form', ja: 'カリグラフィー·手書き文字 — 完璧な形の追求', zh: '书法·手写体 — 追求完美形态', fr: 'Calligraphie — poursuite de la perfection formelle', es: 'Caligrafía — búsqueda de la forma perfecta' },
      { ko: '자원봉사·사회 캠페인 참여', en: 'Volunteering and civic/social campaigns', ja: 'ボランティア·社会キャンペーン参加', zh: '志愿服务·社会活动参与', fr: 'Bénévolat et campagnes citoyennes', es: 'Voluntariado y campañas cívicas/sociales' },
    ],
    leisure: { ko: '기준과 결과가 명확한 활동이 가장 편안합니다. 계획표 작성, 정리 정돈, 오래된 물건 수리 등 "제대로 해냈다"는 만족감을 주는 활동을 즐기세요. 완벽함을 잠시 내려놓는 독서 카페, 조용한 자연 산책도 큰 휴식이 됩니다.', en: 'Activities with clear standards and outcomes feel most comfortable. Making plans, organizing spaces, fixing things, and activities that give a "done right" satisfaction. A quiet reading café or nature walk — where you can briefly let go of perfectionism — brings deep rest.', ja: '基準と結果が明確な活動が最も安心します。計画作成、整理整頓、古いものの修理など「ちゃんとできた」という満足感を与える活動を楽しんでください。完璧さをちょっと手放す読書カフェや自然散策も大きな休息になります。', zh: '有明确标准和结果的活动最令人舒适。制定计划、整理空间、修理旧物等带来"做好了"满足感的活动。偶尔放下完美主义的读书咖啡馆、安静的自然散步也是很好的休息。', fr: 'Les activités aux critères clairs sont les plus confortables. Planifier, organiser, réparer — tout ce qui donne la satisfaction d\'un "bien fait". Un café lecture ou une promenade en nature où vous pouvez temporairement laisser aller la perfection apporte un repos profond.', es: 'Las actividades con estándares y resultados claros son las más cómodas. Planificar, organizar, reparar — todo lo que da satisfacción de "bien hecho". Un café de lectura o un paseo por la naturaleza donde puedas soltar temporalmente el perfeccionismo trae descanso profundo.' },
    avoid: { ko: '아무 기준 없이 즉흥적인 활동, 결과를 평가받는 경쟁', en: 'Purely spontaneous activities with no standards, high-stakes competitions', ja: '基準なしの即興活動、結果を評価される競争', zh: '没有任何标准的即兴活动，被评判结果的竞争', fr: 'Activités purement spontanées sans critères, compétitions à enjeux élevés', es: 'Actividades puramente espontáneas sin estándares, competencias con altas apuestas' },
  },
  {
    num: 2, name: { ko: '조력가', en: 'The Helper', ja: '援助者', zh: '助人者', fr: "L'Aidant", es: 'El Ayudador' },
    core: { ko: '사랑받고 싶어 다른 사람을 돕는 배려자', en: 'The caring person who helps others to feel loved and needed', ja: '愛されたくて他者を助ける思いやりある人', zh: '通过帮助他人获得爱与被需要感的关怀者', fr: "La personne attentionnée qui aide pour se sentir aimée", es: 'La persona cariñosa que ayuda a otros para sentirse amada y necesitada' },
    color: 'border-rose-300 bg-rose-50',
    hobbies: [
      { ko: '요리·베이킹 — 사람들에게 나눠주기', en: 'Cooking / baking to share with others', ja: '料理·ベーキング — 人にふるまう', zh: '烹饪/烘焙 — 与他人分享', fr: 'Cuisine / pâtisserie à partager', es: 'Cocinar / hornear para compartir' },
      { ko: '반려동물 돌보기 또는 동물 봉사', en: 'Pet care or animal volunteering', ja: 'ペット世話または動物ボランティア', zh: '照顾宠物或动物志愿服务', fr: 'Soins aux animaux ou bénévolat animalier', es: 'Cuidado de mascotas o voluntariado con animales' },
      { ko: '꽃꽂이·홈 데코 — 공간을 따뜻하게 만들기', en: 'Flower arranging / home décor — making spaces warm and welcoming', ja: 'フラワーアレンジメント·ホームデコ — 温かい空間作り', zh: '插花·家居装饰 — 营造温馨空间', fr: 'Art floral / décoration intérieure — créer des espaces chaleureux', es: 'Arreglos florales / decoración del hogar — crear espacios cálidos' },
      { ko: '감사 편지·일기 쓰기', en: 'Writing gratitude letters and journaling', ja: '感謝の手紙·日記を書く', zh: '写感谢信·日记', fr: 'Écriture de lettres de gratitude et journal intime', es: 'Escritura de cartas de gratitud y journaling' },
    ],
    leisure: { ko: '나누고 돌보는 활동에서 에너지를 얻습니다. 단, 자신을 위한 시간도 필수 — 아무도 의식하지 않고 혼자 목욕하거나, 마사지받거나, 좋아하는 드라마 보는 "나만을 위한 시간"을 의도적으로 만드세요. 타인의 시선 없이 자신을 채우는 경험이 2유형의 진정한 회복입니다.', en: 'You gain energy from sharing and nurturing. But solo self-care time is essential — intentionally create "just for me" time: a bath with no obligations, a massage, watching your favorite show. Replenishing yourself away from others\' gaze is the 2\'s true recovery.', ja: '分かち合い、世話することでエネルギーを得ます。ただし、自分のための時間も必須 — 誰も意識せず、一人でお風呂に入ったり、マッサージを受けたり、好きなドラマを見る「自分だけの時間」を意図的に作りましょう。他者の視線なしに自分を満たす経験が2タイプの真の回復です。', zh: '从分享和照顾中获取能量。但独处的自我关爱时间同样必不可少——有意识地创造"只为自己"的时间：没有义务的泡澡、按摩、看最喜欢的剧。在没有他人目光的情况下补充自己是2号的真正恢复。', fr: 'Vous puisez de l\'énergie dans le partage et le soin des autres. Mais le temps pour soi est essentiel — créez intentionnellement du temps "juste pour moi" : un bain sans obligations, un massage, regarder votre série préférée. Se ressourcer loin du regard des autres est la vraie récupération du 2.', es: 'Obtienes energía de compartir y cuidar. Pero el tiempo de autocuidado en solitario es esencial — crea intencionalmente tiempo "solo para mí": un baño sin obligaciones, un masaje, ver tu serie favorita. Reponerte alejado de las miradas de otros es la verdadera recuperación del 2.' },
    avoid: { ko: '완전히 혼자서만 해야 하는 고독한 활동(장기), 타인에게 무관심한 환경', en: 'Prolonged isolated solo activities, environments where people are completely indifferent to each other', ja: '長期的に完全に一人でしなければならない孤独な活動、他者に無関心な環境', zh: '长期完全独自进行的孤独活动，人们对彼此完全漠不关心的环境', fr: 'Activités solitaires prolongées, environnements où les gens sont indifférents les uns aux autres', es: 'Actividades solitarias prolongadas, entornos donde las personas son completamente indiferentes entre sí' },
  },
  {
    num: 3, name: { ko: '성취자', en: 'The Achiever', ja: '達成者', zh: '成就者', fr: "L'Achiever", es: 'El Triunfador' },
    core: { ko: '성공과 인정을 추구하는 효율적 실행가', en: 'The efficient performer who seeks success and recognition', ja: '成功と認知を追求する効率的な実行者', zh: '追求成功与认可的高效执行者', fr: 'Le performer efficace qui cherche le succès et la reconnaissance', es: 'El ejecutor eficiente que busca éxito y reconocimiento' },
    color: 'border-amber-300 bg-amber-50',
    hobbies: [
      { ko: '러닝·마라톤 — 기록 단축이라는 명확한 목표', en: 'Running / marathon — clear goal of beating your own record', ja: 'ランニング·マラソン — タイム短縮という明確な目標', zh: '跑步/马拉松 — 缩短个人记录的明确目标', fr: 'Course / marathon — objectif clair de battre son record', es: 'Correr / maratón — objetivo claro de superar tu propio récord' },
      { ko: '비즈니스 도서 독서 + 적용', en: 'Business book reading + practical application', ja: 'ビジネス書読書＋実践', zh: '商业书籍阅读+实践', fr: 'Lecture de livres business + application pratique', es: 'Lectura de libros de negocios + aplicación práctica' },
      { ko: '사진·영상 제작 — 포트폴리오 축적', en: 'Photography / video creation — building a portfolio', ja: '写真·動画制作 — ポートフォリオ蓄積', zh: '摄影/视频制作 — 积累作品集', fr: 'Photo / vidéo — constitution d\'un portfolio', es: 'Fotografía / creación de videos — construyendo un portafolio' },
      { ko: '네트워킹 이벤트·컨퍼런스 참가', en: 'Networking events and conferences', ja: 'ネットワーキングイベント·カンファレンス参加', zh: '社交活动·会议参与', fr: 'Événements de networking et conférences', es: 'Eventos de networking y conferencias' },
    ],
    leisure: { ko: '목표가 있는 활동에서 가장 활기를 느낍니다. 단, 진정한 휴식을 위해 "결과 없는 시간"을 연습하는 것이 3유형에게는 성장입니다. 아무도 모르게 혼자 자연을 걸으며 성과를 내려놓는 경험, 목적 없이 음악 듣기 등 — 의도적인 무목적성이 진정한 회복으로 이어집니다.', en: 'You feel most alive in goal-oriented activities. But for true rest, 3s need to practice "time without outcomes" — a solo walk in nature with no performance tracking, listening to music without purpose. Intentional purposelessness leads to true recovery.', ja: '目標がある活動で最も生き生きとします。ただし、真の休息のために「結果のない時間」を練習することが3タイプの成長です。誰も知らずに一人で自然を歩き成果を手放す経験、目的なく音楽を聴くなど — 意図的な無目的性が真の回復につながります。', zh: '在有目标的活动中感到最有活力。但对于真正的休息，3号需要练习"没有结果的时间"——独自在自然中散步不追踪表现，无目的地听音乐等。有意识的无目的性带来真正的恢复。', fr: 'Vous vous sentez le plus vivant dans les activités orientées vers un but. Mais pour un vrai repos, les 3 doivent pratiquer le "temps sans résultats" — une marche solo en nature sans suivi de performance, écouter de la musique sans but. L\'intentionnel sans but mène à la vraie récupération.', es: 'Te sientes más vivo en actividades orientadas a objetivos. Pero para el descanso verdadero, los 3 necesitan practicar "tiempo sin resultados" — un paseo solo en la naturaleza sin seguimiento de rendimiento, escuchar música sin propósito. La intencionalidad sin propósito lleva a la recuperación real.' },
    avoid: { ko: '아무 성과도 없어 보이는 반복적 활동, 경쟁 없는 무기력한 환경', en: 'Repetitive activities that seem to yield no results, demotivating environments with no competition', ja: '成果がないように見える繰り返し活動、競争のない無気力な環境', zh: '看似没有任何成果的重复活动，没有竞争的沉闷环境', fr: 'Activités répétitives sans résultats apparents, environnements démotivants sans compétition', es: 'Actividades repetitivas que no parecen producir resultados, entornos desmotivantes sin competencia' },
  },
  {
    num: 4, name: { ko: '개인주의자', en: 'The Individualist', ja: '個人主義者', zh: '个人主义者', fr: "L'Individualiste", es: 'El Individualista' },
    core: { ko: '독특한 정체성과 진정성을 갈망하는 낭만가', en: 'The romantic who craves unique identity and authenticity', ja: '独自のアイデンティティと真正性を渇望するロマンチスト', zh: '渴望独特身份和真实性的浪漫主义者', fr: 'Le romantique qui aspire à une identité unique et à l\'authenticité', es: 'El romántico que anhela identidad única y autenticidad' },
    color: 'border-purple-300 bg-purple-50',
    hobbies: [
      { ko: '시 창작·감성 산문 쓰기', en: 'Poetry writing / lyrical prose', ja: '詩の創作·感性的な散文執筆', zh: '诗歌创作·情感散文写作', fr: 'Écriture poétique / prose lyrique', es: 'Escritura poética / prosa lírica' },
      { ko: '그림·수채화·콜라주 아트', en: 'Painting, watercolor, collage art', ja: '絵画·水彩·コラージュアート', zh: '绘画、水彩、拼贴艺术', fr: 'Peinture, aquarelle, collage', es: 'Pintura, acuarela, arte de collage' },
      { ko: '음악 감상 (장르 깊이 파기) + 플레이리스트 큐레이션', en: 'Deep-dive music listening + playlist curation', ja: '音楽鑑賞（ジャンルを深く掘り下げる）＋プレイリストキュレーション', zh: '深入欣赏音악（深入挖掘流派）+播放列表策划', fr: 'Écoute musicale approfondie + curation de playlists', es: 'Escucha profunda de música + curación de listas de reproducción' },
      { ko: '빈티지 쇼핑·고유한 미학 탐구', en: 'Vintage shopping and exploring unique aesthetics', ja: 'ヴィンテージショッピング·独自の美学探求', zh: '复古购物·探索独特美学', fr: 'Shopping vintage et exploration d\'esthétiques uniques', es: 'Compras vintage y exploración de estéticas únicas' },
    ],
    leisure: { ko: '감정을 표현하고 의미를 탐색하는 활동에서 깊은 만족을 얻습니다. 영화·음악·미술에서 공명하는 순간을 찾아 일기에 기록하세요. 일상의 아름다움을 포착하는 사진 산책도 좋습니다. 단, 비교로 인한 자기비판을 주의 — 타인의 작품이 아닌 나만의 표현에 집중하는 것이 4유형의 진정한 여가입니다.', en: 'Deep satisfaction comes from expressing emotions and exploring meaning. Find resonant moments in film, music, and art — journal about them. Photo walks to capture everyday beauty work well too. Watch out for self-criticism through comparison — focusing on your own expression, not others\' work, is the true leisure of the 4.', ja: '感情を表現し、意味を探求する活動で深い満足を得ます。映画·音楽·美術で共鳴する瞬間を見つけて日記に書き留めましょう。日常の美しさを捉える写真散策も良いです。ただし、比較による自己批判に注意 — 他者の作品ではなく自分だけの表現に集中することが4タイプの真の余暇です。', zh: '从表达情感和探索意义的活动中获得深刻满足。在电影、音乐和艺术中找到共鸣的时刻并记录在日记中。捕捉日常之美的摄影散步也很好。注意通过比较产生的自我批评——专注于自己的表达而非他人的作品，才是4号真正的休闲。', fr: 'La satisfaction profonde vient de l\'expression émotionnelle et de l\'exploration du sens. Trouvez des moments de résonance dans le cinéma, la musique, l\'art — notez-les dans un journal. Les balades photo pour capturer la beauté quotidienne conviennent aussi. Méfiez-vous de l\'autocritique par comparaison — se concentrer sur sa propre expression est le vrai loisir du 4.', es: 'La satisfacción profunda viene de expresar emociones y explorar el significado. Encuentra momentos de resonancia en cine, música y arte — escríbelos en un diario. Los paseos fotográficos para capturar la belleza cotidiana también funcionan. Cuida la autocrítica por comparación — enfocarte en tu propia expresión, no en el trabajo de otros, es el verdadero ocio del 4.' },
    avoid: { ko: '획일적인 집단 활동, 자신의 감정을 억제해야 하는 환경', en: 'Uniform group activities, environments that suppress personal emotion', ja: '画一的な集団活動、自分の感情を抑制しなければならない環境', zh: '千篇一律的集体活动，必须压抑个人情感的环境', fr: 'Activités de groupe uniformes, environnements qui répriment l\'émotion personnelle', es: 'Actividades grupales uniformes, entornos que suprimen la emoción personal' },
  },
  {
    num: 5, name: { ko: '탐구자', en: 'The Investigator', ja: '調査者', zh: '调查者', fr: "L'Enquêteur", es: 'El Investigador' },
    core: { ko: '지식과 이해를 통해 세상을 파악하려는 관찰자', en: 'The observer who grasps the world through knowledge and understanding', ja: '知識と理解を通じて世界を把握しようとする観察者', zh: '通过知识和理解来把握世界的观察者', fr: "L'observateur qui saisit le monde à travers la connaissance", es: 'El observador que comprende el mundo a través del conocimiento' },
    color: 'border-sky-300 bg-sky-50',
    hobbies: [
