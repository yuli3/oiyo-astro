    <div class="mb-8 text-center">
      <h1 class="text-3xl font-black text-slate-900">
        {txt({ ko: '에니어그램 유형별 추천 취미·여가', en: 'Enneagram Hobbies & Leisure Guide', ja: 'エニアグラムタイプ別趣味·余暇', zh: '九型人格推荐兴趣与休闲', fr: 'Guide Loisirs & Hobbies Ennéagramme', es: 'Guía de Hobbies y Ocio por Eneagrama' })}
      </h1>
      <p class="mt-2 text-slate-500 max-w-xl mx-auto">
        {txt({ ko: '핵심 동기에 맞는 취미를 선택하면 진정한 회복과 성장을 경험할 수 있습니다.', en: 'Choosing hobbies aligned with your core motivations enables genuine recovery and growth.', ja: '核心的な動機に合った趣味を選ぶと真の回復と成長を体験できます。', zh: '选择符合核心动机的兴趣，体验真正的恢复与成长。', fr: 'Choisir des hobbies alignés avec vos motivations profondes permet une vraie récupération et croissance.', es: 'Elegir hobbies alineados con tus motivaciones centrales permite la recuperación y el crecimiento genuinos.' })}
      </p>
    </div>

    <div class="space-y-6">
      {TYPES.map(({ num, name, core, color, hobbies, leisure, avoid }) => (
        <div class={`rounded-2xl border-2 p-5 ${color}`}>
          <div class="flex items-center gap-3 mb-4">
            <span class="rounded-xl bg-white/70 px-3 py-1 font-mono text-lg font-black text-slate-800">
              {num}. {name[locale] ?? name.en}
            </span>
            <span class="text-xs text-slate-500">{core[locale] ?? core.en}</span>
          </div>

          <div class="mb-4">
            <p class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">✦ {labelHobbies}</p>
            <ul class="space-y-1">
              {hobbies.map((h) => (
                <li class="flex items-start gap-2 text-sm text-slate-800">
                  <span class="mt-0.5 text-slate-400">·</span>
                  {h[locale] ?? h.en}
                </li>
              ))}
            </ul>
          </div>

          <div class="mb-3 rounded-xl bg-white/60 p-3">
            <p class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">◉ {labelLeisure}</p>
            <p class="text-sm leading-relaxed text-slate-700">{leisure[locale] ?? leisure.en}</p>
          </div>

          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">✕ {labelAvoid}</p>
            <p class="text-sm italic text-slate-500">{avoid[locale] ?? avoid.en}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a href={localePath(locale, '/enneagram/test')} class="inline-flex items-center gap-2 rounded-xl border-2 border-indigo-700 bg-indigo-700 px-6 py-3 font-bold text-white transition hover:bg-indigo-800">
        {txt({ ko: '내 에니어그램 유형 테스트하기', en: 'Take the Enneagram Test', ja: 'エニアグラムテストを受ける', zh: '做九型人格测试', fr: 'Passer le test Ennéagramme', es: 'Hacer el test Eneagrama' })} →
      </a>
    </div>
    <RelatedTools locale={locale} tools={['enneagram', 'mbti', 'big5', 'attachment']} current="enneagram-hobbies" />

    <section class="mt-8 border-t border-indigo-100 pt-8">
      <h2 class="text-2xl font-bold text-slate-950">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.conceptTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.concepts.map((item) => (
          <article class="rounded-xl border border-indigo-100 bg-white p-4">
            <h3 class="font-semibold text-slate-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.useTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.useCases.map((item) => (
          <article class="rounded-xl bg-indigo-50 p-4">
            <h3 class="font-semibold text-slate-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-indigo-100 rounded-xl border border-indigo-100 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-950">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.readingTitle}</h2>
      <div class="mt-4 grid gap-3 md:grid-cols-3">
        {c.reading.map((item) => (
          <a class="rounded-xl border border-indigo-100 bg-white p-4 transition-colors hover:border-indigo-300 hover:bg-indigo-50" href={item.href} rel="noopener noreferrer" target="_blank">
            <span class="font-semibold text-slate-950">{item.label}</span>
            <span class="mt-2 block text-sm leading-6 text-slate-700">{item.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">
      {c.disclaimer}
    </p>
      <MentalBoost locale={locale} />
  </main>
</Layout>
