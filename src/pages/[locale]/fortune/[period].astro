const c = content[locale] ?? content.en;
const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: m.title,
  description: m.description,
  url: canonicalUrl,
  inLanguage: locale,
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Web',
  isAccessibleForFree: true,
};
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
const howToJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: c.howToTitle,
  description: c.intro,
  step: c.howToSteps.map((step, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    text: step,
  })),
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'OIYO', item: new URL(`/${locale}/`, Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: PLABEL[period][locale] ?? PLABEL[period].en, item: canonicalUrl },
  ],
};
---

<Layout title={m.title} description={m.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(webAppJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <div class="mx-auto max-w-3xl px-4 py-10">
    <div class="mb-6 text-center">
      <p class="text-xs font-black uppercase tracking-[0.24em] text-green-700">Periodic Fortune</p>
      <h1 class="mt-2 text-3xl font-black text-green-950">{m.h1}</h1>
      <p class="mt-2 text-sm text-muted-foreground">{m.sub}</p>
    </div>

    <nav class="mb-6 flex justify-center gap-2">
      {PERIODS.map((p) => (
        <a href={`/${locale}/fortune/${p}`}
           class={`rounded-full px-4 py-1.5 text-sm font-bold ${p === period ? 'bg-primary text-primary-foreground' : 'border bg-card hover:bg-accent'}`}>
          {PLABEL[p][locale] ?? PLABEL[p].en}
        </a>
      ))}
    </nav>

    <section class="rounded-3xl border border-green-100 bg-white p-5 shadow-sm">
      <PeriodicFortune client:load locale={locale} period={period} />
    </section>

    <section class="mt-6 rounded-3xl border border-green-100 bg-white p-5 shadow-sm">
      <GenerationCompare client:visible locale={locale} period={period} />
    </section>

    <section class="mt-8 rounded-3xl border border-green-100 bg-green-50/60 p-5">
      <h2 class="text-xl font-black text-green-950">{c.introTitle}</h2>
      <p class="mt-3 text-sm leading-7 text-green-900/80">{c.intro}</p>
      <div class="mt-4 rounded-2xl bg-white p-4 text-sm leading-7 text-green-900 shadow-sm">
        <strong>{c.freshnessTitle}</strong>
        <span class="ml-1">{c.freshness}</span>
      </div>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-black text-green-950">{c.conceptTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.concepts.map((item) => (
          <div class="rounded-2xl border border-green-100 bg-white p-4 shadow-sm">
            <h3 class="text-sm font-black text-green-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-black text-green-950">{c.useTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.useCases.map((item) => (
          <div class="rounded-2xl bg-slate-50 p-4">
            <h3 class="text-sm font-black text-slate-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-black text-green-950">{c.howToTitle}</h2>
      <ol class="mt-4 grid gap-3">
        {c.howToSteps.map((step, index) => (
          <li class="flex gap-3 rounded-2xl border border-green-100 bg-white p-4 text-sm leading-6 text-slate-700">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green-700 text-xs font-black text-white">{index + 1}</span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-black text-green-950">{c.faqTitle}</h2>
      <div class="mt-4 space-y-3">
        {c.faqs.map((faq) => (
          <details class="rounded-2xl border border-green-100 bg-white p-4">
            <summary class="cursor-pointer text-sm font-black text-green-950">{faq.question}</summary>
            <p class="mt-3 text-sm leading-7 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-black text-green-950">{c.readingTitle}</h2>
      <div class="mt-4 grid gap-3 md:grid-cols-2">
        {c.reading.map((item) => (
          <a href={item.href} class="rounded-2xl border border-green-100 bg-white p-4 shadow-sm transition-colors hover:border-green-300 hover:bg-green-50">
            <span class="text-sm font-black text-green-950">{item.label}</span>
            <span class="mt-1 block text-sm leading-6 text-slate-700">{item.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <div class="mt-8 flex flex-wrap justify-center gap-2 border-t pt-6 text-sm">
      <a href={`/${locale}/tarot/reading/`} class="rounded-full border bg-card px-4 py-2 font-semibold hover:bg-accent">🃏 {locale === 'ko' ? '타로 리딩' : 'Tarot'}</a>
      <a href={`/${locale}/saju/today/`} class="rounded-full border bg-card px-4 py-2 font-semibold hover:bg-accent">☯️ {locale === 'ko' ? '사주 오늘' : 'Saju today'}</a>
      <a href={`/${locale}/chinese-zodiac/`} class="rounded-full border bg-card px-4 py-2 font-semibold hover:bg-accent">🐉 {locale === 'ko' ? '띠' : 'Zodiac'}</a>
      <a href={`/${locale}/profile/symbolic-compatibility/`} class="rounded-full border bg-card px-4 py-2 font-semibold hover:bg-accent">🤝 {locale === 'ko' ? '친구 궁합' : 'Friend match'}</a>
      <a href={`/${locale}/saju/calculator/`} class="rounded-full border bg-card px-4 py-2 font-semibold hover:bg-accent">🔮 {locale === 'ko' ? '사주 계산기' : 'Saju'}</a>
    </div>

    <p class="mt-5 text-center text-xs leading-6 text-slate-500">{c.disclaimer}</p>
  </div>
</Layout>
