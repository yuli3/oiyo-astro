---
import Layout from '../../layouts/Layout.astro';
import TestLaneLink from '../../components/shared/TestLaneLink.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import { introvertResultCopy } from "../../lib/introvert-result-copy";
import IntroExtroTest from '../../components/tests/IntroExtroTest';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<string, { title: string }> = {
  ko: { title: "내향/외향 스펙트럼 테스트 — 나는 어디에 있나요?" },
  en: { title: "Introvert/Extrovert Spectrum Test — Where Do I Fall?" },
  ja: { title: "内向/外向スペクトラムテスト — 私はどこにいる？" },
  fr: { title: "Test Spectre Introverti/Extraverti — Où suis-je?" },
  es: { title: "Test Espectro Introvertido/Extrovertido — ¿Dónde estoy?" },
  zh: { title: "内向/外向光谱测试 — 我在哪里？" },
};
const m = { ...meta[locale], description: introvertResultCopy[locale].metaDescription };
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <IntroExtroTest locale={locale} client:load />
  </div>
  <TestLaneLink locale={locale as Locale} path="/introvert-extrovert-test" />
</Layout>
