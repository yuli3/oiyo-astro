        "body": "Un estilo rápido o lento no es defecto; es un tempo a negociar."
      },
      {
        "title": "Ir más allá del Sol",
        "body": "Para una lectura seria, incluye Luna, Venus, Marte y Ascendente."
      }
    ],
    "faqs": [
      {
        "question": "¿Mala compatibilidad condena una relación?",
        "answer": "No. Es una herramienta simbólica de conversación. Las relaciones dependen de comunicación, respeto, timing y conducta."
      },
      {
        "question": "¿Basta el signo solar?",
        "answer": "Para una lectura ligera, sí. Para más contexto, añade Luna, Venus, Marte y Ascendente."
      },
      {
        "question": "¿Qué es compatibilidad de elementos?",
        "answer": "Compara Fuego, Tierra, Aire y Agua para hablar de ritmo y necesidades, sin declarar elementos buenos o malos."
      }
    ],
    "reading": [
      {
        "href": "https://wiki.oiyo.net/es/meaning-of-astrology/",
        "label": "Significado de la astrología",
        "desc": "Una guía de signos y bases astrológicas."
      }
    ],
    "disclaimer": "La compatibilidad zodiacal es para entretenimiento y reflexión. No reemplaza decisiones relacionales."
  }
};

const c = content[locale] ?? content.en;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Layout title={m.title} description={m.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="mx-auto max-w-2xl px-4 py-10">
    <DailyHoroscope client:load locale={locale} />

    <section class="mt-10 border-t border-violet-100 pt-8">
      <h2 class="text-2xl font-bold text-violet-950">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-violet-800">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-violet-950">{c.conceptTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.concepts.map((item) => (
          <article class="rounded-xl border border-violet-100 bg-white p-4">
            <h3 class="font-semibold text-violet-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-violet-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-violet-950">{c.useTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.useCases.map((item) => (
          <article class="rounded-xl bg-violet-50 p-4">
            <h3 class="font-semibold text-violet-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-violet-800">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-violet-950">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-violet-100 rounded-xl border border-violet-100 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-violet-950">
              {faq.question}
            </summary>
            <p class="mt-3 text-sm leading-6 text-violet-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-violet-950">{c.readingTitle}</h2>
      <div class="mt-4 grid gap-3 md:grid-cols-2">
        {c.reading.map((item) => (
          <a class="rounded-xl border border-violet-100 bg-white p-4 transition-colors hover:border-violet-300 hover:bg-violet-50" href={item.href} rel="noopener noreferrer" target="_blank">
            <span class="font-semibold text-violet-950">{item.label}</span>
            <span class="mt-2 block text-sm leading-6 text-violet-700">{item.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">
      {c.disclaimer}
    </p>
      <MysticTrinity topic="zodiac" locale={locale} />
  </div>
</Layout>
