---
import Layout from '../../../layouts/Layout.astro';
import MysticTrinity from '../../../components/shared/MysticTrinity.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import DailyHoroscope from '../../../components/tools/DailyHoroscope';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: '별자리 오늘의 운세 — 12별자리 오늘 운세 보기',
    description: '오늘 나의 별자리 운세를 확인하세요. 전체운·애정운·재물운·건강운을 매일 새롭게 제공합니다.',
  },
  en: {
    title: 'Daily Horoscope — Today\'s Fortune for All 12 Signs',
    description: 'Check your zodiac sign\'s daily fortune. Overall, love, money and health readings updated every day.',
  },
  ja: {
    title: '星座今日の運勢 — 12星座の今日の運勢',
    description: '今日の星座運勢を確認しましょう。全体運・恋愛運・金運・健康運を毎日更新。',
  },
  zh: {
    title: '星座今日运势 — 12星座每日运程',
    description: '查看你的星座今日运势，全面运势、爱情运、财运、健康运每天更新。',
  },
  fr: {
    title: 'Horoscope du Jour — Fortune Quotidienne pour les 12 Signes',
    description: 'Consultez votre horoscope du jour. Chance générale, amour, argent et santé mis à jour chaque jour.',
  },
  es: {
    title: 'Horóscopo de Hoy — Fortuna Diaria para los 12 Signos',
    description: 'Consulta tu horóscopo diario. Suerte general, amor, dinero y salud actualizados cada día.',
  },
};

const m = meta[locale] ?? meta.en;

const content: Record<Locale, {
  introTitle: string;
  intro: string;
  conceptTitle: string;
  concepts: { title: string; body: string }[];
  useTitle: string;
  useCases: { title: string; body: string }[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  readingTitle: string;
  reading: { href: string; label: string; desc: string }[];
  disclaimer: string;
}> = {
  "ko": {
    "faqTitle": "자주 묻는 질문",
    "readingTitle": "더 깊게 읽기",
    "introTitle": "별자리 운세는 하루를 단정하지 않고 태양 별자리의 상징으로 마음가짐을 점검합니다",
    "intro": "데일리 별자리 운세는 태양 별자리를 기준으로 오늘의 분위기와 주의할 태도를 상징적으로 제안합니다. 태양 별자리는 전체 출생차트의 일부일 뿐이므로, 결과를 확정된 예언보다 가벼운 자기 점검으로 받아들이는 것이 좋습니다.",
    "conceptTitle": "오늘의 별자리 운세에서 보는 것",
    "concepts": [
      {
        "title": "태양 별자리",
        "body": "일반적으로 말하는 내 별자리. 오늘의 메시지는 이 기준에서 간단히 읽습니다."
      },
      {
        "title": "행성 분위기",
        "body": "점성술의 하루 흐름을 상징적으로 요약해 감정과 선택의 힌트로 씁니다."
      },
      {
        "title": "해석의 한계",
        "body": "같은 별자리라도 출생차트가 다르면 체감은 달라집니다."
      }
    ],
    "useTitle": "운세를 활용하는 법",
    "useCases": [
      {
        "title": "오늘의 키워드 고르기",
        "body": "결과에서 마음에 걸리는 단어 하나를 골라 하루의 관찰 포인트로 삼습니다."
      },
      {
        "title": "결정은 현실 정보로",
        "body": "운세는 기분과 태도 점검에 쓰고, 중요한 결정은 사실과 조언을 함께 보세요."
      },
      {
        "title": "반복해서 기록하기",
