  },
  "en": {
    "faqTitle": "Frequently asked questions",
    "readingTitle": "Read more",
    "introTitle": "Daily horoscope checks the mood through Sun-sign symbols; it does not decide your day",
    "intro": "A daily horoscope offers a symbolic note for today’s mood and attitude based on your Sun sign. Because the Sun sign is only one part of a natal chart, read the result as a light self-check rather than a fixed prediction.",
    "conceptTitle": "What a daily horoscope reads",
    "concepts": [
      {
        "title": "Sun sign",
        "body": "The familiar star sign. Daily horoscope messages usually begin from this simple layer."
      },
      {
        "title": "Planetary weather",
        "body": "A symbolic summary of the day’s astrological tone, used as a cue for attention."
      },
      {
        "title": "Personal variation",
        "body": "Two people of the same sign can experience the day differently because full charts differ."
      }
    ],
    "useTitle": "How to use the forecast",
    "useCases": [
      {
        "title": "Pick one keyword",
        "body": "Choose one word from the result as today’s observation point."
      },
