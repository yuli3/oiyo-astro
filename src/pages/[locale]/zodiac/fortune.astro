  inLanguage: locale,
  isAccessibleForFree: true,
  publisher: { '@id': 'https://oiyo.net/#organization' },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

// 별자리별 섹션. 데이터는 ZodiacPersonality 의 ZODIAC 하나만 쓴다(사본 금지).
// 제목을 "{별자리} 오늘의 운세" 로 두는 이유: blog /ja/tool-daily-horoscope 의 GSC 질의를
// 보면 클릭이 나는 것은 머리말 "運勢"(41위)가 아니라 "射手座運勢 今日"(15위) 같은
// 별자리별 롱테일이었다. 그 질의 모양에 제목을 맞춘다.
const SIGN_ORDER = ["aries", "taurus", "gemini", "cancer", "leo", "virgo", "libra", "scorpio", "sagittarius", "capricorn", "aquarius", "pisces"] as const;
const SIGN_COPY = {"ko": {"h": "{n} 오늘의 운세", "sec": "별자리별 오늘의 운세", "range": "기간", "ruler": "지배 행성", "el": "원소", "up": "오늘 살릴 힘", "down": "오늘 조심할 것", "note": "매일 바뀌는 점수와 메시지는 위 도구에서 확인하세요. 아래는 별자리마다 오늘의 흐름을 읽을 때 기준이 되는 성질입니다."}, "en": {"h": "{n} horoscope today", "sec": "Today by zodiac sign", "range": "Dates", "ruler": "Ruling planet", "el": "Element", "up": "Lean on today", "down": "Watch for today", "note": "The daily score and message come from the tool above. Below is the standing character each sign reads today's flow against."}, "ja": {"h": "{n}の今日の運勢", "sec": "星座別・今日の運勢", "range": "期間", "ruler": "守護星", "el": "エレメント", "up": "今日活かす力", "down": "今日気をつけること", "note": "毎日変わるスコアとメッセージは上のツールで確認できます。以下は各星座が今日の流れを読むときの基準となる性質です。"}, "zh": {"h": "{n}今日运势", "sec": "十二星座今日运势", "range": "日期", "ruler": "守护星", "el": "元素", "up": "今天可以发挥的", "down": "今天需要留意的", "note": "每日变化的分数与讯息请在上方工具查看。以下是各星座解读今日流势时的基本性格。"}, "fr": {"h": "Horoscope du jour : {n}", "sec": "Aujourd’hui par signe", "range": "Dates", "ruler": "Planète maîtresse", "el": "Élément", "up": "À mobiliser aujourd’hui", "down": "À surveiller aujourd’hui", "note": "Le score et le message du jour viennent de l'outil ci-dessus. Voici le caractère de fond avec lequel chaque signe lit la journée."}, "es": {"h": "Horóscopo de hoy: {n}", "sec": "Hoy por signo", "range": "Fechas", "ruler": "Planeta regente", "el": "Elemento", "up": "Para apoyarte hoy", "down": "Para vigilar hoy", "note": "La puntuación y el mensaje del día salen de la herramienta de arriba. Debajo está el carácter de fondo con el que cada signo lee la jornada."}} as const;
const sc = SIGN_COPY[locale] ?? SIGN_COPY.en;
const signs = SIGN_ORDER.map((key) => {
  const z = ZODIAC[key];
  return {
    key,
    emoji: z.emoji,
    name: z.name[locale] ?? z.name.en,
    range: z.dateRange[locale] ?? z.dateRange.en,
    ruler: z.ruler[locale] ?? z.ruler.en,
    element: ELEMENT_LABEL[z.element][locale] ?? ELEMENT_LABEL[z.element].en,
    description: z.description[locale] ?? z.description.en,
    strengths: z.strengths[locale] ?? z.strengths.en,
    weaknesses: z.weaknesses[locale] ?? z.weaknesses.en,
  };
});

---

<Layout title={m.title} description={m.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify([webApplicationJsonLd, faqJsonLd])} />
  <div class="mx-auto max-w-2xl px-4 py-10">
    <DailyHoroscope client:load locale={locale} />

    <section class="mt-8 rounded-xl border border-green-100 bg-white p-4">
      <h2 class="text-lg font-bold text-green-950">{periodHeading[locale] ?? periodHeading.en}</h2>
      <p class="mt-2 text-sm leading-6 text-green-700">{periodDescription[locale] ?? periodDescription.en}</p>
      <div class="mt-4 flex flex-wrap gap-2">
        {PERIODS.map((p) => (
          <a href={`/${locale}/zodiac/${p}/`} class="rounded-full border border-green-100 px-4 py-2 text-sm font-bold text-green-900 transition-colors hover:border-green-300 hover:bg-green-50">
            {periodName(p, locale)}
          </a>
        ))}
      </div>
    </section>

    <section class="mt-10 border-t border-green-100 pt-8">
      <h2 class="text-2xl font-bold text-green-950">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-green-800">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-green-950">{c.conceptTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.concepts.map((item) => (
          <article class="rounded-xl border border-green-100 bg-white p-4">
            <h3 class="font-semibold text-green-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-green-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-green-950">{c.useTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.useCases.map((item) => (
          <article class="rounded-xl bg-green-50 p-4">
            <h3 class="font-semibold text-green-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-green-800">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-green-950">{sc.sec}</h2>
      <p class="mt-3 text-sm leading-7 text-green-700">{sc.note}</p>
      <div class="mt-5 space-y-4">
        {signs.map((s) => (
          <article id={s.key} class="rounded-xl border border-green-100 bg-white p-4">
            <h3 class="font-bold text-green-950">{s.emoji} {sc.h.replace('{n}', s.name)}</h3>
            <dl class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-green-700">
              <div><dt class="inline font-semibold">{sc.range}</dt> <dd class="inline">{s.range}</dd></div>
              <div><dt class="inline font-semibold">{sc.ruler}</dt> <dd class="inline">{s.ruler}</dd></div>
              <div><dt class="inline font-semibold">{sc.el}</dt> <dd class="inline">{s.element}</dd></div>
            </dl>
            <p class="mt-3 text-sm leading-7 text-green-800">{s.description}</p>
            <div class="mt-3 grid gap-2 sm:grid-cols-2">
              <p class="text-sm leading-6 text-green-800"><span class="font-semibold text-green-950">{sc.up}</span> — {s.strengths.join(' · ')}</p>
              <p class="text-sm leading-6 text-amber-800"><span class="font-semibold">{sc.down}</span> — {s.weaknesses.join(' · ')}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-green-950">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-green-100 rounded-xl border border-green-100 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-green-950">
              {faq.question}
            </summary>
            <p class="mt-3 text-sm leading-6 text-green-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-green-950">{c.readingTitle}</h2>
      <div class="mt-4 grid gap-3 md:grid-cols-2">
        {c.reading.map((item) => (
          <a class="rounded-xl border border-green-100 bg-white p-4 transition-colors hover:border-green-300 hover:bg-green-50" href={item.href} rel="noopener noreferrer" target="_blank">
            <span class="font-semibold text-green-950">{item.label}</span>
            <span class="mt-2 block text-sm leading-6 text-green-700">{item.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">
      {c.disclaimer}
    </p>
      <MysticTrinity topic="zodiac" locale={locale} />
  </div>
</Layout>
