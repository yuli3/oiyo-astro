  "en": {
    "faqTitle": "Frequently asked questions",
    "readingTitle": "Read more",
    "introTitle": "Zodiac compatibility is a language for elements and rhythm, not a label for relationships",
    "intro": "Zodiac compatibility compares two Sun signs through elements, modalities, and symbolic temperament. Use it to ask how two people approach closeness, pace, conflict, and comfort rather than to sort relationships into good and bad.",
    "conceptTitle": "Core compatibility ideas",
    "concepts": [
      {
        "title": "Four elements",
        "body": "Fire, Earth, Air, and Water suggest pace, steadiness, communication style, and emotional flow."
