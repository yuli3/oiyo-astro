    "useCases": [
      {
        "title": "Preguntar por el lenguaje",
        "body": "Cambia “¿por qué eres así?” por “¿qué te resulta fácil o pesado?”."
      },
      {
        "title": "Leer conflicto como ritmo",
        "body": "Un estilo rápido o lento no es defecto; es un tempo a negociar."
      },
