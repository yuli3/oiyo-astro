---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import WorkaholicTest from '../../components/tests/WorkaholicTest';
import TestSourceNote from '../../components/shared/TestSourceNote.astro';
import PrintReportButton from '../../components/shared/PrintReportButton.astro';
import { TEST_SOURCE_NOTES } from '../../data/test-source-notes';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<string, { title: string; description: string }> = {
  ko: {
    title: "워커홀릭(일중독) 자가진단 — 나의 일중독 지수는?",
    description: "버겐 일중독 척도(BWAS) 기준 14문항 자가진단. 일에 대한 강박적 몰입, 내성 및 금단 증상, 일과 삶의 균형 침범 7대 요인을 정밀 평가하여 정상·경계·고위험 3단계 상태와 맞춤형 회복 가이드를 즉시 확인해 보세요.",
  },
  en: {
    title: "Workaholism Self-Test — How Addicted to Work Are You?",
    description: "Free workaholism test based on the BWAS scale. Evaluate 7 core addiction factors in 14 questions to find your work-life risk level and healthy balance guide.",
  },
  ja: {
    title: "ワーカホリック自己診断 — あなたの仕事依存度は？",
    description: "バーゲン仕事中毒尺度（BWAS）に基づく14問の自己診断。強迫的な没頭、耐性や離脱症状、ワークライフバランス侵食など7大要因を測定し、正常・境界・高リスクの3段階評価と回復ガイドを確認しましょう。",
  },
  fr: {
    title: "Test de Workaholisme — Êtes-vous accro au travail ?",
    description: "Test de workaholisme basé sur l'échelle de Bergen (BWAS). Évaluez 7 facteurs d'addiction en 14 questions pour mesurer votre risque et retrouver l'équilibre.",
  },
  es: {
    title: "Test de Adicción al Trabajo — ¿Cuán adicto al trabajo eres?",
    description: "Test de adicción al trabajo basado en la escala BWAS. Evalúa 7 factores clave en 14 preguntas para conocer tu nivel de riesgo y recuperar el equilibrio vital.",
  },
  zh: {
    title: "工作狂自测 — 你的工作成瘾指数有多高？",
    description: "基于卑尔根工作成瘾量表（BWAS）的14题专业自测。系统评估强迫投入、耐受戒断与生活界限侵蚀等7大核心维度，精确诊断正常·临界·高风险3个等级，并获取适合您的身心平衡恢复指引。",
  },
};
const m = meta[locale] ?? meta.en ?? Object.values(meta)[0];
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <WorkaholicTest locale={locale as any} client:load />
  <PrintReportButton locale={locale} />
  <TestSourceNote locale={locale} note={TEST_SOURCE_NOTES['workaholic']} />
  </div>
</Layout>
