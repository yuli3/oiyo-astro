---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import DismissalNoticePayGuardComponent from '../../components/tools/DismissalNoticePayGuard';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "해고예고수당(30일분 통상임금) 계산기 & 5인 이상 부당해고 구제 진단기",
    description: "근로기준법 제26조에 따른 30일 전 미예고 해고예고수당 산출(5인 미만 사업장 포함), 3개월 미만 예외 판정 및 제27조 문자·카카오톡 해고 무효성, 노동위원회 구제신청 자격을 실시간 진단합니다.",
  },
  en: {
    title: "Korea 30-Day Dismissal Notice Pay Calculator & Unfair Dismissal Claim Guard",
    description: "Calculate 30-day statutory advance notice wage under Korean Labor Standards Act Art. 26 (including workplaces under 5 staff) and audit unfair dismissal remedy qualifications.",
  },
  ja: {
    title: "韓国 解雇予告手当(30日分通常賃金)計算機＆不当解雇救済申請診断機",
    description: "韓国勤労基準法第26条に基づく解雇予告手当(5人未満事業場を含む)、3ヶ月未満除外判定および第27条に基づく書面通知義務違反(LINE・カカオトーク解雇の無効)を即時診断します。",
  },
  zh: {
    title: "韩国解除劳动合同预告津贴(30日通常工资)计算器与不当解雇维权诊断器",
    description: "测算韩国劳动基准法第26条未提前30日通知解雇预告津贴(含5人以下单位)、满3个月法定除外核查及微信短信口头解雇无效认定与劳动委员会维权救济资格。",
  },
  fr: {
    title: "Calculateur d'Indemnité de Préavis de Licenciement en Corée — Recours Légaux",
    description: "Calculez l'indemnité légale de 30 jours de salaire ordinaire pour défaut de préavis de licenciement en Corée et vérifiez la nullité des renvois par SMS ou messagerie.",
  },
  es: {
    title: "Calculadora de Indemnización por Falta de Preaviso de Despido en Corea",
    description: "Calcula los 30 días de salario ordinario por despido sin preaviso según la ley laboral de Corea y comprueba la nulidad del despido por mensaje o verbal.",
  },
};

const currentMeta = meta[locale] ?? meta.ko;
---

<Layout
  title={currentMeta.title}
  description={currentMeta.description}
  locale={locale}
>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto mb-8 text-center">
      <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary mb-3">
        <span>{locale === 'ko' ? '근로기준법 2026' : 'Labor Standards Act 2026'}</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl text-foreground">
        {currentMeta.title.split('—')[0]}
      </h1>
      <p class="mt-3 text-base text-muted-foreground sm:text-lg">
        {currentMeta.description}
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <DismissalNoticePayGuardComponent client:load locale={locale} />
    </div>

    {/* Hub-and-Spoke Context / FAQ */}
    <section class="max-w-4xl mx-auto mt-8 rounded-xl border border-border bg-card p-6 space-y-4 text-sm text-muted-foreground">
      <h2 class="text-lg font-bold text-foreground">
        {locale === 'ko' ? '자주 묻는 해고 및 수당 노동법률 Q&A' : 'Frequently Asked Questions'}
      </h2>

      <div class="space-y-3">
        <div>
          <h3 class="font-semibold text-foreground">
            {locale === 'ko' ? 'Q1. 5인 미만 사업장에서도 해고예고수당을 받을 수 있나요?' : 'Q1. Can I receive dismissal notice pay in workplaces with under 5 employees?'}
          </h3>
          <p class="mt-1">
            {locale === 'ko'
              ? '네, 100% 동일하게 받을 수 있습니다. 근로기준법 제26조(해고의 예고)는 상시 근로자 수와 상관없이 1인 이상 모든 사업장에 전면 적용됩니다. 따라서 3개월 이상 근무한 근로자에게 30일 전 예고 없이 즉시 해고를 통보했다면, 5인 미만 사업장이라도 30일분의 통상임금을 반드시 지급해야 합니다.'
              : 'Yes. Article 26 of the Labor Standards Act applies universally to all employers including those with fewer than 5 staff. Any worker with >=3 months tenure dismissed without 30 days notice is legally entitled to 30 days ordinary wage.'}
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-foreground">
            {locale === 'ko' ? 'Q2. 사장이 카카오톡이나 문자로 해고를 통보했습니다. 법적으로 유효한가요?' : 'Q2. Is it lawful if my boss fires me via KakaoTalk or text message?'}
          </h3>
          <p class="mt-1">
            {locale === 'ko'
              ? '5인 이상 사업장에서는 무효입니다. 근로기준법 제27조에 따라 해고는 반드시 사유와 시기를 기재한 "서면(종이 문서 또는 전자서명된 전자문서)"으로 통지해야만 효력이 있습니다. 문자 메시지나 카톡, 구두 통보는 서면통지의무 위반으로 부당해고 판정(대법원 판례)을 받으며, 해고 기간의 급여를 소급하여 전액 청구할 수 있습니다.'
              : 'In workplaces with 5+ staff, text or verbal dismissal is strictly void under Article 27. The employer must issue written notice, failing which the dismissal is invalid and full backpay is ordered.'}
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-foreground">
            {locale === 'ko' ? 'Q3. 부당해고 구제신청은 언제까지 해야 하나요?' : 'Q3. What is the deadline to file an unfair dismissal claim?'}
          </h3>
          <p class="mt-1">
            {locale === 'ko'
              ? '해고가 발생한 날로부터 반드시 "3개월 이내"에 사업장 관할 지방노동위원회에 접수해야 합니다. 3개월이 단 하루라도 지나면 제척기간 도과로 구제신청이 각하되므로 지체 없이 노동위원회에 신청해야 합니다.'
              : 'You must file with the local Labor Relations Commission strictly within 3 months from the effective date of dismissal.'}
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
