---
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '../../i18n';
import type { Locale } from '../../i18n';
import RelationshipBoredomTest from '../../components/tests/RelationshipBoredomTest';
import BlogArticleLink from '../../components/shared/BlogArticleLink.astro';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta: Record<string, { title: string; description: string }> = {
  ko: {
    title: "연애 권태기 테스트 — 우리 관계, 지금 어디쯤일까?",
    description: "관계 권태 연구 기반 — 14문항으로 정서적 거리감과 설렘 권태를 측정해 우리 관계의 현재를 점검하세요.",
  },
  en: {
    title: "Relationship Boredom Test — Where Is Your Relationship Right Now?",
    description: "Based on relationship boredom research — measure emotional distance and lost spark with 14 questions to check the state of your relationship.",
  },
  ja: {
    title: "恋愛倦怠期テスト — 今、二人の関係はどのあたり？",
    description: "関係倦怠の研究に基づく — 14の設問で情緒的距離とときめき喪失を測定し、二人の関係の現在を点検しましょう。",
  },
  fr: {
    title: "Test d'Ennui Amoureux — Où en est votre relation aujourd'hui ?",
    description: "Basé sur la recherche sur l'ennui relationnel — mesurez la distance émotionnelle et la perte d'étincelle en 14 questions.",
  },
  es: {
    title: "Test de Aburrimiento en la Relación — ¿Cómo está tu relación ahora mismo?",
    description: "Basado en la investigación sobre el aburrimiento en pareja — mide la distancia emocional y la pérdida de chispa con 14 preguntas.",
  },
  zh: {
    title: "恋爱倦怠期测试 — 你们的关系现在处于什么阶段？",
    description: "基于关系倦怠研究 — 用14个问题测量情感距离与心动流失，检视你们关系的现状。",
  },
};
const m = meta[locale] ?? meta.en ?? Object.values(meta)[0];
---

<Layout title={m.title} description={m.description} locale={locale}>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <RelationshipBoredomTest locale={locale as any} client:load />
    <BlogArticleLink testId="relationship-boredom-test" locale={locale} />
  </div>
</Layout>
