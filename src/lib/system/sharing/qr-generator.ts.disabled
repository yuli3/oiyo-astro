/**
 * QR Code Generator
 * Generates QR codes for result sharing with branding
 */

import QRCode from 'qrcode';
import type { QRCodeOptions } from './types';

/**
 * Generate QR code as data URL
 */
export async function generateQRCode(
  url: string,
  options?: QRCodeOptions
): Promise<string> {
  try {
    const qrOptions = {
      width: options?.size || 200,
      margin: options?.margin || 2,
      errorCorrectionLevel: options?.errorCorrectionLevel || 'M',
      color: {
        dark: options?.color?.dark || '#000000',
        light: options?.color?.light || '#FFFFFF',
      },
    };

    const dataUrl = await QRCode.toDataURL(url, qrOptions);
    return dataUrl;
  } catch (error) {
    console.error('QR Code generation failed:', error);
    throw new Error('Failed to generate QR code');
  }
}

/**
 * Generate QR code with OIYO branding overlay
 */
export async function generateBrandedQRCode(
  url: string,
  options?: QRCodeOptions
): Promise<string> {
  try {
    // Generate base QR code
    const qrDataUrl = await generateQRCode(url, options);

    // Create canvas for branding
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    if (!ctx) throw new Error('Canvas context not available');

    const size = options?.size || 200;
    canvas.width = size;
    canvas.height = size + 40; // Extra space for label

    // Draw QR code
    const qrImage = new Image();
    qrImage.src = qrDataUrl;
    await new Promise((resolve) => {
      qrImage.onload = resolve;
    });
    ctx.drawImage(qrImage, 0, 0, size, size);

    // Add "Scan to take test" label
    ctx.fillStyle = '#000000';
    ctx.font = 'bold 14px system-ui';
    ctx.textAlign = 'center';
    ctx.fillText('나도 테스트하기', size / 2, size + 25);

    return canvas.toDataURL('image/png');
  } catch (error) {
    console.error('Branded QR Code generation failed:', error);
    // Fallback to basic QR code
    return generateQRCode(url, options);
  }
}

/**
 * Generate QR code for embedding in result images
 */
export async function generateEmbeddedQRCode(
  url: string,
  themeColor: string = '#FF6B35'
): Promise<string> {
  const options: QRCodeOptions = {
    size: 150,
    margin: 1,
    errorCorrectionLevel: 'H', // High error correction for better scan reliability
    color: {
      dark: themeColor,
      light: '#FFFFFF',
    },
  };

  return generateBrandedQRCode(url, options);
}

/**
 * Validate URL before QR generation
 */
export function validateQRUrl(url: string): boolean {
  try {
    const urlObj = new URL(url);
    return urlObj.protocol === 'http:' || urlObj.protocol === 'https:';
  } catch {
    return false;
  }
}
