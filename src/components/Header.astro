---
import { FAMILY_SITES, familySiteHref, familySiteTag } from '../config/navigation';
import type { Locale } from '../i18n';
import { getTranslations, LOCALES, LOCALE_LABELS, localePath } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await getTranslations(locale);
// Strip only a real locale prefix (not e.g. "kn" in /knowledge/).
const LOCALE_PREFIX = /^\/(?:en|ko|ja|zh|fr|es)(?=\/|$)/;
const isLocalized = LOCALE_PREFIX.test(Astro.url.pathname);
// Locale-less pages (e.g. /knowledge) have no per-locale equivalent → switch to locale home.
const currentPath = isLocalized ? Astro.url.pathname.replace(LOCALE_PREFIX, '') || '/' : '/';

// NAV_AT_EVERY_WIDTH — why the menu button and nav panel below carry no
// md:hidden. The product's design rules make mobile-only a constitution and
// forbid a desktop-only navigation, so this one menu is the nav at every
// width. Until 2026-08-18 both the button and the panel were hidden from md
// up, which left desktop visitors with no links in the header at all.
// (Frontmatter, not an HTML comment: Astro ships HTML comments to every page.)
---

<header class="sticky top-0 z-50 border-b border-border bg-background">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between gap-4">
    <!-- Logo -->
    <a href={localePath(locale, '/')} class="flex items-center gap-2 tracking-tight text-foreground hover:text-primary">
      <span class="text-xl font-black">OIYO</span><span class="text-sm font-semibold lowercase tracking-wide text-primary">tests</span>
    </a>

    <!-- Nav links -->
    <!-- Locale switcher -->
    <div class="relative" id="locale-switcher">
      <button
        id="locale-btn"
        class="flex items-center gap-1.5 rounded-lg border border-border px-3 py-1.5 text-sm font-semibold text-primary hover:bg-primary/5"
        aria-haspopup="listbox"
        aria-expanded="false"
      >
        {LOCALE_LABELS[locale]}
        <svg class="w-3 h-3 opacity-60" viewBox="0 0 12 12" fill="currentColor">
          <path d="M6 8L1 3h10L6 8z"/>
        </svg>
      </button>
      <div
        id="locale-menu"
        class="hidden absolute right-0 mt-1 min-w-[120px] rounded-xl border border-border bg-background py-1 shadow-lg"
        role="listbox"
      >
        {LOCALES.map((loc) => (
          <a
            href={localePath(loc, currentPath)}
            data-locale={loc}
            class={`flex items-center gap-2 px-4 py-2 text-sm hover:bg-primary/5 ${loc === locale ? 'text-primary font-semibold' : 'text-muted-foreground'}`}
            role="option"
            aria-selected={loc === locale}
          >
            {LOCALE_LABELS[loc]}
          </a>
        ))}
      </div>
    </div>

    <!-- Menu button (see NAV_AT_EVERY_WIDTH above) -->
    <button
      id="mobile-menu-btn"
      class="rounded-lg p-2 text-primary hover:bg-primary/5"
      aria-label="Open menu"
      aria-controls="mobile-nav"
      aria-expanded="false"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>

  <!-- Nav panel (see NAV_AT_EVERY_WIDTH above) -->
  <div id="mobile-nav" class="hidden border-t border-border bg-background">
    <nav class="max-w-6xl mx-auto px-4 py-3 flex flex-col gap-1">
      <a href={localePath(locale, '/tests')} class="px-3 py-2.5 rounded-lg text-sm font-medium text-green-700 hover:bg-green-50">
        {{ ko: '테스트', en: 'Tests', ja: 'テスト', zh: '测试', fr: 'Tests', es: 'Tests' }[locale] ?? 'Tests'}
      </a>
      <a href={localePath(locale, '/ontology')} class="px-3 py-2.5 rounded-lg text-sm font-medium text-green-700 hover:bg-green-50">
        {t('nav.ontology')}
      </a>
      <a href={localePath(locale, '/about')} class="px-3 py-2.5 rounded-lg text-sm font-medium text-green-700 hover:bg-green-50">
        {t('nav.about')}
      </a>
      <a href={localePath(locale, '/faq')} class="px-3 py-2.5 rounded-lg text-sm font-medium text-green-700 hover:bg-green-50">
        FAQ
      </a>
      <div class="mt-2 pt-2 border-t border-green-50">
        <p class="px-3 pt-1 pb-1 text-[10px] font-bold uppercase tracking-widest text-green-400">Oiyo Family</p>
        {FAMILY_SITES.map((f) => (
          <a href={familySiteHref(f, locale, 'menu')}
             target="_blank" rel="noopener noreferrer"
             class="flex flex-col px-3 py-2 rounded-lg text-sm font-medium text-green-700 hover:bg-green-50">
            <span>{f.name} ↗</span>
            <span class="text-[11px] text-green-500">{familySiteTag(f, locale)}</span>
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('locale-btn');
  const menu = document.getElementById('locale-menu');
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileNav = document.getElementById('mobile-nav');
  const localeLinks = menu?.querySelectorAll<HTMLAnchorElement>('[data-locale]');

  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });

  mobileBtn?.addEventListener('click', () => {
    const open = mobileNav?.classList.toggle('hidden') === false;
    mobileBtn.setAttribute('aria-expanded', String(open));
  });

  localeLinks?.forEach((link) => {
    link.addEventListener('click', () => {
      try {
        window.localStorage.setItem('oiyo:locale', link.dataset.locale ?? '');
      } catch {
        // Ignore storage failures in private or restricted browsing modes.
      }
      // T6/#32: preserve a result permalink hash (#r=...) across locale
      // switches. Server-rendered hrefs never see the hash (browsers don't
      // send fragments to the server), so it must be appended client-side,
      // right before navigation, from whatever the hash is at click time.
      if (window.location.hash.startsWith('#r=')) {
        link.href = link.href.split('#')[0] + window.location.hash;
      }
    });
  });

  document.addEventListener('click', (e) => {
    if (!btn?.contains(e.target as Node) && !menu?.contains(e.target as Node)) {
      menu?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
