---
import { FAMILY_SITES, familySiteHref, familySiteTag } from '../config/navigation';
import type { Locale } from '../i18n';
import { getTranslations, LOCALES, LOCALE_LABELS, localePath } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await getTranslations(locale);
// Strip only a real locale prefix (not e.g. "kn" in /knowledge/).
const LOCALE_PREFIX = /^\/(?:en|ko|ja|zh|fr|es)(?=\/|$)/;
const isLocalized = LOCALE_PREFIX.test(Astro.url.pathname);
// Locale-less pages (e.g. /knowledge) have no per-locale equivalent → switch to locale home.
const currentPath = isLocalized ? Astro.url.pathname.replace(LOCALE_PREFIX, '') || '/' : '/';

// NAV_AT_EVERY_WIDTH — the menu button carries no md:hidden, so the same
// hamburger drawer is the nav at every width (family-wide convention since
// 2026-08-23: blog-style slide-in drawer, hamburger on mobile everywhere).
// Until 2026-08-18 both the button and the panel were hidden from md up,
// which left desktop visitors with no links in the header at all.

// Language switcher flags + native names (family-wide convention: flag emoji
// plus a visible text label so it is never icon-only).
const LANG_ITEMS: { code: Locale; flag: string; name: string }[] = [
  { code: 'en', flag: '🇺🇸', name: 'English' },
  { code: 'ko', flag: '🇰🇷', name: '한국어' },
  { code: 'ja', flag: '🇯🇵', name: '日本語' },
  { code: 'zh', flag: '🇨🇳', name: '中文' },
  { code: 'fr', flag: '🇫🇷', name: 'Français' },
  { code: 'es', flag: '🇪🇸', name: 'Español' },
];

const currentLangItem = LANG_ITEMS.find((item) => item.code === locale) ?? LANG_ITEMS[0];

const navLinks = [
  { href: localePath(locale, '/tests'), label: { ko: '테스트', en: 'Tests', ja: 'テスト', zh: '测试', fr: 'Tests', es: 'Tests' }[locale] ?? 'Tests' },
  { href: localePath(locale, '/fortune/today'), label: { ko: '오늘의 운세', en: "Today's fortune", ja: '今日の運勢', zh: '今日运势', fr: 'Fortune du jour', es: 'Fortuna de hoy' }[locale] ?? "Today's fortune" },
  { href: localePath(locale, '/ontology'), label: t('nav.ontology') },
  { href: localePath(locale, '/about'), label: t('nav.about') },
  { href: localePath(locale, '/faq'), label: 'FAQ' },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-background">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between gap-4">
    <!-- Logo -->
    <a href={localePath(locale, '/')} class="flex items-center gap-2 tracking-tight text-foreground hover:text-primary">
      <span class="text-xl font-black">OIYO</span><span class="text-sm font-semibold lowercase tracking-wide text-primary">tests</span>
    </a>

    <!-- Language switcher (flag + label chips, same convention as blog) -->
    <nav aria-label="Language" class="relative">
      <details id="lang-switcher" class="group">
        <summary aria-label={currentLangItem.name} title={currentLangItem.name} class="flex cursor-pointer list-none items-center gap-1 whitespace-nowrap rounded-md bg-primary/10 px-2 py-1 text-[11px] font-bold text-primary [&::-webkit-details-marker]:hidden">
          <span aria-hidden="true">{currentLangItem.flag}</span><span class="hidden sm:inline">{currentLangItem.name}</span><span aria-hidden="true">⌄</span>
        </summary>
        <div class="absolute right-0 top-full z-50 mt-2 flex min-w-[140px] flex-col gap-1 rounded-lg border border-border bg-background p-2 shadow-lg">
          {LANG_ITEMS.map(({ code, flag, name }) => (
            <a href={localePath(code, currentPath)} data-locale={code} aria-label={name} title={name} aria-current={code === locale ? 'true' : undefined} class:list={['flex items-center gap-1.5 rounded-md px-2 py-1.5 text-[11px] font-bold whitespace-nowrap', code === locale ? 'bg-primary/10 text-primary' : 'text-muted-foreground hover:text-primary hover:bg-primary/5']}>
              <span aria-hidden="true">{flag}</span><span>{name}</span>
            </a>
          ))}
        </div>
      </details>
    </nav>

    <!-- Menu button (see NAV_AT_EVERY_WIDTH above) -->
    <button
      id="menu-open"
      class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-muted-foreground hover:text-foreground hover:bg-primary/5 transition-colors"
      aria-label="Open menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>
</header>

<!-- Overlay + slide-in drawer (blog pattern) -->
<div
  id="mobile-menu-overlay"
  class="fixed inset-0 z-[60] bg-black/50 opacity-0 pointer-events-none transition-opacity duration-200"
  aria-hidden="true"
></div>

<div
  id="mobile-menu"
  role="dialog"
  aria-label="Navigation menu"
  aria-modal="true"
  class="fixed top-0 right-0 h-full w-72 max-w-[85vw] z-[70] bg-background border-l border-border shadow-2xl translate-x-full transition-transform duration-300 ease-out flex flex-col"
>
  <div class="flex items-center justify-between px-6 h-16 border-b border-border/40 shrink-0">
    <span class="font-black text-lg tracking-tighter">OIYO <span class="font-semibold lowercase text-primary">tests</span></span>
    <button
      id="menu-close"
      aria-label="Close menu"
      class="flex h-9 w-9 items-center justify-center rounded-lg text-muted-foreground hover:text-foreground hover:bg-primary/5 transition-colors"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 6l12 12M18 6L6 18"/>
      </svg>
    </button>
  </div>

  <nav aria-label="Mobile navigation" class="flex-1 overflow-y-auto px-6 py-6 space-y-1">
    {navLinks.map(({ href, label }) => (
      <a href={href} class="flex items-center h-11 px-2 rounded-lg text-sm font-bold text-green-700 hover:bg-green-50 transition-colors">{label}</a>
    ))}
    <div class="pt-2 border-t border-green-50 mt-4">
      <p class="px-2 pt-2 pb-1 text-[10px] font-bold uppercase tracking-widest text-green-400">Oiyo Family</p>
      {FAMILY_SITES.map((f) => (
        <a href={familySiteHref(f, locale, 'menu')}
           target="_blank" rel="noopener noreferrer"
           class="flex flex-col justify-center min-h-11 px-2 py-1.5 rounded-lg text-sm font-bold text-green-700 hover:bg-green-50 transition-colors">
          <span>{f.name} ↗</span>
          <span class="text-[11px] font-normal normal-case tracking-normal text-green-500">{familySiteTag(f, locale)}</span>
        </a>
      ))}
    </div>
  </nav>

  <!-- Language switcher at bottom (flag + native name) -->
  <div class="px-6 pb-6 pt-4 border-t border-border/40 shrink-0">
    <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground/50 mb-3">Language</p>
    <div class="flex flex-wrap gap-2">
      {LANG_ITEMS.map(({ code, flag, name }) => (
        <a
          href={localePath(code, currentPath)}
          data-locale={code}
          aria-label={name}
          class:list={[
            'flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-bold border transition-colors',
            code === locale ? 'bg-primary text-white border-primary' : 'border-border text-muted-foreground hover:text-primary hover:border-primary/40',
          ]}
        ><span aria-hidden="true">{flag}</span>{name}</a>
      ))}
    </div>
  </div>
</div>

<script>
  const openBtn = document.getElementById('menu-open');
  const closeBtn = document.getElementById('menu-close');
  const overlay = document.getElementById('mobile-menu-overlay');
  const drawer = document.getElementById('mobile-menu');
  const localeLinks = document.querySelectorAll<HTMLAnchorElement>('[data-locale]');
  const langSwitcher = document.getElementById('lang-switcher') as HTMLDetailsElement | null;

  function openMenu() {
    if (!drawer || !overlay || !openBtn) return;
    drawer.classList.remove('translate-x-full');
    overlay.classList.remove('opacity-0', 'pointer-events-none');
    overlay.setAttribute('aria-hidden', 'false');
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    const firstLink = drawer.querySelector('a, button');
    if (firstLink) firstLink.focus();
  }

  function closeMenu() {
    if (!drawer || !overlay || !openBtn) return;
    drawer.classList.add('translate-x-full');
    overlay.classList.add('opacity-0', 'pointer-events-none');
    overlay.setAttribute('aria-hidden', 'true');
    openBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    openBtn.focus();
  }

  openBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  localeLinks.forEach((link) => {
    link.addEventListener('click', () => {
      try {
        window.localStorage.setItem('oiyo:locale', link.dataset.locale ?? '');
      } catch {
        // Ignore storage failures in private or restricted browsing modes.
      }
      // T6/#32: preserve a result permalink hash (#r=...) across locale
      // switches. Server-rendered hrefs never see the hash (browsers don't
      // send fragments to the server), so it must be appended client-side,
      // right before navigation, from whatever the hash is at click time.
      if (window.location.hash.startsWith('#r=')) {
        link.href = link.href.split('#')[0] + window.location.hash;
      }
      if (langSwitcher) langSwitcher.open = false;
    });
  });

  document.addEventListener('click', (event) => {
    if (!langSwitcher?.open || !(event.target instanceof Node)) return;
    if (!langSwitcher.contains(event.target)) langSwitcher.open = false;
  });
</script>
