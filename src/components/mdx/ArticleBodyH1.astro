---
// 2026-09-28: 옮겨 온 글 276편이 본문을 "# 제목"으로 시작해, ArticleBody 의 제목 h1 과
// 함께 한 페이지에 h1 이 둘이 됐다(audit:single-h1 실패, 네이버 "H1 2개 이상" 진단 항목).
// 본문 파일 276개를 고치는 대신 렌더할 때 h2 로 내린다. 대개 부제 역할이라 부제처럼 보이게 한다.
const { class: className, ...rest } = Astro.props;
---
<h2 class:list={["article-body-h1", className]} {...rest}><slot /></h2>
