---
interface Props {
  data: { label: string; value: number; color?: string }[];
  title?: string;
  height?: string;
  max?: number;
}

const { data, title, max } = Astro.props;
// 2026-10-12: invalid quantities must fail a build instead of becoming plausible bars.
if (data.some(item => !Number.isFinite(item.value) || item.value < 0)) {
  throw new Error('BarChart requires finite, non-negative values');
}
const upperBound = max ?? Math.max(1, ...data.map(item => item.value));
if (!Number.isFinite(upperBound) || upperBound <= 0 || data.some(item => item.value > upperBound)) {
  throw new Error('BarChart max must be positive and include every value');
}
// Legacy height/color props remain accepted; reading and theme consistency take priority
// over fixed vertical heights and per-item palettes (2026-10-12, approved HTML seam).
---

{data.length > 0 && (
  <figure class="my-8 rounded-xl border border-border bg-muted/20 p-4 sm:p-6">
    {title && <figcaption class="mb-4 text-base font-semibold text-foreground">{title}</figcaption>}
    <p class="mb-4 text-sm tabular-nums text-muted-foreground">0 – {upperBound}</p>
    <div class="space-y-4">
      {data.map(item => (
        <div class="min-w-0">
          <div class="mb-1 flex items-start justify-between gap-3">
            <span class="min-w-0 wrap-anywhere text-sm font-medium text-foreground">{item.label}</span>
            <span class="shrink-0 text-sm font-semibold tabular-nums text-foreground">{item.value}</span>
          </div>
          <meter class="block h-4 w-full accent-primary" min="0" max={upperBound} value={item.value} aria-label={item.label}>
            {item.value}
          </meter>
        </div>
      ))}
    </div>
  </figure>
)}
