---
import type { Locale } from '../../i18n';
import type { JourneyContent } from '../../lib/ontology/journey/types';
import JourneyCourse from '../shared/JourneyCourse';

interface Props {
  locale: Locale;
  content: JourneyContent;
  /** localStorage namespace for the course tracker (#33) */
  journeyId: string;
}

const { locale, content: c, journeyId } = Astro.props;

const courseSteps = c.tools.items.map((t) => ({
  id: t.href.replace(/^\/[a-z]{2}\//, ''),
  href: t.href,
  label: `${t.emoji ?? ''} ${t.label}`.trim(),
}));

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq.items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---

<article class="mx-auto max-w-3xl px-4 pb-16">
  <!-- Hero -->
  <header class="relative overflow-hidden rounded-3xl bg-gradient-to-b from-violet-50/80 to-white px-6 pt-12 pb-8 text-center mt-6">
    <div class="absolute inset-0 pointer-events-none opacity-20" aria-hidden="true">
      <div class="absolute -top-16 left-1/2 -translate-x-1/2 w-[420px] h-[240px] bg-violet-300 rounded-full blur-3xl"></div>
    </div>
    <div class="relative z-10">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-violet-100 text-violet-700 text-xs font-bold mb-4">
        {c.badge}
      </span>
      <h1 class="text-3xl md:text-4xl font-serif font-black text-violet-950 mb-3 tracking-tight">
        {c.title}
      </h1>
      <p class="text-violet-700 text-lg leading-relaxed max-w-xl mx-auto">{c.intro}</p>
    </div>
  </header>

  <!-- 1. The question -->
  <section class="mt-10">
    <h2 class="text-xl font-black text-violet-950 mb-3">{c.question.heading}</h2>
    {c.question.body.map((p) => <p class="text-gray-700 leading-relaxed mb-3">{p}</p>)}
  </section>

  <!-- 2. Core concepts -->
  <section class="mt-10">
    <h2 class="text-xl font-black text-violet-950 mb-4">{c.concepts.heading}</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {c.concepts.items.map((it) => (
        <div class="rounded-2xl border border-violet-100 bg-violet-50/40 p-5">
          <h3 class="font-bold text-violet-900 mb-1.5">{it.title}</h3>
          <p class="text-sm text-gray-600 leading-relaxed">{it.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 3. Tools -->
  <section class="mt-10">
    <h2 class="text-xl font-black text-violet-950 mb-2">{c.tools.heading}</h2>
    <p class="text-gray-600 mb-4">{c.tools.desc}</p>
    <div class="grid gap-3 sm:grid-cols-2">
      {c.tools.items.map((t) => (
        <a
          href={t.href}
          class="group flex items-start gap-3 rounded-2xl border border-violet-200 bg-white p-4 transition-all hover:border-violet-400 hover:shadow-md"
        >
          <span class="text-2xl" aria-hidden="true">{t.emoji}</span>
          <span>
            <span class="block font-bold text-violet-950 group-hover:text-violet-700">{t.label}</span>
            {t.desc && <span class="block text-sm text-gray-500 mt-0.5">{t.desc}</span>}
          </span>
        </a>
      ))}
    </div>
    <JourneyCourse client:visible locale={locale} journey={journeyId} steps={courseSteps} />
  </section>

  <!-- 4. How to interpret -->
  <section class="mt-10">
    <h2 class="text-xl font-black text-violet-950 mb-4">{c.interpret.heading}</h2>
    <ol class="space-y-4">
      {c.interpret.steps.map((s, i) => (
        <li class="flex gap-3">
          <span class="flex-shrink-0 w-7 h-7 rounded-full bg-violet-600 text-white text-sm font-bold flex items-center justify-center" aria-hidden="true">{i + 1}</span>
          <div>
            <h3 class="font-bold text-violet-900">{s.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed mt-0.5">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- 5. Related tests -->
  <section class="mt-10">
    <h2 class="text-xl font-black text-violet-950 mb-3">{c.tests.heading}</h2>
    <div class="flex flex-wrap gap-2">
      {c.tests.items.map((t) => (
        <a
          href={t.href}
          class="inline-flex items-center gap-1.5 rounded-xl border border-violet-200 bg-white px-3.5 py-2 text-sm font-medium text-violet-900 transition-colors hover:border-violet-500 hover:text-violet-700"
        >
          {t.emoji && <span aria-hidden="true">{t.emoji}</span>}
          {t.label}
        </a>
      ))}
    </div>
  </section>

  <!-- 6 + 7. Read deeper (blog) / look up (wiki) -->
  <section class="mt-10 grid gap-6 sm:grid-cols-2">
    <div class="rounded-2xl border border-amber-200 bg-amber-50/50 p-5">
      <h2 class="text-base font-black text-amber-900 mb-3">{c.blog.heading}</h2>
      <ul class="space-y-2">
        {c.blog.items.map((b) => (
          <li>
            <a href={b.href} rel="noopener" class="text-sm text-amber-900 underline decoration-amber-300 underline-offset-2 hover:text-amber-700">
              {b.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="rounded-2xl border border-sky-200 bg-sky-50/50 p-5">
      <h2 class="text-base font-black text-sky-900 mb-3">{c.wiki.heading}</h2>
      <ul class="space-y-2">
        {c.wiki.items.map((w) => (
          <li>
            <a href={w.href} rel="noopener" class="text-sm text-sky-900 underline decoration-sky-300 underline-offset-2 hover:text-sky-700">
              {w.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 8. FAQ -->
  <section class="mt-10">
    <h2 class="text-xl font-black text-violet-950 mb-4">{c.faq.heading}</h2>
    <div class="space-y-3">
      {c.faq.items.map((f) => (
        <details class="group rounded-2xl border border-violet-100 bg-white p-4">
          <summary class="cursor-pointer font-bold text-violet-950 list-none flex items-center justify-between gap-2">
            {f.q}
            <span class="text-violet-400 transition-transform group-open:rotate-45" aria-hidden="true">＋</span>
          </summary>
          <p class="mt-3 text-sm text-gray-600 leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Next journeys -->
  <nav class="mt-12 rounded-2xl bg-violet-950 p-6 text-center" aria-label={c.next.heading}>
    <h2 class="text-sm font-black uppercase tracking-widest text-violet-300 mb-4">{c.next.heading}</h2>
    <div class="flex flex-wrap justify-center gap-2">
      {c.next.items.map((n) => (
        <a
          href={n.href}
          class="inline-flex items-center gap-1.5 rounded-xl bg-violet-900/60 border border-violet-700 px-4 py-2 text-sm font-medium text-violet-100 transition-colors hover:bg-violet-800 hover:text-white"
        >
          {n.emoji && <span aria-hidden="true">{n.emoji}</span>}
          {n.label}
        </a>
      ))}
    </div>
  </nav>
</article>

<script type="application/ld+json" set:html={faqJsonLd} />
