---
// 세 lane 을 한 그루로 읽게 하는 표식. 캔버스가 아니라 글머리 크기의 도형이다 —
// /ontology 는 이미 뿌리에서 잎 순으로 쌓여 있으므로 그 사실에 표식만 준다.
//
// 지표선은 **점선**이다. 실선으로 그렸더니 세로획과 만나 한자 '木'처럼 읽혔다 —
// 가로 실선 하나가 표식을 글자로 만든다. 점선은 즉시 '지면'으로 읽힌다.
//
// 뿌리 표식에는 지면 위로 올라오는 줄기가 없다. 그 짧은 획 하나 때문에
// 사람 형상처럼 보였다. 뿌리는 지면 아래에만 있다.
interface Props {
  mark: 'root' | 'trunk' | 'leaf';
  class?: string;
}
const { mark, class: className = '' } = Astro.props;
---
<svg
  viewBox="0 0 18 18"
  width="18"
  height="18"
  aria-hidden="true"
  focusable="false"
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
>
  {mark === 'root' && (
    <>
      <line x1="1" y1="4.6" x2="17" y2="4.6" stroke-width="1.1" stroke-dasharray="2 1.8" opacity=".5" />
      <path d="M9 4.6C9 8.4 6.2 10 3.9 14.6" stroke-width="1.7" />
      <path d="M9 4.6C9 8.4 11.8 10 14.1 14.6" stroke-width="1.7" />
      <path d="M9 4.6C9.1 8.6 9.2 11 9 15.8" stroke-width="1.9" />
    </>
  )}
  {mark === 'trunk' && (
    <>
      <line x1="1" y1="15.4" x2="17" y2="15.4" stroke-width="1.1" stroke-dasharray="2 1.8" opacity=".5" />
      <path
        d="M8.1 15.4C8.6 11 8.9 7.5 9.0 2.6L9.9 2.6C10.0 7.5 10.3 11 10.8 15.4Z"
        fill="currentColor"
        stroke="none"
      />
      <path d="M9.4 8.4C10.7 7.5 11.9 7.1 13.3 6.9" stroke-width="1.2" />
      <path d="M9.1 11.6C7.8 10.8 6.8 10.5 5.5 10.4" stroke-width="1.2" />
    </>
  )}
  {mark === 'leaf' && (
    <>
      <g fill="currentColor" stroke="none">
        <ellipse cx="9" cy="4.8" rx="3.7" ry="2.2" transform="rotate(-26 9 4.8)" />
        <ellipse cx="4.9" cy="11" rx="3.3" ry="2" transform="rotate(24 4.9 11)" />
        <ellipse cx="13.1" cy="11" rx="3.3" ry="2" transform="rotate(-24 13.1 11)" />
      </g>
      <path d="M9 8.4C8 10 7 12.6 6.6 15.6" stroke-width="1.1" opacity=".55" />
    </>
  )}
</svg>
