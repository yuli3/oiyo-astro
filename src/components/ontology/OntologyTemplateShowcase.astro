---
interface Props {
  locale: string;
  variant: number;
}

const { locale, variant } = Astro.props;

const navItems = [
  { id: 1, label: "Signal Stack" },
  { id: 2, label: "Journey Map" },
  { id: 3, label: "Library Atlas" },
  { id: 4, label: "Command Deck" },
];

const capabilityGroups = [
  {
    label: "출생 좌표",
    count: "18+",
    tone: "green",
    items: ["사주·팔자", "오행·십성", "서양 점성술", "자미두수", "마야", "켈트", "베다", "카발라"],
  },
  {
    label: "심리 테스트",
    count: "120+",
    tone: "sky",
    items: ["MBTI", "Big Five", "TCI", "HEXACO", "Enneagram", "RIASEC", "HSP", "애착"],
  },
  {
    label: "생활 기록",
    count: "10+",
    tone: "amber",
    items: ["강점 키워드", "취미", "가치", "저널", "호흡", "활동", "연속일", "배지"],
  },
  {
    label: "해석 합성",
    count: "12+",
    tone: "rose",
    items: ["Grand Oracle", "AI Oracle", "추천 엔진", "해석 shard", "비교", "아카이브"],
  },
];

const sourceLanes = [
  { label: "타고난 것", value: "생년월일·출생시간·이름", detail: "사주, 별자리, 마야, 켈트, 자미두수, 수비학" },
  { label: "테스트로 드러난 것", value: "선택·응답·점수", detail: "MBTI, Big Five, TCI, RIASEC, 애착, 가치관" },
  { label: "실제 나의 것", value: "저널·활동·키워드", detail: "강점 키워드, 하고 싶은 활동, 반복 행동, 회복 방식" },
  { label: "해설과 근거", value: "blog/wiki 연결", detail: "사주·심리학·점성술·MBTI 해설로 이어지는 독서 경로" },
];

const testChips = [
  "MBTI", "Big Five", "TCI", "HEXACO", "Enneagram", "RIASEC", "HSP", "애착",
  "자존감", "자기통제", "번아웃", "불안", "우울", "가치관", "돈 성향", "정치 성향",
];

const blogLinks = [
  "MBTI 16유형", "사주 오행", "십성 심리", "Jung Shadow", "애착 이론", "Big Five",
  "Enneagram", "Zodiac", "Money Psychology", "Flow", "Burnout", "Social Anxiety",
];

const templates: Record<number, {
  title: string;
  subtitle: string;
  intent: string;
  bestFor: string;
}> = {
  1: {
    title: "Signal Stack",
    subtitle: "한 화면에서 오늘 필요한 좌표만 먼저 보여주는 압축형 대시보드",
    intent: "모바일 첫 화면에서 사용자가 길을 잃지 않게 핵심 상태, 입력 필요 항목, 다음 행동을 3초 안에 파악하게 한다.",
    bestFor: "첫 방문자, 데이터가 적은 사용자, 빠른 재방문",
  },
  2: {
    title: "Journey Map",
    subtitle: "생년월일에서 시작해 테스트와 키워드 캔버스로 확장되는 여정형",
    intent: "ontology를 한 번에 보여주지 않고, 사용자가 자기 데이터를 쌓아가는 순서를 명확히 만든다.",
    bestFor: "온보딩, 점진적 해금, 게이미피케이션",
  },
  3: {
    title: "Library Atlas",
    subtitle: "태어난 것, 테스트, 실제 기록, 해설을 도서관 서가처럼 분리",
    intent: "상징·검사·행동 데이터를 섞지 않고 출처별로 분류해 신뢰감과 가독성을 확보한다.",
    bestFor: "정보량이 많은 사용자, 아카이브, blog/wiki 연결",
  },
  4: {
    title: "Command Deck",
    subtitle: "오늘 할 입력과 읽을 해설, 열리는 카드가 한 화면에 잡히는 운영형",
    intent: "매일 다시 들어오는 사용자가 다음 행동을 바로 실행하고, 변화한 카드만 확인하게 한다.",
    bestFor: "리텐션, 저널, streak, 추천 루프",
  },
};

const current = templates[variant] ?? templates[1];
const pathBase = `/${locale}/ontology/template`;
---

<section class={`template-page template-${variant}`}>
  <div class="template-shell">
    <aside class="template-side">
      <p class="eyebrow">Ontology prototype</p>
      <h1>{current.title}</h1>
      <p class="subtitle">{current.subtitle}</p>
      <div class="nav-row" aria-label="template navigation">
        {navItems.map((item) => (
          <a class:list={["nav-pill", item.id === variant && "active"]} href={`${pathBase}/${item.id}`}>
            {item.id}
          </a>
        ))}
      </div>
      <div class="intent-box">
        <p class="box-label">설계 의도</p>
        <p>{current.intent}</p>
      </div>
      <div class="intent-box muted">
        <p class="box-label">적합한 상황</p>
        <p>{current.bestFor}</p>
      </div>
    </aside>

    <main class="phone-stage" aria-label={`ontology template ${variant}`}>
      {variant === 1 && (
        <div class="phone-canvas stack-layout">
          <header class="phone-header">
            <span>존재론</span>
            <strong>68%</strong>
          </header>
          <section class="hero-panel">
            <p class="eyebrow">오늘의 지도</p>
            <h2>지혜의 도서관</h2>
            <p>생년월일과 테스트 결과를 합쳐 지금 열 수 있는 좌표를 먼저 보여줍니다.</p>
          </section>
          <div class="metric-grid">
            <div><span>출생 좌표</span><strong>7</strong></div>
            <div><span>테스트</span><strong>12</strong></div>
            <div><span>해설</span><strong>36</strong></div>
          </div>
          <section class="compact-section">
            <div class="section-head">
              <h3>열린 엔진</h3>
              <span>4 groups</span>
            </div>
            {capabilityGroups.map((group) => (
              <article class={`signal-card ${group.tone}`}>
                <div>
                  <p>{group.label}</p>
                  <strong>{group.count}</strong>
                </div>
                <div class="chip-line">
                  {group.items.slice(0, 4).map((item) => <span>{item}</span>)}
                </div>
              </article>
            ))}
          </section>
        </div>
      )}

      {variant === 2 && (
        <div class="phone-canvas journey-layout">
          <header class="phone-header">
            <span>여정 지도</span>
            <strong>Step 2</strong>
          </header>
          <section class="map-panel">
            <div class="map-node primary">생년월일</div>
            <div class="map-node">사주</div>
            <div class="map-node">별자리</div>
            <div class="map-node">테스트</div>
            <div class="map-node">키워드</div>
            <div class="map-node done">합성</div>
          </section>
          <section class="compact-section">
            <div class="section-head">
              <h3>다음에 받을 데이터</h3>
              <span>선택형</span>
            </div>
            <div class="mind-grid">
              {["좋아하는 키워드", "하고 싶은 활동", "회복 방식", "가치관"].map((item) => (
                <button>{item}</button>
              ))}
            </div>
          </section>
          <section class="timeline">
            {sourceLanes.map((lane, index) => (
              <article>
                <span>{index + 1}</span>
                <div>
                  <strong>{lane.label}</strong>
                  <p>{lane.value}</p>
                </div>
              </article>
            ))}
          </section>
        </div>
      )}

      {variant === 3 && (
        <div class="phone-canvas library-layout">
          <header class="phone-header">
            <span>도서관</span>
            <strong>Atlas</strong>
          </header>
          <section class="shelf-hero">
            <h2>분류가 먼저 보이는 존재론</h2>
            <p>데이터 출처를 분리해서 “무엇이 근거인가”를 흐리지 않습니다.</p>
          </section>
          <div class="shelf-list">
            {sourceLanes.map((lane) => (
              <article>
                <div>
                  <strong>{lane.label}</strong>
                  <p>{lane.detail}</p>
                </div>
                <span>{lane.value}</span>
              </article>
            ))}
          </div>
          <section class="blog-strip">
            <h3>연결 해설</h3>
            <div>
              {blogLinks.map((item) => <span>{item}</span>)}
            </div>
          </section>
        </div>
      )}

      {variant === 4 && (
        <div class="phone-canvas deck-layout">
          <header class="sticky-input">
            <div>
              <span>오늘 업데이트</span>
              <strong>생년월일 저장됨</strong>
            </div>
            <button>수정</button>
          </header>
          <section class="command-hero">
            <p class="eyebrow">Command deck</p>
            <h2>오늘 열어볼 카드</h2>
          </section>
          <div class="action-list">
            {["MBTI 결과 연결", "강점 키워드 5개 선택", "사주 오행 해설 읽기", "오늘의 저널 작성"].map((item, index) => (
              <article>
                <span>{index + 1}</span>
                <strong>{item}</strong>
                <button>열기</button>
              </article>
            ))}
          </div>
          <section class="test-cloud">
            <h3>빠른 테스트</h3>
            <div>
              {testChips.map((item) => <span>{item}</span>)}
            </div>
          </section>
        </div>
      )}
    </main>
  </div>
</section>

<style>
  .template-page {
    min-height: 100vh;
    background:
      linear-gradient(180deg, #f7fbf7 0%, #eef7f0 46%, #f8fafc 100%);
    color: #0f172a;
    padding: 24px 16px 56px;
  }

  .template-shell {
    display: grid;
    gap: 18px;
    margin: 0 auto;
    max-width: 980px;
  }

  .template-side {
    display: grid;
    gap: 12px;
    margin: 0 auto;
    max-width: 430px;
    width: 100%;
  }

  .eyebrow {
    color: #15803d;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0;
    margin: 0;
    text-transform: uppercase;
  }

  h1, h2, h3, p {
    margin: 0;
  }

  .template-side h1 {
    font-size: 30px;
    font-weight: 950;
    line-height: 1.05;
  }

  .subtitle {
    color: #475569;
    font-size: 14px;
    line-height: 1.65;
  }

  .nav-row {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .nav-pill {
    align-items: center;
    background: #ffffff;
    border: 1px solid #dbe8de;
    border-radius: 8px;
    color: #166534;
    display: flex;
    font-size: 13px;
    font-weight: 900;
    height: 42px;
    justify-content: center;
    text-decoration: none;
  }

  .nav-pill.active {
    background: #166534;
    border-color: #166534;
    color: #ffffff;
  }

  .intent-box {
    background: #ffffff;
    border: 1px solid #dbe8de;
    border-radius: 8px;
    padding: 14px;
  }

  .intent-box.muted {
    background: #f8fafc;
  }

  .box-label {
    color: #166534;
    font-size: 11px;
    font-weight: 900;
    margin-bottom: 6px;
  }

  .intent-box p:last-child {
    color: #334155;
    font-size: 13px;
    line-height: 1.6;
  }

  .phone-stage {
    display: flex;
    justify-content: center;
  }

  .phone-canvas {
    background: #ffffff;
    border: 1px solid #d8e7dc;
    border-radius: 8px;
    box-shadow: 0 24px 70px rgba(15, 23, 42, 0.12);
    display: grid;
    gap: 12px;
    max-width: 430px;
    min-height: 760px;
    overflow: hidden;
    padding: 14px;
    width: 100%;
  }

  .phone-header,
  .sticky-input {
    align-items: center;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    display: flex;
    justify-content: space-between;
    min-height: 52px;
    padding: 10px 12px;
  }

  .phone-header span,
  .sticky-input span {
    color: #64748b;
    display: block;
    font-size: 11px;
    font-weight: 800;
  }

  .phone-header strong,
  .sticky-input strong {
    color: #0f172a;
    font-size: 14px;
  }

  .hero-panel,
  .map-panel,
  .shelf-hero,
  .command-hero {
    background: #ecfdf3;
    border: 1px solid #bbf7d0;
    border-radius: 8px;
    padding: 16px;
  }

  .hero-panel h2,
  .shelf-hero h2,
  .command-hero h2 {
    font-size: 24px;
    font-weight: 950;
    line-height: 1.1;
    margin-top: 8px;
  }

  .hero-panel p:last-child,
  .shelf-hero p {
    color: #166534;
    font-size: 13px;
    line-height: 1.55;
    margin-top: 8px;
  }

  .metric-grid {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .metric-grid div {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px;
  }

  .metric-grid span,
  .section-head span {
    color: #64748b;
    display: block;
    font-size: 11px;
    font-weight: 800;
  }

  .metric-grid strong {
    display: block;
    font-size: 24px;
    margin-top: 6px;
  }

  .compact-section,
  .timeline,
  .blog-strip,
  .test-cloud {
    display: grid;
    gap: 10px;
  }

  .section-head {
    align-items: center;
    display: flex;
    justify-content: space-between;
  }

  .section-head h3,
  .blog-strip h3,
  .test-cloud h3 {
    font-size: 15px;
    font-weight: 950;
  }

  .signal-card {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    display: grid;
    gap: 10px;
    padding: 12px;
  }

  .signal-card.green { background: #f0fdf4; border-color: #bbf7d0; }
  .signal-card.sky { background: #f0f9ff; border-color: #bae6fd; }
  .signal-card.amber { background: #fffbeb; border-color: #fde68a; }
  .signal-card.rose { background: #fff1f2; border-color: #fecdd3; }

  .signal-card > div:first-child {
    align-items: center;
    display: flex;
    justify-content: space-between;
  }

  .signal-card p {
    color: #334155;
    font-size: 13px;
    font-weight: 900;
  }

  .signal-card strong {
    font-size: 18px;
  }

  .chip-line,
  .blog-strip div,
  .test-cloud div {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chip-line span,
  .blog-strip span,
  .test-cloud span {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    color: #334155;
    font-size: 11px;
    font-weight: 800;
    padding: 6px 8px;
  }

  .map-panel {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .map-node {
    align-items: center;
    background: #ffffff;
    border: 1px solid #bbf7d0;
    border-radius: 8px;
    color: #166534;
    display: flex;
    font-size: 13px;
    font-weight: 900;
    justify-content: center;
    min-height: 54px;
  }

  .map-node.primary {
    background: #166534;
    color: #ffffff;
  }

  .map-node.done {
    background: #fef3c7;
    border-color: #fde68a;
    color: #92400e;
  }

  .mind-grid {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .mind-grid button {
    background: #ffffff;
    border: 1px solid #dbe8de;
    border-radius: 8px;
    color: #166534;
    font: inherit;
    font-size: 12px;
    font-weight: 900;
    min-height: 54px;
    padding: 8px;
  }

  .timeline article,
  .action-list article,
  .shelf-list article {
    align-items: center;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    display: flex;
    gap: 12px;
    padding: 12px;
  }

  .timeline article > span,
  .action-list article > span {
    align-items: center;
    background: #ecfdf3;
    border-radius: 8px;
    color: #166534;
    display: flex;
    font-size: 12px;
    font-weight: 950;
    height: 32px;
    justify-content: center;
    width: 32px;
  }

  .timeline strong,
  .shelf-list strong,
  .action-list strong {
    display: block;
    font-size: 13px;
  }

  .timeline p,
  .shelf-list p {
    color: #64748b;
    font-size: 12px;
    line-height: 1.45;
    margin-top: 3px;
  }

  .shelf-list {
    display: grid;
    gap: 8px;
  }

  .shelf-list article {
    align-items: flex-start;
    justify-content: space-between;
  }

  .shelf-list article > span {
    color: #166534;
    flex: 0 0 92px;
    font-size: 11px;
    font-weight: 900;
    text-align: right;
  }

  .sticky-input {
    position: sticky;
    top: 0;
    z-index: 2;
  }

  .sticky-input button,
  .action-list button {
    background: #166534;
    border: 0;
    border-radius: 8px;
    color: #ffffff;
    font: inherit;
    font-size: 12px;
    font-weight: 900;
    min-height: 36px;
    padding: 0 12px;
  }

  .action-list {
    display: grid;
    gap: 8px;
  }

  .action-list article {
    justify-content: space-between;
  }

  .action-list strong {
    flex: 1;
  }

  @media (min-width: 860px) {
    .template-page {
      padding: 40px 24px 72px;
    }

    .template-shell {
      align-items: start;
      grid-template-columns: minmax(280px, 360px) minmax(390px, 430px);
      justify-content: center;
    }

    .template-side {
      position: sticky;
      top: 32px;
    }
  }
</style>
