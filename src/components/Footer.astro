---
import type { Locale } from '../i18n';
import { getTranslations, localePath } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await getTranslations(locale);

const FAMILY: { host: string; name: string; tag: Record<string, string> }[] = [
  { host: 'blog.oiyo.net', name: 'OIYO Blog', tag: { ko: '읽는 곳 — 강의·매거진', en: 'Read — guides & magazine', ja: '読む — 講座・マガジン', zh: '阅读 — 课程·杂志', fr: 'Lire — guides & magazine', es: 'Leer — guías y revista' } },
  { host: 'wiki.oiyo.net', name: 'OIYO Wiki', tag: { ko: '찾는 곳 — 개념 사전', en: 'Look up — dictionary', ja: '調べる — 用語事典', zh: '查找 — 概念辞典', fr: 'Chercher — dictionnaire', es: 'Buscar — diccionario' } },
  { host: 'game.oiyo.net', name: 'OIYO Arcade', tag: { ko: '노는 곳 — 게임', en: 'Play — games', ja: '遊ぶ — ゲーム', zh: '玩 — 游戏', fr: 'Jouer — jeux', es: 'Jugar — juegos' } },
  { host: 'news.oiyo.net', name: 'OIYO News', tag: { ko: '보는 곳 — 데일리 큐레이션', en: 'Watch — daily curation', ja: '見る — デイリー', zh: '看 — 每日精选', fr: 'Voir — curation', es: 'Ver — curación diaria' } },
  { host: 'ai.oiyo.net', name: 'OIYO AI', tag: { ko: 'AX — AI 운영 시스템', en: 'AX — AI-native OS', ja: 'AX — AI運用', zh: 'AX — AI 系统', fr: 'AX — OS IA-native', es: 'AX — OS con IA' } },
];
const year = new Date().getFullYear();
---

<footer class="bg-green-950 text-green-200 mt-20">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <!-- Brand -->
      <div>
        <a href={localePath(locale, '/')} class="font-black text-xl text-white">OIYO</a>
        <p class="mt-2 text-sm text-green-400 leading-relaxed max-w-xs">
          {t('nav.tagline')}
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-green-400 mb-3">Navigation</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={localePath(locale, '/ontology')} class="hover:text-white transition-colors">{t('nav.ontology')}</a></li>
          <li><a href={localePath(locale, '/about')} class="hover:text-white transition-colors">{t('nav.about')}</a></li>
          <li><a href={localePath(locale, '/faq')} class="hover:text-white transition-colors">FAQ</a></li>
          <li><a href={localePath(locale, '/contact')} class="hover:text-white transition-colors">{t('nav.contact')}</a></li>
          <li><a href={localePath(locale, '/support')} class="hover:text-white transition-colors">Support</a></li>
          <li><a href="/knowledge/" class="hover:text-white transition-colors">Knowledge</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-green-400 mb-3">Legal</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={localePath(locale, '/methodology')} class="hover:text-white transition-colors">{locale === 'ko' ? '신뢰와 방법론' : locale === 'ja' ? '信頼と方法論' : locale === 'zh' ? '信任与方法论' : locale === 'fr' ? 'Méthodologie' : locale === 'es' ? 'Metodología' : 'Trust & Methodology'}</a></li>
          <li><a href={localePath(locale, '/legal/privacy')} class="hover:text-white transition-colors">{t('nav.privacy')}</a></li>
          <li><a href={localePath(locale, '/legal/terms')} class="hover:text-white transition-colors">{t('nav.terms')}</a></li>
        </ul>
      </div>

      <!-- Oiyo Family — 6 sites, localized -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-green-400 mb-3">Oiyo Family</h3>
        <ul class="space-y-2 text-sm">
          {FAMILY.map((f) => (
            <li>
              <a href={`https://${f.host}/${locale}/?utm_source=oiyo&utm_medium=footer&utm_campaign=family_nav`}
                 target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
                {f.name} →
                <span class="block text-[10px] text-gray-500">{f.tag[locale] ?? f.tag.en}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="border-t border-green-800 pt-6 text-xs text-green-500 text-center">
      © {year} OIYO. All rights reserved.
    </div>
  </div>
</footer>
