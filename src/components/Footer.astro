---
import { FAMILY_SITES, familySiteHref, familySiteTag } from '../config/navigation';
import type { Locale } from '../i18n';
import { getTranslations, localePath } from '../i18n';
import { exploreLinks } from '../config/explore';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await getTranslations(locale);

const year = new Date().getFullYear();
const explore = exploreLinks(locale);
// 2026-11-24 로드맵 0단계: tools 한국어 핵심 페이지가 Google에 '모르는 URL'로 남아 있어(GSC URL 검사),
// 형제 사이트에서 깊은 링크를 직접 걸어 발견을 돕는다. 추적 파라미터 없이 정식 주소만 쓴다.
const lifeLawLinks = locale === 'ko' ? [
  ['https://tools.oiyo.net/ko/life-event-navigator/', '이런 일이 생기면 할 일'],
  ['https://tools.oiyo.net/ko/job-exit-consult-prep/', '퇴사·해고·체불 상담 준비'],
  ['https://tools.oiyo.net/ko/quit-one-stop-calculator/', '퇴사 원스톱 계산'],
  ['https://tools.oiyo.net/ko/legal-aid-eligibility-check/', '무료 법률구조 대상 확인'],
  ['https://tools.oiyo.net/ko/before-expert-visit/', '전문가 상담 전 준비'],
  ['https://tools.oiyo.net/ko/job-desk/', '직업별 세금·노무 창구'],
  ['https://tools.oiyo.net/ko/pro-office/', '실무 오피스'],
] : [];
const copy = {
  en: { site: 'Tests', info: 'Information', family: 'OIYO family', knowledge: 'Knowledge index', support: 'Support OIYO', disclaimer: 'All results across OIYO are for entertainment and self-reflection — symbolic tools, not a substitute for career, financial, medical, legal, or relationship decisions.', methodology: 'View methodology', license: 'License' },
  ko: { site: '검사', info: '안내', family: 'OIYO 패밀리', knowledge: '지식 목록', support: 'OIYO 후원', disclaimer: 'OIYO의 모든 결과는 오락과 자기 성찰을 위한 상징 도구이며, 진로·투자·의료·법률·관계 등 중요한 결정을 대신하지 않아요.', methodology: '방법론 보기', license: '라이선스' },
  ja: { site: 'テスト', info: 'ご案内', family: 'OIYOファミリー', knowledge: '知識一覧', support: 'OIYOを支援', disclaimer: 'OIYOのすべての結果は娯楽と自己省察のための象徴的なツールであり、進路・投資・医療・法律・人間関係などの重要な決定の代わりにはなりません。', methodology: '方法論を見る', license: 'ライセンス' },
  zh: { site: '测试', info: '信息', family: 'OIYO 系列', knowledge: '知识索引', support: '支持 OIYO', disclaimer: 'OIYO 的所有结果均为娱乐与自我反思用的象征工具，不能替代职业、投资、医疗、法律或人际关系等重要决策。', methodology: '查看方法论', license: '许可协议' },
  fr: { site: 'Tests', info: 'Informations', family: 'Famille OIYO', knowledge: 'Index des connaissances', support: 'Soutenir OIYO', disclaimer: "Tous les résultats d'OIYO sont des outils symboliques destinés au divertissement et à la réflexion — ils ne remplacent pas une décision professionnelle, financière, médicale, juridique ou relationnelle.", methodology: 'Voir la méthodologie', license: 'Licence' },
  es: { site: 'Tests', info: 'Información', family: 'Familia OIYO', knowledge: 'Índice de conocimiento', support: 'Apoyar OIYO', disclaimer: 'Todos los resultados de OIYO son herramientas simbólicas de entretenimiento y reflexión — no sustituyen decisiones profesionales, financieras, médicas, legales o relacionales.', methodology: 'Ver metodología', license: 'Licencia' },
}[locale];
---

<footer class="mt-20 border-t border-border bg-muted/25 py-10 text-left">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 sm:grid-cols-2 lg:grid-cols-[0.8fr_1fr_2fr]">
    <section>
      <p class="mb-3 text-sm font-black tracking-tight">OIYO <span class="font-semibold lowercase text-primary">tests</span></p>
      <nav aria-label={copy.site} class="grid gap-2 text-sm text-muted-foreground">
        <a href={localePath(locale, '/tests')} class="hover:text-primary">{copy.site}</a>
        <a href={localePath(locale, '/ontology')} class="hover:text-primary">{t('nav.ontology')}</a>
        <a href={localePath(locale, '/about')} class="hover:text-primary">{t('nav.about')}</a>
        <a href="/knowledge/" class="hover:text-primary">{copy.knowledge}</a>
        {explore.map((item) => <a href={item.href} class="hover:text-primary">{item.title}</a>)}
      </nav>
    </section>
    <section>
      <p class="mb-3 text-xs font-bold uppercase tracking-widest text-foreground">{copy.info}</p>
      <nav aria-label={copy.info} class="grid gap-2 text-sm text-muted-foreground">
        <a href={localePath(locale, '/methodology')} class="hover:text-primary">{locale === 'ko' ? '신뢰와 방법론' : locale === 'ja' ? '信頼と方法論' : locale === 'zh' ? '信任与方法论' : locale === 'fr' ? 'Méthodologie' : locale === 'es' ? 'Metodología' : 'Trust & Methodology'}</a>
        <a href={localePath(locale, '/legal/privacy')} class="hover:text-primary">{t('nav.privacy')}</a>
        <a href={localePath(locale, '/legal/terms')} class="hover:text-primary">{t('nav.terms')}</a>
        <a href={`https://blog.oiyo.net/${locale}/license/`} class="hover:text-primary">{copy.license}</a>
        <a href={localePath(locale, '/contact')} class="hover:text-primary">{t('nav.contact')}</a>
        <a id="oiyo-support" href="https://paypal.me/chosean" target="_blank" rel="noopener noreferrer" class="hover:text-primary">{copy.support}</a>
        <a href="https://ko-fi.com/tqqq3" target="_blank" rel="noopener noreferrer" class="hover:text-primary">Ko-fi</a>
      </nav>
    </section>
    <section>
      <p class="mb-3 text-xs font-bold uppercase tracking-widest text-foreground">{copy.family}</p>
      <nav aria-label={copy.family} class="grid grid-cols-2 gap-x-5 gap-y-3 sm:grid-cols-3">
        {FAMILY_SITES.map((f) => (
          <a href={familySiteHref(f, locale, 'footer')} class="group min-w-0 text-sm font-semibold text-foreground hover:text-primary">
            {f.name}<span class="block text-xs font-normal text-muted-foreground group-hover:text-primary">{familySiteTag(f, locale)}</span>
          </a>
        ))}
      </nav>
      {lifeLawLinks.length > 0 && (
        <nav aria-label="생활 법령 도구" class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-sm text-muted-foreground">
          <span class="w-full text-xs font-bold uppercase tracking-widest text-foreground">생활 법령 도구</span>
          {lifeLawLinks.map(([href, label]) => <a href={href} class="hover:text-primary">{label}</a>)}
        </nav>
      )}
    </section>
  </div>
  <div class="mx-auto mt-8 max-w-6xl border-t border-border px-4 pt-5">
    <p class="text-xs leading-5 text-muted-foreground">
      {copy.disclaimer}
      {' '}
      <a href={localePath(locale, '/methodology')} class="underline decoration-dotted underline-offset-2 hover:text-primary">{copy.methodology}</a>
    </p>
    <div class="mt-3 flex flex-wrap items-center justify-between gap-3 text-xs text-muted-foreground">
      <span>© {year} Oiyo Tech · <a href={`https://blog.oiyo.net/${locale}/license/`} class="hover:text-primary">{copy.license}</a></span><a href="mailto:support@oiyo.net" class="hover:text-primary">support@oiyo.net</a>
    </div>
  </div>
</footer>
