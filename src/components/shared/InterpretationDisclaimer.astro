---
import type { Locale } from '../../i18n';
import { DISCLAIMERS, type DisclaimerKind } from '../../data/disclaimers';

interface Props {
  locale: Locale;
  kind: DisclaimerKind;
  text?: string;
}

const { locale, kind, text } = Astro.props;
const message = text ?? DISCLAIMERS[kind][locale] ?? DISCLAIMERS[kind].en;
---

<aside
  class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900"
  data-disclaimer-kind={kind}
>
  {message}
</aside>
