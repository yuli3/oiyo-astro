---
import { localePath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  /** Tool ids to show (current page's own id is safely ignored if included). */
  tools: string[];
  /** Optional id of the current page to exclude from the list. */
  current?: string;
}

const { locale, tools, current } = Astro.props as Props;

