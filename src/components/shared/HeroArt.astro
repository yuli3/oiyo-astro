---
/**
 * 페이지 머리의 장식 그림.
 *
 * 2026-09-29 A2: 8/25 에 만들어 둔 imagegen 히어로 그림이 한 번도 연결되지 않아
 * 쓰이지 않는 채로 있었다. 내용을 전하지 않는 장식이라 alt 는 비우고, 크기를
 * 고정해 레이아웃이 밀리지 않게 한다. 원본 PNG 는 1200px webp 로 줄여 쓴다.
 */
interface Props {
  src: string;
  class?: string;
}
const { src, class: className = '' } = Astro.props;
---
<img
  src={src}
  alt=""
  width="1200"
  height="675"
  decoding="async"
  class={`block h-auto w-full rounded-2xl border border-border object-cover ${className}`}
/>
