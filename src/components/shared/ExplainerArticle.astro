---
// 개념 해설 본문 렌더러. explainers 컬렉션의 마크다운을 받아 한 벌의 산문 스타일로 그린다.
//
// 2026-10-13: share the prose stylesheet with dream detail pages; rendered
// Markdown has no Astro scope hash, so selectors stay under .explainer-prose.
import { render, type CollectionEntry } from 'astro:content';
import type { Locale } from '../../i18n';
import '../../styles/explainer-prose.css';

interface Props {
  entry: CollectionEntry<'explainers'>;
  locale: Locale;
  /** 이어지는 도구 경로. 로케일 접두사 없이 준다. */
  testPath: string;
  /** CTA 문구 종류. 개념 해설이 테스트가 아닌 도구로 이어질 때 쓴다. */
  ctaKind?: 'test' | 'saju' | 'dream';
}
const { entry, locale, testPath, ctaKind = 'test' } = Astro.props;
const { Content } = await render(entry);

const UI: Record<Locale, { cta: string; ctaNote: string; updated: string }> = {
  ko: { cta: '테스트로 내 결과 보기', ctaNote: '읽은 개념을 내 답변에 대입해 봐요.', updated: '마지막 검토' },
  en: { cta: 'Take the test', ctaNote: 'Apply what you just read to your own answers.', updated: 'Last reviewed' },
  ja: { cta: 'テストで確かめる', ctaNote: '読んだ概念を自分の回答に当てはめてみます。', updated: '最終確認' },
  zh: { cta: '去做测试', ctaNote: '把刚读到的概念用在自己的回答上。', updated: '最后审阅' },
  fr: { cta: 'Faire le test', ctaNote: 'Appliquez ce que vous venez de lire à vos propres réponses.', updated: 'Dernière révision' },
  es: { cta: 'Hacer el test', ctaNote: 'Aplica lo que acabas de leer a tus propias respuestas.', updated: 'Última revisión' },
};
const SAJU_UI: Record<Locale, { cta: string; ctaNote: string }> = {
  ko: { cta: '내 사주 월주 확인하기', ctaNote: '글에서 본 절입 경계가 내 사주에 어떻게 적용되는지 봐요.' },
  en: { cta: 'Check my month pillar', ctaNote: 'See how the entry-moment boundary applies to your own chart.' },
  ja: { cta: '自分の月柱を確認する', ctaNote: '記事で見た節入りの境界が自分の命式にどう効くかを見ます。' },
  zh: { cta: '查看我的月柱', ctaNote: '看看文中的交节分界如何落到自己的八字上。' },
  fr: { cta: 'Voir mon pilier du mois', ctaNote: "Voyez comment la limite d'entrée s'applique à votre propre thème." },
  es: { cta: 'Ver mi pilar del mes', ctaNote: 'Comprueba cómo se aplica el instante de entrada a tu propia carta.' },
};
const DREAM_UI: Record<Locale, { cta: string; ctaNote: string }> = {
  ko: { cta: '다른 상징 찾아보기', ctaNote: '꿈에 함께 나온 상징을 사전에서 이어 봐요.' },
  en: { cta: 'Browse other symbols', ctaNote: 'Look up the other symbols that appeared in the same dream.' },
  ja: { cta: '他の象徴を見る', ctaNote: '同じ夢に出た他の象徴も事典で辿ります。' },
  zh: { cta: '浏览其他象征', ctaNote: '继续查阅同一个梦里出现的其他象征。' },
  fr: { cta: "Voir d'autres symboles", ctaNote: 'Retrouvez les autres symboles apparus dans le même rêve.' },
  es: { cta: 'Ver otros símbolos', ctaNote: 'Busca los demás símbolos que aparecieron en el mismo sueño.' },
};
const base = UI[locale] ?? UI.en;
const EXTRA = { saju: SAJU_UI, dream: DREAM_UI } as const;
const ui = ctaKind === 'test' ? base : { ...base, ...(EXTRA[ctaKind][locale] ?? EXTRA[ctaKind].en) };
const updated = entry.data.updated.toISOString().slice(0, 10);
---

<article class="mx-auto max-w-2xl px-4 py-10">
  <h1 class="text-3xl font-bold leading-snug text-foreground" data-route-title>{entry.data.title}</h1>
  <p class="mt-4 leading-8 text-muted-foreground">{entry.data.definition}</p>

  <div class="explainer-prose mt-10"><Content /></div>

  <aside class="mt-12 rounded-xl border border-border bg-surface-subtle p-5">
    <p class="text-sm leading-6 text-muted-foreground">{ui.ctaNote}</p>
    <a
      class="mt-3 inline-block rounded-lg bg-primary px-4 py-2 font-semibold text-primary-foreground transition-colors hover:bg-primary-strong"
      href={`/${locale}${testPath}`.replace(/\/?$/, "/")}>{ui.cta}</a>
  </aside>

  <p class="mt-8 text-sm text-muted-foreground">{ui.updated}: <time datetime={updated}>{updated}</time></p>
</article>
