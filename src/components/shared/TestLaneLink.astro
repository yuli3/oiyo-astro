---
/**
 * 검사 페이지 끝의 "같은 질문의 다른 검사" 링크.
 *
 * 2026-09-28 O9: 설명 없이 검사만 있던 57개 페이지는 다음으로 갈 곳이 없었다. 관련 검사
 * 목록을 페이지마다 손으로 고르지 않고, /tests 허브가 이미 가진 질문 분류(LANE_BY_PATH)로
 * 같은 질문 묶음에 돌려보낸다. 분류가 없으면 아무것도 그리지 않는다.
 *
 * 2026-11-03: 허브 링크 하나만으로는 결과 뒤에 다음 검사로 이어지지 않았다(GA4 28일 세션당
 * 1.8쪽). 같은 묶음에서 이 검사 다음 순서의 검사 3개를 바로 보여 준다. 순서는 LANE_BY_PATH
 * 선언 순서를 돌려 쓰므로 페이지마다 다른 세 개가 나와 묶음 안 내부 링크가 고르게 퍼진다.
 * 페이지가 직접 넣지 않고 Layout 이 경로로 그린다(122개 lane 검사 전부).
 */
import { localePath, type Locale } from '../../i18n';
import { LANE_BY_PATH, QUESTION_LANES } from '../../data/test-question-lanes';
import { buildTestsByPath } from '../../data/test-hub-directory';

interface Props {
  locale: Locale;
  /** 페이지 경로 — 예: "/optimism-test" */
  path: string;
}

const { locale, path } = Astro.props;
const laneId = LANE_BY_PATH[path];
const lane = QUESTION_LANES.find((item) => item.id === laneId);
const lanePaths = Object.entries(LANE_BY_PATH).filter(([, id]) => id === laneId).map(([p]) => p);
const here = lanePaths.indexOf(path);
const testsByPath = buildTestsByPath(locale);
const siblings = here < 0
  ? []
  : [1, 2, 3]
      .map((offset) => lanePaths[(here + offset) % lanePaths.length])
      .filter((p, i, all) => p !== path && all.indexOf(p) === i)
      .map((p) => testsByPath.get(localePath(locale, p)))
      .filter((test): test is NonNullable<typeof test> => Boolean(test));
const T: Record<Locale, { eyebrow: string; more: string }> = {
  ko: { eyebrow: '같은 질문의 다른 검사', more: '이 질문의 검사 모두 보기' },
  en: { eyebrow: 'More tests for the same question', more: 'See every test for this question' },
  ja: { eyebrow: '同じ問いのほかのテスト', more: 'この問いのテストをすべて見る' },
  zh: { eyebrow: '同一问题的其他测试', more: '查看这个问题下的所有测试' },
  fr: { eyebrow: 'D’autres tests pour la même question', more: 'Voir tous les tests de cette question' },
  es: { eyebrow: 'Más tests para la misma pregunta', more: 'Ver todos los tests de esta pregunta' },
};
const copy = T[locale] ?? T.en;
---
{lane && (
  <section class="mx-auto mt-6 max-w-2xl px-4 pb-8">
    <h2 class="text-[11px] font-black uppercase tracking-widest text-primary">{copy.eyebrow}</h2>
    <p class="mt-1 text-lg font-black text-foreground">{lane.question[locale] ?? lane.question.en}</p>
    {siblings.length > 0 && (
      <ul class="mt-3 grid gap-2">
        {siblings.map((test) => (
          <li>
            <a href={test.href} class="flex min-h-11 items-center justify-between gap-3 rounded-lg border border-border bg-card px-4 py-3 text-sm font-bold text-foreground transition-colors hover:border-primary hover:text-primary focus-visible:outline-2 focus-visible:outline-primary">
              <span>{test.title[locale] ?? test.title.en}</span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    )}
    <a href={`${localePath(locale, '/tests')}#${lane.id}`} class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-primary hover:underline focus-visible:outline-2 focus-visible:outline-primary">{copy.more} →</a>
  </section>
)}
