---
/**
 * 출생 정보 저장 알림.
 *
 * 2026-09-30 B6 #10: 사주·운세 도구에서 생일을 넣으면 나의 지도에도 저장되지만
 * 화면에 아무 표시가 없어, 다시 입력하지 않아도 된다는 걸 사용자가 알 수 없었다.
 * user-store 가 값이 바뀔 때만 `oiyo:birth-saved` 이벤트를 보내고, 여기서 5초 동안
 * 알림과 나의 지도 링크를 보여 준다. 나의 지도 페이지 자체에서는 띄우지 않는다.
 */
import { localePath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text: Record<string, { saved: string; open: string }> = {
  ko: { saved: '출생 정보를 나의 지도에 저장했어요', open: '지도 보기' },
  en: { saved: 'Your birth details are saved to My Map', open: 'Open map' },
  ja: { saved: '出生情報を私の地図に保存しました', open: '地図を見る' },
  zh: { saved: '出生信息已保存到我的地图', open: '查看地图' },
  fr: { saved: 'Vos données de naissance sont enregistrées dans Ma carte', open: 'Voir la carte' },
  es: { saved: 'Tus datos de nacimiento se guardaron en Mi mapa', open: 'Ver mapa' },
};
const t = text[locale] ?? text.en;
const mapHref = localePath(locale, '/ontology');
---
<div
  id="birth-saved-toast"
  role="status"
  aria-live="polite"
  data-map-path={mapHref}
  hidden
  class="fixed inset-x-4 bottom-4 z-50 mx-auto flex max-w-md items-center justify-between gap-3 rounded-2xl border border-border bg-card px-4 py-3 text-sm text-card-foreground shadow-lg"
>
  <span>{t.saved}</span>
  <a href={mapHref} class="shrink-0 font-medium text-primary underline underline-offset-2">{t.open}</a>
</div>
<script>
  const toast = document.getElementById('birth-saved-toast');
  let timer: number | undefined;
  window.addEventListener('oiyo:birth-saved', () => {
    if (!toast) return;
    const mapPath = (toast.dataset.mapPath ?? '').replace(/\/$/, '');
    if (window.location.pathname.replace(/\/$/, '') === mapPath) return;
    toast.hidden = false;
    window.clearTimeout(timer);
    timer = window.setTimeout(() => { toast.hidden = true; }, 5000);
  });
</script>
