---
// Hybrid content-graph bridge: oiyo = interactive tool, blog = deep content.
// Links a tool page to its matching blog article by shared slug. Locale-safe
// (blog generates these articles for every locale).
import type { Locale } from '../../i18n';

interface Props {
  /** Blog article slug (must exist on blog.oiyo.net for all locales). */
  slug: string;
  locale: Locale;
  /** Optional topic name shown before the heading. */
  topic?: string;
}
const { slug, locale, topic } = Astro.props;
const utm = 'utm_source=oiyo&utm_medium=tool_page&utm_campaign=hybrid_bridge';
const url = `https://blog.oiyo.net/${locale}/${slug}?${utm}`;

const copy: Record<string, { eyebrow: string; title: string; body: string; cta: string }> = {
  ko: { eyebrow: '하이브리드 — 도구는 여기, 깊이는 블로그', title: '이 주제를 더 깊이 읽기', body: '오이요에서 검사를 마쳤다면, 블로그의 심층 해설(이론·FAQ·유형별 가이드)에서 결과를 더 풍부하게 이해할 수 있습니다.', cta: '블로그에서 이어 읽기' },
  en: { eyebrow: 'Hybrid — tool here, depth on the blog', title: 'Read deeper on this topic', body: 'Took the test on oiyo? Continue on the blog for the in-depth guide — theory, FAQ, and type-by-type breakdowns.', cta: 'Continue on the blog' },
  ja: { eyebrow: 'ハイブリッド — ツールはここ、深掘りはブログ', title: 'このテーマをさらに深く読む', body: 'oiyoで診断したら、ブログの詳しい解説(理論・FAQ・タイプ別ガイド)で結果をより深く理解できます。', cta: 'ブログで続きを読む' },
  zh: { eyebrow: '混合 — 工具在此，深度在博客', title: '更深入地阅读这个主题', body: '在 oiyo 完成测验后，可在博客的深度解读（理论、FAQ、各类型指南）中更全面地理解结果。', cta: '在博客继续阅读' },
  fr: { eyebrow: "Hybride — l'outil ici, l'analyse sur le blog", title: 'Approfondir ce sujet', body: "Test terminé sur oiyo ? Poursuivez sur le blog pour le guide détaillé — théorie, FAQ et analyses par type.", cta: 'Continuer sur le blog' },
  es: { eyebrow: 'Híbrido — la herramienta aquí, la profundidad en el blog', title: 'Lee más sobre este tema', body: '¿Hiciste el test en oiyo? Continúa en el blog para la guía detallada — teoría, FAQ y análisis por tipo.', cta: 'Continuar en el blog' },
};
const c = copy[locale] ?? copy.en;
---
<aside class="mx-auto mt-12 max-w-2xl rounded-2xl border border-green-100 bg-green-50/40 p-6">
  <p class="text-xs font-bold uppercase tracking-wide text-green-700">{c.eyebrow}</p>
  <h2 class="mt-2 text-xl font-bold text-green-950">{topic ? `${topic} — ${c.title}` : c.title}</h2>
  <p class="mt-2 text-sm leading-7 text-slate-700">{c.body}</p>
  <a href={url} class="mt-4 inline-flex items-center gap-2 rounded-lg bg-green-700 px-4 py-2 text-sm font-bold text-white transition hover:bg-green-800">
    {c.cta} →
  </a>
</aside>
