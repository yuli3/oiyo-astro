---
import { getMentalQuotes } from '../../data/mental-quotes';
import type { Locale } from '../../i18n';

// A single rotating mental-boost quote card, shown between features.
// Picks client-side at random; if the visitor has a stored MBTI type
// (oiyo-user-storage profile.mbti, or legacy oiyo_mbti_result), quotes
// tagged with their letters get double weight and a small badge.
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const quotes = getMentalQuotes(locale);

const heading: Record<string, string> = {
  ko: '오늘의 한 줄',
  en: 'A line for today',
  ja: '今日のひとこと',
  zh: '今日一句',
  fr: 'Une ligne pour aujourd’hui',
  es: 'Una línea para hoy',
};
const refreshLabel: Record<string, string> = {
  ko: '다른 글귀 보기',
  en: 'Show another line',
  ja: '別の言葉を見る',
  zh: '换一句',
  fr: 'Voir une autre ligne',
  es: 'Ver otra línea',
};
const badgeTemplate: Record<string, string> = {
  ko: '%s 맞춤',
  en: 'for %s',
  ja: '%s向け',
  zh: '为%s挑选',
  fr: 'pour %s',
  es: 'para %s',
};

const first = quotes[0];
const payload = JSON.stringify({
  quotes,
  badge: badgeTemplate[locale] ?? badgeTemplate.en,
});
---

{quotes.length > 0 && (
  <aside
    data-mental-boost
    class="mt-8 rounded-2xl border border-green-100 bg-green-50/50 p-5"
    aria-label={heading[locale] ?? heading.en}
  >
    <script type="application/json" set:html={payload} />
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <p class="text-[11px] font-black uppercase tracking-widest text-green-700">
          {heading[locale] ?? heading.en}
          <span
            data-mb-badge
            class="ml-2 inline-block rounded-full border border-green-200 bg-white px-2 py-0.5 text-[10px] font-bold normal-case tracking-normal text-green-700"
            style="display:none"
          ></span>
        </p>
        <p data-mb-label class="mt-3 text-xs font-bold text-green-700">{first.label}</p>
        <p data-mb-text class="mt-1 text-[15px] leading-7 text-green-950">{first.text}</p>
      </div>
      <button
        data-mb-refresh
        type="button"
        aria-label={refreshLabel[locale] ?? refreshLabel.en}
        title={refreshLabel[locale] ?? refreshLabel.en}
        class="shrink-0 rounded-lg border border-green-200 bg-white p-2 text-green-700 transition-colors hover:border-green-400 hover:text-green-900"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12a9 9 0 1 1-2.64-6.36" />
          <path d="M21 3v6h-6" />
        </svg>
      </button>
    </div>
  </aside>
)}

<script>
  function initMentalBoost() {
    document.querySelectorAll<HTMLElement>('[data-mental-boost]').forEach((root) => {
      if (root.dataset.mbReady) return;
      root.dataset.mbReady = '1';

      const dataEl = root.querySelector('script[type="application/json"]');
      if (!dataEl?.textContent) return;
      let data: {
        quotes: { label: string; text: string; tags?: string[] }[];
        badge: string;
      };
      try {
        data = JSON.parse(dataEl.textContent);
      } catch {
        return;
      }
      const { quotes, badge } = data;

      // Resolve the visitor's MBTI type, if any
      let mbti: string | null = null;
      try {
        const store = JSON.parse(localStorage.getItem('oiyo-user-storage') || 'null');
        mbti = store?.state?.profile?.mbti ?? null;
        if (!mbti) {
          const legacy = localStorage.getItem('oiyo_mbti_result');
          if (legacy) {
            try {
              const parsed = JSON.parse(legacy);
              mbti = typeof parsed === 'string' ? parsed : (parsed?.type ?? null);
            } catch {
              mbti = legacy;
            }
          }
        }
      } catch {
        mbti = null;
      }
      if (typeof mbti === 'string') {
        mbti = mbti.toUpperCase().trim();
        if (!/^[IE][NS][TF][JP]$/.test(mbti)) mbti = null;
      } else {
        mbti = null;
      }
      const letters = mbti ? mbti.split('') : [];

      // Weighted pool: matching-tag quotes count twice; untagged are universal.
      const pool: number[] = [];
      quotes.forEach((q, i) => {
        if (!q.tags || q.tags.length === 0) pool.push(i);
        else if (q.tags.some((t) => letters.includes(t))) pool.push(i, i);
        else if (!mbti) pool.push(i);
      });
      if (pool.length === 0) return;

      const labelEl = root.querySelector('[data-mb-label]');
      const textEl = root.querySelector('[data-mb-text]');
      const badgeEl = root.querySelector<HTMLElement>('[data-mb-badge]');
      let last = -1;

      const pick = () => {
        let idx = pool[Math.floor(Math.random() * pool.length)];
        for (let guard = 0; idx === last && pool.length > 2 && guard < 10; guard++) {
          idx = pool[Math.floor(Math.random() * pool.length)];
        }
        last = idx;
        const q = quotes[idx];
        if (labelEl) labelEl.textContent = q.label;
        if (textEl) textEl.textContent = q.text;
        if (badgeEl) {
          const personalized = !!mbti && !!q.tags && q.tags.some((t) => letters.includes(t));
          badgeEl.textContent = personalized ? badge.replace('%s', mbti as string) : '';
          badgeEl.style.display = personalized ? '' : 'none';
        }
      };

      pick();
      root.querySelector('[data-mb-refresh]')?.addEventListener('click', pick);
    });
  }

  initMentalBoost();
  document.addEventListener('astro:page-load', initMentalBoost);
</script>
