---
import { localePath, type Locale } from '../../i18n';
import { getCautionText, type TestSourceNote } from '../../data/test-source-notes';

interface Props {
  locale: Locale;
  note: TestSourceNote;
}

const { locale, note } = Astro.props;
const T: Record<Locale, { eyebrow: string; title: string; method: string; limit: string; updated: string; methodology: string }> = {
  ko: { eyebrow: '근거 표기', title: '이 검사가 참고한 모델', method: '참고 척도·이론', limit: '읽기 전 한계', updated: '출처 표기 갱신', methodology: '방법론 보기' },
  en: { eyebrow: 'Sources', title: 'Models This Test References', method: 'Referenced scales and theories', limit: 'Before you read', updated: 'Source note updated', methodology: 'View methodology' },
  ja: { eyebrow: '根拠表示', title: 'このテストが参照したモデル', method: '参照尺度・理論', limit: '読む前の注意', updated: '出典表示の更新', methodology: '方法論を見る' },
  zh: { eyebrow: '来源说明', title: '本测试参考的模型', method: '参考量表与理论', limit: '阅读前说明', updated: '来源说明更新', methodology: '查看方法论' },
  fr: { eyebrow: 'Sources', title: 'Modèles référencés par ce test', method: 'Échelles et théories', limit: 'Avant de lire', updated: 'Note de source mise à jour', methodology: 'Voir la méthodologie' },
  es: { eyebrow: 'Fuentes', title: 'Modelos que referencia este test', method: 'Escalas y teorías', limit: 'Antes de leer', updated: 'Nota de fuentes actualizada', methodology: 'Ver metodología' },
};
const copy = T[locale] ?? T.en;
---

<section class="mx-auto mt-8 max-w-2xl px-4 pb-2">
  <div class="rounded-lg border border-green-100 bg-card p-5 shadow-sm">
    <p class="text-[11px] font-black uppercase tracking-widest text-green-700">{copy.eyebrow}</p>
    <h2 class="mt-2 text-lg font-black text-foreground">{copy.title}</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-[1fr_1.2fr]">
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wide text-slate-500">{copy.method}</h3>
        <ul class="mt-2 space-y-1.5 text-sm leading-6 text-slate-700">
          {note.basis.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wide text-slate-500">{copy.limit}</h3>
        <p class="mt-2 text-sm leading-6 text-slate-700">{getCautionText(note.caution, locale)}</p>
      </div>
    </div>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-3 text-xs text-slate-500">
      <span>{copy.updated}: 2026-06-13</span>
      <a href={localePath(locale, '/methodology')} class="font-semibold text-green-700 hover:text-green-900">{copy.methodology}</a>
    </div>
  </div>
</section>
