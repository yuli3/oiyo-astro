---
import type { TestBridgeContent } from '../../data/test-content-bridges';

interface Props {
  content: TestBridgeContent;
}

// 2026-09-20: blog/wiki 로 내보내는 링크 카드는 뺐다(세운 지시). 이 컴포넌트는
// 이제 oiyo 자체 설명(도입·방법)만 보여준다.
const { content } = Astro.props;
---

<section class="mt-12 rounded-lg border border-green-100 bg-card p-6 shadow-sm">
  <h2 class="text-2xl font-bold text-foreground">{content.introTitle}</h2>
  <p class="mt-4 text-sm leading-7 text-slate-700">{content.introBody}</p>

  <h3 class="mt-8 text-lg font-semibold text-green-900">{content.howTitle}</h3>
  <ul class="mt-3 space-y-2 text-sm leading-7 text-slate-700">
    {content.howItems.map((item) => (
      <li class="flex gap-2">
        <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-green-500"></span>
        <span>{item}</span>
      </li>
    ))}
  </ul>


  <p class="mt-6 rounded-lg bg-slate-50 p-4 text-xs leading-6 text-slate-600">{content.note}</p>
</section>
