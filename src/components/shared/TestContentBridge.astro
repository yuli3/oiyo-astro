---
import type { TestBridgeContent } from '../../data/test-content-bridges';

interface Props {
  content: TestBridgeContent;
  blogUrl: string;
  wikiUrl?: string;
}

const { content, blogUrl, wikiUrl } = Astro.props;
---

<section class="mt-12 rounded-lg border border-green-100 bg-card p-6 shadow-sm">
  <h2 class="text-2xl font-bold text-foreground">{content.introTitle}</h2>
  <p class="mt-4 text-sm leading-7 text-slate-700">{content.introBody}</p>

  <h3 class="mt-8 text-lg font-semibold text-green-900">{content.howTitle}</h3>
  <ul class="mt-3 space-y-2 text-sm leading-7 text-slate-700">
    {content.howItems.map((item) => (
      <li class="flex gap-2">
        <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-green-500"></span>
        <span>{item}</span>
      </li>
    ))}
  </ul>

  <h3 class="mt-8 text-lg font-semibold text-green-900">{content.linksTitle}</h3>
  <div class:list={['mt-3 grid gap-3', wikiUrl && 'sm:grid-cols-2']}>
    <a href={blogUrl} class="rounded-lg border border-green-100 bg-green-50/60 p-4 transition hover:border-green-300 hover:bg-surface-subtle">
      <span class="text-xs font-semibold uppercase tracking-wide text-green-700">{content.blogLabel}</span>
      <p class="mt-2 text-sm leading-6 text-slate-700">{content.blogText}</p>
    </a>
    {wikiUrl && (
      <a href={wikiUrl} class="rounded-lg border border-green-100 bg-slate-50 p-4 transition hover:border-green-300 hover:bg-surface-subtle">
        <span class="text-xs font-semibold uppercase tracking-wide text-green-700">{content.wikiLabel}</span>
        <p class="mt-2 text-sm leading-6 text-slate-700">{content.wikiText}</p>
      </a>
    )}
  </div>

  <p class="mt-6 rounded-lg bg-slate-50 p-4 text-xs leading-6 text-slate-600">{content.note}</p>
</section>
