---
// 홈 랜딩의 운세 도배 섹션. 생년월일 없이 모든 띠·별자리를 기간별로 보여준다.
//
// 2026-09-09: 카드에 순위·점수·등급·전일 대비 변화를 얹었다. 순서는 고정(무순)
// 이고 순위는 배지로만 표기한다 — 순위대로 재배열하면 자기 띠가 매일 다른 자리로
// 옮겨 다녀 찾기 어려워진다. 점수는 PeriodicFortune 과 같은 엔진에서 나오므로
// 랜딩과 상세 페이지의 숫자가 어긋나지 않는다.
import { buildFortuneWall, SECTION_LABELS, GRADE_LABELS, GRADE_COLORS } from '../../lib/fortune/wall-data';
import { MIN_CYCLE_BEFORE_REPEAT } from '../../lib/fortune/periodic';
import type { Locale } from '../../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const lang = (['ko', 'en', 'ja', 'zh', 'fr', 'es'].includes(locale) ? locale : 'en') as keyof typeof SECTION_LABELS;
const sections = buildFortuneWall(locale);
const t = SECTION_LABELS[lang];
const g = GRADE_LABELS[lang];

// 2026-09-21: 이 자리에 "문장 조합 25,055,723,520가지"를 띄우고 있었다.
// 산술은 맞지만(풀 크기의 곱) 방문자에게는 뜻이 없는 수다 — 250억 편의 글을
// 쓴 것이 아니라 다섯 축을 곱한 것뿐이고, 이런 규모 자랑은 신뢰를 깎는다.
// 남긴 주장은 방문자가 실제로 겪는 것이고 스스로 확인할 수 있는 것이다:
// 한 달을 매일 들러도 같은 조언이 다시 나오지 않는다.
// CORPUS_COMBINATIONS 는 코퍼스 깊이를 재는 내부 지표로 남겨 테스트가 쓴다.
const noRepeat = MIN_CYCLE_BEFORE_REPEAT;

const UI = {
  ko: { rank: '위', top: '1위', deltaUp: '상승', deltaDown: '하락', lucky: '행운의 수', more: '내 생년월일로 자세히 보기', scale: `같은 조언은 ${noRepeat}일 안에 다시 나오지 않아요. 문장 풀을 한 바퀴 다 돈 뒤에야 재등장하거든요.` },
  en: { rank: '', top: 'Top', deltaUp: 'up', deltaDown: 'down', lucky: 'Lucky no.', more: 'See it in detail with your birth date', scale: `No advice repeats within ${noRepeat} days — each line cycles through the whole pool before it can return.` },
  ja: { rank: '位', top: '1位', deltaUp: '上昇', deltaDown: '下降', lucky: 'ラッキー数', more: '生年月日で詳しく見る', scale: `同じ助言は ${noRepeat} 日以内に再び出ません。文のプールを一巡してから再登場します。` },
  zh: { rank: '名', top: '第一', deltaUp: '上升', deltaDown: '下降', lucky: '幸运数', more: '用出生日期查看详情', scale: `同一条建议 ${noRepeat} 天内不会重复 — 每句都要走完整个池子才会再次出现。` },
  fr: { rank: 'e', top: 'Top', deltaUp: 'hausse', deltaDown: 'baisse', lucky: 'Nombre', more: 'Voir en détail avec votre date de naissance', scale: `Aucun conseil ne se répète avant ${noRepeat} jours : chaque ligne parcourt tout le réservoir avant de revenir.` },
  es: { rank: 'º', top: 'Top', deltaUp: 'sube', deltaDown: 'baja', lucky: 'Número', more: 'Verlo en detalle con tu fecha de nacimiento', scale: `Ningún consejo se repite en ${noRepeat} días: cada línea recorre todo el conjunto antes de volver.` },
}[lang];

const detailHref = `/${locale}/fortune/today/`;
---

<div class="max-w-4xl mx-auto px-4">
  <p class="mb-3 text-center text-[11px] font-semibold text-green-600">{UI.scale}</p>

  {sections.map((s, i) => (
    <details class="mb-4 rounded-2xl border border-green-100 bg-card" open={i === 0}>
      <summary class="cursor-pointer select-none px-5 py-4 text-lg font-black text-foreground">
        {s.periodLabel} {t.fortuneSuffix} <span class="ml-2 text-xs font-semibold text-green-600">{t.animals} · {t.signs}</span>
      </summary>
      <div class="px-5 pb-5">
        {[{ label: t.animals, cards: s.animals }, { label: t.signs, cards: s.signs }].map((group) => (
          <>
            <p class="mb-2 mt-4 text-xs font-bold uppercase tracking-widest text-green-600 first:mt-0">{group.label}</p>
            <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2 md:grid-cols-3">
              {group.cards.map((c) => (
                <li
                  class="rounded-xl border p-3"
                  style={`border-color:${GRADE_COLORS[c.grade]}33; background:${GRADE_COLORS[c.grade]}0d`}
                >
                  <div class="flex items-baseline gap-2">
                    <span class="min-w-0 flex-1 truncate text-sm font-black text-foreground">{c.emoji} {c.name}</span>
                    <span
                      class="shrink-0 rounded-full px-2 py-0.5 text-[11px] font-black tabular-nums"
                      style={`background:${GRADE_COLORS[c.grade]}1a;color:${GRADE_COLORS[c.grade]}`}
                    >{c.rank}{UI.rank}</span>
                    <span class="shrink-0 text-sm font-black tabular-nums" style={`color:${GRADE_COLORS[c.grade]}`}>{c.score}</span>
                  </div>

                  <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-green-100/70">
                    <span class="block h-full rounded-full" style={`width:${c.score}%;background:${GRADE_COLORS[c.grade]}`}></span>
                  </div>

                  <p class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] font-bold">
                    <span style={`color:${GRADE_COLORS[c.grade]}`}>{g[c.grade]}</span>
                    <span class="text-green-700">#{c.keyword}</span>
                    {c.delta !== 0 && (
                      <span class={c.delta > 0 ? 'text-emerald-600' : 'text-rose-500'}>
                        {c.delta > 0 ? '▲' : '▼'}{Math.abs(c.delta)}
                      </span>
                    )}
                    <span class="inline-flex items-center gap-1 text-green-600">
                      <span class="inline-block h-2.5 w-2.5 rounded-full border" style={`background:${c.luckyColorHex}`} aria-hidden="true"></span>
                      {UI.lucky} {c.luckyNumber}
                    </span>
                  </p>

                  <p class="mt-1.5 text-xs leading-5 text-green-900">{c.opening}</p>
                  <p class="mt-1 text-[11px] font-semibold text-green-600">{c.advice}</p>
                  <p class="mt-1 text-[11px] leading-5 text-green-700/80">{c.caution}</p>
                </li>
              ))}
            </ul>
          </>
        ))}

        <a
          href={detailHref}
          class="mt-4 block rounded-xl border border-green-200 px-4 py-2.5 text-center text-sm font-bold text-green-700 hover:bg-green-50"
        >{UI.more}</a>
      </div>
    </details>
  ))}
</div>
