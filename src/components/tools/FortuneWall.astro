---
// 홈 랜딩의 운세 도배 섹션. 생년월일 없이 모든 띠·별자리를 기간별로 보여준다.
import { buildFortuneWall, SECTION_LABELS } from '../../lib/fortune/wall-data';
import type { Locale } from '../../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const lang = (['ko', 'en', 'ja', 'zh', 'fr', 'es'].includes(locale) ? locale : 'en') as keyof typeof SECTION_LABELS;
const sections = buildFortuneWall(locale);
const t = SECTION_LABELS[lang];
---

<div class="max-w-4xl mx-auto px-4">
  {sections.map((s, i) => (
    <details class="mb-4 rounded-2xl border border-green-100 bg-card" open={i === 0}>
      <summary class="cursor-pointer select-none px-5 py-4 text-lg font-black text-foreground">
        {s.periodLabel} {t.fortuneSuffix} <span class="ml-2 text-xs font-semibold text-green-600">{t.animals} · {t.signs}</span>
      </summary>
      <div class="px-5 pb-5">
        <p class="mb-2 text-xs font-bold uppercase tracking-widest text-green-600">{t.animals}</p>
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4 mb-6">
          {s.animals.map((c) => (
            <div class="rounded-xl bg-green-50/60 p-3">
              <p class="text-sm font-black text-foreground">{c.emoji} {c.name}</p>
              <p class="mt-1 text-xs leading-5 text-green-800">{c.opening}</p>
              <p class="mt-1 text-[11px] font-semibold text-green-600">{c.advice}</p>
            </div>
          ))}
        </div>
        <p class="mb-2 text-xs font-bold uppercase tracking-widest text-green-600">{t.signs}</p>
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4">
          {s.signs.map((c) => (
            <div class="rounded-xl bg-green-50/60 p-3">
              <p class="text-sm font-black text-foreground">{c.emoji} {c.name}</p>
              <p class="mt-1 text-xs leading-5 text-green-800">{c.opening}</p>
              <p class="mt-1 text-[11px] font-semibold text-green-600">{c.advice}</p>
            </div>
          ))}
        </div>
      </div>
    </details>
  ))}
</div>
