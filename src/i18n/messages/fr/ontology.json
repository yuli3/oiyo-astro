          },
          "ECON_AUSTRIAN": {
            "name": "École Autrichienne",
            "description": "Met l'accent sur la découverte entrepreneuriale et le subjectivisme. Valorise la liberté créative, la vision personnelle et la valeur unique des perspectives individuelles."
          }
        }
