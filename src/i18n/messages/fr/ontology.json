        "title": "Analyse de l'orientation politique",
        "subtitle": "Paysage politique",
        "factions": {
          "POL_CONSERVATISM": {
            "name": "Conservatisme",
            "description": "Valorise la tradition, la stabilité et la réforme graduelle. Cette approche cherche à préserver la sagesse chèrement acquise tout en assurant un avenir sûr et stable."
          },
          "POL_LIBERALISM": {
            "name": "Libéralisme",
            "description": "Met l'accent sur la liberté individuelle, l'égalité et le progrès. Valorise la liberté d'explorer de nouvelles possibilités et la dignité inhérente de chaque personne."
          },
          "POL_SOCIALISM": {
            "name": "Socialisme",
            "description": "Se concentre sur la justice sociale, l'égalité et le bien-être de la communauté. Valorise le soutien mutuel, le bien-être collectif et la force trouvée dans la solidarité."
          },
          "POL_LIBERTARIANISM": {
            "name": "Libertarianisme",
            "description": "Priorise l'intervention minimale et l'autonomie individuelle maximale. Valorise l'autodétermination et la protection de l'espace et de l'initiative privés."
          },
          "POL_MODERATISM": {
            "name": "Modératisme",
            "description": "Cherche un équilibre entre l'ordre et le progrès. Valorise les solutions pragmatiques, le dialogue et la recherche d'un terrain d'entente pour le bien commun."
          }
        }
      }
    }
