---
import Layout from '../../../layouts/Layout.astro';
import MentalBoost from '../../../components/shared/MentalBoost.astro';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import SagesCardDaily from '../../../components/tools/SagesCardDaily';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: '오늘의 현인의 카드 — 동서양 지혜 318장 중 한 장',
    description: '그라시안과 노자 318장에서 오늘 한 장을 펼칩니다. 매일 바뀌는 현인의 지혜로 하루를 시작해 보세요.',
  },
  en: {
    title: "Today's Sage Card — One of 318 Wisdom Cards",
    description: 'Draw one of 318 cards from Gracián and Laozi. Start your day with a sage’s wisdom.',
  },
  ja: {
    title: '今日の賢者カード — 東西の知恵318枚から一枚',
    description: 'グラシアンと老子の318枚から、今日の一枚を。毎日変わる賢者の知恵で一日を始めましょう。',
  },
  zh: {
    title: '今日贤者卡 — 东西方318张智慧卡之一',
    description: '从格拉西安与老子的318张中翻开今天的一张。用每日变化的贤者智慧开启一天。',
  },
  fr: {
    title: 'Carte du Sage du Jour — Une des 318 cartes de sagesse',
    description: "Tirez une des 318 cartes de Gracián et Laozi. Commencez la journée avec la sagesse d'un sage.",
  },
  es: {
    title: 'Carta del Sabio del Día — Una de 318 cartas de sabiduría',
    description: 'Saca una de 318 cartas de Gracián y Laozi. Comienza el día con la sabiduría de un sabio.',
  },
};

const m = meta[locale] ?? meta.en;

const content: Record<Locale, {
  introTitle: string;
  intro: string;
  conceptTitle: string;
  concepts: { title: string; body: string }[];
  useTitle: string;
  useCases: { title: string; body: string }[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  readingTitle: string;
  reading: { href: string; label: string; desc: string }[];
  disclaimer: string;
}> = {
  "ko": {
    "faqTitle": "자주 묻는 질문",
    "readingTitle": "더 깊게 읽기",
    "introTitle": "현자의 카드는 정답을 내려주기보다 오래된 지혜의 문장을 빌려 마음을 정돈합니다",
    "intro": "현자 카드 리딩은 지혜, 조언, 관조의 상징을 통해 오늘 붙잡을 한 문장을 고르는 조용한 의례입니다. 결과를 절대적인 지시로 받아들이기보다, 지금의 상황을 한 걸음 떨어져 바라보게 하는 언어로 사용하세요.",
    "conceptTitle": "현자 카드의 핵심",
    "concepts": [
      {
        "title": "지혜의 원형",
        "body": "현자, 안내자, 스승 같은 상징을 통해 조언의 결을 읽습니다."
      },
      {
        "title": "하루의 문장",
        "body": "긴 해석보다 오늘 곁에 둘 짧은 문장을 고르는 데 적합합니다."
      },
      {
        "title": "거리 두기",
        "body": "문제를 바로 해결하려 하기보다 한 발 물러나 보는 태도를 돕습니다."
      }
    ],
    "useTitle": "현자 카드를 활용하는 법",
    "useCases": [
      {
        "title": "아침의 문장",
        "body": "하루를 시작하기 전 카드의 조언을 한 문장으로 적어보세요."
      },
      {
        "title": "감정 정리",
        "body": "복잡한 마음을 설득하려 하기보다, 카드가 던지는 질문을 천천히 따라갑니다."
      },
      {
        "title": "밤의 회고",
        "body": "하루 끝에 카드의 문장이 실제로 어떤 의미였는지 다시 적습니다."
      }
    ],
    "faqs": [
      {
        "question": "현자 카드는 무엇이 다른가요?",
        "answer": "현자 카드는 사건 예측보다 조언, 관조, 마음의 태도를 중심으로 읽는 오라클 형식입니다."
      },
      {
        "question": "결과를 그대로 따라야 하나요?",
        "answer": "아니요. 카드 문장은 명령이 아니라 성찰의 문장입니다. 현실 상황과 자신의 판단을 함께 보세요."
      },
      {
        "question": "매일 뽑아도 되나요?",
        "answer": "네. 하루 한 장을 정해 기록하면 감정과 생각의 변화를 차분히 관찰할 수 있습니다."
      }
    ],
    "reading": [],
    "disclaimer": "현자 카드 결과는 오락과 자기 성찰 목적입니다. 중요한 결정이나 전문적 조언을 대신하지 않습니다."
  },
  "en": {
    "faqTitle": "Frequently asked questions",
    "readingTitle": "Read more",
    "introTitle": "Sage cards borrow the language of wisdom; they do not hand down final answers",
    "intro": "A Sage card reading is a quiet ritual for choosing one sentence of advice, perspective, or reflection for today. Treat the result as language that helps you step back from the situation, not as an absolute instruction.",
    "conceptTitle": "Core ideas of Sage cards",
    "concepts": [
      {
        "title": "Wisdom archetype",
        "body": "Symbols of sages, guides, and teachers frame the reading as counsel rather than forecast."
      },
      {
        "title": "One sentence for the day",
        "body": "The format is useful for carrying a short phrase instead of a long interpretation."
      },
      {
        "title": "Reflective distance",
        "body": "The card helps you step back before trying to solve everything at once."
      }
    ],
    "useTitle": "How to use Sage cards",
    "useCases": [
      {
        "title": "Morning sentence",
        "body": "Before the day begins, write the card’s advice as one sentence."
      },
      {
        "title": "Sort emotions gently",
        "body": "Follow the question the card raises instead of forcing a fast answer."
      },
      {
        "title": "Evening review",
        "body": "At night, rewrite what the sentence meant in practice."
      }
    ],
    "faqs": [
      {
        "question": "How are Sage cards different?",
        "answer": "Sage cards focus on counsel, perspective, and inner posture rather than event prediction."
      },
      {
        "question": "Should I follow the result exactly?",
        "answer": "No. The card is a reflective sentence, not an order. Hold it alongside your real situation and judgment."
      },
      {
        "question": "Can I draw one every day?",
        "answer": "Yes. A daily card and note can help you observe changes in thought and feeling."
      }
    ],
    "reading": [],
    "disclaimer": "Sage card results are for entertainment and self-reflection. They do not replace important decisions or professional advice."
  },
  "ja": {
    "faqTitle": "Frequently asked questions",
    "readingTitle": "Read more",
    "introTitle": "賢者カードは答えを下すのではなく、知恵の言葉で心を整えます",
    "intro": "賢者カードリーディングは、知恵、助言、観照の象徴を通して、今日そばに置く一文を選ぶ静かな儀式です。結果は絶対の指示ではなく、状況を少し離れて見るための言葉として使いましょう。",
    "conceptTitle": "賢者カードの要点",
    "concepts": [
      {
        "title": "知恵の原型",
        "body": "賢者、案内人、師の象徴を通して助言の質を読みます。"
      },
      {
        "title": "一日の一文",
        "body": "長い解釈より、今日持ち歩く短い言葉を選ぶのに向いています。"
      },
      {
        "title": "距離を置く",
        "body": "すぐ解決しようとせず、一歩離れて見る態度を助けます。"
      }
    ],
    "useTitle": "賢者カードの使い方",
    "useCases": [
      {
        "title": "朝の一文",
        "body": "一日を始める前に、カードの助言を一文で書きます。"
      },
      {
        "title": "感情を整える",
        "body": "すぐ答えを出そうとせず、カードが投げる問いをゆっくり追います。"
      },
      {
        "title": "夜の振り返り",
        "body": "一日の終わりに、その言葉が実際どう響いたかを書き直します。"
      }
    ],
    "faqs": [
      {
        "question": "賢者カードは何が違いますか？",
        "answer": "出来事の予測より、助言、観照、心の姿勢を中心に読むオラクル形式です。"
      },
      {
        "question": "結果にそのまま従うべきですか？",
        "answer": "いいえ。カードの文は命令ではなく省察の言葉です。現実の状況と自分の判断を合わせて見ましょう。"
      },
      {
        "question": "毎日引いてもいいですか？",
        "answer": "はい。一日一枚を記録すると、感情や考えの変化を静かに観察できます。"
      }
    ],
    "reading": [],
    "disclaimer": "賢者カードの結果は娯楽と自己省察のためのものです。重要な決定や専門的助言を代替しません。"
  },
  "zh": {
    "faqTitle": "Frequently asked questions",
    "readingTitle": "Read more",
    "introTitle": "贤者卡不替你给出答案，而借古老智慧整理心绪",
    "intro": "贤者卡解读通过智慧、建议与观照的象征，为今天选择一句可以带在身边的话。请把结果当作帮助你退一步看待处境的语言，而不是绝对指令。",
    "conceptTitle": "贤者卡核心",
    "concepts": [
      {
        "title": "智慧原型",
        "body": "以贤者、向导、老师等象征阅读建议的质地。"
      },
      {
        "title": "一天一句话",
        "body": "适合选择今天要带着走的短句，而非复杂解释。"
      },
      {
        "title": "拉开距离",
        "body": "帮助你先退一步观察，而不是立刻解决所有问题。"
      }
    ],
    "useTitle": "如何使用贤者卡",
    "useCases": [
      {
        "title": "早晨一句话",
        "body": "一天开始前，把卡牌建议写成一句话。"
      },
      {
        "title": "整理情绪",
        "body": "不急着说服自己，慢慢跟随卡牌提出的问题。"
      },
      {
        "title": "夜晚回顾",
        "body": "一天结束时，重写这句话在现实中意味着什么。"
      }
    ],
    "faqs": [
      {
        "question": "贤者卡有什么不同？",
        "answer": "贤者卡更重视建议、观照与心态，而不是预测事件。"
      },
      {
        "question": "需要完全照做吗？",
        "answer": "不需要。卡牌文字是反思句子，不是命令。请结合现实处境与自己的判断。"
      },
      {
        "question": "可以每天抽吗？",
        "answer": "可以。每天一张并记录，有助于安静观察情绪和想法的变化。"
      }
    ],
    "reading": [],
    "disclaimer": "贤者卡结果仅供娱乐与自我反思，不替代重要决定或专业建议。"
  },
  "fr": {
    "faqTitle": "Frequently asked questions",
    "readingTitle": "Read more",
    "introTitle": "Les cartes des sages empruntent le langage de la sagesse, sans donner de verdict final",
    "intro": "Un tirage des Sages est un rituel calme pour choisir une phrase de conseil, de recul ou de réflexion pour aujourd’hui. Traitez le résultat comme une langue qui aide à prendre distance, pas comme un ordre absolu.",
    "conceptTitle": "Idées clés des Sages",
    "concepts": [
      {
        "title": "Archétype de sagesse",
        "body": "Sages, guides et enseignants cadrent la lecture comme un conseil plutôt qu’une prévision."
      },
      {
        "title": "Une phrase du jour",
        "body": "Le format aide à porter une phrase courte plutôt qu’une longue interprétation."
      },
      {
        "title": "Distance réflexive",
        "body": "La carte aide à reculer avant de vouloir tout résoudre."
      }
    ],
    "useTitle": "Comment utiliser les Sages",
    "useCases": [
      {
        "title": "Phrase du matin",
        "body": "Avant la journée, écrivez le conseil de la carte en une phrase."
      },
      {
        "title": "Trier les émotions",
        "body": "Suivez doucement la question soulevée au lieu de forcer une réponse rapide."
      },
      {
        "title": "Relecture du soir",
        "body": "Le soir, reformulez ce que la phrase a signifié en pratique."
      }
    ],
    "faqs": [
      {
        "question": "En quoi les cartes des Sages diffèrent-elles ?",
        "answer": "Elles mettent l’accent sur le conseil, la perspective et la posture intérieure plutôt que la prédiction."
      },
      {
        "question": "Dois-je suivre le résultat exactement ?",
        "answer": "Non. La carte est une phrase de réflexion, pas un ordre. Gardez votre jugement et le contexte réel."
      },
      {
        "question": "Puis-je en tirer une chaque jour ?",
        "answer": "Oui. Une carte quotidienne et une note aident à observer les changements de pensée et d’émotion."
      }
    ],
    "reading": [],
    "disclaimer": "Les cartes des Sages servent au divertissement et à la réflexion. Elles ne remplacent pas les décisions importantes ni les conseils professionnels."
  },
  "es": {
    "faqTitle": "Frequently asked questions",
    "readingTitle": "Read more",
    "introTitle": "Las cartas de sabios toman lenguaje de sabiduría; no entregan respuestas finales",
    "intro": "Una lectura de Sabios es un ritual tranquilo para elegir una frase de consejo, perspectiva o reflexión para hoy. Trata el resultado como lenguaje que ayuda a tomar distancia, no como instrucción absoluta.",
    "conceptTitle": "Ideas clave de los Sabios",
    "concepts": [
      {
        "title": "Arquetipo de sabiduría",
        "body": "Sabios, guías y maestros enmarcan la lectura como consejo más que pronóstico."
      },
      {
        "title": "Una frase del día",
        "body": "El formato sirve para llevar una frase breve, no una interpretación extensa."
      },
      {
        "title": "Distancia reflexiva",
        "body": "La carta ayuda a tomar distancia antes de intentar resolverlo todo."
      }
    ],
    "useTitle": "Cómo usar cartas de Sabios",
    "useCases": [
      {
        "title": "Frase de la mañana",
        "body": "Antes del día, escribe el consejo de la carta en una frase."
      },
      {
        "title": "Ordenar emociones",
        "body": "Sigue la pregunta que abre la carta en vez de forzar una respuesta rápida."
      },
      {
        "title": "Revisión nocturna",
        "body": "Por la noche, reescribe qué significó la frase en la práctica."
      }
    ],
    "faqs": [
      {
        "question": "¿En qué se diferencian las cartas de Sabios?",
        "answer": "Se centran en consejo, perspectiva y postura interior más que en predicción de eventos."
      },
      {
        "question": "¿Debo seguir el resultado exactamente?",
        "answer": "No. La carta es una frase reflexiva, no una orden. Sostenla junto con tu situación y criterio."
      },
      {
        "question": "¿Puedo sacar una cada día?",
        "answer": "Sí. Una carta diaria y una nota ayudan a observar cambios de pensamiento y emoción."
      }
    ],
    "reading": [],
    "disclaimer": "Las cartas de Sabios son para entretenimiento y reflexión. No reemplazan decisiones importantes ni consejo profesional."
  }
};

const c = content[locale] ?? content.en;

const webApplicationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: m.title,
  description: m.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Any',
  inLanguage: locale,
  isAccessibleForFree: true,
  publisher: { '@id': 'https://oiyo.net/#organization' },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Layout title={m.title} description={m.description} locale={locale} heading={m.title} intro={m.description}>
  <script type="application/ld+json" set:html={JSON.stringify([webApplicationJsonLd, faqJsonLd])} />
  <div class="mx-auto w-full max-w-3xl px-4 py-12">
    <SagesCardDaily locale={locale} client:load />

    <section class="mt-10 border-t border-green-100 pt-8">
      <h2 class="text-2xl font-bold text-green-950">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-green-800">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-green-950">{c.conceptTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.concepts.map((item) => (
          <article class="rounded-xl border border-green-100 bg-white p-4">
            <h3 class="font-semibold text-green-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-green-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-green-950">{c.useTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.useCases.map((item) => (
          <article class="rounded-xl bg-green-50 p-4">
            <h3 class="font-semibold text-green-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-green-800">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-green-950">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-green-100 rounded-xl border border-green-100 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-green-950">
              {faq.question}
            </summary>
            <p class="mt-3 text-sm leading-6 text-green-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">
      {c.disclaimer}
    </p>
    <div class="mt-10">
      <MentalBoost locale={locale} />
    </div>
  </div>
</Layout>
