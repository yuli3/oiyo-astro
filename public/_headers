# Cloudflare Pages cache & security headers
# oiyo.net

# ──────────────────────────────────────────
# STATIC ASSETS — immutable long cache
# ──────────────────────────────────────────
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# ──────────────────────────────────────────
# IMAGES & ICONS — 1 week CDN
# ──────────────────────────────────────────
/*.png
  Cache-Control: public, max-age=604800, s-maxage=604800, stale-while-revalidate=86400

/*.ico
  Cache-Control: public, max-age=604800, s-maxage=604800

/*.svg
  Cache-Control: public, max-age=604800, s-maxage=604800
  X-Content-Type-Options: nosniff

/img/*
  Cache-Control: public, max-age=604800, s-maxage=604800, stale-while-revalidate=86400

# ──────────────────────────────────────────
# SEO FILES — short revalidation
# ──────────────────────────────────────────
/robots.txt
  Cache-Control: public, max-age=86400

/ads.txt
  Cache-Control: public, max-age=86400

/manifest.json
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

# ──────────────────────────────────────────
# 데이터 번들 — 자주 바뀌지 않고 크다
# ──────────────────────────────────────────
# geonames-cities.json 은 brotli 로도 약 950KB 다. 기본 정책은
# `max-age=0, s-maxage=300` 이라 브라우저가 캐시하지 않고, 검색을 열 때마다
# 조건부 재요청(304)이 왕복한다. 데이터는 GeoNames 릴리스 주기(연 단위)로만
# 바뀌므로 일주일 브라우저 캐시가 맞다. immutable 은 쓰지 않는다 — 파일명에
# 버전이 없어서 갱신했을 때 되돌릴 방법이 없어진다.
/data/*
  Cache-Control: public, max-age=604800, s-maxage=604800, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

/sitemap*.xml
  Cache-Control: public, max-age=3600, s-maxage=86400

# ──────────────────────────────────────────
# ALL PAGES — security headers
# CSP intentionally omitted (2026-06-14): static, no-auth, no-user-data site — CSP has no
# high-value target here and a mis-allowlisted CSP silently breaks ads/analytics. Clickjacking,
# MIME-sniffing, and HTTPS protections remain via the headers below.
# ──────────────────────────────────────────
/*
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=600
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
