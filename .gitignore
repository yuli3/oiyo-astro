# build output
dist/
# generated types
.astro/
.tmp/
public/ontology-platform-v1/
# Immutable source snapshots live in config/ontology-platform/archive/; generated runtime artifacts do not.
.local-data/

# dependencies
# 슬래시가 있으면 디렉터리만 막는다. 이 repo 의 표준 worktree 절차는
# node_modules 를 **심볼릭 링크**로 만들기 때문에(agent 핸드오프 문서 참조)
# 슬래시가 있으면 링크가 추적 후보로 남고, git add -A 한 번에 딸려 들어간다.
# 2026-09-01 실제로 한 번 커밋됐다가 amend 로 걷어냈다.
node_modules

# git worktree
# 이 repo 의 워크트리는 coding/.worktrees/ (repo 바깥) 에 만든다. 그런데 경로를
# 잘못 잡아 repo 안에 생기면 조용히 세 가지가 망가진다 — vitest 가 그 안의
# 테스트까지 수집해 React 인스턴스가 둘이 되어 깨지고(2026-09-07~09 실제로 6건
# 실패했다), node_modules 중복으로 1.3GB 가 쌓이고, untracked 로 노출돼
# git add -A 한 번에 딸려 들어간다. 위쪽 node_modules 사고와 같은 함정이다.
.worktrees/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Cloudflare
.wrangler/
worker-configuration.d.ts
__pycache__/
