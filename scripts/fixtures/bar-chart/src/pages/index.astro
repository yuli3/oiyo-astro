---
import BarChart from '../../../../../src/components/mdx/BarChart.astro';
import '../styles.css';

const invalidCase = process.env.OIYO_BAR_CHART_INVALID;
const invalidData = invalidCase === 'negative' ? -1 : invalidCase === 'nan' ? Number.NaN : 11;
const labels = [
  '긴 한국어 라벨도 생략하지 않고 모두 읽을 수 있어야 해요',
  'A full descriptive label must remain readable without hovering',
  '長い日本語のラベルも省略せずにすべて読めることを確認します',
  '较长的中文标签也应完整显示，不依赖悬停或省略号',
  'Une longue description reste entièrement lisible sans survol',
  'Una descripción larga sigue siendo legible sin pasar el cursor',
  'AnUnbrokenLabelThatMustWrapRatherThanOverflowTheNarrowMobileViewport',
];
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Bar chart fixtures — not production content</title></head>
  <body>
    <main class="mx-auto max-w-xl px-4">
      <h1>Bar chart fixtures — illustrative units only</h1>
      {invalidCase ? <BarChart title="Invalid fixture" data={[{label:'Invalid',value:invalidData}]} max={10} /> : (
        <>
          <section id="long-labels"><BarChart title="Long labels and fractions" data={labels.map(label=>({label,value:2.5}))} max={10} /></section>
          <section id="zero"><BarChart title="All zero" data={[{label:'Zero A',value:0},{label:'Zero B',value:0}]} /></section>
          <section id="empty"><BarChart title="Empty data must not produce misleading bars" data={[]} /></section>
        </>
      )}
    </main>
  </body>
</html>
