SELECT ?s ?bird ?animal ?plant ?treeClass WHERE {
  VALUES ?s { wd:Q1001507 wd:Q101711 wd:Q122069 wd:Q127216 wd:Q130201 wd:Q130918 wd:Q133006 wd:Q139970 wd:Q140 wd:Q15296155 wd:Q15326829 wd:Q15530181 wd:Q156895 wd:Q157552 wd:Q159543 wd:Q161117 wd:Q165278 wd:Q166812 wd:Q171058 wd:Q171869 wd:Q18335389 wd:Q188788 wd:Q2141912 wd:Q214733 wd:Q23757 wd:Q2424230 wd:Q25247 wd:Q25438 wd:Q25612 wd:Q2663639 wd:Q29195 wd:Q358209 wd:Q36341 wd:Q37083 wd:Q38602 wd:Q40561 wd:Q41177 wd:Q41181 wd:Q425900 wd:Q43489 wd:Q511179 wd:Q516233 wd:Q714716 wd:Q792871 wd:Q81056 wd:Q82037 wd:Q843346 wd:Q871991 wd:Q924911 }
  BIND(EXISTS { ?s wdt:P279*/wdt:P171* wd:Q5113 } AS ?bird)
  BIND(EXISTS { ?s wdt:P279*/wdt:P171* wd:Q729 } AS ?animal)
  BIND(EXISTS { ?s wdt:P279*/wdt:P171* wd:Q756 } AS ?plant)
  BIND(EXISTS { ?s wdt:P31?/wdt:P279* wd:Q10884 } AS ?treeClass)
}
